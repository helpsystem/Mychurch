###############################
# Church Management System - Environment Configuration
# DO NOT put real secrets here; use placeholders only
###############################

# ========== SERVER CONFIGURATION ==========
PORT=3001
NODE_ENV=development
# HOST=0.0.0.0 allows remote connections (production)
# HOST=localhost for local-only access (development)
HOST=0.0.0.0

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:5173,https://samanabyar.online

# ========== DATABASE (SUPABASE) ==========
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres.projectref:password@aws-region.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://projectref.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ========== JWT & AUTHENTICATION ==========
JWT_SECRET=please-replace-with-a-long-random-string-min-32-chars
JWT_EXPIRY=7d

# ========== SESSION CONFIGURATION ==========
SESSION_SECRET=your_session_secret_min_32_chars
COOKIE_SECURE=true
COOKIE_DOMAIN=samanabyar.online

# ========== FTP CONFIGURATION ==========
FTP_HOST=mi3-cl8-its2.a2hosting.com
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password
FTP_PORT=21
FTP_SECURE=false
FTP_BASE_DIR=public_html/images
UPLOADS_DIR=uploads

# ========== DOMAIN & URLs ==========
DOMAIN=https://samanabyar.online
API_URL=https://samanabyar.online/api
STATIC_URL=https://samanabyar.online/static

# ========== FRONTEND ORIGINS (OPTIONAL) ==========
FRONTEND_ORIGIN=https://samanabyar.online
# FRONTEND_ORIGIN_2=
# FRONTEND_ORIGIN_3=

# ========== AI SERVICES (OPTIONAL) ==========
# GEMINI_API_KEY=
# GOOGLE_AI_API_KEY=

# ========== NOTIFICATIONS (OPTIONAL - TWILIO) ==========
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# ========== REPLIT (IF DEPLOYING ON REPLIT) ==========
# REPLIT_DEV_DOMAIN=

# ========== BIBLE IMPORT (OPTIONAL LOCAL TOOLING) ==========
# BIBLE_SOURCE_MODE=sqlite
# SQLITE_PATH=./attached_assets/bible_fa_en_XXXXX.sqlite
# BIBLE_SOURCE_MODE=directory
# BIBLE_DIR_PATH=./attached_assets/bible_data
# SECOND_LANG_CODE=fa

# ============================================
# DEPLOYMENT NOTES:
# - Copy this file to .env and fill in your actual values
# - Never commit .env to version control
# - Change all secrets before deploying to production
# - For local development: HOST=localhost
# - For production: HOST=0.0.0.0 to accept remote connections
# ============================================
