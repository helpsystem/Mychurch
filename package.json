{
  "name": "iranian-christian-church-of-d.c.-website.v4",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend": "cd backend && npm run dev",
    "dev:all": "concurrently --kill-others-on-fail \"npm run backend\" \"npm run dev\"",
    "dev:full": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"bgBlue.bold,bgMagenta.bold\" \"npm run backend\" \"npm run dev\"",
    "build": "vite build",
    "build:analyze": "vite build --mode production && npx vite-bundle-analyzer dist",
    "build:prod": "NODE_ENV=production vite build",
    "build:staging": "NODE_ENV=staging vite build",
    "preview": "vite preview",
    "preview:prod": "vite build && vite preview",
    "start": "serve -s dist -l 5000",
    "start-all": "concurrently \"npm run dev\" \"npm run backend\"",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Linting not configured yet'",
    "sitemap:generate": "node scripts/generate-sitemap.js",
    "optimize:images": "node scripts/optimize-images.js",
    "bible:index": "node scripts/bible-timing/build-index.mjs",
    "bible:align": "node scripts/bible-timing/auto-align.mjs",
    "bible:prepare": "npm run bible:index && npm run bible:align",
    "sync": "node sync-to-server.js --sync",
    "sync:watch": "node sync-to-server.js --watch",
    "sync:file": "node sync-to-server.js --file",
    "test": "node test-api.js",
    "test:local": "VITE_API_URL=http://localhost:3001 node test-api.js",
    "setup": "node setup-local.js",
    "setup:local": "./setup-local.sh",
    "setup:windows": "setup-local.bat",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "build:safe": "powershell -File scripts/build-tools.ps1 safe",
    "build:backup": "powershell -File scripts/build-tools.ps1 backup",
    "clean:artifacts": "powershell -File scripts/build-tools.ps1 clean"
  },
