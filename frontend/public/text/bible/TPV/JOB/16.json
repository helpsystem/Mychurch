{
  "translation": "TPV",
  "book": "JOB",
  "chapter": 16,
  "verses": [
    {
      "verse": 2,
      "text": "من این سخنان را بسیار شنیده‌ام.",
      "usfm": "JOB.16.1+JOB.16.2"
    },
    {
      "verse": 2,
      "text": "تسلّی شما مرا زیادتر عذاب می‌دهد.",
      "usfm": "JOB.16.1+JOB.16.2"
    },
    {
      "verse": 3,
      "text": "تا به کی به این حرفهای بیهوده ادامه می‌دهید؟",
      "usfm": "JOB.16.3"
    },
    {
      "verse": 3,
      "text": "آیا شما باید همیشه حرف آخر را بزنید؟",
      "usfm": "JOB.16.3"
    },
    {
      "verse": 4,
      "text": "اگر من هم به جای شما بودم",
      "usfm": "JOB.16.4"
    },
    {
      "verse": 4,
      "text": "می‌توانستم چنین سخنانی بگویم",
      "usfm": "JOB.16.4"
    },
    {
      "verse": 4,
      "text": "و به عنوان اعتراض",
      "usfm": "JOB.16.4"
    },
    {
      "verse": 4,
      "text": "سر خود را تکان بدهم.",
      "usfm": "JOB.16.4"
    },
    {
      "verse": 5,
      "text": "امّا من شما را نصیحت می‌کردم",
      "usfm": "JOB.16.5"
    },
    {
      "verse": 5,
      "text": "و با سخنان گرم، شما را تسلّی می‌دادم.",
      "usfm": "JOB.16.5"
    },
    {
      "verse": 6,
      "text": "هرچه بگویم، از درد و رنج من کاسته نمی‌شود",
      "usfm": "JOB.16.6"
    },
    {
      "verse": 6,
      "text": "و اگر هم ساکت بمانم، دردم دوا نخواهد شد.",
      "usfm": "JOB.16.6"
    },
    {
      "verse": 7,
      "text": "زیرا تو ای خدا، مرا از زندگی خسته کرده‌ای",
      "usfm": "JOB.16.7"
    },
    {
      "verse": 7,
      "text": "و خانواده‌ام را از بین برده‌ای.",
      "usfm": "JOB.16.7"
    },
    {
      "verse": 8,
      "text": "تو عرصه را بر من تنگ کردی و دشمن من شدی.",
      "usfm": "JOB.16.8"
    },
    {
      "verse": 8,
      "text": "من لاغر و استخوانی شده‌ام",
      "usfm": "JOB.16.8"
    },
    {
      "verse": 8,
      "text": "و مردم این را نتیجهٔ گناهان من می‌دانند.",
      "usfm": "JOB.16.8"
    },
    {
      "verse": 9,
      "text": "تو با خشم خود، گوشت بدنم را پاره کرده‌ای،",
      "usfm": "JOB.16.9"
    },
    {
      "verse": 9,
      "text": "با دیدهٔ نفرت به من نگاه می‌کنی و مرا دشمن خود می‌پنداری.",
      "usfm": "JOB.16.9"
    },
    {
      "verse": 10,
      "text": "مردم مرا مسخره می‌کنند",
      "usfm": "JOB.16.10"
    },
    {
      "verse": 10,
      "text": "و به دور من جمع شده به روی من سیلی می‌زنند.",
      "usfm": "JOB.16.10"
    },
    {
      "verse": 11,
      "text": "خدا مرا به دست مردم ظالم و شریر سپرده است.",
      "usfm": "JOB.16.11"
    },
    {
      "verse": 12,
      "text": "من زندگی آرام و آسوده‌ای داشتم،",
      "usfm": "JOB.16.12"
    },
    {
      "verse": 12,
      "text": "امّا او گلوی مرا گرفت",
      "usfm": "JOB.16.12"
    },
    {
      "verse": 12,
      "text": "و مرا تکه‌تکه کرد.",
      "usfm": "JOB.16.12"
    },
    {
      "verse": 12,
      "text": "حالا هم مرا هدف خود قرار داده،",
      "usfm": "JOB.16.12"
    },
    {
      "verse": 13,
      "text": "تیرهای خود را از هر سو به سوی من پرتاب می‌کند،",
      "usfm": "JOB.16.13"
    },
    {
      "verse": 13,
      "text": "مرا زخمی می‌کند",
      "usfm": "JOB.16.13"
    },
    {
      "verse": 13,
      "text": "و رحمی نشان نمی‌دهد.",
      "usfm": "JOB.16.13"
    },
    {
      "verse": 14,
      "text": "او مانند یک جنگجو حمله می‌کند",
      "usfm": "JOB.16.14"
    },
    {
      "verse": 14,
      "text": "و پی‌در‌پی مرا زخمی می‌کند.",
      "usfm": "JOB.16.14"
    },
    {
      "verse": 15,
      "text": "لباس سوگواری پوشیده",
      "usfm": "JOB.16.15"
    },
    {
      "verse": 15,
      "text": "و در خاک ذلّت نشسته‌ام.",
      "usfm": "JOB.16.15"
    },
    {
      "verse": 16,
      "text": "از بس گریه کرده‌ام، چشمانم سرخ شده",
      "usfm": "JOB.16.16"
    },
    {
      "verse": 16,
      "text": "و دیدگانم را تاریکی فراگرفته است.",
      "usfm": "JOB.16.16"
    },
    {
      "verse": 17,
      "text": "امّا من شخص شریری نیستم",
      "usfm": "JOB.16.17"
    },
    {
      "verse": 17,
      "text": "و دعای من از صمیم قلب است.",
      "usfm": "JOB.16.17"
    },
    {
      "verse": 18,
      "text": "ای زمین، خون مرا مپوشان",
      "usfm": "JOB.16.18"
    },
    {
      "verse": 18,
      "text": "و مگذار فریاد عدالت‌خواهی من خاموش گردد.",
      "usfm": "JOB.16.18"
    },
    {
      "verse": 19,
      "text": "شاهد من در آسمان است",
      "usfm": "JOB.16.19"
    },
    {
      "verse": 19,
      "text": "و برای من شفاعت می‌کند.",
      "usfm": "JOB.16.19"
    },
    {
      "verse": 20,
      "text": "دوستان من مسخره‌ام می‌کنند،",
      "usfm": "JOB.16.20"
    },
    {
      "verse": 20,
      "text": "امّا من سیل اشک را در حضور خدا جاری می‌سازم",
      "usfm": "JOB.16.20"
    },
    {
      "verse": 21,
      "text": "و نزد او التماس می‌کنم که به عنوان یک دوست به من گوش بدهد",
      "usfm": "JOB.16.21"
    },
    {
      "verse": 21,
      "text": "و حرفهای مرا بشنود.",
      "usfm": "JOB.16.21"
    },
    {
      "verse": 22,
      "text": "زیرا بزودی می‌میرم و به جایی می‌روم",
      "usfm": "JOB.16.22"
    },
    {
      "verse": 22,
      "text": "که از آنجا امید بازگشت نیست.",
      "usfm": "JOB.16.22"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/JOB/16.mp3"
}