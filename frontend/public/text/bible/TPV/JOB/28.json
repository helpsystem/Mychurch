{
  "translation": "TPV",
  "book": "JOB",
  "chapter": 28,
  "verses": [
    {
      "verse": 1,
      "text": "نقره از معدن استخراج می‌شود",
      "usfm": "JOB.28.1"
    },
    {
      "verse": 1,
      "text": "و طلا را در کوره تصفیه می‌کنند.",
      "usfm": "JOB.28.1"
    },
    {
      "verse": 2,
      "text": "آهن را از زمین به دست می‌آورند",
      "usfm": "JOB.28.2"
    },
    {
      "verse": 2,
      "text": "و مس را از ذوب کردن سنگها.",
      "usfm": "JOB.28.2"
    },
    {
      "verse": 3,
      "text": "مردم در اعماق تاریکی جستجو می‌کنند",
      "usfm": "JOB.28.3"
    },
    {
      "verse": 3,
      "text": "و برای سنگهای معدنی تا دورترین نقطهٔ زمین به جستجو می‌پردازند.",
      "usfm": "JOB.28.3"
    },
    {
      "verse": 4,
      "text": "فراتر از جایی که کسی زندگی کند",
      "usfm": "JOB.28.4"
    },
    {
      "verse": 4,
      "text": "یا پای بشری به آنجا رسیده باشد",
      "usfm": "JOB.28.4"
    },
    {
      "verse": 4,
      "text": "و از طنابها خود را آویزان کرده",
      "usfm": "JOB.28.4"
    },
    {
      "verse": 4,
      "text": "به درون می‌روند.",
      "usfm": "JOB.28.4"
    },
    {
      "verse": 5,
      "text": "سطح زمین خوراک به بار می‌آورد،",
      "usfm": "JOB.28.5"
    },
    {
      "verse": 5,
      "text": "درحالی‌که در زیر هستهٔ همین زمین،",
      "usfm": "JOB.28.5"
    },
    {
      "verse": 5,
      "text": "آتش مذاب نهفته است.",
      "usfm": "JOB.28.5"
    },
    {
      "verse": 6,
      "text": "سنگهای زمین دارای یاقوت",
      "usfm": "JOB.28.6"
    },
    {
      "verse": 6,
      "text": "و خاک آن دارای طلا می‌باشد.",
      "usfm": "JOB.28.6"
    },
    {
      "verse": 7,
      "text": "نه پرندگان شکاری راه آن معادن را می‌دانند",
      "usfm": "JOB.28.7"
    },
    {
      "verse": 7,
      "text": "و نه لاشخورها در بالای آنها پرواز کرده‌اند.",
      "usfm": "JOB.28.7"
    },
    {
      "verse": 8,
      "text": "شیر و حیوان درندهٔ دیگری",
      "usfm": "JOB.28.8"
    },
    {
      "verse": 8,
      "text": "در آن جاها قدم نزده‌ است.",
      "usfm": "JOB.28.8"
    },
    {
      "verse": 9,
      "text": "امّا مردم، سنگ خارا را می‌شکنند",
      "usfm": "JOB.28.9"
    },
    {
      "verse": 9,
      "text": "و کوهها را از بیخ می‌کنند،",
      "usfm": "JOB.28.9"
    },
    {
      "verse": 10,
      "text": "صخره‌‌ها را می‌شکافند",
      "usfm": "JOB.28.10"
    },
    {
      "verse": 10,
      "text": "و سنگهای نفیس به دست می‌آورند.",
      "usfm": "JOB.28.10"
    },
    {
      "verse": 11,
      "text": "سرچشمهٔ دریاها را می‌کاوند",
      "usfm": "JOB.28.11"
    },
    {
      "verse": 11,
      "text": "و چیزهای نهفته را بیرون می‌آورند.",
      "usfm": "JOB.28.11"
    },
    {
      "verse": 12,
      "text": "امّا حکمت را در کجا می‌توان یافت",
      "usfm": "JOB.28.12"
    },
    {
      "verse": 12,
      "text": "و دانش در کجا پیدا می‌شود؟",
      "usfm": "JOB.28.12"
    },
    {
      "verse": 13,
      "text": "انسان فانی راه آن را نمی‌داند",
      "usfm": "JOB.28.13"
    },
    {
      "verse": 13,
      "text": "و در دنیای زندگان پیدا نمی‌شود.",
      "usfm": "JOB.28.13"
    },
    {
      "verse": 14,
      "text": "اعماق اقیانوس‌ها می‌گویند که",
      "usfm": "JOB.28.14"
    },
    {
      "verse": 14,
      "text": "حکمت نزد ما نیست و در اینجا پیدا نمی‌شود.",
      "usfm": "JOB.28.14"
    },
    {
      "verse": 15,
      "text": "حکمت را نمی‌توان با طلا خرید",
      "usfm": "JOB.28.15"
    },
    {
      "verse": 15,
      "text": "و ارزش آن بیشتر از نقره است،",
      "usfm": "JOB.28.15"
    },
    {
      "verse": 16,
      "text": "گرانبهاتر است از",
      "usfm": "JOB.28.16"
    },
    {
      "verse": 16,
      "text": "طلا و جواهرات نفیس.",
      "usfm": "JOB.28.16"
    },
    {
      "verse": 17,
      "text": "طلا و الماس را نمی‌توان با حکمت برابر کرد",
      "usfm": "JOB.28.17"
    },
    {
      "verse": 17,
      "text": "و با جواهر و طلای نفیس مبادله نمی‌شود.",
      "usfm": "JOB.28.17"
    },
    {
      "verse": 18,
      "text": "ارزش حکمت بمراتب بالاتر از مرجان",
      "usfm": "JOB.28.18"
    },
    {
      "verse": 18,
      "text": "و بلور و گرانتر از لعل است.",
      "usfm": "JOB.28.18"
    },
    {
      "verse": 19,
      "text": "یاقوت کبود و طلای خالص را",
      "usfm": "JOB.28.19"
    },
    {
      "verse": 19,
      "text": "نمی‌توان با حکمت مقایسه کرد.",
      "usfm": "JOB.28.19"
    },
    {
      "verse": 20,
      "text": "پس حکمت را از کجا می‌توان به دست آورد",
      "usfm": "JOB.28.20"
    },
    {
      "verse": 20,
      "text": "و منشأ دانش کجاست؟",
      "usfm": "JOB.28.20"
    },
    {
      "verse": 21,
      "text": "حکمت از نظر تمام موجودات زنده پوشیده است",
      "usfm": "JOB.28.21"
    },
    {
      "verse": 21,
      "text": "و حتّی پرندگان هوا نیز آن را نمی‌بینند.",
      "usfm": "JOB.28.21"
    },
    {
      "verse": 22,
      "text": "مرگ و نیستی ادّعا می‌کنند",
      "usfm": "JOB.28.22"
    },
    {
      "verse": 22,
      "text": "که فقط شایعه‌ای از آن شنیده‌اند.",
      "usfm": "JOB.28.22"
    },
    {
      "verse": 23,
      "text": "تنها خدا راه حکمت را می‌شناسد",
      "usfm": "JOB.28.23"
    },
    {
      "verse": 23,
      "text": "و می‌داند آن را در کجا می‌توان یافت.",
      "usfm": "JOB.28.23"
    },
    {
      "verse": 24,
      "text": "زیرا هیچ گوشهٔ زمین از او پوشیده نیست،",
      "usfm": "JOB.28.24"
    },
    {
      "verse": 24,
      "text": "و هر چیزی را که در زیر آسمان است می‌بیند.",
      "usfm": "JOB.28.24"
    },
    {
      "verse": 25,
      "text": "خدا، به باد قدرت وزیدن می‌دهد",
      "usfm": "JOB.28.25"
    },
    {
      "verse": 25,
      "text": "و حدود و اندازهٔ دریاها را تعیین می‌کند.",
      "usfm": "JOB.28.25"
    },
    {
      "verse": 26,
      "text": "به باران فرمان می‌دهد که در کجا ببارد",
      "usfm": "JOB.28.26"
    },
    {
      "verse": 26,
      "text": "و برق و صاعقه در کدام مسیر تولید شوند.",
      "usfm": "JOB.28.26"
    },
    {
      "verse": 27,
      "text": "پس او می‌داند که حکمت در کجاست.",
      "usfm": "JOB.28.27"
    },
    {
      "verse": 27,
      "text": "او آن را امتحان کرد، ارزش آن را دیده تأیید فرمود.",
      "usfm": "JOB.28.27"
    },
    {
      "verse": 28,
      "text": "آنگاه به بشر گفت:",
      "usfm": "JOB.28.28"
    },
    {
      "verse": 28,
      "text": "«به یقین بدانید که ترس از خداوند، حکمت واقعی",
      "usfm": "JOB.28.28"
    },
    {
      "verse": 28,
      "text": "و پرهیزکردن از شرارت، دانش حقیقی است.»",
      "usfm": "JOB.28.28"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/JOB/28.mp3"
}