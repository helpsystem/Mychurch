  "verses": [
    {
      "verse": 1,
      "text": "آنگاه بلدد شوحی جواب داد:",
      "usfm": "JOB.25.1"
    },
    {
      "verse": 2,
      "text": "«سلطنت و هیبت از آن خداست",
      "usfm": "JOB.25.2"
    },
    {
      "verse": 2,
      "text": "و او صلح را در آسمانها برقرار می‌کند.",
      "usfm": "JOB.25.2"
    },
    {
      "verse": 3,
      "text": "کسی نمی‌تواند شمارهٔ فرشتگانی را که در خدمت او هستند، بداند.",
      "usfm": "JOB.25.3"
    },
    {
      "verse": 3,
      "text": "نور خدا بر همه‌کس و در همه‌جا می‌تابد.",
      "usfm": "JOB.25.3"
    },
    {
      "verse": 4,
      "text": "آیا انسان فانی می‌تواند در نظر خدا پاک و بی‌عیب باشد؟",
      "usfm": "JOB.25.4"
    },
    {
      "verse": 5,
      "text": "حتّی مهتاب و ستارگان در نظر او درخشنده",
      "usfm": "JOB.25.5"
    },
    {
      "verse": 5,
      "text": "و پاک نیستند،",
      "usfm": "JOB.25.5"
    },
    {
      "verse": 6,
      "text": "چه رسد به انسان خاکی که کِرمی بیش نیست.",
      "usfm": "JOB.25.6"
    },
    {
      "verse": 6,
      "text": "زندگی انسان چه ارزشی در نظر خدا دارد؟»",
      "usfm": "JOB.25.6"
    }
  ],
