{
  "translation": "TPV",
  "book": "SNG",
  "chapter": 5,
  "verses": [
    {
      "verse": 1,
      "text": "ای دلبر من و ای عروس من،",
      "usfm": "SNG.5.1"
    },
    {
      "verse": 1,
      "text": "من به باغ خود آمده‌‌ام.",
      "usfm": "SNG.5.1"
    },
    {
      "verse": 1,
      "text": "مُر و ادویه‌جاتم را می‌چینم.",
      "usfm": "SNG.5.1"
    },
    {
      "verse": 1,
      "text": "عسل و شانهٔ عسل خود را می‌خورم",
      "usfm": "SNG.5.1"
    },
    {
      "verse": 1,
      "text": "و شراب و شیر خود را می‌نوشم.",
      "usfm": "SNG.5.1"
    },
    {
      "verse": 1,
      "text": "ای دلدادگان بنوشید",
      "usfm": "SNG.5.1"
    },
    {
      "verse": 1,
      "text": "و از مستی عشق سرمست شوید.",
      "usfm": "SNG.5.1"
    },
    {
      "verse": 2,
      "text": "من خواب هستم، امّا دلم بیدار است.",
      "usfm": "SNG.5.2"
    },
    {
      "verse": 2,
      "text": "در عالم خواب صدای محبوبم را می‌شنوم که در می‌زند و می‌گوید:",
      "usfm": "SNG.5.2"
    },
    {
      "verse": 2,
      "text": "«در را بازکن ای عزیز من،",
      "usfm": "SNG.5.2"
    },
    {
      "verse": 2,
      "text": "ای عشق من، ای کبوتر من",
      "usfm": "SNG.5.2"
    },
    {
      "verse": 2,
      "text": "و ای آنکه در جمال و زیبایی کامل هستی،",
      "usfm": "SNG.5.2"
    },
    {
      "verse": 2,
      "text": "زیرا سرم از شبنم سحرگاهی و حلقه‌های مویم از نم‌نم باران شب، ‌تَر است.»",
      "usfm": "SNG.5.2"
    },
    {
      "verse": 3,
      "text": "لباسم را از تن بیرون کردم،",
      "usfm": "SNG.5.3"
    },
    {
      "verse": 3,
      "text": "چگونه می‌توانم آن را دوباره بپوشم؟",
      "usfm": "SNG.5.3"
    },
    {
      "verse": 3,
      "text": "پاهایم را شستم،",
      "usfm": "SNG.5.3"
    },
    {
      "verse": 3,
      "text": "چطور می‌توانم آنها را دوباره کثیف نمایم؟",
      "usfm": "SNG.5.3"
    },
    {
      "verse": 4,
      "text": "محبوبم دست خود را از سوراخ در داخل کرد.",
      "usfm": "SNG.5.4"
    },
    {
      "verse": 4,
      "text": "تمام وجودم به لرزه درآمد.",
      "usfm": "SNG.5.4"
    },
    {
      "verse": 5,
      "text": "برخاستم تا در را برایش باز کنم.",
      "usfm": "SNG.5.5"
    },
    {
      "verse": 5,
      "text": "دستانم به مُر آغشته بود.",
      "usfm": "SNG.5.5"
    },
    {
      "verse": 5,
      "text": "از انگشتانم مُر می‌چکید،",
      "usfm": "SNG.5.5"
    },
    {
      "verse": 5,
      "text": "هنگامی‌که قفل را به دست گرفتم.",
      "usfm": "SNG.5.5"
    },
    {
      "verse": 6,
      "text": "امّا وقتی در را بازکردم،",
      "usfm": "SNG.5.6"
    },
    {
      "verse": 6,
      "text": "محبوبم رفته بود.",
      "usfm": "SNG.5.6"
    },
    {
      "verse": 6,
      "text": "چقدر دلم می‌خواست که صدایش را بشنوم.",
      "usfm": "SNG.5.6"
    },
    {
      "verse": 6,
      "text": "به جستجویش رفتم، امّا او را نیافتم.",
      "usfm": "SNG.5.6"
    },
    {
      "verse": 6,
      "text": "صدایش کردم، ولی جواب نداد.",
      "usfm": "SNG.5.6"
    },
    {
      "verse": 7,
      "text": "پاسبانان شب مرا یافتند،",
      "usfm": "SNG.5.7"
    },
    {
      "verse": 7,
      "text": "مرا زدند و زخمی کردند.",
      "usfm": "SNG.5.7"
    },
    {
      "verse": 7,
      "text": "نگهبانان دیوارهای شهر، قبای مرا ربودند.",
      "usfm": "SNG.5.7"
    },
    {
      "verse": 8,
      "text": "ای دختران اورشلیم، شما را قسم می‌دهم",
      "usfm": "SNG.5.8"
    },
    {
      "verse": 8,
      "text": "که اگر محبوب مرا یافتید،",
      "usfm": "SNG.5.8"
    },
    {
      "verse": 8,
      "text": "به او بگویید که من بیمار عشق او هستم.",
      "usfm": "SNG.5.8"
    },
    {
      "verse": 9,
      "text": "ای زیباترین خوبرویان،",
      "usfm": "SNG.5.9"
    },
    {
      "verse": 9,
      "text": "محبوب تو بر مردان دیگر چه برتری و فضیلتی دارد",
      "usfm": "SNG.5.9"
    },
    {
      "verse": 9,
      "text": "که ما را این چنین قسم می‌دهی؟",
      "usfm": "SNG.5.9"
    },
    {
      "verse": 10,
      "text": "محبوب من زیبا و قوی است",
      "usfm": "SNG.5.10"
    },
    {
      "verse": 10,
      "text": "و در بین ده هزار جوان ممتاز می‌باشد.",
      "usfm": "SNG.5.10"
    },
    {
      "verse": 11,
      "text": "چهره او درخشان و برنزی می‌باشد",
      "usfm": "SNG.5.11"
    },
    {
      "verse": 11,
      "text": "موهایش پُرچین و شکن",
      "usfm": "SNG.5.11"
    },
    {
      "verse": 11,
      "text": "و سیاه مثل کلاغ می‌باشد.",
      "usfm": "SNG.5.11"
    },
    {
      "verse": 12,
      "text": "چشمانش به زیبایی کبوترانی است",
      "usfm": "SNG.5.12"
    },
    {
      "verse": 12,
      "text": "که در کنار چشمه آب نشسته و گویی خود را در شیر شسته‌اند.",
      "usfm": "SNG.5.12"
    },
    {
      "verse": 13,
      "text": "گونه‌هایش مانند باغچه‌ای است",
      "usfm": "SNG.5.13"
    },
    {
      "verse": 13,
      "text": "پُر از گُلهای خوشبو و معطر.",
      "usfm": "SNG.5.13"
    },
    {
      "verse": 13,
      "text": "لبانش همچون سوسن‌هایی است",
      "usfm": "SNG.5.13"
    },
    {
      "verse": 13,
      "text": "که از آنها عطر مُر می‌چکد.",
      "usfm": "SNG.5.13"
    },
    {
      "verse": 14,
      "text": "دستهای خوش‌تراش‌ او مانند میلهٔ طلایی است",
      "usfm": "SNG.5.14"
    },
    {
      "verse": 14,
      "text": "که با جواهر آراسته شده باشد.",
      "usfm": "SNG.5.14"
    },
    {
      "verse": 14,
      "text": "پیکرش همچون عاج شفافی است",
      "usfm": "SNG.5.14"
    },
    {
      "verse": 14,
      "text": "که با یاقوت مزیّن شده باشد.",
      "usfm": "SNG.5.14"
    },
    {
      "verse": 15,
      "text": "ساقهایش مانند ستونهای مرمرند",
      "usfm": "SNG.5.15"
    },
    {
      "verse": 15,
      "text": "که بر پایه‌هایی از طلای ناب قرار داشته باشند.",
      "usfm": "SNG.5.15"
    },
    {
      "verse": 15,
      "text": "چهره‌اش همانند سروهای آزاد لبنان بی‌نظیر است.",
      "usfm": "SNG.5.15"
    },
    {
      "verse": 16,
      "text": "کلام او شیرین و همه‌چیزش زیبا و دلکش است.",
      "usfm": "SNG.5.16"
    },
    {
      "verse": 16,
      "text": "ای دختران اورشلیم، دلدار من این‌همه برتری دارد.",
      "usfm": "SNG.5.16"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/SNG/5.mp3"
}