    },
    {
      "verse": 21,
      "text": "نتنئیل",
      "usfm": "NEH.12.12+NEH.12.13+NEH.12.14+NEH.12.15+NEH.12.16+NEH.12.17+NEH.12.18+NEH.12.19+NEH.12.20+NEH.12.21"
