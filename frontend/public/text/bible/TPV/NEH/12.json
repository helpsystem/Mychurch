    {
      "verse": 21,
      "text": "یدعیا",
      "usfm": "NEH.12.12+NEH.12.13+NEH.12.14+NEH.12.15+NEH.12.16+NEH.12.17+NEH.12.18+NEH.12.19+NEH.12.20+NEH.12.21"
    },
    {
      "verse": 22,
      "text": "هنگامی که الیاشیب، یهویاداع، یوحانان و یدوع، کاهن اعظم بودند، نامهای رؤسای خانواده‌های کاهنان و لاویان ثبت شده بود. این ثبت نام در زمان سلطنت داریوش شاهنشاه پارس، به اتمام رسید.",
      "usfm": "NEH.12.22"
    },
    {
      "verse": 23,
      "text": "ولی نامهای سران لاویان و کاهنان فقط تا زمان یوحانان پسر الیاشیب در دفاتر رسمی ثبت شده بودند.",
      "usfm": "NEH.12.23"
    },
    {
      "verse": 24,
      "text": "لاویان به سرپرستی حشبیا، شربیا، یشوع، بنوی، و قدمیئیل به گروههایی تقسیم شدند و مطابق دستورات داوود پادشاه، مرد خدا، دو گروه در برابر یکدیگر می‌ایستادند و در پاسخ به یکدیگر سرودهای سپاسگزاری برای خدا می‌خواندند.",
      "usfm": "NEH.12.24"
    },
    {
      "verse": 25,
      "text": "نگهبانانی که از انبارهای معبد در نزدیکی دروازه‌های آن نگهبانی می‌کردند عبارت بودند از: متنیا، بقیقیا، عوبدیا، مشلام، طلمون و عقوب.",
      "usfm": "NEH.12.25"
    },
    {
      "verse": 26,
      "text": "این افراد در زمان یویاقیم پسر یهوشع، نوهٔ یهوصادوق، نحمیای فرماندار و عزرای کاهن و عالِم تورات زندگی می‌کردند.",
      "usfm": "NEH.12.26"
    },
    {
      "verse": 27,
      "text": "هنگامی‌که دیوارهای شهر تقدیس شدند، لاویان از هر جایی که زندگی می‌کردند، فراخوانده شدند تا در سراییدن سرودهای سپاسگزاری به همراه نوای سنج و بربط و چنگ شرکت کنند.",
      "usfm": "NEH.12.27"
    },
    {
      "verse": 28,
      "text": "خانواده‌های لاویانِ سراینده از محلهایی که در اطراف اورشلیم و روستاهای نطوفات ساکن شده بودند",
      "usfm": "NEH.12.28"
    },
    {
      "verse": 29,
      "text": "و بیت جلجال، جبع و عزموت گرد آمدند.",
      "usfm": "NEH.12.29"
    },
    {
      "verse": 30,
      "text": "کاهنان و لاویان مراسم پاکیزگی را برای خود و سپس برای قوم، دروازه‌ها و دیوار شهر انجام دادند.",
      "usfm": "NEH.12.30"
    },
    {
      "verse": 31,
      "text": "من رهبران یهودا را در بالای دیوار گرد آوردم و مسئولیّت دو گروه بزرگ را به ایشان سپردم که در پیرامون شهر گام بردارند و از خدا سپاسگزاری کنند.",
      "usfm": "NEH.12.31"
    },
    {
      "verse": 31,
      "text": "گروه نخست از روی دیوار به سمت راست به سوی دروازهٔ خاکروبه رفت.",
      "usfm": "NEH.12.31"
    },
    {
      "verse": 32,
      "text": "هوشعیا به دنبال سرایندگان گام برداشت و نیمی از رهبران یهودا به دنبال او رفتند.",
      "usfm": "NEH.12.32"
    },
    {
      "verse": 35,
      "text": "این کاهنان درحالی‌که شیپور می‌زدند به دنبال ایشان رفتند: عزریا و عزرا و مشلام و یهودا و بنیامین و شمعیا و ارمیا و بعد از ایشان زکریا پسر یوناتان، یوناتان پسر شمعیا، شمعیا پسر متنیا، متنیا پسر میکایا، میکایا پسر زکور، زکور پسر آساف.",
      "usfm": "NEH.12.33+NEH.12.34+NEH.12.35"
    },
    {
      "verse": 36,
      "text": "از خاندان او شمعیا، عزرئیل، مِللای، جِلَلای، ماعای، نتنئیل، یهودا، و حنانی سازهایی که شبیه سازهای داوود پادشاه مَرد خدا بود، با خود حمل می‌کردند. عزرا عالِم تورات گروه مزبور را در راهپیمایی رهبری می‌کرد.",
      "usfm": "NEH.12.36"
    },
    {
      "verse": 37,
      "text": "نزدیک دروازهٔ چشمه از پلّه‌هایی که به شهر داوود می‌رسید بالا رفتند، از کاخ داوود گذشتند و به طرف دیوار نزد دروازهٔ آب در سمت شرقی شهر بازگشتند.",
      "usfm": "NEH.12.37"
    },
    {
      "verse": 38,
      "text": "گروه دیگری که سپاسگزاری می‌کرد، از روی دیوار به سمت چپ رفت و من به همراه نیمی از مردم به دنبال ایشان رفتیم. ما از بُرج تنور و دیوار پهن گذشتیم.",
      "usfm": "NEH.12.38"
    },
    {
      "verse": 39,
      "text": "سپس از دروازهٔ افرایم، دروازهٔ یشانه، دروازهٔ ماهی و بُرج حننئیل و بُرج صد گذشتیم تا به دروازهٔ گوسفند رسیدیم. ما راهپیمایی خود را در دروازهٔ محافظین پایان دادیم.",
      "usfm": "NEH.12.39"
    },
    {
      "verse": 40,
      "text": "بنابراین دو گروهی که سرود شکرگزاری می‌خواند وارد معبد بزرگ شدند.",
      "usfm": "NEH.12.40"
    },
    {
      "verse": 40,
      "text": "علاوه بر رهبرانی که با من بودند،",
      "usfm": "NEH.12.40"
    },
