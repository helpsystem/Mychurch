      "usfm": "NUM.33.15+NUM.33.16+NUM.33.17+NUM.33.18+NUM.33.19+NUM.33.20+NUM.33.21+NUM.33.22+NUM.33.23+NUM.33.24+NUM.33.25+NUM.33.26+NUM.33.27+NUM.33.28+NUM.33.29+NUM.33.30+NUM.33.31+NUM.33.32+NUM.33.33+NUM.33.34+NUM.33.35+NUM.33.36+NUM.33.37"
    },
    {
      "verse": 37,
      "text": "از تاحت به تارح،",
      "usfm": "NUM.33.15+NUM.33.16+NUM.33.17+NUM.33.18+NUM.33.19+NUM.33.20+NUM.33.21+NUM.33.22+NUM.33.23+NUM.33.24+NUM.33.25+NUM.33.26+NUM.33.27+NUM.33.28+NUM.33.29+NUM.33.30+NUM.33.31+NUM.33.32+NUM.33.33+NUM.33.34+NUM.33.35+NUM.33.36+NUM.33.37"
    },
    {
      "verse": 37,
      "text": "از تارح به متقه،",
      "usfm": "NUM.33.15+NUM.33.16+NUM.33.17+NUM.33.18+NUM.33.19+NUM.33.20+NUM.33.21+NUM.33.22+NUM.33.23+NUM.33.24+NUM.33.25+NUM.33.26+NUM.33.27+NUM.33.28+NUM.33.29+NUM.33.30+NUM.33.31+NUM.33.32+NUM.33.33+NUM.33.34+NUM.33.35+NUM.33.36+NUM.33.37"
    },
    {
      "verse": 37,
      "text": "از متقه به حشمونه،",
      "usfm": "NUM.33.15+NUM.33.16+NUM.33.17+NUM.33.18+NUM.33.19+NUM.33.20+NUM.33.21+NUM.33.22+NUM.33.23+NUM.33.24+NUM.33.25+NUM.33.26+NUM.33.27+NUM.33.28+NUM.33.29+NUM.33.30+NUM.33.31+NUM.33.32+NUM.33.33+NUM.33.34+NUM.33.35+NUM.33.36+NUM.33.37"
    },
    {
      "verse": 37,
      "text": "از حشمونه به مسیروت،",
      "usfm": "NUM.33.15+NUM.33.16+NUM.33.17+NUM.33.18+NUM.33.19+NUM.33.20+NUM.33.21+NUM.33.22+NUM.33.23+NUM.33.24+NUM.33.25+NUM.33.26+NUM.33.27+NUM.33.28+NUM.33.29+NUM.33.30+NUM.33.31+NUM.33.32+NUM.33.33+NUM.33.34+NUM.33.35+NUM.33.36+NUM.33.37"
    },
    {
      "verse": 37,
      "text": "از مسیروت به بنی‌یعقان،",
      "usfm": "NUM.33.15+NUM.33.16+NUM.33.17+NUM.33.18+NUM.33.19+NUM.33.20+NUM.33.21+NUM.33.22+NUM.33.23+NUM.33.24+NUM.33.25+NUM.33.26+NUM.33.27+NUM.33.28+NUM.33.29+NUM.33.30+NUM.33.31+NUM.33.32+NUM.33.33+NUM.33.34+NUM.33.35+NUM.33.36+NUM.33.37"
    },
    {
      "verse": 37,
      "text": "از بنی‌یعقان به حورالجدجاد،",
      "usfm": "NUM.33.15+NUM.33.16+NUM.33.17+NUM.33.18+NUM.33.19+NUM.33.20+NUM.33.21+NUM.33.22+NUM.33.23+NUM.33.24+NUM.33.25+NUM.33.26+NUM.33.27+NUM.33.28+NUM.33.29+NUM.33.30+NUM.33.31+NUM.33.32+NUM.33.33+NUM.33.34+NUM.33.35+NUM.33.36+NUM.33.37"
    },
    {
      "verse": 37,
      "text": "از حورالجدجاد به یُطبات،",
      "usfm": "NUM.33.15+NUM.33.16+NUM.33.17+NUM.33.18+NUM.33.19+NUM.33.20+NUM.33.21+NUM.33.22+NUM.33.23+NUM.33.24+NUM.33.25+NUM.33.26+NUM.33.27+NUM.33.28+NUM.33.29+NUM.33.30+NUM.33.31+NUM.33.32+NUM.33.33+NUM.33.34+NUM.33.35+NUM.33.36+NUM.33.37"
    },
    {
      "verse": 37,
      "text": "از یطبات به عبرونه،",
      "usfm": "NUM.33.15+NUM.33.16+NUM.33.17+NUM.33.18+NUM.33.19+NUM.33.20+NUM.33.21+NUM.33.22+NUM.33.23+NUM.33.24+NUM.33.25+NUM.33.26+NUM.33.27+NUM.33.28+NUM.33.29+NUM.33.30+NUM.33.31+NUM.33.32+NUM.33.33+NUM.33.34+NUM.33.35+NUM.33.36+NUM.33.37"
    },
    {
      "verse": 37,
      "text": "از عبرونه به عِصیون جابر،",
      "usfm": "NUM.33.15+NUM.33.16+NUM.33.17+NUM.33.18+NUM.33.19+NUM.33.20+NUM.33.21+NUM.33.22+NUM.33.23+NUM.33.24+NUM.33.25+NUM.33.26+NUM.33.27+NUM.33.28+NUM.33.29+NUM.33.30+NUM.33.31+NUM.33.32+NUM.33.33+NUM.33.34+NUM.33.35+NUM.33.36+NUM.33.37"
    },
    {
      "verse": 37,
      "text": "از عصیون جابر به قادش در بیابان صین،",
      "usfm": "NUM.33.15+NUM.33.16+NUM.33.17+NUM.33.18+NUM.33.19+NUM.33.20+NUM.33.21+NUM.33.22+NUM.33.23+NUM.33.24+NUM.33.25+NUM.33.26+NUM.33.27+NUM.33.28+NUM.33.29+NUM.33.30+NUM.33.31+NUM.33.32+NUM.33.33+NUM.33.34+NUM.33.35+NUM.33.36+NUM.33.37"
    },
    {
      "verse": 37,
      "text": "از قادش به کوه هور در مرز سرزمین اَدوم.",
      "usfm": "NUM.33.15+NUM.33.16+NUM.33.17+NUM.33.18+NUM.33.19+NUM.33.20+NUM.33.21+NUM.33.22+NUM.33.23+NUM.33.24+NUM.33.25+NUM.33.26+NUM.33.27+NUM.33.28+NUM.33.29+NUM.33.30+NUM.33.31+NUM.33.32+NUM.33.33+NUM.33.34+NUM.33.35+NUM.33.36+NUM.33.37"
    },
    {
      "verse": 39,
      "text": "در اینجا بود که خداوند به هارون کاهن فرمود که به بالای کوه هور برود و او در روز اول ماه پنجم سال چهلم، بعد از آن که قوم اسرائیل از سرزمین مصر خارج شدند، در سن صد و بیست و سه سالگی وفات یافت.",
      "usfm": "NUM.33.38+NUM.33.39"
    },
    {
      "verse": 40,
      "text": "پادشاه عراد واقع در قسمت جنوب کنعان، از آمدن قوم اسرائیل باخبر شد.",
      "usfm": "NUM.33.40"
    },
    {
      "verse": 49,
      "text": "سپس قوم اسرائیل از کوه هور حرکت کرده، رهسپار صلمونه شدند. از صلمونه به فونون، بعد به اوبوت، عیی عباریم (مرز موآب)، دیبون جاد، علمون دبلاتایم و سپس در کوهستان عباریم، در نزدیکی کوه نَبو، اردو زدند. بالاخره به دشت موآب رسیدند که در کنار رود اردن، مقابل شهر اریحا بود. و در آنجا در کنار رود اردن از بیت یشیموت تا آبل درّهٔ اقاقیا، در دشت موآب اردو زدند.",
      "usfm": "NUM.33.41+NUM.33.42+NUM.33.43+NUM.33.44+NUM.33.45+NUM.33.46+NUM.33.47+NUM.33.48+NUM.33.49"
    },
    {
      "verse": 50,
      "text": "در همین جا، یعنی در کنار رود اردن، مقابل شهر اریحا بود که خداوند",
      "usfm": "NUM.33.50"
    },
    {
      "verse": 51,
      "text": "این دستورات را به موسی داد: «وقتی از رود اردن عبور کردید، به سرزمین کنعان رسیدید،",
      "usfm": "NUM.33.51"
    },
    {
      "verse": 52,
      "text": "باید تمام ساکنان آنجا را بیرون برانید. همهٔ بُتهای سنگی و فلزی آنها را از بین ببرید و پرستشگاههای بالای تپّه‌های ایشان را ویران کنید.",
      "usfm": "NUM.33.52"
    },
    {
      "verse": 53,
      "text": "سرزمینشان را متصرّف شوید و در آنجا سکونت اختیار نمایید، زیرا من آن سرزمین را به شما داده‌ام.",
      "usfm": "NUM.33.53"
    },
    {
      "verse": 54,
      "text": "زمین آنجا را بین طایفه‌های اسرائیل به قید قرعه تقسیم کنید. به خاندان بزرگتر، زمین زیادتر و به خاندان کوچکتر، زمین کمتر داده شود.",
      "usfm": "NUM.33.54"
    },
    {
      "verse": 55,
      "text": "اگر شما ساکنان آنجا را نرانید، کسانی‌که باقی بمانند، مثل خار در چشم شما و مانند تیغ در پهلویتان بوده، موجب آزارتان می‌شوند.",
      "usfm": "NUM.33.55"
    },
    {
      "verse": 56,
      "text": "و من هم همان طوری ‌که می‌خواستم با آنها رفتار کنم، با شما هم همان رفتار را می‌نمایم.»",
      "usfm": "NUM.33.56"
    }
  ],
