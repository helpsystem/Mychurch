{
  "translation": "TPV",
  "book": "ISA",
  "chapter": 12,
  "verses": [
    {
      "verse": 1,
      "text": "روزی می‌آید که مردم می‌سرایند و می‌گویند:",
      "usfm": "ISA.12.1"
    },
    {
      "verse": 1,
      "text": "«خداوندا تو را ستایش می‌کنم. تو از من خشمگین بودی!",
      "usfm": "ISA.12.1"
    },
    {
      "verse": 1,
      "text": "امّا دیگر خشمگین نیستی و مرا تسلّی می‌دهی.",
      "usfm": "ISA.12.1"
    },
    {
      "verse": 2,
      "text": "خداوند، نجات‌دهندهٔ من است.",
      "usfm": "ISA.12.2"
    },
    {
      "verse": 2,
      "text": "من به او توکّل می‌کنم و دیگر ترسان نیستم.",
      "usfm": "ISA.12.2"
    },
    {
      "verse": 2,
      "text": "خداوند به من قدّرت و توانایی می‌بخشد،",
      "usfm": "ISA.12.2"
    },
    {
      "verse": 2,
      "text": "او نجات‌دهندهٔ من است.",
      "usfm": "ISA.12.2"
    },
    {
      "verse": 3,
      "text": "همان‌قدر که آب گوارا به جانهای تشنه صفا می‌بخشد،",
      "usfm": "ISA.12.3"
    },
    {
      "verse": 3,
      "text": "همان اندازه قوم خدا از نجاتی که او به آنها می‌دهد، خشنودند.»",
      "usfm": "ISA.12.3"
    },
    {
      "verse": 4,
      "text": "روزی می‌آید که مردم می‌سرایند و می‌گویند:",
      "usfm": "ISA.12.4"
    },
    {
      "verse": 4,
      "text": "«خداوند را سپاس گویید، از او مدد بخواهید!",
      "usfm": "ISA.12.4"
    },
    {
      "verse": 4,
      "text": "به همهٔ ملّتها بگویید او چه کرده است!",
      "usfm": "ISA.12.4"
    },
    {
      "verse": 4,
      "text": "به آنها بگویید او چقدر بزرگ است!",
      "usfm": "ISA.12.4"
    },
    {
      "verse": 5,
      "text": "برای کارهای بزرگ خداوند سرودی تازه بسرایید،",
      "usfm": "ISA.12.5"
    },
    {
      "verse": 5,
      "text": "به تمام مردم دنیا این خبر را برسانید،",
      "usfm": "ISA.12.5"
    },
    {
      "verse": 6,
      "text": "همهٔ کسانی‌که در صهیون هستند، با فریاد بسرایند!",
      "usfm": "ISA.12.6"
    },
    {
      "verse": 6,
      "text": "خدای قدّوس اسرائیل عظیم است،",
      "usfm": "ISA.12.6"
    },
    {
      "verse": 6,
      "text": "و در میان قوم خود زندگی می‌کند.»",
      "usfm": "ISA.12.6"
    }
  ],
