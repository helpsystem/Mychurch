{
  "translation": "TPV",
  "book": "HAB",
  "chapter": 3,
  "verses": [
    {
      "verse": 1,
      "text": "این است دعای حبقوق نبی:",
      "usfm": "HAB.3.1"
    },
    {
      "verse": 2,
      "text": "خداوندا، خبری را که به من فرمودی شنیدم",
      "usfm": "HAB.3.2"
    },
    {
      "verse": 2,
      "text": "و از شنیدن آن ترس مرا فراگرفت.",
      "usfm": "HAB.3.2"
    },
    {
      "verse": 2,
      "text": "بار دیگر کارهای عظیمی را که در دوران گذشته انجام می‌دادی",
      "usfm": "HAB.3.2"
    },
    {
      "verse": 2,
      "text": "به ما نشان بده",
      "usfm": "HAB.3.2"
    },
    {
      "verse": 2,
      "text": "و در هنگام غضب خود، رحمتت را به یاد آور.",
      "usfm": "HAB.3.2"
    },
    {
      "verse": 3,
      "text": "خدا از اَدوم برمی‌گردد؛",
      "usfm": "HAB.3.3"
    },
    {
      "verse": 3,
      "text": "خدای قدّوس از کوهستان فاران می‌آید.",
      "usfm": "HAB.3.3"
    },
    {
      "verse": 3,
      "text": "جلال او آسمانها را پوشانده،",
      "usfm": "HAB.3.3"
    },
    {
      "verse": 3,
      "text": "و زمین از ستایش او پر است.",
      "usfm": "HAB.3.3"
    },
    {
      "verse": 4,
      "text": "پرتو او مثل نورِ برق درخشان است",
      "usfm": "HAB.3.4"
    },
    {
      "verse": 4,
      "text": "و از دستهایش که قدرت او در آنها نهفته است، نور می‌تابد.",
      "usfm": "HAB.3.4"
    },
    {
      "verse": 5,
      "text": "مرض را پیشاپیش خود می‌فرستد",
      "usfm": "HAB.3.5"
    },
    {
      "verse": 5,
      "text": "و به مرگ امر می‌کند که به دنبالش بیاید.",
      "usfm": "HAB.3.5"
    },
    {
      "verse": 6,
      "text": "هنگامی‌که می‌ایستد، زمین می‌لرزد",
      "usfm": "HAB.3.6"
    },
    {
      "verse": 6,
      "text": "وقتی نگاه می‌کند، قومها از ترس می‌لرزند.",
      "usfm": "HAB.3.6"
    },
    {
      "verse": 6,
      "text": "کوههای جاودانی خُرد می‌شوند",
      "usfm": "HAB.3.6"
    },
    {
      "verse": 6,
      "text": "و تپّه‌های ابدی که در زمانهای قدیم بر آنها قدم می‌زد،",
      "usfm": "HAB.3.6"
    },
    {
      "verse": 6,
      "text": "از هم پاشیده می‌شوند.",
      "usfm": "HAB.3.6"
    },
    {
      "verse": 7,
      "text": "مردم کوشان را ترسان",
      "usfm": "HAB.3.7"
    },
    {
      "verse": 7,
      "text": "و مدیان را لرزان دیدم.",
      "usfm": "HAB.3.7"
    },
    {
      "verse": 8,
      "text": "خداوندا، آیا رودها تو را خشمگین ساختند؟",
      "usfm": "HAB.3.8"
    },
    {
      "verse": 8,
      "text": "آیا دریاها تو را غضبناک کردند؟",
      "usfm": "HAB.3.8"
    },
    {
      "verse": 8,
      "text": "که بر بالای ابرها عبور کردی؛",
      "usfm": "HAB.3.8"
    },
    {
      "verse": 8,
      "text": "و ابرهای توفانی ارّابه‌ات گشتند،",
      "usfm": "HAB.3.8"
    },
    {
      "verse": 8,
      "text": "و تو پیروزی برای مردم خود آوردی.",
      "usfm": "HAB.3.8"
    },
    {
      "verse": 9,
      "text": "کمانت را آماده کردی",
      "usfm": "HAB.3.9"
    },
    {
      "verse": 9,
      "text": "و تیرت را در کمان گذاشتی",
      "usfm": "HAB.3.9"
    },
    {
      "verse": 9,
      "text": "و زمین را با صاعقه شکافتی.",
      "usfm": "HAB.3.9"
    },
    {
      "verse": 10,
      "text": "کوهها تو را دیدند و به لرزه افتادند.",
      "usfm": "HAB.3.10"
    },
    {
      "verse": 10,
      "text": "سیلابها جاری شدند،",
      "usfm": "HAB.3.10"
    },
    {
      "verse": 10,
      "text": "آبهای عمیق خروشیدند",
      "usfm": "HAB.3.10"
    },
    {
      "verse": 10,
      "text": "و امواجشان بالا آمد.",
      "usfm": "HAB.3.10"
    },
    {
      "verse": 11,
      "text": "از نور تیرهایت و از پرتو نیزه‌های درخشانت",
      "usfm": "HAB.3.11"
    },
    {
      "verse": 11,
      "text": "آفتاب و مهتاب ایستادند.",
      "usfm": "HAB.3.11"
    },
    {
      "verse": 12,
      "text": "با قهر و غضب، جهان را پیمودی و با خشم،",
      "usfm": "HAB.3.12"
    },
    {
      "verse": 12,
      "text": "اقوام دنیا را پایمال کردی.",
      "usfm": "HAB.3.12"
    },
    {
      "verse": 13,
      "text": "برای نجات قوم خود شتافتی",
      "usfm": "HAB.3.13"
    },
    {
      "verse": 13,
      "text": "و پادشاه برگزیده‌ات را نجات دادی.",
      "usfm": "HAB.3.13"
    },
    {
      "verse": 13,
      "text": "رهبرِ شریران را نابود کردی",
      "usfm": "HAB.3.13"
    },
    {
      "verse": 13,
      "text": "و پیروانشان را بکلّی از بین بردی.",
      "usfm": "HAB.3.13"
    },
    {
      "verse": 14,
      "text": "جنگجویان دشمن مانند گردباد آمدند",
      "usfm": "HAB.3.14"
    },
    {
      "verse": 14,
      "text": "تا ما را پراکنده کنند",
      "usfm": "HAB.3.14"
    },
    {
      "verse": 14,
      "text": "و می‌خواستند که مردم مسکین را از بین ببرند، امّا تیرهای تو سر آنها را شکافت.",
      "usfm": "HAB.3.14"
    },
    {
      "verse": 15,
      "text": "با اسبانت، دریا",
      "usfm": "HAB.3.15"
    },
    {
      "verse": 15,
      "text": "و آبهای خروشان را پایمال نمودی.",
      "usfm": "HAB.3.15"
    },
    {
      "verse": 16,
      "text": "وقتی اینها را می‌شنوم،",
      "usfm": "HAB.3.16"
    },
    {
      "verse": 16,
      "text": "از ترس بدنم تکان می‌خورد و لبهایم می‌لرزند.",
      "usfm": "HAB.3.16"
    },
    {
      "verse": 16,
      "text": "اندامم سست می‌شود",
      "usfm": "HAB.3.16"
    },
    {
      "verse": 16,
      "text": "و پاهایم به لرزه می‌آیند.",
      "usfm": "HAB.3.16"
    },
    {
      "verse": 16,
      "text": "در انتظار روزی هستم",
      "usfm": "HAB.3.16"
    },
    {
      "verse": 16,
      "text": "که خدا آن مردمی را که ما را مورد حمله قرار دادند مجازات کند.",
      "usfm": "HAB.3.16"
    },
    {
      "verse": 17,
      "text": "هرچند درخت انجیر شکوفه نیاورد",
      "usfm": "HAB.3.17"
    },
    {
      "verse": 17,
      "text": "و انگور در تاک نروید،",
      "usfm": "HAB.3.17"
    },
    {
      "verse": 17,
      "text": "محصول زیتون از بین برود",
      "usfm": "HAB.3.17"
    },
    {
      "verse": 17,
      "text": "و کشتزارها غلّه بار نیاورند،",
      "usfm": "HAB.3.17"
    },
    {
      "verse": 17,
      "text": "گلّه‌ها در چراگاه تلف شوند",
      "usfm": "HAB.3.17"
    },
    {
      "verse": 17,
      "text": "و طویله‌ها از رمه خالی بمانند،",
      "usfm": "HAB.3.17"
    },
    {
      "verse": 18,
      "text": "بازهم خوشحال و شادمان خواهم بود،",
      "usfm": "HAB.3.18"
    },
    {
      "verse": 18,
      "text": "زیرا خداوند نجات‌دهندهٔ من است.",
      "usfm": "HAB.3.18"
    },
    {
      "verse": 19,
      "text": "خداوند متعال به من نیرو می‌بخشد",
      "usfm": "HAB.3.19"
    },
    {
      "verse": 19,
      "text": "و به پاهایم قوّت می‌دهد",
      "usfm": "HAB.3.19"
    },
    {
      "verse": 19,
      "text": "تا مانند آهو بِدَوَم و از کوههای بلند بالا بروم.",
      "usfm": "HAB.3.19"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/HAB/3.mp3"
}