{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 25,
  "verses": [
    {
      "verse": 1,
      "text": "ای خداوند، به درگاه تو دعا می‌کنم.",
      "usfm": "PSA.25.1"
    },
    {
      "verse": 2,
      "text": "ای خدای من، به تو توکّل دارم.",
      "usfm": "PSA.25.2"
    },
    {
      "verse": 2,
      "text": "نگذار که شرمنده شوم",
      "usfm": "PSA.25.2"
    },
    {
      "verse": 2,
      "text": "و دشمنانم خوشحال گردند.",
      "usfm": "PSA.25.2"
    },
    {
      "verse": 3,
      "text": "آری، کسانی‌که به تو امیدوارند، هرگز شرمنده نمی‌شوند،",
      "usfm": "PSA.25.3"
    },
    {
      "verse": 3,
      "text": "امّا خیانتکاران، شرمنده خواهند شد.",
      "usfm": "PSA.25.3"
    },
    {
      "verse": 4,
      "text": "خداوندا، راه خود را به من نشان بده",
      "usfm": "PSA.25.4"
    },
    {
      "verse": 4,
      "text": "و آن را به من بیاموز.",
      "usfm": "PSA.25.4"
    },
    {
      "verse": 5,
      "text": "مرا به حقیقت خود رهبری نما،",
      "usfm": "PSA.25.5"
    },
    {
      "verse": 5,
      "text": "چون تو خدای نجات‌دهندهٔ من هستی",
      "usfm": "PSA.25.5"
    },
    {
      "verse": 5,
      "text": "و من بر تو توکّل دارم.",
      "usfm": "PSA.25.5"
    },
    {
      "verse": 6,
      "text": "خداوندا، لطف و رحمت بی‌کران خود را",
      "usfm": "PSA.25.6"
    },
    {
      "verse": 6,
      "text": "که از ابتدا نشان داده‌ای، به یاد آور.",
      "usfm": "PSA.25.6"
    },
    {
      "verse": 7,
      "text": "گناهان زمان جوانی و خطاهای مرا به یاد میاور.",
      "usfm": "PSA.25.7"
    },
    {
      "verse": 7,
      "text": "بلکه ای خداوند، به‌خاطر محبّت استوار خود،",
      "usfm": "PSA.25.7"
    },
    {
      "verse": 7,
      "text": "مرا به یاد آور.",
      "usfm": "PSA.25.7"
    },
    {
      "verse": 8,
      "text": "خداوند، نیکو و عادل است،",
      "usfm": "PSA.25.8"
    },
    {
      "verse": 8,
      "text": "بنابراین گناهکاران را به راه راست هدایت می‌کند.",
      "usfm": "PSA.25.8"
    },
    {
      "verse": 9,
      "text": "او فروتنان را به کارهای نیک هدایت می‌کند،",
      "usfm": "PSA.25.9"
    },
    {
      "verse": 9,
      "text": "و راه خود را به آنها تعلیم می‌دهد.",
      "usfm": "PSA.25.9"
    },
    {
      "verse": 10,
      "text": "تمام راههای خداوند، برای کسانی‌که اوامر او را اطاعت می‌کنند",
      "usfm": "PSA.25.10"
    },
    {
      "verse": 10,
      "text": "و به پیمان او وفادارند، رحمت و راستی است.",
      "usfm": "PSA.25.10"
    },
    {
      "verse": 11,
      "text": "ای خداوند، به‌خاطر نام خود،",
      "usfm": "PSA.25.11"
    },
    {
      "verse": 11,
      "text": "گناهان عظیم مرا بیامرز.",
      "usfm": "PSA.25.11"
    },
    {
      "verse": 12,
      "text": "کسانی‌که برای خداوند احترام قائلند",
      "usfm": "PSA.25.12"
    },
    {
      "verse": 12,
      "text": "راهی را که باید بروند، از او خواهند آموخت.",
      "usfm": "PSA.25.12"
    },
    {
      "verse": 13,
      "text": "ایشان پیوسته کامیاب خواهند بود",
      "usfm": "PSA.25.13"
    },
    {
      "verse": 13,
      "text": "و فرزندانشان صاحب زمین خواهند شد.",
      "usfm": "PSA.25.13"
    },
    {
      "verse": 14,
      "text": "خداوند دوست کسانی است که از او اطاعت می‌کنند،",
      "usfm": "PSA.25.14"
    },
    {
      "verse": 14,
      "text": "او پیمان خود را برای آنان بیان می‌کند.",
      "usfm": "PSA.25.14"
    },
    {
      "verse": 15,
      "text": "من همیشه از خداوند انتظار کمک دارم،",
      "usfm": "PSA.25.15"
    },
    {
      "verse": 15,
      "text": "او مرا از خطر می‌رهاند.",
      "usfm": "PSA.25.15"
    },
    {
      "verse": 16,
      "text": "خداوندا، به من توجّه نموده و بر من رحمت فرما",
      "usfm": "PSA.25.16"
    },
    {
      "verse": 16,
      "text": "زیرا که تنها و درمانده شده‌ام.",
      "usfm": "PSA.25.16"
    },
    {
      "verse": 17,
      "text": "مرا از نگرانی‌هایم آزاد کن",
      "usfm": "PSA.25.17"
    },
    {
      "verse": 17,
      "text": "و از مشکلاتم برهان.",
      "usfm": "PSA.25.17"
    },
    {
      "verse": 18,
      "text": "به غمها و دردهایم توجّه فرما",
      "usfm": "PSA.25.18"
    },
    {
      "verse": 18,
      "text": "و گناهانم را ببخش.",
      "usfm": "PSA.25.18"
    },
    {
      "verse": 19,
      "text": "ببین که دشمنانم چقدر زیادند،",
      "usfm": "PSA.25.19"
    },
    {
      "verse": 19,
      "text": "و چقدر از من نفرت دارند.",
      "usfm": "PSA.25.19"
    },
    {
      "verse": 20,
      "text": "جان مرا در پناه خود حفظ کن",
      "usfm": "PSA.25.20"
    },
    {
      "verse": 20,
      "text": "و مرا رهایی ده، مگذار که شرمنده شوم،",
      "usfm": "PSA.25.20"
    },
    {
      "verse": 20,
      "text": "زیرا که به تو پناه آورده‌ام.",
      "usfm": "PSA.25.20"
    },
    {
      "verse": 21,
      "text": "نیکوکاری و راستیِ من، مرا محافظت خواهند کرد،",
      "usfm": "PSA.25.21"
    },
    {
      "verse": 21,
      "text": "زیرا که بر تو توکّل دارم.",
      "usfm": "PSA.25.21"
    },
    {
      "verse": 22,
      "text": "خدایا، بنی‌اسرائیل را",
      "usfm": "PSA.25.22"
    },
    {
      "verse": 22,
      "text": "از همهٔ سختی‌ها برهان!",
      "usfm": "PSA.25.22"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/25.mp3"
}