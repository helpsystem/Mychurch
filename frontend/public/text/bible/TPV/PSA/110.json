{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 110,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند به سَروَر من می‌گوید:",
      "usfm": "PSA.110.1"
    },
    {
      "verse": 1,
      "text": "«به دست راست من بنشین",
      "usfm": "PSA.110.1"
    },
    {
      "verse": 1,
      "text": "تا دشمنانت را زیر پای تو اندازم.»",
      "usfm": "PSA.110.1"
    },
    {
      "verse": 2,
      "text": "خداوند از صهیون سلطنت تو را وسعت خواهد داد",
      "usfm": "PSA.110.2"
    },
    {
      "verse": 2,
      "text": "تا بر دشمنان اطرافت سلطنت کنی.",
      "usfm": "PSA.110.2"
    },
    {
      "verse": 3,
      "text": "در روز نبرد با دشمنانت،",
      "usfm": "PSA.110.3"
    },
    {
      "verse": 3,
      "text": "قومت با کمال میل از اوامر تو پیروی خواهد كرد",
      "usfm": "PSA.110.3"
    },
    {
      "verse": 3,
      "text": "و جوانان تو مثل شبنم صبحگاهی",
      "usfm": "PSA.110.3"
    },
    {
      "verse": 3,
      "text": "به حضور تو بر کوه مقدّس خواهند آمد.",
      "usfm": "PSA.110.3"
    },
    {
      "verse": 4,
      "text": "خداوند قسم خورده است و پشیمان نخواهد شد،",
      "usfm": "PSA.110.4"
    },
    {
      "verse": 4,
      "text": "که تو تا ابد کاهن هستی،",
      "usfm": "PSA.110.4"
    },
    {
      "verse": 4,
      "text": "کاهنی در رتبه ملکی‌صدق.",
      "usfm": "PSA.110.4"
    },
    {
      "verse": 5,
      "text": "خداوند در دست راست توست",
      "usfm": "PSA.110.5"
    },
    {
      "verse": 5,
      "text": "و در روز غضب خود، پادشاهان را شکست خواهد داد.",
      "usfm": "PSA.110.5"
    },
    {
      "verse": 6,
      "text": "ملّتها را محاکمه خواهد كرد.",
      "usfm": "PSA.110.6"
    },
    {
      "verse": 6,
      "text": "میدان جنگ را از اجساد آنها پُر خواهد ساخت",
      "usfm": "PSA.110.6"
    },
    {
      "verse": 6,
      "text": "و پادشاهان روی زمین را شکست خواهد داد.",
      "usfm": "PSA.110.6"
    },
    {
      "verse": 7,
      "text": "پادشاه از آب جوی کنار جاده خواهد نوشید",
      "usfm": "PSA.110.7"
    },
    {
      "verse": 7,
      "text": "و نیرو یافته، با پیروزی سرافراز خواهد شد.",
      "usfm": "PSA.110.7"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/110.mp3"
}