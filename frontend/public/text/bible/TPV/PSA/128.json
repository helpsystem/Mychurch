{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 128,
  "verses": [
    {
      "verse": 1,
      "text": "خوشا به حال کسی‌که از خداوند اطاعت می‌کند",
      "usfm": "PSA.128.1"
    },
    {
      "verse": 1,
      "text": "و مطابق احکام او زندگی می‌نماید.",
      "usfm": "PSA.128.1"
    },
    {
      "verse": 2,
      "text": "دسترنج تو، احتیاجات تو را برآورده می‌سازد",
      "usfm": "PSA.128.2"
    },
    {
      "verse": 2,
      "text": "و کامیاب و شادمان خواهی بود.",
      "usfm": "PSA.128.2"
    },
    {
      "verse": 3,
      "text": "همسرت مانند درخت مو پُر ثمر در خانه‏ات بوده",
      "usfm": "PSA.128.3"
    },
    {
      "verse": 3,
      "text": "و فرزندانت مانند درختان زیتون به دور سفره‌ات خواهند بود.",
      "usfm": "PSA.128.3"
    },
    {
      "verse": 4,
      "text": "شخصی که از خداوند اطاعت می‌کند،",
      "usfm": "PSA.128.4"
    },
    {
      "verse": 4,
      "text": "این چنین برکت خواهد یافت.",
      "usfm": "PSA.128.4"
    },
    {
      "verse": 5,
      "text": "خداوند تو را از صهیون برکت دهد",
      "usfm": "PSA.128.5"
    },
    {
      "verse": 5,
      "text": "و اورشلیم را در سراسر عمرت",
      "usfm": "PSA.128.5"
    },
    {
      "verse": 5,
      "text": "شكوفا و آباد ببینی!",
      "usfm": "PSA.128.5"
    },
    {
      "verse": 6,
      "text": "عمرت دراز باد و نوه‌های خود را ببینی!",
      "usfm": "PSA.128.6"
    },
    {
      "verse": 6,
      "text": "صلح و آرامش بر اسرائیل باد!",
      "usfm": "PSA.128.6"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/128.mp3"
}