{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 126,
  "verses": [
    {
      "verse": 1,
      "text": "وقتی خداوند ما را دوباره به اورشلیم آورد،",
      "usfm": "PSA.126.1"
    },
    {
      "verse": 1,
      "text": "فکر کردیم که خواب می‌بینیم.",
      "usfm": "PSA.126.1"
    },
    {
      "verse": 2,
      "text": "چقدر خندیدیم و از خوشی سرود خواندیم.",
      "usfm": "PSA.126.2"
    },
    {
      "verse": 2,
      "text": "ملل دیگر دربارهٔ ما می‌گفتند:",
      "usfm": "PSA.126.2"
    },
    {
      "verse": 2,
      "text": "«خداوند برای ایشان کارهای عجیبی انجام داده است.»",
      "usfm": "PSA.126.2"
    },
    {
      "verse": 3,
      "text": "در واقع خداوند کارهای عجیبی برای ما کرده است",
      "usfm": "PSA.126.3"
    },
    {
      "verse": 3,
      "text": "و ما خوشحالیم.",
      "usfm": "PSA.126.3"
    },
    {
      "verse": 4,
      "text": "خداوندا، سعادت را به ما بازگردان،",
      "usfm": "PSA.126.4"
    },
    {
      "verse": 4,
      "text": "همچنان‌که باران رودخانه‏های خشک را دوباره پُر آب می‌سازد.",
      "usfm": "PSA.126.4"
    },
    {
      "verse": 5,
      "text": "آنانی که با اشكها می‌کارند،",
      "usfm": "PSA.126.5"
    },
    {
      "verse": 5,
      "text": "با شادمانی درو خواهند نمود!",
      "usfm": "PSA.126.5"
    },
    {
      "verse": 6,
      "text": "کسانی‌که با گریه برای بذر افشانی بیرون می‌روند،",
      "usfm": "PSA.126.6"
    },
    {
      "verse": 6,
      "text": "محصول خود را با نوای شادمانی باز خواهند آورد!",
      "usfm": "PSA.126.6"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/126.mp3"
}