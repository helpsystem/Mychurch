{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 30,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، تو را ستایش می‌کنم،",
      "usfm": "PSA.30.1"
    },
    {
      "verse": 1,
      "text": "چون تو مرا نجات دادی و نگذاشتی دشمنانم مرا مسخره کنند.",
      "usfm": "PSA.30.1"
    },
    {
      "verse": 2,
      "text": "ای خداوند، ای خدای من، به درگاه تو برای کمک التماس کردم",
      "usfm": "PSA.30.2"
    },
    {
      "verse": 2,
      "text": "و تو مرا شفا دادی.",
      "usfm": "PSA.30.2"
    },
    {
      "verse": 3,
      "text": "خداوندا، پایم به لب گور رسیده بود،",
      "usfm": "PSA.30.3"
    },
    {
      "verse": 3,
      "text": "تو مرا از مرگ نجات دادی",
      "usfm": "PSA.30.3"
    },
    {
      "verse": 3,
      "text": "و زندگی تازه‌‌ای به من بخشیدی.",
      "usfm": "PSA.30.3"
    },
    {
      "verse": 4,
      "text": "ای مؤمنین او،",
      "usfm": "PSA.30.4"
    },
    {
      "verse": 4,
      "text": "خداوند را سپاس گویید!",
      "usfm": "PSA.30.4"
    },
    {
      "verse": 4,
      "text": "و آنچه را که آن قدّوسِ یگانه انجام داده به یاد آورید،",
      "usfm": "PSA.30.4"
    },
    {
      "verse": 4,
      "text": "و او را شکر کنید.",
      "usfm": "PSA.30.4"
    },
    {
      "verse": 5,
      "text": "غضب او فقط یک لحظه‌ است،",
      "usfm": "PSA.30.5"
    },
    {
      "verse": 5,
      "text": "امّا رحمت او ابدی است.",
      "usfm": "PSA.30.5"
    },
    {
      "verse": 5,
      "text": "اشکهای شبانه،",
      "usfm": "PSA.30.5"
    },
    {
      "verse": 5,
      "text": "صبحِ شادی در پی خواهد داشت.",
      "usfm": "PSA.30.5"
    },
    {
      "verse": 6,
      "text": "وقتی از امنیّت برخوردار بودم به خود گفتم:",
      "usfm": "PSA.30.6"
    },
    {
      "verse": 6,
      "text": "«من هرگز شکست نمی‌خورم.»",
      "usfm": "PSA.30.6"
    },
    {
      "verse": 7,
      "text": "خداوندا، تو بر من لطف داشتی",
      "usfm": "PSA.30.7"
    },
    {
      "verse": 7,
      "text": "و از من مانند کوهی استوار پشتیبانی نمودی،",
      "usfm": "PSA.30.7"
    },
    {
      "verse": 7,
      "text": "امّا وقتی رویت را از من پنهان کردی",
      "usfm": "PSA.30.7"
    },
    {
      "verse": 7,
      "text": "پریشان گشتم.",
      "usfm": "PSA.30.7"
    },
    {
      "verse": 8,
      "text": "ای خداوند، به درگاه تو، زاری کردم",
      "usfm": "PSA.30.8"
    },
    {
      "verse": 8,
      "text": "و به حضورت نالیدم،",
      "usfm": "PSA.30.8"
    },
    {
      "verse": 9,
      "text": "گفتم: «از مرگ من چه سودی به تو می‌رسد؟",
      "usfm": "PSA.30.9"
    },
    {
      "verse": 9,
      "text": "و اگر من به گور بروم چه نفعی برای تو خواهد داشت؟",
      "usfm": "PSA.30.9"
    },
    {
      "verse": 9,
      "text": "آیا مردگان می‌توانند تو را ستایش کنند",
      "usfm": "PSA.30.9"
    },
    {
      "verse": 9,
      "text": "و احسانهای تو را بیان نمایند؟»",
      "usfm": "PSA.30.9"
    },
    {
      "verse": 10,
      "text": "خداوندا، به من گوش بده",
      "usfm": "PSA.30.10"
    },
    {
      "verse": 10,
      "text": "و بر من رحمت نما و مددکار من باش.",
      "usfm": "PSA.30.10"
    },
    {
      "verse": 11,
      "text": "تو غم مرا به رقص و شادی تبدیل نمودی.",
      "usfm": "PSA.30.11"
    },
    {
      "verse": 11,
      "text": "لباس ماتم را از تنم بیرون آوردی",
      "usfm": "PSA.30.11"
    },
    {
      "verse": 11,
      "text": "و لباس شادی بر من پوشاندی.",
      "usfm": "PSA.30.11"
    },
    {
      "verse": 12,
      "text": "بنابراین سکوت نخواهم کرد",
      "usfm": "PSA.30.12"
    },
    {
      "verse": 12,
      "text": "و سرود تشکّر برای تو خواهم سرایید.",
      "usfm": "PSA.30.12"
    },
    {
      "verse": 12,
      "text": "ای خداوند، ای خدای من،",
      "usfm": "PSA.30.12"
    },
    {
      "verse": 12,
      "text": "تو را تا به ابد ستایش خواهم نمود.",
      "usfm": "PSA.30.12"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/30.mp3"
}