{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 26,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، از من حمایت فرما،",
      "usfm": "PSA.26.1"
    },
    {
      "verse": 1,
      "text": "زیرا در کمال راستی رفتار نموده",
      "usfm": "PSA.26.1"
    },
    {
      "verse": 1,
      "text": "و بدون تردید به تو توکّل کرده‌‌ام.",
      "usfm": "PSA.26.1"
    },
    {
      "verse": 2,
      "text": "ای خداوند، مرا امتحان کن و بیازما!",
      "usfm": "PSA.26.2"
    },
    {
      "verse": 2,
      "text": "قلب و وجدان مرا پاک گردان.",
      "usfm": "PSA.26.2"
    },
    {
      "verse": 3,
      "text": "محبّت سرشار تو راهنمای من است،",
      "usfm": "PSA.26.3"
    },
    {
      "verse": 3,
      "text": "من در حضور تو با وفاداری رفتار می‌کنم.",
      "usfm": "PSA.26.3"
    },
    {
      "verse": 4,
      "text": "با اشخاص بد، همنشین نیستم",
      "usfm": "PSA.26.4"
    },
    {
      "verse": 4,
      "text": "و با مردم ریاکار معاشرت ندارم.",
      "usfm": "PSA.26.4"
    },
    {
      "verse": 5,
      "text": "از مشارکت با مردم شریر نفرت دارم",
      "usfm": "PSA.26.5"
    },
    {
      "verse": 5,
      "text": "و با بدکاران رفت و آمد نمی‌کنم.",
      "usfm": "PSA.26.5"
    },
    {
      "verse": 6,
      "text": "خداوندا، به نشانهٔ بی‌گناهی دست خود را می‌شویم",
      "usfm": "PSA.26.6"
    },
    {
      "verse": 6,
      "text": "و قربانگاه تو را طواف می‌کنم.",
      "usfm": "PSA.26.6"
    },
    {
      "verse": 7,
      "text": "با صدای بلند، در ستایش تو سرود خواهم خواند",
      "usfm": "PSA.26.7"
    },
    {
      "verse": 7,
      "text": "و تمام کارهای عجیب تو را بیان خواهم کرد.",
      "usfm": "PSA.26.7"
    },
    {
      "verse": 8,
      "text": "خداوندا، خانهٔ تو را دوست می‌دارم،",
      "usfm": "PSA.26.8"
    },
    {
      "verse": 8,
      "text": "آن جایی که جلال تو در آنجاست.",
      "usfm": "PSA.26.8"
    },
    {
      "verse": 9,
      "text": "مرا با گناهکاران نابود منما،",
      "usfm": "PSA.26.9"
    },
    {
      "verse": 9,
      "text": "و در سرنوشت مردمان قاتل و خونریز شریک مگردان.",
      "usfm": "PSA.26.9"
    },
    {
      "verse": 10,
      "text": "مردمانی که پیوسته شرارت می‌کنند",
      "usfm": "PSA.26.10"
    },
    {
      "verse": 10,
      "text": "و رشوه می‌گیرند.",
      "usfm": "PSA.26.10"
    },
    {
      "verse": 11,
      "text": "امّا من آنچه را که درست است انجام می‌دهم،",
      "usfm": "PSA.26.11"
    },
    {
      "verse": 11,
      "text": "پس بر من رحمت فرموده مرا نجات بده.",
      "usfm": "PSA.26.11"
    },
    {
      "verse": 12,
      "text": "خداوند مرا از خطر می‌رهاند،",
      "usfm": "PSA.26.12"
    },
    {
      "verse": 12,
      "text": "او را در مقابل همهٔ مردم پرستش خواهم نمود.",
      "usfm": "PSA.26.12"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/26.mp3"
}