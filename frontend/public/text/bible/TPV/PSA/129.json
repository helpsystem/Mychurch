{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 129,
  "verses": [
    {
      "verse": 1,
      "text": "اسرائیل، بگو که چطور",
      "usfm": "PSA.129.1"
    },
    {
      "verse": 1,
      "text": "از زمان جوانی، دشمنانت تو را عذاب دادند.",
      "usfm": "PSA.129.1"
    },
    {
      "verse": 2,
      "text": "«از زمانی که جوان بودم،",
      "usfm": "PSA.129.2"
    },
    {
      "verse": 2,
      "text": "دشمنانم بر من ظلم کردند،",
      "usfm": "PSA.129.2"
    },
    {
      "verse": 2,
      "text": "امّا نتوانستند مرا از پای درآورند.",
      "usfm": "PSA.129.2"
    },
    {
      "verse": 3,
      "text": "شانه‏هایم را با شلاق، مانند",
      "usfm": "PSA.129.3"
    },
    {
      "verse": 3,
      "text": "زمین شخم زده کردند.",
      "usfm": "PSA.129.3"
    },
    {
      "verse": 4,
      "text": "امّا خداوند عادل",
      "usfm": "PSA.129.4"
    },
    {
      "verse": 4,
      "text": "مرا از بردگی آزاد کرد.»",
      "usfm": "PSA.129.4"
    },
    {
      "verse": 5,
      "text": "کسانی‌که از صهیون نفرت دارند،",
      "usfm": "PSA.129.5"
    },
    {
      "verse": 5,
      "text": "سرنگون شوند.",
      "usfm": "PSA.129.5"
    },
    {
      "verse": 6,
      "text": "مانند علف روییده بر روی بامها",
      "usfm": "PSA.129.6"
    },
    {
      "verse": 6,
      "text": "پیش از آن که نمو کنند، پژمرده گردند",
      "usfm": "PSA.129.6"
    },
    {
      "verse": 7,
      "text": "و کسی نتواند آنها را بچیند",
      "usfm": "PSA.129.7"
    },
    {
      "verse": 7,
      "text": "و یا به صورت بافه ببندد.",
      "usfm": "PSA.129.7"
    },
    {
      "verse": 8,
      "text": "هیچ رهگذری نگوید:",
      "usfm": "PSA.129.8"
    },
    {
      "verse": 8,
      "text": "«خداوند تو را برکت دهد",
      "usfm": "PSA.129.8"
    },
    {
      "verse": 8,
      "text": "یا ما به نام خداوند تو را برکت می‌دهیم!»",
      "usfm": "PSA.129.8"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/129.mp3"
}