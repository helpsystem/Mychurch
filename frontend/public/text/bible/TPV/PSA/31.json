{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 31,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، به تو پناه می‌آورم،",
      "usfm": "PSA.31.1"
    },
    {
      "verse": 1,
      "text": "شرمسارم مکن.",
      "usfm": "PSA.31.1"
    },
    {
      "verse": 1,
      "text": "تو خدای عادل هستی،",
      "usfm": "PSA.31.1"
    },
    {
      "verse": 1,
      "text": "پس مرا نجات بده.",
      "usfm": "PSA.31.1"
    },
    {
      "verse": 2,
      "text": "دعایم را مستجاب فرما",
      "usfm": "PSA.31.2"
    },
    {
      "verse": 2,
      "text": "و هرچه زودتر نجاتم ده. پُشت و پناه من باش؛",
      "usfm": "PSA.31.2"
    },
    {
      "verse": 2,
      "text": "و با قدرت خود مرا برهان.",
      "usfm": "PSA.31.2"
    },
    {
      "verse": 3,
      "text": "تو پناهگاه و پشتیبان من هستی.",
      "usfm": "PSA.31.3"
    },
    {
      "verse": 3,
      "text": "به‌خاطر نام خود راهنمای من باش و هدایتم کن.",
      "usfm": "PSA.31.3"
    },
    {
      "verse": 4,
      "text": "مرا از دامی که برایم گسترده‌اند برهان،",
      "usfm": "PSA.31.4"
    },
    {
      "verse": 4,
      "text": "زیرا تو پناهگاه من هستی.",
      "usfm": "PSA.31.4"
    },
    {
      "verse": 5,
      "text": "ای خدای عادل،",
      "usfm": "PSA.31.5"
    },
    {
      "verse": 5,
      "text": "روح خود را به تو می‌سپارم،",
      "usfm": "PSA.31.5"
    },
    {
      "verse": 5,
      "text": "تو مرا نجات داده‌ای.",
      "usfm": "PSA.31.5"
    },
    {
      "verse": 6,
      "text": "از بت‌پرستان نفرت داری، امّا من،",
      "usfm": "PSA.31.6"
    },
    {
      "verse": 6,
      "text": "ای خداوند، به تو ایمان دارم.",
      "usfm": "PSA.31.6"
    },
    {
      "verse": 7,
      "text": "به‌خاطر رحمت پایدار تو",
      "usfm": "PSA.31.7"
    },
    {
      "verse": 7,
      "text": "شادی و خوشی می‌کنم.",
      "usfm": "PSA.31.7"
    },
    {
      "verse": 7,
      "text": "تو سختی‌های مرا دیده‌ای",
      "usfm": "PSA.31.7"
    },
    {
      "verse": 7,
      "text": "و از مشکلاتم آگاهی.",
      "usfm": "PSA.31.7"
    },
    {
      "verse": 8,
      "text": "مرا به دست دشمنانم نسپردی،",
      "usfm": "PSA.31.8"
    },
    {
      "verse": 8,
      "text": "تو مرا آزاد گذاشتی تا هر کجا که بخواهم بروم.",
      "usfm": "PSA.31.8"
    },
    {
      "verse": 9,
      "text": "خداوندا، بر من رحم کن،",
      "usfm": "PSA.31.9"
    },
    {
      "verse": 9,
      "text": "زیرا در سختی هستم.",
      "usfm": "PSA.31.9"
    },
    {
      "verse": 9,
      "text": "چشمانم از غصّه تار گردیده",
      "usfm": "PSA.31.9"
    },
    {
      "verse": 9,
      "text": "و از پا افتاده‌‌ام.",
      "usfm": "PSA.31.9"
    },
    {
      "verse": 10,
      "text": "عمرم در غم گذشته",
      "usfm": "PSA.31.10"
    },
    {
      "verse": 10,
      "text": "و سالهای زندگی را با حسرت طی کرده‌ام.",
      "usfm": "PSA.31.10"
    },
    {
      "verse": 10,
      "text": "توانایی خود را از دست داده‌",
      "usfm": "PSA.31.10"
    },
    {
      "verse": 10,
      "text": "و استخوانهایم پوسیده‌اند.",
      "usfm": "PSA.31.10"
    },
    {
      "verse": 11,
      "text": "همهٔ دشمنانم، به خصوص همسایگانم",
      "usfm": "PSA.31.11"
    },
    {
      "verse": 11,
      "text": "مرا تحقیر می‌کنند،",
      "usfm": "PSA.31.11"
    },
    {
      "verse": 11,
      "text": "آشنایانم از من می‌ترسند",
      "usfm": "PSA.31.11"
    },
    {
      "verse": 11,
      "text": "و وقتی مرا در کوچه می‌بینند، می‌گریزند.",
      "usfm": "PSA.31.11"
    },
    {
      "verse": 12,
      "text": "مثل مُرده‌ها از خاطره‌ها فراموش شده‌ام",
      "usfm": "PSA.31.12"
    },
    {
      "verse": 12,
      "text": "و مانند ظرفی شکسته از نظر افتاده‌‌ام.",
      "usfm": "PSA.31.12"
    },
    {
      "verse": 13,
      "text": "شایعات زیادی را که دشمنانم برضد من می‌گویند، می‌شنوم.",
      "usfm": "PSA.31.13"
    },
    {
      "verse": 13,
      "text": "وحشت اطرافم را فراگرفته",
      "usfm": "PSA.31.13"
    },
    {
      "verse": 13,
      "text": "آنها برضد من دسیسه می‌چینند",
      "usfm": "PSA.31.13"
    },
    {
      "verse": 13,
      "text": "تا مرا به قتل برسانند.",
      "usfm": "PSA.31.13"
    },
    {
      "verse": 14,
      "text": "امّا ای خداوند، من بر تو اعتماد دارم و می‌گویم:",
      "usfm": "PSA.31.14"
    },
    {
      "verse": 14,
      "text": "«تو خدای من هستی.»",
      "usfm": "PSA.31.14"
    },
    {
      "verse": 15,
      "text": "زندگی من در دست توست،",
      "usfm": "PSA.31.15"
    },
    {
      "verse": 15,
      "text": "مرا از دست دشمنانم",
      "usfm": "PSA.31.15"
    },
    {
      "verse": 15,
      "text": "و کسانی‌که مرا می‌آزارند، برهان.",
      "usfm": "PSA.31.15"
    },
    {
      "verse": 16,
      "text": "چشم این بنده‌ات را به نور جمالت روشن کن",
      "usfm": "PSA.31.16"
    },
    {
      "verse": 16,
      "text": "و با رحمت پایدارت مرا نجات بده.",
      "usfm": "PSA.31.16"
    },
    {
      "verse": 17,
      "text": "خداوندا، از تو تمنّا می‌کنم",
      "usfm": "PSA.31.17"
    },
    {
      "verse": 17,
      "text": "که مرا خجل نسازی،",
      "usfm": "PSA.31.17"
    },
    {
      "verse": 17,
      "text": "بلکه بگذار مردمان شریر، شرمنده و سرافکنده شوند",
      "usfm": "PSA.31.17"
    },
    {
      "verse": 17,
      "text": "و خاموش به دیار مردگان بروند.",
      "usfm": "PSA.31.17"
    },
    {
      "verse": 18,
      "text": "خاموش ساز آنانی را که دروغ می‌گویند",
      "usfm": "PSA.31.18"
    },
    {
      "verse": 18,
      "text": "و از روی تکبّر و حماقت",
      "usfm": "PSA.31.18"
    },
    {
      "verse": 18,
      "text": "علیه مردمان نیک حرف می‌زنند.",
      "usfm": "PSA.31.18"
    },
    {
      "verse": 19,
      "text": "رحمت تو بر ترسندگانت چه نیکوست؛",
      "usfm": "PSA.31.19"
    },
    {
      "verse": 19,
      "text": "همه می‌دانند که تو چقدر نیکو‌یی",
      "usfm": "PSA.31.19"
    },
    {
      "verse": 19,
      "text": "و آنهایی را که به تو توکّل می‌کنند",
      "usfm": "PSA.31.19"
    },
    {
      "verse": 19,
      "text": "حمایت می‌کنی.",
      "usfm": "PSA.31.19"
    },
    {
      "verse": 20,
      "text": "آنها را زیر سایهٔ رحمت خود از دسیسه",
      "usfm": "PSA.31.20"
    },
    {
      "verse": 20,
      "text": "و حیلهٔ مردم حفظ می‌کنی",
      "usfm": "PSA.31.20"
    },
    {
      "verse": 20,
      "text": "و در نزد خود پناه می‌دهی.",
      "usfm": "PSA.31.20"
    },
    {
      "verse": 21,
      "text": "خداوند را ستایش می‌کنم،",
      "usfm": "PSA.31.21"
    },
    {
      "verse": 21,
      "text": "زیرا زمانی‌که در محاصرهٔ دشمنان بودم،",
      "usfm": "PSA.31.21"
    },
    {
      "verse": 21,
      "text": "محبّت سرشار خود را به من نشان داد.",
      "usfm": "PSA.31.21"
    },
    {
      "verse": 22,
      "text": "من می‌ترسیدم و فکر می‌کردم",
      "usfm": "PSA.31.22"
    },
    {
      "verse": 22,
      "text": "که او مرا از نظر انداخته است،",
      "usfm": "PSA.31.22"
    },
    {
      "verse": 22,
      "text": "امّا وقتی از او کمک خواستم،",
      "usfm": "PSA.31.22"
    },
    {
      "verse": 22,
      "text": "دعایم را مستجاب کرد.",
      "usfm": "PSA.31.22"
    },
    {
      "verse": 23,
      "text": "ای مؤمنین او، خداوند را دوست بدارید،",
      "usfm": "PSA.31.23"
    },
    {
      "verse": 23,
      "text": "زیرا خداوند مؤمنین را حفظ می‌کند،",
      "usfm": "PSA.31.23"
    },
    {
      "verse": 23,
      "text": "امّا متکبّران را به سزای كارهایشان می‌رساند.",
      "usfm": "PSA.31.23"
    },
    {
      "verse": 24,
      "text": "ای کسانی‌که امیدتان به خداست،",
      "usfm": "PSA.31.24"
    },
    {
      "verse": 24,
      "text": "شجاع و قوی باشید.",
      "usfm": "PSA.31.24"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/31.mp3"
}