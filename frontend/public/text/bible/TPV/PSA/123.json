  "chapter": 123,
  "verses": [
    {
      "verse": 1,
      "text": "ای خداوند، چشمان من به سوی توست،",
      "usfm": "PSA.123.1"
    },
    {
      "verse": 1,
      "text": "به تو که در آسمان فرمانروایی می‌کنی.",
      "usfm": "PSA.123.1"
    },
    {
      "verse": 2,
      "text": "مانند غلام و کنیزی",
      "usfm": "PSA.123.2"
    },
    {
      "verse": 2,
      "text": "که از ارباب خود انتظار دارد،",
      "usfm": "PSA.123.2"
    },
    {
      "verse": 2,
      "text": "همچنین ما نیز ای خداوند خدای ما،",
      "usfm": "PSA.123.2"
    },
    {
      "verse": 2,
      "text": "از تو انتظار رحمت داریم.",
      "usfm": "PSA.123.2"
    },
    {
      "verse": 3,
      "text": "خداوندا، بر ما رحم کن، بر ما رحم کن،",
      "usfm": "PSA.123.3"
    },
    {
      "verse": 3,
      "text": "به ما بسیار اهانت شده است.",
      "usfm": "PSA.123.3"
    },
    {
      "verse": 4,
      "text": "از دست ثروتمندان ظالم و متکبّر،",
      "usfm": "PSA.123.4"
    },
    {
      "verse": 4,
      "text": "جان ما به لب رسیده است.",
      "usfm": "PSA.123.4"
    }
  ],
