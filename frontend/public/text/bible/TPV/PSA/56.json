{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 56,
  "verses": [
    {
      "verse": 1,
      "text": "خدایا بر من رحم کن،",
      "usfm": "PSA.56.1"
    },
    {
      "verse": 1,
      "text": "زیرا دشمنانم به من حمله می‌کنند",
      "usfm": "PSA.56.1"
    },
    {
      "verse": 1,
      "text": "و پیوسته مرا عذاب می‌دهند.",
      "usfm": "PSA.56.1"
    },
    {
      "verse": 2,
      "text": "تمام روز به من حمله می‌کنند",
      "usfm": "PSA.56.2"
    },
    {
      "verse": 2,
      "text": "و آنانی که با من می‌جنگند، بسیارند.",
      "usfm": "PSA.56.2"
    },
    {
      "verse": 3,
      "text": "ای خداوند، هنگامی‌که می‌ترسم،",
      "usfm": "PSA.56.3"
    },
    {
      "verse": 3,
      "text": "به تو توکّل می‌کنم.",
      "usfm": "PSA.56.3"
    },
    {
      "verse": 4,
      "text": "به خدا توکّل می‌کنم و نمی‌ترسم.",
      "usfm": "PSA.56.4"
    },
    {
      "verse": 4,
      "text": "او را به‌خاطر آنچه که انجام داده است شکر می‌کنم،",
      "usfm": "PSA.56.4"
    },
    {
      "verse": 4,
      "text": "پس انسان فانی به من چه می‌تواند بکند؟",
      "usfm": "PSA.56.4"
    },
    {
      "verse": 5,
      "text": "دشمنانم تمام روز به فکر آزار من هستند",
      "usfm": "PSA.56.5"
    },
    {
      "verse": 5,
      "text": "و همیشه در پی آن هستند که راهی برای اذیّت من پیدا کنند.",
      "usfm": "PSA.56.5"
    },
    {
      "verse": 6,
      "text": "آنها همه با هم در کمین هستند",
      "usfm": "PSA.56.6"
    },
    {
      "verse": 6,
      "text": "و پیوسته مراقب من می‌باشند",
      "usfm": "PSA.56.6"
    },
    {
      "verse": 6,
      "text": "تا مرا به قتل برسانند.",
      "usfm": "PSA.56.6"
    },
    {
      "verse": 7,
      "text": "پس ای خدا، آنها را به‌خاطر شرارتشان مجازات کن",
      "usfm": "PSA.56.7"
    },
    {
      "verse": 7,
      "text": "و به غضب خود گرفتار فرما.",
      "usfm": "PSA.56.7"
    },
    {
      "verse": 8,
      "text": "تو از پریشانی من آگاهی،",
      "usfm": "PSA.56.8"
    },
    {
      "verse": 8,
      "text": "حساب اشکهایم را داری",
      "usfm": "PSA.56.8"
    },
    {
      "verse": 8,
      "text": "آیا آنها در دفتر تو نوشته نشده‌اند؟",
      "usfm": "PSA.56.8"
    },
    {
      "verse": 9,
      "text": "آن روزی که تو را صدا می‌کنم",
      "usfm": "PSA.56.9"
    },
    {
      "verse": 9,
      "text": "دشمنانم برمی‌گردند و می‌گریزند.",
      "usfm": "PSA.56.9"
    },
    {
      "verse": 9,
      "text": "یقین دارم که خداوند پشتیبان من است.",
      "usfm": "PSA.56.9"
    },
    {
      "verse": 10,
      "text": "وعده‌های خدا را ستایش می‌کنم و او را شکر می‌کنم.",
      "usfm": "PSA.56.10"
    },
    {
      "verse": 11,
      "text": "بر او توکّل می‌کنم و نخواهم ترسید.",
      "usfm": "PSA.56.11"
    },
    {
      "verse": 11,
      "text": "پس انسان فانی به من چه می‌‌تواند بکند؟",
      "usfm": "PSA.56.11"
    },
    {
      "verse": 12,
      "text": "خدایا، نذرهای خود را به تو ادا خواهم کرد",
      "usfm": "PSA.56.12"
    },
    {
      "verse": 12,
      "text": "و از تو سپاسگزار هستم.",
      "usfm": "PSA.56.12"
    },
    {
      "verse": 13,
      "text": "زیرا تو مرا از مرگ نجات دادی،",
      "usfm": "PSA.56.13"
    },
    {
      "verse": 13,
      "text": "و از نابودی رهانیدی",
      "usfm": "PSA.56.13"
    },
    {
      "verse": 13,
      "text": "تا در پرتو نور حیات که از جانب تو می‌تابد",
      "usfm": "PSA.56.13"
    },
    {
      "verse": 13,
      "text": "به حضور تو راه یابم.",
      "usfm": "PSA.56.13"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/56.mp3"
}