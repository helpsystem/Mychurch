{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 113,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.113.1"
    },
    {
      "verse": 1,
      "text": "ای بندگان خداوند",
      "usfm": "PSA.113.1"
    },
    {
      "verse": 1,
      "text": "نام خداوند را ستایش کنید!",
      "usfm": "PSA.113.1"
    },
    {
      "verse": 2,
      "text": "نام او، از حال",
      "usfm": "PSA.113.2"
    },
    {
      "verse": 2,
      "text": "تا به ابد متبارک باد!",
      "usfm": "PSA.113.2"
    },
    {
      "verse": 3,
      "text": "از طلوع تا غروب آفتاب",
      "usfm": "PSA.113.3"
    },
    {
      "verse": 3,
      "text": "نام خداوند را ستایش کنید.",
      "usfm": "PSA.113.3"
    },
    {
      "verse": 4,
      "text": "خداوند بر همهٔ ملّتها فرمانروایی می‌کند،",
      "usfm": "PSA.113.4"
    },
    {
      "verse": 4,
      "text": "شکوه و عظمت او برتر از آسمانهاست.",
      "usfm": "PSA.113.4"
    },
    {
      "verse": 5,
      "text": "خداوند، خدای ما که بر بلندترین جایگاه عالم بالا نشسته است،",
      "usfm": "PSA.113.5"
    },
    {
      "verse": 5,
      "text": "مانند و همتایی ندارد.",
      "usfm": "PSA.113.5"
    },
    {
      "verse": 6,
      "text": "او خم شده",
      "usfm": "PSA.113.6"
    },
    {
      "verse": 6,
      "text": "از آسمان، زمین را نگاه می‌کند.",
      "usfm": "PSA.113.6"
    },
    {
      "verse": 7,
      "text": "مسکینان را از خاک برمی‌دارد",
      "usfm": "PSA.113.7"
    },
    {
      "verse": 7,
      "text": "و نیازمندان را از ذلّت می‌رهاند",
      "usfm": "PSA.113.7"
    },
    {
      "verse": 8,
      "text": "و آنها را همنشین شاهزادگان،",
      "usfm": "PSA.113.8"
    },
    {
      "verse": 8,
      "text": "شاهزادگان قوم خویش می‌گرداند.",
      "usfm": "PSA.113.8"
    },
    {
      "verse": 9,
      "text": "به زنان نازا، خانواده می‌بخشد",
      "usfm": "PSA.113.9"
    },
    {
      "verse": 9,
      "text": "و آنها را شادمان می‌سازد.",
      "usfm": "PSA.113.9"
    },
    {
      "verse": 9,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.113.9"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/113.mp3"
