{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 77,
  "verses": [
    {
      "verse": 1,
      "text": "با صدای بلند نزد خدا زاری می‌کنم.",
      "usfm": "PSA.77.1"
    },
    {
      "verse": 1,
      "text": "در پیشگاه خدا فریاد می‌کنم تا او مرا بشنود.",
      "usfm": "PSA.77.1"
    },
    {
      "verse": 2,
      "text": "به هنگام سختی، به درگاه خداوند دعا می‌کنم",
      "usfm": "PSA.77.2"
    },
    {
      "verse": 2,
      "text": "و تمام شب دستهای خود را به سوی او بلند می‌کنم،",
      "usfm": "PSA.77.2"
    },
    {
      "verse": 2,
      "text": "امّا تسلّی نمی‌یابم.",
      "usfm": "PSA.77.2"
    },
    {
      "verse": 3,
      "text": "خدا را یاد می‌کنم و آه می‌کشم.",
      "usfm": "PSA.77.3"
    },
    {
      "verse": 3,
      "text": "زمانی که به فکر فرو می‌روم، مأیوس می‌شوم.",
      "usfm": "PSA.77.3"
    },
    {
      "verse": 4,
      "text": "خواب را از من گرفته‌ای،",
      "usfm": "PSA.77.4"
    },
    {
      "verse": 4,
      "text": "آن‌قدر پریشانم که نمی‌توانم حرف بزنم.",
      "usfm": "PSA.77.4"
    },
    {
      "verse": 5,
      "text": "به روزگار گذشته فکر می‌کنم",
      "usfm": "PSA.77.5"
    },
    {
      "verse": 5,
      "text": "و سالهای پیش را به یاد می‌آورم.",
      "usfm": "PSA.77.5"
    },
    {
      "verse": 6,
      "text": "تمام شب با خود فکر می‌کنم",
      "usfm": "PSA.77.6"
    },
    {
      "verse": 6,
      "text": "و می‌اندیشم و از خود می‌پرسم:",
      "usfm": "PSA.77.6"
    },
    {
      "verse": 7,
      "text": "«آیا خداوند ما را برای همیشه ترک خواهد کرد؟",
      "usfm": "PSA.77.7"
    },
    {
      "verse": 7,
      "text": "آیا هرگز از ما راضی نخواهد شد؟",
      "usfm": "PSA.77.7"
    },
    {
      "verse": 8,
      "text": "آیا دیگر ما را دوست ندارد؟",
      "usfm": "PSA.77.8"
    },
    {
      "verse": 8,
      "text": "آیا پیمان او با ما باطل شده است؟",
      "usfm": "PSA.77.8"
    },
    {
      "verse": 9,
      "text": "آیا خدا رحمت خود را فراموش کرده",
      "usfm": "PSA.77.9"
    },
    {
      "verse": 9,
      "text": "و خشم او، جای شفقت او را گرفته است؟»",
      "usfm": "PSA.77.9"
    },
    {
      "verse": 10,
      "text": "پس گفتم: «درد من این است",
      "usfm": "PSA.77.10"
    },
    {
      "verse": 10,
      "text": "که رفتار خدا با من عوض شده است.»",
      "usfm": "PSA.77.10"
    },
    {
      "verse": 11,
      "text": "من کارهای خداوند را به‌خاطر خواهم آورد",
      "usfm": "PSA.77.11"
    },
    {
      "verse": 11,
      "text": "و معجزات او را که در گذشته نشان داد، به یاد می‌آورم.",
      "usfm": "PSA.77.11"
    },
    {
      "verse": 12,
      "text": "دربارهٔ تمام کارهای تو تفکّر خواهم نمود",
      "usfm": "PSA.77.12"
    },
    {
      "verse": 12,
      "text": "و دربارهٔ کارهای حیرت‌انگیز تو خواهم اندیشید.",
      "usfm": "PSA.77.12"
    },
    {
      "verse": 13,
      "text": "خدایا، همهٔ کارهای تو مقدّسند.",
      "usfm": "PSA.77.13"
    },
    {
      "verse": 13,
      "text": "خدایی به بزرگی تو وجود ندارد.",
      "usfm": "PSA.77.13"
    },
    {
      "verse": 14,
      "text": "تو خدایی هستی که معجزه می‌کنی.",
      "usfm": "PSA.77.14"
    },
    {
      "verse": 14,
      "text": "تو قدرت خود را به همهٔ اقوام جهان نشان دادی.",
      "usfm": "PSA.77.14"
    },
    {
      "verse": 15,
      "text": "تو با قدرت خود، قوم خود،",
      "usfm": "PSA.77.15"
    },
    {
      "verse": 15,
      "text": "یعنی فرزندان یعقوب و یوسف را آزاد نمودی.",
      "usfm": "PSA.77.15"
    },
    {
      "verse": 16,
      "text": "ای خدا، وقتی آبها تو را دیدند، ترسیدند",
      "usfm": "PSA.77.16"
    },
    {
      "verse": 16,
      "text": "و اعماق دریا به لرزه درآمد.",
      "usfm": "PSA.77.16"
    },
    {
      "verse": 17,
      "text": "ابرها باریدند،",
      "usfm": "PSA.77.17"
    },
    {
      "verse": 17,
      "text": "رعد در آسمان غرید،",
      "usfm": "PSA.77.17"
    },
    {
      "verse": 17,
      "text": "برق در همه‌جا درخشید.",
      "usfm": "PSA.77.17"
    },
    {
      "verse": 18,
      "text": "صدای رعد تو در گِردباد بود",
      "usfm": "PSA.77.18"
    },
    {
      "verse": 18,
      "text": "و نور برق، جهان را روشن ساخت",
      "usfm": "PSA.77.18"
    },
    {
      "verse": 18,
      "text": "و زمین را به لرزه درآورد.",
      "usfm": "PSA.77.18"
    },
    {
      "verse": 19,
      "text": "از دریا عبور نمودی",
      "usfm": "PSA.77.19"
    },
    {
      "verse": 19,
      "text": "و از عمق دریا گذشتی",
      "usfm": "PSA.77.19"
    },
    {
      "verse": 19,
      "text": "ولی اثری از جای پایت دیده نشد.",
      "usfm": "PSA.77.19"
    },
    {
      "verse": 20,
      "text": "قوم خود را به وسیلهٔ موسی و هارون،",
      "usfm": "PSA.77.20"
    },
    {
      "verse": 20,
      "text": "مانند یک شبان رهبری نمودی.",
      "usfm": "PSA.77.20"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/77.mp3"
}