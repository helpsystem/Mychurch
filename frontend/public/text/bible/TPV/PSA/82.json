{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 82,
  "verses": [
    {
      "verse": 1,
      "text": "خدا در دادگاه آسمانی خود بر مسند قضاوت نشسته",
      "usfm": "PSA.82.1"
    },
    {
      "verse": 1,
      "text": "قاضیان را محاکمه می‌نماید.",
      "usfm": "PSA.82.1"
    },
    {
      "verse": 2,
      "text": "«تا به کی با بی‌عدالتی داوری می‌کنید",
      "usfm": "PSA.82.2"
    },
    {
      "verse": 2,
      "text": "و از ظالمان طرفداری می‌نمایید؟",
      "usfm": "PSA.82.2"
    },
    {
      "verse": 3,
      "text": "از حق بیچارگان و یتیمان دفاع کنید،",
      "usfm": "PSA.82.3"
    },
    {
      "verse": 3,
      "text": "و با محتاجان و درماندگان با انصاف رفتار کنید.",
      "usfm": "PSA.82.3"
    },
    {
      "verse": 4,
      "text": "آنان را از چنگ ظالمان برهانید.",
      "usfm": "PSA.82.4"
    },
    {
      "verse": 5,
      "text": "«شما احمق و نادان هستید",
      "usfm": "PSA.82.5"
    },
    {
      "verse": 5,
      "text": "و در جهالت به سر می‌برید،",
      "usfm": "PSA.82.5"
    },
    {
      "verse": 5,
      "text": "بنابراین عدالت و انصاف در جهان از بین رفته است.",
      "usfm": "PSA.82.5"
    },
    {
      "verse": 6,
      "text": "من شما را 'خدایان'",
      "usfm": "PSA.82.6"
    },
    {
      "verse": 6,
      "text": "و 'پسران خدای متعال' خطاب کردم،",
      "usfm": "PSA.82.6"
    },
    {
      "verse": 7,
      "text": "امّا شما مانند انسانهای دیگر خواهید مُرد",
      "usfm": "PSA.82.7"
    },
    {
      "verse": 7,
      "text": "و همچون سایر رهبران از دنیا خواهید رفت.»",
      "usfm": "PSA.82.7"
    },
    {
      "verse": 8,
      "text": "خدایا، بیا و جهان را داوری فرما،",
      "usfm": "PSA.82.8"
    },
    {
      "verse": 8,
      "text": "زیرا اختیار همهٔ اقوام جهان در دست توست.",
      "usfm": "PSA.82.8"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/82.mp3"
}