{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 146,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.146.1"
    },
    {
      "verse": 1,
      "text": "ای جان من، خداوند را ستایش کن!",
      "usfm": "PSA.146.1"
    },
    {
      "verse": 2,
      "text": "تا زمانی که زنده هستم، خداوند را ستایش خواهم نمود،",
      "usfm": "PSA.146.2"
    },
    {
      "verse": 2,
      "text": "تا وقتی جان در بدن دارم برای خدای خود سرود خواهم خواند.",
      "usfm": "PSA.146.2"
    },
    {
      "verse": 3,
      "text": "به رهبران انسانی توکّل نکنید،",
      "usfm": "PSA.146.3"
    },
    {
      "verse": 3,
      "text": "هیچ انسانی نمی‌‌تواند نجات بدهد.",
      "usfm": "PSA.146.3"
    },
    {
      "verse": 4,
      "text": "وقتی بمیرند، به خاک برمی‌گردند",
      "usfm": "PSA.146.4"
    },
    {
      "verse": 4,
      "text": "و در همان روز تمام نقشه‏هایی که کشیده بودند از بین می‌رود.",
      "usfm": "PSA.146.4"
    },
    {
      "verse": 5,
      "text": "خوشا به حال کسی‌که خدای یعقوب مددکار اوست",
      "usfm": "PSA.146.5"
    },
    {
      "verse": 5,
      "text": "و بر خداوند، خدای خود توکّل می‌کند،",
      "usfm": "PSA.146.5"
    },
    {
      "verse": 6,
      "text": "که آسمان و زمین و دریاها",
      "usfm": "PSA.146.6"
    },
    {
      "verse": 6,
      "text": "و هرآنچه در آنهاست آفرید،",
      "usfm": "PSA.146.6"
    },
    {
      "verse": 6,
      "text": "خدایی که پیوسته به وعده‌های خود وفادار است.",
      "usfm": "PSA.146.6"
    },
    {
      "verse": 7,
      "text": "او به فریاد مظلومان می‌رسد",
      "usfm": "PSA.146.7"
    },
    {
      "verse": 7,
      "text": "و گرسنگان را سیر می‌کند",
      "usfm": "PSA.146.7"
    },
    {
      "verse": 7,
      "text": "و اسیران را آزاد می‌سازد.",
      "usfm": "PSA.146.7"
    },
    {
      "verse": 8,
      "text": "خداوند کورها را بینا می‌سازد،",
      "usfm": "PSA.146.8"
    },
    {
      "verse": 8,
      "text": "افتادگان را برمی‌خیزاند،",
      "usfm": "PSA.146.8"
    },
    {
      "verse": 8,
      "text": "مردم نیکوکار را دوست می‌دارد.",
      "usfm": "PSA.146.8"
    },
    {
      "verse": 9,
      "text": "خداوند غریبان را محافظت می‌کند،",
      "usfm": "PSA.146.9"
    },
    {
      "verse": 9,
      "text": "و از بیوه زنان و یتیمان مراقبت می‌نماید.",
      "usfm": "PSA.146.9"
    },
    {
      "verse": 9,
      "text": "امّا شریران را هلاک می‌سازد.",
      "usfm": "PSA.146.9"
    },
    {
      "verse": 10,
      "text": "سلطنت خداوند جاودان است،",
      "usfm": "PSA.146.10"
    },
    {
      "verse": 10,
      "text": "و خدای تو ای صهیون، تا ابد فرمانروایی می‌کند.",
      "usfm": "PSA.146.10"
    },
    {
      "verse": 10,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.146.10"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/146.mp3"
}