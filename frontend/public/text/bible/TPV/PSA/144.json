{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 144,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند را که پشتیبان من است سپاس باد!",
      "usfm": "PSA.144.1"
    },
    {
      "verse": 1,
      "text": "او مرا برای میدان جنگ تعلیم می‌دهد.",
      "usfm": "PSA.144.1"
    },
    {
      "verse": 2,
      "text": "او پشت و پناه من است،",
      "usfm": "PSA.144.2"
    },
    {
      "verse": 2,
      "text": "او سپر و نجات‌دهندهٔ من است،",
      "usfm": "PSA.144.2"
    },
    {
      "verse": 2,
      "text": "به او توکّل دارم",
      "usfm": "PSA.144.2"
    },
    {
      "verse": 2,
      "text": "و او مردم را تحت فرمان من خواهد آورد.",
      "usfm": "PSA.144.2"
    },
    {
      "verse": 3,
      "text": "خداوندا، انسان چیست که تو به او توجّه داری؟",
      "usfm": "PSA.144.3"
    },
    {
      "verse": 3,
      "text": "و بنی‌آدم کیست که او را به‌خاطر آوری؟",
      "usfm": "PSA.144.3"
    },
    {
      "verse": 4,
      "text": "او مانند سایه درگذر است",
      "usfm": "PSA.144.4"
    },
    {
      "verse": 4,
      "text": "و عمرش بیش از یک نفس نیست.",
      "usfm": "PSA.144.4"
    },
    {
      "verse": 5,
      "text": "ای خداوند، آسمان را بگشا و پایین بیا.",
      "usfm": "PSA.144.5"
    },
    {
      "verse": 5,
      "text": "کوهها را لمس کن تا از آنها دود برخیزد.",
      "usfm": "PSA.144.5"
    },
    {
      "verse": 6,
      "text": "رعد و برق را بفرست و دشمنان خود را پراکنده کن",
      "usfm": "PSA.144.6"
    },
    {
      "verse": 6,
      "text": "و با تیرهای خود آنها را تار و مار گردان.",
      "usfm": "PSA.144.6"
    },
    {
      "verse": 7,
      "text": "دست خود را از عالم بالا دراز کن",
      "usfm": "PSA.144.7"
    },
    {
      "verse": 7,
      "text": "و مرا از عمق آبها،",
      "usfm": "PSA.144.7"
    },
    {
      "verse": 7,
      "text": "و از دست این بیگانگان نجات بده.",
      "usfm": "PSA.144.7"
    },
    {
      "verse": 8,
      "text": "حرفهای آنان دروغ است",
      "usfm": "PSA.144.8"
    },
    {
      "verse": 8,
      "text": "و قسم دروغ می‌خورند.",
      "usfm": "PSA.144.8"
    },
    {
      "verse": 9,
      "text": "خداوندا، برای تو سرودی تازه می‌خوانم",
      "usfm": "PSA.144.9"
    },
    {
      "verse": 9,
      "text": "و با بربط ده تار می‌سرایم.",
      "usfm": "PSA.144.9"
    },
    {
      "verse": 10,
      "text": "پادشاهان را به پیروزی می‌رسانی",
      "usfm": "PSA.144.10"
    },
    {
      "verse": 10,
      "text": "و بنده‌ات، داوود را آزاد می‌سازی.",
      "usfm": "PSA.144.10"
    },
    {
      "verse": 11,
      "text": "خداوندا، مرا از دست دشمن ظالم برهان",
      "usfm": "PSA.144.11"
    },
    {
      "verse": 11,
      "text": "و از چنگ بیگانگان",
      "usfm": "PSA.144.11"
    },
    {
      "verse": 11,
      "text": "که سخنانشان سراسر دروغ است،",
      "usfm": "PSA.144.11"
    },
    {
      "verse": 11,
      "text": "نجات بده.",
      "usfm": "PSA.144.11"
    },
    {
      "verse": 12,
      "text": "پسران ما در جوانی،",
      "usfm": "PSA.144.12"
    },
    {
      "verse": 12,
      "text": "همچون نهالان، برومند و قد بلند گردند،",
      "usfm": "PSA.144.12"
    },
    {
      "verse": 12,
      "text": "دختران ما،",
      "usfm": "PSA.144.12"
    },
    {
      "verse": 12,
      "text": "چون ستونهای تراشیدهٔ کاخ پادشاهان باشند،",
      "usfm": "PSA.144.12"
    },
    {
      "verse": 13,
      "text": "انبارهای ما،",
      "usfm": "PSA.144.13"
    },
    {
      "verse": 13,
      "text": "پُر از محصولات گوناگون، و گوسفندان ما در صحرا هزاران برّه بزایند.",
      "usfm": "PSA.144.13"
    },
    {
      "verse": 14,
      "text": "گاوهای ما، بدون از دست دادن گوساله‌ای،",
      "usfm": "PSA.144.14"
    },
    {
      "verse": 14,
      "text": "بارور و کثیر شوند.",
      "usfm": "PSA.144.14"
    },
    {
      "verse": 14,
      "text": "در کوچه‌های ما صدای هیچ غم و ناله‌ای نباشد.",
      "usfm": "PSA.144.14"
    },
    {
      "verse": 15,
      "text": "خوشا به حال ملّتی که از این برکات بهره‌مند گردند",
      "usfm": "PSA.144.15"
    },
    {
      "verse": 15,
      "text": "و خوشا به حال قومی که خداوند، خدای ایشان است.",
      "usfm": "PSA.144.15"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/144.mp3"
}