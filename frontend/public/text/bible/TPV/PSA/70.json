{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 70,
  "verses": [
    {
      "verse": 1,
      "text": "خدایا مرا نجات بده،",
      "usfm": "PSA.70.1"
    },
    {
      "verse": 1,
      "text": "خداوندا، اکنون به فریادم برس.",
      "usfm": "PSA.70.1"
    },
    {
      "verse": 2,
      "text": "آنانی که قصد جان مرا دارند",
      "usfm": "PSA.70.2"
    },
    {
      "verse": 2,
      "text": "شرمنده و رسوا شوند",
      "usfm": "PSA.70.2"
    },
    {
      "verse": 2,
      "text": "و بدخواهان من آشفته",
      "usfm": "PSA.70.2"
    },
    {
      "verse": 2,
      "text": "و پریشان گردند.",
      "usfm": "PSA.70.2"
    },
    {
      "verse": 3,
      "text": "کسانی‌كه مرا مسخره می‌کنند،",
      "usfm": "PSA.70.3"
    },
    {
      "verse": 3,
      "text": "هراسان شوند.",
      "usfm": "PSA.70.3"
    },
    {
      "verse": 4,
      "text": "کسانی‌که به تو روی می‌آورند شاد و مسرور گردند.",
      "usfm": "PSA.70.4"
    },
    {
      "verse": 4,
      "text": "آنانی که به‌خاطر نجات خود از تو سپاسگزارند،",
      "usfm": "PSA.70.4"
    },
    {
      "verse": 4,
      "text": "همیشه بگویند: «خدا چقدر بزرگ است!»",
      "usfm": "PSA.70.4"
    },
    {
      "verse": 5,
      "text": "خدایا، من فقیر و نیازمندم،",
      "usfm": "PSA.70.5"
    },
    {
      "verse": 5,
      "text": "برای کمک به من شتاب کن،",
      "usfm": "PSA.70.5"
    },
    {
      "verse": 5,
      "text": "تو خداوند و نجات‌دهندهٔ من هستی.",
      "usfm": "PSA.70.5"
    },
    {
      "verse": 5,
      "text": "پس ای خداوند، تأخیر مکن.",
      "usfm": "PSA.70.5"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/70.mp3"
}