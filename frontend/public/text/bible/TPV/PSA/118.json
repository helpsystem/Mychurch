{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 118,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند را شکر کنید، زیرا که نیکوست",
      "usfm": "PSA.118.1"
    },
    {
      "verse": 1,
      "text": "و محبّت پایدار او ابدی است.",
      "usfm": "PSA.118.1"
    },
    {
      "verse": 2,
      "text": "بنی‌اسرائیل بگویند:",
      "usfm": "PSA.118.2"
    },
    {
      "verse": 2,
      "text": "«محبّت پایدار او ابدی است.»",
      "usfm": "PSA.118.2"
    },
    {
      "verse": 3,
      "text": "کاهنان خداوند بگویند:",
      "usfm": "PSA.118.3"
    },
    {
      "verse": 3,
      "text": "«محبّت پایدار او ابدی است.»",
      "usfm": "PSA.118.3"
    },
    {
      "verse": 4,
      "text": "تمام کسانی‌که از خداوند می‌ترسند، بگویند:",
      "usfm": "PSA.118.4"
    },
    {
      "verse": 4,
      "text": "«محبّت پایدار او ابدی است.»",
      "usfm": "PSA.118.4"
    },
    {
      "verse": 5,
      "text": "در هنگام پریشانی نزد خداوند دعا کردم.",
      "usfm": "PSA.118.5"
    },
    {
      "verse": 5,
      "text": "او دعایم را مستجاب کرد و مرا رهایی بخشید.",
      "usfm": "PSA.118.5"
    },
    {
      "verse": 6,
      "text": "خداوند با من است، پس نخواهم ترسید،",
      "usfm": "PSA.118.6"
    },
    {
      "verse": 6,
      "text": "انسان به من چه ‌می‌تواند بکند؟",
      "usfm": "PSA.118.6"
    },
    {
      "verse": 7,
      "text": "خداوند در کنار من و یاور من است،",
      "usfm": "PSA.118.7"
    },
    {
      "verse": 7,
      "text": "پس بر دشمنان خود پیروز خواهم شد.",
      "usfm": "PSA.118.7"
    },
    {
      "verse": 8,
      "text": "توکّل کردن بر خداوند،",
      "usfm": "PSA.118.8"
    },
    {
      "verse": 8,
      "text": "بهتر از اعتماد داشتن به انسان است.",
      "usfm": "PSA.118.8"
    },
    {
      "verse": 9,
      "text": "توکّل کردن بر خداوند،",
      "usfm": "PSA.118.9"
    },
    {
      "verse": 9,
      "text": "بهتر از اعتماد داشتن بر رهبران است.",
      "usfm": "PSA.118.9"
    },
    {
      "verse": 10,
      "text": "هر چند تمام اقوام جهان محاصره‌ام كردند،",
      "usfm": "PSA.118.10"
    },
    {
      "verse": 10,
      "text": "امّا با نام خداوند همه را شکست دادم.",
      "usfm": "PSA.118.10"
    },
    {
      "verse": 11,
      "text": "آنها از هر طرف احاطه‌ام نمودند،",
      "usfm": "PSA.118.11"
    },
    {
      "verse": 11,
      "text": "ولی با قدرت خداوند، آنها را از بین بردم.",
      "usfm": "PSA.118.11"
    },
    {
      "verse": 12,
      "text": "آنها مانند زنبور بر من هجوم آوردند",
      "usfm": "PSA.118.12"
    },
    {
      "verse": 12,
      "text": "و مانند شعله‌های آتش دورم را گرفتند،",
      "usfm": "PSA.118.12"
    },
    {
      "verse": 12,
      "text": "امّا با کمک خداوند آنها را نابود كردم.",
      "usfm": "PSA.118.12"
    },
    {
      "verse": 13,
      "text": "بر من هجوم آوردند تا مرا شکست دهند",
      "usfm": "PSA.118.13"
    },
    {
      "verse": 13,
      "text": "امّا خداوند به کمک من رسید.",
      "usfm": "PSA.118.13"
    },
    {
      "verse": 14,
      "text": "خداوند قوّت من، توانایی من",
      "usfm": "PSA.118.14"
    },
    {
      "verse": 14,
      "text": "و نجات‌دهندهٔ من است.",
      "usfm": "PSA.118.14"
    },
    {
      "verse": 16,
      "text": "فریاد شادی پیروزی را",
      "usfm": "PSA.118.15+PSA.118.16"
    },
    {
      "verse": 16,
      "text": "از چادر‌های قوم خدا بشنوید که می‌گویند:",
      "usfm": "PSA.118.15+PSA.118.16"
    },
    {
      "verse": 16,
      "text": "«دست پُر قدرت خداوند",
      "usfm": "PSA.118.15+PSA.118.16"
    },
    {
      "verse": 16,
      "text": "این پیروزی را نصیب ما ساخته است.»",
      "usfm": "PSA.118.15+PSA.118.16"
    },
    {
      "verse": 17,
      "text": "من نخواهم مرد، بلکه زنده خواهم ماند",
      "usfm": "PSA.118.17"
    },
    {
      "verse": 17,
      "text": "تا کارهای خداوند را بیان نمایم.",
      "usfm": "PSA.118.17"
    },
    {
      "verse": 18,
      "text": "گرچه خداوند مرا به سختی تنبیه نمود،",
      "usfm": "PSA.118.18"
    },
    {
      "verse": 18,
      "text": "ولی نگذاشت که بمیرم.",
      "usfm": "PSA.118.18"
    },
    {
      "verse": 19,
      "text": "دروازه‌های معبد بزرگ را برایم باز کنید",
      "usfm": "PSA.118.19"
    },
    {
      "verse": 19,
      "text": "تا به آنجا وارد شوم و خداوند را ستایش کنم.",
      "usfm": "PSA.118.19"
    },
    {
      "verse": 20,
      "text": "این دروازهٔ خداوند است،",
      "usfm": "PSA.118.20"
    },
    {
      "verse": 20,
      "text": "فقط نیکوکاران می‌توانند از آن وارد شوند.",
      "usfm": "PSA.118.20"
    },
    {
      "verse": 21,
      "text": "از اینکه دعای مرا مستجاب فرمودی",
      "usfm": "PSA.118.21"
    },
    {
      "verse": 21,
      "text": "و به من پیروزی عطا کردی، از تو سپاسگزارم.",
      "usfm": "PSA.118.21"
    },
    {
      "verse": 22,
      "text": "سنگی را که معماران رد کردند،",
      "usfm": "PSA.118.22"
    },
    {
      "verse": 22,
      "text": "اکنون مهمترین سنگ بنا شده است.",
      "usfm": "PSA.118.22"
    },
    {
      "verse": 23,
      "text": "این کار خداوند است",
      "usfm": "PSA.118.23"
    },
    {
      "verse": 23,
      "text": "که به نظر ما عجیب می‌آید.",
      "usfm": "PSA.118.23"
    },
    {
      "verse": 24,
      "text": "این است روزی که خداوند ساخته است،",
      "usfm": "PSA.118.24"
    },
    {
      "verse": 24,
      "text": "بیایید تا با هم شادی کنیم و آن را جشن بگیریم.",
      "usfm": "PSA.118.24"
    },
    {
      "verse": 25,
      "text": "خداوندا! التماس می‌کنیم ما را نجات دهی،",
      "usfm": "PSA.118.25"
    },
    {
      "verse": 25,
      "text": "آه ای خداوند تمنّا می‌کنیم که به ما پیروزی عطا كنی.",
      "usfm": "PSA.118.25"
    },
    {
      "verse": 26,
      "text": "مبارک باد آن کسی‌که به نام خداوند می‌آید،",
      "usfm": "PSA.118.26"
    },
    {
      "verse": 26,
      "text": "ما شما را از معبد بزرگ خداوند برکت می‌دهیم.",
      "usfm": "PSA.118.26"
    },
    {
      "verse": 27,
      "text": "خداوند، خدایی است که ما را سعادت بخشیده است.",
      "usfm": "PSA.118.27"
    },
    {
      "verse": 27,
      "text": "شاخه‌ها را به دست بگیرید",
      "usfm": "PSA.118.27"
    },
    {
      "verse": 27,
      "text": "و قربانگاه او را طواف کنید.",
      "usfm": "PSA.118.27"
    },
    {
      "verse": 28,
      "text": "تو خدای من هستی، من از تو سپاسگزارم",
      "usfm": "PSA.118.28"
    },
    {
      "verse": 28,
      "text": "و تو را ستایش می‌کنم.",
      "usfm": "PSA.118.28"
    },
    {
      "verse": 29,
      "text": "خداوند را سپاس بگویید، زیرا که نیکوست",
      "usfm": "PSA.118.29"
    },
    {
      "verse": 29,
      "text": "و محبّت پایدار او ابدی است.",
      "usfm": "PSA.118.29"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/118.mp3"
}