{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 14,
  "verses": [
    {
      "verse": 1,
      "text": "احمقان در دل خود می‌گویند:",
      "usfm": "PSA.14.1"
    },
    {
      "verse": 1,
      "text": "«خدا وجود ندارد.»",
      "usfm": "PSA.14.1"
    },
    {
      "verse": 1,
      "text": "اینها اشخاصی فاسد هستند",
      "usfm": "PSA.14.1"
    },
    {
      "verse": 1,
      "text": "و کارهای زشت می‌کنند",
      "usfm": "PSA.14.1"
    },
    {
      "verse": 1,
      "text": "و کار نیک از آنها سر نمی‌زند.",
      "usfm": "PSA.14.1"
    },
    {
      "verse": 2,
      "text": "خداوند از آسمان بر مردم روی زمین می‌نگرد",
      "usfm": "PSA.14.2"
    },
    {
      "verse": 2,
      "text": "تا ببیند که آیا شخص فهمیده‌ای وجود دارد",
      "usfm": "PSA.14.2"
    },
    {
      "verse": 2,
      "text": "که طالب خدا باشد.",
      "usfm": "PSA.14.2"
    },
    {
      "verse": 3,
      "text": "امّا همه گمراه و یکسان فاسد شده‌اند.",
      "usfm": "PSA.14.3"
    },
    {
      "verse": 3,
      "text": "حتّی یک نفر نیكوکار هم در بین آنها نیست.",
      "usfm": "PSA.14.3"
    },
    {
      "verse": 4,
      "text": "خداوند می‌پرسد:",
      "usfm": "PSA.14.4"
    },
    {
      "verse": 4,
      "text": "«آیا این بدکاران شعور ندارند",
      "usfm": "PSA.14.4"
    },
    {
      "verse": 4,
      "text": "که بندگان مرا مانند نان می‌خورند",
      "usfm": "PSA.14.4"
    },
    {
      "verse": 4,
      "text": "و مرا به یاد نمی‌آورند؟»",
      "usfm": "PSA.14.4"
    },
    {
      "verse": 5,
      "text": "امّا آنها به وحشت خواهند افتاد،",
      "usfm": "PSA.14.5"
    },
    {
      "verse": 5,
      "text": "زیرا خدا مددکار نیکوکاران است.",
      "usfm": "PSA.14.5"
    },
    {
      "verse": 6,
      "text": "وقتی بدکاران نقشه‌های مسکینان را خراب می‌کنند،",
      "usfm": "PSA.14.6"
    },
    {
      "verse": 6,
      "text": "خداوند پناهگاه آنان است.",
      "usfm": "PSA.14.6"
    },
    {
      "verse": 7,
      "text": "ای کاش پیروزی",
      "usfm": "PSA.14.7"
    },
    {
      "verse": 7,
      "text": "برای بنی‌اسرائیل از صهیون بیاید،",
      "usfm": "PSA.14.7"
    },
    {
      "verse": 7,
      "text": "وقتی خداوند قوم خود را از اسارت آزاد کند،",
      "usfm": "PSA.14.7"
    },
    {
      "verse": 7,
      "text": "یعقوب شاد خواهد شد و بنی‌اسرائیل شادی خواهد کرد.",
      "usfm": "PSA.14.7"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/14.mp3"
}