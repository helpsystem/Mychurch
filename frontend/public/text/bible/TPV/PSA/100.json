{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 100,
  "verses": [
    {
      "verse": 1,
      "text": "ای مردم جهان، برای خداوند آواز شادی بخوانید.",
      "usfm": "PSA.100.1"
    },
    {
      "verse": 2,
      "text": "خداوند را با شادی پرستش کنید،",
      "usfm": "PSA.100.2"
    },
    {
      "verse": 2,
      "text": "با سرودهای نشاط‌انگیز به حضور او بیایید.",
      "usfm": "PSA.100.2"
    },
    {
      "verse": 3,
      "text": "بدانید که خداوند، خداست.",
      "usfm": "PSA.100.3"
    },
    {
      "verse": 3,
      "text": "او ما را آفرید و ما متعلّق به او هستیم.",
      "usfm": "PSA.100.3"
    },
    {
      "verse": 3,
      "text": "ما قوم او و گوسفندان چراگاه او می‌باشیم.",
      "usfm": "PSA.100.3"
    },
    {
      "verse": 4,
      "text": "با شکرگزاری به درگاه او بیایید",
      "usfm": "PSA.100.4"
    },
    {
      "verse": 4,
      "text": "و در صحنهای او، او را بپرستید،",
      "usfm": "PSA.100.4"
    },
    {
      "verse": 4,
      "text": "او را شکر کنید و نام او را بستایید.",
      "usfm": "PSA.100.4"
    },
    {
      "verse": 5,
      "text": "زیرا او خدای مهربان است",
      "usfm": "PSA.100.5"
    },
    {
      "verse": 5,
      "text": "و محبّت پایدار",
      "usfm": "PSA.100.5"
    },
    {
      "verse": 5,
      "text": "و وفاداری او تا ابد استوار است.",
      "usfm": "PSA.100.5"
    }
  ],
