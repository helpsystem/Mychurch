{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 105,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند را شکر کنید",
      "usfm": "PSA.105.1"
    },
    {
      "verse": 1,
      "text": "و عظمت او را بیان نمایید.",
      "usfm": "PSA.105.1"
    },
    {
      "verse": 1,
      "text": "کارهایی را که انجام داده است، به جهانیان اعلام نمایید.",
      "usfm": "PSA.105.1"
    },
    {
      "verse": 2,
      "text": "برای او سرود حمد بسرایید",
      "usfm": "PSA.105.2"
    },
    {
      "verse": 2,
      "text": "و کارهای عظیم او را به مردم بگویید.",
      "usfm": "PSA.105.2"
    },
    {
      "verse": 3,
      "text": "جلال بر نام مقدّس او باد!",
      "usfm": "PSA.105.3"
    },
    {
      "verse": 3,
      "text": "شادمان باد دلهای کسانی‌که خداوند را می‌جویند!",
      "usfm": "PSA.105.3"
    },
    {
      "verse": 4,
      "text": "از خدا کمک بطلبید",
      "usfm": "PSA.105.4"
    },
    {
      "verse": 4,
      "text": "و همیشه او را بپرستید.",
      "usfm": "PSA.105.4"
    },
    {
      "verse": 6,
      "text": "ای فرزندانِ بندهٔ او ابراهیم،",
      "usfm": "PSA.105.5+PSA.105.6"
    },
    {
      "verse": 6,
      "text": "و ای فرزندان یعقوب، برگزیدهٔ او،",
      "usfm": "PSA.105.5+PSA.105.6"
    },
    {
      "verse": 6,
      "text": "معجزات و داوریهای خدا را به‌ یاد آورید.",
      "usfm": "PSA.105.5+PSA.105.6"
    },
    {
      "verse": 7,
      "text": "خداوند، خدای ماست.",
      "usfm": "PSA.105.7"
    },
    {
      "verse": 7,
      "text": "او همهٔ زمین را داوری می‌کند.",
      "usfm": "PSA.105.7"
    },
    {
      "verse": 8,
      "text": "او پیمان خود را تا به ابد نگاه خواهد داشت،",
      "usfm": "PSA.105.8"
    },
    {
      "verse": 8,
      "text": "کلامی را که فرمان داد، برای هزار نسل.",
      "usfm": "PSA.105.8"
    },
    {
      "verse": 9,
      "text": "پیمانی را که با ابراهیم بست،",
      "usfm": "PSA.105.9"
    },
    {
      "verse": 9,
      "text": "وسوگندی را که با اسحاق یاد کرد، حفظ خواهد نمود.",
      "usfm": "PSA.105.9"
    },
    {
      "verse": 10,
      "text": "عهدی با یعقوب بست،",
      "usfm": "PSA.105.10"
    },
    {
      "verse": 10,
      "text": "پیمانی جاودانه با اسرائیل.",
      "usfm": "PSA.105.10"
    },
    {
      "verse": 11,
      "text": "خداوند فرمود: «سرزمین کنعان را",
      "usfm": "PSA.105.11"
    },
    {
      "verse": 11,
      "text": "به عنوان ملکیّت به شما می‌بخشم.»",
      "usfm": "PSA.105.11"
    },
    {
      "verse": 12,
      "text": "وقتی تعداد آنها کم بود",
      "usfm": "PSA.105.12"
    },
    {
      "verse": 12,
      "text": "و در سرزمین کنعان غریب",
      "usfm": "PSA.105.12"
    },
    {
      "verse": 13,
      "text": "و در کشورها و سلطنت‌ها سرگردان بودند،",
      "usfm": "PSA.105.13"
    },
    {
      "verse": 14,
      "text": "خداوند به هیچ‌کس اجازه نداد که به آنها آزاری برساند",
      "usfm": "PSA.105.14"
    },
    {
      "verse": 14,
      "text": "و برای پشتیبانی آنها به پادشاهان هشدار داد",
      "usfm": "PSA.105.14"
    },
    {
      "verse": 15,
      "text": "و فرمود: «به برگزیدگان من ظلم نکنید",
      "usfm": "PSA.105.15"
    },
    {
      "verse": 15,
      "text": "و به انبیای من ضرر نرسانید.»",
      "usfm": "PSA.105.15"
    },
    {
      "verse": 16,
      "text": "وقتی‌که خداوند قحطی در کشور پدید آورد",
      "usfm": "PSA.105.16"
    },
    {
      "verse": 16,
      "text": "و هیچ چیزی برای خوردن پیدا نمی‌شد،",
      "usfm": "PSA.105.16"
    },
    {
      "verse": 17,
      "text": "یوسف را پیشتر از آنها به مصر فرستاد،",
      "usfm": "PSA.105.17"
    },
    {
      "verse": 17,
      "text": "که به عنوان غلام فروخته شد.",
      "usfm": "PSA.105.17"
    },
    {
      "verse": 18,
      "text": "پاهای او را با زنجیر بستند",
      "usfm": "PSA.105.18"
    },
    {
      "verse": 18,
      "text": "و یوغ آهنین بر گردنش گذاشتند.",
      "usfm": "PSA.105.18"
    },
    {
      "verse": 19,
      "text": "تا زمانی که گفته‌های او به حقیقت پیوست",
      "usfm": "PSA.105.19"
    },
    {
      "verse": 19,
      "text": "و کلام خداوند سخن او را تأیید کرد.",
      "usfm": "PSA.105.19"
    },
    {
      "verse": 20,
      "text": "پس فرعون او را آزاد کرد",
      "usfm": "PSA.105.20"
    },
    {
      "verse": 20,
      "text": "و فرماندار مردم او را رها نمود.",
      "usfm": "PSA.105.20"
    },
    {
      "verse": 21,
      "text": "سپس او را بر کاخ خود حاکم ساخت",
      "usfm": "PSA.105.21"
    },
    {
      "verse": 21,
      "text": "و او را فرماندار تمام سرزمین خود نمود،",
      "usfm": "PSA.105.21"
    },
    {
      "verse": 22,
      "text": "تا تمام بزرگان مملکت را تحت فرمان خود درآوَرَد",
      "usfm": "PSA.105.22"
    },
    {
      "verse": 22,
      "text": "و رهبران قوم را تعلیم دهد.",
      "usfm": "PSA.105.22"
    },
    {
      "verse": 23,
      "text": "سپس یعقوب به مصر آمد",
      "usfm": "PSA.105.23"
    },
    {
      "verse": 23,
      "text": "و به عنوان بیگانه در آنجا ساکن شد.",
      "usfm": "PSA.105.23"
    },
    {
      "verse": 24,
      "text": "خداوند در آنجا فرزندان زیادی به آنها داد",
      "usfm": "PSA.105.24"
    },
    {
      "verse": 24,
      "text": "و آنها را از دشمنانشان قویتر ساخت.",
      "usfm": "PSA.105.24"
    },
    {
      "verse": 25,
      "text": "خداوند کاری کرد که مردم مصر از قوم اسرائیل متنفّر شدند",
      "usfm": "PSA.105.25"
    },
    {
      "verse": 25,
      "text": "و با آنها با حیله رفتار کردند.",
      "usfm": "PSA.105.25"
    },
    {
      "verse": 26,
      "text": "سپس خدا موسی خادم خود",
      "usfm": "PSA.105.26"
    },
    {
      "verse": 26,
      "text": "و هارون برگزیدهٔ خویش را فرستاد.",
      "usfm": "PSA.105.26"
    },
    {
      "verse": 27,
      "text": "آنها قدرت خداوند را با انجام معجزات",
      "usfm": "PSA.105.27"
    },
    {
      "verse": 27,
      "text": "در سرزمین مصر نشان دادند.",
      "usfm": "PSA.105.27"
    },
    {
      "verse": 28,
      "text": "خدا تاریکی بر آن سرزمین فرستاد،",
      "usfm": "PSA.105.28"
    },
    {
      "verse": 28,
      "text": "امّا مصریان امر او را اطاعت نکردند.",
      "usfm": "PSA.105.28"
    },
    {
      "verse": 29,
      "text": "رودخانه‏های آنها را به خون تبدیل کرد",
      "usfm": "PSA.105.29"
    },
    {
      "verse": 29,
      "text": "و همهٔ ماهیان آنها را کشت.",
      "usfm": "PSA.105.29"
    },
    {
      "verse": 30,
      "text": "بعد قورباغه‏ها به آن سرزمین هجوم آوردند",
      "usfm": "PSA.105.30"
    },
    {
      "verse": 30,
      "text": "و حتّی کاخ سلطنتی هم پُر از قورباغه شد.",
      "usfm": "PSA.105.30"
    },
    {
      "verse": 31,
      "text": "به امر خداوند انواع مگس و پشه",
      "usfm": "PSA.105.31"
    },
    {
      "verse": 31,
      "text": "سراسر آن سرزمین را پُر ساخت.",
      "usfm": "PSA.105.31"
    },
    {
      "verse": 32,
      "text": "به جای باران،",
      "usfm": "PSA.105.32"
    },
    {
      "verse": 32,
      "text": "تگرگ و رعد و برق را به سرزمینشان فرستاد.",
      "usfm": "PSA.105.32"
    },
    {
      "verse": 33,
      "text": "تاکستانها و درختان انجیر",
      "usfm": "PSA.105.33"
    },
    {
      "verse": 33,
      "text": "و درختان آنها را از بین برد.",
      "usfm": "PSA.105.33"
    },
    {
      "verse": 34,
      "text": "به فرمان او،",
      "usfm": "PSA.105.34"
    },
    {
      "verse": 34,
      "text": "میلیونها ملخ حمله‌ور شدند،",
      "usfm": "PSA.105.34"
    },
    {
      "verse": 35,
      "text": "و همهٔ نباتات",
      "usfm": "PSA.105.35"
    },
    {
      "verse": 35,
      "text": "و غلاّت آنجا را خوردند.",
      "usfm": "PSA.105.35"
    },
    {
      "verse": 36,
      "text": "او تمام نخستزادگان مصریان را",
      "usfm": "PSA.105.36"
    },
    {
      "verse": 36,
      "text": "به قتل رسانید.",
      "usfm": "PSA.105.36"
    },
    {
      "verse": 37,
      "text": "آنگاه قوم اسرائیل را که همگی سالم و نیرومند بودند،",
      "usfm": "PSA.105.37"
    },
    {
      "verse": 37,
      "text": "با نقره و طلا از مصر خارج کرد.",
      "usfm": "PSA.105.37"
    },
    {
      "verse": 38,
      "text": "چون مردم مصر از آنها می‌ترسیدند،",
      "usfm": "PSA.105.38"
    },
    {
      "verse": 38,
      "text": "از رفتن ایشان خوشحال شدند.",
      "usfm": "PSA.105.38"
    },
    {
      "verse": 39,
      "text": "خدا به هنگام روز ابر را سایبان آنها ساخت",
      "usfm": "PSA.105.39"
    },
    {
      "verse": 39,
      "text": "و هنگام شب با ستون آتش به آنها روشنایی می‌بخشید.",
      "usfm": "PSA.105.39"
    },
    {
      "verse": 40,
      "text": "آنها از او تقاضا کردند و او به آنها بلدرچین داد",
      "usfm": "PSA.105.40"
    },
    {
      "verse": 40,
      "text": "و برایشان غذای فراوان از آسمان فرستاد تا سیر شوند.",
      "usfm": "PSA.105.40"
    },
    {
      "verse": 41,
      "text": "صخره را شکافت و از آن آب گوارا فوران کرد",
      "usfm": "PSA.105.41"
    },
    {
      "verse": 41,
      "text": "و مثل رودخانه در صحرای خشک جاری شد.",
      "usfm": "PSA.105.41"
    },
    {
      "verse": 42,
      "text": "زیرا پیمان مقدّس خود را با ابراهیم به یاد آورد.",
      "usfm": "PSA.105.42"
    },
    {
      "verse": 43,
      "text": "به این ترتیب قوم برگزیدهٔ خود را",
      "usfm": "PSA.105.43"
    },
    {
      "verse": 43,
      "text": "با سرود شادمانی از مصر بیرون آورد.",
      "usfm": "PSA.105.43"
    },
    {
      "verse": 44,
      "text": "او سرزمین اقوام دیگر را",
      "usfm": "PSA.105.44"
    },
    {
      "verse": 44,
      "text": "با تمام محصولاتش به آنها داد",
      "usfm": "PSA.105.44"
    },
    {
      "verse": 45,
      "text": "تا احکام او را بجا آورند و قوانین او را اطاعت نمایند.",
      "usfm": "PSA.105.45"
    },
    {
      "verse": 45,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.105.45"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/105.mp3"
}