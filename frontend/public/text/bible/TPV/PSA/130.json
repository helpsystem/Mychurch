{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 130,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، از شدّت غم و اندوه به درگاه تو فریاد می‌کنم.",
      "usfm": "PSA.130.1"
    },
    {
      "verse": 2,
      "text": "خداوندا، فریاد مرا بشنو",
      "usfm": "PSA.130.2"
    },
    {
      "verse": 2,
      "text": "و به دعای من توجّه فرما.",
      "usfm": "PSA.130.2"
    },
    {
      "verse": 3,
      "text": "خداوندا، اگر گناهان ما را به یاد آوری،",
      "usfm": "PSA.130.3"
    },
    {
      "verse": 3,
      "text": "چه کسی تبرئه خواهد شد؟",
      "usfm": "PSA.130.3"
    },
    {
      "verse": 4,
      "text": "امّا تو، خدای بخشنده هستی",
      "usfm": "PSA.130.4"
    },
    {
      "verse": 4,
      "text": "و ما باید به تو احترام بگذاریم.",
      "usfm": "PSA.130.4"
    },
    {
      "verse": 5,
      "text": "من بی‌صبرانه منتظر کمک از جانب خداوند هستم،",
      "usfm": "PSA.130.5"
    },
    {
      "verse": 5,
      "text": "زیرا به وعدهٔ او اعتماد دارم.",
      "usfm": "PSA.130.5"
    },
    {
      "verse": 6,
      "text": "من بیشتر از نگهبانانی",
      "usfm": "PSA.130.6"
    },
    {
      "verse": 6,
      "text": "که منتظر طلوع صبح هستند،",
      "usfm": "PSA.130.6"
    },
    {
      "verse": 6,
      "text": "در انتظار خداوند می‌باشم.",
      "usfm": "PSA.130.6"
    },
    {
      "verse": 7,
      "text": "ای اسرائیل، بر خداوند توکّل کن،",
      "usfm": "PSA.130.7"
    },
    {
      "verse": 7,
      "text": "زیرا از روی محبّت پایدارش",
      "usfm": "PSA.130.7"
    },
    {
      "verse": 7,
      "text": "همیشه مایل است که شما را نجات بخشد.",
      "usfm": "PSA.130.7"
    },
    {
      "verse": 8,
      "text": "او قوم خود، اسرائیل را",
      "usfm": "PSA.130.8"
    },
    {
      "verse": 8,
      "text": "از تمام گناهانشان نجات می‏بخشد.",
      "usfm": "PSA.130.8"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/130.mp3"
}