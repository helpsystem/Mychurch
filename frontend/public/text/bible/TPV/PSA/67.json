{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 67,
  "verses": [
    {
      "verse": 1,
      "text": "خدایا بر ما رحم کن و ما را برکت بده",
      "usfm": "PSA.67.1"
    },
    {
      "verse": 1,
      "text": "و نور روی خود را بر ما بتابان.",
      "usfm": "PSA.67.1"
    },
    {
      "verse": 2,
      "text": "تا همهٔ مردم راه تو را بشناسند",
      "usfm": "PSA.67.2"
    },
    {
      "verse": 2,
      "text": "و قدرت نجات‌بخش تو، بر همهٔ ملّتها آشکار گردد.",
      "usfm": "PSA.67.2"
    },
    {
      "verse": 3,
      "text": "تا ای خدا، تمام مردم تو را بپرستند",
      "usfm": "PSA.67.3"
    },
    {
      "verse": 3,
      "text": "و ستایش کنند.",
      "usfm": "PSA.67.3"
    },
    {
      "verse": 4,
      "text": "تا تمام ملّتها شادمان باشند و از خوشی بسرایند،",
      "usfm": "PSA.67.4"
    },
    {
      "verse": 4,
      "text": "زیرا که تو مردم را با عدالت داوری می‌کنی",
      "usfm": "PSA.67.4"
    },
    {
      "verse": 4,
      "text": "و آنها را هدایت می‌نمایی.",
      "usfm": "PSA.67.4"
    },
    {
      "verse": 5,
      "text": "تا ای خدا، تمام مردم تو را بپرستند",
      "usfm": "PSA.67.5"
    },
    {
      "verse": 5,
      "text": "و ستایش کنند.",
      "usfm": "PSA.67.5"
    },
    {
      "verse": 6,
      "text": "زمین محصول خود را به بار آورده است",
      "usfm": "PSA.67.6"
    },
    {
      "verse": 6,
      "text": "و خدا، خدای ما، ما را برکت داده است.",
      "usfm": "PSA.67.6"
    },
    {
      "verse": 7,
      "text": "خدا ما را برکت داده است،",
      "usfm": "PSA.67.7"
    },
    {
      "verse": 7,
      "text": "که همهٔ مردم، در همه‌جا او را احترام نمایند.",
      "usfm": "PSA.67.7"
    }
  ],
