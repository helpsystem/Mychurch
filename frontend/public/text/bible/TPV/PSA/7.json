{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 7,
  "verses": [
    {
      "verse": 1,
      "text": "ای خداوند، خدای من! به تو پناه می‌آورم.",
      "usfm": "PSA.7.1"
    },
    {
      "verse": 1,
      "text": "مرا از دست تعقیب‌کنندگانم برهان.",
      "usfm": "PSA.7.1"
    },
    {
      "verse": 2,
      "text": "وگرنه آنها مانند شیری مرا خواهند درید",
      "usfm": "PSA.7.2"
    },
    {
      "verse": 2,
      "text": "و تکه‌تکه خواهند کرد،",
      "usfm": "PSA.7.2"
    },
    {
      "verse": 2,
      "text": "و کسی به داد من نخواهد رسید.",
      "usfm": "PSA.7.2"
    },
    {
      "verse": 3,
      "text": "ای خداوند، خدای من! اگر گناهی از من سر زده،",
      "usfm": "PSA.7.3"
    },
    {
      "verse": 3,
      "text": "یا به کسی ظلمی کرده باشم،",
      "usfm": "PSA.7.3"
    },
    {
      "verse": 4,
      "text": "یا به دوستان خیانت،",
      "usfm": "PSA.7.4"
    },
    {
      "verse": 4,
      "text": "و یا بدون سبب مال دشمنانم را غارت کرده باشم،",
      "usfm": "PSA.7.4"
    },
    {
      "verse": 5,
      "text": "آنگاه بگذار دشمنانم مرا دستگیر کنند",
      "usfm": "PSA.7.5"
    },
    {
      "verse": 5,
      "text": "و بر زمین پایمالم کرده",
      "usfm": "PSA.7.5"
    },
    {
      "verse": 5,
      "text": "و با خاک یکسانم نمایند.",
      "usfm": "PSA.7.5"
    },
    {
      "verse": 6,
      "text": "ای خداوند، برخیز و با غضب خود",
      "usfm": "PSA.7.6"
    },
    {
      "verse": 6,
      "text": "در مقابل خشم دشمنانم بایست.",
      "usfm": "PSA.7.6"
    },
    {
      "verse": 6,
      "text": "ای خدا، بیدار شو",
      "usfm": "PSA.7.6"
    },
    {
      "verse": 6,
      "text": "و عدالت را اجرا نما.",
      "usfm": "PSA.7.6"
    },
    {
      "verse": 7,
      "text": "همهٔ مردم را به پیشگاهت جمع کن",
      "usfm": "PSA.7.7"
    },
    {
      "verse": 7,
      "text": "و از بارگاه ملکوتی‌ات بر آنها داوری فرما.",
      "usfm": "PSA.7.7"
    },
    {
      "verse": 8,
      "text": "تو ای خداوند داور همهٔ مردم هستی،",
      "usfm": "PSA.7.8"
    },
    {
      "verse": 8,
      "text": "مرا نیز ای خداوند، مطابق عدالت",
      "usfm": "PSA.7.8"
    },
    {
      "verse": 8,
      "text": "و راستی‌ای که در من است داوری نما.",
      "usfm": "PSA.7.8"
    },
    {
      "verse": 9,
      "text": "ای خدای عادل که از افکار و نیّت دلهای همهٔ مردم آگاهی،",
      "usfm": "PSA.7.9"
    },
    {
      "verse": 9,
      "text": "شرارت و بدی را از بین ببر",
      "usfm": "PSA.7.9"
    },
    {
      "verse": 9,
      "text": "و عدالت و راستی را به جای آن برقرار ساز.",
      "usfm": "PSA.7.9"
    },
    {
      "verse": 10,
      "text": "خدا نگهبان من است",
      "usfm": "PSA.7.10"
    },
    {
      "verse": 10,
      "text": "و راست‌دلان را نجات می‌دهد.",
      "usfm": "PSA.7.10"
    },
    {
      "verse": 11,
      "text": "خداوند داور عادل است",
      "usfm": "PSA.7.11"
    },
    {
      "verse": 11,
      "text": "و همیشه شریران را محکوم می‌کند.",
      "usfm": "PSA.7.11"
    },
    {
      "verse": 12,
      "text": "اگر کسی از گناه خود توبه نکند،",
      "usfm": "PSA.7.12"
    },
    {
      "verse": 12,
      "text": "خداوند برای هلاکت او شمشیر خود را تیز",
      "usfm": "PSA.7.12"
    },
    {
      "verse": 12,
      "text": "و کمان خود را آماده می‌نماید.",
      "usfm": "PSA.7.12"
    },
    {
      "verse": 13,
      "text": "سلاح کشندهٔ او آماده",
      "usfm": "PSA.7.13"
    },
    {
      "verse": 13,
      "text": "و تیرهای آتشین او در کمان است.",
      "usfm": "PSA.7.13"
    },
    {
      "verse": 14,
      "text": "نگاه کنید که اشخاص بدکار چگونه به شرارت فکر می‌کنند،",
      "usfm": "PSA.7.14"
    },
    {
      "verse": 14,
      "text": "آنها نقشهٔ شریرانه می‌کشند و با نیرنگ عمل می‌کنند.",
      "usfm": "PSA.7.14"
    },
    {
      "verse": 15,
      "text": "برای دیگران چاه می‌کنند،",
      "usfm": "PSA.7.15"
    },
    {
      "verse": 15,
      "text": "امّا خودشان در آن می‌افتند.",
      "usfm": "PSA.7.15"
    },
    {
      "verse": 16,
      "text": "پس به‌خاطر شرارتشان مجازات می‌شوند",
      "usfm": "PSA.7.16"
    },
    {
      "verse": 16,
      "text": "و ظلم آنها دامنگیر خودشان می‌گردد.",
      "usfm": "PSA.7.16"
    },
    {
      "verse": 17,
      "text": "خداوند را به‌خاطر عدالتش شکر می‌کنم؛",
      "usfm": "PSA.7.17"
    },
    {
      "verse": 17,
      "text": "و نام خداوند متعال را می‌سرایم.",
      "usfm": "PSA.7.17"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/7.mp3"
}