{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 120,
  "verses": [
    {
      "verse": 1,
      "text": "در هنگام سختی به حضور خداوند دعا کردم",
      "usfm": "PSA.120.1"
    },
    {
      "verse": 1,
      "text": "و او دعایم را مستجاب فرمود.",
      "usfm": "PSA.120.1"
    },
    {
      "verse": 2,
      "text": "خداوندا، مرا از شر مردم دروغگو",
      "usfm": "PSA.120.2"
    },
    {
      "verse": 2,
      "text": "و از زبان حیله‌گران نجات بده.",
      "usfm": "PSA.120.2"
    },
    {
      "verse": 3,
      "text": "ای حیله‌گران، خدا با شما چه خواهد کرد",
      "usfm": "PSA.120.3"
    },
    {
      "verse": 3,
      "text": "و شما را چگونه مجازات خواهد نمود؟",
      "usfm": "PSA.120.3"
    },
    {
      "verse": 4,
      "text": "با تیرهای جانسوز سربازان",
      "usfm": "PSA.120.4"
    },
    {
      "verse": 4,
      "text": "و اخگرهای آتشین!",
      "usfm": "PSA.120.4"
    },
    {
      "verse": 5,
      "text": "زندگی با شما، مانند زندگی در سرزمین ماشک",
      "usfm": "PSA.120.5"
    },
    {
      "verse": 5,
      "text": "و در بین مردم قیدار است!",
      "usfm": "PSA.120.5"
    },
    {
      "verse": 6,
      "text": "از زندگی با این مردم",
      "usfm": "PSA.120.6"
    },
    {
      "verse": 6,
      "text": "که دشمن صلح هستند، بیزار شده‌ام.",
      "usfm": "PSA.120.6"
    },
    {
      "verse": 7,
      "text": "وقتی دربارهٔ صلح حرف می‌زنم،",
      "usfm": "PSA.120.7"
    },
    {
      "verse": 7,
      "text": "آنها دربارهٔ جنگ صحبت می‌کنند.",
      "usfm": "PSA.120.7"
    }
  ],
