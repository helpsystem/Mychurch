{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 132,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، داوود و زحمتهایی را که متحمّل شد",
      "usfm": "PSA.132.1"
    },
    {
      "verse": 1,
      "text": "فراموش مکن.",
      "usfm": "PSA.132.1"
    },
    {
      "verse": 2,
      "text": "به یادآور که قسم خورد",
      "usfm": "PSA.132.2"
    },
    {
      "verse": 2,
      "text": "و برای تو ای خدای یعقوب نذر کرد:",
      "usfm": "PSA.132.2"
    },
    {
      "verse": 5,
      "text": "«من تا خانه‌ای برای خداوند بنا نکنم،",
      "usfm": "PSA.132.3+PSA.132.4+PSA.132.5"
    },
    {
      "verse": 5,
      "text": "به خانهٔ خود نخواهم رفت",
      "usfm": "PSA.132.3+PSA.132.4+PSA.132.5"
    },
    {
      "verse": 5,
      "text": "و استراحت نخواهم كرد",
      "usfm": "PSA.132.3+PSA.132.4+PSA.132.5"
    },
    {
      "verse": 5,
      "text": "و نخواهم خوابید.»",
      "usfm": "PSA.132.3+PSA.132.4+PSA.132.5"
    },
    {
      "verse": 6,
      "text": "در بیت‌لحم، از وجود صندوق پیمان باخبر شدیم",
      "usfm": "PSA.132.6"
    },
    {
      "verse": 6,
      "text": "و در شهر یعاریم آن را یافتیم.",
      "usfm": "PSA.132.6"
    },
    {
      "verse": 7,
      "text": "بیایید به خانهٔ خداوند برویم",
      "usfm": "PSA.132.7"
    },
    {
      "verse": 7,
      "text": "و در برابر تختش او را پرستش کنیم.",
      "usfm": "PSA.132.7"
    },
    {
      "verse": 8,
      "text": "خداوندا، با صندوق پیمان که نشانهٔ قدرت توست",
      "usfm": "PSA.132.8"
    },
    {
      "verse": 8,
      "text": "به معبد بزرگ خود بیا",
      "usfm": "PSA.132.8"
    },
    {
      "verse": 8,
      "text": "و برای همیشه در آنجا ساکن شو.",
      "usfm": "PSA.132.8"
    },
    {
      "verse": 9,
      "text": "کاهنانت لباس عدالت بپوشند",
      "usfm": "PSA.132.9"
    },
    {
      "verse": 9,
      "text": "و مؤمنین تو با شادی برایت سرود بخوانند!",
      "usfm": "PSA.132.9"
    },
    {
      "verse": 10,
      "text": "به‌خاطر بنده‌ات داوود،",
      "usfm": "PSA.132.10"
    },
    {
      "verse": 10,
      "text": "روی خود را از پادشاه برگزیده‌ات بر مگردان.",
      "usfm": "PSA.132.10"
    },
    {
      "verse": 11,
      "text": "تو به داوود وعده دادی",
      "usfm": "PSA.132.11"
    },
    {
      "verse": 11,
      "text": "و از وعدهٔ خود بر نمی‌گردی:",
      "usfm": "PSA.132.11"
    },
    {
      "verse": 11,
      "text": "«یکی از فرزندان او را پادشاه می‌سازم.",
      "usfm": "PSA.132.11"
    },
    {
      "verse": 11,
      "text": "و او بعد از تو سلطنت خواهد کرد",
      "usfm": "PSA.132.11"
    },
    {
      "verse": 12,
      "text": "اگر فرزندان تو نیز به پیمان",
      "usfm": "PSA.132.12"
    },
    {
      "verse": 12,
      "text": "و احکام من وفادار بمانند،",
      "usfm": "PSA.132.12"
    },
    {
      "verse": 12,
      "text": "فرزندان آنها نیز تا به ابد بر تخت سلطنت تو خواهند نشست.»",
      "usfm": "PSA.132.12"
    },
    {
      "verse": 13,
      "text": "خداوند صهیون را",
      "usfm": "PSA.132.13"
    },
    {
      "verse": 13,
      "text": "برای سکونت خود برگزید",
      "usfm": "PSA.132.13"
    },
    {
      "verse": 14,
      "text": "و فرمود: «در اینجا برای همیشه سکونت خواهم کرد",
      "usfm": "PSA.132.14"
    },
    {
      "verse": 14,
      "text": "زیرا چنین اراده نموده‌ام.",
      "usfm": "PSA.132.14"
    },
    {
      "verse": 15,
      "text": "تمام احتیاجات صهیون را به فراوانی برآورده خواهم ساخت",
      "usfm": "PSA.132.15"
    },
    {
      "verse": 15,
      "text": "و بینوایان آن را با غذا سیر خواهم كرد.",
      "usfm": "PSA.132.15"
    },
    {
      "verse": 16,
      "text": "کاهنانش را لباس رستگاری خواهم پوشانید",
      "usfm": "PSA.132.16"
    },
    {
      "verse": 16,
      "text": "و مؤمنیش با شادی سرود خواهند خواند.",
      "usfm": "PSA.132.16"
    },
    {
      "verse": 17,
      "text": "در اینجا، داوود را به قدرت خواهم رسانید",
      "usfm": "PSA.132.17"
    },
    {
      "verse": 17,
      "text": "و چراغی برای برگزیدهٔ خود روشن خواهم کرد.",
      "usfm": "PSA.132.17"
    },
    {
      "verse": 18,
      "text": "دشمنانش را با لباس خجالت خواهم پوشانید،",
      "usfm": "PSA.132.18"
    },
    {
      "verse": 18,
      "text": "امّا سلطنت او کامیاب و شکوفا خواهد شد.»",
      "usfm": "PSA.132.18"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/132.mp3"
}