{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 51,
  "verses": [
    {
      "verse": 1,
      "text": "خدایا به‌خاطر محبّت پایدار خود",
      "usfm": "PSA.51.1"
    },
    {
      "verse": 1,
      "text": "بر من رحم کن،",
      "usfm": "PSA.51.1"
    },
    {
      "verse": 1,
      "text": "و از روی کرم بی‌پایانت",
      "usfm": "PSA.51.1"
    },
    {
      "verse": 1,
      "text": "گناهان مرا ببخش.",
      "usfm": "PSA.51.1"
    },
    {
      "verse": 2,
      "text": "مرا از گناهانم شست‌وشو ده",
      "usfm": "PSA.51.2"
    },
    {
      "verse": 2,
      "text": "و از خطاهایم پاک ساز.",
      "usfm": "PSA.51.2"
    },
    {
      "verse": 3,
      "text": "من به گناهان خود اعتراف می‌کنم",
      "usfm": "PSA.51.3"
    },
    {
      "verse": 3,
      "text": "و خطاهایی را که کرده‌‌ام در نظر دارم.",
      "usfm": "PSA.51.3"
    },
    {
      "verse": 4,
      "text": "من علیه تو ای خداوند،",
      "usfm": "PSA.51.4"
    },
    {
      "verse": 4,
      "text": "بلی تنها علیه تو گناه کرده‌‌ام،",
      "usfm": "PSA.51.4"
    },
    {
      "verse": 4,
      "text": "و آنچه را که در نظر تو بد است، انجام داده‌ام.",
      "usfm": "PSA.51.4"
    },
    {
      "verse": 4,
      "text": "اینک تو حق داری که مرا داوری نموده، محکوم سازی.",
      "usfm": "PSA.51.4"
    },
    {
      "verse": 5,
      "text": "من از روزی که به دنیا آمدم گناهکار بودم،",
      "usfm": "PSA.51.5"
    },
    {
      "verse": 5,
      "text": "از همان لحظه‌ای که نطفه‌ام در رحم مادرم بسته شد، به گناه آلوده بودم.",
      "usfm": "PSA.51.5"
    },
    {
      "verse": 6,
      "text": "تو طرفدار صداقت و راستی هستی،",
      "usfm": "PSA.51.6"
    },
    {
      "verse": 6,
      "text": "پس فکر مرا از حکمت پُر ساز.",
      "usfm": "PSA.51.6"
    },
    {
      "verse": 7,
      "text": "گناه مرا از من دور کن تا پاک شوم.",
      "usfm": "PSA.51.7"
    },
    {
      "verse": 7,
      "text": "مرا بشوی تا از برف سفیدتر گردم.",
      "usfm": "PSA.51.7"
    },
    {
      "verse": 8,
      "text": "بگذار تا صدای خوشی و لذّت را بشنوم؛",
      "usfm": "PSA.51.8"
    },
    {
      "verse": 8,
      "text": "با وجودی که مرا کوبیده‌ و خُرد کرده‌ای،",
      "usfm": "PSA.51.8"
    },
    {
      "verse": 8,
      "text": "بار دیگر شاد خواهم بود.",
      "usfm": "PSA.51.8"
    },
    {
      "verse": 9,
      "text": "از گناهانم چشم بپوش",
      "usfm": "PSA.51.9"
    },
    {
      "verse": 9,
      "text": "و خطاهایم را ببخش.",
      "usfm": "PSA.51.9"
    },
    {
      "verse": 10,
      "text": "خدایا، دل پاک در من بیافرین",
      "usfm": "PSA.51.10"
    },
    {
      "verse": 10,
      "text": "و باطنم را با روح راستی تازه گردان.",
      "usfm": "PSA.51.10"
    },
    {
      "verse": 11,
      "text": "مرا از حضور خود مران",
      "usfm": "PSA.51.11"
    },
    {
      "verse": 11,
      "text": "و روح پاکت را از من مگیر.",
      "usfm": "PSA.51.11"
    },
    {
      "verse": 12,
      "text": "شادی نجات را به من بازگردان",
      "usfm": "PSA.51.12"
    },
    {
      "verse": 12,
      "text": "و شوق اطاعت از اوامرت را در من ایجاد نما.",
      "usfm": "PSA.51.12"
    },
    {
      "verse": 13,
      "text": "آنگاه احکام تو را به خطاکاران خواهم آموخت",
      "usfm": "PSA.51.13"
    },
    {
      "verse": 13,
      "text": "و آنان به سوی تو باز خواهند گشت.",
      "usfm": "PSA.51.13"
    },
    {
      "verse": 14,
      "text": "ای خدایی که نجات‌دهندهٔ من هستی، مرا از خونریزی دور کن،",
      "usfm": "PSA.51.14"
    },
    {
      "verse": 14,
      "text": "تا زبانم بار دیگر سرود عدالت تو را بسراید.",
      "usfm": "PSA.51.14"
    },
    {
      "verse": 15,
      "text": "خداوندا، به من قدرت بیان عطا فرما",
      "usfm": "PSA.51.15"
    },
    {
      "verse": 15,
      "text": "تا تو را ستایش کنم.",
      "usfm": "PSA.51.15"
    },
    {
      "verse": 16,
      "text": "تو قربانی نخواستی،",
      "usfm": "PSA.51.16"
    },
    {
      "verse": 16,
      "text": "وگرنه تقدیم می‌کردم.",
      "usfm": "PSA.51.16"
    },
    {
      "verse": 16,
      "text": "قربانی‌های سوختنی را نمی‌پسندی،",
      "usfm": "PSA.51.16"
    },
    {
      "verse": 17,
      "text": "خدایا، قربانی من، دل شکستهٔ من است،",
      "usfm": "PSA.51.17"
    },
    {
      "verse": 17,
      "text": "تو دل شکسته و روح توبه‌کار را خوار نخواهی شمرد.",
      "usfm": "PSA.51.17"
    },
    {
      "verse": 18,
      "text": "خداوندا، بر صهیون لطف کن",
      "usfm": "PSA.51.18"
    },
    {
      "verse": 18,
      "text": "و دیوارهای اورشلیم را دوباره بنا نما.",
      "usfm": "PSA.51.18"
    },
    {
      "verse": 19,
      "text": "آنگاه از قربانی‌های کامل و مناسب خشنود خواهی شد",
      "usfm": "PSA.51.19"
    },
    {
      "verse": 19,
      "text": "و قربانی‌های سوختنی",
      "usfm": "PSA.51.19"
    },
    {
      "verse": 19,
      "text": "و گاوها بر قربانگاه، قربانی خواهند شد.",
      "usfm": "PSA.51.19"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/51.mp3"
}