{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 11,
  "verses": [
    {
      "verse": 1,
      "text": "من به خداوند توکّل دارم.",
      "usfm": "PSA.11.1"
    },
    {
      "verse": 1,
      "text": "چرا به من می‌گویید:",
      "usfm": "PSA.11.1"
    },
    {
      "verse": 1,
      "text": "«مانند پرنده به کوهها فرار کن.",
      "usfm": "PSA.11.1"
    },
    {
      "verse": 2,
      "text": "زیرا شریران کمان به دست گرفته",
      "usfm": "PSA.11.2"
    },
    {
      "verse": 2,
      "text": "و تیر را به زه نهاده‌اند",
      "usfm": "PSA.11.2"
    },
    {
      "verse": 2,
      "text": "تا آن را در تاریکی به سوی نیکان پرتاب کنند.",
      "usfm": "PSA.11.2"
    },
    {
      "verse": 3,
      "text": "در زمانی که نیکی از بین رفته است،",
      "usfm": "PSA.11.3"
    },
    {
      "verse": 3,
      "text": "نیکان چه می‌توانند بکنند؟»",
      "usfm": "PSA.11.3"
    },
    {
      "verse": 4,
      "text": "خداوند در معبد مقدّس خویش است.",
      "usfm": "PSA.11.4"
    },
    {
      "verse": 4,
      "text": "تخت خدا در آسمان استوار است.",
      "usfm": "PSA.11.4"
    },
    {
      "verse": 4,
      "text": "او همه‌جا مراقب مردم است",
      "usfm": "PSA.11.4"
    },
    {
      "verse": 4,
      "text": "و هرچه می‌کنند، می‌داند.",
      "usfm": "PSA.11.4"
    },
    {
      "verse": 5,
      "text": "خداوند مردم نیک و بد را یکسان مورد آزمایش قرار می‌دهد.",
      "usfm": "PSA.11.5"
    },
    {
      "verse": 5,
      "text": "او با تمام وجود از بدکاران بیزار است.",
      "usfm": "PSA.11.5"
    },
    {
      "verse": 6,
      "text": "بر شریران، باران آتش و گوگرد می‌فرستد",
      "usfm": "PSA.11.6"
    },
    {
      "verse": 6,
      "text": "و نصیب آنان، بادهای سوزاننده است.",
      "usfm": "PSA.11.6"
    },
    {
      "verse": 7,
      "text": "خداوند عادل است و نیکوکاران را دوست می‌دارد",
      "usfm": "PSA.11.7"
    },
    {
      "verse": 7,
      "text": "و درستکاران در پیشگاه او خواهند زیست.",
      "usfm": "PSA.11.7"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/11.mp3"
}