  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، از کبر و غرور دست کشیده‏ام",
      "usfm": "PSA.131.1"
    },
    {
      "verse": 1,
      "text": "و خود را بهتر از دیگران نمی‌دانم.",
      "usfm": "PSA.131.1"
    },
    {
      "verse": 1,
      "text": "خود را از آن چه بالاتر از فهم و درک من است",
      "usfm": "PSA.131.1"
    },
    {
      "verse": 1,
      "text": "دور می‌کنم.",
      "usfm": "PSA.131.1"
    },
    {
      "verse": 2,
      "text": "نگرانی را از خود دور کرده‌ام",
      "usfm": "PSA.131.2"
    },
    {
      "verse": 2,
      "text": "و مانند کودکی که در آغوش مادر خود آرام است،",
      "usfm": "PSA.131.2"
    },
    {
      "verse": 2,
      "text": "در درون خود آرامش دارم.",
      "usfm": "PSA.131.2"
    },
    {
      "verse": 3,
      "text": "ای اسرائیل، بر خداوند توکّل داشته باش،",
      "usfm": "PSA.131.3"
    },
    {
      "verse": 3,
      "text": "از حال تا به ابد!",
      "usfm": "PSA.131.3"
    }
  ],
