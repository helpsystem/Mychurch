{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 55,
  "verses": [
    {
      "verse": 1,
      "text": "خدایا به دعای من گوش بده",
      "usfm": "PSA.55.1"
    },
    {
      "verse": 1,
      "text": "و وقتی‌که زاری می‌کنم خود را از من پنهان مکن.",
      "usfm": "PSA.55.1"
    },
    {
      "verse": 2,
      "text": "دعای مرا بشنو و مستجاب فرما.",
      "usfm": "PSA.55.2"
    },
    {
      "verse": 2,
      "text": "از شدّت نگرانی، فکرم پریشان است.",
      "usfm": "PSA.55.2"
    },
    {
      "verse": 3,
      "text": "از تهدید دشمنان هراسانم",
      "usfm": "PSA.55.3"
    },
    {
      "verse": 3,
      "text": "و ظلم مردم ظالم مرا آشفته کرده است.",
      "usfm": "PSA.55.3"
    },
    {
      "verse": 3,
      "text": "آنها مرا عذاب می‌دهند",
      "usfm": "PSA.55.3"
    },
    {
      "verse": 3,
      "text": "و از من نفرت دارند.",
      "usfm": "PSA.55.3"
    },
    {
      "verse": 4,
      "text": "دلم افسرده و غمگین است.",
      "usfm": "PSA.55.4"
    },
    {
      "verse": 4,
      "text": "وحشت مرگ مرا فراگرفته است.",
      "usfm": "PSA.55.4"
    },
    {
      "verse": 5,
      "text": "ترس و وحشت مرا احاطه کرده",
      "usfm": "PSA.55.5"
    },
    {
      "verse": 5,
      "text": "و از پا انداخته است.",
      "usfm": "PSA.55.5"
    },
    {
      "verse": 6,
      "text": "می‌گویم: «ای کاش مانند کبوتر بال می‌داشتم، پر می‌زدم",
      "usfm": "PSA.55.6"
    },
    {
      "verse": 6,
      "text": "و به جای آرامی می‌رفتم.",
      "usfm": "PSA.55.6"
    },
    {
      "verse": 7,
      "text": "ای کاش به دوردستها پرواز می‌کردم،",
      "usfm": "PSA.55.7"
    },
    {
      "verse": 7,
      "text": "و خانهٔ خود را در بیابان می‌ساختم،",
      "usfm": "PSA.55.7"
    },
    {
      "verse": 8,
      "text": "پناهگاهی می‌جُستم",
      "usfm": "PSA.55.8"
    },
    {
      "verse": 8,
      "text": "و از توفان بلا در امان می‌ماندم.»",
      "usfm": "PSA.55.8"
    },
    {
      "verse": 9,
      "text": "خداوندا، زبان شریران را مغشوش گردان،",
      "usfm": "PSA.55.9"
    },
    {
      "verse": 9,
      "text": "زیرا آنها شهر را به آشوب کشیده‌اند.",
      "usfm": "PSA.55.9"
    },
    {
      "verse": 10,
      "text": "شب و روز دیوارهای شهر را دور می‌زنند",
      "usfm": "PSA.55.10"
    },
    {
      "verse": 10,
      "text": "و جنایت و فساد می‌آفرینند.",
      "usfm": "PSA.55.10"
    },
    {
      "verse": 11,
      "text": "فساد و شرارت همه‌جا را فراگرفته",
      "usfm": "PSA.55.11"
    },
    {
      "verse": 11,
      "text": "و خیابانهای شهر پُر از فریب و نیرنگ است.",
      "usfm": "PSA.55.11"
    },
    {
      "verse": 12,
      "text": "اگر دشمن به من توهین می‌کرد،",
      "usfm": "PSA.55.12"
    },
    {
      "verse": 12,
      "text": "آن را تحمّل می‌کردم",
      "usfm": "PSA.55.12"
    },
    {
      "verse": 12,
      "text": "و یا اگر رقیب من به ضد من برخاسته بود،",
      "usfm": "PSA.55.12"
    },
    {
      "verse": 12,
      "text": "خود را پنهان می‌نمودم.",
      "usfm": "PSA.55.12"
    },
    {
      "verse": 13,
      "text": "امّا این تو هستی، شریک",
      "usfm": "PSA.55.13"
    },
    {
      "verse": 13,
      "text": "و همکار و دوست نزدیک من.",
      "usfm": "PSA.55.13"
    },
    {
      "verse": 14,
      "text": "ما با هم گفت‌وگوهای شیرین داشتیم",
      "usfm": "PSA.55.14"
    },
    {
      "verse": 14,
      "text": "و با یکدیگر برای عبادت به معبد بزرگ می‌رفتیم.",
      "usfm": "PSA.55.14"
    },
    {
      "verse": 15,
      "text": "مرگ ناگهانی نصیبشان شود،",
      "usfm": "PSA.55.15"
    },
    {
      "verse": 15,
      "text": "زنده به گور شوند،",
      "usfm": "PSA.55.15"
    },
    {
      "verse": 15,
      "text": "زیرا دلها و خانه‌های آنان پُر از شرارت و جنایت است.",
      "usfm": "PSA.55.15"
    },
    {
      "verse": 16,
      "text": "امّا من از خداوند، خدای خود یاری می‌‌‌‌خواهم",
      "usfm": "PSA.55.16"
    },
    {
      "verse": 16,
      "text": "و او مرا رهایی خواهد داد.",
      "usfm": "PSA.55.16"
    },
    {
      "verse": 17,
      "text": "صبح و ظهر و شب",
      "usfm": "PSA.55.17"
    },
    {
      "verse": 17,
      "text": "به درگاه خدا ناله می‌کنم",
      "usfm": "PSA.55.17"
    },
    {
      "verse": 17,
      "text": "و او دعای مرا مستجاب خواهد کرد.",
      "usfm": "PSA.55.17"
    },
    {
      "verse": 18,
      "text": "وقتی با دشمنان بسیار",
      "usfm": "PSA.55.18"
    },
    {
      "verse": 18,
      "text": "در میدان جنگ نبرد می‌کنم،",
      "usfm": "PSA.55.18"
    },
    {
      "verse": 18,
      "text": "او مرا با پیروزی بسلامت بازمی‌گرداند.",
      "usfm": "PSA.55.18"
    },
    {
      "verse": 19,
      "text": "خدا که پادشاه ازلی است، مرا خواهد شنید",
      "usfm": "PSA.55.19"
    },
    {
      "verse": 19,
      "text": "و آنها را سرکوب خواهد كرد،",
      "usfm": "PSA.55.19"
    },
    {
      "verse": 19,
      "text": "زیرا آنها از او نمی‌ترسند",
      "usfm": "PSA.55.19"
    },
    {
      "verse": 19,
      "text": "و راه خود را تغییر نمی‌دهند.",
      "usfm": "PSA.55.19"
    },
    {
      "verse": 20,
      "text": "دوست سابق من، دست خود را علیه دوستانش بلند کرده",
      "usfm": "PSA.55.20"
    },
    {
      "verse": 20,
      "text": "و پیمان خود را شکسته است.",
      "usfm": "PSA.55.20"
    },
    {
      "verse": 21,
      "text": "سخنان چرب و نرم می‌زند، امّا در باطن از من نفرت دارد.",
      "usfm": "PSA.55.21"
    },
    {
      "verse": 21,
      "text": "حرفهایش در ظاهر بسیار شیرین، امّا مانند شمشیر تیز و کُشنده است.",
      "usfm": "PSA.55.21"
    },
    {
      "verse": 22,
      "text": "مشکلات خود را به خداوند بسپار",
      "usfm": "PSA.55.22"
    },
    {
      "verse": 22,
      "text": "و او آنها را برایت حل خواهد کرد،",
      "usfm": "PSA.55.22"
    },
    {
      "verse": 22,
      "text": "او هرگز نمی‌گذارد که اشخاص وفادار شکست بخورند.",
      "usfm": "PSA.55.22"
    },
    {
      "verse": 23,
      "text": "امّا تو ای خدا، این آدمهای قاتل و حیله‌گر را پیش از وقت به گور خواهی فرستاد،",
      "usfm": "PSA.55.23"
    },
    {
      "verse": 23,
      "text": "قبل از اینکه نیمی از عمرشان را سپری کنند.",
      "usfm": "PSA.55.23"
    },
    {
      "verse": 23,
      "text": "امّا من بر تو توکّل می‌کنم.",
      "usfm": "PSA.55.23"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/55.mp3"
}