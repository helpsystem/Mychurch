{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 28,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، ای نگهدارندهٔ من،",
      "usfm": "PSA.28.1"
    },
    {
      "verse": 1,
      "text": "به درگاهت زاری می‌کنم دعایم را بشنو،",
      "usfm": "PSA.28.1"
    },
    {
      "verse": 1,
      "text": "زیرا اگر به من جواب ندهی،",
      "usfm": "PSA.28.1"
    },
    {
      "verse": 1,
      "text": "مانند مردگان خواهم بود.",
      "usfm": "PSA.28.1"
    },
    {
      "verse": 2,
      "text": "وقتی دستهای خود را به سوی معبد مقدّس تو بلند می‌کنم",
      "usfm": "PSA.28.2"
    },
    {
      "verse": 2,
      "text": "و با التماس درخواست کمک می‌کنم، دعای مرا مستجاب فرما.",
      "usfm": "PSA.28.2"
    },
    {
      "verse": 3,
      "text": "مرا جزو شریران و بدکاران حساب مکن،",
      "usfm": "PSA.28.3"
    },
    {
      "verse": 3,
      "text": "آنانی که با همسایگان خود دوستانه حرف می‌زنند،",
      "usfm": "PSA.28.3"
    },
    {
      "verse": 3,
      "text": "امّا در دلشان قصد آزار آنها را دارند.",
      "usfm": "PSA.28.3"
    },
    {
      "verse": 4,
      "text": "مطابق کارها و شرارتهایشان،",
      "usfm": "PSA.28.4"
    },
    {
      "verse": 4,
      "text": "آنها را مجازات کن",
      "usfm": "PSA.28.4"
    },
    {
      "verse": 4,
      "text": "برای کارهای زشتی که انجام داده‌اند،",
      "usfm": "PSA.28.4"
    },
    {
      "verse": 4,
      "text": "به آنها مطابق كارهایشان جزا بده.",
      "usfm": "PSA.28.4"
    },
    {
      "verse": 5,
      "text": "آنها به کارهای خداوند",
      "usfm": "PSA.28.5"
    },
    {
      "verse": 5,
      "text": "و آنچه که او آفریده است توجّه نمی‌کنند،",
      "usfm": "PSA.28.5"
    },
    {
      "verse": 5,
      "text": "بنابراین او آنها را مجازات نموده",
      "usfm": "PSA.28.5"
    },
    {
      "verse": 5,
      "text": "و برای همیشه نابود خواهد کرد.",
      "usfm": "PSA.28.5"
    },
    {
      "verse": 6,
      "text": "خداوند را سپاس می‌گویم،",
      "usfm": "PSA.28.6"
    },
    {
      "verse": 6,
      "text": "او درخواست کمک مرا شنیده است.",
      "usfm": "PSA.28.6"
    },
    {
      "verse": 7,
      "text": "خداوند قوّت و سپر من است.",
      "usfm": "PSA.28.7"
    },
    {
      "verse": 7,
      "text": "من بر او توکّل می‌کنم.",
      "usfm": "PSA.28.7"
    },
    {
      "verse": 7,
      "text": "او مرا یاری می‌کند و خوشحال می‌سازد،",
      "usfm": "PSA.28.7"
    },
    {
      "verse": 7,
      "text": "او را با سرودهای شادی سپاس می‌خوانم.",
      "usfm": "PSA.28.7"
    },
    {
      "verse": 8,
      "text": "خداوند قوم خود را حمایت می‌کند،",
      "usfm": "PSA.28.8"
    },
    {
      "verse": 8,
      "text": "و از برگزیدهٔ خود پشتیبانی می‌نماید.",
      "usfm": "PSA.28.8"
    },
    {
      "verse": 9,
      "text": "خداوندا، قوم خود را نجات بده",
      "usfm": "PSA.28.9"
    },
    {
      "verse": 9,
      "text": "و آنانی را که از آن تو هستند برکت بده،",
      "usfm": "PSA.28.9"
    },
    {
      "verse": 9,
      "text": "شبان آنان باش،",
      "usfm": "PSA.28.9"
    },
    {
      "verse": 9,
      "text": "و از آنها همیشه نگهداری فرما.",
      "usfm": "PSA.28.9"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/28.mp3"
}