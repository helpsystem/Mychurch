{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 1,
  "verses": [
    {
      "verse": 1,
      "text": "‌خوشا به حال کسی‌که",
      "usfm": "PSA.1.1"
    },
    {
      "verse": 1,
      "text": "با شریران مشورت نمی‌کند",
      "usfm": "PSA.1.1"
    },
    {
      "verse": 1,
      "text": "و به راه گناهکاران نمی‌رود",
      "usfm": "PSA.1.1"
    },
    {
      "verse": 1,
      "text": "و با مسخره‌کنندگان همنشین نمی‌شود،",
      "usfm": "PSA.1.1"
    },
    {
      "verse": 2,
      "text": "بلکه خوشی او اطاعت از شریعت خداوند است",
      "usfm": "PSA.1.2"
    },
    {
      "verse": 2,
      "text": "و شب و روز به دستورات او می‌اندیشد.",
      "usfm": "PSA.1.2"
    },
    {
      "verse": 3,
      "text": "او مانند درختی است که در کنار نهر آب کاشته شده باشد،",
      "usfm": "PSA.1.3"
    },
    {
      "verse": 3,
      "text": "میوهٔ خود را در موسمش می‌دهد",
      "usfm": "PSA.1.3"
    },
    {
      "verse": 3,
      "text": "و برگهایش پژمرده نمی‌گردد",
      "usfm": "PSA.1.3"
    },
    {
      "verse": 3,
      "text": "و در همهٔ کارهای خود موفّق است.",
      "usfm": "PSA.1.3"
    },
    {
      "verse": 4,
      "text": "امّا شریران چنین نیستند.",
      "usfm": "PSA.1.4"
    },
    {
      "verse": 4,
      "text": "بلکه آنان مانند کاهی هستند که باد آنها را پراکنده می‌سازد.",
      "usfm": "PSA.1.4"
    },
    {
      "verse": 5,
      "text": "بنابراین شریران در روز داوری محکوم خواهند گردید",
      "usfm": "PSA.1.5"
    },
    {
      "verse": 5,
      "text": "و در جمع ایمانداران نخواهند ایستاد.",
      "usfm": "PSA.1.5"
    },
    {
      "verse": 6,
      "text": "خداوند راهنما و حافظ نیكوکاران است",
      "usfm": "PSA.1.6"
    },
    {
      "verse": 6,
      "text": "امّا عاقبت بدکاران هلاکت و نابودی است.",
      "usfm": "PSA.1.6"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/1.mp3"
}