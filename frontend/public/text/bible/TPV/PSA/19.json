{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 19,
  "verses": [
    {
      "verse": 1,
      "text": "آسمانها جلال خدا را بیان می‌کنند",
      "usfm": "PSA.19.1"
    },
    {
      "verse": 1,
      "text": "و فلک، صنعت دست او را نشان می‌دهد.",
      "usfm": "PSA.19.1"
    },
    {
      "verse": 2,
      "text": "روزها معرفت خدا را اعلام می‌کنند",
      "usfm": "PSA.19.2"
    },
    {
      "verse": 2,
      "text": "و شبها حکمت او را.",
      "usfm": "PSA.19.2"
    },
    {
      "verse": 3,
      "text": "نه سخنی شنیده می‌شود و نه کلامی.",
      "usfm": "PSA.19.3"
    },
    {
      "verse": 4,
      "text": "با وجود این، پیامشان به سراسر زمین می‌رسد",
      "usfm": "PSA.19.4"
    },
    {
      "verse": 4,
      "text": "و ندای ایشان به سرتاسر جهان.",
      "usfm": "PSA.19.4"
    },
    {
      "verse": 4,
      "text": "مکانی برای آفتاب در آسمان بنا نموده است،",
      "usfm": "PSA.19.4"
    },
    {
      "verse": 5,
      "text": "و آن مانند دامادی از حجلهٔ خود بیرون می‌آید،",
      "usfm": "PSA.19.5"
    },
    {
      "verse": 5,
      "text": "و چون قهرمانی که با شادی برای دویدن به میدان می‌رود.",
      "usfm": "PSA.19.5"
    },
    {
      "verse": 6,
      "text": "از یک طرف آسمان شروع می‌کند",
      "usfm": "PSA.19.6"
    },
    {
      "verse": 6,
      "text": "و به سوی دیگر آن می‌شتابد",
      "usfm": "PSA.19.6"
    },
    {
      "verse": 6,
      "text": "و هیچ چیز از حرارتش در امان نیست.",
      "usfm": "PSA.19.6"
    },
    {
      "verse": 7,
      "text": "شریعت خداوند کامل است",
      "usfm": "PSA.19.7"
    },
    {
      "verse": 7,
      "text": "و جان را تازه می‌کند.",
      "usfm": "PSA.19.7"
    },
    {
      "verse": 7,
      "text": "اوامر خداوند قابل اطمینان است",
      "usfm": "PSA.19.7"
    },
    {
      "verse": 7,
      "text": "و ساده دلان را حکمت می‌بخشد.",
      "usfm": "PSA.19.7"
    },
    {
      "verse": 8,
      "text": "دستورات خداوند درست است",
      "usfm": "PSA.19.8"
    },
    {
      "verse": 8,
      "text": "و دل را شاد می‌‌کند.",
      "usfm": "PSA.19.8"
    },
    {
      "verse": 8,
      "text": "اوامر خداوند پاک است",
      "usfm": "PSA.19.8"
    },
    {
      "verse": 8,
      "text": "و به انسان آگاهی می‌بخشد.",
      "usfm": "PSA.19.8"
    },
    {
      "verse": 9,
      "text": "احترام به خداوند نیکو و ابدی است.",
      "usfm": "PSA.19.9"
    },
    {
      "verse": 9,
      "text": "احکام خداوند حق و کاملاً عادلانه است.",
      "usfm": "PSA.19.9"
    },
    {
      "verse": 10,
      "text": "مرغوبتر از طلای ناب،",
      "usfm": "PSA.19.10"
    },
    {
      "verse": 10,
      "text": "و شیرین‌تر از عسل خالص است.",
      "usfm": "PSA.19.10"
    },
    {
      "verse": 11,
      "text": "آنها بندهٔ تو را هشیار می‌سازد",
      "usfm": "PSA.19.11"
    },
    {
      "verse": 11,
      "text": "و پیروی از آنها پاداش بسیار دارد.",
      "usfm": "PSA.19.11"
    },
    {
      "verse": 12,
      "text": "کیست که از اشتباهات پنهانی خود آگاه باشد؟",
      "usfm": "PSA.19.12"
    },
    {
      "verse": 12,
      "text": "خداوندا، گناهان پنهانی مرا بیامرز.",
      "usfm": "PSA.19.12"
    },
    {
      "verse": 13,
      "text": "همچنین مرا از گناهان عمدی بازدار.",
      "usfm": "PSA.19.13"
    },
    {
      "verse": 13,
      "text": "مگذار که این گناهان بر من چیره شوند،",
      "usfm": "PSA.19.13"
    },
    {
      "verse": 13,
      "text": "آنگاه بی‌عیب و بی‌گناه خواهم بود.",
      "usfm": "PSA.19.13"
    },
    {
      "verse": 14,
      "text": "ای خداوند، ای پناهگاه و ای نجات‌دهندهٔ من،",
      "usfm": "PSA.19.14"
    },
    {
      "verse": 14,
      "text": "سخنان زبانم و دعاهایم مقبول درگاه تو باشد.",
      "usfm": "PSA.19.14"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/19.mp3"
}