{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 135,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.135.1"
    },
    {
      "verse": 1,
      "text": "ای بندگان خداوند، او را پرستش کنید، نام او را ستایش کنید.",
      "usfm": "PSA.135.1"
    },
    {
      "verse": 2,
      "text": "ای کسانی‌که در خانهٔ خداوند،",
      "usfm": "PSA.135.2"
    },
    {
      "verse": 2,
      "text": "در معبد بزرگ خدای ما ایستاده‌اید،",
      "usfm": "PSA.135.2"
    },
    {
      "verse": 3,
      "text": "خداوند را شکر کنید، زیرا که نیکوست.",
      "usfm": "PSA.135.3"
    },
    {
      "verse": 3,
      "text": "برای او سرود بخوانید، زیرا که او مهربان است.",
      "usfm": "PSA.135.3"
    },
    {
      "verse": 4,
      "text": "او یعقوب را انتخاب نمود",
      "usfm": "PSA.135.4"
    },
    {
      "verse": 4,
      "text": "و بنی‌اسرائیل را برای خود برگزید.",
      "usfm": "PSA.135.4"
    },
    {
      "verse": 5,
      "text": "می‌دانم که خداوند بزرگ",
      "usfm": "PSA.135.5"
    },
    {
      "verse": 5,
      "text": "و برتر از همهٔ خدایان است.",
      "usfm": "PSA.135.5"
    },
    {
      "verse": 6,
      "text": "هرچه که اراده‏اش باشد، انجام می‌دهد،",
      "usfm": "PSA.135.6"
    },
    {
      "verse": 6,
      "text": "چه در آسمان و چه بر زمین،",
      "usfm": "PSA.135.6"
    },
    {
      "verse": 6,
      "text": "چه در دریا و چه در اعماق آن.",
      "usfm": "PSA.135.6"
    },
    {
      "verse": 7,
      "text": "ابرها را از دورترین نقاط زمین می‌آورد،",
      "usfm": "PSA.135.7"
    },
    {
      "verse": 7,
      "text": "رعد و برق و باران را پدید می‌آورد.",
      "usfm": "PSA.135.7"
    },
    {
      "verse": 7,
      "text": "و توفان را می‌آورد.",
      "usfm": "PSA.135.7"
    },
    {
      "verse": 8,
      "text": "او کسی است که پسران اول خانواده‌‌های مصر،",
      "usfm": "PSA.135.8"
    },
    {
      "verse": 8,
      "text": "و همچنین نخستزادگان حیوانات آنها را کشت.",
      "usfm": "PSA.135.8"
    },
    {
      "verse": 9,
      "text": "نشانه‌ها و کارهای شگفت‌آوری در برابر چشمان فرعون",
      "usfm": "PSA.135.9"
    },
    {
      "verse": 9,
      "text": "و خادمان او به عمل آورد.",
      "usfm": "PSA.135.9"
    },
    {
      "verse": 10,
      "text": "اقوام زیاد و پادشاهان مقتدر را",
      "usfm": "PSA.135.10"
    },
    {
      "verse": 10,
      "text": "نابود کرد.",
      "usfm": "PSA.135.10"
    },
    {
      "verse": 12,
      "text": "سیحون، پادشاه اموریان،",
      "usfm": "PSA.135.11+PSA.135.12"
    },
    {
      "verse": 12,
      "text": "عوج، پادشاه باشان،",
      "usfm": "PSA.135.11+PSA.135.12"
    },
    {
      "verse": 12,
      "text": "و تمام پادشاهان کنعان را از بین برد",
      "usfm": "PSA.135.11+PSA.135.12"
    },
    {
      "verse": 12,
      "text": "و سرزمین آنها را به قوم خود،",
      "usfm": "PSA.135.11+PSA.135.12"
    },
    {
      "verse": 12,
      "text": "بنی‌اسرائیل داد.",
      "usfm": "PSA.135.11+PSA.135.12"
    },
    {
      "verse": 13,
      "text": "خداوندا، نام تو تا ابد جاودان است",
      "usfm": "PSA.135.13"
    },
    {
      "verse": 13,
      "text": "و تمام نسلها تو را به یاد خواهند آورد.",
      "usfm": "PSA.135.13"
    },
    {
      "verse": 14,
      "text": "زیرا خداوند از قوم خود حمایت می‌کند",
      "usfm": "PSA.135.14"
    },
    {
      "verse": 14,
      "text": "و بر بندگان خود رحمت می‌کند.",
      "usfm": "PSA.135.14"
    },
    {
      "verse": 15,
      "text": "بُتهای اقوام دیگر از طلا و نقره",
      "usfm": "PSA.135.15"
    },
    {
      "verse": 15,
      "text": "ساختهٔ دست بشر هستند.",
      "usfm": "PSA.135.15"
    },
    {
      "verse": 16,
      "text": "آنها دهان دارند، امّا حرف نمی‌زنند.",
      "usfm": "PSA.135.16"
    },
    {
      "verse": 16,
      "text": "چشم دارند، ولی نمی‌بینند.",
      "usfm": "PSA.135.16"
    },
    {
      "verse": 17,
      "text": "گوش دارند، ولی نمی‌شنوند،",
      "usfm": "PSA.135.17"
    },
    {
      "verse": 17,
      "text": "حتّی قادر نیستند که نفس بکشند.",
      "usfm": "PSA.135.17"
    },
    {
      "verse": 18,
      "text": "کسانی‌که آنها را ساخته‌اند و به آنها ایمان دارند،",
      "usfm": "PSA.135.18"
    },
    {
      "verse": 18,
      "text": "مانند آنها خواهند شد.",
      "usfm": "PSA.135.18"
    },
    {
      "verse": 19,
      "text": "ای قوم اسرائیل، خداوند را ستایش کنید؛",
      "usfm": "PSA.135.19"
    },
    {
      "verse": 19,
      "text": "ای خاندان هارون، خداوند را بپرستید!",
      "usfm": "PSA.135.19"
    },
    {
      "verse": 20,
      "text": "ای طايفهٔ لاوی، او را بپرستید؛",
      "usfm": "PSA.135.20"
    },
    {
      "verse": 20,
      "text": "ای کسانی‌که از او می‌ترسید، خداوند را ستایش کنید!",
      "usfm": "PSA.135.20"
    },
    {
      "verse": 21,
      "text": "خداوند را در صهیون ستایش کنید",
      "usfm": "PSA.135.21"
    },
    {
      "verse": 21,
      "text": "و از خانهٔ او در اورشلیم.",
      "usfm": "PSA.135.21"
    },
    {
      "verse": 21,
      "text": "خدا را سپاس باد!",
      "usfm": "PSA.135.21"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/135.mp3"
}