{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 27,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند نور من و نجات من است،",
      "usfm": "PSA.27.1"
    },
    {
      "verse": 1,
      "text": "از که بترسم؟",
      "usfm": "PSA.27.1"
    },
    {
      "verse": 1,
      "text": "خداوند مرا از تمام خطرها حفظ می‌کند،",
      "usfm": "PSA.27.1"
    },
    {
      "verse": 1,
      "text": "هرگز هراسان نخواهم شد.",
      "usfm": "PSA.27.1"
    },
    {
      "verse": 2,
      "text": "وقتی شریران دور مرا گرفتند و خواستند مرا بکشند،",
      "usfm": "PSA.27.2"
    },
    {
      "verse": 2,
      "text": "لغزیدند و افتادند.",
      "usfm": "PSA.27.2"
    },
    {
      "verse": 3,
      "text": "اگر لشکری به من حمله کند،",
      "usfm": "PSA.27.3"
    },
    {
      "verse": 3,
      "text": "نخواهم ترسید،",
      "usfm": "PSA.27.3"
    },
    {
      "verse": 3,
      "text": "حتّی اگر دشمنان برای جنگ با من بیایند،",
      "usfm": "PSA.27.3"
    },
    {
      "verse": 3,
      "text": "باز هم به خدا توکّل خواهم کرد.",
      "usfm": "PSA.27.3"
    },
    {
      "verse": 4,
      "text": "یک چیز از خداوند خواستم،",
      "usfm": "PSA.27.4"
    },
    {
      "verse": 4,
      "text": "فقط یک چیز،",
      "usfm": "PSA.27.4"
    },
    {
      "verse": 4,
      "text": "و آن این است که تمام دوران عمرم در خانهٔ خداوند باشم",
      "usfm": "PSA.27.4"
    },
    {
      "verse": 4,
      "text": "و زیبایی جمال او را مشاهده کنم و دربارهٔ او تفکّر نمایم.",
      "usfm": "PSA.27.4"
    },
    {
      "verse": 5,
      "text": "در روز تنگی مرا پناه خواهد داد.",
      "usfm": "PSA.27.5"
    },
    {
      "verse": 5,
      "text": "او مرا بسلامت در خیمهٔ خود حفظ خواهد نمود،",
      "usfm": "PSA.27.5"
    },
    {
      "verse": 5,
      "text": "و مرا بر روی صخره‌ای بلند مطمئن می‌سازد.",
      "usfm": "PSA.27.5"
    },
    {
      "verse": 6,
      "text": "پس بر دشمنانم که دور مرا گرفته‌اند پیروز خواهم شد.",
      "usfm": "PSA.27.6"
    },
    {
      "verse": 6,
      "text": "با فریاد شادی در معبد بزرگ او قربانی خواهم گذرانید،",
      "usfm": "PSA.27.6"
    },
    {
      "verse": 6,
      "text": "و برای او سرود خواهم خواند و او را ستایش خواهم نمود.",
      "usfm": "PSA.27.6"
    },
    {
      "verse": 7,
      "text": "خداوندا، دعای مرا بشنو،",
      "usfm": "PSA.27.7"
    },
    {
      "verse": 7,
      "text": "بر من رحمت فرموده دعایم را مستجاب کن.",
      "usfm": "PSA.27.7"
    },
    {
      "verse": 8,
      "text": "تو فرموده‌ای: «طالب من باشید!»",
      "usfm": "PSA.27.8"
    },
    {
      "verse": 8,
      "text": "خداوند، از صمیم قلب می‌گویم که طالب تو هستم،",
      "usfm": "PSA.27.8"
    },
    {
      "verse": 9,
      "text": "روی خود را از من پنهان نکن!",
      "usfm": "PSA.27.9"
    },
    {
      "verse": 9,
      "text": "و بر من خشمگین مباش،",
      "usfm": "PSA.27.9"
    },
    {
      "verse": 9,
      "text": "و بندهٔ خود را از درگاهت مران.",
      "usfm": "PSA.27.9"
    },
    {
      "verse": 9,
      "text": "تو مددکار من بوده‌ای،",
      "usfm": "PSA.27.9"
    },
    {
      "verse": 9,
      "text": "ای خدای نجات بخش من،",
      "usfm": "PSA.27.9"
    },
    {
      "verse": 9,
      "text": "مرا ترک مکن و رد منما.",
      "usfm": "PSA.27.9"
    },
    {
      "verse": 10,
      "text": "حتّی اگر پدر و مادرم مرا ترک کنند،",
      "usfm": "PSA.27.10"
    },
    {
      "verse": 10,
      "text": "خداوند مرا ترک نخواهد کرد.",
      "usfm": "PSA.27.10"
    },
    {
      "verse": 11,
      "text": "خداوندا! راه خود را به من نشان بده،",
      "usfm": "PSA.27.11"
    },
    {
      "verse": 11,
      "text": "و به‌خاطر دشمنانم",
      "usfm": "PSA.27.11"
    },
    {
      "verse": 11,
      "text": "مرا به راه راست هدایت نما.",
      "usfm": "PSA.27.11"
    },
    {
      "verse": 12,
      "text": "مرا به دست دشمنانم مسپار،",
      "usfm": "PSA.27.12"
    },
    {
      "verse": 12,
      "text": "آنها با شهادت دروغ و نیرنگ برضد من برخاسته‌اند.",
      "usfm": "PSA.27.12"
    },
    {
      "verse": 13,
      "text": "می‌دانم که رحمت و نیکویی‌های خداوند را",
      "usfm": "PSA.27.13"
    },
    {
      "verse": 13,
      "text": "در این زندگی باز هم خواهم دید.",
      "usfm": "PSA.27.13"
    },
    {
      "verse": 14,
      "text": "بر خداوند توکّل کن،",
      "usfm": "PSA.27.14"
    },
    {
      "verse": 14,
      "text": "ایمان داشته باش",
      "usfm": "PSA.27.14"
    },
    {
      "verse": 14,
      "text": "و ناامید مشو.",
      "usfm": "PSA.27.14"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/27.mp3"
}