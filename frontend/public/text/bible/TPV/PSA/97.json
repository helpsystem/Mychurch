{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 97,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند سلطنت می‌کند، پس زمین شادی کند",
      "usfm": "PSA.97.1"
    },
    {
      "verse": 1,
      "text": "و جزیره‌ها مسرور گردند.",
      "usfm": "PSA.97.1"
    },
    {
      "verse": 2,
      "text": "ابرها و تاریکی او را احاطه کرده‌اند.",
      "usfm": "PSA.97.2"
    },
    {
      "verse": 2,
      "text": "سلطنت او بر عدالت و انصاف استوار است.",
      "usfm": "PSA.97.2"
    },
    {
      "verse": 3,
      "text": "آتش، پیشاپیش او حرکت می‌کند",
      "usfm": "PSA.97.3"
    },
    {
      "verse": 3,
      "text": "و تمام دشمنانش را از هرسو می‌سوزاند.",
      "usfm": "PSA.97.3"
    },
    {
      "verse": 4,
      "text": "برقهایش جهان را روشن می‌کند",
      "usfm": "PSA.97.4"
    },
    {
      "verse": 4,
      "text": "و زمین آن را می‌بیند و می‌لرزد.",
      "usfm": "PSA.97.4"
    },
    {
      "verse": 5,
      "text": "کوهها در مقابل خداوند سراسر زمین،",
      "usfm": "PSA.97.5"
    },
    {
      "verse": 5,
      "text": "مانند موم آب می‌شوند.",
      "usfm": "PSA.97.5"
    },
    {
      "verse": 6,
      "text": "آسمانها عدالت او را اعلام می‌کنند",
      "usfm": "PSA.97.6"
    },
    {
      "verse": 6,
      "text": "و همهٔ اقوام جهان جلال او را مشاهده می‌کنند.",
      "usfm": "PSA.97.6"
    },
    {
      "verse": 7,
      "text": "تمام بت‌پرستان شرمنده می‌شوند.",
      "usfm": "PSA.97.7"
    },
    {
      "verse": 7,
      "text": "ای تمامی خدایان، در مقابل خداوند زانو بزنید.",
      "usfm": "PSA.97.7"
    },
    {
      "verse": 8,
      "text": "ای خداوند، به‌خاطر داوری‌های تو",
      "usfm": "PSA.97.8"
    },
    {
      "verse": 8,
      "text": "مردم صهیون شادمان هستند",
      "usfm": "PSA.97.8"
    },
    {
      "verse": 8,
      "text": "و اهالی یهودا شادی می‌کنند.",
      "usfm": "PSA.97.8"
    },
    {
      "verse": 9,
      "text": "زیرا تو ای خداوند متعال،",
      "usfm": "PSA.97.9"
    },
    {
      "verse": 9,
      "text": "فرمانروای سراسر زمین و بالاتر از تمام خدایان هستی.",
      "usfm": "PSA.97.9"
    },
    {
      "verse": 10,
      "text": "خداوند آنانی را که از شرارت نفرت دارند، دوست می‌دارد.",
      "usfm": "PSA.97.10"
    },
    {
      "verse": 10,
      "text": "او جان مؤمنین خود را حفظ می‌کند",
      "usfm": "PSA.97.10"
    },
    {
      "verse": 10,
      "text": "و آنها را از دست شریر نجات می‌دهد.",
      "usfm": "PSA.97.10"
    },
    {
      "verse": 11,
      "text": "نور خدا بر مردمان صالح می‌تابد",
      "usfm": "PSA.97.11"
    },
    {
      "verse": 11,
      "text": "و شادمانی نصیب نیکوکاران می‌گردد.",
      "usfm": "PSA.97.11"
    },
    {
      "verse": 12,
      "text": "شما ای نیکوکاران،",
      "usfm": "PSA.97.12"
    },
    {
      "verse": 12,
      "text": "به‌خاطر آنچه خدای مقدّس انجام داده است، شادی نمایید.",
      "usfm": "PSA.97.12"
    },
    {
      "verse": 12,
      "text": "کارهای خداوند را به یاد آورید",
      "usfm": "PSA.97.12"
    },
    {
      "verse": 12,
      "text": "و او را شکر نمایید.",
      "usfm": "PSA.97.12"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/97.mp3"
}