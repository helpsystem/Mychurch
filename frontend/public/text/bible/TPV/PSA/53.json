{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 53,
  "verses": [
    {
      "verse": 1,
      "text": "احمقان در دل خود می‌گویند:",
      "usfm": "PSA.53.1"
    },
    {
      "verse": 1,
      "text": "«خدا وجود ندارد.»",
      "usfm": "PSA.53.1"
    },
    {
      "verse": 1,
      "text": "اینها اشخاصی فاسد هستند،",
      "usfm": "PSA.53.1"
    },
    {
      "verse": 1,
      "text": "کارهای زشت می‌کنند.",
      "usfm": "PSA.53.1"
    },
    {
      "verse": 1,
      "text": "و کار نیک از آنها سر نمی‌زند.",
      "usfm": "PSA.53.1"
    },
    {
      "verse": 2,
      "text": "خدا از آسمان بر مردم روی زمین می‌نگرد",
      "usfm": "PSA.53.2"
    },
    {
      "verse": 2,
      "text": "تا ببیند آیا شخص فهمیده‌ای وجود دارد",
      "usfm": "PSA.53.2"
    },
    {
      "verse": 2,
      "text": "که طالب خدا باشد.",
      "usfm": "PSA.53.2"
    },
    {
      "verse": 3,
      "text": "امّا همه گمراه و یکسان فاسد شده‌اند،",
      "usfm": "PSA.53.3"
    },
    {
      "verse": 3,
      "text": "حتّی یک نفر نیکوکار هم در بین آنها نیست.",
      "usfm": "PSA.53.3"
    },
    {
      "verse": 4,
      "text": "خدا می‌پرسد: «آیا این بدکاران شعور ندارند",
      "usfm": "PSA.53.4"
    },
    {
      "verse": 4,
      "text": "که بندگان مرا مانند نان می‌خورند",
      "usfm": "PSA.53.4"
    },
    {
      "verse": 4,
      "text": "و مرا به یاد نمی‌آورند؟»",
      "usfm": "PSA.53.4"
    },
    {
      "verse": 5,
      "text": "امّا آنها به وحشت خواهند افتاد",
      "usfm": "PSA.53.5"
    },
    {
      "verse": 5,
      "text": "به طوری که قبلاً هرگز آن‌طور وحشتزده نشده بودند.",
      "usfm": "PSA.53.5"
    },
    {
      "verse": 5,
      "text": "خدا استخوانهای دشمنانش را پراکنده خواهد کرد.",
      "usfm": "PSA.53.5"
    },
    {
      "verse": 5,
      "text": "آنان رسوا خواهند گشت،",
      "usfm": "PSA.53.5"
    },
    {
      "verse": 5,
      "text": "چون خدا آنها را طرد نموده است.",
      "usfm": "PSA.53.5"
    },
    {
      "verse": 6,
      "text": "ای کاش پیروزی برای بنی‌اسرائیل از صهیون بیاید،",
      "usfm": "PSA.53.6"
    },
    {
      "verse": 6,
      "text": "وقتی خداوند قوم خود را از اسارت آزاد کند،",
      "usfm": "PSA.53.6"
    },
    {
      "verse": 6,
      "text": "یعقوب شاد خواهد شد",
      "usfm": "PSA.53.6"
    },
    {
      "verse": 6,
      "text": "و بنی‌اسرائیل شادی خواهد كرد.",
      "usfm": "PSA.53.6"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/53.mp3"
}