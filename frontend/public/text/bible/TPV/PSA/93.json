{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 93,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند پادشاه است.",
      "usfm": "PSA.93.1"
    },
    {
      "verse": 1,
      "text": "او به شوکت و اقتدار آراسته است.",
      "usfm": "PSA.93.1"
    },
    {
      "verse": 1,
      "text": "زمین را محکم در جای خود استوار نمود",
      "usfm": "PSA.93.1"
    },
    {
      "verse": 1,
      "text": "و جنبش نخواهد خورد.",
      "usfm": "PSA.93.1"
    },
    {
      "verse": 2,
      "text": "تخت تو از ابتدا برقرار بوده",
      "usfm": "PSA.93.2"
    },
    {
      "verse": 2,
      "text": "و تو از ازل بوده‌ای.",
      "usfm": "PSA.93.2"
    },
    {
      "verse": 3,
      "text": "ای خداوند، اقیانوسها می‌خروشند",
      "usfm": "PSA.93.3"
    },
    {
      "verse": 3,
      "text": "و دریاها طغیان می‌کنند.",
      "usfm": "PSA.93.3"
    },
    {
      "verse": 4,
      "text": "خداوند که در آسمانها حکومت می‌کند،",
      "usfm": "PSA.93.4"
    },
    {
      "verse": 4,
      "text": "قویتر از امواج خروشان اقیانوسها",
      "usfm": "PSA.93.4"
    },
    {
      "verse": 4,
      "text": "و طغیان دریاها می‌باشد.",
      "usfm": "PSA.93.4"
    },
    {
      "verse": 5,
      "text": "ای خداوند، احکام تو مطمئن",
      "usfm": "PSA.93.5"
    },
    {
      "verse": 5,
      "text": "و معبد بزرگ تو تا ابدالآباد مقدّس است.",
      "usfm": "PSA.93.5"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/93.mp3"
}