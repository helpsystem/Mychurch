{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 137,
  "verses": [
    {
      "verse": 1,
      "text": "در کنار رودخانه‌های بابل نشستیم",
      "usfm": "PSA.137.1"
    },
    {
      "verse": 1,
      "text": "و به یاد صهیون گریه کردیم.",
      "usfm": "PSA.137.1"
    },
    {
      "verse": 2,
      "text": "آلات موسیقی خود را",
      "usfm": "PSA.137.2"
    },
    {
      "verse": 2,
      "text": "بر شاخه‌های درختان بید آویختیم.",
      "usfm": "PSA.137.2"
    },
    {
      "verse": 3,
      "text": "زیرا کسانی‌که ما را به اسارت برده بودند، از ما خواستند",
      "usfm": "PSA.137.3"
    },
    {
      "verse": 3,
      "text": "تا برایشان یکی از سرودهای صهیون را بخوانیم",
      "usfm": "PSA.137.3"
    },
    {
      "verse": 3,
      "text": "و آنها را سرگرم کنیم.",
      "usfm": "PSA.137.3"
    },
    {
      "verse": 4,
      "text": "امّا چگونه می‌توانستیم",
      "usfm": "PSA.137.4"
    },
    {
      "verse": 4,
      "text": "سرود خداوند را در دیار بیگانه بسراییم؟",
      "usfm": "PSA.137.4"
    },
    {
      "verse": 5,
      "text": "ای اورشلیم، اگر تو را فراموش کنم،",
      "usfm": "PSA.137.5"
    },
    {
      "verse": 5,
      "text": "دست راستم خشک گردد تا دیگر نتوانم چنگ بنوازم.",
      "usfm": "PSA.137.5"
    },
    {
      "verse": 6,
      "text": "اگر تو را ای اورشلیم، به یاد نیاورم",
      "usfm": "PSA.137.6"
    },
    {
      "verse": 6,
      "text": "و تو را بر همهٔ شادی‌ها ترجیح ندهم،",
      "usfm": "PSA.137.6"
    },
    {
      "verse": 6,
      "text": "زبانم به کامم بچسبد و لال شوم.",
      "usfm": "PSA.137.6"
    },
    {
      "verse": 7,
      "text": "خداوندا، به یادآور،",
      "usfm": "PSA.137.7"
    },
    {
      "verse": 7,
      "text": "روزی را که اَدومیان اورشلیم را تسخیر کردند",
      "usfm": "PSA.137.7"
    },
    {
      "verse": 7,
      "text": "و فریاد می‌زدند:",
      "usfm": "PSA.137.7"
    },
    {
      "verse": 7,
      "text": "«آن را با خاک یکسان کنید.»",
      "usfm": "PSA.137.7"
    },
    {
      "verse": 8,
      "text": "ای بابل، تو ویران خواهی شد.",
      "usfm": "PSA.137.8"
    },
    {
      "verse": 8,
      "text": "خوشا به حال کسی‌که آن چه تو بر سر ما آوردی،",
      "usfm": "PSA.137.8"
    },
    {
      "verse": 8,
      "text": "بر سر خودت بیاورد.",
      "usfm": "PSA.137.8"
    },
    {
      "verse": 9,
      "text": "خوشا به حال کسی‌که کودکان تو را بگیرد",
      "usfm": "PSA.137.9"
    },
    {
      "verse": 9,
      "text": "و آنها را به صخره‌ها بکوبد.",
      "usfm": "PSA.137.9"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/137.mp3"
}