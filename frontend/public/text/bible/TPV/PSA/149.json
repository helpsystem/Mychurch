{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 149,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.149.1"
    },
    {
      "verse": 1,
      "text": "برای خداوند سرودی تازه بسرایید",
      "usfm": "PSA.149.1"
    },
    {
      "verse": 1,
      "text": "و در برابر جماعت ایمانداران نام او را بستایید.",
      "usfm": "PSA.149.1"
    },
    {
      "verse": 2,
      "text": "ای بنی‌اسرائیل، به‌خاطر آفریدگار خود شاد باشید.",
      "usfm": "PSA.149.2"
    },
    {
      "verse": 2,
      "text": "ای ساکنان صهیون، به‌خاطر پادشاه خود شادمان باشید.",
      "usfm": "PSA.149.2"
    },
    {
      "verse": 3,
      "text": "با رقص نام او را ستایش کنید",
      "usfm": "PSA.149.3"
    },
    {
      "verse": 3,
      "text": "و با نوای عود و بربط او را بپرستید.",
      "usfm": "PSA.149.3"
    },
    {
      "verse": 4,
      "text": "زیرا خداوند از قوم خود خشنود است",
      "usfm": "PSA.149.4"
    },
    {
      "verse": 4,
      "text": "و فروتنان را پیروز و سرفراز می‌سازد.",
      "usfm": "PSA.149.4"
    },
    {
      "verse": 5,
      "text": "مؤمنینش به جلال او فخر کنند",
      "usfm": "PSA.149.5"
    },
    {
      "verse": 5,
      "text": "و در بسترهای خود برای او سرود شادمانی بسرایند.",
      "usfm": "PSA.149.5"
    },
    {
      "verse": 7,
      "text": "خدا را با صدای بلند ستایش کنند",
      "usfm": "PSA.149.6+PSA.149.7"
    },
    {
      "verse": 7,
      "text": "و شمشیرهای دو دَم را در دست بگیرند،",
      "usfm": "PSA.149.6+PSA.149.7"
    },
    {
      "verse": 7,
      "text": "تا اقوام و مردم خدانشناس را مجازات کنند.",
      "usfm": "PSA.149.6+PSA.149.7"
    },
    {
      "verse": 8,
      "text": "پادشاهانشان را با زنجیر",
      "usfm": "PSA.149.8"
    },
    {
      "verse": 8,
      "text": "و فرمانروایان آنها را با پای بندهای آهنین ببندند",
      "usfm": "PSA.149.8"
    },
    {
      "verse": 9,
      "text": "و طبق فرمان خداوند آنها را مجازات کنند.",
      "usfm": "PSA.149.9"
    },
    {
      "verse": 9,
      "text": "این افتخاری است برای همهٔ مؤمنین او.",
      "usfm": "PSA.149.9"
    },
    {
      "verse": 9,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.149.9"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/149.mp3"
}