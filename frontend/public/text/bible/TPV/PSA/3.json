{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 3,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، دشمنان بسیار دارم،",
      "usfm": "PSA.3.1"
    },
    {
      "verse": 1,
      "text": "عدّهٔ زیادی علیه من برخاسته‌اند.",
      "usfm": "PSA.3.1"
    },
    {
      "verse": 2,
      "text": "آنها دربارهٔ من صحبت می‌کنند و می‌گویند:",
      "usfm": "PSA.3.2"
    },
    {
      "verse": 2,
      "text": "«خدا او را کمک نخواهد کرد.»",
      "usfm": "PSA.3.2"
    },
    {
      "verse": 3,
      "text": "امّا تو ای خداوند، همیشه سپر من در برابر خطرات هستی؛",
      "usfm": "PSA.3.3"
    },
    {
      "verse": 3,
      "text": "تو به من پیروزی می‌بخشی",
      "usfm": "PSA.3.3"
    },
    {
      "verse": 3,
      "text": "و به من شجاعت می‌دهی.",
      "usfm": "PSA.3.3"
    },
    {
      "verse": 4,
      "text": "به حضور خداوند فریاد می‌کنم",
      "usfm": "PSA.3.4"
    },
    {
      "verse": 4,
      "text": "و او از کوه مقدّس خود مرا اجابت می‌کند.",
      "usfm": "PSA.3.4"
    },
    {
      "verse": 5,
      "text": "آسوده می‌خوابم و دوباره بیدار می‌شوم",
      "usfm": "PSA.3.5"
    },
    {
      "verse": 5,
      "text": "زیرا خداوند از من مراقبت می‌کند.",
      "usfm": "PSA.3.5"
    },
    {
      "verse": 6,
      "text": "از دهها هزار دشمنی که",
      "usfm": "PSA.3.6"
    },
    {
      "verse": 6,
      "text": "مرا از هر طرف احاطه کرده‌اند ترسی ندارم.",
      "usfm": "PSA.3.6"
    },
    {
      "verse": 7,
      "text": "ای خداوند برخیز، ای خدا مرا نجات بده.",
      "usfm": "PSA.3.7"
    },
    {
      "verse": 7,
      "text": "دشمنانم را مجازات کن",
      "usfm": "PSA.3.7"
    },
    {
      "verse": 7,
      "text": "و قدرت آنها را درهم بشکن تا نتوانند به من آسیبی برسانند.",
      "usfm": "PSA.3.7"
    },
    {
      "verse": 8,
      "text": "رهایی از سوی خداوند است",
      "usfm": "PSA.3.8"
    },
    {
      "verse": 8,
      "text": "و او به مؤمنین خود برکت خواهد داد.",
      "usfm": "PSA.3.8"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/3.mp3"
}