{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 101,
  "verses": [
    {
      "verse": 1,
      "text": "ای خداوند، رحمت و عدالت تو را می‌ستایم",
      "usfm": "PSA.101.1"
    },
    {
      "verse": 1,
      "text": "و برای تو سرود می‌خوانم.",
      "usfm": "PSA.101.1"
    },
    {
      "verse": 2,
      "text": "رفتار من بی‌عیب خواهد بود.",
      "usfm": "PSA.101.2"
    },
    {
      "verse": 2,
      "text": "چه وقت به نزد من خواهی آمد؟",
      "usfm": "PSA.101.2"
    },
    {
      "verse": 2,
      "text": "در خانهٔ خود با پاکی زندگی خواهم نمود.",
      "usfm": "PSA.101.2"
    },
    {
      "verse": 3,
      "text": "از کارهای بد خودداری می‌کنم.",
      "usfm": "PSA.101.3"
    },
    {
      "verse": 3,
      "text": "از کارهای کسانی‌که گمراه شده‌اند، نفرت دارم",
      "usfm": "PSA.101.3"
    },
    {
      "verse": 3,
      "text": "و همنشین آنها نمی‌شوم.",
      "usfm": "PSA.101.3"
    },
    {
      "verse": 4,
      "text": "از مردم کجرو دوری می‌کنم",
      "usfm": "PSA.101.4"
    },
    {
      "verse": 4,
      "text": "و با بدی و شرارت کاری ندارم.",
      "usfm": "PSA.101.4"
    },
    {
      "verse": 5,
      "text": "آنهایی را که از دیگران بدگویی می‌کنند،",
      "usfm": "PSA.101.5"
    },
    {
      "verse": 5,
      "text": "از بین می‌برم؛",
      "usfm": "PSA.101.5"
    },
    {
      "verse": 5,
      "text": "و اشخاص مغرور و متکبّر",
      "usfm": "PSA.101.5"
    },
    {
      "verse": 5,
      "text": "را تحمّل نمی‌کنم.",
      "usfm": "PSA.101.5"
    },
    {
      "verse": 6,
      "text": "از کسانی‌که به خداوند وفادارند، حمایت می‌کنم",
      "usfm": "PSA.101.6"
    },
    {
      "verse": 6,
      "text": "و آنها را در کاخ خود سکونت خواهم داد.",
      "usfm": "PSA.101.6"
    },
    {
      "verse": 6,
      "text": "آنهایی را که زندگی پاک و بی‌عیب دارند",
      "usfm": "PSA.101.6"
    },
    {
      "verse": 6,
      "text": "به کار خواهم گماشت.",
      "usfm": "PSA.101.6"
    },
    {
      "verse": 7,
      "text": "شخص فریبکار را در کاخ خود راه نخواهم داد",
      "usfm": "PSA.101.7"
    },
    {
      "verse": 7,
      "text": "و کسی را که دروغگوست در حضور خود نخواهم پذیرفت.",
      "usfm": "PSA.101.7"
    },
    {
      "verse": 8,
      "text": "همه‌روزه مردم بدکار را در مملکت خود نابود خواهم کرد",
      "usfm": "PSA.101.8"
    },
    {
      "verse": 8,
      "text": "و شهر خدا را از وجود اشخاص شریر پاک خواهم ساخت.",
      "usfm": "PSA.101.8"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/101.mp3"
}