{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 8,
  "verses": [
    {
      "verse": 1,
      "text": "ای خداوند، خداوند ما!",
      "usfm": "PSA.8.1"
    },
    {
      "verse": 1,
      "text": "چه پرشکوه است نام تو در سراسر جهان!",
      "usfm": "PSA.8.1"
    },
    {
      "verse": 1,
      "text": "و جلال تو برتر است از آسمانها.",
      "usfm": "PSA.8.1"
    },
    {
      "verse": 2,
      "text": "کودکان و شیرخوارگان شكوه تو را می‌سرایند.",
      "usfm": "PSA.8.2"
    },
    {
      "verse": 2,
      "text": "تو دشمنان و انتقام گیرندگان را ساکت می‌کنی،",
      "usfm": "PSA.8.2"
    },
    {
      "verse": 2,
      "text": "و از دشمنی آنان در امان هستی!",
      "usfm": "PSA.8.2"
    },
    {
      "verse": 3,
      "text": "هنگامی‌که به آسمان نگاه می‌کنم که تو آن را آفریده‌ای،",
      "usfm": "PSA.8.3"
    },
    {
      "verse": 3,
      "text": "و به ماه و ستارگانی که تو در آن قرار داده‌ای،",
      "usfm": "PSA.8.3"
    },
    {
      "verse": 4,
      "text": "انسان چیست که به او می‌اندیشی،",
      "usfm": "PSA.8.4"
    },
    {
      "verse": 4,
      "text": "و به او چنین توجّه می‌نمایی؟",
      "usfm": "PSA.8.4"
    },
    {
      "verse": 5,
      "text": "او را اندکی پایین‌تر از خود آفریدی",
      "usfm": "PSA.8.5"
    },
    {
      "verse": 5,
      "text": "و تاج جلال و افتخار را بر سر او نهادی.",
      "usfm": "PSA.8.5"
    },
    {
      "verse": 6,
      "text": "او را اشرف مخلوقات نهادی؛",
      "usfm": "PSA.8.6"
    },
    {
      "verse": 6,
      "text": "و اختیار همه‌چیز را به دست او سپردی:",
      "usfm": "PSA.8.6"
    },
    {
      "verse": 7,
      "text": "گوسفندان و گاوان و حیوانات وحشی،",
      "usfm": "PSA.8.7"
    },
    {
      "verse": 8,
      "text": "مرغان هوا، ماهیان دریا،",
      "usfm": "PSA.8.8"
    },
    {
      "verse": 8,
      "text": "و همهٔ جانوران آبزی را.",
      "usfm": "PSA.8.8"
    },
    {
      "verse": 9,
      "text": "ای خداوند، خداوند ما!",
      "usfm": "PSA.8.9"
    },
    {
      "verse": 9,
      "text": "چه مجید است نام تو در سراسر جهان.",
      "usfm": "PSA.8.9"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/8.mp3"
}