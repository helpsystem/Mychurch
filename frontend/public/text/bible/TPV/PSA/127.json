{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 127,
  "verses": [
    {
      "verse": 1,
      "text": "اگر خداوند خانه را بنا نکند،",
      "usfm": "PSA.127.1"
    },
    {
      "verse": 1,
      "text": "زحمت بنّایان بی‌فایده است.",
      "usfm": "PSA.127.1"
    },
    {
      "verse": 1,
      "text": "هرگاه خداوند از شهر نگهبانی نکند،",
      "usfm": "PSA.127.1"
    },
    {
      "verse": 1,
      "text": "مراقبت نگهبانان بیهوده است.",
      "usfm": "PSA.127.1"
    },
    {
      "verse": 2,
      "text": "فایده‌ای ندارد که از صبح زود تا شام",
      "usfm": "PSA.127.2"
    },
    {
      "verse": 2,
      "text": "برای به دست آوردن خوراک خود، این‌همه زحمت بکشید",
      "usfm": "PSA.127.2"
    },
    {
      "verse": 2,
      "text": "زیرا خداوند هنگامی‌که محبوبان او در خواب هستند،",
      "usfm": "PSA.127.2"
    },
    {
      "verse": 2,
      "text": "روزیِ آنها را آماده می‌کند.",
      "usfm": "PSA.127.2"
    },
    {
      "verse": 3,
      "text": "فرزندان، میراثی از جانب خداوند هستند",
      "usfm": "PSA.127.3"
    },
    {
      "verse": 3,
      "text": "و برکتی که خداوند به انسان عطا می‌کند.",
      "usfm": "PSA.127.3"
    },
    {
      "verse": 4,
      "text": "شخصی که در جوانی صاحب پسر می‌شود،",
      "usfm": "PSA.127.4"
    },
    {
      "verse": 4,
      "text": "فرزندانش مانند تیرهای تیز در دست سرباز هستند.",
      "usfm": "PSA.127.4"
    },
    {
      "verse": 5,
      "text": "خوشا به حال کسی‌که در ترکش خود از این تیرها فراوان دارد.",
      "usfm": "PSA.127.5"
    },
    {
      "verse": 5,
      "text": "آن شخص در دادگاه، هنگام مقابله با دشمن،",
      "usfm": "PSA.127.5"
    },
    {
      "verse": 5,
      "text": "هرگز شکست نخواهد خورد.",
      "usfm": "PSA.127.5"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/127.mp3"
}