{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 111,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.111.1"
    },
    {
      "verse": 1,
      "text": "خداوند را در میان قوم او،",
      "usfm": "PSA.111.1"
    },
    {
      "verse": 1,
      "text": "با تمامی دل خود خواهم ستود.",
      "usfm": "PSA.111.1"
    },
    {
      "verse": 2,
      "text": "کارهای خداوند چقدر عالی است،",
      "usfm": "PSA.111.2"
    },
    {
      "verse": 2,
      "text": "کسانی‌که به آنها علاقه دارند، دربارهٔ آنها تفکّر می‌کنند.",
      "usfm": "PSA.111.2"
    },
    {
      "verse": 3,
      "text": "تمام کارهای او پُرشکوه و با عظمت است",
      "usfm": "PSA.111.3"
    },
    {
      "verse": 3,
      "text": "و عدالت او جاودانی.",
      "usfm": "PSA.111.3"
    },
    {
      "verse": 4,
      "text": "کارهای عجیب او فراموش نشدنی است،",
      "usfm": "PSA.111.4"
    },
    {
      "verse": 4,
      "text": "زیرا خداوند رحیم و مهربان است.",
      "usfm": "PSA.111.4"
    },
    {
      "verse": 5,
      "text": "روزیِ ترسندگان خود را می‌رساند",
      "usfm": "PSA.111.5"
    },
    {
      "verse": 5,
      "text": "و پیمان خود را هرگز فراموش نمی‌کند.",
      "usfm": "PSA.111.5"
    },
    {
      "verse": 6,
      "text": "او با دادن سرزمین بیگانگان به قوم خود،",
      "usfm": "PSA.111.6"
    },
    {
      "verse": 6,
      "text": "قدرت خود را به آنها نشان داد.",
      "usfm": "PSA.111.6"
    },
    {
      "verse": 7,
      "text": "کارهای خداوند با عدالت و راستی",
      "usfm": "PSA.111.7"
    },
    {
      "verse": 7,
      "text": "و احکام او همه، قابل اعتماد می‌باشند.",
      "usfm": "PSA.111.7"
    },
    {
      "verse": 8,
      "text": "همهٔ آنها پایدار و ابدی هستند،",
      "usfm": "PSA.111.8"
    },
    {
      "verse": 8,
      "text": "زیرا بر عدالت و راستی بنا شده‌اند.",
      "usfm": "PSA.111.8"
    },
    {
      "verse": 9,
      "text": "به قوم خود آزادی بخشید و با آنها پیمانی ابدی بست.",
      "usfm": "PSA.111.9"
    },
    {
      "verse": 9,
      "text": "او مقدّس و پُر قدرت است.",
      "usfm": "PSA.111.9"
    },
    {
      "verse": 10,
      "text": "ترس از خداوند شروع حکمت است.",
      "usfm": "PSA.111.10"
    },
    {
      "verse": 10,
      "text": "او به کسانی‌که از او اطاعت می‌کنند، فهم و شعور می‌بخشد.",
      "usfm": "PSA.111.10"
    },
    {
      "verse": 10,
      "text": "او را تا به ابد سپاس باد!",
      "usfm": "PSA.111.10"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/111.mp3"
}