{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 87,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند شهر خود را بر کوه مقدّس بنا کرد.",
      "usfm": "PSA.87.1"
    },
    {
      "verse": 2,
      "text": "شهر اورشلیم را",
      "usfm": "PSA.87.2"
    },
    {
      "verse": 2,
      "text": "زیادتر از تمام شهرهای اسرائیل دوست دارد.",
      "usfm": "PSA.87.2"
    },
    {
      "verse": 3,
      "text": "ای شهر خدا، به چیزهای عالی",
      "usfm": "PSA.87.3"
    },
    {
      "verse": 3,
      "text": "که او دربارهٔ تو می‌گوید گوش کن.",
      "usfm": "PSA.87.3"
    },
    {
      "verse": 4,
      "text": "مصر و بابل جزو ممالکی هستند",
      "usfm": "PSA.87.4"
    },
    {
      "verse": 4,
      "text": "که مرا می‌شناسند",
      "usfm": "PSA.87.4"
    },
    {
      "verse": 4,
      "text": "و مردمان فلسطین، صور و حبشه را",
      "usfm": "PSA.87.4"
    },
    {
      "verse": 4,
      "text": "جزو ساکنان اورشلیم به حساب می‌آورم.",
      "usfm": "PSA.87.4"
    },
    {
      "verse": 5,
      "text": "دربارهٔ صهیون گفته می‌شود",
      "usfm": "PSA.87.5"
    },
    {
      "verse": 5,
      "text": "که تمام اقوام جهان به آن تعلّق دارند",
      "usfm": "PSA.87.5"
    },
    {
      "verse": 5,
      "text": "و خدای قادر مطلق آن را نیرومند می‌گرداند.",
      "usfm": "PSA.87.5"
    },
    {
      "verse": 6,
      "text": "خداوند آمار تمام مردم را تهیّه می‌کند",
      "usfm": "PSA.87.6"
    },
    {
      "verse": 6,
      "text": "و همهٔ آنها را اهل اورشلیم می‌شمارد.",
      "usfm": "PSA.87.6"
    },
    {
      "verse": 7,
      "text": "آنها رقص‌کنان می‌خوانند و می‌گویند",
      "usfm": "PSA.87.7"
    },
    {
      "verse": 7,
      "text": "که صهیون سرچشمهٔ همهٔ برکات است.",
      "usfm": "PSA.87.7"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/87.mp3"
}