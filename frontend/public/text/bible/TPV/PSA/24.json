{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 24,
  "verses": [
    {
      "verse": 1,
      "text": "زمین و هرچه در آن است از آن خداوند است.",
      "usfm": "PSA.24.1"
    },
    {
      "verse": 1,
      "text": "جهان و همهٔ موجودات آن به او تعلّق دارد.",
      "usfm": "PSA.24.1"
    },
    {
      "verse": 2,
      "text": "او اساس آن را بر دریاها قرار داد",
      "usfm": "PSA.24.2"
    },
    {
      "verse": 2,
      "text": "و آن را بر رودخانه‌ها بنا کرد.",
      "usfm": "PSA.24.2"
    },
    {
      "verse": 3,
      "text": "چه کسی می‌تواند به بالای کوه خداوند برود",
      "usfm": "PSA.24.3"
    },
    {
      "verse": 3,
      "text": "و به درگاه مقدّس او داخل شود؟",
      "usfm": "PSA.24.3"
    },
    {
      "verse": 4,
      "text": "کسی‌که كردار و پندارش پاک باشد.",
      "usfm": "PSA.24.4"
    },
    {
      "verse": 4,
      "text": "کسی‌که بت‌پرستی نمی‌کند",
      "usfm": "PSA.24.4"
    },
    {
      "verse": 4,
      "text": "و قسم دروغ نمی‌خورد.",
      "usfm": "PSA.24.4"
    },
    {
      "verse": 5,
      "text": "خداوند آنان را برکت می‌دهد و نجات می‌بخشد،",
      "usfm": "PSA.24.5"
    },
    {
      "verse": 5,
      "text": "و خدا آنان را بی‌گناه محسوب خواهد نمود.",
      "usfm": "PSA.24.5"
    },
    {
      "verse": 6,
      "text": "ایشان طالب خدا",
      "usfm": "PSA.24.6"
    },
    {
      "verse": 6,
      "text": "و مشتاق دیدار خدای یعقوب می‌باشند.",
      "usfm": "PSA.24.6"
    },
    {
      "verse": 7,
      "text": "ای دروازه‌ها",
      "usfm": "PSA.24.7"
    },
    {
      "verse": 7,
      "text": "و ای درهای قدیمی باز شوید",
      "usfm": "PSA.24.7"
    },
    {
      "verse": 7,
      "text": "تا پادشاه جلال داخل شود.",
      "usfm": "PSA.24.7"
    },
    {
      "verse": 8,
      "text": "این پادشاه جلال کیست؟",
      "usfm": "PSA.24.8"
    },
    {
      "verse": 8,
      "text": "او خداوند قادر متعال است!",
      "usfm": "PSA.24.8"
    },
    {
      "verse": 8,
      "text": "که در جنگها شکست نمی‌خورد.",
      "usfm": "PSA.24.8"
    },
    {
      "verse": 9,
      "text": "ای دروازه‌ها به کنار بروید،",
      "usfm": "PSA.24.9"
    },
    {
      "verse": 9,
      "text": "و ای درهای کهن باز شوید.",
      "usfm": "PSA.24.9"
    },
    {
      "verse": 9,
      "text": "تا پادشاه جلال داخل شود.",
      "usfm": "PSA.24.9"
    },
    {
      "verse": 10,
      "text": "این پادشاه جلال کیست؟",
      "usfm": "PSA.24.10"
    },
    {
      "verse": 10,
      "text": "او خداوند متعال است! او خداوند شکست ناپذیر است!",
      "usfm": "PSA.24.10"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/24.mp3"
}