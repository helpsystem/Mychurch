{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 125,
  "verses": [
    {
      "verse": 1,
      "text": "آنهایی که بر خداوند توکّل دارند، مانند کوه صهیون هستند",
      "usfm": "PSA.125.1"
    },
    {
      "verse": 1,
      "text": "که هیچ‌گاه نمی‌لرزند و از جای خود تکان نمی‌خورند.",
      "usfm": "PSA.125.1"
    },
    {
      "verse": 2,
      "text": "همان‌طور که کوهها،",
      "usfm": "PSA.125.2"
    },
    {
      "verse": 2,
      "text": "شهر اورشلیم را احاطه کرده‌اند،",
      "usfm": "PSA.125.2"
    },
    {
      "verse": 2,
      "text": "خداوند هم قوم خود را همیشه در پناه خود می‌گیرد.",
      "usfm": "PSA.125.2"
    },
    {
      "verse": 3,
      "text": "شریران همیشه در سرزمین نیکوکاران حکومت نخواهند کرد.",
      "usfm": "PSA.125.3"
    },
    {
      "verse": 3,
      "text": "وگرنه، نیکوکاران نیز ممکن است دست به شرارت بزنند.",
      "usfm": "PSA.125.3"
    },
    {
      "verse": 4,
      "text": "خداوندا، با مردم نیک که احکام تو را بجا می‌آورند،",
      "usfm": "PSA.125.4"
    },
    {
      "verse": 4,
      "text": "مهربان باش.",
      "usfm": "PSA.125.4"
    },
    {
      "verse": 5,
      "text": "امّا شریران را با کسانی‌که از راه تو پیروی نمی‌کنند،",
      "usfm": "PSA.125.5"
    },
    {
      "verse": 5,
      "text": "مجازات کن.",
      "usfm": "PSA.125.5"
    },
    {
      "verse": 5,
      "text": "صلح و سلامتی بر اسرائیل باد!",
      "usfm": "PSA.125.5"
    }
  ],
