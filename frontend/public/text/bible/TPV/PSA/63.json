{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 63,
  "verses": [
    {
      "verse": 1,
      "text": "خدایا تو خدای من هستی.",
      "usfm": "PSA.63.1"
    },
    {
      "verse": 1,
      "text": "من مشتاق تو هستم.",
      "usfm": "PSA.63.1"
    },
    {
      "verse": 1,
      "text": "مانند یک زمین خشک",
      "usfm": "PSA.63.1"
    },
    {
      "verse": 1,
      "text": "و سوزان و بی‌آب،",
      "usfm": "PSA.63.1"
    },
    {
      "verse": 1,
      "text": "با تمام وجود خود تشنهٔ توام.",
      "usfm": "PSA.63.1"
    },
    {
      "verse": 2,
      "text": "عطا فرما که به جایگاه مقدّس تو داخل شوم",
      "usfm": "PSA.63.2"
    },
    {
      "verse": 2,
      "text": "و قدرت و جلال تو را ببینم.",
      "usfm": "PSA.63.2"
    },
    {
      "verse": 3,
      "text": "محبّت پایدار تو برای من شیرین‌تر از زندگی است،",
      "usfm": "PSA.63.3"
    },
    {
      "verse": 3,
      "text": "بنابراین تو را ستایش می‌کنم.",
      "usfm": "PSA.63.3"
    },
    {
      "verse": 4,
      "text": "تا زنده‌ام از تو سپاسگزارم",
      "usfm": "PSA.63.4"
    },
    {
      "verse": 4,
      "text": "و دستِ دعا به درگاهت بلند می‌کنم.",
      "usfm": "PSA.63.4"
    },
    {
      "verse": 5,
      "text": "جان من سیر خواهد گردید",
      "usfm": "PSA.63.5"
    },
    {
      "verse": 5,
      "text": "و زبانم سرودهای شاد برای تو خواهد سرود.",
      "usfm": "PSA.63.5"
    },
    {
      "verse": 6,
      "text": "شبها وقتی‌که به بستر خود می‌روم تو را به یاد می‌آورم",
      "usfm": "PSA.63.6"
    },
    {
      "verse": 6,
      "text": "و تمام شب دربارهٔ تو تفکّر می‌کنم،",
      "usfm": "PSA.63.6"
    },
    {
      "verse": 7,
      "text": "زیرا تو مددکار من بوده‌ای",
      "usfm": "PSA.63.7"
    },
    {
      "verse": 7,
      "text": "و در سایهٔ بالهای تو سرود شادی می‌سرایم.",
      "usfm": "PSA.63.7"
    },
    {
      "verse": 8,
      "text": "من به تو متّكی هستم",
      "usfm": "PSA.63.8"
    },
    {
      "verse": 8,
      "text": "و دست تو مرا محافظت خواهد کرد.",
      "usfm": "PSA.63.8"
    },
    {
      "verse": 9,
      "text": "امّا کسانی‌که قصد کشتن مرا دارند",
      "usfm": "PSA.63.9"
    },
    {
      "verse": 9,
      "text": "به دنیای مردگان خواهند رفت،",
      "usfm": "PSA.63.9"
    },
    {
      "verse": 10,
      "text": "با شمشیر کشته خواهند شد",
      "usfm": "PSA.63.10"
    },
    {
      "verse": 10,
      "text": "و جسد آنان طعمهٔ شغالان خواهد گردید.",
      "usfm": "PSA.63.10"
    },
    {
      "verse": 11,
      "text": "امّا پادشاه به‌خاطر پیروزی که خدا به او عطا کرده است،",
      "usfm": "PSA.63.11"
    },
    {
      "verse": 11,
      "text": "شادی خواهد کرد.",
      "usfm": "PSA.63.11"
    },
    {
      "verse": 11,
      "text": "و همهٔ کسانی‌که به نام خدا وعده می‌دهند، او را سپاس خواهند گفت.",
      "usfm": "PSA.63.11"
    },
    {
      "verse": 11,
      "text": "امّا دهان دروغگویان بسته خواهد شد.",
      "usfm": "PSA.63.11"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/63.mp3"
}