{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 143,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، چون تو امین و عادل هستی،",
      "usfm": "PSA.143.1"
    },
    {
      "verse": 1,
      "text": "دعای مرا بشنو",
      "usfm": "PSA.143.1"
    },
    {
      "verse": 1,
      "text": "و به التماس من گوش بده.",
      "usfm": "PSA.143.1"
    },
    {
      "verse": 2,
      "text": "بنده‌ات را محاکمه مکن،",
      "usfm": "PSA.143.2"
    },
    {
      "verse": 2,
      "text": "زیرا هیچ شخص زنده‌ای در حضور تو بی‌گناه نیست.",
      "usfm": "PSA.143.2"
    },
    {
      "verse": 3,
      "text": "دشمن، مرا از پای درآورده",
      "usfm": "PSA.143.3"
    },
    {
      "verse": 3,
      "text": "و به زمین زده است.",
      "usfm": "PSA.143.3"
    },
    {
      "verse": 3,
      "text": "چنان روزگارم را سیاه کرده است",
      "usfm": "PSA.143.3"
    },
    {
      "verse": 3,
      "text": "که گویی سالهاست مرده‌ام.",
      "usfm": "PSA.143.3"
    },
    {
      "verse": 4,
      "text": "به‌خاطر این خود را باخته‌ام",
      "usfm": "PSA.143.4"
    },
    {
      "verse": 4,
      "text": "و بکلّی مأیوس شده‌ام.",
      "usfm": "PSA.143.4"
    },
    {
      "verse": 5,
      "text": "گذشته‏ها را به یاد می‌آورم",
      "usfm": "PSA.143.5"
    },
    {
      "verse": 5,
      "text": "و به آنچه که تو برای من انجام داده‏ای",
      "usfm": "PSA.143.5"
    },
    {
      "verse": 5,
      "text": "فکر می‌کنم.",
      "usfm": "PSA.143.5"
    },
    {
      "verse": 6,
      "text": "دستهای خود را برای دعا به درگاه تو بلند می‌کنم.",
      "usfm": "PSA.143.6"
    },
    {
      "verse": 6,
      "text": "مانند زمین خشکی که تشنهٔ آب است، همچنان جان من تشنهٔ توست.",
      "usfm": "PSA.143.6"
    },
    {
      "verse": 7,
      "text": "خداوندا، دعایم را هرچه زودتر مستجاب کن،",
      "usfm": "PSA.143.7"
    },
    {
      "verse": 7,
      "text": "زیرا امیدم را از دست داده‌ام.",
      "usfm": "PSA.143.7"
    },
    {
      "verse": 7,
      "text": "روی خود را از من مپوشان، مبادا بمیرم",
      "usfm": "PSA.143.7"
    },
    {
      "verse": 7,
      "text": "و به دیار خاموشان بروم.",
      "usfm": "PSA.143.7"
    },
    {
      "verse": 8,
      "text": "همه روزه از محبّت پایدار خود برخوردارم کن،",
      "usfm": "PSA.143.8"
    },
    {
      "verse": 8,
      "text": "زیرا بر تو توکّل دارم،",
      "usfm": "PSA.143.8"
    },
    {
      "verse": 8,
      "text": "به درگاه تو دعا می‌کنم",
      "usfm": "PSA.143.8"
    },
    {
      "verse": 8,
      "text": "تا راه زندگی را به من نشان بدهی.",
      "usfm": "PSA.143.8"
    },
    {
      "verse": 9,
      "text": "خداوندا، به تو پناه آورده‌ام،",
      "usfm": "PSA.143.9"
    },
    {
      "verse": 9,
      "text": "مرا از شر دشمنان برهان.",
      "usfm": "PSA.143.9"
    },
    {
      "verse": 10,
      "text": "تو خدای من هستی،",
      "usfm": "PSA.143.10"
    },
    {
      "verse": 10,
      "text": "مرا تعلیم بده تا ارادهٔ تو را انجام دهم.",
      "usfm": "PSA.143.10"
    },
    {
      "verse": 10,
      "text": "روح پاکت مرا به راه راست هدایت فرماید.",
      "usfm": "PSA.143.10"
    },
    {
      "verse": 11,
      "text": "خداوندا، مطابق وعدهٔ خود زندگیم را حفظ کن",
      "usfm": "PSA.143.11"
    },
    {
      "verse": 11,
      "text": "و با لطف خود مرا از مشکلاتم رهایی ده.",
      "usfm": "PSA.143.11"
    },
    {
      "verse": 12,
      "text": "به‌خاطر محبّت پایداری که به من داری، دشمنانم را نابود کن",
      "usfm": "PSA.143.12"
    },
    {
      "verse": 12,
      "text": "و کسانی را که بر من ظلم می‌کنند، از بین ببر،",
      "usfm": "PSA.143.12"
    },
    {
      "verse": 12,
      "text": "زیرا که من بندهٔ تو هستم.",
      "usfm": "PSA.143.12"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/143.mp3"
}