{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 121,
  "verses": [
    {
      "verse": 1,
      "text": "با چشمان خود به سوی کوهها نگاه می‌کنم!",
      "usfm": "PSA.121.1"
    },
    {
      "verse": 1,
      "text": "از کجا برای من کمک خواهد رسید؟",
      "usfm": "PSA.121.1"
    },
    {
      "verse": 2,
      "text": "کمک من از جانب خداوندی است،",
      "usfm": "PSA.121.2"
    },
    {
      "verse": 2,
      "text": "که آسمان و زمین را آفرید.",
      "usfm": "PSA.121.2"
    },
    {
      "verse": 3,
      "text": "او مرا از لغزش باز می‌دارد.",
      "usfm": "PSA.121.3"
    },
    {
      "verse": 3,
      "text": "او پشتیبانی است که همیشه بیدار است.",
      "usfm": "PSA.121.3"
    },
    {
      "verse": 4,
      "text": "او حافظ و نگهبان اسرائیل است",
      "usfm": "PSA.121.4"
    },
    {
      "verse": 4,
      "text": "و هرگز نمی‌خوابد.",
      "usfm": "PSA.121.4"
    },
    {
      "verse": 5,
      "text": "خداوند نگهبان توست،",
      "usfm": "PSA.121.5"
    },
    {
      "verse": 5,
      "text": "او در کنار توست و از تو پشتیبانی می‌کند.",
      "usfm": "PSA.121.5"
    },
    {
      "verse": 6,
      "text": "آفتاب در روز تو را اذیّت نخواهد کرد",
      "usfm": "PSA.121.6"
    },
    {
      "verse": 6,
      "text": "و مهتاب نیز در شب.",
      "usfm": "PSA.121.6"
    },
    {
      "verse": 7,
      "text": "خداوند تو را از تمام خطرها نجات خواهد داد",
      "usfm": "PSA.121.7"
    },
    {
      "verse": 7,
      "text": "و تو را محافظت خواهد نمود.",
      "usfm": "PSA.121.7"
    },
    {
      "verse": 8,
      "text": "خداوند مراقب رفت و آمد توست",
      "usfm": "PSA.121.8"
    },
    {
      "verse": 8,
      "text": "و همیشه از تو محافظت خواهد نمود.",
      "usfm": "PSA.121.8"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/121.mp3"
}