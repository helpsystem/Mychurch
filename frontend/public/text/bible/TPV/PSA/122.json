{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 122,
  "verses": [
    {
      "verse": 1,
      "text": "وقتی به من گفتند: «به خانهٔ خداوند برویم.»",
      "usfm": "PSA.122.1"
    },
    {
      "verse": 1,
      "text": "بسیار خوشحال شدم.",
      "usfm": "PSA.122.1"
    },
    {
      "verse": 2,
      "text": "اکنون اینجا،",
      "usfm": "PSA.122.2"
    },
    {
      "verse": 2,
      "text": "در دروازه‌های اورشلیم ایستاده‌ایم.",
      "usfm": "PSA.122.2"
    },
    {
      "verse": 3,
      "text": "اورشلیم شهری است",
      "usfm": "PSA.122.3"
    },
    {
      "verse": 3,
      "text": "بسیار محکم و به هم پیوسته.",
      "usfm": "PSA.122.3"
    },
    {
      "verse": 4,
      "text": "اینجا جایی است که تمام طایفه‌ها می‌آیند،",
      "usfm": "PSA.122.4"
    },
    {
      "verse": 4,
      "text": "تمام طایفه‌های اسرائیل،",
      "usfm": "PSA.122.4"
    },
    {
      "verse": 4,
      "text": "تا مطابق اوامر خداوند",
      "usfm": "PSA.122.4"
    },
    {
      "verse": 4,
      "text": "او را ستایش کنند.",
      "usfm": "PSA.122.4"
    },
    {
      "verse": 5,
      "text": "در اینجا پادشاهان اسرائیل",
      "usfm": "PSA.122.5"
    },
    {
      "verse": 5,
      "text": "برای داوری مردم می‌نشستند.",
      "usfm": "PSA.122.5"
    },
    {
      "verse": 6,
      "text": "برای صلح و سلامتی اورشلیم دعا کنید",
      "usfm": "PSA.122.6"
    },
    {
      "verse": 6,
      "text": "تا تمام کسانی‌که تو را دوست دارند، سعادتمند گردند.",
      "usfm": "PSA.122.6"
    },
    {
      "verse": 7,
      "text": "صلح و سلامتی در درون دیوارهای تو",
      "usfm": "PSA.122.7"
    },
    {
      "verse": 7,
      "text": "و امنیّت در قصرهای تو باد!",
      "usfm": "PSA.122.7"
    },
    {
      "verse": 8,
      "text": "به‌خاطر خویشاوندان و دوستان خود به اورشلیم می‌گویم:",
      "usfm": "PSA.122.8"
    },
    {
      "verse": 8,
      "text": "«سلامتی بر تو باد!»",
      "usfm": "PSA.122.8"
    },
    {
      "verse": 9,
      "text": "به‌خاطر خانهٔ خداوند خدای خود،",
      "usfm": "PSA.122.9"
    },
    {
      "verse": 9,
      "text": "سعادت تو را ای اورشلیم، خواهانم.",
      "usfm": "PSA.122.9"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/122.mp3"
}