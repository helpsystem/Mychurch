{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 6,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، نسبت به من خشمگین مباش",
      "usfm": "PSA.6.1"
    },
    {
      "verse": 1,
      "text": "و در غضب خود مرا تنبیه نکن.",
      "usfm": "PSA.6.1"
    },
    {
      "verse": 2,
      "text": "خداوندا، افسرده دلم، بر من رحم فرما؛",
      "usfm": "PSA.6.2"
    },
    {
      "verse": 2,
      "text": "بسیار ناتوانم، پس ای خداوند یاریم کن.",
      "usfm": "PSA.6.2"
    },
    {
      "verse": 3,
      "text": "جان من بشدّت پریشان است.",
      "usfm": "PSA.6.3"
    },
    {
      "verse": 3,
      "text": "ای خداوند تا به کی صبر کنم؟",
      "usfm": "PSA.6.3"
    },
    {
      "verse": 4,
      "text": "بیا ای خداوند و مرا نجات بده؛",
      "usfm": "PSA.6.4"
    },
    {
      "verse": 4,
      "text": "مرا به به‌خاطر رحمت خود رهایی ده.",
      "usfm": "PSA.6.4"
    },
    {
      "verse": 5,
      "text": "در دنیای مردگان یادی از تو نیست",
      "usfm": "PSA.6.5"
    },
    {
      "verse": 5,
      "text": "و کسی در آنجا تو را سپاس نمی‌گوید.",
      "usfm": "PSA.6.5"
    },
    {
      "verse": 6,
      "text": "از ناله خسته شده‌ام.",
      "usfm": "PSA.6.6"
    },
    {
      "verse": 6,
      "text": "هر شب سیل اشک",
      "usfm": "PSA.6.6"
    },
    {
      "verse": 6,
      "text": "در رختخواب من جاری است.",
      "usfm": "PSA.6.6"
    },
    {
      "verse": 7,
      "text": "به سختی می‌توانم ببینم؛",
      "usfm": "PSA.6.7"
    },
    {
      "verse": 7,
      "text": "چشمانم ورم کرده‌اند",
      "usfm": "PSA.6.7"
    },
    {
      "verse": 7,
      "text": "زیرا از دست دشمنانم گریهٔ بسیار نموده‌ام.",
      "usfm": "PSA.6.7"
    },
    {
      "verse": 8,
      "text": "ای بدکاران، از من دور شوید،",
      "usfm": "PSA.6.8"
    },
    {
      "verse": 8,
      "text": "زیرا خداوند صدای گریهٔ مرا شنیده است.",
      "usfm": "PSA.6.8"
    },
    {
      "verse": 9,
      "text": "خداوند التماس مرا شنیده",
      "usfm": "PSA.6.9"
    },
    {
      "verse": 9,
      "text": "و دعای مرا مستجاب نموده است.",
      "usfm": "PSA.6.9"
    },
    {
      "verse": 10,
      "text": "دشمنانم بشدّت شرمنده گردیده",
      "usfm": "PSA.6.10"
    },
    {
      "verse": 10,
      "text": "و با خجالت از پیشگاه خداوند رانده می‌شوند.",
      "usfm": "PSA.6.10"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/6.mp3"
}