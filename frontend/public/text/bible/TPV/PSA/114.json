{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 114,
  "verses": [
    {
      "verse": 1,
      "text": "وقتی بنی‌اسرائیل مصر را ترک کرد",
      "usfm": "PSA.114.1"
    },
    {
      "verse": 1,
      "text": "و وقتی فرزندان یعقوب از سرزمین بیگانه خارج شدند،",
      "usfm": "PSA.114.1"
    },
    {
      "verse": 2,
      "text": "یهودا قوم مقدّس او",
      "usfm": "PSA.114.2"
    },
    {
      "verse": 2,
      "text": "و اسرائیل ملک خاص او گردید.",
      "usfm": "PSA.114.2"
    },
    {
      "verse": 3,
      "text": "دریای سرخ با دیدن آنها گریخت",
      "usfm": "PSA.114.3"
    },
    {
      "verse": 3,
      "text": "و رود اردن به عقب بازگشت.",
      "usfm": "PSA.114.3"
    },
    {
      "verse": 4,
      "text": "کوهها مانند قوچها و تپّه‌ها،",
      "usfm": "PSA.114.4"
    },
    {
      "verse": 4,
      "text": "همچون برّه‌ها به جست و خیز پرداختند.",
      "usfm": "PSA.114.4"
    },
    {
      "verse": 5,
      "text": "ای دریا تو را چه شده است که گریختی؟",
      "usfm": "PSA.114.5"
    },
    {
      "verse": 5,
      "text": "و ای رود اردن چرا به عقب برگشتی؟",
      "usfm": "PSA.114.5"
    },
    {
      "verse": 6,
      "text": "ای کوهها و ای تپّه‏ها",
      "usfm": "PSA.114.6"
    },
    {
      "verse": 6,
      "text": "چرا مانند قوچها به جست و خیز پرداختید؟",
      "usfm": "PSA.114.6"
    },
    {
      "verse": 7,
      "text": "ای زمین در برابر خداوند",
      "usfm": "PSA.114.7"
    },
    {
      "verse": 7,
      "text": "و در حضور خدای یعقوب بلرز،",
      "usfm": "PSA.114.7"
    },
    {
      "verse": 8,
      "text": "زیرا او کسی است که صخره را به دریاچه تبدیل نمود",
      "usfm": "PSA.114.8"
    },
    {
      "verse": 8,
      "text": "و از سنگ خارا، چشمهٔ آب جاری ساخت.",
      "usfm": "PSA.114.8"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/114.mp3"
}