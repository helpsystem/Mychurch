{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 43,
  "verses": [
    {
      "verse": 1,
      "text": "ای خدای من، در برابر مردم بی‌رحم از من دفاع کن",
      "usfm": "PSA.43.1"
    },
    {
      "verse": 1,
      "text": "و بی‌گناهی مرا اعلام نما،",
      "usfm": "PSA.43.1"
    },
    {
      "verse": 1,
      "text": "مرا از دست مردم شریر و دروغگو برهان.",
      "usfm": "PSA.43.1"
    },
    {
      "verse": 2,
      "text": "خدایا، تو پناهگاه من هستی.",
      "usfm": "PSA.43.2"
    },
    {
      "verse": 2,
      "text": "چرا رهایم کرده‌ای؟",
      "usfm": "PSA.43.2"
    },
    {
      "verse": 2,
      "text": "چرا از دست ظلم دشمنان",
      "usfm": "PSA.43.2"
    },
    {
      "verse": 2,
      "text": "همیشه رنج بکشم؟",
      "usfm": "PSA.43.2"
    },
    {
      "verse": 3,
      "text": "نور و راستی خود را بفرست",
      "usfm": "PSA.43.3"
    },
    {
      "verse": 3,
      "text": "تا راهنمای من باشند",
      "usfm": "PSA.43.3"
    },
    {
      "verse": 3,
      "text": "و مرا به کوه مقدّس",
      "usfm": "PSA.43.3"
    },
    {
      "verse": 3,
      "text": "که بارگاه توست برسانند.",
      "usfm": "PSA.43.3"
    },
    {
      "verse": 4,
      "text": "آنگاه در برابر قربانگاه تو خواهم ایستاد",
      "usfm": "PSA.43.4"
    },
    {
      "verse": 4,
      "text": "و برای تو ای خدا، خدای من که سرچشمهٔ شادی هستی،",
      "usfm": "PSA.43.4"
    },
    {
      "verse": 4,
      "text": "با بربط خواهم نواخت",
      "usfm": "PSA.43.4"
    },
    {
      "verse": 4,
      "text": "و سرود شکرگزاری خواهم سرایید.",
      "usfm": "PSA.43.4"
    },
    {
      "verse": 5,
      "text": "ای جان من چرا افسرده و غمگین هستی؟",
      "usfm": "PSA.43.5"
    },
    {
      "verse": 5,
      "text": "بر خدا امید داشته باش زیرا",
      "usfm": "PSA.43.5"
    },
    {
      "verse": 5,
      "text": "که دوباره او را ستایش خواهی کرد،",
      "usfm": "PSA.43.5"
    },
    {
      "verse": 5,
      "text": "چون او خدای من و مددکار من است.",
      "usfm": "PSA.43.5"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/43.mp3"
}