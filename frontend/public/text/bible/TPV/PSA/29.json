{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 29,
  "verses": [
    {
      "verse": 1,
      "text": "ای فرشتگان آسمان، خداوند را ستایش کنید.",
      "usfm": "PSA.29.1"
    },
    {
      "verse": 1,
      "text": "جلال و قدرت او را ستایش نمایید.",
      "usfm": "PSA.29.1"
    },
    {
      "verse": 2,
      "text": "نام پُرجلال خداوند را بستایید،",
      "usfm": "PSA.29.2"
    },
    {
      "verse": 2,
      "text": "او را با لباس پرهیزکاری بپرستید.",
      "usfm": "PSA.29.2"
    },
    {
      "verse": 3,
      "text": "صدای خداوند از فراز اقیانوسها شنیده می‌شود،",
      "usfm": "PSA.29.3"
    },
    {
      "verse": 3,
      "text": "خدای جلال می‌غرّد",
      "usfm": "PSA.29.3"
    },
    {
      "verse": 3,
      "text": "و صدای او بر بالای اقیانوسها طنین می‌افکند.",
      "usfm": "PSA.29.3"
    },
    {
      "verse": 4,
      "text": "صدای خداوند با هیبت",
      "usfm": "PSA.29.4"
    },
    {
      "verse": 4,
      "text": "و با شکوه است.",
      "usfm": "PSA.29.4"
    },
    {
      "verse": 5,
      "text": "صدای خداوند درختان سدر را می‌شکند،",
      "usfm": "PSA.29.5"
    },
    {
      "verse": 5,
      "text": "حتّی درختان سدر لبنان را.",
      "usfm": "PSA.29.5"
    },
    {
      "verse": 6,
      "text": "کوههای لبنان و حرمون را مانند گوساله",
      "usfm": "PSA.29.6"
    },
    {
      "verse": 6,
      "text": "به جنبش در می‌آورد.",
      "usfm": "PSA.29.6"
    },
    {
      "verse": 7,
      "text": "صدای خداوند رعد و برق پدید می‌آورد.",
      "usfm": "PSA.29.7"
    },
    {
      "verse": 8,
      "text": "صدای خداوند بیابان را به لرزه در می‌آورد",
      "usfm": "PSA.29.8"
    },
    {
      "verse": 8,
      "text": "و صحرای قادش را می‌جنباند.",
      "usfm": "PSA.29.8"
    },
    {
      "verse": 9,
      "text": "صدای خداوند درختان بلوط را تکان می‌دهد،",
      "usfm": "PSA.29.9"
    },
    {
      "verse": 9,
      "text": "و درختان جنگل را بی‌برگ می‌سازد.",
      "usfm": "PSA.29.9"
    },
    {
      "verse": 9,
      "text": "همه در معبد بزرگ او فریاد می‌زنند: «بر خداوند جلال باد!»",
      "usfm": "PSA.29.9"
    },
    {
      "verse": 10,
      "text": "خداوند به عنوان پادشاه ابدی",
      "usfm": "PSA.29.10"
    },
    {
      "verse": 10,
      "text": "بر فراز توفانها جلوس فرموده است.",
      "usfm": "PSA.29.10"
    },
    {
      "verse": 11,
      "text": "خداوند به قوم خود قدرت عطا فرماید",
      "usfm": "PSA.29.11"
    },
    {
      "verse": 11,
      "text": "و برکت و آرامش ببخشد!",
      "usfm": "PSA.29.11"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/29.mp3"
}