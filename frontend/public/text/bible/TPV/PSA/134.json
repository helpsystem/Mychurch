    {
      "verse": 1,
      "text": "ای جمیع بندگان خداوند،",
      "usfm": "PSA.134.1"
    },
    {
      "verse": 1,
      "text": "و آنهایی که هر شب در معبد بزرگ، او را خدمت می‌کنید،",
      "usfm": "PSA.134.1"
    },
    {
      "verse": 1,
      "text": "بیایید او را پرستش کنید.",
      "usfm": "PSA.134.1"
    },
    {
      "verse": 2,
      "text": "دستهای خود را به سوی معبد بزرگ او بلند کنید",
      "usfm": "PSA.134.2"
    },
    {
      "verse": 2,
      "text": "و او را ستایش نمایید.",
      "usfm": "PSA.134.2"
    },
    {
      "verse": 3,
      "text": "خداوند که خالق آسمان و زمین است",
      "usfm": "PSA.134.3"
    },
    {
      "verse": 3,
      "text": "شما را از صهیون برکت دهد.",
      "usfm": "PSA.134.3"
    }
