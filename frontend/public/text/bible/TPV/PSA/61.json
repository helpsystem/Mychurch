{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 61,
  "verses": [
    {
      "verse": 1,
      "text": "خدایا، نالهٔ مرا بشنو",
      "usfm": "PSA.61.1"
    },
    {
      "verse": 1,
      "text": "و به دعای من گوش بده.",
      "usfm": "PSA.61.1"
    },
    {
      "verse": 2,
      "text": "در پریشانی و از این دیار غریب",
      "usfm": "PSA.61.2"
    },
    {
      "verse": 2,
      "text": "رو به سوی تو می‌آورم،",
      "usfm": "PSA.61.2"
    },
    {
      "verse": 2,
      "text": "تو مرا به مکانی مطمئن رهبری فرما.",
      "usfm": "PSA.61.2"
    },
    {
      "verse": 3,
      "text": "زیرا در برابر دشمنانم تو نگهبان",
      "usfm": "PSA.61.3"
    },
    {
      "verse": 3,
      "text": "و بُرج محکم من هستی.",
      "usfm": "PSA.61.3"
    },
    {
      "verse": 4,
      "text": "عطا فرما که تمام دوران عمرم در خانهٔ تو ساکن شوم",
      "usfm": "PSA.61.4"
    },
    {
      "verse": 4,
      "text": "و زیر سایهٔ بالهای تو در امان باشم.",
      "usfm": "PSA.61.4"
    },
    {
      "verse": 5,
      "text": "ای خدا، قولی را که به تو داده‌ام، شنیده‌ای",
      "usfm": "PSA.61.5"
    },
    {
      "verse": 5,
      "text": "و برکاتی را نصیب من کرده‌ای که به ترسندگان خود می‌دهی.",
      "usfm": "PSA.61.5"
    },
    {
      "verse": 6,
      "text": "به پادشاه عمر طولانی عطا فرما",
      "usfm": "PSA.61.6"
    },
    {
      "verse": 6,
      "text": "و به سالهای عمر وی بیافزا.",
      "usfm": "PSA.61.6"
    },
    {
      "verse": 7,
      "text": "خدایا، تاج و تخت او را برای ابد در حضور خود برقرار ساز",
      "usfm": "PSA.61.7"
    },
    {
      "verse": 7,
      "text": "و با محبّت و وفاداری پایدار از او نگهداری کن.",
      "usfm": "PSA.61.7"
    },
    {
      "verse": 8,
      "text": "من همیشه تو را ستایش می‌کنم",
      "usfm": "PSA.61.8"
    },
    {
      "verse": 8,
      "text": "و هر روز نذری را که کرده‌‌ام، ادا می‌کنم.",
      "usfm": "PSA.61.8"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/61.mp3"
}