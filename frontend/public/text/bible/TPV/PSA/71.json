{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 71,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، به تو پناه آورده‌ام،",
      "usfm": "PSA.71.1"
    },
    {
      "verse": 1,
      "text": "شرمسارم مکن!",
      "usfm": "PSA.71.1"
    },
    {
      "verse": 2,
      "text": "تو عادل هستی، کمک کن و مرا رهایی ده.",
      "usfm": "PSA.71.2"
    },
    {
      "verse": 2,
      "text": "دعایم را بشنو و مرا نجات ده.",
      "usfm": "PSA.71.2"
    },
    {
      "verse": 3,
      "text": "پناهگاه امن من باش",
      "usfm": "PSA.71.3"
    },
    {
      "verse": 3,
      "text": "و سنگری محکم برای محافظتم،",
      "usfm": "PSA.71.3"
    },
    {
      "verse": 3,
      "text": "تو قلعه و پناهگاه من هستی.",
      "usfm": "PSA.71.3"
    },
    {
      "verse": 4,
      "text": "خدایا، مرا از دست مردم شریر رهایی ده",
      "usfm": "PSA.71.4"
    },
    {
      "verse": 4,
      "text": "و از شر اشخاص بدکار و ظالم برهان.",
      "usfm": "PSA.71.4"
    },
    {
      "verse": 5,
      "text": "چون تو ای خداوند، امید من هستی،",
      "usfm": "PSA.71.5"
    },
    {
      "verse": 5,
      "text": "از جوانی به تو توکّل نموده‌ام.",
      "usfm": "PSA.71.5"
    },
    {
      "verse": 6,
      "text": "در تمام دوران عمرم به تو تکیه کرده‌‌ام",
      "usfm": "PSA.71.6"
    },
    {
      "verse": 6,
      "text": "و از روز تولّدم، تو پشتیبان من بوده‌ای.",
      "usfm": "PSA.71.6"
    },
    {
      "verse": 6,
      "text": "من همیشه تو را ستایش می‌کنم.",
      "usfm": "PSA.71.6"
    },
    {
      "verse": 7,
      "text": "زندگی من سرمشق عدّهٔ زیادی گردیده است،",
      "usfm": "PSA.71.7"
    },
    {
      "verse": 7,
      "text": "چون تو پشتیبان نیرومند من بوده‌ای.",
      "usfm": "PSA.71.7"
    },
    {
      "verse": 8,
      "text": "تمام روز تو را ستایش می‌کنم.",
      "usfm": "PSA.71.8"
    },
    {
      "verse": 8,
      "text": "و جلال تو را اعلام می‌نمایم.",
      "usfm": "PSA.71.8"
    },
    {
      "verse": 9,
      "text": "اکنون که پیر و ناتوانم،",
      "usfm": "PSA.71.9"
    },
    {
      "verse": 9,
      "text": "مرا از درگاه خود مَران و فراموشم مکن.",
      "usfm": "PSA.71.9"
    },
    {
      "verse": 10,
      "text": "زیرا دشمنانم برای کشتن",
      "usfm": "PSA.71.10"
    },
    {
      "verse": 10,
      "text": "من با هم توطئه می‌کنند.",
      "usfm": "PSA.71.10"
    },
    {
      "verse": 11,
      "text": "و می‌گویند: «خدا او را ترک کرده،",
      "usfm": "PSA.71.11"
    },
    {
      "verse": 11,
      "text": "پس برویم و او را دستگیر کنیم،",
      "usfm": "PSA.71.11"
    },
    {
      "verse": 11,
      "text": "زیرا کسی نیست که او را از دست ما رهایی بدهد.»",
      "usfm": "PSA.71.11"
    },
    {
      "verse": 12,
      "text": "خدایا، از من دور مباش.",
      "usfm": "PSA.71.12"
    },
    {
      "verse": 12,
      "text": "ای خدای من، بشتاب و مرا کمک کن!",
      "usfm": "PSA.71.12"
    },
    {
      "verse": 13,
      "text": "دشمنان جانم،",
      "usfm": "PSA.71.13"
    },
    {
      "verse": 13,
      "text": "شرمنده و نابود گردند",
      "usfm": "PSA.71.13"
    },
    {
      "verse": 13,
      "text": "و آنانی که در پی آزار من هستند،",
      "usfm": "PSA.71.13"
    },
    {
      "verse": 13,
      "text": "سرافکنده و پریشان گردند.",
      "usfm": "PSA.71.13"
    },
    {
      "verse": 14,
      "text": "امید من همیشه به تو می‌باشد؛",
      "usfm": "PSA.71.14"
    },
    {
      "verse": 14,
      "text": "و بیشتر و بیشتر تو را ستایش می‌کنم!",
      "usfm": "PSA.71.14"
    },
    {
      "verse": 15,
      "text": "تمام روز دربارهٔ نجات خود",
      "usfm": "PSA.71.15"
    },
    {
      "verse": 15,
      "text": "و کارهای نیک تو که تعداد آن از فهم من خارج است،",
      "usfm": "PSA.71.15"
    },
    {
      "verse": 15,
      "text": "گفت‌وگو خواهم کرد.",
      "usfm": "PSA.71.15"
    },
    {
      "verse": 16,
      "text": "با قدرت خداوند، خدای متعال خواهم آمد",
      "usfm": "PSA.71.16"
    },
    {
      "verse": 16,
      "text": "و برای همه اعلام خواهم کرد که تو یگانه خدای عادل هستی.",
      "usfm": "PSA.71.16"
    },
    {
      "verse": 17,
      "text": "از دوران کودکی، تو مرا تعلیم داده‌ای",
      "usfm": "PSA.71.17"
    },
    {
      "verse": 17,
      "text": "و من هنوز هم کارهای عجیب تو را اعلام می‌کنم.",
      "usfm": "PSA.71.17"
    },
    {
      "verse": 18,
      "text": "پس ای خدا، اکنون که پیر شده",
      "usfm": "PSA.71.18"
    },
    {
      "verse": 18,
      "text": "و موهایم سفید گردیده است،",
      "usfm": "PSA.71.18"
    },
    {
      "verse": 18,
      "text": "مرا ترک منما،",
      "usfm": "PSA.71.18"
    },
    {
      "verse": 18,
      "text": "تا قدرت و عجایب تو را برای نسلهای آینده بیان کنم.",
      "usfm": "PSA.71.18"
    },
    {
      "verse": 19,
      "text": "خدایا، عدالت تو تا به آسمانها رسیده است.",
      "usfm": "PSA.71.19"
    },
    {
      "verse": 19,
      "text": "تو کارهای عجیب انجام داده‌ای،",
      "usfm": "PSA.71.19"
    },
    {
      "verse": 19,
      "text": "کسی مانند تو وجود ندارد.",
      "usfm": "PSA.71.19"
    },
    {
      "verse": 20,
      "text": "تو انواع سختی‌ها و مشکلات بسیار بر سر من آوردی،",
      "usfm": "PSA.71.20"
    },
    {
      "verse": 20,
      "text": "امّا دوباره قدرت مرا به من بازمی‌گردانی",
      "usfm": "PSA.71.20"
    },
    {
      "verse": 20,
      "text": "و مرا از چنگال مرگ نجات خواهی داد.",
      "usfm": "PSA.71.20"
    },
    {
      "verse": 21,
      "text": "مرا بیشتر از گذشته سربلند خواهی کرد؛",
      "usfm": "PSA.71.21"
    },
    {
      "verse": 21,
      "text": "و از من دلجویی خواهی نمود.",
      "usfm": "PSA.71.21"
    },
    {
      "verse": 22,
      "text": "ای خدای من، با نوای چنگ تو را ستایش خواهم کرد",
      "usfm": "PSA.71.22"
    },
    {
      "verse": 22,
      "text": "و صداقت تو را خواهم ستود.",
      "usfm": "PSA.71.22"
    },
    {
      "verse": 22,
      "text": "ای خدای مقدّس اسرائیل،",
      "usfm": "PSA.71.22"
    },
    {
      "verse": 22,
      "text": "با نوای چنگ خود برای تو سرود خواهم سرایید.",
      "usfm": "PSA.71.22"
    },
    {
      "verse": 23,
      "text": "با شادی سرود برای تو خواهم سرایید و خواهم خواند.",
      "usfm": "PSA.71.23"
    },
    {
      "verse": 23,
      "text": "با تمام وجود خود خواهم خواند،",
      "usfm": "PSA.71.23"
    },
    {
      "verse": 23,
      "text": "زیرا که تو مرا رهایی داده‌ای.",
      "usfm": "PSA.71.23"
    },
    {
      "verse": 24,
      "text": "تمام روز دربارهٔ عدالت تو گفت‌وگو خواهم کرد،",
      "usfm": "PSA.71.24"
    },
    {
      "verse": 24,
      "text": "زیرا همهٔ کسانی‌که می‌خواستند مرا اذیّت و آزار کنند،",
      "usfm": "PSA.71.24"
    },
    {
      "verse": 24,
      "text": "شرمنده و رسوا شدند.",
      "usfm": "PSA.71.24"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/71.mp3"
}