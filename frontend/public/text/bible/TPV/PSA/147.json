{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 147,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.147.1"
    },
    {
      "verse": 1,
      "text": "چه نیکوست که خداوند را با سراییدن سرود ستایش کنیم،",
      "usfm": "PSA.147.1"
    },
    {
      "verse": 1,
      "text": "ستایش خداوند بسیار مناسب و لذّت بخش است.",
      "usfm": "PSA.147.1"
    },
    {
      "verse": 2,
      "text": "خداوند اورشلیم را دوباره آباد می‌کند",
      "usfm": "PSA.147.2"
    },
    {
      "verse": 2,
      "text": "و پراکندگان اسرائیل را جمع می‌سازد.",
      "usfm": "PSA.147.2"
    },
    {
      "verse": 3,
      "text": "او دل‏شكستگان را تسلّی می‌دهد",
      "usfm": "PSA.147.3"
    },
    {
      "verse": 3,
      "text": "و بر زخمهای ایشان مرهم می‌گذارد.",
      "usfm": "PSA.147.3"
    },
    {
      "verse": 4,
      "text": "او تعداد ستارگان را می‌‌داند",
      "usfm": "PSA.147.4"
    },
    {
      "verse": 4,
      "text": "و هر کدام از آنها را به نام می‌شناسد.",
      "usfm": "PSA.147.4"
    },
    {
      "verse": 5,
      "text": "خداوند ما بزرگ و قدرتش عظیم است،",
      "usfm": "PSA.147.5"
    },
    {
      "verse": 5,
      "text": "دانش و حکمت او بی‌کران است.",
      "usfm": "PSA.147.5"
    },
    {
      "verse": 6,
      "text": "خداوند، مسکینان را برمی‌افرازد،",
      "usfm": "PSA.147.6"
    },
    {
      "verse": 6,
      "text": "و شریران را سرنگون می‌کند.",
      "usfm": "PSA.147.6"
    },
    {
      "verse": 7,
      "text": "برای خداوند سرود شکرگزاری بخوانید",
      "usfm": "PSA.147.7"
    },
    {
      "verse": 7,
      "text": "و با نوای بربط برای خدای ما بسرایید.",
      "usfm": "PSA.147.7"
    },
    {
      "verse": 8,
      "text": "او آسمانها را با ابر می‌پوشاند",
      "usfm": "PSA.147.8"
    },
    {
      "verse": 8,
      "text": "و برای زمین باران فراهم می‌سازد",
      "usfm": "PSA.147.8"
    },
    {
      "verse": 8,
      "text": "و سبزه‌ها را بر تپّه‌ها می‌رویاند.",
      "usfm": "PSA.147.8"
    },
    {
      "verse": 9,
      "text": "به حیوانات خوراک می‌دهد",
      "usfm": "PSA.147.9"
    },
    {
      "verse": 9,
      "text": "و جوجه کلاغها را غذا می‌دهد.",
      "usfm": "PSA.147.9"
    },
    {
      "verse": 10,
      "text": "به قدرت اسبها علاقه‌ای ندارد",
      "usfm": "PSA.147.10"
    },
    {
      "verse": 10,
      "text": "و نیروی انسانها او را خشنود نمی‌سازد،",
      "usfm": "PSA.147.10"
    },
    {
      "verse": 11,
      "text": "بلکه رضامندی او از کسانی است که او را گرامی می‌دارند",
      "usfm": "PSA.147.11"
    },
    {
      "verse": 11,
      "text": "و به محبّت پایدار او توکّل می‌کنند.",
      "usfm": "PSA.147.11"
    },
    {
      "verse": 12,
      "text": "خداوند را ستایش کن، ای اورشلیم!",
      "usfm": "PSA.147.12"
    },
    {
      "verse": 12,
      "text": "خدای خود را ستایش کن، ای صهیون!",
      "usfm": "PSA.147.12"
    },
    {
      "verse": 13,
      "text": "او دروازه‌هایت را بر روی دشمن محکم می‌بندد",
      "usfm": "PSA.147.13"
    },
    {
      "verse": 13,
      "text": "و ساکنان تو را برکت می‌دهد.",
      "usfm": "PSA.147.13"
    },
    {
      "verse": 14,
      "text": "او صلح را به مرزهای تو می‌آورد",
      "usfm": "PSA.147.14"
    },
    {
      "verse": 14,
      "text": "و انبارهایت را از غلّه پُر می‌سازد.",
      "usfm": "PSA.147.14"
    },
    {
      "verse": 15,
      "text": "او به زمین فرمان می‌دهد",
      "usfm": "PSA.147.15"
    },
    {
      "verse": 15,
      "text": "و فرمایشات او فوراً انجام می‌شود.",
      "usfm": "PSA.147.15"
    },
    {
      "verse": 16,
      "text": "زمین را با لحاف برف می‌پوشاند",
      "usfm": "PSA.147.16"
    },
    {
      "verse": 16,
      "text": "و شبنم را مانند گرد می‌پاشد.",
      "usfm": "PSA.147.16"
    },
    {
      "verse": 17,
      "text": "تگرگ را همچون سنگریزه می‌فرستد",
      "usfm": "PSA.147.17"
    },
    {
      "verse": 17,
      "text": "و کسی تاب تحمّل سرمای آن را ندارد.",
      "usfm": "PSA.147.17"
    },
    {
      "verse": 18,
      "text": "به فرمان او یخها آب می‌شوند، باد می‌وزد",
      "usfm": "PSA.147.18"
    },
    {
      "verse": 18,
      "text": "و آب جاری می‌گردد.",
      "usfm": "PSA.147.18"
    },
    {
      "verse": 19,
      "text": "کلام خود را به یعقوب بیان می‌کند",
      "usfm": "PSA.147.19"
    },
    {
      "verse": 19,
      "text": "و احکام و دستورات خود را به بنی‌اسرائیل می‌دهد.",
      "usfm": "PSA.147.19"
    },
    {
      "verse": 20,
      "text": "با هیچ قوم دیگری چنین رفتار نمی‌کند،",
      "usfm": "PSA.147.20"
    },
    {
      "verse": 20,
      "text": "زیرا آنها احکام او را نمی‌دانند.",
      "usfm": "PSA.147.20"
    },
    {
      "verse": 20,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.147.20"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/147.mp3"
}