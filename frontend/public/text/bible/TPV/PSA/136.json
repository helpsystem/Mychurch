{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 136,
  "verses": [
    {
      "verse": 1,
      "text": "خدا را شکر کنید، زیرا که نیکوست؛",
      "usfm": "PSA.136.1"
    },
    {
      "verse": 1,
      "text": "و محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.1"
    },
    {
      "verse": 2,
      "text": "خدای خدایان را شکر کنید؛",
      "usfm": "PSA.136.2"
    },
    {
      "verse": 2,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.2"
    },
    {
      "verse": 3,
      "text": "خداوند جهانیان را شکر کنید؛",
      "usfm": "PSA.136.3"
    },
    {
      "verse": 3,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.3"
    },
    {
      "verse": 4,
      "text": "او را به‌خاطر معجزاتی که انجام می‌دهد شکر کنید؛",
      "usfm": "PSA.136.4"
    },
    {
      "verse": 4,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.4"
    },
    {
      "verse": 5,
      "text": "او را که با حکمت خود آسمانها را آفرید؛",
      "usfm": "PSA.136.5"
    },
    {
      "verse": 5,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.5"
    },
    {
      "verse": 6,
      "text": "او را که زمین را بر روی آبهای عمیق بنا کرد؛",
      "usfm": "PSA.136.6"
    },
    {
      "verse": 6,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.6"
    },
    {
      "verse": 7,
      "text": "او اجسام نورانی را آفرید؛",
      "usfm": "PSA.136.7"
    },
    {
      "verse": 7,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.7"
    },
    {
      "verse": 8,
      "text": "خورشید را سلطان روز ساخت؛",
      "usfm": "PSA.136.8"
    },
    {
      "verse": 8,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.8"
    },
    {
      "verse": 9,
      "text": "ماه و ستارگان را فرمانروای شب گردانید؛",
      "usfm": "PSA.136.9"
    },
    {
      "verse": 9,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.9"
    },
    {
      "verse": 10,
      "text": "او نخستزادگان مصریان را کشت؛",
      "usfm": "PSA.136.10"
    },
    {
      "verse": 10,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.10"
    },
    {
      "verse": 11,
      "text": "او قوم ‌اسرائیل را از مصر بیرون آورد؛",
      "usfm": "PSA.136.11"
    },
    {
      "verse": 11,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.11"
    },
    {
      "verse": 12,
      "text": "با دست قوی و بازوی قدرتمندش؛",
      "usfm": "PSA.136.12"
    },
    {
      "verse": 12,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.12"
    },
    {
      "verse": 13,
      "text": "او دریای سرخ را شكافت؛",
      "usfm": "PSA.136.13"
    },
    {
      "verse": 13,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.13"
    },
    {
      "verse": 14,
      "text": "و بنی‌اسرائیل را از میانش عبور داد؛",
      "usfm": "PSA.136.14"
    },
    {
      "verse": 14,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.14"
    },
    {
      "verse": 15,
      "text": "فرعون و لشکر او را در آب غرق کرد؛",
      "usfm": "PSA.136.15"
    },
    {
      "verse": 15,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.15"
    },
    {
      "verse": 16,
      "text": "قوم خود را در بیایان رهبری نمود؛",
      "usfm": "PSA.136.16"
    },
    {
      "verse": 16,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.16"
    },
    {
      "verse": 17,
      "text": "پادشاهان مقتدر را از بین برد؛",
      "usfm": "PSA.136.17"
    },
    {
      "verse": 17,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.17"
    },
    {
      "verse": 18,
      "text": "پادشاهان معروف را به قتل رسانید؛",
      "usfm": "PSA.136.18"
    },
    {
      "verse": 18,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.18"
    },
    {
      "verse": 19,
      "text": "سیحون، پادشاه اموریان را کشت؛",
      "usfm": "PSA.136.19"
    },
    {
      "verse": 19,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.19"
    },
    {
      "verse": 20,
      "text": "عوج، پادشاه باشان را از بین برد؛",
      "usfm": "PSA.136.20"
    },
    {
      "verse": 20,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.20"
    },
    {
      "verse": 21,
      "text": "او سرزمین آنها را به قوم خود داد؛",
      "usfm": "PSA.136.21"
    },
    {
      "verse": 21,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.21"
    },
    {
      "verse": 22,
      "text": "او آنها را به اسرائیل، خادم خود داد؛",
      "usfm": "PSA.136.22"
    },
    {
      "verse": 22,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.22"
    },
    {
      "verse": 23,
      "text": "ما را در زمان پریشانی به یاد آورد؛",
      "usfm": "PSA.136.23"
    },
    {
      "verse": 23,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.23"
    },
    {
      "verse": 24,
      "text": "ما را از دست دشمنان رهایی بخشید؛",
      "usfm": "PSA.136.24"
    },
    {
      "verse": 24,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.24"
    },
    {
      "verse": 25,
      "text": "او همهٔ انسانها را روزی می‌دهد؛",
      "usfm": "PSA.136.25"
    },
    {
      "verse": 25,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.25"
    },
    {
      "verse": 26,
      "text": "خدای آسمان را شکر کنید؛",
      "usfm": "PSA.136.26"
    },
    {
      "verse": 26,
      "text": "زیرا محبّت پایدار او ابدی است.",
      "usfm": "PSA.136.26"
    }
  ],
