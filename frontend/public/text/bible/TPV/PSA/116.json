{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 116,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند را دوست دارم،",
      "usfm": "PSA.116.1"
    },
    {
      "verse": 1,
      "text": "زیرا او دعا و التماس مرا می‌شنود.",
      "usfm": "PSA.116.1"
    },
    {
      "verse": 2,
      "text": "او به دعای من گوش می‌دهد،",
      "usfm": "PSA.116.2"
    },
    {
      "verse": 2,
      "text": "پس تا پایان عمرم به درگاهش دعا خواهم كرد.",
      "usfm": "PSA.116.2"
    },
    {
      "verse": 3,
      "text": "خطر مرگ از هر سو مرا احاطه کرد",
      "usfm": "PSA.116.3"
    },
    {
      "verse": 3,
      "text": "و فکر رفتن به گور مرا به وحشت انداخت",
      "usfm": "PSA.116.3"
    },
    {
      "verse": 3,
      "text": "و درد و رنج وجودم را فراگرفت.",
      "usfm": "PSA.116.3"
    },
    {
      "verse": 4,
      "text": "آنگاه به حضور خداوند دعا کردم و گفتم:",
      "usfm": "PSA.116.4"
    },
    {
      "verse": 4,
      "text": "«خداوندا، از تو تمنّا می‌کنم که مرا نجات بده!»",
      "usfm": "PSA.116.4"
    },
    {
      "verse": 5,
      "text": "خداوند نیکو و مهربان است،",
      "usfm": "PSA.116.5"
    },
    {
      "verse": 5,
      "text": "خدای ما بسیار رحیم است.",
      "usfm": "PSA.116.5"
    },
    {
      "verse": 6,
      "text": "خداوند از بینوایان حمایت می‌کند.",
      "usfm": "PSA.116.6"
    },
    {
      "verse": 6,
      "text": "وقتی من در خطر بودم او نجاتم داد.",
      "usfm": "PSA.116.6"
    },
    {
      "verse": 7,
      "text": "ای جان من اکنون آرام باش،",
      "usfm": "PSA.116.7"
    },
    {
      "verse": 7,
      "text": "زیرا خداوند با من مهربان است.",
      "usfm": "PSA.116.7"
    },
    {
      "verse": 8,
      "text": "خداوند مرا از مرگ نجات بخشید",
      "usfm": "PSA.116.8"
    },
    {
      "verse": 8,
      "text": "و اشک را از چشمانم پاک کرد",
      "usfm": "PSA.116.8"
    },
    {
      "verse": 8,
      "text": "و پاهایم را از لغزش نگاه داشت.",
      "usfm": "PSA.116.8"
    },
    {
      "verse": 9,
      "text": "پس تا زنده‌ام",
      "usfm": "PSA.116.9"
    },
    {
      "verse": 9,
      "text": "در حضور خداوند راه خواهم رفت.",
      "usfm": "PSA.116.9"
    },
    {
      "verse": 11,
      "text": "حتّی وقتی به خود گفتم که",
      "usfm": "PSA.116.10+PSA.116.11"
    },
    {
      "verse": 11,
      "text": "من بکلّی نابود شده‌ام و در نهایت ترس گفتم",
      "usfm": "PSA.116.10+PSA.116.11"
    },
    {
      "verse": 11,
      "text": "که بر هیچ‌کس نباید اعتماد کرد،",
      "usfm": "PSA.116.10+PSA.116.11"
    },
    {
      "verse": 11,
      "text": "ایمان خود را حفظ نمودم.",
      "usfm": "PSA.116.10+PSA.116.11"
    },
    {
      "verse": 12,
      "text": "در مقابل تمام احسانهای خداوند",
      "usfm": "PSA.116.12"
    },
    {
      "verse": 12,
      "text": "چه چیز به او تقدیم کنم؟",
      "usfm": "PSA.116.12"
    },
    {
      "verse": 13,
      "text": "پیالهٔ نجات را بر خواهم داشت",
      "usfm": "PSA.116.13"
    },
    {
      "verse": 13,
      "text": "و نام خداوند را سپاس خواهم گفت.",
      "usfm": "PSA.116.13"
    },
    {
      "verse": 14,
      "text": "آنچه را که برای خداوند نذر کرده بودم،",
      "usfm": "PSA.116.14"
    },
    {
      "verse": 14,
      "text": "در حضور همهٔ مردم به او ادا خواهم کرد.",
      "usfm": "PSA.116.14"
    },
    {
      "verse": 15,
      "text": "مرگ مؤمنین",
      "usfm": "PSA.116.15"
    },
    {
      "verse": 15,
      "text": "برای خداوند بسیار ناگوار است.",
      "usfm": "PSA.116.15"
    },
    {
      "verse": 16,
      "text": "خداوندا، من بندهٔ تو،",
      "usfm": "PSA.116.16"
    },
    {
      "verse": 16,
      "text": "پسر تو و فرزند کنیز تو هستم،",
      "usfm": "PSA.116.16"
    },
    {
      "verse": 16,
      "text": "تو مرا از بندهایم رهایی دادی.",
      "usfm": "PSA.116.16"
    },
    {
      "verse": 17,
      "text": "پس قربانی شکرگزاری به پیشگاهت تقدیم خواهم كرد",
      "usfm": "PSA.116.17"
    },
    {
      "verse": 17,
      "text": "و نام تو را ستایش خواهم كرد.",
      "usfm": "PSA.116.17"
    },
    {
      "verse": 19,
      "text": "در معبد بزرگ تو در اورشلیم",
      "usfm": "PSA.116.18+PSA.116.19"
    },
    {
      "verse": 19,
      "text": "و در حضور همهٔ قوم تو",
      "usfm": "PSA.116.18+PSA.116.19"
    },
    {
      "verse": 19,
      "text": "نذرهای خود را به تو ادا خواهم کرد.",
      "usfm": "PSA.116.18+PSA.116.19"
    },
    {
      "verse": 19,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.116.18+PSA.116.19"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/116.mp3"
}