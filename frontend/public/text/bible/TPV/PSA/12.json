{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 12,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، مدد فرما!",
      "usfm": "PSA.12.1"
    },
    {
      "verse": 1,
      "text": "زیرا دیگر اشخاص نیکوکار وجود ندارند",
      "usfm": "PSA.12.1"
    },
    {
      "verse": 1,
      "text": "و انسان وفادار در میان آدمیان یافت نمی‌شود.",
      "usfm": "PSA.12.1"
    },
    {
      "verse": 2,
      "text": "مردم به یکدیگر دروغ می‌گویند",
      "usfm": "PSA.12.2"
    },
    {
      "verse": 2,
      "text": "و با چرب زبانی و ریاکاری با یکدیگر گفت‌وگو می‌کنند.",
      "usfm": "PSA.12.2"
    },
    {
      "verse": 3,
      "text": "خداوندا، زبانهای چرب و نرم را قطع کن",
      "usfm": "PSA.12.3"
    },
    {
      "verse": 3,
      "text": "و اشخاص مغرور و متکبّر را خاموش ساز.",
      "usfm": "PSA.12.3"
    },
    {
      "verse": 4,
      "text": "ایشان می‌گویند: «با زبان خود موفّق خواهیم شد.",
      "usfm": "PSA.12.4"
    },
    {
      "verse": 4,
      "text": "هرچه بخواهیم می‌گوییم",
      "usfm": "PSA.12.4"
    },
    {
      "verse": 4,
      "text": "و هیچ‌کس نمی‌تواند مانع ما شود.»",
      "usfm": "PSA.12.4"
    },
    {
      "verse": 5,
      "text": "خداوند می‌فرماید:",
      "usfm": "PSA.12.5"
    },
    {
      "verse": 5,
      "text": "«چون بر مردم مسکین ظلم شده",
      "usfm": "PSA.12.5"
    },
    {
      "verse": 5,
      "text": "و فریاد و نالهٔ فقیران برخاسته است،",
      "usfm": "PSA.12.5"
    },
    {
      "verse": 5,
      "text": "می‌آیم و امنیّتی را که می‌خواستند به آنها می‌دهم.»",
      "usfm": "PSA.12.5"
    },
    {
      "verse": 6,
      "text": "وعده‌های خداوند قابل اطمینان",
      "usfm": "PSA.12.6"
    },
    {
      "verse": 6,
      "text": "و مانند نقره‌ای که هفت بار در کوره تصفیه شده باشد،",
      "usfm": "PSA.12.6"
    },
    {
      "verse": 6,
      "text": "صاف و بی‌آلایش هستند.",
      "usfm": "PSA.12.6"
    },
    {
      "verse": 8,
      "text": "خداوندا، شریران همه‌جا رخنه کرده‌اند",
      "usfm": "PSA.12.7+PSA.12.8"
    },
    {
      "verse": 8,
      "text": "و شرارت مورد ستایش است!",
      "usfm": "PSA.12.7+PSA.12.8"
    },
    {
      "verse": 8,
      "text": "ما را همیشه در پناه خود نگه‌دار",
      "usfm": "PSA.12.7+PSA.12.8"
    },
    {
      "verse": 8,
      "text": "و از این زمانهٔ شریر محافظت فرما.",
      "usfm": "PSA.12.7+PSA.12.8"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/12.mp3"
}