{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 62,
  "verses": [
    {
      "verse": 1,
      "text": "جان من فقط در حضور خدا آرام می‌شود،",
      "usfm": "PSA.62.1"
    },
    {
      "verse": 1,
      "text": "زیرا نجات من از جانب اوست.",
      "usfm": "PSA.62.1"
    },
    {
      "verse": 2,
      "text": "او یگانه پشتیبان و نجات‌دهندهٔ من است،",
      "usfm": "PSA.62.2"
    },
    {
      "verse": 2,
      "text": "او نگه‌دار من است",
      "usfm": "PSA.62.2"
    },
    {
      "verse": 2,
      "text": "پس هرگز شکست نخواهم خورد.",
      "usfm": "PSA.62.2"
    },
    {
      "verse": 3,
      "text": "تا به کی همگی شما بر مردی هجوم می‌آورید",
      "usfm": "PSA.62.3"
    },
    {
      "verse": 3,
      "text": "که مانند دیوار شکسته است؟",
      "usfm": "PSA.62.3"
    },
    {
      "verse": 4,
      "text": "فکر شما فقط این است که او را از مقامش پایین بیاورید.",
      "usfm": "PSA.62.4"
    },
    {
      "verse": 4,
      "text": "شما دروغ را دوست می‌دارید،",
      "usfm": "PSA.62.4"
    },
    {
      "verse": 4,
      "text": "با زبان خود او را برکت می‌دهید،",
      "usfm": "PSA.62.4"
    },
    {
      "verse": 4,
      "text": "امّا در دلتان او را نفرین می‌کنید.",
      "usfm": "PSA.62.4"
    },
    {
      "verse": 5,
      "text": "من فقط به خدا اعتماد دارم",
      "usfm": "PSA.62.5"
    },
    {
      "verse": 5,
      "text": "و امیدم به اوست.",
      "usfm": "PSA.62.5"
    },
    {
      "verse": 6,
      "text": "او یگانه پشتیبان و نجات‌دهندهٔ من است،",
      "usfm": "PSA.62.6"
    },
    {
      "verse": 6,
      "text": "او نگه‌دار من است،",
      "usfm": "PSA.62.6"
    },
    {
      "verse": 6,
      "text": "پس هرگز شکست نخواهم خورد.",
      "usfm": "PSA.62.6"
    },
    {
      "verse": 7,
      "text": "نجات و عزّت من از خداست.",
      "usfm": "PSA.62.7"
    },
    {
      "verse": 7,
      "text": "او نگهبان توانا",
      "usfm": "PSA.62.7"
    },
    {
      "verse": 7,
      "text": "و پناهگاه من است.",
      "usfm": "PSA.62.7"
    },
    {
      "verse": 8,
      "text": "ای مردم در همهٔ اوقات به خدا توکّل کنید.",
      "usfm": "PSA.62.8"
    },
    {
      "verse": 8,
      "text": "همهٔ مشکلات خود را به او بگویید،",
      "usfm": "PSA.62.8"
    },
    {
      "verse": 8,
      "text": "زیرا او پناهگاه ماست.",
      "usfm": "PSA.62.8"
    },
    {
      "verse": 9,
      "text": "تمام مردم چه کوچک و چه بزرگ، ناچیزند",
      "usfm": "PSA.62.9"
    },
    {
      "verse": 9,
      "text": "و بیش از یک نفس نیستند.",
      "usfm": "PSA.62.9"
    },
    {
      "verse": 9,
      "text": "اگر در ترازو وزن شوند،",
      "usfm": "PSA.62.9"
    },
    {
      "verse": 9,
      "text": "از باد هم سبکترند.",
      "usfm": "PSA.62.9"
    },
    {
      "verse": 10,
      "text": "بر ظلم توکّل نكنید",
      "usfm": "PSA.62.10"
    },
    {
      "verse": 10,
      "text": "و بر آنچه که از راه دزدی به دست آورده‌اید، امید نداشته باشید؛",
      "usfm": "PSA.62.10"
    },
    {
      "verse": 10,
      "text": "و هرچند دارا‌یی شما زیاد شود",
      "usfm": "PSA.62.10"
    },
    {
      "verse": 10,
      "text": "بر آن دل نبندید.",
      "usfm": "PSA.62.10"
    },
    {
      "verse": 11,
      "text": "خداوند بارها فرموده است",
      "usfm": "PSA.62.11"
    },
    {
      "verse": 11,
      "text": "که قدرت در دست اوست.",
      "usfm": "PSA.62.11"
    },
    {
      "verse": 12,
      "text": "ای خداوند، محبّت پایدار نیز از آن توست",
      "usfm": "PSA.62.12"
    },
    {
      "verse": 12,
      "text": "و تو هرکس را مطابق کارهایش پاداش خواهی داد.",
      "usfm": "PSA.62.12"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/62.mp3"
}