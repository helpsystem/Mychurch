{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 5,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، دعای مرا بشنو",
      "usfm": "PSA.5.1"
    },
    {
      "verse": 1,
      "text": "و به زاری من توجّه فرما!",
      "usfm": "PSA.5.1"
    },
    {
      "verse": 2,
      "text": "ای پادشاه و ای خدای من،",
      "usfm": "PSA.5.2"
    },
    {
      "verse": 2,
      "text": "به فریاد من گوش فرا ده.",
      "usfm": "PSA.5.2"
    },
    {
      "verse": 2,
      "text": "من به درگاه تو دعا می‌کنم.",
      "usfm": "PSA.5.2"
    },
    {
      "verse": 3,
      "text": "خداوندا، سحرگاهان آواز زاری مرا می‌شنوی",
      "usfm": "PSA.5.3"
    },
    {
      "verse": 3,
      "text": "و هر صبح به درگاه تو دعا می‌کنم",
      "usfm": "PSA.5.3"
    },
    {
      "verse": 3,
      "text": "و انتظار می‌کشم.",
      "usfm": "PSA.5.3"
    },
    {
      "verse": 4,
      "text": "زیرا تو ای خدا، از شرارت بیزار هستی",
      "usfm": "PSA.5.4"
    },
    {
      "verse": 4,
      "text": "و گناهکاران به بارگاهت راه ندارند.",
      "usfm": "PSA.5.4"
    },
    {
      "verse": 5,
      "text": "متکبّران در پیشگاه تو نخواهند ایستاد",
      "usfm": "PSA.5.5"
    },
    {
      "verse": 5,
      "text": "و از همهٔ شریران نفرت داری.",
      "usfm": "PSA.5.5"
    },
    {
      "verse": 6,
      "text": "دروغگویان را نابود می‌سازی،",
      "usfm": "PSA.5.6"
    },
    {
      "verse": 6,
      "text": "و از مردم قاتل و فریبکار بیزاری.",
      "usfm": "PSA.5.6"
    },
    {
      "verse": 7,
      "text": "امّا به‌خاطر محبّت عظیم تو،",
      "usfm": "PSA.5.7"
    },
    {
      "verse": 7,
      "text": "من می‌توانم به خانهٔ تو داخل شوم",
      "usfm": "PSA.5.7"
    },
    {
      "verse": 7,
      "text": "و در معبد مقدّست،",
      "usfm": "PSA.5.7"
    },
    {
      "verse": 7,
      "text": "تو را با احترام پرستش نمایم.",
      "usfm": "PSA.5.7"
    },
    {
      "verse": 8,
      "text": "خداوندا، دشمنان بسیار دارم،",
      "usfm": "PSA.5.8"
    },
    {
      "verse": 8,
      "text": "مرا به راه راستی و عدالت هدایت نما.",
      "usfm": "PSA.5.8"
    },
    {
      "verse": 9,
      "text": "راستی در دهان ایشان نیست،",
      "usfm": "PSA.5.9"
    },
    {
      "verse": 9,
      "text": "دلهایشان از شرارت پُر است،",
      "usfm": "PSA.5.9"
    },
    {
      "verse": 9,
      "text": "گلوی ایشان مانند گور است",
      "usfm": "PSA.5.9"
    },
    {
      "verse": 9,
      "text": "و زبانی ریاكار دارند.",
      "usfm": "PSA.5.9"
    },
    {
      "verse": 10,
      "text": "خدایا، آنها را به سزای كارهایشان برسان",
      "usfm": "PSA.5.10"
    },
    {
      "verse": 10,
      "text": "و در دام خودشان گرفتارشان کن.",
      "usfm": "PSA.5.10"
    },
    {
      "verse": 10,
      "text": "به‌خاطر سرپیچی‌های زیادشان",
      "usfm": "PSA.5.10"
    },
    {
      "verse": 10,
      "text": "آنها را از بارگاه خود بران،",
      "usfm": "PSA.5.10"
    },
    {
      "verse": 10,
      "text": "زیرا علیه تو شورش نموده‌اند.",
      "usfm": "PSA.5.10"
    },
    {
      "verse": 11,
      "text": "امّا کسانی را که به تو پناه می‌آورند، شاد گردان",
      "usfm": "PSA.5.11"
    },
    {
      "verse": 11,
      "text": "تا برای همیشه از خوشی بسرایند.",
      "usfm": "PSA.5.11"
    },
    {
      "verse": 11,
      "text": "زیرا تو پناهگاه آنان می‌باشی.",
      "usfm": "PSA.5.11"
    },
    {
      "verse": 11,
      "text": "دلهای آنانی که تو را دوست دارند، از خوشی سرشار ساز.",
      "usfm": "PSA.5.11"
    },
    {
      "verse": 12,
      "text": "چون تو ای خداوند، راستان را برکت می‌دهی",
      "usfm": "PSA.5.12"
    },
    {
      "verse": 12,
      "text": "و با سپر محبّت خود از آنان دفاع می‌کنی.",
      "usfm": "PSA.5.12"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/5.mp3"
}