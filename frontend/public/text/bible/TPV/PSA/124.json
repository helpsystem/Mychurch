{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 124,
  "verses": [
    {
      "verse": 1,
      "text": "ای قوم اسرائیل جواب بدهید.",
      "usfm": "PSA.124.1"
    },
    {
      "verse": 1,
      "text": "اگر خداوند با ما نمی‌بود، چه می‌شد؟",
      "usfm": "PSA.124.1"
    },
    {
      "verse": 2,
      "text": "اگر خداوند پشتیبان ما نمی‌بود،",
      "usfm": "PSA.124.2"
    },
    {
      "verse": 2,
      "text": "وقتی دشمنان بر ما حمله کردند،",
      "usfm": "PSA.124.2"
    },
    {
      "verse": 3,
      "text": "آنگاه آنها در خشم و غضب خود",
      "usfm": "PSA.124.3"
    },
    {
      "verse": 3,
      "text": "ما را می‌بلعیدند.",
      "usfm": "PSA.124.3"
    },
    {
      "verse": 4,
      "text": "بعد سیل خروشان ما را با خود می‌برد",
      "usfm": "PSA.124.4"
    },
    {
      "verse": 4,
      "text": "و آب از سرِ ما می‌گذشت",
      "usfm": "PSA.124.4"
    },
    {
      "verse": 5,
      "text": "و در گردابها غرق می‌شدیم.",
      "usfm": "PSA.124.5"
    },
    {
      "verse": 6,
      "text": "خداوند را سپاس باد",
      "usfm": "PSA.124.6"
    },
    {
      "verse": 6,
      "text": "که ما را شکار دندانهای آنها نساخت.",
      "usfm": "PSA.124.6"
    },
    {
      "verse": 7,
      "text": "مانند پرنده‌ای از دام صیاد جستیم،",
      "usfm": "PSA.124.7"
    },
    {
      "verse": 7,
      "text": "دام پاره شد و ما آزاد شدیم.",
      "usfm": "PSA.124.7"
    },
    {
      "verse": 8,
      "text": "خداوندی که آسمان و زمین را آفرید",
      "usfm": "PSA.124.8"
    },
    {
      "verse": 8,
      "text": "مددکار ماست.",
      "usfm": "PSA.124.8"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/124.mp3"
}