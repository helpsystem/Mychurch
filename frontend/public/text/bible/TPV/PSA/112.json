{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 112,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.112.1"
    },
    {
      "verse": 1,
      "text": "خوشا به حال کسی‌که از خداوند می‌ترسد",
      "usfm": "PSA.112.1"
    },
    {
      "verse": 1,
      "text": "و احکام او را با رغبت بجا می‌آورد.",
      "usfm": "PSA.112.1"
    },
    {
      "verse": 2,
      "text": "فرزندان او نیرومند می‌شوند",
      "usfm": "PSA.112.2"
    },
    {
      "verse": 2,
      "text": "و نسل او برکت خواهد یافت.",
      "usfm": "PSA.112.2"
    },
    {
      "verse": 3,
      "text": "خانواده‌اش ثروتمند خواهد شد",
      "usfm": "PSA.112.3"
    },
    {
      "verse": 3,
      "text": "و او تا به ابد کامیاب خواهد بود.",
      "usfm": "PSA.112.3"
    },
    {
      "verse": 4,
      "text": "تاریکی برای آنانی که نیکوکار، بخشنده و عادل هستند،",
      "usfm": "PSA.112.4"
    },
    {
      "verse": 4,
      "text": "روشنایی خواهد گردید.",
      "usfm": "PSA.112.4"
    },
    {
      "verse": 5,
      "text": "کسی‌که دلسوز و قرض‌دهنده باشد",
      "usfm": "PSA.112.5"
    },
    {
      "verse": 5,
      "text": "و کارهای خود را از روی عدل و انصاف انجام دهد، سعادتمند خواهد شد.",
      "usfm": "PSA.112.5"
    },
    {
      "verse": 6,
      "text": "شخص نیکو هرگز ناکام نخواهد شد",
      "usfm": "PSA.112.6"
    },
    {
      "verse": 6,
      "text": "و نام او همیشه به نیکی یاد خواهد شد.",
      "usfm": "PSA.112.6"
    },
    {
      "verse": 7,
      "text": "از خبر بد نخواهد ترسید، زیرا ایمان او قوی است",
      "usfm": "PSA.112.7"
    },
    {
      "verse": 7,
      "text": "و به خداوند اعتماد دارد.",
      "usfm": "PSA.112.7"
    },
    {
      "verse": 8,
      "text": "دل او استوار است و نخواهد ترسید",
      "usfm": "PSA.112.8"
    },
    {
      "verse": 8,
      "text": "و شکست دشمنانش را خواهد دید.",
      "usfm": "PSA.112.8"
    },
    {
      "verse": 9,
      "text": "او با سخاوت به نیازمندان می‌بخشد.",
      "usfm": "PSA.112.9"
    },
    {
      "verse": 9,
      "text": "و خیرخواهی او تا ابد باقی می‌ماند",
      "usfm": "PSA.112.9"
    },
    {
      "verse": 9,
      "text": "و همیشه سربلند و با عزّت خواهد بود.",
      "usfm": "PSA.112.9"
    },
    {
      "verse": 10,
      "text": "شخص شریر این را می‌‌‌بیند و خشمگین می‌شود،",
      "usfm": "PSA.112.10"
    },
    {
      "verse": 10,
      "text": "حرص می‌خورد،",
      "usfm": "PSA.112.10"
    },
    {
      "verse": 10,
      "text": "و امیدش برای همیشه از بین می‌رود.",
      "usfm": "PSA.112.10"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/112.mp3"
}