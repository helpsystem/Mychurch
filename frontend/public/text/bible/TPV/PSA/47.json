{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 47,
  "verses": [
    {
      "verse": 1,
      "text": "ای مردمان جهان دست زنید،",
      "usfm": "PSA.47.1"
    },
    {
      "verse": 1,
      "text": "و با آواز بلند به حضور خدا بسرایید!",
      "usfm": "PSA.47.1"
    },
    {
      "verse": 2,
      "text": "از خداوند، آن قادر متعال باید ترسید",
      "usfm": "PSA.47.2"
    },
    {
      "verse": 2,
      "text": "او پادشاه بزرگی است، بر سراسر جهان پادشاهی می‌کند.",
      "usfm": "PSA.47.2"
    },
    {
      "verse": 3,
      "text": "او ما را بر اقوام جهان پیروز می‌گرداند؛",
      "usfm": "PSA.47.3"
    },
    {
      "verse": 3,
      "text": "و ملّتها را در پیش پای ما به خاک می‌اندازد.",
      "usfm": "PSA.47.3"
    },
    {
      "verse": 4,
      "text": "او این سرزمین را برای سکونت ما انتخاب کرد،",
      "usfm": "PSA.47.4"
    },
    {
      "verse": 4,
      "text": "سرزمینی که موجب افتخار فرزندان یعقوب است، قومی که او آنها را دوست می‌دارد.",
      "usfm": "PSA.47.4"
    },
    {
      "verse": 5,
      "text": "خدا در میان هلهلهٔ شادی",
      "usfm": "PSA.47.5"
    },
    {
      "verse": 5,
      "text": "و با صدای شیپور",
      "usfm": "PSA.47.5"
    },
    {
      "verse": 5,
      "text": "به تخت خود جلوس نمود.",
      "usfm": "PSA.47.5"
    },
    {
      "verse": 6,
      "text": "در ستایش خدا سرود بخوانید،",
      "usfm": "PSA.47.6"
    },
    {
      "verse": 6,
      "text": "برای پادشاه ما سرود نیایش بخوانید.",
      "usfm": "PSA.47.6"
    },
    {
      "verse": 7,
      "text": "خدا پادشاه سراسر جهان است؛",
      "usfm": "PSA.47.7"
    },
    {
      "verse": 7,
      "text": "با سرود او را ستایش کنید.",
      "usfm": "PSA.47.7"
    },
    {
      "verse": 8,
      "text": "خدا بر تخت مقدّس خود نشسته",
      "usfm": "PSA.47.8"
    },
    {
      "verse": 8,
      "text": "و بر مردم جهان حکمرانی می‌کند.",
      "usfm": "PSA.47.8"
    },
    {
      "verse": 9,
      "text": "پادشاهان جهان با قوم خدای ابراهیم",
      "usfm": "PSA.47.9"
    },
    {
      "verse": 9,
      "text": "برای پرستش او جمع می‌شوند،",
      "usfm": "PSA.47.9"
    },
    {
      "verse": 9,
      "text": "زیرا او نیرومندتر از همهٔ لشکرهای دنیا",
      "usfm": "PSA.47.9"
    },
    {
      "verse": 9,
      "text": "و حاکم مطلق جهان است.",
      "usfm": "PSA.47.9"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/47.mp3"
}