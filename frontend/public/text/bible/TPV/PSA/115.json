{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 115,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، به نام تو،",
      "usfm": "PSA.115.1"
    },
    {
      "verse": 1,
      "text": "تنها به نام تو جلال باد، نه به نام ما،",
      "usfm": "PSA.115.1"
    },
    {
      "verse": 1,
      "text": "زیرا تو سرشار از محبّت پایدار و وفا هستی.",
      "usfm": "PSA.115.1"
    },
    {
      "verse": 2,
      "text": "چرا ملّتهای جهان از ما بپرسند:",
      "usfm": "PSA.115.2"
    },
    {
      "verse": 2,
      "text": "«خدای شما کجاست؟»",
      "usfm": "PSA.115.2"
    },
    {
      "verse": 3,
      "text": "خدای ما در آسمانهاست",
      "usfm": "PSA.115.3"
    },
    {
      "verse": 3,
      "text": "و آنچه را که اراده فرماید به عمل می‌آورد.",
      "usfm": "PSA.115.3"
    },
    {
      "verse": 4,
      "text": "خدایان آنها از نقره و طلا",
      "usfm": "PSA.115.4"
    },
    {
      "verse": 4,
      "text": "و ساختهٔ دست بشر هستند.",
      "usfm": "PSA.115.4"
    },
    {
      "verse": 5,
      "text": "آنها دهان دارند، امّا حرف نمی‌زنند،",
      "usfm": "PSA.115.5"
    },
    {
      "verse": 5,
      "text": "چشم دارند، ولی نمی‌بینند.",
      "usfm": "PSA.115.5"
    },
    {
      "verse": 6,
      "text": "گوش دارند، امّا نمی‌شنوند.",
      "usfm": "PSA.115.6"
    },
    {
      "verse": 6,
      "text": "بینی دارند، لیکن نمی‌بویند.",
      "usfm": "PSA.115.6"
    },
    {
      "verse": 7,
      "text": "دست دارند، امّا لمس نمی‌کنند.",
      "usfm": "PSA.115.7"
    },
    {
      "verse": 7,
      "text": "پا دارند، امّا راه نمی‌روند",
      "usfm": "PSA.115.7"
    },
    {
      "verse": 7,
      "text": "و صدایی از گلویشان بیرون نمی‌آید.",
      "usfm": "PSA.115.7"
    },
    {
      "verse": 8,
      "text": "کسانی‌که آنها را ساخته‌اند و همچنین اشخاصی که به آنها اطمینان دارند،",
      "usfm": "PSA.115.8"
    },
    {
      "verse": 8,
      "text": "مانند بُتهایی می‌شوند که ساخته‌اند.",
      "usfm": "PSA.115.8"
    },
    {
      "verse": 9,
      "text": "ای بنی‌اسرائیل، بر خداوند توکّل کنید،",
      "usfm": "PSA.115.9"
    },
    {
      "verse": 9,
      "text": "زیرا او نگهبان و یاور شماست.",
      "usfm": "PSA.115.9"
    },
    {
      "verse": 10,
      "text": "ای کاهنان خدا، بر خداوند توکّل کنید،",
      "usfm": "PSA.115.10"
    },
    {
      "verse": 10,
      "text": "زیرا او نگهبان و یاور شماست.",
      "usfm": "PSA.115.10"
    },
    {
      "verse": 11,
      "text": "ای خداترسان، بر خداوند توکّل کنید،",
      "usfm": "PSA.115.11"
    },
    {
      "verse": 11,
      "text": "زیرا او نگهبان و یاور شماست.",
      "usfm": "PSA.115.11"
    },
    {
      "verse": 12,
      "text": "خداوند به ما توجّه دارد و ما را برکت می‌دهد.",
      "usfm": "PSA.115.12"
    },
    {
      "verse": 12,
      "text": "او بنی‌اسرائیل و تمام کاهنان خدا را",
      "usfm": "PSA.115.12"
    },
    {
      "verse": 12,
      "text": "برکت خواهد داد.",
      "usfm": "PSA.115.12"
    },
    {
      "verse": 13,
      "text": "او همهٔ خداترسان،",
      "usfm": "PSA.115.13"
    },
    {
      "verse": 13,
      "text": "کوچک و بزرگ را، یکسان برکت خواهد داد.",
      "usfm": "PSA.115.13"
    },
    {
      "verse": 14,
      "text": "خداوند نسل شما",
      "usfm": "PSA.115.14"
    },
    {
      "verse": 14,
      "text": "و فرزندانتان را برکت دهد!",
      "usfm": "PSA.115.14"
    },
    {
      "verse": 15,
      "text": "خداوندی که آسمانها و زمین را آفریده است،",
      "usfm": "PSA.115.15"
    },
    {
      "verse": 15,
      "text": "شما را برکت دهد!",
      "usfm": "PSA.115.15"
    },
    {
      "verse": 16,
      "text": "آسمانها از آن خداوند هستند،",
      "usfm": "PSA.115.16"
    },
    {
      "verse": 16,
      "text": "امّا زمین را به انسان بخشیده است.",
      "usfm": "PSA.115.16"
    },
    {
      "verse": 17,
      "text": "مردگان و کسانی‌که به دیار خاموشی می‌روند",
      "usfm": "PSA.115.17"
    },
    {
      "verse": 17,
      "text": "خداوند را ستایش نمی‌کنند.",
      "usfm": "PSA.115.17"
    },
    {
      "verse": 18,
      "text": "امّا ما که زنده هستیم، خداوند را ستایش می‌کنیم",
      "usfm": "PSA.115.18"
    },
    {
      "verse": 18,
      "text": "از اکنون تا به ابد.",
      "usfm": "PSA.115.18"
    },
    {
      "verse": 18,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.115.18"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/115.mp3"
}