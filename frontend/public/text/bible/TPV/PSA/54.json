{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 54,
  "verses": [
    {
      "verse": 1,
      "text": "خدایا، با قدرت خود نجاتم بده",
      "usfm": "PSA.54.1"
    },
    {
      "verse": 1,
      "text": "و با نیروی خود آزادم کن.",
      "usfm": "PSA.54.1"
    },
    {
      "verse": 2,
      "text": "خدایا، دعای مرا بشنو",
      "usfm": "PSA.54.2"
    },
    {
      "verse": 2,
      "text": "و به سخنان من گوش بده،",
      "usfm": "PSA.54.2"
    },
    {
      "verse": 3,
      "text": "زیرا اشخاص مغرور علیه من برخاسته‌اند",
      "usfm": "PSA.54.3"
    },
    {
      "verse": 3,
      "text": "و مردمان ظالم قصد کشتن مرا دارند.",
      "usfm": "PSA.54.3"
    },
    {
      "verse": 3,
      "text": "آنان به خدا توجّه ندارند.",
      "usfm": "PSA.54.3"
    },
    {
      "verse": 4,
      "text": "امّا خدا مددکار من است",
      "usfm": "PSA.54.4"
    },
    {
      "verse": 4,
      "text": "و خداوند حافظ جان من می‌باشد.",
      "usfm": "PSA.54.4"
    },
    {
      "verse": 5,
      "text": "او دشمنانم را به سزای گناهشان می‌رساند.",
      "usfm": "PSA.54.5"
    },
    {
      "verse": 5,
      "text": "به‌خاطر وفاداری خود، به زندگی آنها خاتمه خواهد داد.",
      "usfm": "PSA.54.5"
    },
    {
      "verse": 6,
      "text": "خداوندا، با کمال خوشی به پیشگاه تو قربانی تقدیم خواهم كرد.",
      "usfm": "PSA.54.6"
    },
    {
      "verse": 6,
      "text": "تو را سپاس خواهم گفت",
      "usfm": "PSA.54.6"
    },
    {
      "verse": 6,
      "text": "زیرا نیكو هستی.",
      "usfm": "PSA.54.6"
    },
    {
      "verse": 7,
      "text": "تو مرا از تمام مشکلاتم نجات داده‌ای،",
      "usfm": "PSA.54.7"
    },
    {
      "verse": 7,
      "text": "و من شکست دشمنانم را با چشمانم دیده‌ام.",
      "usfm": "PSA.54.7"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/54.mp3"
}