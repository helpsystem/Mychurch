{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 102,
  "verses": [
    {
      "verse": 1,
      "text": "خداوندا، دعایم را بشنو",
      "usfm": "PSA.102.1"
    },
    {
      "verse": 1,
      "text": "و به فریاد من برس.",
      "usfm": "PSA.102.1"
    },
    {
      "verse": 2,
      "text": "در روزهای سختی از من روی متاب.",
      "usfm": "PSA.102.2"
    },
    {
      "verse": 2,
      "text": "به من گوش بده",
      "usfm": "PSA.102.2"
    },
    {
      "verse": 2,
      "text": "و چون تو را بخوانم،",
      "usfm": "PSA.102.2"
    },
    {
      "verse": 2,
      "text": "دعایم را هرچه زودتر مستجاب فرما.",
      "usfm": "PSA.102.2"
    },
    {
      "verse": 3,
      "text": "زیرا روزهای عمرم مانند دود برباد می‌رود",
      "usfm": "PSA.102.3"
    },
    {
      "verse": 3,
      "text": "و استخوانهایم مانند آتش می‌‌سوزد.",
      "usfm": "PSA.102.3"
    },
    {
      "verse": 4,
      "text": "دل من شکسته و مثل کاه خشک و پژمرده شده است.",
      "usfm": "PSA.102.4"
    },
    {
      "verse": 4,
      "text": "اشتها و میل به غذا ندارم.",
      "usfm": "PSA.102.4"
    },
    {
      "verse": 5,
      "text": "از بس ناله کرده‌ام،",
      "usfm": "PSA.102.5"
    },
    {
      "verse": 5,
      "text": "در بدنم فقط پوست و استخوان باقی مانده است.",
      "usfm": "PSA.102.5"
    },
    {
      "verse": 6,
      "text": "مثل مرغ وحشی در صحرا",
      "usfm": "PSA.102.6"
    },
    {
      "verse": 6,
      "text": "و مانند جغد در خرابه‌ها به سر می‌برم.",
      "usfm": "PSA.102.6"
    },
    {
      "verse": 7,
      "text": "خوابم نمی‌برد،",
      "usfm": "PSA.102.7"
    },
    {
      "verse": 7,
      "text": "مانند پرنده‌ای بر پشت‌بام، تنها مانده‌ام.",
      "usfm": "PSA.102.7"
    },
    {
      "verse": 8,
      "text": "دشمنانم هر روز مرا سرزنش می‌کنند",
      "usfm": "PSA.102.8"
    },
    {
      "verse": 8,
      "text": "و مسخره‌كنندگانم مرا لعنت می‌نمایند.",
      "usfm": "PSA.102.8"
    },
    {
      "verse": 10,
      "text": "به‌خاطر خشم و غضب تو،",
      "usfm": "PSA.102.9+PSA.102.10"
    },
    {
      "verse": 10,
      "text": "به جای نان، خاکستر می‌خورم",
      "usfm": "PSA.102.9+PSA.102.10"
    },
    {
      "verse": 10,
      "text": "و اشکهایم با آبی که می‌نوشم، آمیخته‌اند،",
      "usfm": "PSA.102.9+PSA.102.10"
    },
    {
      "verse": 10,
      "text": "زیرا تو مرا بلند كرده و بر زمین زدی.",
      "usfm": "PSA.102.9+PSA.102.10"
    },
    {
      "verse": 11,
      "text": "عمرم مانند سایه‌های غروب به سرعت رو به زوال است",
      "usfm": "PSA.102.11"
    },
    {
      "verse": 11,
      "text": "و همچون گیاه پژمرده می‌شوم.",
      "usfm": "PSA.102.11"
    },
    {
      "verse": 12,
      "text": "امّا تاج و تخت تو ای خداوند، ازلی و ابدی است",
      "usfm": "PSA.102.12"
    },
    {
      "verse": 12,
      "text": "و تمام نسلهای بشر نام تو را به یاد خواهند آورد.",
      "usfm": "PSA.102.12"
    },
    {
      "verse": 13,
      "text": "می‌دانم که تو خواهی آمد و بر صهیون رحم خواهی كرد",
      "usfm": "PSA.102.13"
    },
    {
      "verse": 13,
      "text": "و اكنون وقت آن است تا وعده‌ای را که داده بودی، عملی کنی،",
      "usfm": "PSA.102.13"
    },
    {
      "verse": 13,
      "text": "و رحمت خود را نشان بدهی.",
      "usfm": "PSA.102.13"
    },
    {
      "verse": 14,
      "text": "بندگان تو آن را دوست می‌دارند،",
      "usfm": "PSA.102.14"
    },
    {
      "verse": 14,
      "text": "گرچه ویرانه گشته؛",
      "usfm": "PSA.102.14"
    },
    {
      "verse": 14,
      "text": "نسبت به آن رحمت می‌دارند،",
      "usfm": "PSA.102.14"
    },
    {
      "verse": 14,
      "text": "گرچه خرابه گشته.",
      "usfm": "PSA.102.14"
    },
    {
      "verse": 15,
      "text": "ملل جهان از نام خداوند،",
      "usfm": "PSA.102.15"
    },
    {
      "verse": 15,
      "text": "و پادشاهان روی زمین، از عظمت و جلال او خواهند ترسید.",
      "usfm": "PSA.102.15"
    },
    {
      "verse": 16,
      "text": "هنگامی‌که خداوند صهیون را دوباره آباد ‌کند،",
      "usfm": "PSA.102.16"
    },
    {
      "verse": 16,
      "text": "جلال و شکوه او آشكار خواهد شد.",
      "usfm": "PSA.102.16"
    },
    {
      "verse": 17,
      "text": "به زاریِ بیچارگان گوش خواهد داد",
      "usfm": "PSA.102.17"
    },
    {
      "verse": 17,
      "text": "و دعای ایشان را اجابت خواهد كرد.",
      "usfm": "PSA.102.17"
    },
    {
      "verse": 18,
      "text": "این را برای نسلهای آینده بنویسید تا از کارهای خداوند آگاه شوند",
      "usfm": "PSA.102.18"
    },
    {
      "verse": 18,
      "text": "و کسانی‌که هنوز به دنیا نیامده‌اند، او را بستایند.",
      "usfm": "PSA.102.18"
    },
    {
      "verse": 19,
      "text": "خداوند از جایگاه عالی و مقدّس خود در آسمان",
      "usfm": "PSA.102.19"
    },
    {
      "verse": 19,
      "text": "به زمین نظر افکنده است.",
      "usfm": "PSA.102.19"
    },
    {
      "verse": 20,
      "text": "ناله‌های زندانیان را شنید",
      "usfm": "PSA.102.20"
    },
    {
      "verse": 20,
      "text": "و آنهایی را که محکوم به مرگ بودند، رهایی بخشید.",
      "usfm": "PSA.102.20"
    },
    {
      "verse": 21,
      "text": "در نتیجه نام خداوند در صهیون ذکر خواهد گردید",
      "usfm": "PSA.102.21"
    },
    {
      "verse": 21,
      "text": "و در اورشلیم او را خواهند پرستید،",
      "usfm": "PSA.102.21"
    },
    {
      "verse": 22,
      "text": "وقتی همهٔ اقوام و پادشاهان جهان با هم جمع شوند",
      "usfm": "PSA.102.22"
    },
    {
      "verse": 22,
      "text": "و او را پرستش نمایند.",
      "usfm": "PSA.102.22"
    },
    {
      "verse": 23,
      "text": "خداوند مرا در جوانی ضعیف و ناتوان ساخت",
      "usfm": "PSA.102.23"
    },
    {
      "verse": 23,
      "text": "و عمرم را کوتاه کرد.",
      "usfm": "PSA.102.23"
    },
    {
      "verse": 24,
      "text": "ای خدا نگذار که اکنون بمیرم،",
      "usfm": "PSA.102.24"
    },
    {
      "verse": 24,
      "text": "قبل از آنکه به پیری برسم.",
      "usfm": "PSA.102.24"
    },
    {
      "verse": 24,
      "text": "ای خدا، تو تا به ابد زنده هستی",
      "usfm": "PSA.102.24"
    },
    {
      "verse": 25,
      "text": "در ابتدا زمین را آفریدی",
      "usfm": "PSA.102.25"
    },
    {
      "verse": 25,
      "text": "و آسمانها کار دستهای توست.",
      "usfm": "PSA.102.25"
    },
    {
      "verse": 26,
      "text": "آنها از میان خواهند رفت،",
      "usfm": "PSA.102.26"
    },
    {
      "verse": 26,
      "text": "امّا تو باقی خواهی ماند.",
      "usfm": "PSA.102.26"
    },
    {
      "verse": 26,
      "text": "همهٔ آنها همچون لباس، کُهنه خواهند شد",
      "usfm": "PSA.102.26"
    },
    {
      "verse": 26,
      "text": "و تو آنها را مانند ردا عوض خواهی كرد و دور خواهی انداخت و نابود خواهند شد.",
      "usfm": "PSA.102.26"
    },
    {
      "verse": 27,
      "text": "امّا تو همیشه همان هستی",
      "usfm": "PSA.102.27"
    },
    {
      "verse": 27,
      "text": "و عمر تو، پایانی نخواهد داشت.",
      "usfm": "PSA.102.27"
    },
    {
      "verse": 28,
      "text": "فرزندان ما، در پناه تو در امان هستند",
      "usfm": "PSA.102.28"
    },
    {
      "verse": 28,
      "text": "و در زیر سایهٔ حمایت تو،",
      "usfm": "PSA.102.28"
    },
    {
      "verse": 28,
      "text": "نسل آنها پایدار خواهد بود.",
      "usfm": "PSA.102.28"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/102.mp3"
}