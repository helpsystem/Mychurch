{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 65,
  "verses": [
    {
      "verse": 1,
      "text": "خدایا، تو در صهیون شایستهٔ ستایش هستی",
      "usfm": "PSA.65.1"
    },
    {
      "verse": 1,
      "text": "و ما آنچه را که نذر کرده‌ایم ادا خواهیم كرد.",
      "usfm": "PSA.65.1"
    },
    {
      "verse": 3,
      "text": "چون تو دعاها را مستجاب می‌فرمایی،",
      "usfm": "PSA.65.2+PSA.65.3"
    },
    {
      "verse": 3,
      "text": "همهٔ مردم به‌خاطر گناهانشان",
      "usfm": "PSA.65.2+PSA.65.3"
    },
    {
      "verse": 3,
      "text": "نزد تو خواهند آمد.",
      "usfm": "PSA.65.2+PSA.65.3"
    },
    {
      "verse": 3,
      "text": "گناهان ما بر ما چیره گشته است،",
      "usfm": "PSA.65.2+PSA.65.3"
    },
    {
      "verse": 3,
      "text": "امّا تو ما را می‌بخشی.",
      "usfm": "PSA.65.2+PSA.65.3"
    },
    {
      "verse": 4,
      "text": "خوشا به حال کسانی‌که تو آنان را برگزیده‌ای",
      "usfm": "PSA.65.4"
    },
    {
      "verse": 4,
      "text": "تا به پیشگاه تو بیایند و در جایگاه مقدّس تو ساکن شوند.",
      "usfm": "PSA.65.4"
    },
    {
      "verse": 4,
      "text": "ما از تمام چیزهای نیکوی خانهٔ تو",
      "usfm": "PSA.65.4"
    },
    {
      "verse": 4,
      "text": "و برکات معبد تو بهره‌مند خواهیم شد.",
      "usfm": "PSA.65.4"
    },
    {
      "verse": 5,
      "text": "ای خدایی که نجات‌دهندهٔ ما هستی،",
      "usfm": "PSA.65.5"
    },
    {
      "verse": 5,
      "text": "تو با کارهای عادلانه و عجیب ما را نجات می‌دهی.",
      "usfm": "PSA.65.5"
    },
    {
      "verse": 5,
      "text": "تو امید مردم سراسر جهان هستی.",
      "usfm": "PSA.65.5"
    },
    {
      "verse": 6,
      "text": "تو با قدرت خود کوهها را بنا نمودی",
      "usfm": "PSA.65.6"
    },
    {
      "verse": 6,
      "text": "و نیروی عظیم خود را نشان دادی.",
      "usfm": "PSA.65.6"
    },
    {
      "verse": 7,
      "text": "تو تلاطم دریاها",
      "usfm": "PSA.65.7"
    },
    {
      "verse": 7,
      "text": "و خروش امواج",
      "usfm": "PSA.65.7"
    },
    {
      "verse": 7,
      "text": "و شورش آدمیان را آرام می‌سازی.",
      "usfm": "PSA.65.7"
    },
    {
      "verse": 8,
      "text": "ساکنان سراسر زمین",
      "usfm": "PSA.65.8"
    },
    {
      "verse": 8,
      "text": "از کارهای عجیب تو حیرانند",
      "usfm": "PSA.65.8"
    },
    {
      "verse": 8,
      "text": "و کارهای تو از یک سوی زمین",
      "usfm": "PSA.65.8"
    },
    {
      "verse": 8,
      "text": "تا آن سوی دیگر آن شادمانی می‌آفریند.",
      "usfm": "PSA.65.8"
    },
    {
      "verse": 9,
      "text": "باران را بر زمین می‌فرستی و از آن مراقبت می‌کنی",
      "usfm": "PSA.65.9"
    },
    {
      "verse": 9,
      "text": "تا آن را سیراب و حاصلخیز کند.",
      "usfm": "PSA.65.9"
    },
    {
      "verse": 9,
      "text": "رودخانه‌ها را پُر آب می‌سازی",
      "usfm": "PSA.65.9"
    },
    {
      "verse": 9,
      "text": "و زمین را با غلاّت بارور می‌گردانی.",
      "usfm": "PSA.65.9"
    },
    {
      "verse": 10,
      "text": "باران فراوان بر زمین می‌فرستی",
      "usfm": "PSA.65.10"
    },
    {
      "verse": 10,
      "text": "و با بارانهای سیل‌آسا",
      "usfm": "PSA.65.10"
    },
    {
      "verse": 10,
      "text": "زمین را نرم و هموار می‌کنی",
      "usfm": "PSA.65.10"
    },
    {
      "verse": 10,
      "text": "تا نباتات از زمین برویند.",
      "usfm": "PSA.65.10"
    },
    {
      "verse": 11,
      "text": "لطف تو، حاصل فراوان به بار آورده",
      "usfm": "PSA.65.11"
    },
    {
      "verse": 11,
      "text": "و سراسر زمین از نعمات تو لبریز است.",
      "usfm": "PSA.65.11"
    },
    {
      "verse": 12,
      "text": "چمنزارها پُر از گلّه",
      "usfm": "PSA.65.12"
    },
    {
      "verse": 12,
      "text": "و دامنهٔ کوهها، سرشار از شادی است.",
      "usfm": "PSA.65.12"
    },
    {
      "verse": 13,
      "text": "مزارع پوشیده از گوسفندان است",
      "usfm": "PSA.65.13"
    },
    {
      "verse": 13,
      "text": "و دشتها از غلّه لبریز هستند.",
      "usfm": "PSA.65.13"
    },
    {
      "verse": 13,
      "text": "همه از خوشی فریاد می‌زنند و با هم سرود می‌خوانند.",
      "usfm": "PSA.65.13"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/65.mp3"
}