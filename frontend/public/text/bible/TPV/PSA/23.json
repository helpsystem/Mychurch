{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 23,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند شبان من است.",
      "usfm": "PSA.23.1"
    },
    {
      "verse": 1,
      "text": "محتاج به هیچ چیز نخواهم بود.",
      "usfm": "PSA.23.1"
    },
    {
      "verse": 2,
      "text": "در چمنزارهای سرسبز مرا می‌خواباند.",
      "usfm": "PSA.23.2"
    },
    {
      "verse": 2,
      "text": "در کنار آبهای آرام مرا رهبری می‌کند.",
      "usfm": "PSA.23.2"
    },
    {
      "verse": 3,
      "text": "جان تازه‌ای به من می‌بخشد",
      "usfm": "PSA.23.3"
    },
    {
      "verse": 3,
      "text": "و به‌خاطر نام خود، مرا به راه راست هدایت می‌نماید.",
      "usfm": "PSA.23.3"
    },
    {
      "verse": 4,
      "text": "حتّی هنگام گذشتن از درّهٔ تاریک مرگ",
      "usfm": "PSA.23.4"
    },
    {
      "verse": 4,
      "text": "از چیزی نمی‌ترسم،",
      "usfm": "PSA.23.4"
    },
    {
      "verse": 4,
      "text": "زیرا تو همراه من هستی.",
      "usfm": "PSA.23.4"
    },
    {
      "verse": 4,
      "text": "عصا و چوبدستی تو مرا حمایت خواهد کرد.",
      "usfm": "PSA.23.4"
    },
    {
      "verse": 5,
      "text": "سفره‌ای برای من در حضور دشمنانم می‌گسترانی",
      "usfm": "PSA.23.5"
    },
    {
      "verse": 5,
      "text": "و مرا چون مهمانی عزیز در این ضیافت می‌پذیری",
      "usfm": "PSA.23.5"
    },
    {
      "verse": 5,
      "text": "و جام مرا لبریز می‌گردانی.",
      "usfm": "PSA.23.5"
    },
    {
      "verse": 6,
      "text": "اطمینان دارم که تمام عمرم به من لطف و محبّت خواهی نمود،",
      "usfm": "PSA.23.6"
    },
    {
      "verse": 6,
      "text": "و تا زمانی که زنده هستم، در خانهٔ تو ساکن خواهم بود.",
      "usfm": "PSA.23.6"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/23.mp3"
}