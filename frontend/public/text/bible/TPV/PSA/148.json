{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 148,
  "verses": [
    {
      "verse": 1,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.148.1"
    },
    {
      "verse": 1,
      "text": "خداوند را از آسمانها",
      "usfm": "PSA.148.1"
    },
    {
      "verse": 1,
      "text": "و از عرش اعلی ستایش کنید.",
      "usfm": "PSA.148.1"
    },
    {
      "verse": 2,
      "text": "ای فرشتگان او",
      "usfm": "PSA.148.2"
    },
    {
      "verse": 2,
      "text": "و ای لشکرهای آسمانی او را ستایش کنید.",
      "usfm": "PSA.148.2"
    },
    {
      "verse": 3,
      "text": "ای آفتاب و ای مهتاب،",
      "usfm": "PSA.148.3"
    },
    {
      "verse": 3,
      "text": "و ای ستارگان درخشان، او را ستایش کنید.",
      "usfm": "PSA.148.3"
    },
    {
      "verse": 4,
      "text": "ای آسمانها و ای آبهای بالای آسمان،",
      "usfm": "PSA.148.4"
    },
    {
      "verse": 4,
      "text": "او را ستایش کنید.",
      "usfm": "PSA.148.4"
    },
    {
      "verse": 5,
      "text": "همهٔ اینها خداوند را ستایش کنند،",
      "usfm": "PSA.148.5"
    },
    {
      "verse": 5,
      "text": "زیرا که به فرمان او آفریده شدند.",
      "usfm": "PSA.148.5"
    },
    {
      "verse": 6,
      "text": "او همهٔ آنها را تا به ابد استوار ساخت",
      "usfm": "PSA.148.6"
    },
    {
      "verse": 6,
      "text": "و هرگز تغییر نخواهند کرد.",
      "usfm": "PSA.148.6"
    },
    {
      "verse": 7,
      "text": "ای نهنگها و ای تمام اعماق اقیانوسها،",
      "usfm": "PSA.148.7"
    },
    {
      "verse": 7,
      "text": "او را ستایش کنید.",
      "usfm": "PSA.148.7"
    },
    {
      "verse": 8,
      "text": "ای آتش و تگرگ و برف و مه و توفان که مطیع فرمان او هستید،",
      "usfm": "PSA.148.8"
    },
    {
      "verse": 8,
      "text": "او را ستایش کنید.",
      "usfm": "PSA.148.8"
    },
    {
      "verse": 9,
      "text": "ای کوهها و تپّه‏ها",
      "usfm": "PSA.148.9"
    },
    {
      "verse": 9,
      "text": "و درختان میوه‌دار و ای سروهای بلند،",
      "usfm": "PSA.148.9"
    },
    {
      "verse": 10,
      "text": "ای حیوانات وحشی و اهلی،",
      "usfm": "PSA.148.10"
    },
    {
      "verse": 10,
      "text": "ای خزندگان و پرندگان، او را ستایش کنید.",
      "usfm": "PSA.148.10"
    },
    {
      "verse": 11,
      "text": "ای پادشاهان، ای مردم،",
      "usfm": "PSA.148.11"
    },
    {
      "verse": 11,
      "text": "شاهزادگان و فرمانروایان،",
      "usfm": "PSA.148.11"
    },
    {
      "verse": 12,
      "text": "ای جوانان و ای دوشیزگان،",
      "usfm": "PSA.148.12"
    },
    {
      "verse": 12,
      "text": "پیر مردان و کودکان، خداوند را ستایش کنید.",
      "usfm": "PSA.148.12"
    },
    {
      "verse": 13,
      "text": "همه با هم نام خداوند را ستایش کنید،",
      "usfm": "PSA.148.13"
    },
    {
      "verse": 13,
      "text": "زیرا فقط نام او متعال،",
      "usfm": "PSA.148.13"
    },
    {
      "verse": 13,
      "text": "و شکوه و جلال او بالاتر از زمین و آسمان است.",
      "usfm": "PSA.148.13"
    },
    {
      "verse": 14,
      "text": "او قوم خود یعنی بنی‌اسرائیل را",
      "usfm": "PSA.148.14"
    },
    {
      "verse": 14,
      "text": "قوّت و توانایی بخشید،",
      "usfm": "PSA.148.14"
    },
    {
      "verse": 14,
      "text": "او مایهٔ افتخار مقدّسان می‌باشد.",
      "usfm": "PSA.148.14"
    },
    {
      "verse": 14,
      "text": "خداوند را سپاس باد!",
      "usfm": "PSA.148.14"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/148.mp3"
}