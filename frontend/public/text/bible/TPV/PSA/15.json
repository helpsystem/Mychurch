{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 15,
  "verses": [
    {
      "verse": 1,
      "text": "ای خداوند، چه کسی به خیمهٔ مقدّس تو وارد خواهد شد؟",
      "usfm": "PSA.15.1"
    },
    {
      "verse": 1,
      "text": "چه کسی در کوه مقدّس تو عبادت خواهد کرد؟",
      "usfm": "PSA.15.1"
    },
    {
      "verse": 2,
      "text": "کسی‌که بی‌عیب، نیكوکار، راستگو و صمیمی باشد.",
      "usfm": "PSA.15.2"
    },
    {
      "verse": 3,
      "text": "غیبت ننماید،",
      "usfm": "PSA.15.3"
    },
    {
      "verse": 3,
      "text": "در حق دوستان خود بدی نکرده",
      "usfm": "PSA.15.3"
    },
    {
      "verse": 3,
      "text": "و به تهمت‌ها گوش ندهد.",
      "usfm": "PSA.15.3"
    },
    {
      "verse": 4,
      "text": "گناهکاران را حقیر شمارد",
      "usfm": "PSA.15.4"
    },
    {
      "verse": 4,
      "text": "و نیکوکاران را احترام گذارد،",
      "usfm": "PSA.15.4"
    },
    {
      "verse": 4,
      "text": "به قول خود وفا کند",
      "usfm": "PSA.15.4"
    },
    {
      "verse": 4,
      "text": "هرچند به ضررش باشد،",
      "usfm": "PSA.15.4"
    },
    {
      "verse": 5,
      "text": "از رباخواری پرهیز نماید",
      "usfm": "PSA.15.5"
    },
    {
      "verse": 5,
      "text": "و با رشوه گرفتن، علیه مردم بی‌گناه شهادت ندهد.",
      "usfm": "PSA.15.5"
    },
    {
      "verse": 5,
      "text": "کسانی‌که اینها را انجام دهند، همیشه استوار خواهند بود.",
      "usfm": "PSA.15.5"
    }
  ],
