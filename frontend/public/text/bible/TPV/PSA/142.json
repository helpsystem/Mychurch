{
  "translation": "TPV",
  "book": "PSA",
  "chapter": 142,
  "verses": [
    {
      "verse": 1,
      "text": "نزد خداوند فریاد می‌زنم",
      "usfm": "PSA.142.1"
    },
    {
      "verse": 1,
      "text": "و با التماس از او کمک می‌طلبم.",
      "usfm": "PSA.142.1"
    },
    {
      "verse": 2,
      "text": "شکایات خود را به پیشگاه او عرض می‌کنم",
      "usfm": "PSA.142.2"
    },
    {
      "verse": 2,
      "text": "و مشکلاتم را برایش بیان می‌نمایم.",
      "usfm": "PSA.142.2"
    },
    {
      "verse": 3,
      "text": "وقتی طاقت من تمام شود،",
      "usfm": "PSA.142.3"
    },
    {
      "verse": 3,
      "text": "تو می‌دانی که چه باید بکنم.",
      "usfm": "PSA.142.3"
    },
    {
      "verse": 3,
      "text": "دشمنان در سر راه من",
      "usfm": "PSA.142.3"
    },
    {
      "verse": 3,
      "text": "دام گسترده‏اند.",
      "usfm": "PSA.142.3"
    },
    {
      "verse": 4,
      "text": "وقتی به اطرافم نگاه می‌کنم،",
      "usfm": "PSA.142.4"
    },
    {
      "verse": 4,
      "text": "کسی را نمی‌بینم که به کمکم بیاید",
      "usfm": "PSA.142.4"
    },
    {
      "verse": 4,
      "text": "و کسی به من توجّه نمی‌کند.",
      "usfm": "PSA.142.4"
    },
    {
      "verse": 5,
      "text": "خداوندا، برای کمک به درگاه تو رو می‌آورم،",
      "usfm": "PSA.142.5"
    },
    {
      "verse": 5,
      "text": "زیرا تو یگانه پشتیبان",
      "usfm": "PSA.142.5"
    },
    {
      "verse": 5,
      "text": "و همه‌چیز من در این زندگی هستی.",
      "usfm": "PSA.142.5"
    },
    {
      "verse": 6,
      "text": "به فریاد من گوش بده،",
      "usfm": "PSA.142.6"
    },
    {
      "verse": 6,
      "text": "زیرا که درمانده‌ام.",
      "usfm": "PSA.142.6"
    },
    {
      "verse": 6,
      "text": "مرا از دست دشمنان نجات بده،",
      "usfm": "PSA.142.6"
    },
    {
      "verse": 6,
      "text": "زیرا آنها از من بسیار قویترند.",
      "usfm": "PSA.142.6"
    },
    {
      "verse": 7,
      "text": "مرا از این بُن‌بست و پریشانی آزاد کن تا تو را ستایش كنم.",
      "usfm": "PSA.142.7"
    },
    {
      "verse": 7,
      "text": "آنگاه به‌خاطر نیكویی كه به من كرده‏ای،",
      "usfm": "PSA.142.7"
    },
    {
      "verse": 7,
      "text": "نیكوکاران مرا احاطه خواهند كرد.",
      "usfm": "PSA.142.7"
    }
  ],
  "audio": "https://webdav.hidrive.ionos.com/users/adminchurch/mychurch/bible/audio/TPV/PSA/142.mp3"
}