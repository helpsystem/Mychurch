  "chapter": 133,
  "verses": [
    {
      "verse": 1,
      "text": "چه زیبا و دلپسند است",
      "usfm": "PSA.133.1"
    },
    {
      "verse": 1,
      "text": "که مؤمنین با اتّحاد دور هم جمع شوند.",
      "usfm": "PSA.133.1"
    },
    {
      "verse": 2,
      "text": "مانند روغن خُوشبویی است که بر سر هارون ریخته شده",
      "usfm": "PSA.133.2"
    },
    {
      "verse": 2,
      "text": "و بر ریش و سپس بر ردایش می‌چکد.",
      "usfm": "PSA.133.2"
    },
    {
      "verse": 3,
      "text": "اتّحاد مانند شبنم بر کوه حرمون است که بر کوه صهیون فرو می‌ریزد.",
      "usfm": "PSA.133.3"
    },
    {
      "verse": 3,
      "text": "زیرا خداوند برکت خود را،",
      "usfm": "PSA.133.3"
    },
    {
      "verse": 3,
      "text": "یعنی زندگی‌ای را که پایانی ندارد، در آنجا عطا خواهد کرد.",
      "usfm": "PSA.133.3"
    }
  ],
