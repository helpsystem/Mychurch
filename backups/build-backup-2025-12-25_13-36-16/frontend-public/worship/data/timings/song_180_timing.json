    {
      "line": "Pre-Chorus2",
      "start": 164.86,
      "end": 168.3,
      "words": 1
    },
    {
      "line": "ستایـ[Em]ـش بر خدایـ[F]ـی که جفا د[G]ید و وفا کـ[Am]ـرد",
      "start": 169.8,
      "end": 186.99,
      "words": 9
    },
    {
      "line": "جهان ر[Em]ا از گناهـ[F]ـان پاک و از[G] غم ها رها کـ[Am]ـرد",
