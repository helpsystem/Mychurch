      "start": 37.95,
      "end": 41.39,
      "words": 1
    },
    {
      "line": "جلال بـ[Em]ـر نامت ای خـ[F]ـورشید تابـا[G]ن درخشـ[Am]ـان",
      "start": 42.89,
      "end": 60.39,
      "words": 7
    },
    {
      "line": "تو ای آ[Em]رامی د[G]ل ، قوت جـ[F]ـان ، نور ایمـ[Am]ـان",
      "start": 61.89,
      "end": 78.77,
