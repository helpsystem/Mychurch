    {
      "line": "کدام عـ[Dm]ـاشق",
      "start": 83.65,
      "end": 88.34,
      "words": 2
    },
    {
      "line": "صلیب[Am] عشق را بـ[G]ـر دوش برد[F]اشـت[Am]",
      "start": 89.84,
      "end": 102.97,
      "words": 6
    },
    {
      "line": "حیات[Am] جاودان بـ[G]ـر تو ستم بـ[Em]ـر خود روا دا[Am]شت",
      "start": 104.47,
      "end": 121.97,
      "words": 9
    },
    {
      "line": "کدام عـ[Dm]ـاشق",
      "start": 123.47,
      "end": 128.16,
      "words": 2
    },
    {
      "line": "به راه[Am] عشق فدیـ[G]ـه نقد جان کـ[F]ـرد[Am]",
      "start": 129.66,
      "end": 143.73,
      "words": 7
    },
    {
      "line": "کجا جـ[Am]ـبران این عـ[G]ـشق عظیمـ[Em]ـش را توان کـ[Am]ـرد",
      "start": 145.23,
      "end": 163.36,
      "words": 8
