  "issues": [
    {
      "id": "CODE-001",
      "title": "Bible Reader API missing translation fallback",
      "severity": "high",
      "category": "code_defect",
      "status": "resolved",
      "created": "2025-11-04T09:00:00Z",
      "resolved": "2025-11-04T09:12:00Z",
      "affected_tests": ["TEST-003", "TEST-006"],
      "affected_features": [
        "Bible Reader"
      ],
      "repro_steps": [
        "Call API: GET http://localhost:3001/api/bible/content/JHN/3",
        "Observe: Returns 0 verses (should return 36)",
        "Call API: GET http://localhost:3001/api/bible/content/REV/22",
        "Observe: Returns 0 verses (should return 21)",
        "Root cause: backend/routes/bibleRoutes.js line 345 hardcoded to translation_id = 1",
        "John 3 and Revelation 22 only exist in translation_id = 2"
      ],
      "fix_steps": [
        "Edit: backend/routes/bibleRoutes.js",
        "Replace hardcoded single translation call with fallback strategy",
        "Implementation: Try translation 8 (EN) + 2 (FA) first via Promise.all()",
        "Merge results from both translations",
        "Fallback to translation 1 if both empty",
        "Restart backend server",
        "Verify fix: All 5 test cases now pass"
      ],
      "code_changes": {
        "file": "backend/routes/bibleRoutes.js",
        "lines": "340-380",
        "before": "const verses = await supabaseClient.getVerses(book.book_iso, parseInt(chapter), 1);",
        "after": "const [trans8Verses, trans2Verses] = await Promise.all([\n  supabaseClient.getVerses(book.book_iso, parseInt(chapter), 8).catch(() => []),\n  supabaseClient.getVerses(book.book_iso, parseInt(chapter), 2).catch(() => [])\n]);\n// Merge both translations\nfor (let i = 0; i < maxVerses; i++) {\n  verses.push({\n    verse_number: (trans8Verses[i]?.verse_number || trans2Verses[i]?.verse_number || i + 1),\n    text_en: trans8Verses[i]?.text_en || trans8Verses[i]?.text_fa || trans2Verses[i]?.text_fa || '',\n    text_fa: trans2Verses[i]?.text_fa || trans2Verses[i]?.text_en || ''\n  });\n}\n// Fallback to translation 1 if empty\nif (verses.length === 0) {\n  verses = await supabaseClient.getVerses(book.book_iso, parseInt(chapter), 1);\n}"
      },
      "impact": "Critical - John 3:16 (most famous verse) was inaccessible, Revelation 22 (last chapter) was inaccessible",
      "priority": "P0",
      "assignee": "Backend Developer",
      "test_results": {
        "before_fix": "2/5 tests failed (John 3:16, Revelation 22)",
        "after_fix": "5/5 tests passed (100%)"
      }
    },
