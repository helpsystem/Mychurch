    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 2,
      "chapter_usfm": "JON.2",
      "version_id": 206,
      "version_abbr": "WEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.2.1",
          "line_type": "p",
          "text": "Then Jonah prayed to Yahweh, his God, out of the fish’s belly."
        },
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "line_type": "p",
          "text": "He said,“I called because of my affliction to Yahweh.He answered me.Out of the belly of Sheol I cried.You heard my voice."
        },
        {
          "verse": 3,
          "usfm": "JON.2.3",
          "line_type": "q1",
          "text": "For you threw me into the depths,in the heart of the seas.The flood was all around me.All your waves and your billows passed over me."
        },
        {
          "verse": 4,
          "usfm": "JON.2.4",
          "line_type": "q1",
          "text": "I said, ‘I have been banished from your sight;yet I will look again toward your holy temple.’"
        },
        {
          "verse": 5,
          "usfm": "JON.2.5",
          "line_type": "q1",
          "text": "The waters surrounded me,even to the soul.The deep was around me.The weeds were wrapped around my head."
        },
        {
          "verse": 6,
          "usfm": "JON.2.6",
          "line_type": "q1",
          "text": "I went down to the bottoms of the mountains.The earth barred me in forever;yet you have brought my life up from the pit, Yahweh my God."
        },
        {
          "verse": 7,
          "usfm": "JON.2.7",
          "line_type": "q1",
          "text": "“When my soul fainted within me, I remembered Yahweh.My prayer came in to you, into your holy temple."
        },
        {
          "verse": 8,
          "usfm": "JON.2.8",
          "line_type": "q1",
          "text": "Those who regard vain idols forsake their own mercy."
        },
        {
          "verse": 9,
          "usfm": "JON.2.9",
          "line_type": "q2",
          "text": "But I will sacrifice to you with the voice of thanksgiving.I will pay that which I have vowed.Salvation belongs to Yahweh.”"
        },
        {
          "verse": 10,
          "usfm": "JON.2.10",
          "line_type": "p",
          "text": "Then Yahweh spoke to the fish, and it vomited out Jonah on the dry land."
        }
      ],
      "verse_count": 10,
      "headings": [],
      "footnotes": [
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "note_ref": "2:2",
          "note_type": "footnote",
          "references": [],
          "text": "Sheol is the place of the dead."
        }
      ],
