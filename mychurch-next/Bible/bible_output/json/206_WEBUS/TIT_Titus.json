    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 2,
      "chapter_usfm": "TIT.2",
      "version_id": 206,
      "version_abbr": "WEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.2.1",
          "line_type": "p",
          "text": "But say the things which fit sound doctrine,"
        },
        {
          "verse": 2,
          "usfm": "TIT.2.2",
          "line_type": "p",
          "text": "that older men should be temperate, sensible, sober minded, sound in faith, in love, and in perseverance,"
        },
        {
          "verse": 3,
          "usfm": "TIT.2.3",
          "line_type": "p",
          "text": "and that older women likewise be reverent in behavior, not slanderers nor enslaved to much wine, teachers of that which is good,"
        },
        {
          "verse": 4,
          "usfm": "TIT.2.4",
          "line_type": "p",
          "text": "that they may train the young wives to love their husbands, to love their children,"
        },
        {
          "verse": 5,
          "usfm": "TIT.2.5",
          "line_type": "p",
          "text": "to be sober minded, chaste, workers at home, kind, being in subjection to their own husbands, that God’s word may not be blasphemed."
        },
        {
          "verse": 6,
          "usfm": "TIT.2.6",
          "line_type": "p",
          "text": "Likewise, exhort the younger men to be sober minded."
        },
        {
          "verse": 7,
          "usfm": "TIT.2.7",
          "line_type": "p",
          "text": "In all things show yourself an example of good works. In your teaching, show integrity, seriousness, incorruptibility,"
        },
        {
          "verse": 8,
          "usfm": "TIT.2.8",
          "line_type": "p",
          "text": "and soundness of speech that can’t be condemned, that he who opposes you may be ashamed, having no evil thing to say about us."
        },
        {
          "verse": 9,
          "usfm": "TIT.2.9",
          "line_type": "p",
          "text": "Exhort servants to be in subjection to their own masters and to be well-pleasing in all things, not contradicting,"
        },
        {
          "verse": 10,
          "usfm": "TIT.2.10",
          "line_type": "p",
          "text": "not stealing, but showing all good fidelity, that they may adorn the doctrine of God, our Savior, in all things."
        },
        {
          "verse": 11,
          "usfm": "TIT.2.11",
          "line_type": "p",
          "text": "For the grace of God has appeared, bringing salvation to all men,"
        },
        {
          "verse": 12,
          "usfm": "TIT.2.12",
          "line_type": "p",
          "text": "instructing us to the intent that, denying ungodliness and worldly lusts, we would live soberly, righteously, and godly in this present age;"
        },
        {
          "verse": 13,
          "usfm": "TIT.2.13",
          "line_type": "p",
          "text": "looking for the blessed hope and appearing of the glory of our great God and Savior, Jesus Christ,"
        },
        {
          "verse": 14,
          "usfm": "TIT.2.14",
          "line_type": "p",
          "text": "who gave himself for us, that he might redeem us from all iniquity and purify for himself a people for his own possession, zealous for good works."
        },
        {
          "verse": 15,
          "usfm": "TIT.2.15",
          "line_type": "p",
          "text": "Say these things and exhort and reprove with all authority. Let no one despise you."
        }
      ],
      "verse_count": 15,
