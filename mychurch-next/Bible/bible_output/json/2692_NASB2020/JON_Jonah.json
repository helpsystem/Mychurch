    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 2,
      "chapter_usfm": "JON.2",
      "version_id": 2692,
      "version_abbr": "NASB2020",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.2.1",
          "line_type": "p",
          "text": "Then Jonah prayed to the Lord his God from the stomach of the fish,"
        },
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "line_type": "p",
          "text": "and he said,“I called out of my distress to the Lord,And He answered me.I called for help from the depth of Sheol;You heard my voice."
        },
        {
          "verse": 3,
          "usfm": "JON.2.3",
          "line_type": "q",
          "text": "“For You threw me into the deep,Into the heart of the seas,And the current flowed around me.All Your breakers and waves passed over me."
        },
        {
          "verse": 4,
          "usfm": "JON.2.4",
          "line_type": "q",
          "text": "“So I said, ‘I have been cast out of Your sight.Nevertheless I will look again toward Your holy temple.’"
        },
        {
          "verse": 5,
          "usfm": "JON.2.5",
          "line_type": "q",
          "text": "“Water encompassed me to the point of death.The deep flowed around me,Seaweed was wrapped around my head."
        },
        {
          "verse": 6,
          "usfm": "JON.2.6",
          "line_type": "q",
          "text": "“I descended to the base of the mountains.The earth with its bars was around me forever,But You have brought up my life from the pit, Lord my God."
        },
        {
          "verse": 7,
          "usfm": "JON.2.7",
          "line_type": "q",
          "text": "“While I was fainting away,I remembered the Lord,And my prayer came to You,Into Your holy temple."
        },
        {
          "verse": 8,
          "usfm": "JON.2.8",
          "line_type": "q",
          "text": "“Those who are followers of worthless idolsAbandon their faithfulness,"
        },
        {
          "verse": 9,
          "usfm": "JON.2.9",
          "line_type": "q",
          "text": "But I will sacrifice to YouWith a voice of thanksgiving.That which I have vowed I will pay.Salvation is from the Lord.”"
        },
        {
          "verse": 10,
          "usfm": "JON.2.10",
          "line_type": "p",
          "text": "Then the Lord commanded the fish, and it vomited Jonah up onto the dry land."
        }
      ],
      "verse_count": 10,
