    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 2,
      "chapter_usfm": "TIT.2",
      "version_id": 2692,
      "version_abbr": "NASB2020",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.2.1",
          "line_type": "p",
          "text": "But as for you, proclaim the things which are fitting for sound doctrine."
        },
        {
          "verse": 2,
          "usfm": "TIT.2.2",
          "line_type": "p",
          "text": "Older men are to be temperate, dignified, self-controlled, sound in faith, in love, in perseverance."
        },
        {
          "verse": 3,
          "usfm": "TIT.2.3",
          "line_type": "p",
          "text": "Older women likewise are to be reverent in their behavior, not malicious gossips nor enslaved to much wine, teaching what is good,"
        },
        {
          "verse": 4,
          "usfm": "TIT.2.4",
          "line_type": "p",
          "text": "so that they may encourage the young women to love their husbands, to love their children,"
        },
        {
          "verse": 5,
          "usfm": "TIT.2.5",
          "line_type": "p",
          "text": "to be sensible, pure, workers at home, kind, being subject to their own husbands, so that the word of God will not be dishonored."
        },
        {
          "verse": 6,
          "usfm": "TIT.2.6",
          "line_type": "p",
          "text": "Likewise urge the young men to be sensible;"
        },
        {
          "verse": 7,
          "usfm": "TIT.2.7",
          "line_type": "p",
          "text": "in all things show yourself to be an example of good deeds, with purity in doctrine, dignified,"
        },
        {
          "verse": 8,
          "usfm": "TIT.2.8",
          "line_type": "p",
          "text": "sound in speech which is beyond reproach, so that the opponent will be put to shame, having nothing bad to say about us."
        },
        {
          "verse": 9,
          "usfm": "TIT.2.9",
          "line_type": "p",
          "text": "Urge slaves to be subject to their own masters in everything, to be pleasing, not argumentative,"
        },
        {
          "verse": 10,
          "usfm": "TIT.2.10",
          "line_type": "p",
          "text": "not stealing, but showing all good faith so that they will adorn the doctrine of God our Savior in every respect."
        },
        {
          "verse": 11,
          "usfm": "TIT.2.11",
          "line_type": "p",
          "text": "For the grace of God has appeared, bringing salvation to all people,"
        },
        {
          "verse": 12,
          "usfm": "TIT.2.12",
          "line_type": "p",
          "text": "instructing us to deny ungodliness and worldly desires and to live sensibly, righteously, and in a godly manner in the present age,"
        },
        {
          "verse": 13,
          "usfm": "TIT.2.13",
          "line_type": "p",
          "text": "looking for the blessed hope and the appearing of the glory of our great God and Savior, Christ Jesus,"
        },
        {
          "verse": 14,
          "usfm": "TIT.2.14",
          "line_type": "p",
          "text": "who gave Himself for us to redeem us from every lawless deed, and to purify for Himself a people for His own possession, eager for good deeds."
        },
        {
          "verse": 15,
          "usfm": "TIT.2.15",
          "line_type": "p",
          "text": "These things speak and exhort, and rebuke with all authority. No one is to disregard you."
        }
      ],
      "verse_count": 15,
      "headings": [
