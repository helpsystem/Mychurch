    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 1,
      "chapter_usfm": "1TH.1",
      "version_id": 4669,
      "version_abbr": "AFINT",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.1.1",
          "line_type": "p",
          "text": "Paul and Silvanus and Timothy, To the church of the Thessalonians in God the Father and the Lord Jesus Christ:Grace to you and peace.*"
        },
        {
          "verse": 2,
          "usfm": "1TH.1.2",
          "line_type": "p",
          "text": "We give thanks to God at all times concerning all of you, making mention of you* in our prayers,"
        },
        {
          "verse": 3,
          "usfm": "1TH.1.3",
          "line_type": "p",
          "text": "constantly remembering your work of faith and labour of love and steadfastness of hope in our Lord Jesus Christ in the presence of our God and Father."
        },
        {
          "verse": 4,
          "usfm": "1TH.1.4",
          "line_type": "p",
          "text": "knowing, brothers, beloved by God, your election,"
        },
        {
          "verse": 5,
          "usfm": "1TH.1.5",
          "line_type": "p",
          "text": "because our gospel did not come to you in word only, but also in power, and in the Holy Spirit, and with complete assurance, just as you know what sort of men we were among you for your sake."
        },
        {
          "verse": 6,
          "usfm": "1TH.1.6",
          "line_type": "p",
          "text": "And you became imitators of us and of the Lord, having received the word in the face of intense affliction,* with the joy of the Holy Spirit,"
        },
        {
          "verse": 7,
          "usfm": "1TH.1.7",
          "line_type": "p",
          "text": "so that you became an example to all the believers in Macedonia and Achaia.*"
        },
        {
          "verse": 8,
          "usfm": "1TH.1.8",
          "line_type": "p",
          "text": "For not only has the word of the Lord sounded forth from you in Macedonia and Achaia, but in every place your faith towards God has gone out, so that we have no need to say anything."
        },
        {
          "verse": 9,
          "usfm": "1TH.1.9",
          "line_type": "p",
          "text": "For they themselves report about us, what sort of reception we had among you, and how you turned to God from idols to serve the living and true God,"
        },
        {
          "verse": 10,
          "usfm": "1TH.1.10",
          "line_type": "p",
          "text": "and to wait for His Son from heaven,* whom He raised from the dead—Jesus, the One who rescues us from the wrath to come. 1 Some ancient manuscripts insert the expression from God our Father and the Lord Jesus Christ, in order to harmonise the text with a parallel reading in 2 Thess. 1:2 2 The genitive of reference of you is contextually supplied for clarity 6 Greek in intense affliction 7 Greek to all those who believe in Macedonia and Achaia 10 Greek from the heavens"
        }
      ],
      "verse_count": 10,
      "headings": [
        {
          "before_verse": 2,
          "text": "Thanksgiving to God for the Thessalonians’ Exemplary Faith and Life"
        },
        {
          "before_verse": 11,
          "text": "Notes"
        }
      ],
