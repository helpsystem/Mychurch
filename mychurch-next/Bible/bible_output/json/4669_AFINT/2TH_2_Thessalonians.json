  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 1,
      "chapter_usfm": "2TH.1",
      "version_id": 4669,
      "version_abbr": "AFINT",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.1.1",
          "line_type": "p",
          "text": "Paul and Silvanus and Timothy, To the church of the Thessalonians in God our Father and the Lord Jesus Christ."
        },
        {
          "verse": 2,
          "usfm": "2TH.1.2",
          "line_type": "p",
          "text": "Grace to you, and peace from God the Father and the Lord Jesus Christ."
        },
        {
          "verse": 3,
          "usfm": "2TH.1.3",
          "line_type": "p",
          "text": "We ought always to give thanks to God concerning you, brothers, just as it is fitting, because your faith is growing greatly and the love of each and every one of you towards another is increasing,"
        },
        {
          "verse": 4,
          "usfm": "2TH.1.4",
          "line_type": "p",
          "text": "so that we ourselves boast about you among the churches of God for your perseverance and faith in all your persecutions and in the afflictions which you are enduring."
        },
        {
          "verse": 5,
          "usfm": "2TH.1.5",
          "line_type": "p",
          "text": "This is an indication of the righteous judgment of God, so that you may be considered worthy of the kingdom of God, for which you are also suffering."
        },
        {
          "verse": 6,
          "usfm": "2TH.1.6",
          "line_type": "p",
          "text": "For indeed, it is just with God to repay those who are afflicting you with affliction,"
        },
        {
          "verse": 7,
          "usfm": "2TH.1.7",
          "line_type": "p",
          "text": "and to you who are being afflicted, rest with us at the revelation of the Lord Jesus from heaven with His mighty angels"
        },
        {
          "verse": 8,
          "usfm": "2TH.1.8",
          "line_type": "p",
          "text": "in blazing flame, inflicting just punishment on those who do not know God, and who do not obey the gospel of our Lord Jesus.*"
        },
        {
          "verse": 9,
          "usfm": "2TH.1.9",
          "line_type": "p",
          "text": "These* will pay the penalty of eternal destruction, away from the presence of the Lord and from the glory of his strength,"
        },
        {
          "verse": 10,
          "usfm": "2TH.1.10",
          "line_type": "p",
          "text": "when He comes to be glorified in His saints on that day and to be marvelled at among all those who have believed, because our testimony to you was believed."
        },
        {
          "verse": 11,
          "usfm": "2TH.1.11",
          "line_type": "p",
          "text": "For this* purpose also, we pray always for you, that our God may count you worthy of His calling, and bring to completion your every desire for goodness and your every faith-driven work by His power,*"
        },
        {
          "verse": 12,
          "usfm": "2TH.1.12",
          "line_type": "p",
          "text": "so that the name of our Lord Jesus may be glorified in you, and you in Him, according to the grace of our God and the Lord Jesus Christ. 8 Some ancient manuscripts omit the name Jesus 9 Greek who 11 Greek which 11 Greek …and bring to completion every desire for goodness and work of faith by power"
        }
      ],
