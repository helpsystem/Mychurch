    {
      "schema_version": 6,
      "book_id": "2CO",
      "chapter": 13,
      "chapter_usfm": "2CO.13",
      "version_id": 97,
      "version_abbr": "MSG",
      "verses": [
        {
          "verse": 10,
          "usfm": "2CO.13.10",
          "line_type": "p",
          "text": "I’m writing this to you now so that when I come I won’t have to say another word on the subject. The authority the Master gave me is for putting people together, not taking them apart. I want to get on with it, and not have to spend time on reprimands.* * * And that’s about it, friends. Be cheerful. Keep things in good repair. Keep your spirits up. Think in harmony. Be agreeable. Do all that, and the God of love and peace will be with you for sure. Greet one another with a holy embrace. All the brothers and sisters here say hello."
        },
        {
          "verse": 14,
          "usfm": "2CO.13.14",
          "line_type": "p",
          "text": "The amazing grace of the Master, Jesus Christ, the extravagant love of God, the intimate friendship of the Holy Spirit, be with all of you."
        }
      ],
