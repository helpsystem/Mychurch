      "version_abbr": "MSG",
      "verses": [
        {
          "verse": 23,
          "usfm": "2CO.1.23",
          "line_type": "p",
          "text": "Now, are you ready for the real reason I didn’t visit you in Corinth? As God is my witness, the only reason I didn’t come was to spare you pain. I was being considerate of you, not indifferent, not manipulative."
        },
        {
          "verse": 24,
          "usfm": "2CO.1.24",
          "line_type": "p",
          "text": "We’re not in charge of how you live out the faith, looking over your shoulders, suspiciously critical. We’re partners, working alongside you, joyfully expectant. I know that you stand by your own faith, not by ours."
        }
      ],
