    {
      "schema_version": 6,
      "book_id": "RUT",
      "chapter": 3,
      "chapter_usfm": "RUT.3",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "RUT.3.1",
          "line_type": "p",
          "text": "روزی نِعومی، مادر شوهر روت وی را گفت: «دخترم، آيا برای تو به دنبال آسایش نباشم تا برايت نيکو باشد؟"
        },
        {
          "verse": 2,
          "usfm": "RUT.3.2",
          "line_type": "p",
          "text": "و الان مگر بوعَز که تو با کنيزانش بودی، خويشاوند ما نيست؟ او امشب در خرمنگاه خود، جو پاک می‌کند."
        },
        {
          "verse": 3,
          "usfm": "RUT.3.3",
          "line_type": "p",
          "text": "پس شستشو کرده، به خود عطر بزن و لباس خود را پوشيده، به خرمنگاه برو. اما خود را به آن مرد نشناسان، تا از خوردن و نوشيدن فارغ شود."
        },
        {
          "verse": 4,
          "usfm": "RUT.3.4",
          "line_type": "p",
          "text": "و چون او بخوابد، جای خوابيدنش را نشان کن، و رفته، پوشش روی پايهای او را کنار زن و همانجا دراز بکش. او تو را خواهد گفت که چه بايد بکني.»"
        },
        {
          "verse": 5,
          "usfm": "RUT.3.5",
          "line_type": "p",
          "text": "روت وی را گفت: «هر‌ چه به من گفتی، خواهم کرد.»"
        },
        {
          "verse": 6,
          "usfm": "RUT.3.6",
          "line_type": "p",
          "text": "پس به خرمنگاه رفته، مطابق هر‌ آنچه که مادر شوهرش او را امر فرموده بود، عمل نمود."
        },
        {
          "verse": 7,
          "usfm": "RUT.3.7",
          "line_type": "p",
          "text": "پس چون بوعَز خورد و نوشيد و دلش شاد شد و رفته، به کنار بافه‌های جو خوابيد. آنگاه روت آهسته آهسته آمده، پوشش روی پايهای او را کنار زد و همانجا خوابيد."
        },
        {
          "verse": 8,
          "usfm": "RUT.3.8",
          "line_type": "p",
          "text": "نیمه‌های شب آن مرد از خواب پرید و برگشته، زنی را دید که نزد پايهايش خوابيده است."
        },
        {
          "verse": 9,
          "usfm": "RUT.3.9",
          "line_type": "p",
          "text": "و گفت: «تو کيستي»؟ روت گفت: «من کنيز تو، روت هستم، پس دامن خود را بر کنيز خويش بگستران، زيرا که تو قیّم هستي.»"
        },
        {
          "verse": 10,
          "usfm": "RUT.3.10",
          "line_type": "p",
          "text": "بوعَز گفت: «دخترم، خداوند تو را برکت دهد! زيرا که در آخر، از اول بيشتر نیکویی نمودی، چونکه در پی جوانان، چه فقير و چه غنی، نرفتی."
        },
        {
          "verse": 11,
          "usfm": "RUT.3.11",
          "line_type": "p",
          "text": "و حال، ‌دخترم، مترس! هر آنچه به من گفتی، برايت خواهم کرد، زيرا که تمامی همشهریانم تو را زنی نيکو می‌دانند."
        },
        {
          "verse": 12,
          "usfm": "RUT.3.12",
          "line_type": "p",
          "text": "و الان راست است که من قیّم هستم، ليکن ولی‌ّای نزديکتر از من هم هست."
        },
        {
          "verse": 13,
          "usfm": "RUT.3.13",
          "line_type": "p",
          "text": "امشب در اينجا بمان و بامدادان اگر او حق قیّم را برای تو به جا آورد، که آورد. اما اگر نخواهد که برای تو حق قیّم را به جا آورد، به حيات خداوند قسم که من آن را برای تو به جا خواهم آورد. الان تا صبح همینجا بخواب.»"
        },
        {
          "verse": 14,
          "usfm": "RUT.3.14",
          "line_type": "p",
          "text": "پس روت نزد پايش تا صبح خوابيده، پيش از آنکه کسی قادر به تشخیص همسايه‌اش باشد، برخاست. و بوعَز گفت: «به هوش باش که کسی نفهمد که اين زن به خرمنگاه آمده است.»"
        },
        {
          "verse": 15,
          "usfm": "RUT.3.15",
          "line_type": "p",
          "text": "و گفت: «چادری که بر توست، بياور و بر دستانت بگير.» پس روت چادر را بگرفت و بوعَز شش پیمانه جو پيموده، بر او گذارد و به شهر رفت."
        },
        {
          "verse": 16,
          "usfm": "RUT.3.16",
          "line_type": "p",
          "text": "و چون نزد مادر شوهر خود رسيد، او وی را گفت: «دخترم، بر تو چه گذشت؟» پس روت او را از هر آنچه آن مرد با وی کرده بود، خبر داد."
        },
        {
          "verse": 17,
          "usfm": "RUT.3.17",
          "line_type": "p",
          "text": "و گفت: «اين شش پیمانه جو را به من داد، زيرا گفت: ”نزد مادر شوهرت دست‌خالی بازنگرد.»"
        },
        {
          "verse": 18,
          "usfm": "RUT.3.18",
          "line_type": "p",
          "text": "نِعومی وی را گفت: «دخترم، آرام بنشين تا بدانی که اين امر چگونه خواهد شد، زيرا که آن مرد تا اين کار را امروز تمام نکند، آرام نخواهد گرفت.»"
        }
      ],
