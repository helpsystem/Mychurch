  "chapters": [
    {
      "schema_version": 6,
      "book_id": "RUT",
      "chapter": 1,
      "chapter_usfm": "RUT.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "RUT.1.1",
          "line_type": "p",
          "text": "و واقع شد در دوران حکومت داوران که قحطی در سرزمين پيدا شد. پس مردی از بيت‌لِحِم يهودا رفت تا در دیار موآب ساکن شود، او و زنش و دو پسرش."
        },
        {
          "verse": 2,
          "usfm": "RUT.1.2",
          "line_type": "p",
          "text": "و اسم آن مرد اِليمِلِک بود، و اسم زنش نِعومی، و پسرانش مَحلون و کِليون نام داشتند و اِفراتيانی از بيت‌لِحِم يهودا بودند. پس به دیار موآب رسيده، در آنجا ماندند."
        },
        {
          "verse": 3,
          "usfm": "RUT.1.3",
          "line_type": "p",
          "text": "و اِليمِلِک شوهر نِعومی، مرد و او با دو پسرش باقی ماند."
        },
        {
          "verse": 4,
          "usfm": "RUT.1.4",
          "line_type": "p",
          "text": "و ايشان از زنان موآب برای خود زن گرفتند که نام يکی عُرپَه و نام ديگری روت بود، و در آنجا قريب به ده سال توقف نمودند."
        },
        {
          "verse": 5,
          "usfm": "RUT.1.5",
          "line_type": "p",
          "text": "و هر دوی ايشان مَحلون و کِليون نيز مردند، و آن زن از دو پسر و شوهر خود محروم ماند."
        },
        {
          "verse": 6,
          "usfm": "RUT.1.6",
          "line_type": "p",
          "text": "پس او با دو عروس خود برخاست تا از دیار موآب برگردد، زيرا که در دیار موآب شنيده بود که خداوند از قوم خود دیدار نموده، به آنها خوراک داده است."
        },
        {
          "verse": 7,
          "usfm": "RUT.1.7",
          "line_type": "p",
          "text": "نِعومی از مکانی که در آن ساکن بود، بيرون آمد و دو عروسش همراه وی بودند، و به راه روانه شدند تا به سرزمين يهودا مراجعت کنند."
        },
        {
          "verse": 8,
          "usfm": "RUT.1.8",
          "line_type": "p",
          "text": "نِعومی به دو عروس خود گفت: «برويد و هر يکی از شما به خانه مادر خود برگرديد. خداوند بر شما نیکویی کند، چنانکه شما به مردگان و به من کرديد."
        },
        {
          "verse": 9,
          "usfm": "RUT.1.9",
          "line_type": "p",
          "text": "و خداوند به شما عطا کند که هر يکی از شما در خانه شوهر خود آسایش يابيد.» پس ايشان را بوسيد و صدای خود را بلند کرده، گريستند."
        },
        {
          "verse": 10,
          "usfm": "RUT.1.10",
          "line_type": "p",
          "text": "و به او گفتند: «نه، بلکه همراه تو نزد قوم تو خواهيم برگشت.»"
        },
        {
          "verse": 11,
          "usfm": "RUT.1.11",
          "line_type": "p",
          "text": "نِعومی گفت: «ای دخترانم برگرديد، چرا همراه من بياييد؟ آيا در رَحِم من هنوز پسران هستند که برای شما شوهر باشند؟"
        },
        {
          "verse": 12,
          "usfm": "RUT.1.12",
          "line_type": "p",
          "text": "‌ای دخترانم برگشته، راه خود را پيش گيريد، زيرا که برای شوهر گرفتن زياده پير هستم، و اگر گويم که اميد دارم و امشب نيز به شوهر داده شوم و پسران هم بزايم،"
        },
        {
          "verse": 13,
          "usfm": "RUT.1.13",
          "line_type": "p",
          "text": "آيا تا بالغ شدن آنان صبر خواهيد کرد، و به‌ خاطر ایشان خود را از شوهر گرفتن محروم خواهيد داشت؟ نه، ‌ای دخترانم، زيرا که جانم برای شما بسيار تلخ شده است چونکه دست خداوند به ضدّ من دراز شده است.»"
        },
        {
          "verse": 14,
          "usfm": "RUT.1.14",
          "line_type": "p",
          "text": "پس بار ديگر صدای خود را بلند کرده، گريستند و عُرپه مادر شوهر خود را بوسيد، اما روت به او چسبيد."
        },
        {
          "verse": 15,
          "usfm": "RUT.1.15",
          "line_type": "p",
          "text": "نِعومی به او گفت: «اينک زن برادر شوهرت نزد قوم خود و خدايان خويش برگشته است، تو نيز در پی جاری‌ات برگرد.»"
        },
        {
          "verse": 16,
          "usfm": "RUT.1.16",
          "line_type": "p",
          "text": "روت گفت: «بر من اصرار مکن که تو را ترک کنم و از نزد تو برگردم، زيرا هر جايی که رَوی، می‌آيم و هر جايی که منزل کنی، منزل می‌کنم. قوم تو قوم من و خدای تو خدای من خواهد بود."
        },
        {
          "verse": 17,
          "usfm": "RUT.1.17",
          "line_type": "p",
          "text": "جايی که بميری، می‌ميرم و در آنجا دفن خواهم شد. خداوند به من چنين بلکه زياده بر اين کند اگر چيزی غير از مرگ، مرا از تو جدا نمايد.»"
        },
        {
          "verse": 18,
          "usfm": "RUT.1.18",
          "line_type": "p",
          "text": "چون نِعومی ديد که روت برای رفتن به همراهش مصمم است، از سخن ‌گفتن با او باز ايستاد."
        },
        {
          "verse": 19,
          "usfm": "RUT.1.19",
          "line_type": "p",
          "text": "و ايشان هر دو روانه شدند تا به بیت​لِحِم رسيدند. چون وارد بیت​لِحِم گرديدند، تمامی شهر بر ايشان به حرکت آمده، زنان می‌گفتند: «آيا اين نعومی است؟»"
        },
        {
          "verse": 20,
          "usfm": "RUT.1.20",
          "line_type": "p",
          "text": "نِعومی به ايشان گفت: «مرا نِعومي مخوانيد، بلکه مرا مارا بخوانيد، زيرا قادر مطلق به من مرارت سخت رسانيده است."
        },
        {
          "verse": 21,
          "usfm": "RUT.1.21",
          "line_type": "p",
          "text": "من پُر بيرون رفتم و خداوند مرا خالی برگردانيد. پس برای چه مرا نعومی می‌خوانيد؟ چونکه خداوند مرا ذليل ساخته است و قادر مطلق به من بدی رسانيده است.»"
        },
        {
          "verse": 22,
          "usfm": "RUT.1.22",
          "line_type": "p",
          "text": "و نعومی مراجعت کرد و عروسش روت موآبی که از دیار موآب برگشته بود، همراه او آمد. آنها در ابتدای موسم درويدن جو وارد بیت​لِحِم شدند."
        }
      ],
      "verse_count": 22,
