    },
    {
      "schema_version": 6,
      "book_id": "RUT",
      "chapter": 4,
      "chapter_usfm": "RUT.4",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "RUT.4.1",
          "line_type": "p",
          "text": "و بوعَز به دروازه شهر آمده، آنجا نشست و اينک آن قیّم که بوعَز درباره او سخن گفته بود، می‌گذشت. بوعَز به او گفت: «فلانی، به اين طرف برگرد و بنشين.» او برگشته، نشست."
        },
        {
          "verse": 2,
          "usfm": "RUT.4.2",
          "line_type": "p",
          "text": "آنگاه بوعَز ده نفر از مشايخ شهر را برداشته، به ايشان گفت: «اينجا بنشينيد.» و ايشان نشستند."
        },
        {
          "verse": 3,
          "usfm": "RUT.4.3",
          "line_type": "p",
          "text": "و به آن قیّم گفت: «نِعومی که از دیار موآب برگشته است، قطعه زمينی را که از آنِ برادر ما اِليمِلِک بود، می‌فروشد."
        },
        {
          "verse": 4,
          "usfm": "RUT.4.4",
          "line_type": "p",
          "text": "و من مصلحت ديدم که تو را اطلاع داده، بگويم که ”آن را در حضور اين مجلس و مشايخ قوم من بخر.“ اگر آن را بازخرید می‌کنی، بکن. و اگر بازخرید نمی‌کنی، مرا خبر بده تا بدانم. زيرا غير از تو کسی نيست که آن را بازخرید نماید. و من بعد از تو هستم.» آن مرد گفت: «من بازخرید می‌کنم.»"
        },
        {
          "verse": 5,
          "usfm": "RUT.4.5",
          "line_type": "p",
          "text": "بوعَز گفت: «در روزی که زمين را از دست نِعومی باز می‌خری، روت موآبی را نیز که زن متوفی است، بايد از آنِ خود کنی، تا نام متوفی را بر ميراثش باقی بماند.»"
        },
        {
          "verse": 6,
          "usfm": "RUT.4.6",
          "line_type": "p",
          "text": "آن قیّم گفت: «نمی‌توانم برای خود بازخرید کنم، مبادا ميراث خود را به خطر اندازم. تو حق بازخرید مرا بر عهده خود بگير، زيرا نمی‌توانم بازخرید نمايم.»"
        },
        {
          "verse": 7,
          "usfm": "RUT.4.7",
          "line_type": "p",
          "text": "و رسم بازخرید و مبادله در روزهای قديم در اسرائيل به جهت رسمیت بخشیدن به هر امر، اين بود که شخص کفش خود را بيرون کرده، آن را به شخص دیگر می‌داد. و اين در اسرائيل قانون شده است."
        },
        {
          "verse": 8,
          "usfm": "RUT.4.8",
          "line_type": "p",
          "text": "پس آن قیّم به بوعَز گفت: «آن را برای خود بازخرید نما.» و کفش خود را بيرون کرد."
        },
        {
          "verse": 9,
          "usfm": "RUT.4.9",
          "line_type": "p",
          "text": "بوعَز به مشايخ و به تمامی قوم گفت: «شما امروز شاهد باشيد که تمامی دارایی اِليمِلِک و تمامی دارایی کِليون و مَحلون را از دست نعومی خريدم."
        },
        {
          "verse": 10,
          "usfm": "RUT.4.10",
          "line_type": "p",
          "text": "و هم روت موآبی زن مَحلون را نیز به زنی خود بازخريد کردم تا نام متوفی را بر ميراثش باقی نگه دارم و نام متوفی از ميان برادرانش و از دروازه شهرش بریده نشود. شما امروز شاهد باشيد.»"
        },
        {
          "verse": 11,
          "usfm": "RUT.4.11",
          "line_type": "p",
          "text": "و تمامی قوم که نزد دروازه بودند و مشايخ گفتند: «شاهد هستيم و خداوند اين زن را که به خانه تو درآمد، مثل راحيل و ليه گرداند که خانه اسرائيل را بنا کردند. و تو در اِفراته کامياب شو، و در بیت​لِحِم نامور باش."
        },
        {
          "verse": 12,
          "usfm": "RUT.4.12",
          "line_type": "p",
          "text": "و خانه تو مثل خانه فِرِص باشد که تامار برای يهودا زاييد، از اولادی که خداوند تو را از اين دختر، خواهد بخشيد.»"
        },
        {
          "verse": 13,
          "usfm": "RUT.4.13",
          "line_type": "p",
          "text": "پس بوعَز روت را گرفت و روت زن وی شد. بوعَز با او همخواب شد و خداوند روت را بارور ساخت و او پسری زاييد."
        },
        {
          "verse": 14,
          "usfm": "RUT.4.14",
          "line_type": "p",
          "text": "و زنان به نِعومی گفتند: «متبارک باد خداوند که تو را امروز بدون ‌قیّم نگذاشته است. نام او در اسرائيل بلند‌آوازه شود."
        },
        {
          "verse": 15,
          "usfm": "RUT.4.15",
          "line_type": "p",
          "text": "این پسر جان تو را تازه کند و در وقت پیری از تو نگهداری نماید، زيرا که عروست که تو را دوست می‌دارد و برايت از هفت پسر بهتر است، او را زاييده است.»"
        },
        {
          "verse": 16,
          "usfm": "RUT.4.16",
          "line_type": "p",
          "text": "و نِعومی پسر را گرفته، در آغوش خود گذاشت و دايه او شد."
        },
        {
          "verse": 17,
          "usfm": "RUT.4.17",
          "line_type": "p",
          "text": "و زنان همسايه‌اش، او را نام نهاده، گفتند: «برای نعومی پسری زاييده شده است.» و نام او را عوبيد خواندند و او پدر يِسا پدر داوود است."
        },
        {
          "verse": 18,
          "usfm": "RUT.4.18",
          "line_type": "p",
          "text": "اين است پيدايش نسل فِرِص: فِرِص حِصرون را آورد؛"
        },
        {
          "verse": 19,
          "usfm": "RUT.4.19",
          "line_type": "p",
          "text": "و حِصرون، رام را آورد؛ و رام، عَمّيناداب را آورد؛"
        },
        {
          "verse": 20,
          "usfm": "RUT.4.20",
          "line_type": "p",
          "text": "و عَمّيناداب نَحشون را آورد؛ و نَحشون سَلمون را آورد؛"
        },
        {
          "verse": 21,
          "usfm": "RUT.4.21",
          "line_type": "p",
          "text": "و سَلمون بوعَز را آورد؛ و بوعَز عوبيد را آورد؛"
        },
        {
          "verse": 22,
          "usfm": "RUT.4.22",
          "line_type": "p",
          "text": "و عوبيد، يِسا را آورد؛ و يِسا داوود را آورد."
        }
      ],
