    {
      "schema_version": 6,
      "book_id": "RUT",
      "chapter": 2,
      "chapter_usfm": "RUT.2",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "RUT.2.1",
          "line_type": "p",
          "text": "و نعومی خويشاوندی از طرف شوهر داشت که مردی دولتمند، بوعَز نام از خاندان اِليمِلِک بود."
        },
        {
          "verse": 2,
          "usfm": "RUT.2.2",
          "line_type": "p",
          "text": "روت موآبی به نِعومی گفت: «مرا اجازه ده که به کشتزارها بروم و در عقب هر کسی ‌که در نظرش التفات يابم، خوشه‌چينی نمايم.» نِعومی وی را گفت: «برو، ‌ای دخترم.»"
        },
        {
          "verse": 3,
          "usfm": "RUT.2.3",
          "line_type": "p",
          "text": "پس روانه شده، به کشتزار درآمد و در پی دروندگان خوشه‌چينی می‌نمود. از قضا به قطعه زمین بوعَز که از خاندان اَليمِلِک بود، افتاد."
        },
        {
          "verse": 4,
          "usfm": "RUT.2.4",
          "line_type": "p",
          "text": "و اينک بوعَز از بيت‌لِحِم آمده، به دروندگان گفت: «خداوند با شما باد.» ايشان وی را گفتند: «خداوند تو را برکت دهد.»"
        },
        {
          "verse": 5,
          "usfm": "RUT.2.5",
          "line_type": "p",
          "text": "بوعَز به نوکر خود که بر دروندگان گماشته بود، گفت: «اين دختر از آنِ کيست؟»"
        },
        {
          "verse": 6,
          "usfm": "RUT.2.6",
          "line_type": "p",
          "text": "نوکر که بر دروندگان گماشته شده بود، در جواب گفت: «اين همان دختر موآبی است که با نِعومی از شهرهای موآب برگشته است."
        },
        {
          "verse": 7,
          "usfm": "RUT.2.7",
          "line_type": "p",
          "text": "او به من گفت: ”تمنا اينکه خوشه‌چينی نمايم و در عقب دروندگان در ميان بافه‌ها جمع کنم.“ پس آمده، از صبح تا به حال بی‌وقفه مشغول است، سوای آنکه اندکی در خانه استراحت کرده است.»"
        },
        {
          "verse": 8,
          "usfm": "RUT.2.8",
          "line_type": "p",
          "text": "بوعَز به روت گفت: «ای دخترم، گوش کن، به هيچ کشتزار ديگر برای خوشه‌چينی مرو و اينجا را هم ترک مکن. بلکه با کنيزان من در اينجا باش."
        },
        {
          "verse": 9,
          "usfm": "RUT.2.9",
          "line_type": "p",
          "text": "و چشمانت به زمينی که می‌دروند، باشد و در پی ايشان برو. مگر جوانان را حکم نکردم که تو را لمس نکنند؟ و اگر تشنه شدی، نزد ظروف ايشان برو و از آنچه جوانان می‌کشند، بنوش.»"
        },
        {
          "verse": 10,
          "usfm": "RUT.2.10",
          "line_type": "p",
          "text": "پس روت به روی درافتاده، او را تا به زمين تعظيم کرد و به او گفت: «برای چه در نظر تو التفات يافتم که به من توجه نمودی و حال آنکه غريب هستم.»"
        },
        {
          "verse": 11,
          "usfm": "RUT.2.11",
          "line_type": "p",
          "text": "بوعَز در جواب او گفت: «از هر ‌آنچه بعد از مردن شوهرت به مادر شوهر خود کردی، به تمامی به اطلاع من رسيده است، اینکه چگونه پدر و مادر و زادگاهت را ترک کرده، نزد قومی که پيشتر نمی‌شناختی، آمدي."
        },
        {
          "verse": 12,
          "usfm": "RUT.2.12",
          "line_type": "p",
          "text": "خداوند عمل تو را پاداش دهد و از جانب يهوه خدای اسرائيل، که در زير بالهايش پناه بردی، پاداش کامل به تو برسد.»"
        },
        {
          "verse": 13,
          "usfm": "RUT.2.13",
          "line_type": "p",
          "text": "گفت: «ای آقايم، در نظر تو التفات بيابم، زيرا که مرا تسلی دادی و به کنيز خود به مهربانی سخن گفتی، اگر‌چه من مثل يکی از کنيزان تو هم نيستم.»"
        },
        {
          "verse": 14,
          "usfm": "RUT.2.14",
          "line_type": "p",
          "text": "بوعَز او را گفت: «در وقت غذا اينجا بيا و از نان بخور و لقمه خود را در شيره فرو بر.» پس روت نزد دروندگان نشست و غله برشته به او دادند و خورد و سير شد و قدری هم اضافی آورد."
        },
        {
          "verse": 15,
          "usfm": "RUT.2.15",
          "line_type": "p",
          "text": "و چون برای خوشه‌چينی برخاست، بوعَز جوانان خود را امر کرده، گفت: «بگذاريد که در ميان بافه‌ها هم خوشه‌چينی نمايد و به او تشر مزنید."
        },
        {
          "verse": 16,
          "usfm": "RUT.2.16",
          "line_type": "p",
          "text": "و نيز از دسته‌ها کشيده، برايش بگذاريد تا برچيند و توبیخش مکنيد.»"
        },
        {
          "verse": 17,
          "usfm": "RUT.2.17",
          "line_type": "p",
          "text": "پس روت تا شامگاه در آن کشتزار خوشه‌چينی نموده، آنچه را که برچيده بود، کوبيد و به قدر يک ايفه جو بود."
        },
        {
          "verse": 18,
          "usfm": "RUT.2.18",
          "line_type": "p",
          "text": "پس آن را برداشته، به شهر درآمد و مادر شوهرش آنچه را که برچيده بود، ديد. روت آنچه بعد از سير شدنش باقی‌ مانده بود، بيرون آورده، به او داد."
        },
        {
          "verse": 19,
          "usfm": "RUT.2.19",
          "line_type": "p",
          "text": "مادر شوهرش وی را گفت: «امروز کجا خوشه‌چينی نمودی و کجا کار کردی؟ مبارک باد آنکه بر تو توجه نموده است.» روت مادر شوهر خود را از کسی ‌که نزد او کار کرده بود، خبر داده، گفت: «نام آن شخص که امروز نزد او کار کردم، بوعَز است.»"
        },
        {
          "verse": 20,
          "usfm": "RUT.2.20",
          "line_type": "p",
          "text": "نعومی به عروس خود گفت: «مبارک باد او، از جانب خداوندی که نیکویی را بر زندگان و مردگان ترک ننموده است.» و نِعومی او را گفت: «اين شخص، خويشاوند ما و از ولی‌ّهای ماست.»"
        },
        {
          "verse": 21,
          "usfm": "RUT.2.21",
          "line_type": "p",
          "text": "روت موآبی گفت: «او همچنین مرا گفت: ”با خادمان من باش تا زمانی که همه درو مرا تمام کنند.»"
        },
        {
          "verse": 22,
          "usfm": "RUT.2.22",
          "line_type": "p",
          "text": "نِعومی به عروس خود روت گفت: «دخترم، خوب است که با کنيزان او بيرون روی، مبادا در کشتزار ديگر به تو دست‌درازی شود.»"
        },
        {
          "verse": 23,
          "usfm": "RUT.2.23",
          "line_type": "p",
          "text": "پس روت با کنيزان بوعَز برای خوشه‌چينی می‌ماند تا درو جو و درو گندم تمام شد. و با مادر شوهرش سکونت داشت."
        }
      ],
      "verse_count": 23,
      "headings": [],
