  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 1,
      "chapter_usfm": "2PE.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.1.1",
          "line_type": "p",
          "text": "شَمعون پِطرُس، غلام و رسول عیسی مسیح،به آنانی که ایمان گرانبها را به اندازهٔ ما یافته‌اند، در عدالت خدای ما و عیسی مسیح نجات‌دهنده."
        },
        {
          "verse": 2,
          "usfm": "2PE.1.2",
          "line_type": "p",
          "text": "فیض و سلامتی در معرفت خدا و خداوند ما عیسی بر شما افزون باد."
        },
        {
          "verse": 3,
          "usfm": "2PE.1.3",
          "line_type": "p",
          "text": "چنانکه قوّت الهی او همه‌ٔ چیزهایی را که برای حیات و دینداری لازم است، به ما ارزانی داشته است، به معرفت او که ما را به جلال و نیکویی خود دعوت نموده،"
        },
        {
          "verse": 4,
          "usfm": "2PE.1.4",
          "line_type": "p",
          "text": "که به واسطه آنها وعده‌های بی‌نهایت بزرگ و گرانبها به ما داده شد تا شما به اینها شریک طبیعت الهی گردید و از فسادی که از شهوت در جهان است، خلاصی یابید."
        },
        {
          "verse": 5,
          "usfm": "2PE.1.5",
          "line_type": "p",
          "text": "و به همین جهت، کمال سعی نموده، در ایمان خود نیکویی بار آورید"
        },
        {
          "verse": 6,
          "usfm": "2PE.1.6",
          "line_type": "p",
          "text": "و در نیکویی، علم و در علم، عفّت و در عفّت، صبر و در صبر، دینداری"
        },
        {
          "verse": 7,
          "usfm": "2PE.1.7",
          "line_type": "p",
          "text": "و در دینداری، محبّت برادران و با محبّت برادران، محبّت را."
        },
        {
          "verse": 8,
          "usfm": "2PE.1.8",
          "line_type": "p",
          "text": "زیرا هرگاه اینها در شما یافت شود و فزونی یابد، شما را نمی‌گذارد که در معرفت خداوند ما عیسی مسیح تنبل یا بی‌ثمر بوده باشید."
        },
        {
          "verse": 9,
          "usfm": "2PE.1.9",
          "line_type": "p",
          "text": "زیرا هر که اینها را ندارد، کور و کوتاه‌نظر است و پاکی گناهان گذشته خود را فراموش کرده است."
        },
        {
          "verse": 10,
          "usfm": "2PE.1.10",
          "line_type": "p",
          "text": "بنابراین ای برادران، بیشتر جد و جهد کنید تا دعوت و برگزیدگی خود را استواری دهید. زیرا اگر چنین کنید، هرگز لغزش نخواهید خورد."
        },
        {
          "verse": 11,
          "usfm": "2PE.1.11",
          "line_type": "p",
          "text": "و همچنین توان ورود به پادشاهی جاودانی خداوند و نجات‌دهندهٔ ما عیسی مسیح به شما به دولتمندی داده خواهد شد."
        },
        {
          "verse": 12,
          "usfm": "2PE.1.12",
          "line_type": "p",
          "text": "پس این امور را پیوسته به یاد شما خواهم آورد، هرچند آنها را می‌دانید و در آن حقیقت که نزد شما است، استوار هستید."
        },
        {
          "verse": 13,
          "usfm": "2PE.1.13",
          "line_type": "p",
          "text": "لیکن این را درست می‌دانم، مادامی که در این خیمه هستم، شما را به یادآوری برانگیزانم."
        },
        {
          "verse": 14,
          "usfm": "2PE.1.14",
          "line_type": "p",
          "text": "چونکه می‌دانم که زمان بیرون کردن خیمه من نزدیک است، چنانکه خداوند ما عیسی مسیح نیز مرا آگاهانید."
        },
        {
          "verse": 15,
          "usfm": "2PE.1.15",
          "line_type": "p",
          "text": "و برای این نیز کوشش می‌کنم تا شما در هر وقت بعد از رحلت من، بتوانید این امور را یاد آورید."
        },
        {
          "verse": 16,
          "usfm": "2PE.1.16",
          "line_type": "p",
          "text": "زیرا که در‌ پی افسانه‌های ساختگی نرفتیم چون از قوت و آمدن خداوند ما عیسی مسیح شما را اعلام دادیم، بلکه شوکت او را دیده بودیم."
        },
        {
          "verse": 17,
          "usfm": "2PE.1.17",
          "line_type": "p",
          "text": "زیرا که او از خدای پدر حرمت و جلال یافت هنگامی که صدایی از جلال شوکت به او رسید که «این است پسر عزیز من که از وی خشنودم.»"
        },
        {
          "verse": 18,
          "usfm": "2PE.1.18",
          "line_type": "p",
          "text": "و این صدا را ما زمانی که با او در کوه مقدّس بودیم، شنیدیم که از آسمان آورده شد."
        },
        {
          "verse": 19,
          "usfm": "2PE.1.19",
          "line_type": "p",
          "text": "و کلام انبیا را نیز محکمتر داریم که نیکو می‌کنید اگر در آن جد و جهد کنید؛ مثل چراغی درخشنده در مکان تاریک تا روز بشکافد و ستاره صبح در دلهای شما طلوع کند."
        },
        {
          "verse": 20,
          "usfm": "2PE.1.20",
          "line_type": "p",
          "text": "و این را نخست بدانید که هیچ نبوت کتاب از تفسیر خود نبی نیست."
        },
        {
          "verse": 21,
          "usfm": "2PE.1.21",
          "line_type": "p",
          "text": "زیرا که نبوّت به ارادهٔ انسان هرگز آورده نشد، بلکه مردمان تحت نفوذ روح‌القدس از جانب خدا سخن‌ گفتند."
        }
      ],
      "verse_count": 21,
