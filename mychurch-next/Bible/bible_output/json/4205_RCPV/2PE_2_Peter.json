    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 3,
      "chapter_usfm": "2PE.3",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.3.1",
          "line_type": "p",
          "text": "این رساله دوّم را‌، ای عزیزان، الان به شما می‌نویسم که به این هر دو، دل پاک شما را به طریق یادگاری برمی‌انگیزانم،"
        },
        {
          "verse": 2,
          "usfm": "2PE.3.2",
          "line_type": "p",
          "text": "تا به خاطر آرید کلماتی که انبیا مقدّس، پیش گفته‌اند و فرمان خداوند و نجات‌دهنده را که به رسولان شما داده شد."
        },
        {
          "verse": 3,
          "usfm": "2PE.3.3",
          "line_type": "p",
          "text": "و نخست این را می‌دانید که در روزهای آخر مسخره‌کنندگان با استهزا گویان خواهند شد که در پیروی از شهوات خود رفتار نموده،"
        },
        {
          "verse": 4,
          "usfm": "2PE.3.4",
          "line_type": "p",
          "text": "خواهند گفت: «کجاست وعده آمدن او؟ زیرا از زمانی که پدران به خواب رفتند، هر چیز به همینطوری که از ابتدای آفرینش بود، باقی هست.»"
        },
        {
          "verse": 5,
          "usfm": "2PE.3.5",
          "line_type": "p",
          "text": "زیرا که ایشان عمداً از این غافل هستند که به کلام خدا آسمانها از قدیم بود و زمین از آب و به آب مستحکم گردید."
        },
        {
          "verse": 6,
          "usfm": "2PE.3.6",
          "line_type": "p",
          "text": "و به این هر دو، عالمی که آن وقت بود در آب غرق شده، هلاک گشت."
        },
        {
          "verse": 7,
          "usfm": "2PE.3.7",
          "line_type": "p",
          "text": "لیکن آسمان و زمین الآن به همان کلام برای آتش ذخیره شده و تا روز داوری و هلاکت مردم بی‌دین نگاه داشته شده‌اند."
        },
        {
          "verse": 8,
          "usfm": "2PE.3.8",
          "line_type": "p",
          "text": "لیکن ای حبیبان، این یک چیز از شما مخفی نماند که یک روز نزد خداوند همچون هزار سال است و هزار سال همچون یک روز."
        },
        {
          "verse": 9,
          "usfm": "2PE.3.9",
          "line_type": "p",
          "text": "خداوند در وعدهٔ خود تأخیر نمی‌نماید چنانکه بعضی تأخیر می‌پندارند، بلکه بر شما تحمّل می‌نماید چون نمی‌خواهد که کسی هلاک گردد، بلکه همه به توبه گرایند."
        },
        {
          "verse": 10,
          "usfm": "2PE.3.10",
          "line_type": "p",
          "text": "لیکن روز خداوند همچون دزد خواهد آمد که در آن آسمانها به صدای مهیب از بین خواهد رفت و اجرام آسمانی سوخته شده، از هم خواهد پاشید و زمین و کارهایی که در آن است، سوخته خواهد شد."
        },
        {
          "verse": 11,
          "usfm": "2PE.3.11",
          "line_type": "p",
          "text": "پس چون تمامی اینها فرو خواهند ریخت، شما چطور مردمان باید باشید، در هر کردار مقدّس و دینداری؟"
        },
        {
          "verse": 12,
          "usfm": "2PE.3.12",
          "line_type": "p",
          "text": "و آمدن روز خدا را انتظار بکشید و آن را بشتابانید که در آن آسمانها سوخته شده، از هم پراکنده خواهند شد و اجرام آسمانی از حرارت گداخته خواهد گردید."
        },
        {
          "verse": 13,
          "usfm": "2PE.3.13",
          "line_type": "p",
          "text": "ولی مطابق وعدهٔ او، منتظر آسمانهای جدید و زمین جدید هستیم که در آنها عدالت ساکن خواهد بود."
        },
        {
          "verse": 14,
          "usfm": "2PE.3.14",
          "line_type": "p",
          "text": "بنابراین ای عزیزان، چون انتظار این چیزها را می‌کشید، جد و جهد نمایید تا نزد او بی‌لکه و بی‌عیب در آشتی یافت شوید."
        },
        {
          "verse": 15,
          "usfm": "2PE.3.15",
          "line_type": "p",
          "text": "و تحمّل خداوند ما را نجات بدانید، چنانکه برادر عزیز ما پولُس نیز مطابق حکمتی که به او داده شد، به شما نوشت."
        },
        {
          "verse": 16,
          "usfm": "2PE.3.16",
          "line_type": "p",
          "text": "و همچنین در سایر رساله‌های خود این چیزها را بیان می‌نماید که در آنها بعضی چیزهاست که فهمیدن آنها مشکل است و مردمان بی‌علم و ناپایدار آنها را مثل سایر کتب تحریف می‌کنند تا به هلاکت خود برسند."
        },
        {
          "verse": 17,
          "usfm": "2PE.3.17",
          "line_type": "p",
          "text": "پس شما‌، ای عزیزان، چون این امور را از پیش می‌دانید، مواظب باشید که مبادا به گمراهی بی‌دینان اسیر توفان شده از پایداری خود بیفتید."
        },
        {
          "verse": 18,
          "usfm": "2PE.3.18",
          "line_type": "p",
          "text": "بلکه در فیض و معرفت خداوند و نجات‌دهندهٔ ما عیسی مسیح پیشرفت کنید، که او را از کنون تا به ابد جلال باد. آمین."
        }
      ],
