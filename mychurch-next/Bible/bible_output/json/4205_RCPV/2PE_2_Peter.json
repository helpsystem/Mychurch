    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 2,
      "chapter_usfm": "2PE.2",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.2.1",
          "line_type": "p",
          "text": "لیکن در میان قوم، انبیای دروغین نیز بودند، چنانکه در میان شما هم معلّمان دروغین خواهند بود که بدعتهای مرگبار را مخفیانه خواهند آورد و آن سَروری را که ایشان را خرید، انکار خواهند نمود و هلاکت سریع را بر خود خواهند کشید؛"
        },
        {
          "verse": 2,
          "usfm": "2PE.2.2",
          "line_type": "p",
          "text": "و بسیاری عیاشی ایشان را پیروی خواهند نمود که به خاطر ایشان طریق حق، مورد ملامت خواهد شد."
        },
        {
          "verse": 3,
          "usfm": "2PE.2.3",
          "line_type": "p",
          "text": "و از راه سودجویی به سخنان ساختگی شما را خرید و فروش خواهند کرد که مکافات ایشان که از دیرباز رقم خورده، بی‌کار ننشسته و هلاکت ایشان خوابیده نیست."
        },
        {
          "verse": 4,
          "usfm": "2PE.2.4",
          "line_type": "p",
          "text": "زیرا هرگاه خدا بر فرشتگانی که گناه کردند، شفقت ننمود، بلکه ایشان را به جهنم انداخته، به زنجیرهای ظلمت سپرد تا برای داوری نگاه داشته شوند؛"
        },
        {
          "verse": 5,
          "usfm": "2PE.2.5",
          "line_type": "p",
          "text": "و بر جهان قدیم شفقت نفرمود بلکه نوح، واعظ عدالت را با هفت نفر دیگر محفوظ داشته، طوفان را بر جهان بی‌دینان آورد؛"
        },
        {
          "verse": 6,
          "usfm": "2PE.2.6",
          "line_type": "p",
          "text": "و شهرهای سُدوم و غَموره را خاکستر نموده، امر به سقوط آنها فرمود و آنها را برای آنانی که بعد از این بی‌دینی خواهند کرد، درس عبرتی ساخت؛"
        },
        {
          "verse": 7,
          "usfm": "2PE.2.7",
          "line_type": "p",
          "text": "و لوط عادل را که از رفتار عیاش‌وار بی‌دینان رنجیده بود، رهانید."
        },
        {
          "verse": 8,
          "usfm": "2PE.2.8",
          "line_type": "p",
          "text": "زیرا که آن مرد عادل در میانشان ساکن بوده، از آنچه می‌دید و می‌شنید، دل صالح خود را به ‌کارهای زشت ایشان هر روزه رنجیده می‌داشت."
        },
        {
          "verse": 9,
          "usfm": "2PE.2.9",
          "line_type": "p",
          "text": "پس خداوند می‌داند که عادلان را از امتحان رهایی دهد و ظالمان را تا به روز جزا در عذاب نگاه دارد."
        },
        {
          "verse": 10,
          "usfm": "2PE.2.10",
          "line_type": "p",
          "text": "به ویژه آنانی که در شهوات نجاست در‌ پی جسم می‌روند و اقتدار خداوند را حقیر می‌دانند. این گستاخان و متکبّران از اهانت به بزرگان آسمانی ترسی ندارند؛"
        },
        {
          "verse": 11,
          "usfm": "2PE.2.11",
          "line_type": "p",
          "text": "و حال آنکه فرشتگانی که در قدرت و قوت برتر هستند، پیش خداوند بر ایشان حکم افترا نمی‌زنند."
        },
        {
          "verse": 12,
          "usfm": "2PE.2.12",
          "line_type": "p",
          "text": "لیکن اینها همچون حیوانات بی‌شعور که برای صید و هلاکت طبیعتاً متولّد شده‌اند، ملامت می‌کنند بر آنچه نمی‌دانند و در فساد خود هلاک خواهند شد."
        },
        {
          "verse": 13,
          "usfm": "2PE.2.13",
          "line_type": "p",
          "text": "و مزد ناراستی خود را خواهند یافت که عیش و عشرت یک روزه را سرور خود می‌دانند. لکّه‌ها و عیبها هستند که در مهمانی‌های محبّتانه خود عیش و عشرت می‌نمایند وقتی که با شما شادی می‌کنند."
        },
        {
          "verse": 14,
          "usfm": "2PE.2.14",
          "line_type": "p",
          "text": "چشمان پر از زنا دارند که از گناه بازداشته نمی‌شود، و کسان ناپایدار را به دام می‌کشند؛ پسران لعنت که قلب خود را برای سودجویی تربیت کرده‌اند،"
        },
        {
          "verse": 15,
          "usfm": "2PE.2.15",
          "line_type": "p",
          "text": "و راه مستقیم را ترک کرده، گمراه شدند و راه بلعام پسر بُصور را که مزد ناراستی را دوست می‌داشت، پیش گرفتند."
        },
        {
          "verse": 16,
          "usfm": "2PE.2.16",
          "line_type": "p",
          "text": "لیکن او از تقصیر خود توبیخ یافت که الاغ بی‌زبان به زبان انسان سخن گفته، دیوانگی نبی را توبیخ نمود."
        },
        {
          "verse": 17,
          "usfm": "2PE.2.17",
          "line_type": "p",
          "text": "اینها چشمه‌های بی‌آب و مِه‌های رانده شده به باد شدید هستند که برای ایشان ظلمت تاریکی جاودانی، تعیین شده است."
        },
        {
          "verse": 18,
          "usfm": "2PE.2.18",
          "line_type": "p",
          "text": "زیرا که سخنان تکبرآمیز و پوچ می‌گویند و آنانی را که از اهل گمراهی تازه آزاد شده‌اند، در دام شهوات به عیاشی جسمی می‌کشند."
        },
        {
          "verse": 19,
          "usfm": "2PE.2.19",
          "line_type": "p",
          "text": "ایشان را به آزادی وعده می‌دهند و حال آنکه خود غلام فساد هستند، زیرا هر چیزی که بر کسی غالب شده باشد، او نیز غلام آن است."
        },
        {
          "verse": 20,
          "usfm": "2PE.2.20",
          "line_type": "p",
          "text": "زیرا هرگاه به معرفت خداوند و نجات‌دهنده ما عیسی مسیح از آلودگی دنیوی رهایی یافتند و بعد از آن، بار دیگر گرفتار و مغلوب آن گشتند، اواخر ایشان از اوایل بدتر می‌شود."
        },
        {
          "verse": 21,
          "usfm": "2PE.2.21",
          "line_type": "p",
          "text": "زیرا که برای ایشان بهتر می‌بود که راه عدالت را ندانسته باشند، از اینکه بعد از دانستن، بار دیگر از آن فرمان مقدس که به ایشان سپرده شده بود، برگردند."
        },
        {
          "verse": 22,
          "usfm": "2PE.2.22",
          "line_type": "p",
          "text": "آنچه مَثَل حقیقی می‌گوید، به سرشان آمده که:«سگ به قی خود مراجعت کرده است.»و«خوک شسته شده، به غلطیدن در گِل.»"
        }
      ],
      "verse_count": 22,
