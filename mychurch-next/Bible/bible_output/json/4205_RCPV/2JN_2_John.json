  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2JN",
      "chapter": 1,
      "chapter_usfm": "2JN.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2JN.1.1",
          "line_type": "p",
          "text": "من که پیرم، به بانوی برگزیده و فرزندانش که ایشان را در حقیقت محبّت می‌نمایم و نه من فقط، بلکه همهٔ کسانی که حقیقت را می‌دانند،"
        },
        {
          "verse": 2,
          "usfm": "2JN.1.2",
          "line_type": "p",
          "text": "به خاطر آن حقیقت که در ما ساکن است و با ما تا به ابد خواهد بود."
        },
        {
          "verse": 3,
          "usfm": "2JN.1.3",
          "line_type": "p",
          "text": "فیض و رحمت و سلامتی از جانب خدای پدر و عیسی مسیح، پسر آن پدر، در حقیقت و محبّت با ما خواهد بود."
        },
        {
          "verse": 4,
          "usfm": "2JN.1.4",
          "line_type": "p",
          "text": "بسیار مسرور شدم چونکه بعضی از فرزندان تو را یافتم که در حقیقت رفتار می‌کنند، چنانکه از پدر فرمان یافتیم."
        },
        {
          "verse": 5,
          "usfm": "2JN.1.5",
          "line_type": "p",
          "text": "و الآن، ‌ای بانو، از تو التماس دارم نه آنکه امری تازه به تو بنویسم، بلکه همان را که از ابتدا داشتیم که یکدیگر را محبّت بنماییم."
        },
        {
          "verse": 6,
          "usfm": "2JN.1.6",
          "line_type": "p",
          "text": "و این است محبّت که موافق فرامین او زندگی کنیم و امر همان است که از اوّل شنیدید تا در آن رفتار نماییم."
        },
        {
          "verse": 7,
          "usfm": "2JN.1.7",
          "line_type": "p",
          "text": "زیرا گمراه کنندگان بسیار به ‌دنیا بیرون شدند که عیسی مسیح ظاهر شده در جسم را اقرار نمی‌کنند. آن است گمراه ‌کننده و ضدّمسیح."
        },
        {
          "verse": 8,
          "usfm": "2JN.1.8",
          "line_type": "p",
          "text": "خود را نگاه دارید، مبادا آنچه را که کار کردیم، بر باد دهید، بلکه تا مزد کامل بیابید."
        },
        {
          "verse": 9,
          "usfm": "2JN.1.9",
          "line_type": "p",
          "text": "هر که از تعلیم مسیح فراتر می‌رود و در آن استوار نیست، خدا را نیافته است. امّا آنکه در تعلیم مسیح استوار ماند، او هم پدر و پسر را دارد."
        },
        {
          "verse": 10,
          "usfm": "2JN.1.10",
          "line_type": "p",
          "text": "اگر کسی به نزد شما آید و این تعلیم را نیاورد، او را به خانه خود مپذیرید و او را خوش‌آمد مگویید."
        },
        {
          "verse": 11,
          "usfm": "2JN.1.11",
          "line_type": "p",
          "text": "زیرا هر که او را خوش‌آمد گوید، در کارهای شرم آورش شریک گردد."
        },
        {
          "verse": 12,
          "usfm": "2JN.1.12",
          "line_type": "p",
          "text": "چیزهای بسیار دارم که به شما بنویسم، لیکن نخواستم که به کاغذ و مرکّب بنویسم، بلکه امیدوارم که به نزد شما بیایم و زبانی گفتگو نمایم تا خوشی ما کامل شود."
        },
        {
          "verse": 13,
          "usfm": "2JN.1.13",
          "line_type": "p",
          "text": "فرزندان خواهر برگزیدٔه تو، به تو سلام می‌رسانند. آمین."
        }
      ],
