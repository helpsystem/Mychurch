    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 2,
      "chapter_usfm": "TIT.2",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.2.1",
          "line_type": "p",
          "text": "امّا تو سخنان شایسته تعلیم صحیح را بگو؛"
        },
        {
          "verse": 2,
          "usfm": "TIT.2.2",
          "line_type": "p",
          "text": "که مردانِ سالخورده، هشیار و باوقار و خرداندیش و در ایمان و محبّت و صبر، درست باشند."
        },
        {
          "verse": 3,
          "usfm": "TIT.2.3",
          "line_type": "p",
          "text": "همچنین زنانِ سالخورده، در کردار پرهیزگار باشند، و نه غیبت‌گو و نه اسیر شراب زیاده، بلکه آموزندگان تعلیم نیکو،"
        },
        {
          "verse": 4,
          "usfm": "TIT.2.4",
          "line_type": "p",
          "text": "تا زنان جوان را خرد بیاموزند که شوهردوست و فرزنددوست باشند،"
        },
        {
          "verse": 5,
          "usfm": "TIT.2.5",
          "line_type": "p",
          "text": "و خرداندیش و پاک و خانه‌نشین و نیکو و مطیع شوهران خود که مبادا کلام خدا بد گفته شود."
        },
        {
          "verse": 6,
          "usfm": "TIT.2.6",
          "line_type": "p",
          "text": "و به همین شیوه مردان جوان را نصیحت فرما تا خرداندیش باشند."
        },
        {
          "verse": 7,
          "usfm": "TIT.2.7",
          "line_type": "p",
          "text": "و خود را در همه ‌چیز نمونه کارهای نیک بگردان و در تعلیم خود صداقت و وقار را به کار بر"
        },
        {
          "verse": 8,
          "usfm": "TIT.2.8",
          "line_type": "p",
          "text": "و کلام صحیح بی‌عیب را، تا دشمن چونکه فرصت بد‌گفتن در حق ما نیابد، خجل شود."
        },
        {
          "verse": 9,
          "usfm": "TIT.2.9",
          "line_type": "p",
          "text": "غلامان را نصیحت نما که آقایان خود را اطاعت کنند و در هر امر ایشان را خشنود سازند. جرّ و بحث نکنند"
        },
        {
          "verse": 10,
          "usfm": "TIT.2.10",
          "line_type": "p",
          "text": "و دزدی ننمایند، بلکه کمال امانتداری را آشکار سازند تا تعلیم نجات‌دهندهٔ ما خدا را در هر چیز زینت دهند."
        },
        {
          "verse": 11,
          "usfm": "TIT.2.11",
          "line_type": "p",
          "text": "زیرا که فیض خدا که برای همهٔ مردم نجات‌بخش است، آشکار شده،"
        },
        {
          "verse": 12,
          "usfm": "TIT.2.12",
          "line_type": "p",
          "text": "ما را هشدار می‌دهد که بی‌دینی و شهوات دنیوی را ترک کرده، با خرداندیشی و عدالت و دینداری در این جهان زندگی کنیم."
        },
        {
          "verse": 13,
          "usfm": "TIT.2.13",
          "line_type": "p",
          "text": "و آن امید مبارک و ظهور جلال خدای بزرگ و نجات‌دهنده خویش عیسی مسیح را انتظار کشیم،"
        },
        {
          "verse": 14,
          "usfm": "TIT.2.14",
          "line_type": "p",
          "text": "که خود را در راه ما فدا ساخت تا ما را از هر ناراستی برهاند و قومی برای خود طاهر سازد که مِلک خاص او و غیور در کارهای نیک باشند."
        },
        {
          "verse": 15,
          "usfm": "TIT.2.15",
          "line_type": "p",
          "text": "این را بگو و نصیحت فرما و در کمال اقتدار توبیخ نما و هیچ‌‌کس تو را حقیر نشمارد."
        }
      ],
