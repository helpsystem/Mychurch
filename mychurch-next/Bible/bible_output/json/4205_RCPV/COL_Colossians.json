    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 2,
      "chapter_usfm": "COL.2",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.2.1",
          "line_type": "p",
          "text": "زیرا می‌خواهم شما آگاه باشید که مرا چه نوع غیرت است برای شما و اهل لائودیکیه و آنانی که چهرهٔ مرا در جسم ندیده‌اند،"
        },
        {
          "verse": 2,
          "usfm": "COL.2.2",
          "line_type": "p",
          "text": "تا دلهای ایشان تسلّی یابد و ایشان در محبّت پیوند شده، به دولتِ یقینِ فهمِ تمام و به معرفت راز خدا برسند؛"
        },
        {
          "verse": 3,
          "usfm": "COL.2.3",
          "line_type": "p",
          "text": "یعنی راز مسیح که در وی تمامی گنجهای حکمت و علم مخفی است."
        },
        {
          "verse": 4,
          "usfm": "COL.2.4",
          "line_type": "p",
          "text": "امّا این را می‌گویم تا هیچ‌‌کس شما را به سخنان فریبنده گمراه نکند."
        },
        {
          "verse": 5,
          "usfm": "COL.2.5",
          "line_type": "p",
          "text": "زیرا که هرچند در جسم غایبم، لیکن در روح با شما بوده، شادی می‌کنم و نظم و استواری ایمانتان را در مسیح مشاهده می‌نمایم."
        },
        {
          "verse": 6,
          "usfm": "COL.2.6",
          "line_type": "p",
          "text": "پس چنانکه مسیح عیسی خداوند را پذیرفتید، در وی رفتار نمایید،"
        },
        {
          "verse": 7,
          "usfm": "COL.2.7",
          "line_type": "p",
          "text": "که در او ریشه کرده و بنا شده و در ایمان استوار گشته‌اید، به گونه‌ای که تعلیم یافته‌اید و در آن شکرگزاری بسیار می‌نمایید."
        },
        {
          "verse": 8,
          "usfm": "COL.2.8",
          "line_type": "p",
          "text": "باخبر باشید که کسی شما را نرباید به فلسفه و حیله باطل، مطابق تقلید مردم و بر حسب اصول دنیوی، نه برحسب مسیح،"
        },
        {
          "verse": 9,
          "usfm": "COL.2.9",
          "line_type": "p",
          "text": "که در وی از جهت جسم، تمامی پری الوهیت ساکن است."
        },
        {
          "verse": 10,
          "usfm": "COL.2.10",
          "line_type": "p",
          "text": "و شما در وی به کمال رسیده‌‌اید که سَرِ تمامی ریاست و قدرت است."
        },
        {
          "verse": 11,
          "usfm": "COL.2.11",
          "line_type": "p",
          "text": "و در وی ختنه شده‌اید، به ختنه ناساخته به ‌دست، یعنی بیرون کردن بدن جسمانی به‌وسیلهٔ ختنه مسیح."
        },
        {
          "verse": 12,
          "usfm": "COL.2.12",
          "line_type": "p",
          "text": "و با وی در تعمید دفن گشتید که در آن هم برخیزانیده شدید به ایمان بر کار خدا که او را از مردگان برخیزانید."
        },
        {
          "verse": 13,
          "usfm": "COL.2.13",
          "line_type": "p",
          "text": "و شما را که در خطایا و ختنه‌ناشدگی جسم خود مُرده بودید، خدا با او زنده گردانید چونکه همه خطایای شما را بخشید،"
        },
        {
          "verse": 14,
          "usfm": "COL.2.14",
          "line_type": "p",
          "text": "و آن سند قرضها را که ضدّ ما و مشتمل بر قوانین و به خلاف ما بود، محو ساخت و آن را به صلیب خود میخکوب کرده از میان برداشت."
        },
        {
          "verse": 15,
          "usfm": "COL.2.15",
          "line_type": "p",
          "text": "و ریاسات و قوات را خلع سلاح کرده، آنها را در مقابل چشم همه رسوا نمود، چون در آن بر آنها پیروزی یافت."
        },
        {
          "verse": 16,
          "usfm": "COL.2.16",
          "line_type": "p",
          "text": "پس کسی دربارهٔ خوردن و نوشیدن و دربارهٔ عید و ماه نو و سبّت شما را محکوم نکند،"
        },
        {
          "verse": 17,
          "usfm": "COL.2.17",
          "line_type": "p",
          "text": "زیرا که اینها سایه چیزهای آینده است، لیکن اصل آنها در مسیح است."
        },
        {
          "verse": 18,
          "usfm": "COL.2.18",
          "line_type": "p",
          "text": "و کسی جایزهٔ شما را نرباید از رغبت به فروتنی و عبادت فرشتگان و دخالت در اموری که دیده است که از ذهن جسمانی خود بی‌جا مغرور شده است؛"
        },
        {
          "verse": 19,
          "usfm": "COL.2.19",
          "line_type": "p",
          "text": "و به‌ سر نچسبیده که از آن تمامی بدن به توسط مفصلها و بندها مدد یافته و با هم پیوند شده، رشد می‌کند به رشدی که از خداست."
        },
        {
          "verse": 20,
          "usfm": "COL.2.20",
          "line_type": "p",
          "text": "چونکه با مسیح از اصول دنیوی مُردید، چگونه است که مثل زندگان در دنیا بر شما قوانین و مقررات نهاده می‌شود؟"
        },
        {
          "verse": 21,
          "usfm": "COL.2.21",
          "line_type": "p",
          "text": "که «لمس مکن و به آن لب نزن و بر آن دست مگذار!»؟"
        },
        {
          "verse": 22,
          "usfm": "COL.2.22",
          "line_type": "p",
          "text": "که همه اینها تنها به خاطر استفاده از بین می‌رود و برحسب تقلیدها و تعالیم مردم بنا شده است."
        },
        {
          "verse": 23,
          "usfm": "COL.2.23",
          "line_type": "p",
          "text": "که چنین چیزها هرچند در عبادت داوطلبانه و فروتنی و آزار بدن صورت حکمت دارد، ولی فایده‌ای برای رفع تن‌پروری ندارد."
        }
      ],
      "verse_count": 23,
      "headings": [
        {
          "before_verse": 6,
          "text": "در مسیح زنده"
        }
      ],
