    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 4,
      "chapter_usfm": "COL.4",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.4.1",
          "line_type": "p",
          "text": "ای آقایان، با غلامان خود عدالت و انصاف را به‌ جا آرید، چونکه می‌دانید شما را نیز آقایی هست در آسمان."
        },
        {
          "verse": 2,
          "usfm": "COL.4.2",
          "line_type": "p",
          "text": "با استقامت در دعا ادامه دهید و در آن با شکرگزاری بیدار باشید."
        },
        {
          "verse": 3,
          "usfm": "COL.4.3",
          "line_type": "p",
          "text": "و دربارهٔ ما نیز دعا کنید که خدا درِ کلام را به روی ما بگشاید تا راز مسیح را که به خاطر آن به زندان هم افتاده‌ام، بگویم"
        },
        {
          "verse": 4,
          "usfm": "COL.4.4",
          "line_type": "p",
          "text": "و آن را به طوری که می‌باید صحبت کنم و روشن سازم."
        },
        {
          "verse": 5,
          "usfm": "COL.4.5",
          "line_type": "p",
          "text": "زمان را درک کرده، پیش اهل خارج به حکمت رفتار کنید."
        },
        {
          "verse": 6,
          "usfm": "COL.4.6",
          "line_type": "p",
          "text": "گفتگوی شما همیشه با فیض باشد و اصلاح شده به نمک، تا بدانید هر کس را چگونه جواب باید داد."
        },
        {
          "verse": 7,
          "usfm": "COL.4.7",
          "line_type": "p",
          "text": "تیخیکوس، برادر عزیز و خادم امین و هم‌خدمت من در خداوند، از همه احوال من شما را باخبر خواهد ساخت،"
        },
        {
          "verse": 8,
          "usfm": "COL.4.8",
          "line_type": "p",
          "text": "که او را به همین جهت نزد شما فرستادم تا از حالات شما آگاه شود و دلهای شما را تسلّی دهد،"
        },
        {
          "verse": 9,
          "usfm": "COL.4.9",
          "line_type": "p",
          "text": "با اونِسیموس، برادر امین و عزیز ما که از خود شماست، شما را از همه گزارش اینجا آگاه خواهند ساخت."
        },
        {
          "verse": 10,
          "usfm": "COL.4.10",
          "line_type": "p",
          "text": "آریستارخوس هم‌زندان من شما را سلام می‌رساند، و مرقس عموزاده برنابا که دربارهٔ او به شما توصیه کردم، هرگاه نزد شما آید، او را بپذیرید،"
        },
        {
          "verse": 11,
          "usfm": "COL.4.11",
          "line_type": "p",
          "text": "و یسوع، معروف به یوستوس که ایشان تنها از اهل ختنه برای پادشاهی خدا هم‌خدمت شده، باعث تسلّی من گردیدند."
        },
        {
          "verse": 12,
          "usfm": "COL.4.12",
          "line_type": "p",
          "text": "اِپافراس به شما سلام می‌رساند که یکی از شما و غلام مسیح عیسی است و پیوسته برای شما در دعاهای خود جد و جهد می‌کند تا در تمامی اراده خدا کامل و استوار شوید."
        },
        {
          "verse": 13,
          "usfm": "COL.4.13",
          "line_type": "p",
          "text": "و برای او گواهی می‌دهم که دربارهٔ شما و اهل لائودیکیه و اهل هیراپولیس بسیار زحمت می‌کشد."
        },
        {
          "verse": 14,
          "usfm": "COL.4.14",
          "line_type": "p",
          "text": "و لوقای طبیب محبوب و دیماس به شما سلام می‌رسانند."
        },
        {
          "verse": 15,
          "usfm": "COL.4.15",
          "line_type": "p",
          "text": "برادران در لائودیکیه و نیمفا و کلیسایی را که در خانه اوست، سلام رسانید."
        },
        {
          "verse": 16,
          "usfm": "COL.4.16",
          "line_type": "p",
          "text": "و چون این رساله برای شما خوانده شد، ترتیبی دهید که در کلیسای لائودیکیان نیز خوانده شود و رساله از لائودیکیه را هم شما بخوانید."
        },
        {
          "verse": 17,
          "usfm": "COL.4.17",
          "line_type": "p",
          "text": "و به آرخیپوس گویید: «باخبر باش تا آن خدمتی را که در خداوند یافته‌ای، به‌ کمال رسانی.»"
        },
        {
          "verse": 18,
          "usfm": "COL.4.18",
          "line_type": "p",
