    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 3,
      "chapter_usfm": "COL.3",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.3.1",
          "line_type": "p",
          "text": "پس چون با مسیح برخیزانیده شدید، آنچه را که در بالا است، بطلبید در آنجایی که مسیح است، به ‌دست راست خدا نشسته."
        },
        {
          "verse": 2,
          "usfm": "COL.3.2",
          "line_type": "p",
          "text": "در آنچه بالا است، تفکّر کنید، نه در آنچه بر زمین است."
        },
        {
          "verse": 3,
          "usfm": "COL.3.3",
          "line_type": "p",
          "text": "زیرا که مردید و زندگی شما با مسیح در خدا مخفی است."
        },
        {
          "verse": 4,
          "usfm": "COL.3.4",
          "line_type": "p",
          "text": "چون مسیح که زندگی ما است، آشکار شود، آنگاه شما هم با وی در جلال آشکار خواهید شد."
        },
        {
          "verse": 5,
          "usfm": "COL.3.5",
          "line_type": "p",
          "text": "پس اعضای خود را که بر زمین است بکشید، زنا و ناپاکی و هوا و هوس و شهوات شرم آور و طمع که بت‌پرستی است"
        },
        {
          "verse": 6,
          "usfm": "COL.3.6",
          "line_type": "p",
          "text": "که به خاطر اینها خشم خدا بر پسران نااطاعتی وارد می‌آید."
        },
        {
          "verse": 7,
          "usfm": "COL.3.7",
          "line_type": "p",
          "text": "که شما نیز سابق در اینها رفتار می‌کردید، هنگامی که در آنها زندگی می‌نمودید."
        },
        {
          "verse": 8,
          "usfm": "COL.3.8",
          "line_type": "p",
          "text": "لیکن اکنون شما همه را ترک کنید، یعنی خشم و عصبانیّت و بدخویی و بدگویی و فحش را از زبان خود."
        },
        {
          "verse": 9,
          "usfm": "COL.3.9",
          "line_type": "p",
          "text": "به یکدیگر دروغ مگویید، چونکه انسانیّت کهنه را با کارهایش از خود بیرون کرده‌اید،"
        },
        {
          "verse": 10,
          "usfm": "COL.3.10",
          "line_type": "p",
          "text": "و تازه را پوشیده‌اید که به صورت خالق خویش تا به معرفت کامل تازه می‌شود،"
        },
        {
          "verse": 11,
          "usfm": "COL.3.11",
          "line_type": "p",
          "text": "که در آن نه یونانی است، نه یهود، نه ختنه‌شدگی، نه ختنه‌ناشدگی نه بربر نه سکایی، نه غلام و نه آزاد، بلکه مسیح همه و در همه است."
        },
        {
          "verse": 12,
          "usfm": "COL.3.12",
          "line_type": "p",
          "text": "پس مانند برگزیدگان مقدّس و محبوب خدا دلسوزی و مهربانی و تواضع و تحمّل و حلم را بپوشید."
        },
        {
          "verse": 13,
          "usfm": "COL.3.13",
          "line_type": "p",
          "text": "و متحمل یکدیگر شده، همدیگر را عفو کنید هرگاه بر دیگری ادعایی داشته باشید؛ چنانکه خداوند شما را بخشید، شما نیز یکدیگر را ببخشید."
        },
        {
          "verse": 14,
          "usfm": "COL.3.14",
          "line_type": "p",
          "text": "و بر این همه محبّت را بپوشید که همه چیز را به کمال به هم می‌پیوندد."
        },
        {
          "verse": 15,
          "usfm": "COL.3.15",
          "line_type": "p",
          "text": "و سلامتی مسیح در دلهای شما مسلط باشد که به آن هم در یک بدن خوانده شده‌اید و شکرگزار باشید."
        },
        {
          "verse": 16,
          "usfm": "COL.3.16",
          "line_type": "p",
          "text": "کلام مسیح در شما به دولتمندی و به‌ کمال حکمت ساکن بشود و یکدیگر را تعلیم و نصیحت کنید به مزامیر و نغمه‌ها و سرودهای روحانی، و با شکرگزاری در دلهای خود خدا را بسرایید."
        },
        {
          "verse": 17,
          "usfm": "COL.3.17",
          "line_type": "p",
          "text": "و آنچه کنید در حرف و در عمل، همه را به نام عیسی خداوند بکنید و خدای پدر را به‌وسیله او شکر کنید."
        },
        {
          "verse": 18,
          "usfm": "COL.3.18",
          "line_type": "p",
          "text": "‌ای زنان، شوهران خود را اطاعت نمایید، چنانکه در خداوند شایسته است."
        },
        {
          "verse": 19,
          "usfm": "COL.3.19",
          "line_type": "p",
          "text": "‌ای شوهران، همسران خود را محبّت نمایید و با ایشان تلخی مکنید."
        },
        {
          "verse": 20,
          "usfm": "COL.3.20",
          "line_type": "p",
          "text": "‌ای فرزندان، والدین خود را در همه ‌چیز اطاعت کنید، زیرا که این پسندیده است در خداوند."
        },
        {
          "verse": 21,
          "usfm": "COL.3.21",
          "line_type": "p",
          "text": "‌ای پدران، فرزندان خود را خشمگین مسازید، مبادا شکسته‌دل شوند."
        },
        {
          "verse": 22,
          "usfm": "COL.3.22",
          "line_type": "p",
          "text": "‌ای غلامان، آقایان جسمانی خود را در هر چیز اطاعت کنید، نه به خدمت حضور مثل جویندگان خشنودی مردم، بلکه به صداقت قلب. و از خداوند بترسید."
        },
        {
          "verse": 23,
          "usfm": "COL.3.23",
          "line_type": "p",
          "text": "و آنچه کنید، از دل کنید به خاطر خداوند نه به خاطر انسان."
        },
        {
          "verse": 24,
          "usfm": "COL.3.24",
          "line_type": "p",
          "text": "چون می‌دانید که از خداوند پاداش میراث را خواهید یافت، چونکه مسیح خداوند را خدمت می‌کنید."
        },
        {
          "verse": 25,
          "usfm": "COL.3.25",
          "line_type": "p",
          "text": "زیرا هر که ظلم کند، آن ظلمی را که کرد، خواهد یافت و ظاهربینی نیست."
        }
      ],
      "verse_count": 25,
      "headings": [
        {
          "before_verse": 18,
          "text": "اصول روابط مسیحی"
        }
      ],
      "footnotes": [
        {
          "verse": 11,
          "usfm": "COL.3.11",
          "note_ref": "3‏.11",
          "note_type": "footnote",
          "references": [],
          "text": "مردمان غیریونانی که زبان یونانی را نمی‌دانستند."
        },
        {
          "verse": 11,
          "usfm": "COL.3.11",
          "note_ref": "3‏.11",
          "note_type": "footnote",
          "references": [],
          "text": "'سَکایی' لقبی بود برای پست‌ترین قشر از مردمان بَربَر، و بخصوص در اشاره به قبایلی در اطراف دریای سیاه به کار می‌رفت که از میانشان برده می‌گرفتند."
        }
      ],
