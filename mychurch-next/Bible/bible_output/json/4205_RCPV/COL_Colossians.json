  "chapters": [
    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 1,
      "chapter_usfm": "COL.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.1.1",
          "line_type": "p",
          "text": "پولس به ارادهٔ خدا رسول مسیح عیسی و تیموتائوس برادر،"
        },
        {
          "verse": 2,
          "usfm": "COL.1.2",
          "line_type": "p",
          "text": "به مقدسین در کولُسی و برادران امین در مسیح،فیض و سلامتی از جانب پدر ما خدا بر شما باد."
        },
        {
          "verse": 3,
          "usfm": "COL.1.3",
          "line_type": "p",
          "text": "خدا و پدر خداوند خود عیسی مسیح را شکر می‌کنیم و پیوسته برای شما دعا می‌نماییم،"
        },
        {
          "verse": 4,
          "usfm": "COL.1.4",
          "line_type": "p",
          "text": "چونکه ایمان شما را در مسیح عیسی و محبّتی را که با تمامی مقدسین می‌نمایید، شنیدیم،"
        },
        {
          "verse": 5,
          "usfm": "COL.1.5",
          "line_type": "p",
          "text": "به خاطر امیدی که برای شما در آسمان گذاشته شده است که خبر آن را در کلام حقیقت انجیل پیشتر شنیدید،"
        },
        {
          "verse": 6,
          "usfm": "COL.1.6",
          "line_type": "p",
          "text": "که به شما وارد شد، چنانکه در تمامی جهان نیز، و میوه می‌آورد و نمو می‌کند، چنانکه در میان شما نیز از روزی که آن را شنیدید و فیض خدا را در حقیقت دانسته‌اید."
        },
        {
          "verse": 7,
          "usfm": "COL.1.7",
          "line_type": "p",
          "text": "چنانکه از اِپافراس تعلیم یافتید که هم‌خدمت عزیز ما و خادم امین مسیح برای شما است."
        },
        {
          "verse": 8,
          "usfm": "COL.1.8",
          "line_type": "p",
          "text": "و او ما را نیز از محبّت شما که در روح است، خبر داد."
        },
        {
          "verse": 9,
          "usfm": "COL.1.9",
          "line_type": "p",
          "text": "و از آن جهت ما نیز از روزی که این را شنیدیم، باز نمی‌ایستیم از دعا کردن برای شما و درخواست نمودن، تا از کمال معرفت اراده او در هر حکمت و فهم روحانی پر شوید،"
        },
        {
          "verse": 10,
          "usfm": "COL.1.10",
          "line_type": "p",
          "text": "تا شما به طریق شایسته خداوند به‌ کمال خشنودی او رفتار نمایید و در هر عمل نیکو بار آورید و به معرفت کامل خدا رشد کنید"
        },
        {
          "verse": 11,
          "usfm": "COL.1.11",
          "line_type": "p",
          "text": "و به اندازهٔ توانایی جلال او به قوت کامل نیرومند شوید تا صبر کامل و تحمّل را با شادمانی داشته باشید؛"
        },
        {
          "verse": 12,
          "usfm": "COL.1.12",
          "line_type": "p",
          "text": "و پدر را شکر گزارید که ما را لایق بهره میراث مقدسین در نور گردانیده است،"
        },
        {
          "verse": 13,
          "usfm": "COL.1.13",
          "line_type": "p",
          "text": "و ما را از قدرت ظلمت رهانیده، به پادشاهی پسر محبّت خود منتقل ساخت،"
        },
        {
          "verse": 14,
          "usfm": "COL.1.14",
          "line_type": "p",
          "text": "که در وی رهایی خود یعنی بخشش گناهان خویش را یافته‌ایم."
        },
        {
          "verse": 15,
          "usfm": "COL.1.15",
          "line_type": "p",
          "text": "و او صورت خدای نادیده است، نخست‌زاده تمامی آفریدگان."
        },
        {
          "verse": 16,
          "usfm": "COL.1.16",
          "line_type": "p",
          "text": "زیرا که در او همه ‌چیز آفریده شد، آنچه در آسمان و آنچه بر زمین است از چیزهای دیدنی و نادیدنی و تختها و سلطنتها و ریاسات و قوات؛ همه به‌وسیلهٔ او و برای او آفریده شد."
        },
        {
          "verse": 17,
          "usfm": "COL.1.17",
          "line_type": "p",
          "text": "و او قبل از همه است و در وی همه ‌چیز قوام دارد."
        },
        {
          "verse": 18,
          "usfm": "COL.1.18",
          "line_type": "p",
          "text": "و او بدن یعنی کلیسا را سَر است، زیرا که او ابتدا است و نخست‌زاده از مردگان تا در همه ‌چیز، او اوّل شود."
        },
        {
          "verse": 19,
          "usfm": "COL.1.19",
          "line_type": "p",
          "text": "زیرا خدا رضا به این داد که تمامی پری در او ساکن شود"
        },
        {
          "verse": 20,
          "usfm": "COL.1.20",
          "line_type": "p",
          "text": "و اینکه به واسطهٔ او همه ‌چیز را با خود آشتی دهد، چونکه به خون صلیب وی آشتی را پدید آورد. بلی به‌وسیلهٔ او خواه آنچه بر زمین و خواه آنچه در آسمان است."
        },
        {
          "verse": 21,
          "usfm": "COL.1.21",
          "line_type": "p",
          "text": "و شما را که سابق از نیت دل در کارهای بد خویش اجنبی و دشمن بودید، عملا آشتی داده است،"
        },
        {
          "verse": 22,
          "usfm": "COL.1.22",
          "line_type": "p",
          "text": "در بدن بشری خود به‌وسیله مرگ تا شما را در حضور خود مقدّس و بی‌عیب و بی‌ملامت حاضر سازد،"
        },
        {
          "verse": 23,
          "usfm": "COL.1.23",
          "line_type": "p",
          "text": "به شرطی که در ایمان بنیاد نهاده و استوار بمانید و جنبش نخورید از امید انجیل که در آن تعلیم یافته‌اید و به تمامی خلقت زیر آسمان به آن موعظه شده است و من پولس خادم آن شده‌ام."
        },
        {
          "verse": 24,
          "usfm": "COL.1.24",
          "line_type": "p",
          "text": "الان از عذابهای خود در راه شما شادی می‌کنم و کاستی زحمات مسیح را در بدن خود به ‌کمال می‌رسانم برای بدن او که کلیسا است،"
        },
        {
          "verse": 25,
          "usfm": "COL.1.25",
          "line_type": "p",
          "text": "که من خادم آن گشته‌ام مطابق کار نظارت خدا که به من برای شما سپرده شد تا کلام خدا را به‌ کمال رسانم؛"
        },
        {
          "verse": 26,
          "usfm": "COL.1.26",
          "line_type": "p",
          "text": "یعنی آن رازی که از شروع عصرها و قرنها مخفی داشته شده بود، لیکن اکنون به مقدّسین او آشکار گردید،"
        },
        {
          "verse": 27,
          "usfm": "COL.1.27",
          "line_type": "p",
          "text": "که خدا اراده نمود تا بشناساند که چیست دولت جلال این راز در میان غیریهودیان که آن مسیح در شما و امید جلال است."
        },
        {
          "verse": 28,
          "usfm": "COL.1.28",
          "line_type": "p",
          "text": "و ما او را اعلان می‌نماییم، در حالتی که هر شخص را هشدار می‌دهیم و هر کس را به هر حکمت می‌آموزیم تا هر کس را کامل در مسیح حاضر سازیم."
        },
        {
          "verse": 29,
          "usfm": "COL.1.29",
          "line_type": "p",
          "text": "و برای این نیز زحمت می‌کشم و مجاهده می‌نمایم مطابق عمل او که در من به قوت کار می‌کند."
        }
      ],
      "verse_count": 29,
      "headings": [
        {
          "before_verse": 3,
          "text": "شکرگزاری و دعا"
        },
        {
          "before_verse": 15,
          "text": "برتری مسیح"
        },
        {
          "before_verse": 24,
          "text": "خدمات پولس برای کلیسا"
        }
      ],
