  "chapters": [
    {
      "schema_version": 6,
      "book_id": "3JN",
      "chapter": 1,
      "chapter_usfm": "3JN.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "3JN.1.1",
          "line_type": "p",
          "text": "من که پیرم، به گایوس عزیز که او را در حقیقت محبّت می‌نمایم."
        },
        {
          "verse": 2,
          "usfm": "3JN.1.2",
          "line_type": "p",
          "text": "‌ای عزیز، دعا می‌کنم که از هر جهت کامیاب و تندرست بوده باشی، چنانکه جان تو کامیاب است."
        },
        {
          "verse": 3,
          "usfm": "3JN.1.3",
          "line_type": "p",
          "text": "زیرا که بسیار شاد شدم چون برادران آمدند و بر وفاداری تو به حقیقت شهادت دادند، چنانکه تو در حقیقت زندگی می‌نمایی."
        },
        {
          "verse": 4,
          "usfm": "3JN.1.4",
          "line_type": "p",
          "text": "مرا بیش از این شادی نیست که بشنوم که فرزندانم در حقیقت رفتار می‌نمایند."
        },
        {
          "verse": 5,
          "usfm": "3JN.1.5",
          "line_type": "p",
          "text": "‌ای عزیز، آنچه می‌کنی به برادران، به ویژه به غریبان، به امانت می‌کنی،"
        },
        {
          "verse": 6,
          "usfm": "3JN.1.6",
          "line_type": "p",
          "text": "که در حضور کلیسا بر محبّت تو شهادت دادند و هرگاه ایشان را به طور شایسته خدا بدرقه کنی، نیکویی نشان می‌دهی،"
        },
        {
          "verse": 7,
          "usfm": "3JN.1.7",
          "line_type": "p",
          "text": "زیرا که به خاطر اسم او بیرون رفتند و از غیریهودیان چیزی نمی‌گیرند."
        },
        {
          "verse": 8,
          "usfm": "3JN.1.8",
          "line_type": "p",
          "text": "پس بر ما واجب است که چنین اشخاص را بپذیریم تا شریک حقیقت بشویم."
        },
        {
          "verse": 9,
          "usfm": "3JN.1.9",
          "line_type": "p",
          "text": "به کلیسا چیزی نوشتم لیکن دیوت‌رِفیس که دوست دارد همیشه خود را اوّل قرار دهد، ما را قبول نمی‌کند."
        },
        {
          "verse": 10,
          "usfm": "3JN.1.10",
          "line_type": "p",
          "text": "بنابراین اگر آیم، کارهایی را که او می‌کند، به یاد خواهم آورد، زیرا به سخنان ناشایسته بر ما یاوه‌گویی می‌کند و به این قانع نشده، برادران را خود نمی‌پذیرد و کسانی را نیز که می‌خواهند، مانع ایشان می‌شود و از کلیسا بیرون می‌کند."
        },
        {
          "verse": 11,
          "usfm": "3JN.1.11",
          "line_type": "p",
          "text": "‌ای عزیز، از بدی نمونه مگیر، بلکه از نیکویی، زیرا نیکو‌کردار از خداست و بدکردار خدا را ندیده است."
        },
        {
          "verse": 12,
          "usfm": "3JN.1.12",
          "line_type": "p",
          "text": "همهٔ مردم و خود حقیقت نیز بر دیمیتریوس شهادت می‌دهند و ما هم شهادت می‌دهیم و آگاهید که شهادت ما راست است."
        },
        {
          "verse": 13,
          "usfm": "3JN.1.13",
          "line_type": "p",
          "text": "مرا چیزهای بسیار بود که به تو بنویسم، لیکن نمی‌خواهم به مرکّب و قلم به تو بنویسم."
        },
        {
          "verse": 14,
          "usfm": "3JN.1.14",
          "line_type": "p",
          "text": "لیکن امیدوارم که به زودی تو را خواهم دید و زبانی گفتگو کنیم."
        },
        {
          "verse": 15,
          "usfm": "3JN.1.15",
          "line_type": "p",
          "text": "سلام بر تو باد. دوستان به تو سلام می‌رسانند. سلام مرا به دوستان نام‌ به‌ نام برسان."
        }
      ],
      "verse_count": 15,
