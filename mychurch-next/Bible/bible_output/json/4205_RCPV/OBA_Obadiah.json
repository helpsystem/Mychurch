  "chapters": [
    {
      "schema_version": 6,
      "book_id": "OBA",
      "chapter": 1,
      "chapter_usfm": "OBA.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "OBA.1.1",
          "line_type": "p",
          "text": "رویای عوبَدیا."
        },
        {
          "verse": 2,
          "usfm": "OBA.1.2",
          "line_type": "q1",
          "text": "اینک، من تو را کوچکترین قومها گردانیدم،و تو بسیار خوار هستی."
        },
        {
          "verse": 3,
          "usfm": "OBA.1.3",
          "line_type": "q1",
          "text": "‌ای که در شکافهای صخره ساکن هستی،و مسکن تو بلند می‌باشد،و در دل خود می‌گویی:«کیست که مرا به زمین فرود بیاورد؟»تکبّر دلت، تو را فریب داده است."
        },
        {
          "verse": 4,
          "usfm": "OBA.1.4",
          "line_type": "q1",
          "text": "خداوند می‌گوید:اگر چه خویشتن را مثل عقاب بلند سازی،و آشیانه خود را در میان ستارگان بگذاری،من تو را از آنجا فرود خواهم آورد."
        },
        {
          "verse": 5,
          "usfm": "OBA.1.5",
          "line_type": "q1",
          "text": "اگر دزدان یا غارت کنندگان،شب نزد تو آیند-چه مصیبتی در انتظارت خواهد بود! -آیا تنها به قدر کفایت غارت نمی‌کنند؟و اگر انگورچینان نزد تو آیند،آیا بعضی خوشه‌ها را نمی‌گذارند؟"
        },
        {
          "verse": 6,
          "usfm": "OBA.1.6",
          "line_type": "q1",
          "text": "چیزهای عیسو چگونه غارت شده!و گنجهای مخفی او چگونهبه تاراج رفته است!"
        },
        {
          "verse": 7,
          "usfm": "OBA.1.7",
          "line_type": "q1",
          "text": "همه آنانی که با تو هم​عهد بودند،تو را به سرحدت رانده‌اند،و صلح‌اندیشان تو، تو را فریب داده،بر تو غالب آمدندو خورندگان نان تو، دامی زیر تو گستردند.و تو از آن آگاه نیستی."
        },
        {
          "verse": 8,
          "usfm": "OBA.1.8",
          "line_type": "q1",
          "text": "خداوند می‌گوید:آیا در آن روز حکیمان اِدوم رانابود نخواهم گردانید؟و فهم را از کوه عیسو؟"
        },
        {
          "verse": 9,
          "usfm": "OBA.1.9",
          "line_type": "q1",
          "text": "جنگاوران تو، ‌ای تیمان،هراسان خواهند شدتا هر کس از کوه عیسوبه قتل ریشه​کن شود."
        },
        {
          "verse": 10,
          "usfm": "OBA.1.10",
          "line_type": "q1",
          "text": "به خاطر ظلمی که بر برادرت یعقوب نمودی،خجالت تو را خواهد پوشانیدو تا به ابد ریشه​کن خواهی شد."
        },
        {
          "verse": 11,
          "usfm": "OBA.1.11",
          "line_type": "q1",
          "text": "در روزی که به مقابل وی ایستاده بودی،هنگامی که غریبان اموال او را غارت نمودندو بیگانگان به دروازه‌هایش داخل شدند،و بر اورشلیم قرعه انداختند،تو نیز مثل یکی از آنها بودی."
        },
        {
          "verse": 12,
          "usfm": "OBA.1.12",
          "line_type": "q1",
          "text": "بر روز برادر خود هنگام مصیبتش نگاه مکن،و بر پسران یهودا در روزهلاکت ایشان شادی منما،و در روز تنگی ایشان لاف مزن."
        },
        {
          "verse": 13,
          "usfm": "OBA.1.13",
          "line_type": "q1",
          "text": "و به دروازه های قوم مندر روز بلای ایشان داخل مشوو تو نیز بر بدی ایشان در روز بلای ایشان منگرو دست خود را بر اموال ایشاندر روز بلای ایشان دراز مکن."
        },
        {
          "verse": 14,
          "usfm": "OBA.1.14",
          "line_type": "q1",
          "text": "و بر سر دو راه مایستتا فراریان ایشان را ریشه​کن سازی.و باقیماندگان ایشان رادر روز تنگی تسلیم منما."
        },
        {
          "verse": 15,
          "usfm": "OBA.1.15",
          "line_type": "q1",
          "text": "زیرا که روز خداوند بر تمامی قومها نزدیک استو چنانکه عمل نمودی،همچنان به تو عمل کرده خواهد شدو اعمالت بر سرت خواهد برگشت."
        },
        {
          "verse": 16,
          "usfm": "OBA.1.16",
          "line_type": "q1",
          "text": "زیرا چنانکه بر کوه مقدس من نوشیدید،همچنان تمامی قومها خواهند نوشیدو آشامیده، خواهند بلعیدو چنان خواهند شد که گویا نبوده‌اند."
        },
        {
          "verse": 17,
          "usfm": "OBA.1.17",
          "line_type": "q1",
          "text": "اما بر کوه صَهیون نجات خواهد بودو مقدس خواهد شدو خاندان یعقوب میراث خود رابه تصرف خواهند ‌آورد."
        },
        {
          "verse": 18,
          "usfm": "OBA.1.18",
          "line_type": "q1",
          "text": "و خاندان یعقوب آتشو خاندان یوسف شعلهو خاندان عیسو کاه خواهند بودو در میان ایشان مشتعل شده،ایشان را خواهد سوزانیدو برای خاندان عیسوباقیمانده‌ای نخواهد ماند،زیرا خداوند صحبت نموده است."
        },
        {
          "verse": 19,
          "usfm": "OBA.1.19",
          "line_type": "q1",
          "text": "و اهل نِگِب کوه عیسو راو اهل هامون فلسطینیان رابه تصرف خواهند ‌آوردو صحرای اِفرایم و صحرای سامره رابه تصرف خواهند ‌آوردو بنیامین جِلعاد را متصرف خواهد شد."
        },
        {
          "verse": 20,
          "usfm": "OBA.1.20",
          "line_type": "q1",
          "text": "و اسیران این لشکر قوم اسرائیل،سرزمین کنعانیان را تا صَرَفهبه تصرف خواهند ‌آوردو اسیران اورشلیم که در صَرِفه هستند،شهرهای نِگِب را به تصرف خواهند ‌آورد."
        },
        {
          "verse": 21,
          "usfm": "OBA.1.21",
          "line_type": "q1",
          "text": "و نجات دهندگان به کوه صَهیون برآمده،بر کوه عیسو داوری خواهند کردو پادشاهی از آنِ خداوند خواهد شد!"
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 2,
          "text": "نابودی اَدوم"
        },
        {
          "before_verse": 10,
          "text": "خشونت اَدوم بر اسرائیل"
        }
      ],
