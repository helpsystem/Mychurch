    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 3,
      "chapter_usfm": "JON.3",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.3.1",
          "line_type": "p",
          "text": "پس کلام خداوند بار دوم بر یونس نازل شده، گفت:"
        },
        {
          "verse": 2,
          "usfm": "JON.3.2",
          "line_type": "p",
          "text": "«برخیز و به نینوا شهر بزرگ برو و آن پیامی را که من به تو خواهم گفت، به ایشان ندا کن.»"
        },
        {
          "verse": 3,
          "usfm": "JON.3.3",
          "line_type": "p",
          "text": "آنگاه یونس برخاسته، مطابق فرمان خداوند به نینوا رفت و نینوا شهری بزرگ بود و گردش در درون آن سه روز طول می‌کشید."
        },
        {
          "verse": 4,
          "usfm": "JON.3.4",
          "line_type": "p",
          "text": "یونس به شهر داخل شده و به مسافت یک روز رفت و به ندا کردن آغاز کرد و گفت: «بعد از چهل روز نینوا سرنگون خواهد شد.»"
        },
        {
          "verse": 5,
          "usfm": "JON.3.5",
          "line_type": "p",
          "text": "مردمان نینوا به خدا ایمان آوردند و به روزه اعلام کرده، از بزرگ تا کوچک پلاس پوشیدند."
        },
        {
          "verse": 6,
          "usfm": "JON.3.6",
          "line_type": "p",
          "text": "و چون پادشاه نینوا از این امر اطلاع یافت، از تخت خود برخاسته، ردای خود را از برکند و پلاس پوشیده، بر خاکستر نشست."
        },
        {
          "verse": 7,
          "usfm": "JON.3.7",
          "line_type": "p",
          "text": "پادشاه فرمانی صادر کرد و فرمان در سراسر نینوا جار کشیده شد: «به فرمان پادشاه و بزرگانش، هیچ انسان یا حیوان، گله یا رمه، چیزی نخورند و نچرند و آب ننوشند."
        },
        {
          "verse": 8,
          "usfm": "JON.3.8",
          "line_type": "p",
          "text": "انسان و حیوان پلاس پوشیده، نزد خدا به شدت التماس نمایند و هر کس از راه بد خود و از ظلمی که در دست او است، بازگشت نماید."
        },
        {
          "verse": 9,
          "usfm": "JON.3.9",
          "line_type": "p",
          "text": "کسی چه می‌داند؟ شاید خدا منصرف شده، از شدت خشم خود برگردد، تا هلاک نشویم.»"
        },
        {
          "verse": 10,
          "usfm": "JON.3.10",
          "line_type": "p",
          "text": "پس چون خدا کارهای ایشان را دید که از راه زشت خود بازگشت نمودند، آنگاه خدا از بلایی که گفته بود که به ایشان برساند، منصرف شد و آن را به عمل نیاورد."
        }
      ],
