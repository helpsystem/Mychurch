  "chapters": [
    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 1,
      "chapter_usfm": "JON.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.1.1",
          "line_type": "p",
          "text": "و کلام خداوند بر یونس پسر اَمِتّای نازل شده، گفت:"
        },
        {
          "verse": 2,
          "usfm": "JON.1.2",
          "line_type": "p",
          "text": "«برخیز و به نینوا شهر بزرگ برو و به ضد آن فریاد برآور، زیرا که شرارت ایشان به حضور من برآمده است.»"
        },
        {
          "verse": 3,
          "usfm": "JON.1.3",
          "line_type": "p",
          "text": "اما یونس برخاست تا از حضور خداوند به ترشیش فرار کند. پس به یافا فرود آمده، کشتی‌ای یافت که عازم ترشیش بود. پس کرایه‌اش را داده، سوار شد تا همراه ایشان از حضور خداوند به ترشیش برود."
        },
        {
          "verse": 4,
          "usfm": "JON.1.4",
          "line_type": "p",
          "text": "اما خداوند باد شدیدی بر دریا وزانید که تلاطم بزرگی در دریا پدید آمد، چنانکه نزدیک بود که کشتی در هم بشکند."
        },
        {
          "verse": 5,
          "usfm": "JON.1.5",
          "line_type": "p",
          "text": "ملاحان ترسان شده، هر کدام نزد خدای خود التماس نمودند و باری را که در کشتی بود، به دریا ریختند تا آن را سبک سازند. اما یونس در درون کشتی آمده دراز کشید و خواب سنگینی او را در ربود."
        },
        {
          "verse": 6,
          "usfm": "JON.1.6",
          "line_type": "p",
          "text": "و ناخدای کشتی نزد او آمده، وی را گفت: «چگونه می‌توانی راحت بخوابی؟ برخیز و خدای خود را بخوان، شاید که آن خدا ما را به خاطر آوَرَد تا هلاک نشویم.»"
        },
        {
          "verse": 7,
          "usfm": "JON.1.7",
          "line_type": "p",
          "text": "و به یکدیگر گفتند: «بیایید قرعه بیندازیم تا بدانیم که این بلا به خاطر چه کسی بر ما وارد شده است؟» پس چون قرعه انداختند، قرعه به نام یونس افتاد."
        },
        {
          "verse": 8,
          "usfm": "JON.1.8",
          "line_type": "p",
          "text": "پس او را گفتند: «ما را اطلاع ده که این بلا به خاطر چه کسی بر ما نازل شده؟ شغل تو چیست و از کجا آمده‌ای و وطنت کدام است و از چه قوم هستی؟»"
        },
        {
          "verse": 9,
          "usfm": "JON.1.9",
          "line_type": "p",
          "text": "او ایشان را جواب داد: «من عبرانی هستم و ترس یهوه خدای آسمان را به دل دارم که دریا و خشکی را آفریده است.»"
        },
        {
          "verse": 10,
          "usfm": "JON.1.10",
          "line_type": "p",
          "text": "پس آن مردمان سخت‌ ترسان شدند و او را گفتند: «چه کرده‌ای؟» زیرا که ایشان می‌دانستند که از حضور خداوند فرار کرده است، چونکه ایشان را اطلاع داده بود."
        },
        {
          "verse": 11,
          "usfm": "JON.1.11",
          "line_type": "p",
          "text": "و او را گفتند: «با تو چه کنیم تا دریا برای ما ساکن شود؟» زیرا دریا در تلاطم همی افزود."
        },
        {
          "verse": 12,
          "usfm": "JON.1.12",
          "line_type": "p",
          "text": "یونس به ایشان گفت: «مرا برداشته، به دریا بیندازید و دریا برای شما ساکن خواهد شد، زیرا می‌دانم این تلاطم بزرگ به سبب من بر شما وارد آمده است.»"
        },
        {
          "verse": 13,
          "usfm": "JON.1.13",
          "line_type": "p",
          "text": "اما آن مردمان سعی نمودند تا کشتی را به خشکی برسانند، اما نتوانستند، زیرا که دریا به ضد ایشان زیاده و زیاده تلاطم می‌نمود."
        },
        {
          "verse": 14,
          "usfm": "JON.1.14",
          "line_type": "p",
          "text": "پس نزد یهوه دعا کرده، گفتند: «آه، ‌ای خداوند، به‌ خاطر جان این شخص هلاک نشویم و خون بی‌گناه را بر ما مگذار زیرا تو، ‌ای خداوند، هر‌ چه بخواهی، می‌کنی.»"
        },
        {
          "verse": 15,
          "usfm": "JON.1.15",
          "line_type": "p",
          "text": "پس یونس را برداشته، در دریا انداختند و دریا از تلاطمش آرام شد."
        },
        {
          "verse": 16,
          "usfm": "JON.1.16",
          "line_type": "p",
          "text": "آن مردان از خداوند سخت‌ ترسان شدند و برای خداوند قربانی‌ها تقدیم کردند و نذرها نمودند."
        },
        {
          "verse": 17,
          "usfm": "JON.1.17",
          "line_type": "p",
          "text": "و اما خداوند ماهی بزرگی برگماشت که یونس را فرو بلعید. یونس سه روز و سه شب در شکم ماهی ماند."
        }
      ],
      "verse_count": 17,
