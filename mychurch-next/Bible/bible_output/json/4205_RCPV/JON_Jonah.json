    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 2,
      "chapter_usfm": "JON.2",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.2.1",
          "line_type": "p",
          "text": "و یونس از شکم ماهی نزد یهوه خدای خود دعا نمود"
        },
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "line_type": "p",
          "text": "و گفت:«در تنگی خود خداوند را خواندمو مرا قبول فرمود.از شکم عالم مردگان التماس نمودم،و صدای مرا شنیدی."
        },
        {
          "verse": 3,
          "usfm": "JON.2.3",
          "line_type": "q1",
          "text": "زیرا که مرا به ژرفا در دل دریاها انداختی،و سیلها مرا احاطه نمود.تمامی خیزابها و موجهای تو بر من گذشت."
        },
        {
          "verse": 4,
          "usfm": "JON.2.4",
          "line_type": "q1",
          "text": "و گفتم: ”از چشم تو افتادم.لیکن معبد قُدس تو را باز خواهم دید.“"
        },
        {
          "verse": 5,
          "usfm": "JON.2.5",
          "line_type": "q1",
          "text": "آبها مرا به زیر کشید تا جانم را بگیرد؛ژرفا مرا در میان گرفت؛خزه‌ها دور سرم پیچیده شد."
        },
        {
          "verse": 6,
          "usfm": "JON.2.6",
          "line_type": "q1",
          "text": "به بُن کوه‌ها فرو رفتم،و زمین به بندهای خود مرا برای همیشه در‌گرفت.اما تو، ‌ای یهوه خدایم،حیات مرا از گور بیرون کشیدی."
        },
        {
          "verse": 7,
          "usfm": "JON.2.7",
          "line_type": "q1",
          "text": "چون جان من در درونم بی‌تاب شد،خداوند را به یاد آوردمو دعای من نزد تو به معبد مقدست رسید."
        },
        {
          "verse": 8,
          "usfm": "JON.2.8",
          "line_type": "q1",
          "text": "آنانی که به بتهای پوچ ارزش می‌دهند،امیدشان را به محبت بی‌زوال ترک می‌نمایند."
        },
        {
          "verse": 9,
          "usfm": "JON.2.9",
          "line_type": "q1",
          "text": "اما من به آواز شکرگزاریبرای تو قربانی خواهم گذرانید،و به آنچه نذر کردم، وفا خواهم نمود.نجات از آنِ خداوند است.»"
        },
        {
          "verse": 10,
          "usfm": "JON.2.10",
          "line_type": "m",
          "text": "پس خداوند ماهی را امر فرمود و ماهی یونس را بر خشکی قی کرد."
        }
      ],
