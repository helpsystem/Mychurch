    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 3,
      "chapter_usfm": "2TH.3",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.3.1",
          "line_type": "p",
          "text": "خلاصه ‌ای برادران، برای ما دعا کنید تا کلام خداوند جاری شود و جلال یابد، چنانکه در میان شما نیز؛"
        },
        {
          "verse": 2,
          "usfm": "2TH.3.2",
          "line_type": "p",
          "text": "و تا از مردم ناشایسته شریر رهایی یابیم، زیرا که همه را ایمان نیست."
        },
        {
          "verse": 3,
          "usfm": "2TH.3.3",
          "line_type": "p",
          "text": "امّا امین است آن خداوندی که شما را استوار و از شریر محفوظ خواهد ساخت."
        },
        {
          "verse": 4,
          "usfm": "2TH.3.4",
          "line_type": "p",
          "text": "امّا بر شما در خداوند اعتماد داریم که آنچه به شما امر کنیم، به عمل می‌آورید و نیز خواهید آورد."
        },
        {
          "verse": 5,
          "usfm": "2TH.3.5",
          "line_type": "p",
          "text": "و خداوند دلهای شما را به محبّت خدا و به صبر مسیح هدایت کند."
        },
        {
          "verse": 6,
          "usfm": "2TH.3.6",
          "line_type": "p",
          "text": "ولی ‌ای برادران، شما را به نام خداوند خود عیسی مسیح امر می‌کنیم که از هر برادری که بی‌نظم رفتار می‌کند و نه مطابق آن قانونی که از ما یافته‌اید، دوری کنید."
        },
        {
          "verse": 7,
          "usfm": "2TH.3.7",
          "line_type": "p",
          "text": "زیرا خود آگاه هستید که به چه نوع از ما نمونه باید گرفت، چونکه در میان شما بی‌نظم رفتار نکردیم"
        },
        {
          "verse": 8,
          "usfm": "2TH.3.8",
          "line_type": "p",
          "text": "و نان هیچ‌‌کس را مفت نخوردیم، بلکه به زحمت و مشقت شبانه‌روز به ‌کار مشغول می‌بودیم تا بر کسی از شما بار نگذاریم."
        },
        {
          "verse": 9,
          "usfm": "2TH.3.9",
          "line_type": "p",
          "text": "نه آنکه اختیار نداریم بلکه تا خود را نمونه برای شما سازیم تا از ما سرمشق گیرید."
        },
        {
          "verse": 10,
          "usfm": "2TH.3.10",
          "line_type": "p",
          "text": "زیرا هنگامی که نزد شما هم می‌بودیم، این را به شما امر فرمودیم که اگر کسی خواهد کار نکند، خوراک هم نخورد."
        },
        {
          "verse": 11,
          "usfm": "2TH.3.11",
          "line_type": "p",
          "text": "زیرا شنیدیم که بعضی در میان شما بی‌نظم رفتار می‌کنند که کاری نمی کنند، بلکه فضول هستند."
        },
        {
          "verse": 12,
          "usfm": "2TH.3.12",
          "line_type": "p",
          "text": "امّا چنین اشخاص را در خداوند ما عیسی مسیح امر و نصیحت می‌کنیم که به آرامی کار کرده، نان خود را بخورند."
        },
        {
          "verse": 13,
          "usfm": "2TH.3.13",
          "line_type": "p",
          "text": "امّا شما‌ ای برادران، از نیکوکاری خسته خاطر مشوید."
        },
        {
          "verse": 14,
          "usfm": "2TH.3.14",
          "line_type": "p",
          "text": "ولی اگر کسی سخن ما را در این رساله اطاعت نکند، بر او نشانه گذارید و با وی معاشرت مکنید، تا شرمنده شود."
        },
        {
          "verse": 15,
          "usfm": "2TH.3.15",
          "line_type": "p",
          "text": "امّا او را دشمن مشمارید، بلکه چون برادر او را تنبیه کنید."
        },
        {
          "verse": 16,
          "usfm": "2TH.3.16",
          "line_type": "p",
          "text": "امّا خود خداوندِ سلامتی، شما را پیوسته در هر صورت، سلامتی عطا کند. خداوند با همگی شما باد."
        },
        {
          "verse": 17,
          "usfm": "2TH.3.17",
          "line_type": "p",
          "text": "سلام به ‌دست من پولس که نشانه در هر رساله است، به اینطور می‌نویسم:"
        },
        {
          "verse": 18,
          "usfm": "2TH.3.18",
          "line_type": "p",
          "text": "فیض خداوند ما عیسی مسیح با همه شما باد. آمین."
        }
      ],
