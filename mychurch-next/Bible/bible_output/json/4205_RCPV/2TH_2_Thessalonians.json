  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 1,
      "chapter_usfm": "2TH.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.1.1",
          "line_type": "p",
          "text": "پولس و سِلوانُس و تیموتائوس، به کلیسای تِسالونیکیان که در خدای پدر ما و عیسی مسیح خداوند می‌باشید."
        },
        {
          "verse": 2,
          "usfm": "2TH.1.2",
          "line_type": "p",
          "text": "فیض و سلامتی از جانب پدر ما خدا و عیسی مسیح خداوند بر شما باد."
        },
        {
          "verse": 3,
          "usfm": "2TH.1.3",
          "line_type": "p",
          "text": "‌ای برادران، می‌باید همیشه به خاطر شما خدا را شکر کنیم، چنانکه سزاوار است، از آنجا که ایمان شما بسیار رشد می‌کند و محبّت هر یکی از شما به یکدیگر می‌افزاید،"
        },
        {
          "verse": 4,
          "usfm": "2TH.1.4",
          "line_type": "p",
          "text": "به حدّی که خود ما در مورد شما در کلیساهای خدا فخر می‌کنیم به خاطر صبر و ایمانتان در همهٔ زحمات شما و عذابهایی که متحمّل آنها می‌شوید،"
        },
        {
          "verse": 5,
          "usfm": "2TH.1.5",
          "line_type": "p",
          "text": "که دلیل است بر داوری عادل خدا تا شما سزاوار پادشاهی خدا بشوید، که برای آن هم زحمت می‌کشید."
        },
        {
          "verse": 6,
          "usfm": "2TH.1.6",
          "line_type": "p",
          "text": "زیرا که این انصاف است نزد خدا که عذاب کنندگان شما را عذاب دهد."
        },
        {
          "verse": 7,
          "usfm": "2TH.1.7",
          "line_type": "p",
          "text": "و شما را که عذاب می‌کشید، با ما راحت بخشد در هنگامی که عیسی خداوند از آسمان با فرشتگان نیرومند خود ظهور خواهد نمود"
        },
        {
          "verse": 8,
          "usfm": "2TH.1.8",
          "line_type": "p",
          "text": "در آتش مشتعل، و انتقام خواهد کشید از آنانی که خدا را نمی‌شناسند و انجیل خداوند ما عیسی را اطاعت نمی‌کنند،"
        },
        {
          "verse": 9,
          "usfm": "2TH.1.9",
          "line_type": "p",
          "text": "که ایشان به محکومیّت هلاکت جاودانی خواهند رسید از حضور خداوند و جلال قوت او"
        },
        {
          "verse": 10,
          "usfm": "2TH.1.10",
          "line_type": "p",
          "text": "هنگامی که آید تا در مقدّسان خود جلال یابد و در همه ایمانداران از او تعجّب کنند در آن روز، زیرا که شما شهادت ما را تصدیق کردید."
        },
        {
          "verse": 11,
          "usfm": "2TH.1.11",
          "line_type": "p",
          "text": "و برای این هم پیوسته برای شما دعا می‌کنیم که خدای ما شما را سزاوار این دعوت شمارد و تمام مسرّت نیکویی و عمل ایمان را با قوّت کامل گرداند،"
        },
        {
          "verse": 12,
          "usfm": "2TH.1.12",
          "line_type": "p",
          "text": "تا نام خداوند ما عیسی در شما تمجید یابد و شما در وی مطابق فیض خدای ما و عیسی مسیح خداوند."
        }
      ],
      "verse_count": 12,
      "headings": [
        {
          "before_verse": 3,
          "text": "شکرگزاری"
        }
      ],
