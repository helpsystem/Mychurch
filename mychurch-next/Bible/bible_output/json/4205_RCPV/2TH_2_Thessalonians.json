    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 2,
      "chapter_usfm": "2TH.2",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.2.1",
          "line_type": "p",
          "text": "امّا ‌ای برادران، از شما خواهش می‌کنیم دربارهٔ آمدن خداوند ما عیسی مسیح و جمع شدن ما به نزد او،"
        },
        {
          "verse": 2,
          "usfm": "2TH.2.2",
          "line_type": "p",
          "text": "که شما از هوش خود به زودی پریشان نشوید و مضطرب نگردید، نه از روح و نه از کلام و نه از رساله‌ای که گویا از ما باشد، به این مضمون که روز خداوند رسیده است."
        },
        {
          "verse": 3,
          "usfm": "2TH.2.3",
          "line_type": "p",
          "text": "به هوش باشید که کسی به هیچ وجه شما را نفریبد، زیرا که تا آن عصیان، اوّل واقع نشود و آن مرد بی‌دین یعنی فرزند هلاکت آشکار نگردد، آن روز نخواهد آمد؛"
        },
        {
          "verse": 4,
          "usfm": "2TH.2.4",
          "line_type": "p",
          "text": "که او مخالفت می‌کند و خود را بلندتر می‌سازد از هر‌ چه خدا و پرستیدنی خوانده شود، به حدّی که در معبد خدا نشسته، خود را می نماید که خداست."
        },
        {
          "verse": 5,
          "usfm": "2TH.2.5",
          "line_type": "p",
          "text": "آیا یاد نمی‌کنید که هنگامی که هنوز نزد شما می بودم، این را به شما می‌گفتم؟"
        },
        {
          "verse": 6,
          "usfm": "2TH.2.6",
          "line_type": "p",
          "text": "و الآن آنچه را که مانع است می‌دانید تا او در زمان خود ظاهر بشود."
        },
        {
          "verse": 7,
          "usfm": "2TH.2.7",
          "line_type": "p",
          "text": "زیرا که آن راز بی‌دینی هم‌اکنون کار می‌کند فقط تا وقتی که آنکه تا به حال مانع است، از میان برداشته شود."
        },
        {
          "verse": 8,
          "usfm": "2TH.2.8",
          "line_type": "p",
          "text": "آنگاه آن بی‌دین آشکار خواهد شد که عیسی خداوند او را به نَفَس دهان خود هلاک خواهد کرد و به تجلّی ظهور خویش، او را نابود خواهد ساخت؛"
        },
        {
          "verse": 9,
          "usfm": "2TH.2.9",
          "line_type": "p",
          "text": "که ظهور آن بی‌دین به عمل شیطان است با هر نوع قوّت و نشانه‌ها و عجایب دروغ،"
        },
        {
          "verse": 10,
          "usfm": "2TH.2.10",
          "line_type": "p",
          "text": "و به هر قسم فریب ناراستی برای هالکان، از آنجا که محبّت حقیقت را نپذیرفتند تا نجات یابند."
        },
        {
          "verse": 11,
          "usfm": "2TH.2.11",
          "line_type": "p",
          "text": "و به این جهت خدا به ایشان عمل گمراهی می‌فرستد تا دروغ را باور کنند"
        },
        {
          "verse": 12,
          "usfm": "2TH.2.12",
          "line_type": "p",
          "text": "و تا محکوم شود بر همهٔ کسانی که حقیقت را باور نکردند، بلکه به ناراستی شاد شدند."
        },
        {
          "verse": 13,
          "usfm": "2TH.2.13",
          "line_type": "p",
          "text": "امّا ‌ای برادران و ‌ای عزیزان خداوند، می‌باید ما همیشه برای شما خدا را شکر نماییم که از ابتدا خدا شما را برگزید برای نجات به تقدیس روح و ایمان به حقیقت."
        },
        {
          "verse": 14,
          "usfm": "2TH.2.14",
          "line_type": "p",
          "text": "و برای آن شما را دعوت کرد به‌وسیلهٔ مژدهٔ ما برای نائل شدن به جلال خداوند ما عیسی مسیح."
        },
        {
          "verse": 15,
          "usfm": "2TH.2.15",
          "line_type": "p",
          "text": "پس‌ ای برادران، استوار باشید و آن سنتها را که خواه از کلام و خواه از رسالهٔ ما آموخته‌اید، نگاه دارید."
        },
        {
          "verse": 16,
          "usfm": "2TH.2.16",
          "line_type": "p",
          "text": "و خود خداوند ما عیسی مسیح و خدا و پدر ما که ما را محبّت نمود و تسلّی ابدی و امید نیکو را به فیض خود به ما بخشید،"
        },
        {
          "verse": 17,
          "usfm": "2TH.2.17",
          "line_type": "p",
          "text": "دلهای شما را تسلی عطا کند و شما را در هر عمل و سخن نیکو استوار گرداند."
        }
      ],
      "verse_count": 17,
