  "chapters": [
    {
      "schema_version": 6,
      "book_id": "PHM",
      "chapter": 1,
      "chapter_usfm": "PHM.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHM.1.1",
          "line_type": "p",
          "text": "پولس، محبوس به خاطر مسیح عیسی، و تیموتائوس برادر ما،به فِلیمون عزیز و همکار ما"
        },
        {
          "verse": 2,
          "usfm": "PHM.1.2",
          "line_type": "p",
          "text": "به آپفیا خواهر ما و آرخیپوس همرزم ما، و به کلیسایی که در خانه‌ات می‌باشد."
        },
        {
          "verse": 3,
          "usfm": "PHM.1.3",
          "line_type": "p",
          "text": "فیض و سلامتی از جانب پدر ما خدا و عیسی مسیح خداوند با شما باد."
        },
        {
          "verse": 4,
          "usfm": "PHM.1.4",
          "line_type": "p",
          "text": "خدای خود را شکر می‌کنم و پیوسته تو را در دعاهای خود یاد می‌آورم،"
        },
        {
          "verse": 5,
          "usfm": "PHM.1.5",
          "line_type": "p",
          "text": "چونکه وصف محبّت و ایمان تو را شنیده‌ام که به عیسی خداوند و به همه مقدّسین داری،"
        },
        {
          "verse": 6,
          "usfm": "PHM.1.6",
          "line_type": "p",
          "text": "تا شراکت ایمانت مؤثر شود در معرفت کامل هر نیکویی که در ما است برای مسیح."
        },
        {
          "verse": 7,
          "usfm": "PHM.1.7",
          "line_type": "p",
          "text": "زیرا که مرا شادی کامل و تسلّی رخ نمود از محبّت تو از آن رو که دلهای مقدّسین از تو، ‌ای برادر، استراحت می‌پذیرند."
        },
        {
          "verse": 8,
          "usfm": "PHM.1.8",
          "line_type": "p",
          "text": "به این جهت هرچند در مسیح کمال جسارت را دارم که به آنچه مناسب است تو را امر دهم،"
        },
        {
          "verse": 9,
          "usfm": "PHM.1.9",
          "line_type": "p",
          "text": "لیکن برای محبّت، شایسته‌تر آن است که التماس نمایم، هرچند مردی چون پولس پیر، و اکنون به خاطر مسیح عیسی زندانی نیز می‌باشم."
        },
        {
          "verse": 10,
          "usfm": "PHM.1.10",
          "line_type": "p",
          "text": "پس تو را التماس می‌کنم دربارهٔ فرزند خود اونیسیموس که در زنجیرهای خود او را پدر شدم،"
        },
        {
          "verse": 11,
          "usfm": "PHM.1.11",
          "line_type": "p",
          "text": "که سابق او برای تو بی‌فایده بود، لیکن اکنون تو را و مرا فایده‌مند می‌باشد؛"
        },
        {
          "verse": 12,
          "usfm": "PHM.1.12",
          "line_type": "p",
          "text": "که او را نزد تو پس می‌فرستم. پس تو او را بپذیر که جان من است."
        },
        {
          "verse": 13,
          "usfm": "PHM.1.13",
          "line_type": "p",
          "text": "و من می‌خواستم که او را نزد خود نگاه دارم تا به عوض تو مرا در زنجیرهای انجیل خدمت کند."
        },
        {
          "verse": 14,
          "usfm": "PHM.1.14",
          "line_type": "p",
          "text": "امّا نخواستم کاری بدون نظر تو کرده باشم، تا نیکویی تو از روی اجبار نباشد، بلکه از روی میل و رغبت."
        },
        {
          "verse": 15,
          "usfm": "PHM.1.15",
          "line_type": "p",
          "text": "زیرا که شاید به این جهت مدّتی از تو جدا شد تا او را تا به ابد پیدا کنی."
        },
        {
          "verse": 16,
          "usfm": "PHM.1.16",
          "line_type": "p",
          "text": "لیکن بعد از این نه چون غلام، بلکه فوق از غلام یعنی برادر عزیز به ویژه به من، امّا چند مرتبه زیادتر به تو، هم در جسم و هم در خداوند."
        },
        {
          "verse": 17,
          "usfm": "PHM.1.17",
          "line_type": "p",
          "text": "پس هرگاه مرا رفیق می‌دانی، او را چون من قبول فرما."
        },
        {
          "verse": 18,
          "usfm": "PHM.1.18",
          "line_type": "p",
          "text": "امّا اگر ضرری به تو رسانیده باشد، یا طلبی از او داشته باشی، آن را به حساب من بگذار."
        },
        {
          "verse": 19,
          "usfm": "PHM.1.19",
          "line_type": "p",
          "text": "من، پولس، به دست خود می‌نویسم: آن را جبران خواهم کرد. نیازی به گفتنش هم نیست که جان خود را نیز مدیون من هستی."
        },
        {
          "verse": 20,
          "usfm": "PHM.1.20",
          "line_type": "p",
          "text": "بلی، ‌ای برادر، تا من از تو در خداوند برخوردار شوم. پس جان مرا در مسیح تازگی بده."
        },
        {
          "verse": 21,
          "usfm": "PHM.1.21",
          "line_type": "p",
          "text": "چون بر اطاعت تو اعتماد دارم، به تو می‌نویسم از آن جهت که می‌دانم بیشتر از آنچه می‌گویم هم خواهی کرد."
        },
        {
          "verse": 22,
          "usfm": "PHM.1.22",
          "line_type": "p",
          "text": "در ضمن اقامتگاهی نیز برای من حاضر کن، زیرا که امیدوارم از دعاهای شما، به شما بخشیده شوم."
        },
        {
          "verse": 23,
          "usfm": "PHM.1.23",
          "line_type": "p",
          "text": "اِپافراس که در مسیح عیسی همزندان من است و مرقُس"
        },
        {
          "verse": 24,
          "usfm": "PHM.1.24",
          "line_type": "p",
          "text": "و آریستارخوس و دیماس و لوقا همکاران من تو را سلام می‌رسانند."
        },
        {
          "verse": 25,
          "usfm": "PHM.1.25",
          "line_type": "p",
          "text": "فیض خداوند عیسی مسیح با روح شما باد. آمین."
        }
      ],
      "verse_count": 25,
      "headings": [
        {
          "before_verse": 4,
          "text": "محبّت و ایمان فِلیمون"
        },
        {
          "before_verse": 8,
          "text": "درخواست پولُس"
        }
      ],
