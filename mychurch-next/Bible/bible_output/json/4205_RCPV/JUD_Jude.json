  "chapters": [
    {
      "schema_version": 6,
      "book_id": "JUD",
      "chapter": 1,
      "chapter_usfm": "JUD.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JUD.1.1",
          "line_type": "p",
          "text": "یهودا، غلام عیسی مسیح و برادر یعقوب، به خوانده‌شدگانی که در خدای پدر عزیز و برای عیسی مسیح محفوظ می‌باشید."
        },
        {
          "verse": 2,
          "usfm": "JUD.1.2",
          "line_type": "p",
          "text": "رحمت و سلامتی و محبّت بر شما افزون باد."
        },
        {
          "verse": 3,
          "usfm": "JUD.1.3",
          "line_type": "p",
          "text": "‌ای عزیزان، چون شوق کامل داشتم که دربارهٔ نجاتی که در آن سهیم هستیم، به شما بنویسم، ناچار شدم که الآن به شما بنویسم و نصیحت دهم تا شما جد و جهد کنید برای آن ایمانی که یک بار به مقدّسین سپرده شد."
        },
        {
          "verse": 4,
          "usfm": "JUD.1.4",
          "line_type": "p",
          "text": "زیرا که بعضی اشخاص مخفیانه رخنه کرده‌اند که از قدیم برای این محکومیت تعیین شده بودند؛ مردمان بی‌دین که فیض خدای ما را به عیاشی تبدیل نموده و عیسی مسیح سَرور یکتا و خداوند ما را انکار کرده‌اند."
        },
        {
          "verse": 5,
          "usfm": "JUD.1.5",
          "line_type": "p",
          "text": "پس می‌خواهم شما را یاد دهم، هرچند از همه چیز خود یکبار آگاه شدید که بعد از آنکه خداوند، قوم را از زمین مصر رهایی بخشیده بود، بار دیگر بی‌ایمانان را هلاک فرمود."
        },
        {
          "verse": 6,
          "usfm": "JUD.1.6",
          "line_type": "p",
          "text": "و فرشتگانی را که ریاست خود را حفظ نکردند، بلکه مسکن حقیقی خود را ترک نمودند، در زنجیرهای ابدی در تحت ظلمت برای محکومیت روز عظیم نگاه داشته است."
        },
        {
          "verse": 7,
          "usfm": "JUD.1.7",
          "line_type": "p",
          "text": "و همچنین سُدوم و عَموره و سایر شهرهای نواحی آنها مثل ایشان چونکه زناکار شدند و آرزومند بدن غریب گشتند، در مکافات آتش ابدی گرفتار شده، به جهت عبرت تعیین شدند."
        },
        {
          "verse": 8,
          "usfm": "JUD.1.8",
          "line_type": "p",
          "text": "لیکن با وجود این، همه این خواب بینندگان نیز بدن خود را نجس می‌سازند و اقتدار خداوند را خوار می‌شمارند و بر بزرگان تهمت می‌زنند."
        },
        {
          "verse": 9,
          "usfm": "JUD.1.9",
          "line_type": "p",
          "text": "امّا میکائیل، رئیس ملائکه، چون دربارهٔ جسد موسی با ابلیس نزاع می‌کرد، جرأت ننمود که او را به سبب اهانت محکوم کند، بلکه گفت: «خداوند تو را توبیخ فرماید.»"
        },
        {
          "verse": 10,
          "usfm": "JUD.1.10",
          "line_type": "p",
          "text": "لیکن این اشخاص بر آنچه نمی‌دانند اهانت می‌کنند و در آنچه مثل حیوان بی‌شعور از روی غریزه فهمیده‌اند، خود را فاسد می سازند."
        },
        {
          "verse": 11,
          "usfm": "JUD.1.11",
          "line_type": "p",
          "text": "وای بر ایشان، زیرا که به راه قائن رفته‌اند و در گمراهی بَلعام به خاطر مزد غرق شده‌اند و در طغیان قورَح هلاک گشته‌اند."
        },
        {
          "verse": 12,
          "usfm": "JUD.1.12",
          "line_type": "p",
          "text": "اینها در مهمانی‌های محبّتانه شما صخره‌ها هستند چون با شما شادی می‌کنند، و شبانانی که خود را بی‌ترس پروار می‌کنند و ابرهای بی‌آب از بادها رانده شده و درختان پاییزی بی‌میوه، دوباره مرده و از ریشه‌ کنده شده،"
        },
        {
          "verse": 13,
          "usfm": "JUD.1.13",
          "line_type": "p",
          "text": "و امواج جوشیده دریا که رسوایی خود را مثل کف برمی‌آورند و ستارگان آواره هستند که برای ایشان تاریکی ظلمت جاودانی تعیین شده است."
        },
        {
          "verse": 14,
          "usfm": "JUD.1.14",
          "line_type": "p",
          "text": "لیکن خنوخ که هفتم از آدم بود، دربارهٔ همین اشخاص خبر داده، گفت: «اینک خداوند با هزاران هزار از مقدّسین خود آمد"
        },
        {
          "verse": 15,
          "usfm": "JUD.1.15",
          "line_type": "p",
          "text": "تا بر همه داوری نماید و همه بی‌دینان را محکوم کند، بر همه کارهای خلاف دینداری که در بی‌دینی کردند و بر تمامی سخنان زشت که گناهکاران بی‌دین به خلاف او گفتند.»"
        },
        {
          "verse": 16,
          "usfm": "JUD.1.16",
          "line_type": "p",
          "text": "اینانند غُرغُرکنان و گِله‌مندان که مطابق شهوات خود رفتار می‌نمایند و به زبان خود سخنان تکبرآمیز می‌گویند و در پی سودجویی از مردم طرفداری می‌کنند."
        },
        {
          "verse": 17,
          "usfm": "JUD.1.17",
          "line_type": "p",
          "text": "امّا شما‌ ای عزیزان، به خاطر آورید آن سخنانی که رسولان خداوند ما عیسی مسیح پیش گفته‌اند،"
        },
        {
          "verse": 18,
          "usfm": "JUD.1.18",
          "line_type": "p",
          "text": "چون به شما خبر دادند که در زمان آخر مسخره‌کنندگان خواهند آمد که مطابق شهوات بی‌دینی خود رفتار خواهند کرد."
        },
        {
          "verse": 19,
          "usfm": "JUD.1.19",
          "line_type": "p",
          "text": "اینانند که جدایی‌ها سبب می‌شوند و نفسانی هستند که روح را ندارند."
        },
        {
          "verse": 20,
          "usfm": "JUD.1.20",
          "line_type": "p",
          "text": "امّا شما‌ ای عزیزان، خود را به ایمان اَقدس خود بنا کرده و در روح‌القدس عبادت نموده،"
        },
        {
          "verse": 21,
          "usfm": "JUD.1.21",
          "line_type": "p",
          "text": "خود را در محبّت خدا محفوظ دارید و منتظر رحمت خداوند ما عیسی مسیح برای حیات جاودانی بوده باشید."
        },
        {
          "verse": 22,
          "usfm": "JUD.1.22",
          "line_type": "p",
          "text": "و به آنها که شک دارند، رحیم باشید."
        },
        {
          "verse": 23,
          "usfm": "JUD.1.23",
          "line_type": "p",
          "text": "و بعضی را از آتش بیرون کشیده، برهانید و بر بعضی با ترس رحمت کنید و از لباس جسم‌آلود نفرت نمایید."
        },
        {
          "verse": 24,
          "usfm": "JUD.1.24",
          "line_type": "p",
          "text": "الآن او را که قادر است که شما را از لغزش محفوظ دارد و در حضور جلال خود شما را بی‌عیب به شادی عظیم استوار فرماید،"
        },
        {
          "verse": 25,
          "usfm": "JUD.1.25",
          "line_type": "p",
          "text": "یعنی خدای یکتا و نجات‌دهنده ما را، به واسطه خداوند ما عیسی مسیح، جلال و عظمت و توانایی و قدرت باد، الآن و تا به ابد. آمین."
        }
      ],
      "verse_count": 25,
      "headings": [
        {
          "before_verse": 3,
          "text": "محکومیّت معلّمان دروغین"
        },
        {
          "before_verse": 17,
          "text": "دعوت به پایداری"
        },
        {
          "before_verse": 24,
          "text": "برکت پایانی"
        }
      ],
      "footnotes": [
        {
          "verse": 9,
          "usfm": "JUD.1.9",
          "note_ref": "1‏.9",
          "note_type": "footnote",
          "references": [],
          "text": "در اینجا معلوم نیست که یهودا از کدام منبع نقل قول می‌کند، لیکن در منبع مورد نظر یهودا، شیطان با بستن اتهام قتل، به موسی اهانت می‌کند و می‌خواهد بر این اساس از تدفین محترمانه جسد موسی به دست میکائیل جلوگیری نماید."
        }
      ],
