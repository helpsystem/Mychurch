  "chapters": [
    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 1,
      "chapter_usfm": "PHP.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.1.1",
          "line_type": "p",
          "text": "پولس و تیموتائوس، غلامان عیسی مسیح، به همهٔ مقدسین در مسیح عیسی که در فیلپی می‌باشند با اسقفان و شماسان."
        },
        {
          "verse": 2,
          "usfm": "PHP.1.2",
          "line_type": "p",
          "text": "فیض و سلامتی از جانب پدر ما خدا و عیسی مسیح خداوند بر شما باد."
        },
        {
          "verse": 3,
          "usfm": "PHP.1.3",
          "line_type": "p",
          "text": "هرگاه شما را به یاد می‌آورم، خدای خود را شکر می‌گذارم،"
        },
        {
          "verse": 4,
          "usfm": "PHP.1.4",
          "line_type": "p",
          "text": "و پیوسته در هر دعای خود برای تمامی شما به شادی دعا می‌کنم،"
        },
        {
          "verse": 5,
          "usfm": "PHP.1.5",
          "line_type": "p",
          "text": "به خاطر مشارکت شما برای انجیل از روز اوّل تا به حال."
        },
        {
          "verse": 6,
          "usfm": "PHP.1.6",
          "line_type": "p",
          "text": "چونکه به این اعتماد دارم که او که عمل نیکو را در شما شروع کرد، آن را تا روز عیسی مسیح به‌ کمال خواهد رسانید."
        },
        {
          "verse": 7,
          "usfm": "PHP.1.7",
          "line_type": "p",
          "text": "چنانکه مرا سزاوار است که دربارهٔ همه شما همین فکر کنم، زیرا که شما را در دل خود می‌دارم که در زنجیرهای من و در دفاع و اثبات انجیل همهٔ شما با من شریک در این نعمت هستید."
        },
        {
          "verse": 8,
          "usfm": "PHP.1.8",
          "line_type": "p",
          "text": "زیرا خدا مرا شاهد است که چقدر با شفقت درونی خود عیسی مسیح، مشتاق همهٔ شما هستم."
        },
        {
          "verse": 9,
          "usfm": "PHP.1.9",
          "line_type": "p",
          "text": "و برای این دعا می‌کنم تا محبّت شما در معرفت و کمالِ فهم، بسیار زیادتر شود."
        },
        {
          "verse": 10,
          "usfm": "PHP.1.10",
          "line_type": "p",
          "text": "تا چیزهای بهتر را برگزینید و در روز مسیح پاک و بی‌عیب باشید"
        },
        {
          "verse": 11,
          "usfm": "PHP.1.11",
          "line_type": "p",
          "text": "و پر شوید از میوهٔ عدالت که به‌وسیلهٔ عیسی مسیح برای تمجید و حمد خداست."
        },
        {
          "verse": 12,
          "usfm": "PHP.1.12",
          "line_type": "p",
          "text": "امّا ‌ای برادران، می‌خواهم شما بدانید که آنچه بر من واقع گشت، برعکس به رشد انجیل انجامید،"
        },
        {
          "verse": 13,
          "usfm": "PHP.1.13",
          "line_type": "p",
          "text": "به حدّی که زنجیرهای من آشکارا شد در مسیح به تمام گارد کاخ سلطنتی و به همه دیگران آشکار شد که به خاطر مسیح به زنجیرم."
        },
        {
          "verse": 14,
          "usfm": "PHP.1.14",
          "line_type": "p",
          "text": "و بسیاری از برادران در خداوند از زنجیرهای من اعتماد به هم رسانیده، بیشتر جرأت می‌کنند که کلام خدا را بی‌ترس بگویند."
        },
        {
          "verse": 15,
          "usfm": "PHP.1.15",
          "line_type": "p",
          "text": "امّا بعضی از حسد و ستیزه‌جویی به مسیح موعظه می‌کنند، ولی بعضی هم از خشنودی."
        },
        {
          "verse": 16,
          "usfm": "PHP.1.16",
          "line_type": "p",
          "text": "اینان از راه محبّت، چونکه می‌دانند که من به خاطر حمایت انجیل معین شده‌ام."
        },
        {
          "verse": 17,
          "usfm": "PHP.1.17",
          "line_type": "p",
          "text": "امّا آنان از روی جاه‌طلبی نه از روی خلوص نیّت به مسیح اعلام می‌کنند و گمان می‌برند که به زنجیرهای من زحمت می‌افزایند."
        },
        {
          "verse": 18,
          "usfm": "PHP.1.18",
          "line_type": "p",
          "text": "پس چه؟ جز اینکه به هر صورت، خواه به نیّت نادرست و خواه به درستی به مسیح موعظه می‌شود و از این شادمانم، بلکه شادی هم خواهم کرد،"
        },
        {
          "verse": 19,
          "usfm": "PHP.1.19",
          "line_type": "p",
          "text": "زیرا می‌دانم که به نجات من خواهد انجامید به‌وسیلهٔ دعای شما و تأیید روح عیسی مسیح،"
        },
        {
          "verse": 20,
          "usfm": "PHP.1.20",
          "line_type": "p",
          "text": "مطابق انتظار و امید من که در هیچ‌ چیز خجالت نخواهم کشید، بلکه در کمال دلیری، چنانکه همیشه، الآن نیز مسیح در بدن من جلال خواهد یافت، خواه در حیات و خواه در مرگ."
        },
        {
          "verse": 21,
          "usfm": "PHP.1.21",
          "line_type": "p",
          "text": "زیرا که مرا زیستن مسیح است و مردن نفع."
        },
        {
          "verse": 22,
          "usfm": "PHP.1.22",
          "line_type": "p",
          "text": "و لیکن اگر زیستن در بدن، همان ثمر کار من است، پس نمی‌دانم کدام را انتخاب کنم."
        },
        {
          "verse": 23,
          "usfm": "PHP.1.23",
          "line_type": "p",
          "text": "زیرا در میان این دو سخت گرفتار هستم، چونکه خواهش دارم که از این جهان در گذرم و با مسیح باشم، زیرا این بسیار بهتر است."
        },
        {
          "verse": 24,
          "usfm": "PHP.1.24",
          "line_type": "p",
          "text": "لیکن در بدن ماندن برای شما لازمتر است."
        },
        {
          "verse": 25,
          "usfm": "PHP.1.25",
          "line_type": "p",
          "text": "و چون از این یقین دارم، می‌دانم که خواهم ماند و با همهٔ شما ادامه خواهم داد به خاطر رشد و خوشی ایمان شما،"
        },
        {
          "verse": 26,
          "usfm": "PHP.1.26",
          "line_type": "p",
          "text": "تا فخر شما در مسیح عیسی در من افزوده شود به‌وسیلهٔ آمدن من بار دیگر نزد شما."
        },
        {
          "verse": 27,
          "usfm": "PHP.1.27",
          "line_type": "p",
          "text": "باری به طور شایستهٔ انجیل مسیح رفتار نمایید تا خواه آیم و شما را بینم و خواه غایب باشم، احوال شما را بشنوم که به یک روح برقرارید و به یک فکر برای ایمان انجیل دوش به دوش هم مجادله می‌کنید."
        },
        {
          "verse": 28,
          "usfm": "PHP.1.28",
          "line_type": "p",
          "text": "و در هیچ امری از دشمنان ترسان نیستید که همین برای ایشان دلیل هلاکت است، امّا شما را دلیل نجات و این از خداست."
        },
        {
          "verse": 29,
          "usfm": "PHP.1.29",
          "line_type": "p",
          "text": "زیرا که به شما عطا شد به‌ خاطر مسیح نه فقط ایمان آوردن به او، بلکه عذاب کشیدن هم برای او."
        },
        {
          "verse": 30,
          "usfm": "PHP.1.30",
          "line_type": "p",
          "text": "و شما را همان مجاهده است که در من دیدید و الان هم می‌شنوید که در من است."
        }
      ],
      "verse_count": 30,
      "headings": [
        {
          "before_verse": 3,
          "text": "شکرگزاری و دعا"
        },
        {
          "before_verse": 12,
          "text": "پیشرفت انجیل"
        }
      ],
