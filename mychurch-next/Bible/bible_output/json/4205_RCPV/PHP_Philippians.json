    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 2,
      "chapter_usfm": "PHP.2",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.2.1",
          "line_type": "p",
          "text": "بنابراین اگر نصیحتی در مسیح، یا تسلی محبّت، یا شراکت در روح، یا شفقت و رحمت هست،"
        },
        {
          "verse": 2,
          "usfm": "PHP.2.2",
          "line_type": "p",
          "text": "پس خوشی مرا کامل گردانید تا با هم یک فکر کنید و همان محبّت نموده، یکدل بشوید و یک فکر داشته باشید."
        },
        {
          "verse": 3,
          "usfm": "PHP.2.3",
          "line_type": "p",
          "text": "و هیچ‌ چیز را از راه جاه‌طلبی و تکبّر مکنید، بلکه با فروتنی دیگران را از خود بهتر بدانید."
        },
        {
          "verse": 4,
          "usfm": "PHP.2.4",
          "line_type": "p",
          "text": "و هر یک از شما ملاحظه کارهای خود را نکند، بلکه هر کدام کارهای دیگران را نیز."
        },
        {
          "verse": 5,
          "usfm": "PHP.2.5",
          "line_type": "p",
          "text": "پس همین فکر در شما باشد که در مسیح عیسی نیز بود؛"
        },
        {
          "verse": 6,
          "usfm": "PHP.2.6",
          "line_type": "p",
          "text": "که چون به صورت خدا بود، با خدا برابر بودن را غنیمت نشمرد،"
        },
        {
          "verse": 7,
          "usfm": "PHP.2.7",
          "line_type": "p",
          "text": "لیکن خود را خالی کرده، صورت غلام را پذیرفت و در شباهت مردمان شد؛"
        },
        {
          "verse": 8,
          "usfm": "PHP.2.8",
          "line_type": "p",
          "text": "و چون در شکل انسان یافت شد، خود را فروتن ساخت و تا به مرگ، بلکه تا به مرگ صلیب مطیع گردید."
        },
        {
          "verse": 9,
          "usfm": "PHP.2.9",
          "line_type": "p",
          "text": "از این جهت خدا نیز او را بسیار سرافراز نمود و نامی را که فوق از همه نامها است، به او بخشید"
        },
        {
          "verse": 10,
          "usfm": "PHP.2.10",
          "line_type": "p",
          "text": "تا به نام عیسی هر زانویی از آنچه در آسمان و بر زمین و زیر زمین است، خم شود"
        },
        {
          "verse": 11,
          "usfm": "PHP.2.11",
          "line_type": "p",
          "text": "و هر زبانی اقرار کند که عیسی مسیح، خداوند است برای تمجید خدای پدر."
        },
        {
          "verse": 12,
          "usfm": "PHP.2.12",
          "line_type": "p",
          "text": "پس‌ ای عزیزان من، چنانکه همیشه مطیع می‌بودید، نه در حضور من فقط، بلکه بسیار زیادتر الان وقتی که غایبم، نجات خود را به ترس و لرز به عمل آورید."
        },
        {
          "verse": 13,
          "usfm": "PHP.2.13",
          "line_type": "p",
          "text": "زیرا خداست که در شما مطابق خشنودی خود، هم اراده و هم عمل را پدید می‌آورد."
        },
        {
          "verse": 14,
          "usfm": "PHP.2.14",
          "line_type": "p",
          "text": "و هر کاری را بدون غرغر و مجادله بکنید،"
        },
        {
          "verse": 15,
          "usfm": "PHP.2.15",
          "line_type": "p",
          "text": "تا بی‌عیب و ساده‌دل، و فرزندان بی‌ملامت خدا باشید، در میان قومی کج‌رو و گردنکش که در آن میان چون ستارگان در جهان می‌درخشید"
        },
        {
          "verse": 16,
          "usfm": "PHP.2.16",
          "line_type": "p",
          "text": "و کلام حیات را برمی‌افرازید، به خاطر فخر من در روز مسیح تا آنکه بی‌جهت ندویده و بی‌جهت زحمت نکشیده باشم."
        },
        {
          "verse": 17,
          "usfm": "PHP.2.17",
          "line_type": "p",
          "text": "بلکه هرگاه بر قربانی و خدمت ایمان شما همچون هدیه‌ای ریختنی ریخته شوم، شادمان هستم و با همه شما شادی می‌کنم."
        },
        {
          "verse": 18,
          "usfm": "PHP.2.18",
          "line_type": "p",
          "text": "و همچنین شما نیز شادمان هستید و با من شادی می‌کنید."
        },
        {
          "verse": 19,
          "usfm": "PHP.2.19",
          "line_type": "p",
          "text": "و در عیسی خداوند امیدوارم که تیموتائوس را به زودی نزد شما بفرستم تا من نیز از احوال شما آگاه شده، تازه‌روح گردم."
        },
        {
          "verse": 20,
          "usfm": "PHP.2.20",
          "line_type": "p",
          "text": "زیرا کسی دیگر را همدل ندارم که به خلوص نیت دربارهٔ شما اندیشد."
        },
        {
          "verse": 21,
          "usfm": "PHP.2.21",
          "line_type": "p",
          "text": "از آن رو که همه نفع خود را می طلبند، نه امور عیسی مسیح را."
        },
        {
          "verse": 22,
          "usfm": "PHP.2.22",
          "line_type": "p",
          "text": "امّا دلیل او را می‌دانید، زیرا چنانکه فرزند پدر را خدمت می‌کند، او با من برای انجیل خدمت کرده است."
        },
        {
          "verse": 23,
          "usfm": "PHP.2.23",
          "line_type": "p",
          "text": "پس امیدوارم که چون دیدم کار من چطور می‌شود، او را بی‌درنگ بفرستم."
        },
        {
          "verse": 24,
          "usfm": "PHP.2.24",
          "line_type": "p",
          "text": "امّا در خداوند اعتماد دارم که خود هم به زودی بیایم."
        },
        {
          "verse": 25,
          "usfm": "PHP.2.25",
          "line_type": "p",
          "text": "ولی لازم دانستم که اِپافرودیتوس را به سوی شما روانه نمایم که مرا برادر و همکار و همرزم می‌باشد، امّا شما را رسول و خادم نیاز من."
        },
        {
          "verse": 26,
          "usfm": "PHP.2.26",
          "line_type": "p",
          "text": "زیرا که مشتاق همه شما بود و غمگین شد از اینکه شنیده بودید که او بیمار شده بود."
        },
        {
          "verse": 27,
          "usfm": "PHP.2.27",
          "line_type": "p",
          "text": "و به راستی هم بیمار و در آستانه مرگ بود، لیکن خدا بر او ترحّم فرمود و نه بر او فقط، بلکه بر من نیز تا مرا غمی بر غم نباشد."
        },
        {
          "verse": 28,
          "usfm": "PHP.2.28",
          "line_type": "p",
          "text": "پس به سعی بیشتر او را روانه نمودم تا از دیدنش باز شاد شوید و غصه من کمتر شود."
        },
        {
          "verse": 29,
          "usfm": "PHP.2.29",
          "line_type": "p",
          "text": "پس او را در خداوند با کمال خوشی بپذیرید و چنین کسان را محترم بدارید،"
        },
        {
          "verse": 30,
          "usfm": "PHP.2.30",
          "line_type": "p",
          "text": "زیرا در کار مسیح در آستانه مرگ شد و جان خود را به خطر انداخت تا کاستی خدمت شما را برای من جبران نماید."
        }
      ],
      "verse_count": 30,
      "headings": [
        {
          "before_verse": 19,
          "text": "تیموتائوس و اِپافرودیتوس"
        }
      ],
