    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 3,
      "chapter_usfm": "PHP.3",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.3.1",
          "line_type": "p",
          "text": "خلاصه ‌ای برادران من، در خداوند خوش باشید. همان مطالب را به شما نوشتن بر من سنگین نیست و ایمنی شما است."
        },
        {
          "verse": 2,
          "usfm": "PHP.3.2",
          "line_type": "p",
          "text": "از سگها باحذر باشید! از عاملان شریر دوری کنید. از قطع کنندگان عضو بپرهیزید."
        },
        {
          "verse": 3,
          "usfm": "PHP.3.3",
          "line_type": "p",
          "text": "زیرا ختنه‌شدگان ما هستیم که خدا را در روح عبادت می‌کنیم و به مسیح عیسی فخر می‌کنیم و بر جسم اعتماد نداریم."
        },
        {
          "verse": 4,
          "usfm": "PHP.3.4",
          "line_type": "p",
          "text": "هرچند مرا در جسم نیز اعتماد است. اگر کسی دیگر گمان برد که در جسم اعتماد دارد، من بیشتر."
        },
        {
          "verse": 5,
          "usfm": "PHP.3.5",
          "line_type": "p",
          "text": "روز هشتم ختنه شده و از قوم اسرائیل، از قبیلهٔ بنیامین، عبرانی از عبرانیان، از جهت شریعت فریسی،"
        },
        {
          "verse": 6,
          "usfm": "PHP.3.6",
          "line_type": "p",
          "text": "از جهت غیرت جفا کننده بر کلیسا، از جهت عدالتِ شریعتی، بی‌عیب."
        },
        {
          "verse": 7,
          "usfm": "PHP.3.7",
          "line_type": "p",
          "text": "امّا آنچه مرا سود می‌بود، آن را به ‌خاطر مسیح زیان دانستم."
        },
        {
          "verse": 8,
          "usfm": "PHP.3.8",
          "line_type": "p",
          "text": "بلکه همه ‌چیز را نیز به خاطر ارزش برتر شناخت خداوند خود مسیح عیسی زیان می‌دانم که به خاطر او همه ‌چیز را زیان کردم و فضله شمردم تا مسیح را دریابم."
        },
        {
          "verse": 9,
          "usfm": "PHP.3.9",
          "line_type": "p",
          "text": "و در وی یافت شوم نه با عدالت خود که از شریعت است، بلکه با آن که از طریق ایمان به مسیح حاصل می‌آید، یعنی عدالتی که از خدا و بر اساس ایمان است."
        },
        {
          "verse": 10,
          "usfm": "PHP.3.10",
          "line_type": "p",
          "text": "و تا او را و قوت زنده شدن وی را و شراکت در رنجهای او را بشناسم و با مرگ وی مشابه گردم،"
        },
        {
          "verse": 11,
          "usfm": "PHP.3.11",
          "line_type": "p",
          "text": "تا به هر طریق به زنده شدن از مردگان برسم."
        },
        {
          "verse": 12,
          "usfm": "PHP.3.12",
          "line_type": "p",
          "text": "نه اینکه تا به حال به چنگ آورده یا تا به حال کامل شده باشم، ولی در‌ پی آن می‌کوشم بلکه شاید آن را به دست آورم که برای آن مسیح عیسی نیز مرا به دست آورد."
        },
        {
          "verse": 13,
          "usfm": "PHP.3.13",
          "line_type": "p",
          "text": "‌ای برادران، گمان نمی‌برم که من به دست آورده‌ام؛ لیکن یک چیز می‌کنم که آنچه در عقب است فراموش کرده و به سوی آنچه در‌ پیش است، خود را کشیده،"
        },
        {
          "verse": 14,
          "usfm": "PHP.3.14",
          "line_type": "p",
          "text": "در‌ پی مقصد می‌کوشم به خاطر جایزهٔ دعوت والای خدا که در مسیح عیسی است."
        },
        {
          "verse": 15,
          "usfm": "PHP.3.15",
          "line_type": "p",
          "text": "پس همهٔ ما که کامل هستیم، این فکر داشته باشیم و اگر دربارهٔ موضوعی فکر دیگر دارید، خدا این را هم بر شما آشکار خواهد فرمود."
        },
        {
          "verse": 16,
          "usfm": "PHP.3.16",
          "line_type": "p",
          "text": "امّا به هر مقامی که رسیده‌ایم، به همان قانون رفتار باید کرد."
        },
        {
          "verse": 17,
          "usfm": "PHP.3.17",
          "line_type": "p",
          "text": "‌ای برادران، با هم از من نمونه بردارید و توجّه کنید آنانی را که مطابق نمونه‌ای که در ما دارید، رفتار می‌کنند."
        },
        {
          "verse": 18,
          "usfm": "PHP.3.18",
          "line_type": "p",
          "text": "زیرا که بسیاری رفتار می‌نمایند که ایشان را بارها به شما خاطرنشان کرده‌ام و حال نیز با گریه می‌کنم که دشمنان صلیب مسیح می‌باشند،"
        },
        {
          "verse": 19,
          "usfm": "PHP.3.19",
          "line_type": "p",
          "text": "که سرانجام ایشان هلاکت است و خدای ایشان شکم ایشان و فخر ایشان در ننگ ایشان، و چیزهای دنیوی را اندیشه می‌کنند."
        },
        {
          "verse": 20,
          "usfm": "PHP.3.20",
          "line_type": "p",
          "text": "امّا وطن ما در آسمان است که از آنجا نیز نجات‌دهنده، یعنی عیسی مسیح خداوند را انتظار می‌کشیم،"
        },
        {
          "verse": 21,
          "usfm": "PHP.3.21",
          "line_type": "p",
          "text": "که شکل بدن ذلیل ما را تبدیل خواهد نمود تا به صورت بدن مجید او درآید، مطابق عمل قوّت خود که همه ‌چیز را مطیع خود بگرداند."
        }
      ],
