    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 4,
      "chapter_usfm": "PHP.4",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.4.1",
          "line_type": "p",
          "text": "بنابراین، ای برادران عزیز و مورد اشتیاق من و شادی و تاج من، به همینطور در خداوند استوار باشید، ‌ای عزیزان."
        },
        {
          "verse": 2,
          "usfm": "PHP.4.2",
          "line_type": "p",
          "text": "از اِفودیه خواهش دارم و به سینتیخی التماس دارم که در خداوند همفکر باشند."
        },
        {
          "verse": 3,
          "usfm": "PHP.4.3",
          "line_type": "p",
          "text": "و از تو نیز‌، ای همقطار خالص، خواهش می‌کنم که ایشان را کمک کنی، زیرا در جهاد انجیل با من شریک می‌بودند با اَکلیمِنتُس نیز و سایر همکاران من که نام ایشان در دفتر حیات ‌است."
        },
        {
          "verse": 4,
          "usfm": "PHP.4.4",
          "line_type": "p",
          "text": "در خداوند دائم شاد باشید و باز می‌گویم: شاد باشید."
        },
        {
          "verse": 5,
          "usfm": "PHP.4.5",
          "line_type": "p",
          "text": "بگذارید ملایمت شما بر همه مردم آشکار باشد. خداوند نزدیک است."
        },
        {
          "verse": 6,
          "usfm": "PHP.4.6",
          "line_type": "p",
          "text": "برای هیچ ‌چیز اندیشه مکنید، بلکه در هر چیز با دعا و استغاثه، همراه با شکرگزاری، درخواستهای خود را به خدا عرض کنید."
        },
        {
          "verse": 7,
          "usfm": "PHP.4.7",
          "line_type": "p",
          "text": "و آرامش خدا که فوق از تمامی عقل است، دلها و ذهنهای شما را در مسیح عیسی نگاه خواهد داشت."
        },
        {
          "verse": 8,
          "usfm": "PHP.4.8",
          "line_type": "p",
          "text": "خلاصه ‌ای برادران، هر چه راست باشد و هر چه مجید و هر چه عادل و هر چه پاک و هر چه زیبا و هر چه نیکنام است، و هر فخر و هر مدحی که بوده باشد، در آنها تفکّر کنید."
        },
        {
          "verse": 9,
          "usfm": "PHP.4.9",
          "line_type": "p",
          "text": "و آنچه در من آموخته و پذیرفته و شنیده و دیده‌اید، آنها را به عمل آرید، و خدای سلامتی با شما خواهد بود."
        },
        {
          "verse": 10,
          "usfm": "PHP.4.10",
          "line_type": "p",
          "text": "و در خداوند بسیار شاد گردیدم که الآن نهایت، فکر شما برای من شکوفه آورد و در این نیز تفکّر می‌کردید، لیکن فرصت نیافتید."
        },
        {
          "verse": 11,
          "usfm": "PHP.4.11",
          "line_type": "p",
          "text": "نه آنکه دربارهٔ احتیاج سخن می‌گویم، زیرا که آموخته‌ام که در هر حالتی که باشم، قناعت کنم."
        },
        {
          "verse": 12,
          "usfm": "PHP.4.12",
          "line_type": "p",
          "text": "ذلت را می‌دانم و دولتمندی را هم می‌دانم، در هر صورت و در همه‌ چیز، سیری و گرسنگی و دولتمندی و ورشکستگی را یاد گرفته‌ام."
        },
        {
          "verse": 13,
          "usfm": "PHP.4.13",
          "line_type": "p",
          "text": "قوّت هر چیز را دارم در مسیح که مرا تقویت می‌بخشد."
        },
        {
          "verse": 14,
          "usfm": "PHP.4.14",
          "line_type": "p",
          "text": "لیکن نیکویی کردید که در تنگی من شریک شدید."
        },
        {
          "verse": 15,
          "usfm": "PHP.4.15",
          "line_type": "p",
          "text": "امّا ‌ای فیلیپیان، شما هم آگاهید که در ابتدای انجیل، چون از مقدونیه روانه شدم، هیچ کلیسا در امر دادن و گرفتن با من شریک نشد جز شما و بس."
        },
        {
          "verse": 16,
          "usfm": "PHP.4.16",
          "line_type": "p",
          "text": "زیرا که در تسالونیکی هم یکی دو بار برای احتیاج من فرستادید."
        },
        {
          "verse": 17,
          "usfm": "PHP.4.17",
          "line_type": "p",
          "text": "نه آنکه خواستار بخشش باشم، بلکه خواستار ثمری هستم که به حساب شما بیفزاید."
        },
        {
          "verse": 18,
          "usfm": "PHP.4.18",
          "line_type": "p",
          "text": "ولی همه ‌چیز بلکه بیشتر از کفایت دارم. پُر گشته‌ام چونکه هدایای شما را از اِپافرودیتوس یافته‌ام که عطر خوشبوی و قربانی مقبول و پسندیده خداست."
        },
        {
          "verse": 19,
          "usfm": "PHP.4.19",
          "line_type": "p",
          "text": "امّا خدای من همهٔ احتیاجات شما را مطابق دولت خود در جلال در مسیح عیسی رفع خواهد نمود."
        },
        {
          "verse": 20,
          "usfm": "PHP.4.20",
          "line_type": "p",
          "text": "و خدا و پدر ما را تا ابد جلال باد. آمین."
        },
        {
          "verse": 21,
          "usfm": "PHP.4.21",
          "line_type": "p",
          "text": "هر مقدّس را در مسیح عیسی سلام برسانید. و برادرانی که با من می‌باشند، به شما سلام می‌فرستند."
        },
        {
          "verse": 22,
          "usfm": "PHP.4.22",
          "line_type": "p",
          "text": "همهٔ مقدّسان به شما سلام می‌رسانند، به ویژه آنانی که از اهل خانه قیصر هستند."
        },
        {
          "verse": 23,
          "usfm": "PHP.4.23",
          "line_type": "p",
          "text": "فیض عیسی مسیح خداوند با روح شما باد. آمین."
        }
      ],
