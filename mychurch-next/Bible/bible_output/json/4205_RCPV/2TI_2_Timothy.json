    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 2,
      "chapter_usfm": "2TI.2",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.2.1",
          "line_type": "p",
          "text": "پس تو، ‌ای فرزند من، در فیضی که در مسیح عیسی است، نیرومند باش."
        },
        {
          "verse": 2,
          "usfm": "2TI.2.2",
          "line_type": "p",
          "text": "و آنچه به شاهدان بسیار از من شنیدی، به مردمان امین بسپار که قابل تعلیم دیگران هم باشند."
        },
        {
          "verse": 3,
          "usfm": "2TI.2.3",
          "line_type": "p",
          "text": "چون سرباز نیکوی مسیح عیسی در تحمّل زحمات شریک باش."
        },
        {
          "verse": 4,
          "usfm": "2TI.2.4",
          "line_type": "p",
          "text": "هیچ سرباز خود را در امور روزگار گرفتار نمی‌سازد تا خشنودی آنکه او را به سربازی گرفت، بجوید."
        },
        {
          "verse": 5,
          "usfm": "2TI.2.5",
          "line_type": "p",
          "text": "و اگر کسی نیز پهلوانی کند، تاج را به او نمی‌دهند اگر به قانون پهلوانی نکرده باشد."
        },
        {
          "verse": 6,
          "usfm": "2TI.2.6",
          "line_type": "p",
          "text": "برزگری که زحمت می‌کشد، باید اوّل سهمی از حاصل ببرد."
        },
        {
          "verse": 7,
          "usfm": "2TI.2.7",
          "line_type": "p",
          "text": "در آنچه می‌گویم تفکّر کن، زیرا خداوند تو را در همه ‌چیز فهم خواهد بخشید."
        },
        {
          "verse": 8,
          "usfm": "2TI.2.8",
          "line_type": "p",
          "text": "عیسی مسیح را به خاطر دار که از نسل داوود بوده، از مردگان برخاست مطابق مژدهٔ من،"
        },
        {
          "verse": 9,
          "usfm": "2TI.2.9",
          "line_type": "p",
          "text": "که در آن چون بدکار تا به بندها زحمت می‌کشم، لیکن کلام خدا بسته نمی‌شود."
        },
        {
          "verse": 10,
          "usfm": "2TI.2.10",
          "line_type": "p",
          "text": "و از این جهت همهٔ زحمات را به خاطر برگزیدگان متحمّل می‌شوم تا ایشان نیز نجاتی را که در مسیح عیسی است با جلال جاودانی کسب کنند."
        },
        {
          "verse": 11,
          "usfm": "2TI.2.11",
          "line_type": "p",
          "text": "این سخن امین است زیرا اگر با وی مردیم، با او زندگی هم خواهیم کرد."
        },
        {
          "verse": 12,
          "usfm": "2TI.2.12",
          "line_type": "p",
          "text": "و اگر تحمّل کنیم، با او سلطنت هم خواهیم کرد؛ و هرگاه او را انکار کنیم، او نیز ما را انکار خواهد کرد."
        },
        {
          "verse": 13,
          "usfm": "2TI.2.13",
          "line_type": "p",
          "text": "اگر بی‌ایمان شویم، او امین می‌ماند زیرا خود را انکار نمی‌تواند نمود."
        },
        {
          "verse": 14,
          "usfm": "2TI.2.14",
          "line_type": "p",
          "text": "این چیزها را به یاد ایشان آور و در حضور خداوند قدغن فرما که جرّ و بحث نکنند، زیرا هیچ سود نمی‌بخشد، بلکه باعث هلاکت شنوندگان می‌باشد."
        },
        {
          "verse": 15,
          "usfm": "2TI.2.15",
          "line_type": "p",
          "text": "و سعی کن که خود را مقبول خدا سازی، خادمی که خجل نشود و کلام حقیقت را به خوبی انجام دهد."
        },
        {
          "verse": 16,
          "usfm": "2TI.2.16",
          "line_type": "p",
          "text": "و از یاوه‌گویی‌های کفرآمیز دوری نما، زیرا که شخص را هر چه بیشتر به بی دینی خواهد کشاند."
        },
        {
          "verse": 17,
          "usfm": "2TI.2.17",
          "line_type": "p",
          "text": "و کلام ایشان چون مرض قانقاریا می‌خورد و از آن جمله هیمِنائوس و فیلیتوس می‌باشند"
        },
        {
          "verse": 18,
          "usfm": "2TI.2.18",
          "line_type": "p",
          "text": "که ایشان از حقیقت برگشته، می‌گویند که قیامت هم‌اکنون شده است و بعضی را از ایمان منحرف می‌سازند."
        },
        {
          "verse": 19,
          "usfm": "2TI.2.19",
          "line_type": "p",
          "text": "و لیکن بنیاد استوار خدا مستحکم است و این مُهر را دارد که «خداوند کسان خود را می‌شناسد» و «هر که نام خداوند را خواند، از ناراستی کناره جوید.»"
        },
        {
          "verse": 20,
          "usfm": "2TI.2.20",
          "line_type": "p",
          "text": "امّا در خانه بزرگ نه فقط ظروف طلا و نقره می‌باشد، بلکه چوبی و گلی نیز؛ امّا آنها برای عزّت و اینها برای ذلّت."
        },
        {
          "verse": 21,
          "usfm": "2TI.2.21",
          "line_type": "p",
          "text": "پس اگر کسی خود را از اینها تمیز سازد، ظرف عزّت خواهد بود، مقدس و سودمند برای مالک خود و حاضر برای هر کار نیکو."
        },
        {
          "verse": 22,
          "usfm": "2TI.2.22",
          "line_type": "p",
          "text": "اما از شهوات جوانی بگریز و با آنانی که از قلب خالص نام خداوند را می‌خوانند، عدالت و ایمان و محبّت و سلامتی را تعقیب نما."
        },
        {
          "verse": 23,
          "usfm": "2TI.2.23",
          "line_type": "p",
          "text": "لیکن از مباحثات پوچ و بی‌خردانه دوری نما، چون می‌دانی که نزاعها پدید می‌آورد."
        },
        {
          "verse": 24,
          "usfm": "2TI.2.24",
          "line_type": "p",
          "text": "اما خادم خداوند نباید نزاع کند، بلکه با همه کس ملایم و راغب به تعلیم و صبور در مشقت باشد"
        },
        {
          "verse": 25,
          "usfm": "2TI.2.25",
          "line_type": "p",
          "text": "و با حلم مخالفین را ارشاد نماید که شاید خدا ایشان را توبه بخشد تا حقیقت را بشناسند"
        },
        {
          "verse": 26,
          "usfm": "2TI.2.26",
          "line_type": "p",
          "text": "و از دام ابلیس باز به هوش آیند که مطابق اراده او به دام افتاده‌اند."
        }
      ],
      "verse_count": 26,
      "headings": [
        {
          "before_verse": 14,
          "text": "خادم مقبول خدا"
        }
      ],
