  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 1,
      "chapter_usfm": "2TI.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.1.1",
          "line_type": "p",
          "text": "پولس به ارادهٔ خدا رسول مسیح عیسی، مطابق وعدهٔ حیاتی که در مسیح عیسی است،"
        },
        {
          "verse": 2,
          "usfm": "2TI.1.2",
          "line_type": "p",
          "text": "فرزند محبوب خود تیموتائوس را.فیض و رحمت و سلامتی از جانب خدای پدر و خداوند ما عیسی مسیح باد."
        },
        {
          "verse": 3,
          "usfm": "2TI.1.3",
          "line_type": "p",
          "text": "شکر می‌کنم آن خدایی را که از اجداد خود به وجدان خالص خدمت او را می‌کنم، چونکه دائم در دعاهای خود تو را شبانه‌روز یاد می‌کنم"
        },
        {
          "verse": 4,
          "usfm": "2TI.1.4",
          "line_type": "p",
          "text": "و مشتاق ملاقات تو هستم، چونکه اشکهای تو را به خاطر می‌دارم تا از خوشی سیر شوم."
        },
        {
          "verse": 5,
          "usfm": "2TI.1.5",
          "line_type": "p",
          "text": "زیرا که یاد می‌دارم ایمان بی‌ریای تو را که نخست در مادربزرگت لوئیس و مادرت یونیکی ساکن می‌بود و مرا یقین است که در تو نیز هست."
        },
        {
          "verse": 6,
          "usfm": "2TI.1.6",
          "line_type": "p",
          "text": "بنابراین به یاد تو می‌آورم که آن عطای خدا را که به‌وسیلهٔ گذاشتن دستهای من بر تو است، شعله‌ور سازی."
        },
        {
          "verse": 7,
          "usfm": "2TI.1.7",
          "line_type": "p",
          "text": "زیرا خدا روح ترس را به ما نداده است، بلکه روح قوت و محبّت و انضباط را."
        },
        {
          "verse": 8,
          "usfm": "2TI.1.8",
          "line_type": "p",
          "text": "پس از شهادت خداوند ما عار مدار و نه از من که به خاطر او زندانی می‌باشم، بلکه در زحمات انجیل شریک باش مطابق قوت خدا،"
        },
        {
          "verse": 9,
          "usfm": "2TI.1.9",
          "line_type": "p",
          "text": "که ما را نجات داد و به دعوت مقدّس خواند، نه مطابق اعمال ما، بلکه مطابق اراده خود و آن فیضی که از ایّام ازل در مسیح عیسی به ما عطا شد."
        },
        {
          "verse": 10,
          "usfm": "2TI.1.10",
          "line_type": "p",
          "text": "امّا اکنون آشکار گردید به ظهور نجات‌دهنده ما عیسی مسیح که مرگ را نیست ساخت و حیات و بی‌فسادی را آشکار گردانید به‌وسیلهٔ انجیل،"
        },
        {
          "verse": 11,
          "usfm": "2TI.1.11",
          "line_type": "p",
          "text": "که برای آن من واعظ و رسول و معلّم گماشته شده‌ام."
        },
        {
          "verse": 12,
          "usfm": "2TI.1.12",
          "line_type": "p",
          "text": "و از این جهت این زحمات را می‌کشم، بلکه عار ندارم، چون می‌دانم به که ایمان آوردم و مرا یقین است که او قادر است که امانت مرا تا به آن روز حفظ کند."
        },
        {
          "verse": 13,
          "usfm": "2TI.1.13",
          "line_type": "p",
          "text": "سرمشق بگیر از سخنان صحیح که از من شنیدی در ایمان و محبّتی که در مسیح عیسی است."
        },
        {
          "verse": 14,
          "usfm": "2TI.1.14",
          "line_type": "p",
          "text": "آن امانت نیکو را به‌وسیلهٔ روح‌القدس که در ما ساکن است، حفظ کن."
        },
        {
          "verse": 15,
          "usfm": "2TI.1.15",
          "line_type": "p",
          "text": "از این آگاه هستی که همهٔ آنانی که در آسیا هستند، از من روی برگردانده‌اند که از آن جمله فیگِلوس و هِرموگِنِس می‌باشند."
        },
        {
          "verse": 16,
          "usfm": "2TI.1.16",
          "line_type": "p",
          "text": "خداوند اهل خانهٔ اونیسیفوروس را ترحم کند، زیرا که او بارها دل مرا تازه کرد و از زنجیر من عار نداشت،"
        },
        {
          "verse": 17,
          "usfm": "2TI.1.17",
          "line_type": "p",
          "text": "بلکه چون به روم رسید، مرا به کوشش بسیار جستجو کرده، پیدا نمود."
        },
        {
          "verse": 18,
          "usfm": "2TI.1.18",
          "line_type": "p",
          "text": "خداوند به او عطا کند که در آن روز در حضور خداوند رحمت یابد. و خدمتهایی را که در اَفِسُس کرد، تو بهتر می‌دانی."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 3,
          "text": "امانت سپرده شده را حفاظت کن"
        }
      ],
