    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 4,
      "chapter_usfm": "2TI.4",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.4.1",
          "line_type": "p",
          "text": "تو را در حضور خدا و مسیح عیسی که بر زندگان و مردگان داوری خواهد کرد، قسم می‌دهم و به ظهور و پادشاهی او"
        },
        {
          "verse": 2,
          "usfm": "2TI.4.2",
          "line_type": "p",
          "text": "که به کلام موعظه کنی و در فرصت و غیر فرصت مواظب باشی و تنبیه و توبیخ و نصیحت نمایی با کمال تحمّل و تعلیم."
        },
        {
          "verse": 3,
          "usfm": "2TI.4.3",
          "line_type": "p",
          "text": "زیرا روزهایی می‌آیند که تعلیم صحیح را متحمّل نخواهند شد، بلکه مطابق شهوات خود خارش گوشها داشته، معلّمان را بر خود فراهم خواهند ‌آورد"
        },
        {
          "verse": 4,
          "usfm": "2TI.4.4",
          "line_type": "p",
          "text": "و گوشهای خود را از حقیقت برگردانیده، به سوی افسانه‌ها خواهند گرایید."
        },
        {
          "verse": 5,
          "usfm": "2TI.4.5",
          "line_type": "p",
          "text": "لیکن تو در همه ‌چیز هشیار بوده، متحمّل زحمات باش و کار مبشر را به جا آور و خدمت خود را به‌ کمال رسان."
        },
        {
          "verse": 6,
          "usfm": "2TI.4.6",
          "line_type": "p",
          "text": "زیرا که من الان همچون هدیه ریختنی ریخته شده‌ام و وقت رحلت من رسیده است."
        },
        {
          "verse": 7,
          "usfm": "2TI.4.7",
          "line_type": "p",
          "text": "به جنگ نیکو جنگ کرده‌ام و دوره خود را به‌ کمال رسانیده، ایمان را محفوظ داشته‌ام."
        },
        {
          "verse": 8,
          "usfm": "2TI.4.8",
          "line_type": "p",
          "text": "بعد از این تاج عدالت برای من حاضر شده است که خداوند، آن داور عادل در آن روز به من خواهد داد؛ و نه به من فقط، بلکه نیز به همهٔ کسانی که ظهور او را دوست می‌دارند."
        },
        {
          "verse": 9,
          "usfm": "2TI.4.9",
          "line_type": "p",
          "text": "سعی کن که به زودی نزد من آیی،"
        },
        {
          "verse": 10,
          "usfm": "2TI.4.10",
          "line_type": "p",
          "text": "زیرا که دیماس برای محبّت این جهان حاضر مرا ترک کرده، به تِسالونیکی رفته است و کریسکیس به غَلاطیه و تیطس به دَلماتیه."
        },
        {
          "verse": 11,
          "usfm": "2TI.4.11",
          "line_type": "p",
          "text": "لوقا تنها با من است. مرقُس را برداشته با خود بیاور، زیرا که مرا به جهت خدمت مفید است."
        },
        {
          "verse": 12,
          "usfm": "2TI.4.12",
          "line_type": "p",
          "text": "امّا تیخیکوس را به افسس فرستادم."
        },
        {
          "verse": 13,
          "usfm": "2TI.4.13",
          "line_type": "p",
          "text": "ردایی را که در تروآس نزد کارپوس گذاشتم، وقت آمدنت بیاور و کتب را نیز، و به ویژه طومارها را."
        },
        {
          "verse": 14,
          "usfm": "2TI.4.14",
          "line_type": "p",
          "text": "اسکندر مسگر با من بسیار بدیها کرد. خداوند او را مطابق کارهایش جزا خواهد داد."
        },
        {
          "verse": 15,
          "usfm": "2TI.4.15",
          "line_type": "p",
          "text": "و تو هم از او دوری کن، زیرا که با سخنان ما به شدت مقاومت نمود."
        },
        {
          "verse": 16,
          "usfm": "2TI.4.16",
          "line_type": "p",
          "text": "در دفاع اوّل من، هیچ‌‌کس با من حاضر نشد، بلکه همه مرا ترک کردند. مباد که این به حساب آنها هم گذاشته شود."
        },
        {
          "verse": 17,
          "usfm": "2TI.4.17",
          "line_type": "p",
          "text": "لیکن خداوند با من ایستاده، به من قوت داد تا موعظه به‌وسیلهٔ من به‌ کمال رسد و تمامی غیر یهودیان بشنوند و از دهان شیر رهایی یافتم."
        },
        {
          "verse": 18,
          "usfm": "2TI.4.18",
          "line_type": "p",
          "text": "و خداوند مرا از هر کار بد خواهد رهانید و تا به پادشاهی آسمانی خود نجات خواهد کرد. او را تا به ابد جلال باد. آمین."
        },
        {
          "verse": 19,
          "usfm": "2TI.4.19",
          "line_type": "p",
          "text": "پریسکا و اَکیلا و اهل خانه اونیسیفوروس را سلام رسان."
        },
        {
          "verse": 20,
          "usfm": "2TI.4.20",
          "line_type": "p",
          "text": "اِراستوس در قُرِنتُس ماند؛ امّا ترفیموس را در میلیتوس بیمار واگذاردم."
        },
        {
          "verse": 21,
          "usfm": "2TI.4.21",
          "line_type": "p",
          "text": "سعی کن که قبل از زمستان بیایی. یوبولوس و پودِنس و لینوس و کلودیا و همهٔ برادران تو را سلام می‌رسانند."
        },
        {
          "verse": 22,
          "usfm": "2TI.4.22",
          "line_type": "p",
          "text": "خداوند با روح تو باد. فیض با تو باد. آمین."
        }
      ],
      "verse_count": 22,
      "headings": [
        {
          "before_verse": 9,
          "text": "رهنمودهای شخصی"
        },
        {
          "before_verse": 19,
          "text": "سلامهای آخرین"
        }
      ],
