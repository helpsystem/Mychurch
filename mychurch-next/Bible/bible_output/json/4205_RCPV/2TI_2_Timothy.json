    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 3,
      "chapter_usfm": "2TI.3",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.3.1",
          "line_type": "p",
          "text": "امّا این را بدان که در روزهای آخر زمانهای سخت پدید خواهد آمد،"
        },
        {
          "verse": 2,
          "usfm": "2TI.3.2",
          "line_type": "p",
          "text": "زیرا که مردمان، خودپرست خواهند بود و طماع و لاف‌زن و متکبر و بدگو و نامطیع والدین و ناسپاس و ناپاک"
        },
        {
          "verse": 3,
          "usfm": "2TI.3.3",
          "line_type": "p",
          "text": "و بی‌عاطفه و کینه‌دل و غیبت‌گو و ناپرهیز و بی‌مروّت و متنفر از نیکویی"
        },
        {
          "verse": 4,
          "usfm": "2TI.3.4",
          "line_type": "p",
          "text": "و خیانتکار و بی‌مبالات و مغرور که عشرت را بیشتر از خدا دوست می‌دارند؛"
        },
        {
          "verse": 5,
          "usfm": "2TI.3.5",
          "line_type": "p",
          "text": "که ظاهر دینداری دارند، لیکن قوّت آن را انکار می‌کنند. از ایشان دوری نما."
        },
        {
          "verse": 6,
          "usfm": "2TI.3.6",
          "line_type": "p",
          "text": "زیرا که از اینها هستند آنانی که به حیله داخل خانه‌ها گشته، زنان کم‌عقل را اسیر می‌کنند که بار گناهان را می‌کشند و به انواع شهوات ربوده می‌شوند."
        },
        {
          "verse": 7,
          "usfm": "2TI.3.7",
          "line_type": "p",
          "text": "و دائم تعلیم می‌گیرند، لیکن هرگز به معرفت حقیقت نمی‌توانند رسید."
        },
        {
          "verse": 8,
          "usfm": "2TI.3.8",
          "line_type": "p",
          "text": "و همچنان ‌که یَنّیس و یَمبریس با موسی مقاومت کردند، ایشان نیز با حقیقت مخالفت می‌کنند که مردم در عقل فاسد و مردود از ایمانند."
        },
        {
          "verse": 9,
          "usfm": "2TI.3.9",
          "line_type": "p",
          "text": "لیکن بیشتر پیشرفت نخواهند کرد زیرا که حماقت ایشان بر همه مردم معلوم خواهد شد، چنانکه حماقت آنها نیز شد."
        },
        {
          "verse": 10,
          "usfm": "2TI.3.10",
          "line_type": "p",
          "text": "لیکن تو تعلیم و کردار و هدف و ایمان و حلم و محبّت و صبر مرا پیروی نمودی،"
        },
        {
          "verse": 11,
          "usfm": "2TI.3.11",
          "line_type": "p",
          "text": "و زحمات و آزارهای مرا مثل آنهایی که در اَنطاکیه و قونیه و لِستره بر من واقع شد؛ چگونه زحمات را تحمّل می‌نمودم و خداوند مرا از همه رهایی داد."
        },
        {
          "verse": 12,
          "usfm": "2TI.3.12",
          "line_type": "p",
          "text": "و همهٔ کسانی که می‌خواهند در مسیح عیسی به دینداری زندگی کنند، زحمات خواهند کشید."
        },
        {
          "verse": 13,
          "usfm": "2TI.3.13",
          "line_type": "p",
          "text": "لیکن مردمان شریر و شیاد در بدی رشد خواهند کرد که فریبنده و فریب خورده می‌باشند."
        },
        {
          "verse": 14,
          "usfm": "2TI.3.14",
          "line_type": "p",
          "text": "امّا تو در آنچه آموختی و ایمان آوردی، استوار باش، چونکه می‌دانی از چه کسان تعلیم یافتی،"
        },
        {
          "verse": 15,
          "usfm": "2TI.3.15",
          "line_type": "p",
          "text": "و اینکه از کودکی کتب مقدّس را دانسته‌ای که می‌تواند تو را حکمت آموزد برای نجات به‌وسیلهٔ ایمانی که بر مسیح عیسی است."
        },
        {
          "verse": 16,
          "usfm": "2TI.3.16",
          "line_type": "p",
          "text": "تمامی کتب از الهام خداست و به جهت تعلیم و تنبیه و اصلاح و تربیت در عدالت مفید است"
        },
        {
          "verse": 17,
          "usfm": "2TI.3.17",
          "line_type": "p",
          "text": "تا مرد خدا کامل و برای هر کار نیکو آراسته بشود."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 10,
          "text": "همهٔ کتب الهام خداست"
        }
      ],
      "footnotes": [],
