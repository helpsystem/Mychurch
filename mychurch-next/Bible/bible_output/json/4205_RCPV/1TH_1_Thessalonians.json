    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 4,
      "chapter_usfm": "1TH.4",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.4.1",
          "line_type": "p",
          "text": "خلاصه ‌ای برادران، از شما در عیسی خداوند خواهش و التماس می‌کنیم که چنانکه از ما یافته‌اید که به چه نوع باید رفتار کنید و خدا را راضی سازید، که چنین نیز می‌کنید. به همانطور زیادتر رشد کنید."
        },
        {
          "verse": 2,
          "usfm": "1TH.4.2",
          "line_type": "p",
          "text": "زیرا می‌دانید چه فرامین از جانب عیسی خداوند به شما دادیم."
        },
        {
          "verse": 3,
          "usfm": "1TH.4.3",
          "line_type": "p",
          "text": "زیرا که این است ارادهٔ خدا یعنی قدّوسیّت شما، تا از زنا بپرهیزید."
        },
        {
          "verse": 4,
          "usfm": "1TH.4.4",
          "line_type": "p",
          "text": "تا هر کسی از شما بداند چگونه باید ظرف خود را در قدّوسیّت و عزّت دریابد،"
        },
        {
          "verse": 5,
          "usfm": "1TH.4.5",
          "line_type": "p",
          "text": "و نه در امیال شهوانی، مثل قومهایی که خدا را نمی‌شناسند."
        },
        {
          "verse": 6,
          "usfm": "1TH.4.6",
          "line_type": "p",
          "text": "و تا کسی در این امر دست آزار و اذّیت یا سودجویی بر برادر خود دراز نکند، زیرا خداوند از تمامی چنین کارها انتقام‌کشنده است."
        },
        {
          "verse": 7,
          "usfm": "1TH.4.7",
          "line_type": "p",
          "text": "چنانکه سابق نیز به شما گفته و امر کرده‌ایم، زیرا خدا ما را به ناپاکی نخوانده است، بلکه به قدّوسیّت."
        },
        {
          "verse": 8,
          "usfm": "1TH.4.8",
          "line_type": "p",
          "text": "بنابراین هر که حقیر شمارد، انسان را حقیر نمی‌شمارد، بلکه خدا را که روح قدّوس خود را به شما عطا کرده است."
        },
        {
          "verse": 9,
          "usfm": "1TH.4.9",
          "line_type": "p",
          "text": "امّا در مورد محبّت برادرانه، لازم نیست که به شما بنویسم، زیرا خود شما از خدا آموخته شده‌اید که یکدیگر را محبّت نمایید؛"
        },
        {
          "verse": 10,
          "usfm": "1TH.4.10",
          "line_type": "p",
          "text": "و چنین هم می‌کنید با همهٔ برادرانی که در تمام مقدونیه می‌باشند. لیکن ‌ای برادران، از شما التماس داریم که زیادتر رشد کنید."
        },
        {
          "verse": 11,
          "usfm": "1TH.4.11",
          "line_type": "p",
          "text": "و مشتاق باشید در اینکه آرام شوید و به ‌کارهای خود مشغول شده، به‌ دستهای خویش کسب نمایید، چنانکه شما را امر کردیم،"
        },
        {
          "verse": 12,
          "usfm": "1TH.4.12",
          "line_type": "p",
          "text": "تا نزد آنانی که خارج‌اند، به طور شایسته رفتار کنید و به چیزی محتاج نباشید."
        },
        {
          "verse": 13,
          "usfm": "1TH.4.13",
          "line_type": "p",
          "text": "امّا ‌ای برادران، نمی‌خواهیم شما از حالت خوابیدگان بی‌خبر باشید که مبادا مثل دیگران که امید ندارند، غمگین شوید."
        },
        {
          "verse": 14,
          "usfm": "1TH.4.14",
          "line_type": "p",
          "text": "زیرا اگر باور می‌کنیم که عیسی مرد و برخاست، به همینطور نیز خدا آنانی را که در عیسی خوابیده‌اند، با وی خواهد آورد."
        },
        {
          "verse": 15,
          "usfm": "1TH.4.15",
          "line_type": "p",
          "text": "زیرا این را به شما از کلام خدا می‌گوییم که ما که زنده و تا آمدن خداوند باقی باشیم، بر خوابیدگان پیشی نخواهیم جست."
        },
        {
          "verse": 16,
          "usfm": "1TH.4.16",
          "line_type": "p",
          "text": "زیرا خود خداوند با فرمانی بلندآواز و با آوای رئیس فرشتگان و با شیپور خدا از آسمان فرود خواهد آمد و مردگان در مسیح اوّل خواهند برخاست."
        },
        {
          "verse": 17,
          "usfm": "1TH.4.17",
          "line_type": "p",
          "text": "آنگاه ما که زنده و باقی باشیم، با ایشان در ابرها ربوده خواهیم شد تا خداوند را در هوا استقبال کنیم و همچنین همیشه با خداوند خواهیم بود."
        },
        {
          "verse": 18,
          "usfm": "1TH.4.18",
          "line_type": "p",
          "text": "پس به این سخنان همدیگر را تسلّی دهید."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 13,
          "text": "بازگشت مسیح"
        }
      ],
      "footnotes": [
        {
          "verse": 13,
          "usfm": "1TH.4.13",
          "note_ref": "4‏.13",
          "note_type": "footnote",
          "references": [],
          "text": "منظور مسیحیانی است که چشم از جهان فرو بسته‌اند."
        }
      ],
