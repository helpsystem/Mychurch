    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 3,
      "chapter_usfm": "1TH.3",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.3.1",
          "line_type": "p",
          "text": "پس چون دیگر شکیبایی نداشتیم، راضی به این شدیم که ما را در آتن تنها واگذاردند."
        },
        {
          "verse": 2,
          "usfm": "1TH.3.2",
          "line_type": "p",
          "text": "و تیموتائوس را که برادر ما و خادم خدا در انجیل مسیح است، فرستادیم تا شما را استوار سازد و در مورد ایمانتان شما را نصیحت کند."
        },
        {
          "verse": 3,
          "usfm": "1TH.3.3",
          "line_type": "p",
          "text": "تا هیچ‌‌کس از این مصیبتها نلرزد، زیرا خود می‌دانید که برای همین تعیین شده‌ایم."
        },
        {
          "verse": 4,
          "usfm": "1TH.3.4",
          "line_type": "p",
          "text": "زیرا هنگامی که نزد شما بودیم، شما را پیش خبر دادیم که می‌باید زحمات بکشیم، چنانکه واقع شد و می‌دانید."
        },
        {
          "verse": 5,
          "usfm": "1TH.3.5",
          "line_type": "p",
          "text": "بنابراین من نیز چون شکیبایی نداشتم، فرستادم تا از ایمان شما آگاه شوم مبادا که آن وسوسه کننده شما را وسوسه کرده باشد و زحمات ما هدر رود."
        },
        {
          "verse": 6,
          "usfm": "1TH.3.6",
          "line_type": "p",
          "text": "امّا اکنون چون تیموتائوس از نزد شما به ما رسید و مژده ایمان و محبّت شما را به ما رسانید و اینکه شما پیوسته ما را نیکو یاد می‌کنید و مشتاق ملاقات ما می‌باشید، چنانکه ما نیز علاقمند شما هستیم،"
        },
        {
          "verse": 7,
          "usfm": "1TH.3.7",
          "line_type": "p",
          "text": "بنابراین ای برادران، در همهٔ رنج و مصیبتی که داریم، از شما به خاطر ایمانتان تسلی یافتیم."
        },
        {
          "verse": 8,
          "usfm": "1TH.3.8",
          "line_type": "p",
          "text": "چونکه الان زندگی می‌کنیم، اگر شما در خداوند استوار هستید."
        },
        {
          "verse": 9,
          "usfm": "1TH.3.9",
          "line_type": "p",
          "text": "زیرا چه شکرگزاری به خدا توانیم نمود به خاطر این همه شادی‌ای که به حضور خدا دربارهٔ شما داریم؛"
        },
        {
          "verse": 10,
          "usfm": "1TH.3.10",
          "line_type": "p",
          "text": "که روز و شب از دل و جان دعا می‌کنیم تا شما را روبرو ملاقات کنیم و کاستی ایمان شما را به‌ کمال رسانیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.3.11",
          "line_type": "p",
          "text": "امّا خود خدا یعنی پدر ما و خداوند ما عیسی راه ما را به سوی شما راست بیاورد."
        },
        {
          "verse": 12,
          "usfm": "1TH.3.12",
          "line_type": "p",
          "text": "و خداوند شما را رشد دهد و با محبّت با یکدیگر و با همه افزونی بخشد، چنانکه ما شما را محبّت می‌نماییم،"
        },
        {
          "verse": 13,
          "usfm": "1TH.3.13",
          "line_type": "p",
          "text": "تا دلهای شما را استوار سازد، بی‌عیب در قدّوسیت، به حضور خدا و پدر ما در هنگام ظهور خداوند ما عیسی، با تمامی مقدّسین خود."
        }
      ],
      "verse_count": 13,
      "headings": [
        {
          "before_verse": 6,
          "text": "گزارش دلگرم کننده تیموتائوس"
        }
      ],
