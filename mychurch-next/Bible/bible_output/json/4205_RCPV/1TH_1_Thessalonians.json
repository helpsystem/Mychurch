    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 2,
      "chapter_usfm": "1TH.2",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.2.1",
          "line_type": "p",
          "text": "زیرا‌ ای برادران، خود می‌دانید که ورود ما در میان شما باطل نبود."
        },
        {
          "verse": 2,
          "usfm": "1TH.2.2",
          "line_type": "p",
          "text": "بلکه هرچند قبل از آن در فیلیپی زحمات کشیده و بی‌احترامی دیده بودیم، چنانکه اطلاع دارید، لیکن در خدای خود دلیری کردیم تا انجیل خدا را با جدّ و جهد شدید به شما اعلام نماییم."
        },
        {
          "verse": 3,
          "usfm": "1TH.2.3",
          "line_type": "p",
          "text": "زیرا که نصیحت ما از گمراهی و انگیزه‌های ناپاک و ریا نیست،"
        },
        {
          "verse": 4,
          "usfm": "1TH.2.4",
          "line_type": "p",
          "text": "بلکه چنانکه مقبول خدا گشتیم که وکیلان انجیل بشویم، همچنین سخن می‌گوییم و خواستار خشنودی مردم نیستیم، بلکه خشنودی خدایی که دلهای ما را می‌آزماید."
        },
        {
          "verse": 5,
          "usfm": "1TH.2.5",
          "line_type": "p",
          "text": "زیرا هرگز سخن از روی چاپلوسی نگفتیم، چنانکه می‌دانید، و نه بهانه سودجویی کردیم، خدا شاهد است؛"
        },
        {
          "verse": 6,
          "usfm": "1TH.2.6",
          "line_type": "p",
          "text": "و نه بزرگی از خلق جستیم، نه از شما و نه از دیگران، هرچند چون رسولان مسیح بودیم، می‌توانستیم سنگین باشیم."
        },
        {
          "verse": 7,
          "usfm": "1TH.2.7",
          "line_type": "p",
          "text": "بلکه در میان شما به ملایمت به سر می‌بردیم، مثل مادر شیردهی که کودکان خود را می‌پرورد."
        },
        {
          "verse": 8,
          "usfm": "1TH.2.8",
          "line_type": "p",
          "text": "به این طرز علاقمند شما شده، راضی می‌بودیم که نه همان انجیل خدا را به شما دهیم، بلکه جانهای خود را نیز، از بس که عزیز ما بودید."
        },
        {
          "verse": 9,
          "usfm": "1TH.2.9",
          "line_type": "p",
          "text": "از آن رو که ‌ای برادران زحمت و مشقت ما را یاد می‌دارید زیرا که شبانه‌روز در کار مشغول شده، به انجیل خدا شما را موعظه می‌کردیم که مبادا بر کسی از شما بار نهیم."
        },
        {
          "verse": 10,
          "usfm": "1TH.2.10",
          "line_type": "p",
          "text": "شما شاهد هستید و خدا نیز که به چه نوع با قدّوسیت و عدالت و بی‌عیبی نزد شما که ایماندار هستید، رفتار نمودیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.2.11",
          "line_type": "p",
          "text": "چنانکه می‌دانید که هر یکی از شما را چون پدر به فرزندانش نصیحت و دلداری می‌نمودیم"
        },
        {
          "verse": 12,
          "usfm": "1TH.2.12",
          "line_type": "p",
          "text": "و سفارش می‌کردیم که رفتار بکنید به طور شایسته خدایی که شما را به پادشاهی و جلال خود می‌خواند."
        },
        {
          "verse": 13,
          "usfm": "1TH.2.13",
          "line_type": "p",
          "text": "و از این جهت ما نیز دائم خدا را شکر می‌کنیم که چون کلام خدا را که از ما شنیده بودید، یافتید، آن را کلام انسانی نپذیرفتید، بلکه چنانکه به راستی هم هست، کلام خدا که در شما که ایماندار هستید، عمل می‌کند."
        },
        {
          "verse": 14,
          "usfm": "1TH.2.14",
          "line_type": "p",
          "text": "زیرا که ‌ای برادران، شما نمونه گرفتید از کلیساهای خدا که در یهودیه در مسیح عیسی می‌باشند، زیرا که شما از قوم خود همان زحمات را کشیدید که ایشان نیز از یهود دیدند،"
        },
        {
          "verse": 15,
          "usfm": "1TH.2.15",
          "line_type": "p",
          "text": "که عیسی خداوند و انبیای خود را کشتند و بر ما جفا کردند. ایشان ناپسند خدا هستند و مخالف تمامی مردم،"
        },
        {
          "verse": 16,
          "usfm": "1TH.2.16",
          "line_type": "p",
          "text": "و ما را منع می‌کنند که به غیریهودیان سخن بگوییم تا نجات یابند و همیشه گناهان خود را لبریز می‌کنند. امّا نهایت غضب ایشان را فرو گرفته است."
        },
        {
          "verse": 17,
          "usfm": "1TH.2.17",
          "line_type": "p",
          "text": "لیکن ما‌ ای برادران، چون به اندازهٔ مدّتی کوتاه، در ظاهر نه در دل، از شما دور شدیم، به اشتیاق بسیار زیادتر کوشیدیم تا روی شما را ببینیم."
        },
        {
          "verse": 18,
          "usfm": "1TH.2.18",
          "line_type": "p",
          "text": "و به این جهت یکی دو بار خواستیم نزد شما بیاییم، یعنی من، پولس، لیکن شیطان ما را نگذاشت."
        },
        {
          "verse": 19,
          "usfm": "1TH.2.19",
          "line_type": "p",
          "text": "زیرا که چیست امید و شادی و تاج فخر ما؟ مگر شما نیستید در حضور خداوند ما عیسی در هنگام ظهور او؟"
        },
        {
          "verse": 20,
          "usfm": "1TH.2.20",
          "line_type": "p",
          "text": "زیرا که شما جلال و خوشی ما هستید."
        }
      ],
      "verse_count": 20,
      "headings": [
        {
          "before_verse": 17,
          "text": "اشتیاق پولس برای دیدن تِسالونیکیان"
        }
      ],
