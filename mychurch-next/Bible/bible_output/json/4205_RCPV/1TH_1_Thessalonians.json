  "chapters": [
    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 1,
      "chapter_usfm": "1TH.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.1.1",
          "line_type": "p",
          "text": "پولس و سلوانس و تیموتائوس، به کلیسای تسالونیکیان که در خدای پدر و عیسی مسیح خداوند می‌باشید.فیض و سلامتی بر شما باد."
        },
        {
          "verse": 2,
          "usfm": "1TH.1.2",
          "line_type": "p",
          "text": "پیوسته دربارهٔ همهٔ شما خدا را شکر می‌کنیم و دائم در دعاهای خود شما را به زبان می‌آورم"
        },
        {
          "verse": 3,
          "usfm": "1TH.1.3",
          "line_type": "p",
          "text": "چون اعمال ایمان شما و زحمت محبّت و صبر امید شما را در خداوند ما عیسی مسیح در حضور خدا و پدر خود یاد می‌کنیم."
        },
        {
          "verse": 4,
          "usfm": "1TH.1.4",
          "line_type": "p",
          "text": "زیرا که ‌ای برادران و ‌ای عزیزان خدا، از برگزیدگی شما آگاه هستیم،"
        },
        {
          "verse": 5,
          "usfm": "1TH.1.5",
          "line_type": "p",
          "text": "زیرا که انجیل ما بر شما تنها به خاطر سخن وارد نشده، بلکه با قوّت و روح‌القدس و یقین کامل، چنانکه می‌دانید که در میان شما به خاطر شما چگونه مردمان شدیم."
        },
        {
          "verse": 6,
          "usfm": "1TH.1.6",
          "line_type": "p",
          "text": "و شما از ما و از خداوند سرمشق گرفتید و کلام را در زحمت شدید، با خوشی روح‌القدس پذیرفتید،"
        },
        {
          "verse": 7,
          "usfm": "1TH.1.7",
          "line_type": "p",
          "text": "به حدّی که شما تمامی ایمانداران مقدونيه و اَخائیه را نمونه شدید،"
        },
        {
          "verse": 8,
          "usfm": "1TH.1.8",
          "line_type": "p",
          "text": "به گونه‌ای که از شما کلام خداوند نه فقط در مقدونیه و اَخائیه پیچید، بلکه در هر جا ایمان شما به خدا بر سر زبانهاست، به گونه‌ای که احتیاج نیست که ما چیزی بگوییم،"
        },
        {
          "verse": 9,
          "usfm": "1TH.1.9",
          "line_type": "p",
          "text": "زیرا خود ایشان دربارهٔ ما خبر می‌دهند که به چه شکل از ما استقبال کردید و به چه شکل از بتها به سوی خدا بازگشت نمودید تا خدای زنده حقیقی را خدمت نمایید"
        },
        {
          "verse": 10,
          "usfm": "1TH.1.10",
          "line_type": "p",
          "text": "و تا پسر او را از آسمان انتظار بکشید که او را از مردگان برخیزانید، یعنی عیسی که ما را از غضب آینده می‌رهاند."
        }
      ],
      "verse_count": 10,
      "headings": [
        {
          "before_verse": 2,
          "text": "ایمان و زندگی ایماندان تِسالونیکی"
        }
      ],
      "footnotes": [
