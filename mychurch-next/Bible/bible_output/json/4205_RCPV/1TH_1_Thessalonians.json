    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 5,
      "chapter_usfm": "1TH.5",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.5.1",
          "line_type": "p",
          "text": "اما ‌ای برادران، در مورد وقتها و زمانها، احتیاج ندارید که به شما بنویسم."
        },
        {
          "verse": 2,
          "usfm": "1TH.5.2",
          "line_type": "p",
          "text": "زیرا خود شما به راستی آگاهید که روز خداوند چون دزد در شب می‌آید."
        },
        {
          "verse": 3,
          "usfm": "1TH.5.3",
          "line_type": "p",
          "text": "زیرا هنگامی که می‌گویند: «سلامتی و امان است»، آنگاه هلاکت ایشان را ناگهان فرو خواهد گرفت؛ همچون درد زایمان زن حامله را. و هرگز رستگار نخواهند شد."
        },
        {
          "verse": 4,
          "usfm": "1TH.5.4",
          "line_type": "p",
          "text": "لیکن شما‌ ای برادران، در ظلمت نیستید تا آن روز چون دزد بر شما آید،"
        },
        {
          "verse": 5,
          "usfm": "1TH.5.5",
          "line_type": "p",
          "text": "زیرا همه شما پسران نور و پسران روز هستید، از شب و ظلمت نیستیم."
        },
        {
          "verse": 6,
          "usfm": "1TH.5.6",
          "line_type": "p",
          "text": "بنابراین مثل دیگران به خواب نرویم، بلکه بیدار و هشیار باشیم."
        },
        {
          "verse": 7,
          "usfm": "1TH.5.7",
          "line_type": "p",
          "text": "زیرا خوابیدگان در شب می‌خوابند و مستان در شب مست می‌شوند."
        },
        {
          "verse": 8,
          "usfm": "1TH.5.8",
          "line_type": "p",
          "text": "لیکن ما که از روز هستیم، هشیار بوده، جوشن ایمان و محبّت و کلاهخود امید نجات را بپوشیم."
        },
        {
          "verse": 9,
          "usfm": "1TH.5.9",
          "line_type": "p",
          "text": "زیرا خدا ما را تعیین نکرد برای غضب، بلکه به جهت نائل شدن به نجات، به‌وسیلهٔ خداوند ما عیسی مسیح،"
        },
        {
          "verse": 10,
          "usfm": "1TH.5.10",
          "line_type": "p",
          "text": "که برای ما مرد، تا خواه بیدار باشیم و خواه خوابیده، همراه وی زندگی کنیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.5.11",
          "line_type": "p",
          "text": "پس همدیگر را تسلّی دهید و یکدیگر را بنا کنید، چنانکه هم می‌کنید."
        },
        {
          "verse": 12,
          "usfm": "1TH.5.12",
          "line_type": "p",
          "text": "امّا ‌ای برادران، به شما التماس داریم که بشناسید آنانی را که در میان شما زحمت می‌کشند و رهبران شما در خداوند بوده، شما را نصیحت می‌کنند."
        },
        {
          "verse": 13,
          "usfm": "1TH.5.13",
          "line_type": "p",
          "text": "و ایشان را در نهایت محبّت، به خاطر عملشان محترم دارید و با یکدیگر صلح کنید."
        },
        {
          "verse": 14,
          "usfm": "1TH.5.14",
          "line_type": "p",
          "text": "لیکن ‌ای برادران، از شما خواهش داریم که سرکشان را تنبیه کنید و کم‌جرأتان را تشویق نمایید و ضعیفان را حمایت کنید و با همهٔ مردم تحمّل نمایید."
        },
        {
          "verse": 15,
          "usfm": "1TH.5.15",
          "line_type": "p",
          "text": "به هوش باشید که کسی با کسی به سزای بدی، بدی نکند، بلکه دائم با یکدیگر و با همه مردم در‌ پی نیکویی بکوشید."
        },
        {
          "verse": 16,
          "usfm": "1TH.5.16",
          "line_type": "p",
          "text": "پیوسته شادمان باشید."
        },
        {
          "verse": 17,
          "usfm": "1TH.5.17",
          "line_type": "p",
          "text": "همیشه دعا کنید."
        },
        {
          "verse": 18,
          "usfm": "1TH.5.18",
          "line_type": "p",
          "text": "در هر امری شکرگزار باشید که این است ارادهٔ خدا در حق شما در مسیح عیسی."
        },
        {
          "verse": 19,
          "usfm": "1TH.5.19",
          "line_type": "p",
          "text": "روح را خاموش مکنید."
        },
        {
          "verse": 20,
          "usfm": "1TH.5.20",
          "line_type": "p",
          "text": "نبوتها را خوار مشمارید."
        },
        {
          "verse": 21,
          "usfm": "1TH.5.21",
          "line_type": "p",
          "text": "همه‌ چیز را بیازمایید، و به آنچه نیکو است، بچسبید."
        },
        {
          "verse": 22,
          "usfm": "1TH.5.22",
          "line_type": "p",
          "text": "از هر نوع بدی دوری کنید."
        },
        {
          "verse": 23,
          "usfm": "1TH.5.23",
          "line_type": "p",
          "text": "امّا خود خدای سلامتی شما را به تمامی مقدس گرداند و روح و نفس و بدن شما به طور کامل، بی‌عیب محفوظ باشد در وقت آمدن خداوند ما عیسی مسیح."
        },
        {
          "verse": 24,
          "usfm": "1TH.5.24",
          "line_type": "p",
          "text": "امین است دعوت کنندهٔ شما که این را هم خواهد کرد."
        },
        {
          "verse": 25,
          "usfm": "1TH.5.25",
          "line_type": "p",
          "text": "‌ای برادران، برای ما دعا کنید."
        },
        {
          "verse": 26,
          "usfm": "1TH.5.26",
          "line_type": "p",
          "text": "همهٔ برادران را به بوسهٔ مقدسانه سلام کنید."
        },
        {
          "verse": 27,
          "usfm": "1TH.5.27",
          "line_type": "p",
          "text": "شما را به خداوند قسم می‌دهم که این رساله برای تمامی برادران خوانده شود."
        },
        {
          "verse": 28,
          "usfm": "1TH.5.28",
          "line_type": "p",
