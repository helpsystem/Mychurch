    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 4,
      "chapter_usfm": "JAS.4",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.4.1",
          "line_type": "p",
          "text": "از کجا در میان شما جنگها و از کجا نزاعها پدید می‌آید؟ آیا نه از لذّتهای شما که در اعضای شما جنگ می‌کند؟"
        },
        {
          "verse": 2,
          "usfm": "JAS.4.2",
          "line_type": "p",
          "text": "طمع می‌ورزید و ندارید؛ پس می‌کُشید. حسد می‌نمایید و نمی‌توانید به چنگ آرید؛ پس جنگ و جدال می‌کنید. ندارید از این جهت که درخواست نمی‌کنید."
        },
        {
          "verse": 3,
          "usfm": "JAS.4.3",
          "line_type": "p",
          "text": "درخواست می‌کنید و نمی‌یابید، از این رو که به نیّت بد درخواست می‌کنید تا در لذّات خود صرف نمایید."
        },
        {
          "verse": 4,
          "usfm": "JAS.4.4",
          "line_type": "p",
          "text": "‌ای زناکاران، آیا نمی‌دانید که دوستی دنیا، دشمنی خداست؟ پس هر که می‌خواهد دوست دنیا باشد، دشمن خدا گردد."
        },
        {
          "verse": 5,
          "usfm": "JAS.4.5",
          "line_type": "p",
          "text": "آیا گمان دارید که کتاب بی‌جهت می‌گوید: «خدا نسبت به روحی که در ما ساکن کرده است، غیرت بسیار دارد؟»"
        },
        {
          "verse": 6,
          "usfm": "JAS.4.6",
          "line_type": "p",
          "text": "لیکن او فیض زیاده می‌بخشد. بنابراین می‌گوید: «خدا متکبران را مخالفت می‌کند، امّا فروتنان را فیض می‌بخشد.»"
        },
        {
          "verse": 7,
          "usfm": "JAS.4.7",
          "line_type": "p",
          "text": "پس خدا را اطاعت نمایید و با ابلیس مقاومت کنید تا از شما بگریزد."
        },
        {
          "verse": 8,
          "usfm": "JAS.4.8",
          "line_type": "p",
          "text": "و به خدا نزدیکی جویید تا به شما نزدیکی نماید. دستهای خود را پاک سازید، ای گناهکاران، و دلهای خود را تمیز کنید، ای دودلان."
        },
        {
          "verse": 9,
          "usfm": "JAS.4.9",
          "line_type": "p",
          "text": "خود را خوار سازید و ناله و گریه نمایید و خنده شما به ماتم و خوشی شما به غم تبدیل شود."
        },
        {
          "verse": 10,
          "usfm": "JAS.4.10",
          "line_type": "p",
          "text": "در حضور خدا فروتنی کنید تا شما را سرافراز فرماید."
        },
        {
          "verse": 11,
          "usfm": "JAS.4.11",
          "line_type": "p",
          "text": "‌ای برادران، یکدیگر را ناسزا مگویید، زیرا هر که برادر خود را ناسزا گوید و بر او قضاوت کند، شریعت را ناسزا گفته و بر شریعت قضاوت کرده باشد. لیکن اگر بر شریعت قضاوت کنی، به جا آورنده شریعت نیستی، بلکه داور هستی."
        },
        {
          "verse": 12,
          "usfm": "JAS.4.12",
          "line_type": "p",
          "text": "صاحب شریعت و داور، یکی است که بر رهانیدن و هلاک کردن قادر می‌باشد. پس تو کیستی که بر همسایه خود داوری می‌کنی؟"
        },
        {
          "verse": 13,
          "usfm": "JAS.4.13",
          "line_type": "p",
          "text": "امّا شماها، ای کسانی که می‌گویید: «امروز و فردا به فلان شهر خواهیم رفت و در آنجا یک سال به سر خواهیم برد و تجارت خواهیم کرد و نفع خواهیم برد»،"
        },
        {
          "verse": 14,
          "usfm": "JAS.4.14",
          "line_type": "p",
          "text": "و حال آنکه نمی‌دانید که فردا چه می‌شود؛ از آن رو که حیات شما چیست؟ مگر بخاری نیستید که اندک زمانی آشکار است و بعد ناپدید می‌شود؟"
        },
        {
          "verse": 15,
          "usfm": "JAS.4.15",
          "line_type": "p",
          "text": "به عوض آنکه باید گفت که «اگر خداوند بخواهد، زنده می‌مانیم و چنین و چنان می‌کنیم.»"
        },
        {
          "verse": 16,
          "usfm": "JAS.4.16",
          "line_type": "p",
          "text": "امّا اکنون به تکبّر خود فخر می‌کنید و هر چنین فخر بد است."
        },
        {
          "verse": 17,
          "usfm": "JAS.4.17",
          "line_type": "p",
          "text": "پس هر که نیکویی ‌کردن بداند و به عمل نیاورد، او را گناه است."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 13,
          "text": "فخر نکردن درباره فردا"
        }
      ],
