    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 3,
      "chapter_usfm": "JAS.3",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.3.1",
          "line_type": "p",
          "text": "ای برادران من، بسیار معلّم نشوید، چونکه می‌دانید که بر ما معلمان داوری سخت‌تر خواهد شد."
        },
        {
          "verse": 2,
          "usfm": "JAS.3.2",
          "line_type": "p",
          "text": "زیرا همگی ما بسیار می‌لغزیم. و اگر کسی در سخن‌گفتن نلغزد، او مرد کامل است و می‌تواند لگام تمام بدن خود را بکشد."
        },
        {
          "verse": 3,
          "usfm": "JAS.3.3",
          "line_type": "p",
          "text": "و اینک لگام را بر دهان اسبان می‌زنیم تا مطیع ما شوند و تمام بدن آنها را برمی‌گردانیم."
        },
        {
          "verse": 4,
          "usfm": "JAS.3.4",
          "line_type": "p",
          "text": "اینک کشتی‌ها نیز چقدر بزرگ است و از بادهای سخت رانده می‌شود، لیکن با سُکّان کوچک به هر طرفی که ارادهٔ ناخدا باشد، برگردانیده می‌شود."
        },
        {
          "verse": 5,
          "usfm": "JAS.3.5",
          "line_type": "p",
          "text": "همچنان زبان نیز عضوی کوچک است و سخنان کبرآمیز می‌گوید. اینک آتش کمی چه جنگل بزرگی را می‌سوزاند!"
        },
        {
          "verse": 6,
          "usfm": "JAS.3.6",
          "line_type": "p",
          "text": "و زبان آتشی است! آن عالم ناراستی در میان اعضای ما زبان است که تمام بدن را آلوده می‌کند و دایرهٔ کائنات را می‌سوزاند و جهنم است که آن را می‌افروزد."
        },
        {
          "verse": 7,
          "usfm": "JAS.3.7",
          "line_type": "p",
          "text": "زیرا که هر طبیعتی از وحوش و پرندگان و خزندگان و حیوانات دریایی از طبیعت انسان رام می‌شود و رام شده است."
        },
        {
          "verse": 8,
          "usfm": "JAS.3.8",
          "line_type": "p",
          "text": "لیکن زبان را کسی از مردمان نمی‌تواند رام کند. شرارتی سرکش و پر از زهر قاتل است!"
        },
        {
          "verse": 9,
          "usfm": "JAS.3.9",
          "line_type": "p",
          "text": "خداوند و پدر را به آن متبارک می‌خوانیم و به همان مردمان را که به صورت خدا آفریده شده‌اند، لعنت می‌گوییم."
        },
        {
          "verse": 10,
          "usfm": "JAS.3.10",
          "line_type": "p",
          "text": "از یک دهان برکت و لعنت بیرون می‌آید! ای برادران، شایسته نیست که چنین شود."
        },
        {
          "verse": 11,
          "usfm": "JAS.3.11",
          "line_type": "p",
          "text": "آیا چشمه از یک شکاف هم آب شیرین و هم آب شور جاری می‌سازد؟"
        },
        {
          "verse": 12,
          "usfm": "JAS.3.12",
          "line_type": "p",
          "text": "یا می‌شود، ای برادران من که درخت انجیر، زیتون یا درخت مو، انجیر بار آورد؟ چشمه شور نیز نمی‌تواند آب شیرین را موجود سازد."
        },
        {
          "verse": 13,
          "usfm": "JAS.3.13",
          "line_type": "p",
          "text": "کیست در میان شما که حکیم و عالم باشد؟ پس اعمال خود را از کردار نیکو به تواضع حکمت آشکار بسازد."
        },
        {
          "verse": 14,
          "usfm": "JAS.3.14",
          "line_type": "p",
          "text": "لیکن اگر در دل خود حسد تلخ و تعصب دارید، فخر مکنید و به ضد حقیقت دروغ مگویید."
        },
        {
          "verse": 15,
          "usfm": "JAS.3.15",
          "line_type": "p",
          "text": "این حکمت از بالا نازل نمی‌شود، بلکه دنیوی و نفسانی و شیطانی است."
        },
        {
          "verse": 16,
          "usfm": "JAS.3.16",
          "line_type": "p",
          "text": "زیرا هر جایی که حسد و تعصب است، در آنجا بلوا و هر امر زشت موجود می‌باشد."
        },
        {
          "verse": 17,
          "usfm": "JAS.3.17",
          "line_type": "p",
          "text": "لیکن آن حکمت که از بالا است، اوّل پاک است و بعد صلح‌آمیز و ملایم و نصیحت‌پذیر و پر از رحمت و میوه‌های نیکو و بی‌طرف و بی‌ریا."
        },
        {
          "verse": 18,
          "usfm": "JAS.3.18",
          "line_type": "p",
          "text": "و میوهٔ عدالت در صلح و صفا کاشته می‌شود به دست آنانی که صلح و صفا برقرار می‌کنند."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 13,
          "text": "حکمت از بالا"
        }
      ],
