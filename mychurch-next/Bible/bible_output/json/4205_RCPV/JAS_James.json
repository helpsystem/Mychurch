    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 5,
      "chapter_usfm": "JAS.5",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.5.1",
          "line_type": "p",
          "text": "شما، ای دولتمندان، به خاطر مصیبتهایی که بر شما وارد می‌آید، گریه و شیون نمایید."
        },
        {
          "verse": 2,
          "usfm": "JAS.5.2",
          "line_type": "p",
          "text": "ثروت شما فاسد و لباس شما بیدخورده می‌شود."
        },
        {
          "verse": 3,
          "usfm": "JAS.5.3",
          "line_type": "p",
          "text": "طلا و نقره شما را زنگ می‌خورد و زنگ آنها بر شما شهادت خواهد کرد و مثل آتش، گوشت شما را خواهد خورد. شما در زمان آخر ثروت اندوخته‌اید."
        },
        {
          "verse": 4,
          "usfm": "JAS.5.4",
          "line_type": "p",
          "text": "اینک مزد عمله‌هایی که کشتزارهای شما را درو کرده‌اند و شما آن را به فریب نگاه داشته‌اید، فریاد برمی‌آورد و ناله‌های دروگران، به گوشهای خداوند لشکرها رسیده است."
        },
        {
          "verse": 5,
          "usfm": "JAS.5.5",
          "line_type": "p",
          "text": "بر روی زمین به تجمّل و کامرانی مشغول بوده، دلهای خود را برای روز کشتار پروردید."
        },
        {
          "verse": 6,
          "usfm": "JAS.5.6",
          "line_type": "p",
          "text": "مرد عادل را محکوم کردید و او را به قتل رسانیدید. او با شما مقاومت نمی‌کند."
        },
        {
          "verse": 7,
          "usfm": "JAS.5.7",
          "line_type": "p",
          "text": "پس‌ ای برادران، تا هنگام آمدن خداوند صبر کنید. اینک دهقان انتظار می‌کشد برای محصول گرانبهای زمین و برایش صبر می‌کند تا باران اوّلین و آخرین را بیابد."
        },
        {
          "verse": 8,
          "usfm": "JAS.5.8",
          "line_type": "p",
          "text": "شما نیز صبر نمایید و دلهای خود را قوی سازید زیرا که آمدن خداوند نزدیک است."
        },
        {
          "verse": 9,
          "usfm": "JAS.5.9",
          "line_type": "p",
          "text": "‌ای برادران، از یکدیگر شکایت مکنید، مبادا بر شما داوری شود. اینک داور بر در ایستاده است."
        },
        {
          "verse": 10,
          "usfm": "JAS.5.10",
          "line_type": "p",
          "text": "‌ای برادران، نمونهٔ زحمت و صبر را بگیرید از پیامبرانی که به نام خداوند سخن گفتند."
        },
        {
          "verse": 11,
          "usfm": "JAS.5.11",
          "line_type": "p",
          "text": "اینک صبر کنندگان را خوشبخت می‌گوییم و صبر ایوب را شنیده‌اید و سرانجام کار خداوند را دانسته‌اید، زیرا که خداوند بسیار مهربان و کریم است."
        },
        {
          "verse": 12,
          "usfm": "JAS.5.12",
          "line_type": "p",
          "text": "لیکن اوّل همه‌، ای برادران من، قسم مخورید؛ نه به آسمان و نه به زمین و نه به هیچ سوگند دیگر. بلکه «بلی» شما «بلی» باشد و «نه» شما «نه»، مبادا محکوم شوید."
        },
        {
          "verse": 13,
          "usfm": "JAS.5.13",
          "line_type": "p",
          "text": "اگر کسی از شما مبتلای بلایی باشد، دعا بنماید و اگر کسی خوشحال باشد، سرود بخواند."
        },
        {
          "verse": 14,
          "usfm": "JAS.5.14",
          "line_type": "p",
          "text": "و هرگاه کسی از شما بیمار باشد، کشیشان کلیسا را طلب کند تا برایش دعا نمایند و او را به نام خداوند به روغن تدهین کنند."
        },
        {
          "verse": 15,
          "usfm": "JAS.5.15",
          "line_type": "p",
          "text": "و دعای ایمان، بیمار شما را شفا خواهد بخشید و خداوند او را خواهد برخیزانید و اگر گناه کرده باشد، بر او بخشیده خواهد شد."
        },
        {
          "verse": 16,
          "usfm": "JAS.5.16",
          "line_type": "p",
          "text": "نزد یکدیگر به گناهان خود اعتراف کنید و برای یکدیگر دعا کنید تا شفا یابید، زیرا دعای مرد عادل در عمل، قوت بسیار دارد."
        },
        {
          "verse": 17,
          "usfm": "JAS.5.17",
          "line_type": "p",
          "text": "ایلیا مردی بود صاحب حواس مثل ما و به تمامی دل دعا کرد که باران نبارد و تا مدّت سه سال و شش ماه نبارید."
        },
        {
          "verse": 18,
          "usfm": "JAS.5.18",
          "line_type": "p",
          "text": "و باز دعا کرد و آسمان بارید و زمین ثمر خود را رویانید."
        },
        {
          "verse": 19,
          "usfm": "JAS.5.19",
          "line_type": "p",
          "text": "‌ای برادران من، اگر کسی از شما از حقیقت منحرف شود و شخصی او را باز گرداند،"
        },
        {
          "verse": 20,
          "usfm": "JAS.5.20",
          "line_type": "p",
          "text": "بداند هر که گناهکار را از گمراهی او برگرداند، جانی را از مرگ رهانیده و گناهان بسیار را پوشانیده است."
        }
      ],
