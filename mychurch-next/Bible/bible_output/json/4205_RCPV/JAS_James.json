  "version_abbr": "RCPV",
  "version_name": "ترجمه کلاسیک بازنگری شده",
  "language": "fa",
  "chapter_count": 5,
  "total_verses": 108,
  "chapters": [
    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 1,
      "chapter_usfm": "JAS.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.1.1",
          "line_type": "p",
          "text": "یعقوب که غلام خدا و عیسی مسیح خداوند است، به دوازده قبیله که پراکنده هستند.خوش باشید."
        },
        {
          "verse": 2,
          "usfm": "JAS.1.2",
          "line_type": "p",
          "text": "‌ای برادران من، وقتی که در امتحانهای گوناگون می‌افتید، کمال خوشی دانید."
        },
        {
          "verse": 3,
          "usfm": "JAS.1.3",
          "line_type": "p",
          "text": "چونکه می‌دانید که امتحان ایمان شما صبر را پیدا می‌کند."
        },
        {
          "verse": 4,
          "usfm": "JAS.1.4",
          "line_type": "p",
          "text": "لیکن صبر را عمل کامل خود باشد تا کامل و تمام شوید و محتاج هیچ‌ چیز نباشید."
        },
        {
          "verse": 5,
          "usfm": "JAS.1.5",
          "line_type": "p",
          "text": "و اگر از شما کسی محتاج به حکمت باشد، بخواهد از خدایی که هر کس را به گشاده‌دستی عطا می‌کند و ملامت نمی‌نماید و به او داده خواهد شد."
        },
        {
          "verse": 6,
          "usfm": "JAS.1.6",
          "line_type": "p",
          "text": "لیکن به ایمان بخواهد و هرگز شک نکند، زیرا هر که شک کند، مانند موج دریاست که از باد رانده و متلاطم می‌شود."
        },
        {
          "verse": 7,
          "usfm": "JAS.1.7",
          "line_type": "p",
          "text": "زیرا چنین شخص گمان نبرد که از خداوند چیزی خواهد یافت."
        },
        {
          "verse": 8,
          "usfm": "JAS.1.8",
          "line_type": "p",
          "text": "مرد دو دل در تمام رفتار خود ناپایدار است."
        },
        {
          "verse": 9,
          "usfm": "JAS.1.9",
          "line_type": "p",
          "text": "لیکن برادر مسکین به‌ سرافرازی خود فخر بنماید"
        },
        {
          "verse": 10,
          "usfm": "JAS.1.10",
          "line_type": "p",
          "text": "و دولتمند به فقیری خود، زیرا مثل گل علف در گذر است."
        },
        {
          "verse": 11,
          "usfm": "JAS.1.11",
          "line_type": "p",
          "text": "از آن رو که آفتاب با گرمی طلوع کرده، علف را خشکانید و گُلش به زیر افتاده، زیبایی صورتش زایل شد. به همینطور شخص دولتمند نیز در راههای خود، پژمرده خواهد گردید."
        },
        {
          "verse": 12,
          "usfm": "JAS.1.12",
          "line_type": "p",
          "text": "خوشا به حال کسی ‌که متحمّل امتحان شود، زیرا که چون آزموده شد، آن تاج حیاتی را که خدا به دوستداران خود وعده فرموده است، خواهد یافت."
        },
        {
          "verse": 13,
          "usfm": "JAS.1.13",
          "line_type": "p",
          "text": "هیچ‌کس چون در وسوسه افتد، نگوید: «خدا مرا وسوسه می‌کند»، زیرا خدا هرگز از بدیها وسوسه نمی‌شود و او هیچ‌کس را وسوسه نمی‌کند."
        },
        {
          "verse": 14,
          "usfm": "JAS.1.14",
          "line_type": "p",
          "text": "لیکن هر کس در وسوسه می‌افتد وقتی که شهوت وی او را می‌کشد و فریفته می‌سازد."
        },
        {
          "verse": 15,
          "usfm": "JAS.1.15",
          "line_type": "p",
          "text": "پس شهوت آبستن شده، گناه را می‌زاید و گناه نیز چون به تمام و کمال رشد کرد، مرگ را تولید می‌کند."
        },
        {
          "verse": 16,
          "usfm": "JAS.1.16",
          "line_type": "p",
          "text": "‌ای برادران عزیز من، گمراه مشوید!"
        },
        {
          "verse": 17,
          "usfm": "JAS.1.17",
          "line_type": "p",
          "text": "هر بخشندگی نیکو و هر بخشش کامل از بالا است و فرو می‌ریزد از پدر نورها که نزد او هیچ تبدیل و سایه ناشی از تغییر نیست."
        },
        {
          "verse": 18,
          "usfm": "JAS.1.18",
          "line_type": "p",
          "text": "او تنها به خاطر ارادهٔ خود ما را به‌وسیلهٔ کلمهٔ حقیقت تولید نمود تا ما همچون نوبر مخلوقات او باشیم."
        },
        {
          "verse": 19,
          "usfm": "JAS.1.19",
          "line_type": "p",
          "text": "بنابراین، ای برادران عزیز من، هر کس در شنیدن تند و در گفتن آهسته و در خشم سست باشد."
        },
        {
          "verse": 20,
          "usfm": "JAS.1.20",
          "line_type": "p",
          "text": "زیرا خشم انسان عدالت خدا را حاصل نمی‌آورد."
        },
        {
          "verse": 21,
          "usfm": "JAS.1.21",
          "line_type": "p",
          "text": "پس هر نجاست و افزونی شر را دور کنید و با فروتنی، کلام کاشته شده را بپذیرید که قادر است که جانهای شما را نجات‌ بخشد."
        },
        {
          "verse": 22,
          "usfm": "JAS.1.22",
          "line_type": "p",
          "text": "لیکن کنندگان کلام باشید، نه فقط شنوندگان که خود را فریب می‌دهند."
        },
        {
          "verse": 23,
          "usfm": "JAS.1.23",
          "line_type": "p",
          "text": "زیرا اگر کسی کلام را بشنود و عمل نکند، شخصی را ماند که چهرهٔ طبیعی خود را در آینه می‌نگرد."
        },
        {
          "verse": 24,
          "usfm": "JAS.1.24",
          "line_type": "p",
          "text": "زیرا خود را نگریست و رفت و فوراً فراموش کرد که چطور شخصی بود."
        },
        {
          "verse": 25,
          "usfm": "JAS.1.25",
          "line_type": "p",
          "text": "لیکن کسی ‌که بر شریعت کامل آزادی چشم دوخت و در آن استوار ماند، او همچون شنوندهٔ فراموشکار نمی‌باشد، بلکه کنندهٔ عمل. پس او در عمل خود مبارک خواهد بود."
        },
        {
          "verse": 26,
          "usfm": "JAS.1.26",
          "line_type": "p",
          "text": "اگر کسی از شما گمان برد که پرستندهٔ خدا است و لگام زبان خود را نکشد، بلکه دل خود را فریب دهد، پرستش او باطل است."
        },
        {
          "verse": 27,
          "usfm": "JAS.1.27",
          "line_type": "p",
          "text": "پرستش صاف و بی‌عیب نزد خدا و پدر این است که یتیمان و بیوه‌زنان را در مصیبت ایشان دستگیری کنند و خود را از آلودگی دنیا نگاه دارند."
        }
      ],
      "verse_count": 27,
      "headings": [
        {
          "before_verse": 2,
          "text": "امتحان ایمان شما"
        },
        {
          "before_verse": 19,
          "text": "شنیدن کلام و عمل کردن به آن"
        }
      ],
