    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 2,
      "chapter_usfm": "1TI.2",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.2.1",
          "line_type": "p",
          "text": "پس از همه ‌چیز، اوّل توصیه می‌کنم که درخواستها و دعاها و شفاعتها و شکرها را برای همه مردم به‌ جا آورند؛"
        },
        {
          "verse": 2,
          "usfm": "1TI.2.2",
          "line_type": "p",
          "text": "برای پادشاهان و تمامی صاحبان منصب تا به آرامی و استراحت و با کمال دینداری و وقار، عمر خود را به سر بریم."
        },
        {
          "verse": 3,
          "usfm": "1TI.2.3",
          "line_type": "p",
          "text": "زیرا که این نیکو و پسندیده است، در حضور نجات‌دهندهٔ ما خدا"
        },
        {
          "verse": 4,
          "usfm": "1TI.2.4",
          "line_type": "p",
          "text": "که می‌خواهد همه مردم نجات یابند و به معرفت حقیقت نائل گردند."
        },
        {
          "verse": 5,
          "usfm": "1TI.2.5",
          "line_type": "p",
          "text": "زیرا خدا واحد است و در میان خدا و انسان یک واسطه است یعنی انسانی که مسیح عیسی باشد،"
        },
        {
          "verse": 6,
          "usfm": "1TI.2.6",
          "line_type": "p",
          "text": "که خود را در راه همه فدا داد، شهادتی در زمان معین."
        },
        {
          "verse": 7,
          "usfm": "1TI.2.7",
          "line_type": "p",
          "text": "و برای این، من واعظ و رسول و معلّم غیریهودیان در ایمان و حقیقت گماشته شدم. در مسیح راست می‌گویم و دروغ نه."
        },
        {
          "verse": 8,
          "usfm": "1TI.2.8",
          "line_type": "p",
          "text": "پس آرزوی این دارم که مردان، دستهای مقدّس را بدون خشم و جدال برافراخته، در هر جا دعا کنند."
        },
        {
          "verse": 9,
          "usfm": "1TI.2.9",
          "line_type": "p",
          "text": "و همچنین زنان خود را بیارایند به لباس تزیین یافته به نجابت و متانت، نه به گیسوان و طلا و مروارید و لباس گرانبها؛"
        },
        {
          "verse": 10,
          "usfm": "1TI.2.10",
          "line_type": "p",
          "text": "بلکه چنانکه زنانی را می‌شاید که ادعای دینداری می‌کنند به کارهای نیک."
        },
        {
          "verse": 11,
          "usfm": "1TI.2.11",
          "line_type": "p",
          "text": "زن با سکوت، به‌ کمال اطاعت تعلیم گیرد."
        },
        {
          "verse": 12,
          "usfm": "1TI.2.12",
          "line_type": "p",
          "text": "و زن را اجازه نمی‌دهم که تعلیم دهد یا بر شوهر مسلط شود بلکه در سکوت بماند."
        },
        {
          "verse": 13,
          "usfm": "1TI.2.13",
          "line_type": "p",
          "text": "زیرا که آدم اوّل سرشته شد و بعد حوا."
        },
        {
          "verse": 14,
          "usfm": "1TI.2.14",
          "line_type": "p",
          "text": "و آدم فریب نخورد بلکه زن فریب خورده، در تقصیر گرفتار شد."
        },
        {
          "verse": 15,
          "usfm": "1TI.2.15",
          "line_type": "p",
          "text": "امّا به زاییدن رستگار خواهد شد، اگر در ایمان و محبّت و قدّوسیّت و تقوا استوار بمانند."
        }
      ],
