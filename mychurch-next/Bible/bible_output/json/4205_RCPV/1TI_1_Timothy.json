    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 6,
      "chapter_usfm": "1TI.6",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.6.1",
          "line_type": "p",
          "text": "آنانی که غلامان زیر یوغ می‌باشند، آقایان خویش را لایق کمال احترام بدانند، که مبادا نام و تعلیم خدا بد گفته شود."
        },
        {
          "verse": 2,
          "usfm": "1TI.6.2",
          "line_type": "p",
          "text": "امّا کسانی که آقایان مؤمن دارند، ایشان را تحقیر ننمایند، از آنجا که برادرانند، بلکه بیشتر خدمت کنند، از آنرو که آنانی که در این نیکویی شرکت دارند، مؤمن و عزیز هستند."
        },
        {
          "verse": 3,
          "usfm": "1TI.6.3",
          "line_type": "p",
          "text": "و اگر کسی به طور دیگر تعلیم دهد و کلام صحیح خداوند ما عیسی مسیح و آن تعلیمی را که به طریق دینداری است قبول ننماید،"
        },
        {
          "verse": 4,
          "usfm": "1TI.6.4",
          "line_type": "p",
          "text": "از غرور مست شده، هیچ نمی‌داند، بلکه در بحثها و کشمکشها دیوانه گشته است که از آنها پدید می‌آید، حسد و دعوا و ناسزاگویی و بدگمانی"
        },
        {
          "verse": 5,
          "usfm": "1TI.6.5",
          "line_type": "p",
          "text": "و ستیزه‌جویی مردم در عقل فاسد و گمراه از حقیقت، که می‌پندارند دینداری سود است."
        },
        {
          "verse": 6,
          "usfm": "1TI.6.6",
          "line_type": "p",
          "text": "لیکن دینداری با قناعت سود عظیمی است."
        },
        {
          "verse": 7,
          "usfm": "1TI.6.7",
          "line_type": "p",
          "text": "زیرا که در این دنیا هیچ نیاوردیم و معلوم است که از آن هیچ نمی‌توانیم برد."
        },
        {
          "verse": 8,
          "usfm": "1TI.6.8",
          "line_type": "p",
          "text": "پس اگر خوراک و پوشاک داریم، به آنها قانع خواهیم بود."
        },
        {
          "verse": 9,
          "usfm": "1TI.6.9",
          "line_type": "p",
          "text": "امّا آنانی که می‌خواهند دولتمند شوند، گرفتار می‌شوند در وسوسه و دام و انواع شهوات پوچ و زیانبار که مردم را به تباهی و هلاکت غرق می‌سازند."
        },
        {
          "verse": 10,
          "usfm": "1TI.6.10",
          "line_type": "p",
          "text": "زیرا که پولدوستی ریشه همه بدیها است که بعضی چون در‌ پی آن می‌کوشیدند، از ایمان گمراه گشته، خود را به اقسام مجروح ساختند."
        },
        {
          "verse": 11,
          "usfm": "1TI.6.11",
          "line_type": "p",
          "text": "ولی تو، ‌ای مرد خدا، از اینها بگریز و عدالت و دینداری و ایمان و محبّت و صبر و تواضع را پیروی نما."
        },
        {
          "verse": 12,
          "usfm": "1TI.6.12",
          "line_type": "p",
          "text": "و جنگ نیکوی ایمان را بکن و به دست آور آن حیات جاودانی را که برای آن دعوت شدی و اعتراف نیکو کردی در حضور شاهدان بسیار."
        },
        {
          "verse": 13,
          "usfm": "1TI.6.13",
          "line_type": "p",
          "text": "تو را سفارش می‌کنم به حضور آن خدایی که همه را زندگی می‌بخشد و مسیح عیسی که در‌ پیش پُنتیوس پیلاتُس اعتراف نیکو نمود،"
        },
        {
          "verse": 14,
          "usfm": "1TI.6.14",
          "line_type": "p",
          "text": "که تو این حکم را بی‌لکه و به دور از ملامت حفظ کنی تا به ظهور خداوند ما عیسی مسیح."
        },
        {
          "verse": 15,
          "usfm": "1TI.6.15",
          "line_type": "p",
          "text": "که آن را، آن متبارک و قادر یکتا و شاه شاهان و خداوند خداوندان در زمان معین به ظهور خواهد آورد."
        },
        {
          "verse": 16,
          "usfm": "1TI.6.16",
          "line_type": "p",
          "text": "که تنها فناناپذیر و ساکن در نوری است که نزدیک آن نتوان شد و هیچ انسانی او را ندیده و نمی‌تواند دید. او را تا به ابد حرمت و قدرت باد. آمین."
        },
        {
          "verse": 17,
          "usfm": "1TI.6.17",
          "line_type": "p",
          "text": "دولتمندان این جهان را امر فرما که بلندپروازی نکنند و به دولت ناپایدار امید ندارند، بلکه به خدا که همه ‌چیز را دولتمندانه برای بهره بردن به ما عطا می‌کند؛"
        },
        {
          "verse": 18,
          "usfm": "1TI.6.18",
          "line_type": "p",
          "text": "که نیکوکار بوده، در کارهای نیک دولتمند و سخاوتمند و گشاده‌دست باشند"
        },
        {
          "verse": 19,
          "usfm": "1TI.6.19",
          "line_type": "p",
          "text": "و برای خود بنیاد نیکو به جهت جهان آینده گذارند تا حیات جاودانی را به دست آرند."
        },
        {
          "verse": 20,
          "usfm": "1TI.6.20",
          "line_type": "p",
          "text": "‌ای تیموتائوس، تو آن امانت را محفوظ دار و از سخنان مبتذل کفرآمیز و از مباحثاتی که به غلط، \"معرفت\" نامیده می‌شود، دوری نما،"
        },
        {
          "verse": 21,
          "usfm": "1TI.6.21",
          "line_type": "p",
          "text": "که بعضی چون ادّعای آن کردند، از ایمان منحرف گشتند. فیض با تو باد. آمین."
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 11,
          "text": "جنگ نیکوی ایمان را بکن"
        }
      ],
