    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 4,
      "chapter_usfm": "1TI.4",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.4.1",
          "line_type": "p",
          "text": "و لیکن روح آشکارا می‌گوید که در زمان آخر بعضی از ایمان برگشته، به ارواح فریبنده و تعالیم شیاطین گوش خواهند نمود،"
        },
        {
          "verse": 2,
          "usfm": "1TI.4.2",
          "line_type": "p",
          "text": "به ریاکاری دروغگویان که وجدانهای خود را از کار انداخته‌اند؛"
        },
        {
          "verse": 3,
          "usfm": "1TI.4.3",
          "line_type": "p",
          "text": "که ازدواج را منع می‌کنند و امر می‌نمایند به دوری از خوراکهایی که خدا آفرید برای مؤمنین و آگاهان از حقیقت تا آنها را به شکرگزاری بخورند."
        },
        {
          "verse": 4,
          "usfm": "1TI.4.4",
          "line_type": "p",
          "text": "زیرا که هر مخلوق خدا نیکو است و هیچ‌ چیز را رد نباید کرد، اگر به شکرگزاری پذیرند،"
        },
        {
          "verse": 5,
          "usfm": "1TI.4.5",
          "line_type": "p",
          "text": "زیرا که از کلام خدا و دعا تقدیس می‌شود."
        },
        {
          "verse": 6,
          "usfm": "1TI.4.6",
          "line_type": "p",
          "text": "اگر این امور را به برادران بسپاری، خادم نیکوی مسیح عیسی خواهی بود، تربیت یافته در کلام ایمان و تعلیم خوب که پیروی آن را کرده‌ای."
        },
        {
          "verse": 7,
          "usfm": "1TI.4.7",
          "line_type": "p",
          "text": "لیکن از افسانه‌های کفرآمیز پیرزنان دوری کن و در دینداری خود را تربیت کن."
        },
        {
          "verse": 8,
          "usfm": "1TI.4.8",
          "line_type": "p",
          "text": "که تربیت بدنی اندک فایده‌ای دارد، لیکن دینداری برای هر چیز مفید است که وعده زندگی حال و آینده را دارد."
        },
        {
          "verse": 9,
          "usfm": "1TI.4.9",
          "line_type": "p",
          "text": "این سخن امین است و لایق قبول کامل،"
        },
        {
          "verse": 10,
          "usfm": "1TI.4.10",
          "line_type": "p",
          "text": "زیرا که برای این زحمات و بی‌احترامی می‌کشیم، زیرا امید داریم به خدای زنده که همه مردمان به ویژه مؤمنین را نجات‌دهنده است."
        },
        {
          "verse": 11,
          "usfm": "1TI.4.11",
          "line_type": "p",
          "text": "این امور را امر و تعلیم فرما."
        },
        {
          "verse": 12,
          "usfm": "1TI.4.12",
          "line_type": "p",
          "text": "هیچ‌‌کس جوانی تو را حقیر نشمارد، بلکه مؤمنین را در کلام و کردار و محبّت و ایمان و پاکی، نمونه باش."
        },
        {
          "verse": 13,
          "usfm": "1TI.4.13",
          "line_type": "p",
          "text": "تا آمدنم خود را به خواندن کلام و نصیحت و تعلیم بسپار."
        },
        {
          "verse": 14,
          "usfm": "1TI.4.14",
          "line_type": "p",
          "text": "به هوش باش که به آن عطایی که در تو است که به‌وسیله نبوّت با نهادن دستهای کشیشان به تو داده شد، بی‌اعتنایی منمایی."
        },
        {
          "verse": 15,
          "usfm": "1TI.4.15",
          "line_type": "p",
          "text": "در این امور مشغول باش و در اینها استوار بمان تا پیشرفت تو بر همه آشکار شود."
        },
        {
          "verse": 16,
          "usfm": "1TI.4.16",
          "line_type": "p",
          "text": "خود را و تعلیم را مراقب باش و در این امور استوار بایست که هرگاه چنین کنی، خود را و شنوندگان خویش را نیز نجات خواهی داد."
        }
      ],
