    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 3,
      "chapter_usfm": "1TI.3",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.3.1",
          "line_type": "p",
          "text": "این سخن امین است که اگر کسی مقام اسقفی را بخواهد، کار نیکو می‌طلبد."
        },
        {
          "verse": 2,
          "usfm": "1TI.3.2",
          "line_type": "p",
          "text": "پس اسقف باید بی‌ملامت و صاحب یک زن و هشیار و خردمند و آبرومند و مهمان‌نواز و راغب به تعلیم باشد؛"
        },
        {
          "verse": 3,
          "usfm": "1TI.3.3",
          "line_type": "p",
          "text": "نه میگسار یا خشن، بلکه حلیم و نه جنگجو و نه پول‌دوست."
        },
        {
          "verse": 4,
          "usfm": "1TI.3.4",
          "line_type": "p",
          "text": "اداره کنندهٔ اهل خانهٔ خود به نیکویی، و فرزندان خویش را در کمال وقار مطیع گرداند،"
        },
        {
          "verse": 5,
          "usfm": "1TI.3.5",
          "line_type": "p",
          "text": "زیرا هرگاه کسی نداند که اهل خانهٔ خود را تدبیر کند، چگونه کلیسای خدا را نگاهبانی می‌نماید؟"
        },
        {
          "verse": 6,
          "usfm": "1TI.3.6",
          "line_type": "p",
          "text": "و نه فردی جدید در ایمان که مبادا غرور کرده، به محکومیت ابلیس بیفتد."
        },
        {
          "verse": 7,
          "usfm": "1TI.3.7",
          "line_type": "p",
          "text": "امّا لازم است که نزد آنانی که خارجند هم نیکنام باشد، که مبادا در رسوایی و دام ابلیس گرفتار شود."
        },
        {
          "verse": 8,
          "usfm": "1TI.3.8",
          "line_type": "p",
          "text": "همچنین شماسان با وقار باشند، نه دو زبان و نه راغب به شراب زیاده و نه به دنبال منافع نامشروع؛"
        },
        {
          "verse": 9,
          "usfm": "1TI.3.9",
          "line_type": "p",
          "text": "دارندگان راز ایمان در وجدان پاک."
        },
        {
          "verse": 10,
          "usfm": "1TI.3.10",
          "line_type": "p",
          "text": "امّا باید اوّل ایشان آزموده شوند و چون بی‌عیب یافت شدند، کار شماسی را بکنند."
        },
        {
          "verse": 11,
          "usfm": "1TI.3.11",
          "line_type": "p",
          "text": "و به همینطور زنان نیز باید باوقار باشند و نه غیبت‌گو، بلکه هشیار و در هر امری امین."
        },
        {
          "verse": 12,
          "usfm": "1TI.3.12",
          "line_type": "p",
          "text": "و شماسان صاحب یک زن باشند و فرزندان و اهل خانهٔ خویش را نیکو تدبیر نمایند،"
        },
        {
          "verse": 13,
          "usfm": "1TI.3.13",
          "line_type": "p",
          "text": "زیرا آنانی که کار شماسی را نیکو کرده باشند، مرتبه‌ای خوب برای خود کسب می‌کنند و اطمینان کامل در ایمانی که به مسیح عیسی است."
        },
        {
          "verse": 14,
          "usfm": "1TI.3.14",
          "line_type": "p",
          "text": "این به تو می‌نویسم به امید آنکه به زودی نزد تو آیم."
        },
        {
          "verse": 15,
          "usfm": "1TI.3.15",
          "line_type": "p",
          "text": "لیکن اگر تأخیر اندازم، تا بدانی که چگونه باید در خانهٔ خدا رفتار کنی که کلیسای خدای زنده و ستون و بنیاد حقیقت است."
        },
        {
          "verse": 16,
          "usfm": "1TI.3.16",
          "line_type": "p",
          "text": "به یقین که راز دینداری عظیم است که خدا در جسم آشکار شد و در روح، تصدیق کرده شد و به فرشتگان ظاهر گردید و به ملّتها موعظه کرده و در دنیا ایمان آورده و به جلال بالا برده شد."
        }
      ],
