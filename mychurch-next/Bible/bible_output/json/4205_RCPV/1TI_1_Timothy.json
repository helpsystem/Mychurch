    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 5,
      "chapter_usfm": "1TI.5",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.5.1",
          "line_type": "p",
          "text": "مرد پیر را توبیخ منما، بلکه چون پدر او را نصیحت کن، و جوانان را چون برادران."
        },
        {
          "verse": 2,
          "usfm": "1TI.5.2",
          "line_type": "p",
          "text": "زنان پیر را چون مادران. و زنان جوان را مثل خواهران با کمال عفت."
        },
        {
          "verse": 3,
          "usfm": "1TI.5.3",
          "line_type": "p",
          "text": "بیوه‌زنان را اگر به راستی بیوه باشند، محترم دار."
        },
        {
          "verse": 4,
          "usfm": "1TI.5.4",
          "line_type": "p",
          "text": "امّا اگر بیوه‌زنی فرزندان یا نواده‌ها دارد، آموخته بشوند که خانهٔ خود را با دینداری نگاه دارند و حقوق اجداد خود را ادا کنند که این در حضور خدا نیکو و پسندیده است."
        },
        {
          "verse": 5,
          "usfm": "1TI.5.5",
          "line_type": "p",
          "text": "امّا زنی که به راستی بیوه و بی‌کس است، به خدا امیدوار است و در درخواستها و دعاها شبانه‌روز مشغول می‌باشد."
        },
        {
          "verse": 6,
          "usfm": "1TI.5.6",
          "line_type": "p",
          "text": "لیکن زن عیاش در حال حیات مرده است."
        },
        {
          "verse": 7,
          "usfm": "1TI.5.7",
          "line_type": "p",
          "text": "و به این امور امر فرما تا بی‌ملامت باشند."
        },
        {
          "verse": 8,
          "usfm": "1TI.5.8",
          "line_type": "p",
          "text": "ولی اگر کسی برای خویشان و به ویژه اهل خانهٔ خود تامین معاش نکند، مُنکر ایمان و پست‌تر از بی‌ایمان است."
        },
        {
          "verse": 9,
          "usfm": "1TI.5.9",
          "line_type": "p",
          "text": "بیوه‌زنی که کمتر از شصت ساله نباشد و یک شوهر کرده باشد، باید نام او ثبت گردد،"
        },
        {
          "verse": 10,
          "usfm": "1TI.5.10",
          "line_type": "p",
          "text": "که در اعمال صالح نیکنام باشد، اگر فرزندان را تربیت کرده و غریبان را مهمانی نموده و پایهای مقدسین را شسته و زحمت کشان را کمکی نموده و هر کار نیکو را پیروی کرده باشد."
        },
        {
          "verse": 11,
          "usfm": "1TI.5.11",
          "line_type": "p",
          "text": "امّا بیوه های جوانتر از این را قبول مکن، زیرا که چون از مسیح سرکش شوند، خواسته ازدواج دارند"
        },
        {
          "verse": 12,
          "usfm": "1TI.5.12",
          "line_type": "p",
          "text": "و محکوم می‌شوند از اینکه ایمان نخست را زیر پا گذاشته‌اند."
        },
        {
          "verse": 13,
          "usfm": "1TI.5.13",
          "line_type": "p",
          "text": "و علاوه بر این، خانه به خانه گردش کرده، یاد می‌گیرند که بی‌کار باشند؛ و نه فقط بی‌کار بلکه سخن‌چین و فضول هم که حرفهای ناشایسته می‌زنند."
        },
        {
          "verse": 14,
          "usfm": "1TI.5.14",
          "line_type": "p",
          "text": "پس نظر من این است که بیوه‌های جوانتر شوهر کنند و فرزندان بزایند و کدبانو شوند و دشمن را مجال بدگویی ندهند."
        },
        {
          "verse": 15,
          "usfm": "1TI.5.15",
          "line_type": "p",
          "text": "زیرا که بعضی برگشتند به عقب شیطان."
        },
        {
          "verse": 16,
          "usfm": "1TI.5.16",
          "line_type": "p",
          "text": "اگر زنی ایماندار، خویشاوندان بیوه دارد، ایشان را یاری کند و بار بر کلیسا نگذارد تا آنانی را که به راستی بیوه باشند، کمک نماید."
        },
        {
          "verse": 17,
          "usfm": "1TI.5.17",
          "line_type": "p",
          "text": "کشیشانی که نیکو رهبری کرده‌اند، سزاوار حرمت دو برابر می‌باشند، به ویژه آنانی که در کلام و تعلیم زحمت می‌کشند."
        },
        {
          "verse": 18,
          "usfm": "1TI.5.18",
          "line_type": "p",
          "text": "زیرا کتاب می‌گوید: «گاو را وقتی که خرمن را خُرد می‌کند، دهن مبند» و «مزدور سزاوار مزد خود است.»"
        },
        {
          "verse": 19,
          "usfm": "1TI.5.19",
          "line_type": "p",
          "text": "ادعایی بر یکی از کشیشان جز به زبان دو یا سه شاهد مپذیر."
        },
        {
          "verse": 20,
          "usfm": "1TI.5.20",
          "line_type": "p",
          "text": "آنانی که گناه کنند، پیش همه توبیخ فرما تا دیگران بترسند."
        },
        {
          "verse": 21,
          "usfm": "1TI.5.21",
          "line_type": "p",
          "text": "در حضور خدا و مسیح عیسی و فرشتگان برگزیده تو را قسم می‌دهم که این امور را بدون غَرَض نگاه داری و هیچ کاری از روی طرفداری مکن."
        },
        {
          "verse": 22,
          "usfm": "1TI.5.22",
          "line_type": "p",
          "text": "و دستها به زودی بر هیچ‌‌کس مگذار و در گناهان دیگران شریک مشو، بلکه خود را پاک نگاه دار."
        },
        {
          "verse": 23,
          "usfm": "1TI.5.23",
          "line_type": "p",
          "text": "دیگر آشامنده آب فقط مباش، بلکه به خاطر شکمت و ضعفهای بسیار خود شرابی کم بیاشام."
        },
        {
          "verse": 24,
          "usfm": "1TI.5.24",
          "line_type": "p",
          "text": "گناهان بعضی آشکار است و پیش روی ایشان به داوری می‌شتابد، امّا بعضی را تعقیب می‌کند."
        },
        {
          "verse": 25,
          "usfm": "1TI.5.25",
          "line_type": "p",
          "text": "و همچنین کارهای نیکو معلوم است و آنهایی که به اینگونه نیست، نتوان مخفی داشت."
        }
      ],
      "verse_count": 25,
      "headings": [],
      "footnotes": [
        {
          "verse": 18,
          "usfm": "1TI.5.18",
          "note_ref": "5‏.18",
          "note_type": "footnote",
          "references": [],
          "text": "تَثنیه 25‏:4"
