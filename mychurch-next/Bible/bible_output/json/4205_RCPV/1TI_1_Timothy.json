{
  "book_id": "1TI",
  "book_name_en": "1 Timothy",
  "book_name_fa": "اول تیموتائوس",
  "testament": "NT",
  "version_id": 4205,
  "version_abbr": "RCPV",
  "version_name": "ترجمه کلاسیک بازنگری شده",
  "language": "fa",
  "chapter_count": 6,
  "total_verses": 113,
  "chapters": [
    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 1,
      "chapter_usfm": "1TI.1",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.1.1",
          "line_type": "p",
          "text": "پولس، رسول عیسی مسیح به فرمان نجات‌دهندهٔ ما خدا و مسیح عیسی که امید ما است،"
        },
        {
          "verse": 2,
          "usfm": "1TI.1.2",
          "line_type": "p",
          "text": "به فرزند حقیقی خود در ایمان، تیموتائوس.فیض و رحم و سلامتی از جانب خدای پدر و خداوند ما مسیح عیسی بر تو باد."
        },
        {
          "verse": 3,
          "usfm": "1TI.1.3",
          "line_type": "p",
          "text": "چنانکه هنگامی که عازم مقدونیه بودم، به شما التماس نمودم که در اَفِسُس بمانی تا بعضی را امر کنی که تعلیمی دیگر ندهند،"
        },
        {
          "verse": 4,
          "usfm": "1TI.1.4",
          "line_type": "p",
          "text": "و افسانه‌ها و نسب‌نامه‌های بی‌سر و ته را گوش ننمایند که اینها مباحثات را، نه آن بنای کار خدا را که در ایمان است، پدید می‌آورد."
        },
        {
          "verse": 5,
          "usfm": "1TI.1.5",
          "line_type": "p",
          "text": "امّا هدف فرمان ما، محبّت است از دل پاک و وجدان صالح و ایمان بی‌ریا."
        },
        {
          "verse": 6,
          "usfm": "1TI.1.6",
          "line_type": "p",
          "text": "که از این امور بعضی منحرف گشته به سخنان مبتذل توجّه نموده‌اند"
        },
        {
          "verse": 7,
          "usfm": "1TI.1.7",
          "line_type": "p",
          "text": "و می‌خواهند معلمان شریعت بشوند و حال آنکه نمی‌فهمند آنچه می‌گویند و نه آنچه به تأکید بیان می‌نمایند."
        },
        {
          "verse": 8,
          "usfm": "1TI.1.8",
          "line_type": "p",
          "text": "لیکن می‌دانیم که شریعت نیکو است اگر کسی آن را مطابق شریعت به کار برد."
        },
        {
          "verse": 9,
          "usfm": "1TI.1.9",
          "line_type": "p",
          "text": "و این بداند که شریعت به جهت عادل وضع نمی‌شود، بلکه برای سرکشان و یاغیان و بی‌دینان و گناهکاران و ناپاکان و کافران و قاتلان پدر و قاتلان مادر و قاتلان مردم"
        },
        {
          "verse": 10,
          "usfm": "1TI.1.10",
          "line_type": "p",
          "text": "و زناکاران و لواط گران و آدم ربایان و دروغ‌گویان و قسم دروغ خوران و برای هر عمل دیگری که برخلاف تعلیم صحیح باشد،"
        },
        {
          "verse": 11,
          "usfm": "1TI.1.11",
          "line_type": "p",
          "text": "مطابق انجیل جلال خدای متبارک که به من سپرده شده است."
        },
        {
          "verse": 12,
          "usfm": "1TI.1.12",
          "line_type": "p",
          "text": "و شکر می‌کنم خداوند خود مسیح عیسی را که مرا تقویت داد، چونکه امین شمرده، به این خدمتم تعیین فرمود،"
        },
        {
          "verse": 13,
          "usfm": "1TI.1.13",
          "line_type": "p",
          "text": "که سابق کفرگو و ستمگر و زورگو بودم، لیکن رحم یافتم از آن رو که از جهالت در بی‌ایمانی کردم."
        },
        {
          "verse": 14,
          "usfm": "1TI.1.14",
          "line_type": "p",
          "text": "امّا فیض خداوند ما بی‌نهایت افزود با‌ ایمان و محبّتی که در مسیح عیسی است."
        },
        {
          "verse": 15,
          "usfm": "1TI.1.15",
          "line_type": "p",
          "text": "این سخن امین است و لایق قبول کامل که مسیح عیسی به ‌دنیا آمد تا گناهکاران را نجات‌ بخشد که من بزرگترینِ آنها هستم."
        },
        {
          "verse": 16,
          "usfm": "1TI.1.16",
          "line_type": "p",
          "text": "بلکه از این جهت بر من رحم شد تا اوّل در من، مسیح عیسی کمال حِلم را آشکار سازد تا آنانی را که به خاطر حیات جاودانی به وی ایمان خواهند ‌آورد، نمونه باشم."
        },
        {
          "verse": 17,
          "usfm": "1TI.1.17",
          "line_type": "p",
          "text": "باری پادشاه سرمدی و باقی و نادیده را، خدای یکتا را حرمت و جلال تا به ابد باد. آمین."
        },
        {
          "verse": 18,
          "usfm": "1TI.1.18",
          "line_type": "p",
          "text": "‌ای فرزند، تیموتائوس، این توصیه را به تو می‌سپارم مطابق نبوّتهایی که سابق بر تو شد، تا در آنها جنگ نیکو کنی"
        },
        {
          "verse": 19,
          "usfm": "1TI.1.19",
          "line_type": "p",
          "text": "و ایمان و وجدان صالح را نگاه داری که بعضی این را از خود دور انداخته، در همان ایمان خود شکسته‌کشتی شدند."
        },
        {
          "verse": 20,
          "usfm": "1TI.1.20",
          "line_type": "p",
          "text": "که از آن جمله هیمِنائوس و اسکندر می‌باشند که ایشان را به شیطان سپردم تا تنبیه شده، دیگر کفر نگویند."
        }
      ],
      "verse_count": 20,
      "headings": [
        {
          "before_verse": 3,
          "text": "هشدار بر علیه معلّمان دروغین"
        },
        {
          "before_verse": 12,
          "text": "مسیح برای نجات گناهکاران آمد"
        }
      ],
