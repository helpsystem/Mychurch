    {
      "schema_version": 6,
      "book_id": "HAG",
      "chapter": 2,
      "chapter_usfm": "HAG.2",
      "version_id": 4205,
      "version_abbr": "RCPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAG.2.1",
          "line_type": "p",
          "text": "در روز بیست و یکم ماه هفتم، کلام خداوند به واسطه حَجَّی نبی نازل شده، گفت:"
        },
        {
          "verse": 2,
          "usfm": "HAG.2.2",
          "line_type": "p",
          "text": "ِ«زِرُبّابِل پسر شِئَلتیئیل والی یهودا و یِهوشَع پسر یِهوصاداق، رئیس کاهنان، و بقیه قوم را خطاب کرده، بگو:"
        },
        {
          "verse": 3,
          "usfm": "HAG.2.3",
          "line_type": "p",
          "text": "کیست در میان شما باقیماندگان که این خانه را در جلال نخستینش دیده باشد؟ پس الان در نظر شما چگونه می‌نماید؟ آیا در نظر شما ناچیز نمی‌نماید؟"
        },
        {
          "verse": 4,
          "usfm": "HAG.2.4",
          "line_type": "p",
          "text": "”اما الان خداوند می‌گوید: ای ِزِرُبّابِل قوی‌دل باش و ‌ای یِهوشَع پسر یِهوصاداق، رئیس کاهنان، قوی‌دل باش و ‌ای تمامی قوم زمین، قوی‌دل باشید و خداوند می‌فرماید که مشغول بشوید زیرا که من با شما هستم. سخن یهوه صِبایوت این است."
        },
        {
          "verse": 5,
          "usfm": "HAG.2.5",
          "line_type": "p",
          "text": "مطابق کلام آن عهدی که در حین بیرون آوردن شما از مصر با شما بستم و چونکه روح من در میان شما برقرار می‌باشد، ترسان مباشید."
        },
        {
          "verse": 6,
          "usfm": "HAG.2.6",
          "line_type": "p",
          "text": "زیرا که یهوه صِبایوت چنین می‌گوید: یک بار دیگر و آن نیز بعد از اندک زمانی، آسمانها و زمین و دریا و خشکی را به لرزه در خواهم آورد."
        },
        {
          "verse": 7,
          "usfm": "HAG.2.7",
          "line_type": "p",
          "text": "و تمامی قومها را پریشان خواهم ساخت و گنجینه تمامی قومها به اینجا خواهند آمد و یهوه صِبایوت می‌گوید که این خانه را از جلال پر خواهم ساخت."
        },
        {
          "verse": 8,
          "usfm": "HAG.2.8",
          "line_type": "p",
          "text": "یهوه صِبایوت می‌گوید: نقره از آنِ من و طلا از آنِ من است."
        },
        {
          "verse": 9,
          "usfm": "HAG.2.9",
          "line_type": "p",
          "text": "یهوه صِبایوت می‌گوید: جلال آخر این خانه از جلال نخستینش بزرگتر خواهد بود و در این مکان، سلامتی را خواهم بخشید. سخن یهوه صِبایوت این است.“»"
        },
        {
          "verse": 10,
          "usfm": "HAG.2.10",
          "line_type": "p",
          "text": "در روز بیست و چهارم ماه نهم از سال دوم داریوش، کلام خداوند توسط حجی نبی نازل شده، گفت:"
        },
        {
          "verse": 11,
          "usfm": "HAG.2.11",
          "line_type": "p",
          "text": "«یهوه صِبایوت چنین می‌گوید: از کاهنان درباره شریعت سؤال کن و بپرس."
        },
        {
          "verse": 12,
          "usfm": "HAG.2.12",
          "line_type": "p",
          "text": "”اگر کسی گوشت مقدس را در دامن جامه خود بردارد و دامنش به نان یا آش یا شراب یا روغن یا به هر قسم خوراک دیگر برخورد، آیا آن خوراک مقدس خواهد شد؟“» کاهنان جواب دادند که «نه.»"
        },
        {
          "verse": 13,
          "usfm": "HAG.2.13",
          "line_type": "p",
          "text": "پس حَجَّی پرسید: «اگر کسی ‌که از میتی نجس شده باشد، یکی از آن خوراکها را لمس نماید، آیا آن نجس خواهد شد؟» و کاهنان در جواب گفتند که «نجس خواهد شد.»"
        },
        {
          "verse": 14,
          "usfm": "HAG.2.14",
          "line_type": "p",
          "text": "آنگاه حَجَّی صحبت نموده، گفت: «خداوند می‌فرماید، این قوم نیز چنین‌اند و این ملت در نظر من چنین می‌باشند و همه کارهای دستهای ایشان چنین است و هر هدیه‌ای که به آنجا می‌برند، نجس می‌باشد."
        },
        {
          "verse": 15,
          "usfm": "HAG.2.15",
          "line_type": "p",
          "text": "و الان دل خود را مشغول سازید: از این ‌روز و قبل از این، پیش از آنکه سنگی بر سنگی در معبد خداوند گذاشته شود،"
        },
        {
          "verse": 16,
          "usfm": "HAG.2.16",
          "line_type": "p",
          "text": "در تمامی این روزها چون کسی به پشته خرمن بیست منی می‌آمد، فقط ده من می‌یافت و چون کسی نزد حوض شراب می‌رفت تا پنجاه پیمانه از آن بکشد، فقط بیست پیمانه بود."
        },
        {
          "verse": 17,
          "usfm": "HAG.2.17",
          "line_type": "p",
          "text": "شما را و تمامی کارهای دستهای شما را به باد سوزان و کپک و تگرگ زدم. لیکن خداوند می‌گوید، اما به سوی من بازگشت ننمودید."
        },
        {
          "verse": 18,
          "usfm": "HAG.2.18",
          "line_type": "p",
          "text": "الان نیک بیندیشید: از این ‌روز به بعد، یعنی از روز بیست و چهارم ماه نهم، از روزی که بنیاد معبد خداوند نهاده شد، از نظر بگذرانید."
        },
        {
          "verse": 19,
          "usfm": "HAG.2.19",
          "line_type": "p",
          "text": "آیا تخم هنوز در انبار است؟ به راستی که مو و انجیر و انار و درخت زیتون هنوز میوه خود را نیاورده‌اند. ولی از این ‌روز شما را برکت خواهم داد.»"
        },
        {
          "verse": 20,
          "usfm": "HAG.2.20",
          "line_type": "p",
          "text": "و کلام خداوند بار دوم در بیست و چهارم ماه بر حَجَّی نازل شده، گفت:"
        },
        {
          "verse": 21,
          "usfm": "HAG.2.21",
          "line_type": "p",
          "text": "ِ«زِرُبّابِل والی یهودا را خطاب کرده، بگو: من آسمانها و زمین را به لرزه درخواهم آورد."
        },
        {
          "verse": 22,
          "usfm": "HAG.2.22",
          "line_type": "p",
          "text": "و تخت ممالک را واژگون خواهم نمود و قوت ممالک قومها را نابود خواهم ساخت و ارابه‌ها و سواران آنها را سرنگون خواهم کرد و اسبها و سواران آنها به شمشیر یکدیگر خواهند افتاد."
        },
        {
          "verse": 23,
          "usfm": "HAG.2.23",
          "line_type": "p",
          "text": "یهوه صِبایوت می گوید: در آن روز، ‌ای خادم من ِزِرُبّابِل، پسر شِئَلتیئیل، تو را خواهم گرفت و خداوند می‌گوید که تو را مثل نگین مُهر خواهم ساخت زیرا که من تو را برگزیده‌ام.» سخن یهوه صِبایوت این است."
        }
      ],
