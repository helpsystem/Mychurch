    {
      "schema_version": 6,
      "book_id": "MAL",
      "chapter": 4,
      "chapter_usfm": "MAL.4",
      "version_id": 116,
      "version_abbr": "NLT",
      "verses": [
        {
          "verse": 1,
          "usfm": "MAL.4.1",
          "line_type": "m",
          "text": "The Lord of Heaven’s Armies says, “The day of judgment is coming, burning like a furnace. On that day the arrogant and the wicked will be burned up like straw. They will be consumed—roots, branches, and all."
        },
        {
          "verse": 2,
          "usfm": "MAL.4.2",
          "line_type": "p",
          "text": "“But for you who fear my name, the Sun of Righteousness will rise with healing in his wings. And you will go free, leaping with joy like calves let out to pasture."
        },
        {
          "verse": 3,
          "usfm": "MAL.4.3",
          "line_type": "p",
          "text": "On the day when I act, you will tread upon the wicked as if they were dust under your feet,” says the Lord of Heaven’s Armies."
        },
        {
          "verse": 4,
          "usfm": "MAL.4.4",
          "line_type": "p",
          "text": "“Remember to obey the Law of Moses, my servant—all the decrees and regulations that I gave him on Mount Sinai for all Israel."
        },
        {
          "verse": 5,
          "usfm": "MAL.4.5",
          "line_type": "p",
          "text": "“Look, I am sending you the prophet Elijah before the great and dreadful day of the Lord arrives."
        },
        {
          "verse": 6,
          "usfm": "MAL.4.6",
          "line_type": "p",
          "text": "His preaching will turn the hearts of fathers to their children, and the hearts of children to their fathers. Otherwise I will come and strike the land with a curse.”"
        }
      ],
      "verse_count": 6,
      "headings": [],
      "footnotes": [
        {
          "verse": 1,
          "usfm": "MAL.4.1",
          "note_ref": "4:1",
          "note_type": "footnote",
          "references": [],
          "text": "Verses 4:1-6 are numbered 3:19-24 in Hebrew text."
        },
        {
          "verse": 2,
          "usfm": "MAL.4.2",
          "note_ref": "4:2",
          "note_type": "footnote",
          "references": [],
          "text": "Or the sun of righteousness will rise with healing in its wings."
        },
        {
          "verse": 4,
          "usfm": "MAL.4.4",
          "note_ref": "4:4",
          "note_type": "footnote",
          "references": [],
          "text": "Hebrew Horeb, another name for Sinai."
        }
      ],
