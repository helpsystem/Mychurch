        },
        {
          "verse": 12,
          "usfm": "JUD.1.12",
          "note_ref": "1:12",
          "note_type": "footnote",
          "references": [],
          "text": "Or they are contaminants among you; or they are stains."
        },
        {
          "verse": 15,
          "usfm": "JUD.1.15",
          "note_ref": "1:14-15",
          "note_type": "footnote",
          "references": [],
          "text": "The quotation comes from intertestamental literature: 1 Enoch 1:9."
        },
        {
          "verse": 20,
          "usfm": "JUD.1.20",
          "note_ref": "1:20",
          "note_type": "footnote",
          "references": [],
          "text": "Greek pray in the Holy Spirit."
        },
        {
          "verse": 22,
          "usfm": "JUD.1.22",
          "note_ref": "1:22",
          "note_type": "footnote",
          "references": [],
          "text": "Some manuscripts read must reprove."
        },
        {
          "verse": 23,
          "usfm": "JUD.1.23",
          "note_ref": "1:22-23a",
          "note_type": "footnote",
          "references": [],
          "text": "Some manuscripts have only two categories of people: (1) those whose faith is wavering and therefore need to be snatched from the flames of judgment, and (2) those who need to be shown mercy."
        },
        {
          "verse": 23,
          "usfm": "JUD.1.23",
          "note_ref": "1:23b",
          "note_type": "footnote",
          "references": [],
          "text": "Greek with fear, hating even the clothing stained by the flesh."
        }
      ],
