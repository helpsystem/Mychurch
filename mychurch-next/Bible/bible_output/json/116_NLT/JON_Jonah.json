    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 2,
      "chapter_usfm": "JON.2",
      "version_id": 116,
      "version_abbr": "NLT",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.2.1",
          "line_type": "m",
          "text": "Then Jonah prayed to the Lord his God from inside the fish."
        },
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "line_type": "m",
          "text": "He said,“I cried out to the Lord in my great trouble,and he answered me.I called to you from the land of the dead,and Lord, you heard me!"
        },
        {
          "verse": 3,
          "usfm": "JON.2.3",
          "line_type": "q1",
          "text": "You threw me into the ocean depths,and I sank down to the heart of the sea.The mighty waters engulfed me;I was buried beneath your wild and stormy waves."
        },
        {
          "verse": 4,
          "usfm": "JON.2.4",
          "line_type": "q1",
          "text": "Then I said, ‘O Lord, you have driven me from your presence.Yet I will look once more toward your holy Temple.’"
        },
        {
          "verse": 5,
          "usfm": "JON.2.5",
          "line_type": "q1",
          "text": "“I sank beneath the waves,and the waters closed over me.Seaweed wrapped itself around my head."
        },
        {
          "verse": 6,
          "usfm": "JON.2.6",
          "line_type": "q1",
          "text": "I sank down to the very roots of the mountains.I was imprisoned in the earth,whose gates lock shut forever.But you, O Lord my God,snatched me from the jaws of death!"
        },
        {
          "verse": 7,
          "usfm": "JON.2.7",
          "line_type": "q1",
          "text": "As my life was slipping away,I remembered the Lord.And my earnest prayer went out to youin your holy Temple."
        },
        {
          "verse": 8,
          "usfm": "JON.2.8",
          "line_type": "q1",
          "text": "Those who worship false godsturn their backs on all God’s mercies."
        },
        {
          "verse": 9,
          "usfm": "JON.2.9",
          "line_type": "q1",
          "text": "But I will offer sacrifices to you with songs of praise,and I will fulfill all my vows.For my salvation comes from the Lord alone.”"
        },
        {
          "verse": 10,
          "usfm": "JON.2.10",
          "line_type": "p",
          "text": "Then the Lord ordered the fish to spit Jonah out onto the beach."
        }
      ],
