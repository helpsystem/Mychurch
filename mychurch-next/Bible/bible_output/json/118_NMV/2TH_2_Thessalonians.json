  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 1,
      "chapter_usfm": "2TH.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.1.1",
          "line_type": "p",
          "text": "از پولس و سیلاس و تیموتائوس،به کلیسای تسالونیکیان که در خدا، پدر ما، و خداوندْ عیسی مسیح‌اند:"
        },
        {
          "verse": 2,
          "usfm": "2TH.1.2",
          "line_type": "p",
          "text": "فیض و سلامتی از سوی خدا، پدر ما، و خداوندْ عیسی مسیح بر شما باد."
        },
        {
          "verse": 3,
          "usfm": "2TH.1.3",
          "line_type": "p",
          "text": "ای برادران، ما باید همواره خدا را به‌خاطر وجود شما شکر گوییم، و سزاوار نیز همین است، زیرا ایمان شما هر چه بیشتر رشد می‌کند و محبت هر یک از شما به یکدیگر فزونی می‌یابد."
        },
        {
          "verse": 4,
          "usfm": "2TH.1.4",
          "line_type": "p",
          "text": "از این رو، ما در کلیساهای خدا به‌خاطر پایداری و ایمان شما در تحمّل آزارها و سختیها، به وجودتان افتخار می‌کنیم."
        },
        {
          "verse": 5,
          "usfm": "2TH.1.5",
          "line_type": "p",
          "text": "اینها همه نشان داوری عادلانۀ خداست، و ثمرش این است که شما شایستۀ پادشاهی خدا شمرده خواهید شد که در راهش رنج می‌برید."
        },
        {
          "verse": 6,
          "usfm": "2TH.1.6",
          "line_type": "p",
          "text": "زیرا این عادلانه است که خدا آنان را که شما را رنج می‌دهند، به رنج عوض دهد،"
        },
        {
          "verse": 7,
          "usfm": "2TH.1.7",
          "line_type": "p",
          "text": "و شما را که رنج می‌برید با ما آرام بخشد. این زمانی واقع خواهد شد که خداوندْ عیسی همراه با فرشتگانِ نیرومند خویش با آتشی فروزان از آسمان ظهور کند."
        },
        {
          "verse": 8,
          "usfm": "2TH.1.8",
          "line_type": "p",
          "text": "او خدانشناسان و نافرمانانِ به انجیل خداوند ما عیسی را کیفر خواهد داد."
        },
        {
          "verse": 9,
          "usfm": "2TH.1.9",
          "line_type": "p",
          "text": "جزای ایشان هلاکت جاودانی از حضور خداوند و از جلالِ قدرت او خواهد بود،"
        },
        {
          "verse": 10,
          "usfm": "2TH.1.10",
          "line_type": "p",
          "text": "در آن روز که او می‌آید تا در مقدسین خود تمجید شود و در میان همۀ آنان که ایمان آورده‌اند، مایۀ شگفتی گردد. این شامل شما نیز خواهد بود، چرا که به شهادت ما ایمان آورده‌اید."
        },
        {
          "verse": 11,
          "usfm": "2TH.1.11",
          "line_type": "p",
          "text": "از همین رو، پیوسته برای شما دعا می‌کنیم تا خدای ما شما را شایستۀ دعوت خود شمارد و به نیروی خود هر قصد نیکو و هر عملی را که از ایمان شما سرچشمه می‌گیرد، به انجام رساند،"
        },
        {
          "verse": 12,
          "usfm": "2TH.1.12",
          "line_type": "p",
          "text": "و تا نام خداوند ما عیسی در شما جلال یابد، و شما نیز در او جلال یابید، بر حسب فیض خدای ما و خداوندْ عیسی مسیح."
        }
      ],
      "verse_count": 12,
      "headings": [
        {
          "before_verse": 3,
          "text": "شکرگزاری و دعا"
        }
      ],
      "footnotes": [
        {
          "verse": 1,
          "usfm": "2TH.1.1",
          "note_ref": "1‏:1",
          "note_type": "footnote",
          "references": [],
          "text": "در اصل یونانی:‏ ”سیلوانُس“، که شکل دیگری از ”سیلاس“ است."
        },
        {
          "verse": 9,
          "usfm": "2TH.1.9",
          "note_ref": "1‏:9",
          "note_type": "footnote",
          "references": [],
          "text": "یا:‏ «هلاکت جاودانی و دوری از حضور خداوند و از جلالِ قدرت او خواهد بود»."
        }
      ],
