      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.3.1",
          "line_type": "p",
          "text": "در خاتمه، ای برادران، برای ما دعا کنید تا کلام خداوند به‌سرعت پیش رود و عزّت یابد، همان‌گونه که در میان شما چنین شد،"
        },
        {
          "verse": 2,
          "usfm": "2TH.3.2",
          "line_type": "p",
          "text": "و تا از افراد خبیث و شَرور رهایی یابیم، زیرا همگان را ایمان نیست."
        },
        {
          "verse": 3,
          "usfm": "2TH.3.3",
          "line_type": "p",
          "text": "امّا خداوند امین است؛ او شما را نیرو می‌بخشد و از آن شریر حفظ می‌کند."
        },
        {
          "verse": 4,
          "usfm": "2TH.3.4",
          "line_type": "p",
          "text": "ما در خداوند به شما اطمینان داریم که آنچه به شما حکم می‌کنیم به جای می‌آورید و خواهید آورد."
        },
        {
          "verse": 5,
          "usfm": "2TH.3.5",
          "line_type": "p",
          "text": "خداوند دلهای شما را به محبت خدا و پایداری مسیح هدایت فرماید."
        },
        {
          "verse": 6,
          "usfm": "2TH.3.6",
          "line_type": "p",
          "text": "ای برادران، به نام خداوندْ عیسی مسیح به شما حکم می‌کنیم که از هر برادری که کاهلی پیشه کرده است و مطابق تعلیمی که از ما گرفته‌اید رفتار نمی‌کند، دوری کنید."
        },
        {
          "verse": 7,
          "usfm": "2TH.3.7",
          "line_type": "p",
          "text": "زیرا خود می‌دانید که چگونه باید از ما سرمشق بگیرید. زمانی که ما با شما بودیم، کاهلی نکردیم"
        },
        {
          "verse": 8,
          "usfm": "2TH.3.8",
          "line_type": "p",
          "text": "و نان کسی را مفت نخوردیم، بلکه شب و روز کار کردیم و زحمت کشیدیم تا سربار هیچ‌یک از شما نباشیم."
        },
        {
          "verse": 9,
          "usfm": "2TH.3.9",
          "line_type": "p",
          "text": "نه اینکه چنین حقّی نداریم، بلکه می‌خواستیم نمونه‌ای به شما بدهیم تا از ما سرمشق بگیرید."
        },
        {
          "verse": 10,
          "usfm": "2TH.3.10",
          "line_type": "p",
          "text": "زیرا حتی زمانی که با شما بودیم این حکم را به شما دادیم که «هر که نمی‌خواهد کار کند، نان هم نخورد.»"
        },
        {
          "verse": 11,
          "usfm": "2TH.3.11",
          "line_type": "p",
          "text": "شنیده‌ایم در میان شما برخی کاهلی پیشه کرده‌اند. اینان کار نمی‌کنند، بلکه در کارهای دیگران فضولی می‌نمایند."
        },
        {
          "verse": 12,
          "usfm": "2TH.3.12",
          "line_type": "p",
          "text": "پس به نام خداوندْ عیسی مسیح چنین‌کسان را حکم می‌کنیم و پند می‌دهیم که آرام و قرار بگیرند و برای تأمین معاش خود به آرامی کار کنند."
        },
        {
          "verse": 13,
          "usfm": "2TH.3.13",
          "line_type": "p",
          "text": "و امّا شما ای برادران، هرگز از انجام کار درست خسته نشوید."
        },
        {
          "verse": 14,
          "usfm": "2TH.3.14",
          "line_type": "p",
          "text": "هر گاه کسی از تعالیم ما در این نامه اطاعت نکند، او را نشان کنید و با وی معاشرت ننمایید تا شرمنده شود."
        },
        {
          "verse": 15,
          "usfm": "2TH.3.15",
          "line_type": "p",
          "text": "ولی او را دشمن مشمارید، بلکه همچون برادر به وی هشدار دهید."
        },
        {
          "verse": 16,
          "usfm": "2TH.3.16",
          "line_type": "p",
          "text": "حال، خداوندِ سلامتی، خود همواره و از هر حیث به شما سلامتی عطا فرماید. خداوند با همگی شما باد."
        },
        {
          "verse": 17,
          "usfm": "2TH.3.17",
          "line_type": "p",
          "text": "من، پولس، به خط خود این سلام را می‌نویسم. این نشان ویژۀ همۀ نامه‌های من است. من چنین می‌نویسم."
        },
        {
          "verse": 18,
          "usfm": "2TH.3.18",
          "line_type": "p",
          "text": "فیض خداوند ما عیسی مسیح با همگی شما باد. آمین."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 6,
          "text": "هشدار به کاهلان"
        },
        {
          "before_verse": 16,
