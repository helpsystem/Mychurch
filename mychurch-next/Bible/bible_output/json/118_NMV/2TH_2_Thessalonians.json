    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 2,
      "chapter_usfm": "2TH.2",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.2.1",
          "line_type": "p",
          "text": "ای برادران، دربارۀ آمدن خداوند ما عیسی مسیح و گِرد آمدن ما نزد او، استدعا داریم"
        },
        {
          "verse": 2,
          "usfm": "2TH.2.2",
          "line_type": "p",
          "text": "از پیام نبوّتی یا گفته یا نامه‌ای که گویا از ما باشد، بدین مضمون که روز خداوند هم‌اکنون فرا رسیده است، زود متزلزل یا مشوّش مشوید."
        },
        {
          "verse": 3,
          "usfm": "2TH.2.3",
          "line_type": "p",
          "text": "مگذارید هیچ‌کس به هیچ طریقی شما را فریب دهد. زیرا تا نخست آن عِصیان واقع نشود و آن مرد بی‌دین که فرزند هلاکت است به ظهور نرسد، آن روز فرا نخواهد رسید."
        },
        {
          "verse": 4,
          "usfm": "2TH.2.4",
          "line_type": "p",
          "text": "او با هرآنچه خدا خوانده می‌شود و مورد پرستش قرار می‌گیرد، مخالفت می‌ورزد و خود را بالاتر قرار می‌دهد، تا آنجا که در معبد خدا جلوس می‌کند و خود را خدا معرفی می‌نماید."
        },
        {
          "verse": 5,
          "usfm": "2TH.2.5",
          "line_type": "p",
          "text": "آیا به یاد ندارید هنگامی که با شما بودم اینها را به شما می‌گفتم؟"
        },
        {
          "verse": 6,
          "usfm": "2TH.2.6",
          "line_type": "p",
          "text": "شما می‌دانید که اکنون چه چیزی مانع است و سبب می‌شود که او تنها در زمان مناسب خود ظهور کند."
        },
        {
          "verse": 7,
          "usfm": "2TH.2.7",
          "line_type": "p",
          "text": "زیرا سِرّ بی‌دینی هم‌اکنون نیز عمل می‌کند، امّا فقط تا وقتی که آن که تا به حال مانع است از میان برداشته شود."
        },
        {
          "verse": 8,
          "usfm": "2TH.2.8",
          "line_type": "p",
          "text": "آنگاه آن بی‌دین ظاهر خواهد شد، که خداوندْ عیسی با نَفَس دهان خود او را هلاک خواهد کرد و با درخشندگیِ ظهور خویش او را نابود خواهد ساخت."
        },
        {
          "verse": 9,
          "usfm": "2TH.2.9",
          "line_type": "p",
          "text": "ظهور آن بی‌دین به نیروی شیطان و همراه با همه گونه معجزات و آیات و عجایبِ گمراه‌کننده خواهد بود،"
        },
        {
          "verse": 10,
          "usfm": "2TH.2.10",
          "line_type": "p",
          "text": "و نیز همراه با همه گونه شرارت که راهیان طریق هلاکت را فریفته می‌سازد. ایشان از آن رو هلاک می‌شوند که نخواستند حقیقت را دوست بدارند تا نجات یابند."
        },
        {
          "verse": 11,
          "usfm": "2TH.2.11",
          "line_type": "p",
          "text": "پس خدا ایشان را به توهّمی بزرگ دچار خواهد کرد، به گونه‌ای که دروغ را باور خواهند داشت،"
        },
        {
          "verse": 12,
          "usfm": "2TH.2.12",
          "line_type": "p",
          "text": "تا همۀ کسانی که حقیقت را باور نکرده و از شرارت خشنود گشته‌اند، محکوم شوند."
        },
        {
          "verse": 13,
          "usfm": "2TH.2.13",
          "line_type": "p",
          "text": "امّا ای برادران که محبوب خدایید، ما باید همواره خدا را به‌خاطر وجود شما شکر گوییم، زیرا خدا شما را از آغاز برگزید تا به واسطۀ عمل تقدیس‌کنندۀ روح و ایمان به حقیقت نجات یابید."
        },
        {
          "verse": 14,
          "usfm": "2TH.2.14",
          "line_type": "p",
          "text": "او شما را به واسطۀ انجیل ما فرا خواند تا از جلال خداوند ما عیسی مسیح برخوردار شوید."
        },
        {
          "verse": 15,
          "usfm": "2TH.2.15",
          "line_type": "p",
          "text": "پس، ای برادران، استوار باشید و سنّتهایی را که چه با سخنِ زبان و چه با نامه به شما سپردیم، نگاه دارید."
        },
        {
          "verse": 16,
          "usfm": "2TH.2.16",
          "line_type": "p",
          "text": "خودِ خداوند ما عیسی مسیح و پدر ما خدا که ما را محبت کرد و به فیض خود به ما دلگرمی جاودانی و امیدی نیکو بخشید،"
        },
        {
          "verse": 17,
          "usfm": "2TH.2.17",
          "line_type": "p",
          "text": "شما را دلگرمی بخشد و در هر کردار و گفتار نیکو استوار گرداند."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 13,
          "text": "استوار بمانید"
        }
      ],
      "footnotes": [
        {
          "verse": 3,
          "usfm": "2TH.2.3",
          "note_ref": "2‏:3",
          "note_type": "footnote",
          "references": [],
          "text": "منظور از ”فرزند هلاکت“، ”محکوم به هلاکت“، و یا به احتمال کمتر، ”عامل هلاکت“ است."
        },
        {
          "verse": 13,
          "usfm": "2TH.2.13",
          "note_ref": "2‏:13",
          "note_type": "footnote",
          "references": [],
          "text": "یا:‏ «خدا شما را چون نوبر برگزید»."
        },
        {
          "verse": 15,
          "usfm": "2TH.2.15",
          "note_ref": "2‏:15",
          "note_type": "footnote",
          "references": [],
          "text": "یا ”تعالیمی“."
        }
      ],
