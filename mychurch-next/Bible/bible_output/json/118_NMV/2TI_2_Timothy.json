    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 3,
      "chapter_usfm": "2TI.3",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.3.1",
          "line_type": "p",
          "text": "امّا آگاه باش که در روزهای آخر، زمانهای سخت پیش خواهد آمد."
        },
        {
          "verse": 2,
          "usfm": "2TI.3.2",
          "line_type": "p",
          "text": "مردمانْ خودپرست، پولدوست، لاف‌زن، متکبر، ناسزاگو، نافرمان به والدین، ناسپاس، ناپاک،"
        },
        {
          "verse": 3,
          "usfm": "2TI.3.3",
          "line_type": "p",
          "text": "بی‌عاطفه، بی‌گذشت، غیبت‌گو، بی‌بندوبار، وحشی، دشمن نیکویی،"
        },
        {
          "verse": 4,
          "usfm": "2TI.3.4",
          "line_type": "p",
          "text": "خیانتکار، بی‌مبالات و خودپسند خواهند بود. لذت را بیش از خدا دوست خواهند داشت"
        },
        {
          "verse": 5,
          "usfm": "2TI.3.5",
          "line_type": "p",
          "text": "و هرچند صورتِ ظاهرِ دینداری را دارند، منکر قدرت آن خواهند بود. از چنین کسان دوری گزین."
        },
        {
          "verse": 6,
          "usfm": "2TI.3.6",
          "line_type": "p",
          "text": "اینان کسانی هستند که به درون خانۀ مردم رخنه کرده، زنان سبک‌مغز را اسیر خود می‌سازند، زنانی را که زیر بار گناهان خم شده‌اند و هوسهای گوناگونْ آنان را به هر سو می‌کشد،"
        },
        {
          "verse": 7,
          "usfm": "2TI.3.7",
          "line_type": "p",
          "text": "و با اینکه همواره تعلیم می‌گیرند، هرگز به شناخت حقیقت نتوانند رسید."
        },
        {
          "verse": 8,
          "usfm": "2TI.3.8",
          "line_type": "p",
          "text": "همان‌گونه که یَنّیس و یَمْبْریس به مخالفت با موسی برخاستند، این مردان نیز که فکری فاسد و ایمانی مردود دارند، با حقیقت مخالفت می‌کنند."
        },
        {
          "verse": 9,
          "usfm": "2TI.3.9",
          "line_type": "p",
          "text": "امّا راه به جایی نخواهند برد، بلکه حماقتشان بر همگان آشکار خواهد شد، چنانکه حماقت آن دو نیز عیان گردید."
        },
        {
          "verse": 10,
          "usfm": "2TI.3.10",
          "line_type": "p",
          "text": "ولی تو تعلیم و رفتار و هدف و ایمان و صبر و محبت و تحمّل مرا"
        },
        {
          "verse": 11,
          "usfm": "2TI.3.11",
          "line_type": "p",
          "text": "و آزارهایی را که دیدم و رنجهایی را که کشیدم، نظاره‌گر بوده‌ای و از آنچه در اَنطاکیه، قونیه و لِستْره بر سرم آمد و آزارهایی که به من رسید، نیک آگاهی. امّا خداوند مرا از آن همه رهانید."
        },
        {
          "verse": 12,
          "usfm": "2TI.3.12",
          "line_type": "p",
          "text": "براستی، همۀ کسانی که بخواهند در مسیحْ عیسی با دینداری زیست کنند، آزار خواهند دید؛"
        },
        {
          "verse": 13,
          "usfm": "2TI.3.13",
          "line_type": "p",
          "text": "امّا شرارت‌پیشگان و شیّادان در بدی پیش خواهند رفت؛ فریب خواهند داد و فریب خواهند خورد."
        },
        {
          "verse": 14,
          "usfm": "2TI.3.14",
          "line_type": "p",
          "text": "امّا تو در آنچه آموخته و بدان ایمان آورده‌ای پایدار باش، چرا که می‌دانی آنها را از چه کسان فرا گرفته‌ای،"
        },
        {
          "verse": 15,
          "usfm": "2TI.3.15",
          "line_type": "p",
          "text": "و چگونه از کودکی کتب مقدّس را دانسته‌ای که می‌تواند تو را حکمت آموزد برای نجاتی که از راه ایمان به مسیحْ عیسی است."
        },
        {
          "verse": 16,
          "usfm": "2TI.3.16",
          "line_type": "p",
          "text": "تمامی کتبِ مقدّس الهام خداست و برای تعلیم و تأدیب و اصلاح و تربیت در پارسایی سودمند است،"
        },
        {
          "verse": 17,
          "usfm": "2TI.3.17",
          "line_type": "p",
          "text": "تا مرد خدا به کمال برای هر کارِ نیکو تجهیز گردد."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 10,
          "text": "اندرز پولس به تیموتائوس"
        }
      ],
