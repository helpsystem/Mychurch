    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 4,
      "chapter_usfm": "2TI.4",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.4.1",
          "line_type": "p",
          "text": "در برابر خدا و مسیحْ عیسی که بر زندگان و مردگان داوری خواهد کرد، و نظر به ظهور او و پادشاهی‌اش، تو را مکلّف می‌سازم که"
        },
        {
          "verse": 2,
          "usfm": "2TI.4.2",
          "line_type": "p",
          "text": "کلام را موعظه کنی و به گاه و به بیگاه آمادۀ این کار باشی و با صبر بسیار و تعلیم دقیق، به اصلاح و توبیخ و تشویق بپردازی."
        },
        {
          "verse": 3,
          "usfm": "2TI.4.3",
          "line_type": "p",
          "text": "زیرا زمانی خواهد آمد که مردم به تعلیم صحیح گوش فرا نخواهند داد، بلکه بنا به میل خویش، معلّمان بسیار گِرد خود خواهند آورد تا آنچه را که گوشهایشان طالب شنیدن آن است، از آنان بشنوند؛"
        },
        {
          "verse": 4,
          "usfm": "2TI.4.4",
          "line_type": "p",
          "text": "و از گوش فرا دادن به حقیقت رویگردان شده، به سوی افسانه‌ها منحرف خواهند گشت."
        },
        {
          "verse": 5,
          "usfm": "2TI.4.5",
          "line_type": "p",
          "text": "امّا تو در همه حال به‌هوش باش؛ سختیها را بر خود هموار کن؛ کار مبشّر را انجام ده و خدمت خویش را به کمال به انجام رسان."
        },
        {
          "verse": 6,
          "usfm": "2TI.4.6",
          "line_type": "p",
          "text": "زیرا من، هم‌اکنون، همچون هدیه‌ای ریختنی، در حال ریخته شدنم و زمان رحلتم فرا رسیده است."
        },
        {
          "verse": 7,
          "usfm": "2TI.4.7",
          "line_type": "p",
          "text": "جنگِ نیکو را جنگیده‌ام، مسابقه را به پایان رسانده و ایمان را محفوظ داشته‌ام."
        },
        {
          "verse": 8,
          "usfm": "2TI.4.8",
          "line_type": "p",
          "text": "اکنون تاج پارسایی برایم آماده است، تاجی که خداوند، آن داور عادل، در آن روز به من عطا خواهد کرد - نه تنها به من، بلکه به همۀ آنان که مشتاق ظهور او بوده‌اند."
        },
        {
          "verse": 9,
          "usfm": "2TI.4.9",
          "line_type": "p",
          "text": "بکوش تا هر چه زودتر نزد من آیی."
        },
        {
          "verse": 10,
          "usfm": "2TI.4.10",
          "line_type": "p",
          "text": "زیرا دیماس به‌خاطر عشق این دنیا مرا ترک کرده و به تَسالونیکی رفته است. کْریسکیس به غَلاطیه و تیتوس هم به دَلماتیه رفته."
        },
        {
          "verse": 11,
          "usfm": "2TI.4.11",
          "line_type": "p",
          "text": "تنها لوقا با من است. مَرقُس را برگیر و با خود بیاور، زیرا در خدمتم مرا سودمند است."
        },
        {
          "verse": 12,
          "usfm": "2TI.4.12",
          "line_type": "p",
          "text": "تیخیکوس را به اَفِسُس فرستادم."
        },
        {
          "verse": 13,
          "usfm": "2TI.4.13",
          "line_type": "p",
          "text": "هنگام آمدنت، قبایی را که در تْروآس نزد کارپوس بر جا گذاشتم با خود بیاور، و نیز طومارهایم را و بخصوص نوشته‌های پوستین را."
        },
        {
          "verse": 14,
          "usfm": "2TI.4.14",
          "line_type": "p",
          "text": "اسکندر مِسگر، با من بسیار بدیها کرد. خداوند سزای کارهایش را خواهد داد."
        },
        {
          "verse": 15,
          "usfm": "2TI.4.15",
          "line_type": "p",
          "text": "تو نیز از او برحذر باش، زیرا با پیام ما سخت به مخالفت برخاسته است."
        },
        {
          "verse": 16,
          "usfm": "2TI.4.16",
          "line_type": "p",
          "text": "در نخستین دفاع من، هیچ‌کس به پشتیبانی از من بر‌نخاست، بلکه همه مرا وانهادند. مباد که این به حسابشان گذاشته شود."
        },
        {
          "verse": 17,
          "usfm": "2TI.4.17",
          "line_type": "p",
          "text": "امّا خداوند در کنار من ایستاد و مرا نیرو بخشید تا کلام به واسطۀ من به کمال موعظه شود و همۀ غیریهودیان آن را بشنوند. پس، از دهان شیر رستم."
        },
        {
          "verse": 18,
          "usfm": "2TI.4.18",
          "line_type": "p",
          "text": "خداوند مرا از هر عمل شریرانه خواهد رهانید و برای پادشاهی آسمانی خود نجات خواهد بخشید. جلال بر او باد تا ابدالآباد. آمین!"
        },
        {
          "verse": 19,
          "usfm": "2TI.4.19",
          "line_type": "p",
          "text": "سلام مرا به پْریسکیلا و آکیلا و خانوادۀ اونیسیفوروس برسان."
        },
        {
          "verse": 20,
          "usfm": "2TI.4.20",
          "line_type": "p",
          "text": "اِراستوس در قُرِنتُس ماند، و من تْروفیموس را در میلیتوس، بیمار، بر جا گذاشتم."
        },
        {
          "verse": 21,
          "usfm": "2TI.4.21",
          "line_type": "p",
          "text": "بکوش تا پیش از زمستان به اینجا برسی. یوبولوس برای تو سلام می‌فرستد، و نیز پودِنْس، لینوس، کْلودیا و همۀ برادران."
        },
        {
          "verse": 22,
          "usfm": "2TI.4.22",
          "line_type": "p",
          "text": "خداوند با روح تو باشد. فیض با شما باد."
        }
      ],
      "verse_count": 22,
      "headings": [
        {
          "before_verse": 9,
          "text": "سفارشهای شخصی"
        },
        {
          "before_verse": 19,
          "text": "درودهای نهایی"
        }
      ],
