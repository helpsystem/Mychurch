  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 1,
      "chapter_usfm": "2TI.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.1.1",
          "line_type": "p",
          "text": "از پولس، که به خواست خدا و به‌خاطر وعدۀ حیاتی که در مسیحْ عیسی یافت می‌شود، رسول مسیحْ عیساست،"
        },
        {
          "verse": 2,
          "usfm": "2TI.1.2",
          "line_type": "p",
          "text": "به فرزند عزیزم، تیموتائوس:فیض و رحمت و سلامتی از جانب خدای پدر و خداوند ما مسیحْ عیسی بر تو باد."
        },
        {
          "verse": 3,
          "usfm": "2TI.1.3",
          "line_type": "p",
          "text": "وقتی تو را شب و روز، پیوسته در دعاهایم یاد می‌دارم، خدا را سپاس می‌گزارم، خدایی را که من نیز چون پدرانم با وجدانی پاک خدمتش می‌کنم."
        },
        {
          "verse": 4,
          "usfm": "2TI.1.4",
          "line_type": "p",
          "text": "چون اشکهای تو را به خاطر می‌آورم، آرزو می‌کنم با تو دیدارْ تازه کنم تا از شادی لبریز شوم."
        },
        {
          "verse": 5,
          "usfm": "2TI.1.5",
          "line_type": "p",
          "text": "ایمان بی‌ریای تو را به یاد می‌آورم که نخست در مادربزرگت لوئیس و سپس در مادرت یونیکی ساکن بود، و یقین دارم اکنون نیز در تو ساکن است."
        },
        {
          "verse": 6,
          "usfm": "2TI.1.6",
          "line_type": "p",
          "text": "از این رو، تو را یادآور می‌شوم که آن عطای خدا را که به واسطۀ دست گذاشتنِ من، در تو جای گرفته، شعله‌ور سازی."
        },
        {
          "verse": 7,
          "usfm": "2TI.1.7",
          "line_type": "p",
          "text": "زیرا روحی که خدا به ما بخشیده، نه روح ترس، بلکه روح قوّت و محبت و انضباط است."
        },
        {
          "verse": 8,
          "usfm": "2TI.1.8",
          "line_type": "p",
          "text": "پس، از شهادت بر خداوند ما عار مدار، و نه از من که به‌خاطر او در بندم، بلکه تو نیز با اتکا به نیروی الهی در رنج کشیدن برای انجیل سهیم باش."
        },
        {
          "verse": 9,
          "usfm": "2TI.1.9",
          "line_type": "p",
          "text": "خدا ما را نجات داده و به زندگی مقدّس فرا خوانده است. این نه به سبب اعمال ما، بلکه به‌خاطر قصد و فیض خودِ اوست، فیضی که در مسیحْ عیسی از ایام ازل به ما عطا شده بود،"
        },
        {
          "verse": 10,
          "usfm": "2TI.1.10",
          "line_type": "p",
          "text": "ولی اکنون با ظهور نجات‌دهندۀ ما مسیحْ عیسی عیان گشته است - همان که به واسطۀ انجیل، مرگ را باطل کرد و حیات و فناناپذیری را آشکار ساخت."
        },
        {
          "verse": 11,
          "usfm": "2TI.1.11",
          "line_type": "p",
          "text": "و من برگماشته شده‌ام تا واعظ، رسول و معلّم این انجیل باشم."
        },
        {
          "verse": 12,
          "usfm": "2TI.1.12",
          "line_type": "p",
          "text": "از همین روست که این‌گونه رنج می‌کشم، امّا عار ندارم، چرا که می‌دانم به که ایمان آورده‌ام و یقین دارم که او قادر است امانتم را تا بدان روز حفظ کند."
        },
        {
          "verse": 13,
          "usfm": "2TI.1.13",
          "line_type": "p",
          "text": "با ایمان و محبتی که در مسیحْ عیسی یافت می‌شود، به آنچه از من شنیده‌ای چون الگوی تعلیم صحیح سخت بچسب."
        },
        {
          "verse": 14,
          "usfm": "2TI.1.14",
          "line_type": "p",
          "text": "به یاری روح‌القدس که در ما ساکن است، آن امانت نیکو را که به تو سپرده شده، پاس دار."
        },
        {
          "verse": 15,
          "usfm": "2TI.1.15",
          "line_type": "p",
          "text": "آگاهی که ساکنان ایالت آسیا، همه مرا ترک کرده‌اند، از آن جمله، فیگِلوس و هِرموگِنِس."
        },
        {
          "verse": 16,
          "usfm": "2TI.1.16",
          "line_type": "p",
          "text": "رحمت خداوند بر خانوادۀ اونیسیفوروس باد، چه او بارها جان مرا تازه کرد و از زنجیرهایم عار نداشت."
        },
        {
          "verse": 17,
          "usfm": "2TI.1.17",
          "line_type": "p",
          "text": "بلکه چون به روم آمد، بسیار مرا جُست تا سرانجام یافت."
        },
        {
          "verse": 18,
          "usfm": "2TI.1.18",
          "line_type": "p",
          "text": "رحمت خداوند در آن روزِ خاص شامل حال او شود. تو خود از خدمات بسیار او در اَفِسُس، نیک آگاهی."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 3,
          "text": "ترغیب به وفاداری"
        }
      ],
      "footnotes": [
        {
          "verse": 7,
          "usfm": "2TI.1.7",
          "note_ref": "1‏:7",
          "note_type": "footnote",
          "references": [],
          "text": "یا ”خویشتنداری“."
        },
        {
          "verse": 10,
