    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 2,
      "chapter_usfm": "2TI.2",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.2.1",
          "line_type": "p",
          "text": "پس تو ای فرزندم، در فیضی که در مسیحْ عیسی است نیرومند شو،"
        },
        {
          "verse": 2,
          "usfm": "2TI.2.2",
          "line_type": "p",
          "text": "و آنچه را که در حضور گواهان بسیار از من شنیدی، به مردمان امینی بسپار که از عهدۀ آموزش دیگران نیز برآیند."
        },
        {
          "verse": 3,
          "usfm": "2TI.2.3",
          "line_type": "p",
          "text": "همچون سربازِ شایستۀ مسیحْ عیسی، در تحمّل رنجها سهیم باش."
        },
        {
          "verse": 4,
          "usfm": "2TI.2.4",
          "line_type": "p",
          "text": "هیچ‌کس به هنگام سربازی، خود را گرفتار مشغولیتهای زندگی نمی‌سازد، چرا که خواهان جلب خشنودی فرماندۀ خویش است."
        },
        {
          "verse": 5,
          "usfm": "2TI.2.5",
          "line_type": "p",
          "text": "به همین‌سان، ورزشکاری که هماوردی می‌کند، تاج پیروزی را دریافت نخواهد کرد، اگر به قانونْ هماوردی نکرده باشد."
        },
        {
          "verse": 6,
          "usfm": "2TI.2.6",
          "line_type": "p",
          "text": "آن که باید نخست از محصول نصیب ببرد، کشاورزی است که محنت کشیده است."
        },
        {
          "verse": 7,
          "usfm": "2TI.2.7",
          "line_type": "p",
          "text": "به آنچه می‌گویم بیندیش، که خداوند تو را در فهم همۀ اینها بصیرت خواهد بخشید."
        },
        {
          "verse": 8,
          "usfm": "2TI.2.8",
          "line_type": "p",
          "text": "عیسی مسیح را به خاطر دار که از نسل داوود بود و از مردگان برخاست؛ این است انجیل من،"
        },
        {
          "verse": 9,
          "usfm": "2TI.2.9",
          "line_type": "p",
          "text": "که به‌خاطرش در رنجم، تا بدان حد که چون مجرمان به زنجیرم کشیده‌اند. امّا کلام خدا در زنجیر نیست."
        },
        {
          "verse": 10,
          "usfm": "2TI.2.10",
          "line_type": "p",
          "text": "پس همه چیز را به‌خاطر برگزیدگان تحمل می‌کنم تا آنان نیز نجاتی را که در مسیحْ عیساست، با جلال جاودانی به دست آورند."
        },
        {
          "verse": 11,
          "usfm": "2TI.2.11",
          "line_type": "p",
          "text": "این سخن درخور اعتماد است که:اگر با او مردیم،با او زندگی هم خواهیم کرد."
        },
        {
          "verse": 12,
          "usfm": "2TI.2.12",
          "line_type": "q1",
          "text": "اگر تحمّل کنیم،با او سلطنت هم خواهیم کرد.اگر انکارش کنیم،او نیز انکارمان خواهد کرد."
        },
        {
          "verse": 13,
          "usfm": "2TI.2.13",
          "line_type": "q1",
          "text": "اگر بی‌وفا شویم،او وفادار خواهد ماند،از آن رو که خویشتن را انکار نتواند کرد."
        },
        {
          "verse": 14,
          "usfm": "2TI.2.14",
          "line_type": "p",
          "text": "اینها را پیوسته بدیشان یادآور شو و در حضور خدا هشدار ده که بر سر کلمات مجادله نکنند، که جز تباهیِ شنوندگان ثمری ندارد."
        },
        {
          "verse": 15,
          "usfm": "2TI.2.15",
          "line_type": "p",
          "text": "سخت بکوش که مقبول خدا باشی، همچون خدمتکاری که او را سببی برای شرمساری نیست و کلام حقیقت را به‌درستی به کار می‌بندد."
        },
        {
          "verse": 16,
          "usfm": "2TI.2.16",
          "line_type": "p",
          "text": "از یاوه‌گویی‌های دنیوی بپرهیز، که شخص را هر چه بیشتر به بی‌دینی سوق می‌دهد."
        },
        {
          "verse": 17,
          "usfm": "2TI.2.17",
          "line_type": "p",
          "text": "تعلیم چنین کسان مانند بیماری قانقاریا پخش می‌شود. هیمِنائوس و فیلِتوس از همین دسته‌اند،"
        },
        {
          "verse": 18,
          "usfm": "2TI.2.18",
          "line_type": "p",
          "text": "که از حقیقت منحرف گشته‌اند و می‌گویند رستاخیز هم‌اکنون به وقوع پیوسته است، و بدین‌سان ایمان بعضی را ویران می‌کنند."
        },
        {
          "verse": 19,
          "usfm": "2TI.2.19",
          "line_type": "p",
          "text": "با این حال، پی مستحکمی که خدا نهاده است، پابرجاست و با این عبارت مُهر شده است که: «خداوند کسان خود را می‌شناسد،» و «هر که به نام خداوند اقرار دارد، باید از شرارت کناره جوید.»"
        },
        {
          "verse": 20,
          "usfm": "2TI.2.20",
          "line_type": "p",
          "text": "در خانه‌ای بزرگ، تنها ظروف طلا و نقره نیست، بلکه چوبی و گِلی هم هست؛ آنها به کار مصارف مهم می‌آیند، اینها به کار مصارف پیش پا افتاده."
        },
        {
          "verse": 21,
          "usfm": "2TI.2.21",
          "line_type": "p",
          "text": "پس هر که خود را از آنچه گفتم پاک نگاه دارد، ظرفی خواهد بود که به کار مصارف مهم می‌آید، ظرفی مقدّس و مفید برای صاحبخانه و مهیا برای هر کار نیکو."
        },
        {
          "verse": 22,
          "usfm": "2TI.2.22",
          "line_type": "p",
          "text": "از امیال جوانی بگریز، و به همراه آنان که با دلی پاک خداوند را می‌خوانند، در پی پارسایی و ایمان و محبت و صلح باش."
        },
        {
          "verse": 23,
          "usfm": "2TI.2.23",
          "line_type": "p",
          "text": "از مباحثات پوچ و بی‌خردانه دوری کن، چرا که می‌دانی نزاعها برمی‌انگیزد."
        },
        {
          "verse": 24,
          "usfm": "2TI.2.24",
          "line_type": "p",
          "text": "حال آنکه خادم خداوند نباید نزاع کند، بلکه باید با همه مهربان باشد و قادر به تعلیم و بردبار."
        },
        {
          "verse": 25,
          "usfm": "2TI.2.25",
          "line_type": "p",
          "text": "باید مخالفان را به‌نرمی ارشاد کند، بدین امید که خدا به آنها توبه عطا فرماید تا به شناخت حقیقت برسند"
        },
        {
          "verse": 26,
          "usfm": "2TI.2.26",
          "line_type": "p",
          "text": "و به خود آمده، از دام ابلیس که ایشان را برای انجام خواست خود اسیر کرده است، برهند."
        }
      ],
      "verse_count": 26,
      "headings": [
        {
          "before_verse": 14,
          "text": "خادم مقبول خدا"
        }
      ],
      "footnotes": [
        {
          "verse": 19,
          "usfm": "2TI.2.19",
          "note_ref": "",
