    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 2,
      "chapter_usfm": "1TH.2",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.2.1",
          "line_type": "p",
          "text": "ای برادران، خود می‌دانید که آمدن ما نزد شما بیهوده نبوده است،"
        },
        {
          "verse": 2,
          "usfm": "1TH.2.2",
          "line_type": "p",
          "text": "بلکه هرچند پیشتر در شهر فیلیپی آزار و اهانت بر ما رفت، چنانکه می‌دانید، امّا به مدد خدای خود دلیری کردیم تا انجیل خدا را با وجود مخالفتهای بسیار به شما برسانیم."
        },
        {
          "verse": 3,
          "usfm": "1TH.2.3",
          "line_type": "p",
          "text": "زیرا اگر ترغیبتان می‌کنیم، از گمراهی یا انگیزه‌های ناپاک نیست، و قصد فریبتان را نیز نداریم،"
        },
        {
          "verse": 4,
          "usfm": "1TH.2.4",
          "line_type": "p",
          "text": "بلکه چون کسانی سخن می‌گوییم که خدا بر آنها مُهر تأیید زده و انجیل را بدیشان به امانت سپرده است. ما در پی خشنود ساختن مردم نیستیم، بلکه خشنودی خدایی را طالبیم که دلهای ما را می‌آزماید."
        },
        {
          "verse": 5,
          "usfm": "1TH.2.5",
          "line_type": "p",
          "text": "شما نیک می‌دانید که ما هرگز به چاپلوسی متوسّل نشدیم، و از ظاهرسازی چون سرپوشی برای طمع سود نجستیم - خدا گواه ماست."
        },
        {
          "verse": 6,
          "usfm": "1TH.2.6",
          "line_type": "p",
          "text": "و نیز جویای ستایش از انسانها نبوده‌ایم، چه از شما و چه از دیگران.هرچند در مقام رسولان مسیح حقی بر گردن شما داشتیم،"
        },
        {
          "verse": 7,
          "usfm": "1TH.2.7",
          "line_type": "p",
          "text": "امّا همچون مادری شیرده که از کودکان خود نگهداری می‌کند، با شما به نرمی رفتار کردیم."
        },
        {
          "verse": 8,
          "usfm": "1TH.2.8",
          "line_type": "p",
          "text": "شدت علاقۀ ما به شما چنان بود که شادمانه حاضر بودیم نه تنها انجیل خدا را به شما برسانیم، بلکه از جان خود نیز در راه شما بگذریم، چندان که ما را عزیز گشته بودید."
        },
        {
          "verse": 9,
          "usfm": "1TH.2.9",
          "line_type": "p",
          "text": "شما ای برادران، به‌یقین محنت و مشقّت ما را به یاد دارید، که شب و روز کار می‌کردیم تا وقتی انجیلِ خدا را به شما وعظ می‌کنیم، سربار کسی نباشیم."
        },
        {
          "verse": 10,
          "usfm": "1TH.2.10",
          "line_type": "p",
          "text": "شما شاهدید و خدا خود نیز گواه است که با چه پاکی و درستی و بی‌عیبی با شما ایمانداران رفتار کردیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.2.11",
          "line_type": "p",
          "text": "چنانکه می‌دانید، رفتار ما با یک یک شما چون رفتار پدری با فرزندانش بود."
        },
        {
          "verse": 12,
          "usfm": "1TH.2.12",
          "line_type": "p",
          "text": "شما را تشویق کرده، دلداری می‌دادیم و سفارش می‌کردیم که شیوۀ رفتارتان شایستۀ خدایی باشد که شما را به پادشاهی و جلال خود فرا می‌خواند."
        },
        {
          "verse": 13,
          "usfm": "1TH.2.13",
          "line_type": "p",
          "text": "نیز ما خدا را پیوسته شکر می‌گوییم که شما به هنگام پذیرفتن کلام خدا، که از ما شنیدید، آن را نه چون سخنان انسان، بلکه چون کلام خدا پذیرفتید، چنانکه براستی نیز چنین است؛ همان کلام اکنون در میان شما که ایمان دارید، عمل می‌کند."
        },
        {
          "verse": 14,
          "usfm": "1TH.2.14",
          "line_type": "p",
          "text": "زیرا ای برادران، شما از کلیساهای خدا در یهودیه که در مسیحْ عیسایند، سرمشق گرفتید: شما نیز از هموطنان خود، همان آزارها را دیدید که آنان از یهودیان دیدند،"
        },
        {
          "verse": 15,
          "usfm": "1TH.2.15",
          "line_type": "p",
          "text": "از آنان که عیسای خداوند و پیامبران را کشتند و ما را نیز بیرون راندند. آنان خدا را خشنود نمی‌سازند و با همۀ مردم دشمنی می‌ورزند،"
        },
        {
          "verse": 16,
          "usfm": "1TH.2.16",
          "line_type": "p",
          "text": "و نمی‌گذارند ما با غیریهودیان سخن بگوییم تا نجات یابند. بدین‌گونه همواره پیمانۀ گناهان خود را لبریز می‌کنند. امّا غضب خدا سرانجام بر ایشان فرو ریخته است."
        },
        {
          "verse": 17,
          "usfm": "1TH.2.17",
          "line_type": "p",
          "text": "و امّا ای برادران، چون کوتاه زمانی از شما به دور افتادیم، البته جسماً و نه قلباً، با اشتیاقی بس پرشورتر کوشیدیم تا روی شما را ببینیم."
        },
        {
          "verse": 18,
          "usfm": "1TH.2.18",
          "line_type": "p",
          "text": "چرا که خواهان آمدن نزد شما بودیم - براستی که من، پولس، بارها سعی کردم - ولی شیطان مانع شد."
        },
        {
          "verse": 19,
          "usfm": "1TH.2.19",
          "line_type": "p",
          "text": "زیرا چیست امید و شادی و تاج افتخار ما در حضور خداوندمان عیسی به هنگام ظهور او؟ مگر شما نیستید؟"
        },
        {
          "verse": 20,
          "usfm": "1TH.2.20",
          "line_type": "p",
          "text": "براستی که شمایید جلال و شادی ما."
        }
      ],
      "verse_count": 20,
      "headings": [
        {
          "before_verse": 17,
          "text": "اشتیاق پولس برای دیدار با ایمانداران تَسالونیکی"
        }
      ],
      "footnotes": [
