    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 3,
      "chapter_usfm": "1TH.3",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.3.1",
          "line_type": "p",
          "text": "سرانجام چون دیگر طاقت نداشتیم، رضا دادیم که ما را در آتن تنها واگذارند."
        },
        {
          "verse": 2,
          "usfm": "1TH.3.2",
          "line_type": "p",
          "text": "پس تیموتائوس را که برادر ما و همکار خدا در کار انجیل مسیح است، نزدتان فرستادیم تا شما را در ایمانتان تقویت و تشویق کند،"
        },
        {
          "verse": 3,
          "usfm": "1TH.3.3",
          "line_type": "p",
          "text": "تا هیچ‌کس در اثر این سختیها سست نشود، زیرا نیک می‌دانید که اینها برای ما مقرر است."
        },
        {
          "verse": 4,
          "usfm": "1TH.3.4",
          "line_type": "p",
          "text": "به‌واقع هنگامی که با شما بودیم، پیشاپیش گفتیم که آزار خواهیم دید، و همان‌گونه که آگاهید، چنین نیز شد."
        },
        {
          "verse": 5,
          "usfm": "1TH.3.5",
          "line_type": "p",
          "text": "از این رو، چون دیگر طاقت نداشتم، فرستادم تا از ایمانتان آگاهی یابم، زیرا بیم آن داشتم که آن وسوسه‌گر به نحوی شما را وسوسه کرده، و زحمات ما به هدر رفته باشد."
        },
        {
          "verse": 6,
          "usfm": "1TH.3.6",
          "line_type": "p",
          "text": "امّا اکنون تیموتائوس از نزد شما بازگشته و ما را مژده از ایمان و محبت شما آورده است. او به ما خبر داده که شما همیشه از ما به نیکی یاد می‌کنید و همان‌گونه که ما مشتاق دیدار شماییم، شما نیز شوق دیدار ما را دارید."
        },
        {
          "verse": 7,
          "usfm": "1TH.3.7",
          "line_type": "p",
          "text": "از همین رو، ای برادران، با وجود همۀ فشارها و زحماتمان، از بابت شما و ایمانتان دلگرم شده‌ایم."
        },
        {
          "verse": 8,
          "usfm": "1TH.3.8",
          "line_type": "p",
          "text": "اکنون می‌توانیم نفسی به‌راحت برآوریم، زیرا شما در خداوند استوارید."
        },
        {
          "verse": 9,
          "usfm": "1TH.3.9",
          "line_type": "p",
          "text": "امّا چگونه می‌توانیم به شکرانۀ این همه شادی که به‌خاطر شما در حضور خدای خود یافته‌ایم، او را سپاسی بسزا گوییم؟"
        },
        {
          "verse": 10,
          "usfm": "1TH.3.10",
          "line_type": "p",
          "text": "ما روز و شب از دل و جان دعا می‌کنیم که باز به دیدارتان نایل شویم تا هر کاستی ایمان شما را برطرف سازیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.3.11",
          "line_type": "p",
          "text": "خودِ خدا، پدر ما، و خداوند ما عیسی، راه ما را به سوی شما هموار سازد."
        },
        {
          "verse": 12,
          "usfm": "1TH.3.12",
          "line_type": "p",
          "text": "و همان‌گونه که محبت ما به شما فزونی می‌یابد، خداوند محبت شما را به یکدیگر و به همۀ مردم بسیار افزون گرداند."
        },
        {
          "verse": 13,
          "usfm": "1TH.3.13",
          "line_type": "p",
          "text": "و دلهای شما را استواری بخشد تا آنگاه که خداوند ما عیسی با همۀ مقدسان خود می‌آید، در حضور خدا، پدر ما، بی‌عیب و مقدّس باشید."
        }
      ],
      "verse_count": 13,
      "headings": [
        {
          "before_verse": 6,
          "text": "گزارش دلگرم‌کنندۀ تیموتائوس"
        }
      ],
      "footnotes": [
        {
          "verse": 13,
          "usfm": "1TH.3.13",
