    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 5,
      "chapter_usfm": "1TH.5",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.5.1",
          "line_type": "p",
          "text": "و امّا دربارۀ وقتها و زمانها، ای برادران، نیازی نیست چیزی به شما بنویسم."
        },
        {
          "verse": 2,
          "usfm": "1TH.5.2",
          "line_type": "p",
          "text": "زیرا خود نیک می‌دانید که روز خداوند همچون دزدی که شب‌هنگام می‌آید، فرا خواهد رسید."
        },
        {
          "verse": 3,
          "usfm": "1TH.5.3",
          "line_type": "p",
          "text": "آن زمان که مردم می‌گویند: «صلح و امنیت حکمفرماست»، ناگهان هلاکت بر ایشان نازل خواهد شد، بدان‌سان که زن آبستن به دردِ زایمان دچار شود، و از آن گریزی نخواهد بود."
        },
        {
          "verse": 4,
          "usfm": "1TH.5.4",
          "line_type": "p",
          "text": "امّا شما ای برادران، در تاریکی نیستید تا آن روز چون دزد غافلگیرتان کند."
        },
        {
          "verse": 5,
          "usfm": "1TH.5.5",
          "line_type": "p",
          "text": "شما همه فرزندانِ نور و فرزندان روزید؛ ما به شب و به تاریکی تعلق نداریم."
        },
        {
          "verse": 6,
          "usfm": "1TH.5.6",
          "line_type": "p",
          "text": "پس همانند دیگران به خواب نرویم، بلکه بیدار و هوشیار باشیم."
        },
        {
          "verse": 7,
          "usfm": "1TH.5.7",
          "line_type": "p",
          "text": "زیرا آنان که می‌خوابند، شب‌هنگام می‌خوابند، و آنان که مست می‌کنند، شب‌هنگام مست می‌کنند."
        },
        {
          "verse": 8,
          "usfm": "1TH.5.8",
          "line_type": "p",
          "text": "امّا ما چون به روز تعلّق داریم، باید هوشیار باشیم، و ایمان و محبت را همچون زرۀ سینه‌پوش بر تن کنیم، و امیدِ نجات را همچون کلاهخود بر سر نهیم."
        },
        {
          "verse": 9,
          "usfm": "1TH.5.9",
          "line_type": "p",
          "text": "زیرا خدا ما را نه برای غضب، بلکه برای کسب نجات به واسطۀ خداوندمان عیسی مسیح تعیین کرده است،"
        },
        {
          "verse": 10,
          "usfm": "1TH.5.10",
          "line_type": "p",
          "text": "که به‌خاطر ما مرد، تا چه بیدار باشیم و چه خفته، با او زندگی کنیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.5.11",
          "line_type": "p",
          "text": "پس یکدیگر را تشویق و تقویت کنید، چنانکه اکنون نیز می‌کنید."
        },
        {
          "verse": 12,
          "usfm": "1TH.5.12",
          "line_type": "p",
          "text": "حال ای برادران، تقاضا می‌کنیم آنان را که در میان شما زحمت می‌کشند و از جانب خداوند رهبران شما بوده، پندتان می‌دهند، گرامی بدارید،"
        },
        {
          "verse": 13,
          "usfm": "1TH.5.13",
          "line_type": "p",
          "text": "و با محبت، کمال احترام را به سبب کاری که انجام می‌دهند، برایشان قائل باشید. و با یکدیگر در صلح و صفا زندگی کنید."
        },
        {
          "verse": 14,
          "usfm": "1TH.5.14",
          "line_type": "p",
          "text": "ای برادران، از شما استدعا می‌کنیم که کاهلان را هشدار دهید؛ کم‌جرئتان را تشویق کنید؛ ضعیفان را حمایت نمایید؛ و با همه بردبار باشید."
        },
        {
          "verse": 15,
          "usfm": "1TH.5.15",
          "line_type": "p",
          "text": "زِنهار، کسی بدی را با بدی پاسخ نگوید، بلکه همواره در پی نیکی کردن به یکدیگر و به همۀ مردم باشید."
        },
        {
          "verse": 16,
          "usfm": "1TH.5.16",
          "line_type": "p",
          "text": "همیشه شاد باشید؛"
        },
        {
          "verse": 17,
          "usfm": "1TH.5.17",
          "line_type": "p",
          "text": "پیوسته دعا کنید؛"
        },
        {
          "verse": 18,
          "usfm": "1TH.5.18",
          "line_type": "p",
          "text": "در هر وضعی شکرگزار باشید، زیرا این است ارادۀ خدا برای شما در مسیحْ عیسی."
        },
        {
          "verse": 19,
          "usfm": "1TH.5.19",
          "line_type": "p",
          "text": "آتش روح را خاموش مکنید؛"
        },
        {
          "verse": 20,
          "usfm": "1TH.5.20",
          "line_type": "p",
          "text": "نبوّتها را خوار مشمارید."
        },
        {
          "verse": 21,
          "usfm": "1TH.5.21",
          "line_type": "p",
          "text": "همه چیز را بیازمایید؛ به آنچه نیکوست، محکم بچسبید."
        },
        {
          "verse": 22,
          "usfm": "1TH.5.22",
          "line_type": "p",
          "text": "از هر گونه بدی دوری کنید."
        },
        {
          "verse": 23,
          "usfm": "1TH.5.23",
          "line_type": "p",
          "text": "خدای سلامتی، خودْ شما را به تمامی تقدیس کند و روح و جان و تن شما تا آمدن خداوندمان عیسی مسیح، بی‌عیب محفوظ بماند."
        },
        {
          "verse": 24,
          "usfm": "1TH.5.24",
          "line_type": "p",
          "text": "او که شما را فرا می‌خواند، امین است و این را خواهد کرد."
        },
        {
          "verse": 25,
          "usfm": "1TH.5.25",
          "line_type": "p",
          "text": "ای برادران، برای ما دعا کنید."
        },
        {
          "verse": 26,
          "usfm": "1TH.5.26",
          "line_type": "p",
          "text": "با بوسه‌ای مقدّس همۀ برادران را سلام گویید."
        },
        {
          "verse": 27,
          "usfm": "1TH.5.27",
          "line_type": "p",
          "text": "در حضور خداوند، شما را قسم می‌دهم که این نامه را برای همۀ برادران قرائت کنید."
        },
        {
          "verse": 28,
          "usfm": "1TH.5.28",
          "line_type": "p",
          "text": "فیض خداوند ما عیسی مسیح با شما باد. آمین."
        }
      ],
      "verse_count": 28,
      "headings": [
        {
          "before_verse": 12,
          "text": "اندرزهای پایانی"
        }
      ],
      "footnotes": [
        {
          "verse": 6,
          "usfm": "1TH.5.6",
          "note_ref": "5‏:6",
          "note_type": "footnote",
          "references": [],
          "text": "یا ”خویشتندار“؛ همچنین در آیۀ ۸."
        },
        {
          "verse": 10,
          "usfm": "1TH.5.10",
          "note_ref": "5‏:10",
          "note_type": "footnote",
          "references": [],
          "text": "یعنی:‏ «چه زنده باشیم، چه مرده»."
