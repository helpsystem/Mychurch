  "chapters": [
    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 1,
      "chapter_usfm": "1TH.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.1.1",
          "line_type": "p",
          "text": "از پولس و سیلاس و تیموتائوس،به کلیسای تسالونیکیان که در خدای پدر و خداوندْ عیسی مسیح‌اند:فیض و سلامتی بر شما باد."
        },
        {
          "verse": 2,
          "usfm": "1TH.1.2",
          "line_type": "p",
          "text": "ما همواره خدا را به‌خاطر وجود همۀ شما شکر می‌گوییم و از شما در دعاهای خود نام می‌بریم،"
        },
        {
          "verse": 3,
          "usfm": "1TH.1.3",
          "line_type": "p",
          "text": "و پیوسته در حضور خدا و پدر خود، عمل شما را که از ایمان ناشی می‌شود و محنت شما را که محرک آن محبت است و پایداری شما را که از امید به خداوندمان عیسی مسیح الهام می‌گیرد، به یاد می‌آوریم."
        },
        {
          "verse": 4,
          "usfm": "1TH.1.4",
          "line_type": "p",
          "text": "زیرا ای برادران که محبوب خدایید، از برگزیدگی شما آگاهیم."
        },
        {
          "verse": 5,
          "usfm": "1TH.1.5",
          "line_type": "p",
          "text": "چرا که انجیلِ ما تنها نه با کلمات، بلکه با قدرت و روح‌القدس و یقین کامل به شما رسید، چنانکه نیک می‌دانید به‌خاطر شما چگونه در میانتان رفتار کردیم."
        },
        {
          "verse": 6,
          "usfm": "1TH.1.6",
          "line_type": "p",
          "text": "شما از ما و از خداوند سرمشق گرفتید و در رنج بسیار، کلام را با آن شادی که روح‌القدس می‌بخشد، استقبال کردید."
        },
        {
          "verse": 7,
          "usfm": "1TH.1.7",
          "line_type": "p",
          "text": "بدین‌گونه شما برای همۀ ایمانداران مقدونیه و اَخائیه سرمشقی بر جای گذاشتید،"
        },
        {
          "verse": 8,
          "usfm": "1TH.1.8",
          "line_type": "p",
          "text": "زیرا کلام خداوند به واسطۀ شما نه تنها در مقدونیه و اَخائیه طنین افکند، بلکه ایمان شما به خدا در همه جا بر سر زبانهاست، آن‌گونه که دیگر نیازی نیست ما چیزی بگوییم."
        },
        {
          "verse": 9,
          "usfm": "1TH.1.9",
          "line_type": "p",
          "text": "زیرا آنان خود از استقبال گرم شما از ما سخن می‌گویند، و از اینکه چگونه از بتها دست کشیده، به سوی خدا بازگشتید تا خدای زنده و حقیقی را خدمت کنید"
        },
        {
          "verse": 10,
          "usfm": "1TH.1.10",
          "line_type": "p",
          "text": "و در انتظار آمدن پسر او از آسمان باشید، که از مردگان برخیزانیدش، یعنی عیسی، که ما را از غضب آینده رهایی می‌بخشد."
        }
      ],
      "verse_count": 10,
      "headings": [
        {
          "before_verse": 2,
          "text": "شکرگزاری و دعا"
        }
      ],
      "footnotes": [
        {
          "verse": 1,
          "usfm": "1TH.1.1",
          "note_ref": "1‏:1",
          "note_type": "footnote",
          "references": [],
          "text": "در اصل یونانی:‏ ”سیلوانُس“، که شکل دیگری از ”سیلاس“ است."
        }
      ],
