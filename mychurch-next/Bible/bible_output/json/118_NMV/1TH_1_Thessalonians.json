    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 4,
      "chapter_usfm": "1TH.4",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.4.1",
          "line_type": "p",
          "text": "دیگر اینکه، ای برادران، شما از ما آموختید که چگونه باید رفتار کنید تا خدا را خشنود سازید، همان‌گونه که چنین نیز می‌کنید. اکنون به نام عیسای خداوند از شما استدعا داریم و اندرزتان می‌دهیم که در این باره هر چه بیشتر تلاش کنید."
        },
        {
          "verse": 2,
          "usfm": "1TH.4.2",
          "line_type": "p",
          "text": "زیرا آگاهید که از جانب عیسای خداوند، چه احکامی به شما داده‌ایم."
        },
        {
          "verse": 3,
          "usfm": "1TH.4.3",
          "line_type": "p",
          "text": "ارادۀ خدا این است که مقدّس باشید: خود را از بی‌عفتی دور نگاه دارید."
        },
        {
          "verse": 4,
          "usfm": "1TH.4.4",
          "line_type": "p",
          "text": "هر‌یک از شما باید بداند که چگونه در پاکی و برازندگی، بدن خود را تحت تسلّط نگاه دارد."
        },
        {
          "verse": 5,
          "usfm": "1TH.4.5",
          "line_type": "p",
          "text": "نباید همانند قومهایی که خدا را نمی‌شناسند، دستخوش امیال شهوانی باشید."
        },
        {
          "verse": 6,
          "usfm": "1TH.4.6",
          "line_type": "p",
          "text": "هیچ‌کس نباید در این امر دست تجاوز یا طمع به حریم برادر خود دراز کند. چنانکه پیشتر به شما گفتیم و هشدار دادیم، خداوند همۀ این کارها را کیفر خواهد داد."
        },
        {
          "verse": 7,
          "usfm": "1TH.4.7",
          "line_type": "p",
          "text": "زیرا خدا ما را نه به ناپاکی، بلکه به قدّوسیت فرا خوانده است."
        },
        {
          "verse": 8,
          "usfm": "1TH.4.8",
          "line_type": "p",
          "text": "پس، هر که این تعلیم را رد کند، نه انسان، بلکه خدایی را رد کرده که روح قدّوس خود را به شما عطا می‌فرماید."
        },
        {
          "verse": 9,
          "usfm": "1TH.4.9",
          "line_type": "p",
          "text": "و اما دربارۀ محبت برادرانه نیازی نیست چیزی به شما بنویسیم، زیرا خود از خدا آموخته‌اید که یکدیگر را محبت کنید،"
        },
        {
          "verse": 10,
          "usfm": "1TH.4.10",
          "line_type": "p",
          "text": "و براستی که همۀ برادران را در سرتاسر مقدونیه محبت می‌کنید. با این همه، ای برادران، ترغیبتان می‌کنیم که هر چه بیشتر چنین کنید."
        },
        {
          "verse": 11,
          "usfm": "1TH.4.11",
          "line_type": "p",
          "text": "آرزومند این باشید که زندگی آرامی داشته باشید و سر به کار خویش مشغول بدارید و با دستهای خود کار کنید، همان‌گونه که شما را حکم کردیم."
        },
        {
          "verse": 12,
          "usfm": "1TH.4.12",
          "line_type": "p",
          "text": "بدین‌سان، زندگی روزمرۀ شما احترام مردمِ بیرون را بر خواهد انگیخت، و محتاج کسی نیز نخواهید بود."
        },
        {
          "verse": 13,
          "usfm": "1TH.4.13",
          "line_type": "p",
          "text": "ای برادران، نمی‌خواهیم از حال خفتگان بی‌خبر باشید، مبادا همچون دیگر مردمان که امیدی ندارند، به ماتم بنشینید."
        },
        {
          "verse": 14,
          "usfm": "1TH.4.14",
          "line_type": "p",
          "text": "زیرا اگر ایمان داریم که عیسی مرد و برخاست، پس به همین‌سان خدا آنان را نیز که در عیسی خفته‌اند، با وی باز خواهد آورد."
        },
        {
          "verse": 15,
          "usfm": "1TH.4.15",
          "line_type": "p",
          "text": "این را به واسطۀ کلام خودِ خداوند به شما می‌گوییم: کسانی از ما که هنوز زنده‌اند و تا آمدن خداوند باقی می‌مانند، به‌یقین از خفتگان پیشی نخواهند گرفت."
        },
        {
          "verse": 16,
          "usfm": "1TH.4.16",
          "line_type": "p",
          "text": "زیرا خداوند، خود با فرمانی بلندآواز و آوای رئیس فرشتگان و نفیر شیپور خدا، از آسمان فرود خواهد آمد. آنگاه نخست مردگانِ در مسیح، بر خواهند خاست."
        },
        {
          "verse": 17,
          "usfm": "1TH.4.17",
          "line_type": "p",
          "text": "پس از آن، ما که هنوز زنده و باقی مانده‌ایم، با آنها در ابرها ربوده خواهیم شد تا خداوند را در هوا ملاقات کنیم، و بدین‌گونه همیشه با خداوند خواهیم بود."
        },
        {
          "verse": 18,
          "usfm": "1TH.4.18",
          "line_type": "p",
          "text": "پس بدین سخنان، یکدیگر را دلداری دهید."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 13,
          "text": "بازگشت خداوندْ عیسی"
        }
      ],
      "footnotes": [
