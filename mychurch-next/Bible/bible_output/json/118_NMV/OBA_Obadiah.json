    {
      "schema_version": 6,
      "book_id": "OBA",
      "chapter": 1,
      "chapter_usfm": "OBA.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "OBA.1.1",
          "line_type": "p",
          "text": "رؤیای عوبَدیا.پیامی از خداوند شنیده‌ایم؛پیکی نزد قومها فرستاده شده که می‌گوید:«برخیزید تا با او به نبرد برآییم!»خداوندگارْ یهوه دربارۀ اَدوم چنین می‌فرماید:"
        },
        {
          "verse": 2,
          "usfm": "OBA.1.2",
          "line_type": "q1",
          "text": "هان من تو را در میان قومها کوچک خواهم ساخت،و تو بسیار پست خواهی شد."
        },
        {
          "verse": 3,
          "usfm": "OBA.1.3",
          "line_type": "q1",
          "text": "ای که در شکافهای صخره ساکنیو مسکنت بر بلندیهاست،ای که با خود می‌گویی:«کیست که مرا به زمین فرود آوَرَد؟»بدان که تکبر دلت تو را فریفته است."
        },
        {
          "verse": 4,
          "usfm": "OBA.1.4",
          "line_type": "q1",
          "text": "خداوند می‌فرماید:اگرچه همچون عقاب اوج گیریو در میان ستارگان آشیان گزینی،از آنجا تو را فرود خواهم آورد."
        },
        {
          "verse": 5,
          "usfm": "OBA.1.5",
          "line_type": "q1",
          "text": "اگر دزدان بر تو آیندو غارتگران بر تو شبیخون زنند -چه مصیبتی در انتظارت خواهد بود! - آیا تنها به قدرِ کفایت دزدی نخواهند کرد؟اگر انگورچینان بر تو آیند،آیا خوشه‌هایی باقی نخواهند گذاشت؟"
        },
        {
          "verse": 6,
          "usfm": "OBA.1.6",
          "line_type": "q1",
          "text": "اما عیسو چگونه غارت شده،و گنجهای نهانش چه‌سان به تاراج رفته است!"
        },
        {
          "verse": 7,
          "usfm": "OBA.1.7",
          "line_type": "q1",
          "text": "هم‌پیمانانت جملگی تو را به سرحدّاتت رانده‌اند؛آنان که با تو در صلحند، تو را فریفته و بر تو چیره گشته‌اند؛آنان که نان تو را خورده‌اند پیش رویت دام نهاده‌اند،و تو از آن آگاه نیستی."
        },
        {
          "verse": 8,
          "usfm": "OBA.1.8",
          "line_type": "q1",
          "text": "خداوند می‌فرماید:آیا در آن روز حکیمان را از اَدومو خردمندان را از کوه عیسو نابود نخواهم کرد؟"
        },
        {
          "verse": 9,
          "usfm": "OBA.1.9",
          "line_type": "q1",
          "text": "ای تیمان، جنگاورانت هراسان خواهند شد،تا همگی کشته شده، از کوه عیسو منقطع گردند."
        },
        {
          "verse": 10,
          "usfm": "OBA.1.10",
          "line_type": "q1",
          "text": "به سبب خشونتی که بر برادرت یعقوب روا داشتی،شرمساریْ تو را در بر خواهد گرفتو تا به ابد نابود خواهی شد."
        },
        {
          "verse": 11,
          "usfm": "OBA.1.11",
          "line_type": "q1",
          "text": "آن روز که در کناری ایستادی،روزی که اجنبیان ثروت او را به یغما بردندو بیگانگان به دروازه‌هایش درآمده،بر اورشلیم قرعه افکندند،تو نیز همچون یکی از آنان بودی."
        },
        {
          "verse": 12,
          "usfm": "OBA.1.12",
          "line_type": "q1",
          "text": "به روزِ نگونبختیِ برادرتبر وی شادمانه منگر،به روز هلاکت مردم یهودابر آنان شادی مکن،و به روز مصیبت ایشانبر آنان فخر مفروش."
        },
        {
          "verse": 13,
          "usfm": "OBA.1.13",
          "line_type": "q1",
          "text": "به روز بلای قوم منبه دروازه‌هایشان داخل مشو،به روز مصیبت ایشانبر آنان شادمانه منگر،و به روز تنگیِ ایشاندست تطاول بر اموالشان دراز مکن."
        },
        {
          "verse": 14,
          "usfm": "OBA.1.14",
          "line_type": "q1",
          "text": "بر سر چهارراه مَایستتا پناه‌جویانشان را قتل‌عام کنی؛و بازماندگانشان را در روز بلا تسلیم منما."
        },
        {
          "verse": 15,
          "usfm": "OBA.1.15",
          "line_type": "q1",
          "text": "زیرا روز خداوند،برای تمامی قومها نزدیک است!به همان‌گونه که تو عمل کردی،با تو عمل خواهند کرد؛اعمال تو بر سر خودت خواهد آمد."
        },
        {
          "verse": 16,
          "usfm": "OBA.1.16",
          "line_type": "q1",
          "text": "زیرا همان‌گونه که شما بر کوه مقدسِ من نوشیدید،به همان‌گونه همۀ قومها پیوسته خواهند نوشید؛آری، آنان خواهند نوشید و خواهند بلعید،و چنان خواهند شد که گویی هرگز نبوده‌اند."
        },
        {
          "verse": 17,
          "usfm": "OBA.1.17",
          "line_type": "q1",
          "text": "اما بر کوه صَهیون رستگاری خواهد بود،و آن مکانْ مقدس خواهد بود،و خاندان یعقوب میراث خود راتصاحب خواهند کرد."
        },
        {
          "verse": 18,
          "usfm": "OBA.1.18",
          "line_type": "q1",
          "text": "خاندان یعقوب آتشی خواهد بود،خاندان یوسف شعله‌ای،و خاندان عیسو کاه؛ایشان آنها را به آتش کشیده، خواهند سوزانید،و از خاندان عیسو کسی زنده نخواهد ماند،زیرا خداوند سخن گفته است."
        },
        {
          "verse": 19,
          "usfm": "OBA.1.19",
          "line_type": "q1",
          "text": "مردمان نِگِب کوه عیسو را متصرف خواهند شد،و اهالیِ کوهپایه، سرزمین فلسطینیان را تسخیر خواهند کرد؛ایشان سرزمین اِفرایِم و سرزمین سامِرِه را به تصرف در خواهند آورد،و بِنیامین، جِلعاد را."
        },
        {
          "verse": 20,
          "usfm": "OBA.1.20",
          "line_type": "q1",
          "text": "تبعیدشدگانِ این لشکرِ بنی‌اسرائیل،سرزمین کنعانیان را تا صَرِفَه تسخیر خواهند کرد؛و تبعیدشدگانِ اورشلیم که در سِفارَد هستند،شهرهای نِگِب را تصرف خواهند نمود."
        },
        {
          "verse": 21,
          "usfm": "OBA.1.21",
          "line_type": "q1",
          "text": "نجات‌دهندگان به کوه صَهیون بر خواهند آمدتا بر کوه عیسو فرمان برانند؛و سلطنت از آنِ خداوند خواهد بود!"
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 2,
          "text": "نابودی اَدوم"
        },
        {
          "before_verse": 10,
          "text": "خشونت اَدوم"
        },
        {
          "before_verse": 15,
          "text": "روز خداوند"
        },
        {
          "before_verse": 19,
          "text": "پادشاهی خداوند"
        }
      ],
      "footnotes": [
        {
          "verse": 3,
          "usfm": "OBA.1.3",
          "note_ref": "1‏:3",
          "note_type": "footnote",
