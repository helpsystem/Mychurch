  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2JN",
      "chapter": 1,
      "chapter_usfm": "2JN.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2JN.1.1",
          "line_type": "p",
          "text": "از شیخ کلیسا،به بانوی برگزیده و فرزندانش که ایشان را در ’حقیقت‘ دوست می‌دارم - و نه تنها من، بلکه همۀ آنان که حقیقت را شناخته‌اند -"
        },
        {
          "verse": 2,
          "usfm": "2JN.1.2",
          "line_type": "p",
          "text": "به سبب آن حقیقت که در ما ساکن است و تا ابد با ما خواهد بود."
        },
        {
          "verse": 3,
          "usfm": "2JN.1.3",
          "line_type": "p",
          "text": "فیض و رحمت و سلامتی از جانب خدای پدر و از جانب عیسی مسیح، پسر آن پدر، در حقیقت و محبت با ما خواهد بود."
        },
        {
          "verse": 4,
          "usfm": "2JN.1.4",
          "line_type": "p",
          "text": "بسی شادمان شدم که دریافتم برخی از فرزندان تو بنا بر حکمی که از پدر یافتیم، در ’حقیقت‘ سلوک می‌کنند."
        },
        {
          "verse": 5,
          "usfm": "2JN.1.5",
          "line_type": "p",
          "text": "امّا حال، بانوی گرامی، از تو درخواستی دارم. نه آنکه حکمی تازه به تو بنویسم، بلکه همان که از آغاز داشته‌ایم، که یکدیگر را محبت کنیم."
        },
        {
          "verse": 6,
          "usfm": "2JN.1.6",
          "line_type": "p",
          "text": "و محبت این است که بنا بر احکام او سلوک نماییم. آری، همان‌گونه که از آغاز شنیده‌اید، حکم او این است که در محبت سلوک کنید."
        },
        {
          "verse": 7,
          "usfm": "2JN.1.7",
          "line_type": "p",
          "text": "زیرا که فریبکارانِ بسیار به دنیا بیرون رفته‌اند، که بر آمدن عیسی مسیح در جسم انسانی اقرار ندارند. چنین کسان، همان فریبکار و ضدّمسیح‌اند."
        },
        {
          "verse": 8,
          "usfm": "2JN.1.8",
          "line_type": "p",
          "text": "بهوش باشید که ثمر کار خود را بر ‌باد ندهید، بلکه پاداشی به کمال دریافت کنید."
        },
        {
          "verse": 9,
          "usfm": "2JN.1.9",
          "line_type": "p",
          "text": "هر آن کس که از تعلیم مسیح فراتر رود و در آن پایدار نماند، خدا را ندارد، آن که در آن تعلیم پایدار مانَد، هم پدر را دارد و هم پسر را."
        },
        {
          "verse": 10,
          "usfm": "2JN.1.10",
          "line_type": "p",
          "text": "اگر کسی نزد شما آید و این تعلیم را نیاورد، او را به خانۀ خود مپذیرید و خوشامدش مگویید؛"
        },
        {
          "verse": 11,
          "usfm": "2JN.1.11",
          "line_type": "p",
          "text": "زیرا آن که او را خوشامد گوید، در اعمال بدش شریک می‌شود."
        },
        {
          "verse": 12,
          "usfm": "2JN.1.12",
          "line_type": "p",
          "text": "بسیار چیزها دارم که به شما بنویسم، لیکن نمی‌خواهم با قلم و کاغذ باشد. امّا امیدوارم نزدتان بیایم و رویاروی گفتگو کنیم تا شادی‌مان کامل شود."
        },
        {
          "verse": 13,
          "usfm": "2JN.1.13",
          "line_type": "p",
          "text": "فرزندان خواهرِ برگزیده‌ات، برای تو سلام می‌فرستند. [آمین!]"
        }
      ],
      "verse_count": 13,
