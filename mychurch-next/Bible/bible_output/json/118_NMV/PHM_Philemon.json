  "chapters": [
    {
      "schema_version": 6,
      "book_id": "PHM",
      "chapter": 1,
      "chapter_usfm": "PHM.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHM.1.1",
          "line_type": "p",
          "text": "از پولس، زندانی مسیحْ عیسی، و تیموتائوس، برادر ما،به دوست عزیز و همکار ما فیلیمون،"
        },
        {
          "verse": 2,
          "usfm": "PHM.1.2",
          "line_type": "p",
          "text": "به خواهر ما آپْفیا و همرزم ما آرخیپوس، و به کلیسایی که در خانه‌ات برپا می‌شود:"
        },
        {
          "verse": 3,
          "usfm": "PHM.1.3",
          "line_type": "p",
          "text": "فیض و سلامتی از جانب خدا، پدر ما، و خداوندْ عیسی مسیح بر شما باد."
        },
        {
          "verse": 4,
          "usfm": "PHM.1.4",
          "line_type": "p",
          "text": "من با یاد آوردنت در دعاهایم، همواره خدای خود را سپاس می‌گویم،"
        },
        {
          "verse": 5,
          "usfm": "PHM.1.5",
          "line_type": "p",
          "text": "زیرا وصف ایمانت به خداوندْ عیسی و محبتت به همۀ مقدسین را می‌شنوم."
        },
        {
          "verse": 6,
          "usfm": "PHM.1.6",
          "line_type": "p",
          "text": "دعایم این است که مشارکت ایمانت بسی کارگر افتاده، تو را به شناخت هر قابلیت نیکویی رهنمون شود که در جهت نیل به قامت مسیح در ماست."
        },
        {
          "verse": 7,
          "usfm": "PHM.1.7",
          "line_type": "p",
          "text": "محبت تو مرا سخت شاد و دلگرم کرده است، چه تو به دلهای مقدسین طراوت و تازگی بخشیده‌ای."
        },
        {
          "verse": 8,
          "usfm": "PHM.1.8",
          "line_type": "p",
          "text": "از این رو، هرچند در مسیح این جسارت را دارم که تو را به انجام آنچه سزاوار است حکم کنم،"
        },
        {
          "verse": 9,
          "usfm": "PHM.1.9",
          "line_type": "p",
          "text": "ترجیح می‌دهم بر پایۀ محبت استدعا کنم. پس من، پولسِ پیر، که اکنون نیز زندانی مسیحْ عیسایم،"
        },
        {
          "verse": 10,
          "usfm": "PHM.1.10",
          "line_type": "p",
          "text": "دربارۀ پسرم اونِسیموس که در بندْ او را پدر شده‌ام، استدعایی از تو دارم."
        },
        {
          "verse": 11,
          "usfm": "PHM.1.11",
          "line_type": "p",
          "text": "او در گذشته برای تو بی‌فایده بود، امّا اکنون هم تو را و هم مرا مفید است."
        },
        {
          "verse": 12,
          "usfm": "PHM.1.12",
          "line_type": "p",
          "text": "او را که پارۀ تنِ من است نزد تو باز می‌فرستم."
        },
        {
          "verse": 13,
          "usfm": "PHM.1.13",
          "line_type": "p",
          "text": "می‌خواستم نزد خود نگاهش بدارم تا در مدتی که به‌خاطر انجیل در بندم، سهم تو را در خدمت به من بر عهده گیرد."
        },
        {
          "verse": 14,
          "usfm": "PHM.1.14",
          "line_type": "p",
          "text": "امّا نخواستم کاری بدون موافقت تو کرده باشم، تا احسانت از روی میل باشد، نه به اجبار."
        },
        {
          "verse": 15,
          "usfm": "PHM.1.15",
          "line_type": "p",
          "text": "چه بسا که از همین رو اندک زمانی از تو جدا شد تا برای همیشه نزدت بازگردد،"
        },
        {
          "verse": 16,
          "usfm": "PHM.1.16",
          "line_type": "p",
          "text": "امّا دیگر نه چون غلام، بلکه بالاتر از آن، چون برادری عزیز. او مرا بس عزیز است، امّا تو را به مراتب عزیزتر است، خواه در مقام یک انسان و خواه در مقام برادری در خداوند."
        },
        {
          "verse": 17,
          "usfm": "PHM.1.17",
          "line_type": "p",
          "text": "پس اگر مرا رفیق خود می‌دانی، او را همان‌گونه بپذیر که مرا می‌پذیری."
        },
        {
          "verse": 18,
          "usfm": "PHM.1.18",
          "line_type": "p",
          "text": "اگر خطایی به تو کرده، یا چیزی به تو بدهکار است، آن را به حساب من بگذار."
        },
        {
          "verse": 19,
          "usfm": "PHM.1.19",
          "line_type": "p",
          "text": "من، پولس، به دست خود می‌نویسم که آن را جبران خواهم کرد - البته نیازی نمی‌بینم بگویم که تو جان خود را نیز به من مدیونی."
        },
        {
          "verse": 20,
          "usfm": "PHM.1.20",
          "line_type": "p",
          "text": "آری ای برادر، آرزو دارم در خداوند نفعی از تو به من برسد؛ پس جان مرا در مسیح تازه ساز."
        },
        {
          "verse": 21,
          "usfm": "PHM.1.21",
          "line_type": "p",
          "text": "این را می‌نویسم چون از اطاعت تو اطمینان دارم و می‌دانم حتی بیش از آنچه می‌گویم، خواهی کرد."
        },
        {
          "verse": 22,
          "usfm": "PHM.1.22",
          "line_type": "p",
          "text": "در ضمن، اتاقی نیز برایم مهیا کن، زیرا امید دارم به سبب دعاهایتان به شما بخشیده شوم."
        },
        {
          "verse": 23,
          "usfm": "PHM.1.23",
          "line_type": "p",
          "text": "اِپافْراس، همزندان من در مسیحْ عیسی، تو را سلام می‌فرستد."
        },
        {
          "verse": 24,
          "usfm": "PHM.1.24",
          "line_type": "p",
          "text": "همچنین همکارانم، مَرقُس، آریستارخوس، دیماس و لوقا تو را سلام می‌گویند."
        },
        {
          "verse": 25,
          "usfm": "PHM.1.25",
          "line_type": "p",
          "text": "فیض خداوندْ عیسی مسیح با روح شما باد."
        }
      ],
      "verse_count": 25,
      "headings": [
        {
          "before_verse": 4,
          "text": "شکرگزاری و دعا"
        },
        {
          "before_verse": 8,
          "text": "استدعای پولس دربارۀ اونیسیموس"
        }
      ],
