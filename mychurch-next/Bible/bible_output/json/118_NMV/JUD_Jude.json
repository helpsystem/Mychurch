  "chapters": [
    {
      "schema_version": 6,
      "book_id": "JUD",
      "chapter": 1,
      "chapter_usfm": "JUD.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JUD.1.1",
          "line_type": "p",
          "text": "از یهودا، خادم عیسی مسیح و برادر یعقوب،به فراخواندگانی که در خدای پدر، محبوبند، و برای عیسی مسیح محفوظ نگاه داشته شده‌اند:"
        },
        {
          "verse": 2,
          "usfm": "JUD.1.2",
          "line_type": "p",
          "text": "رحمت و سلامتی و محبت، به‌فزونی بر شما باد."
        },
        {
          "verse": 3,
          "usfm": "JUD.1.3",
          "line_type": "p",
          "text": "ای عزیزان، گرچه اشتیاق بسیار داشتم تا دربارۀ نجاتی که در آن سهیم هستیم به شما بنویسم، امّا لازم دیدم با نوشتن این چند خط، شما را به ادامۀ مجاهده در راه ایمانی برانگیزم که یک بار برای همیشه به مقدسین سپرده شده است."
        },
        {
          "verse": 4,
          "usfm": "JUD.1.4",
          "line_type": "p",
          "text": "زیرا برخی کسان که محکومیتشان از دیرباز رقم خورده، مخفیانه در میان شما رخنه کرده‌اند. اینان خدانشناسانی هستند که فیض خدای ما را به جواز ارتکاب فجور بدل می‌کنند و عیسی مسیح، یگانه سرور و خداوند ما را انکار می‌نمایند."
        },
        {
          "verse": 5,
          "usfm": "JUD.1.5",
          "line_type": "p",
          "text": "با آنکه شما یک بار از این همه آگاهی یافته‌اید، می‌خواهم یادآور شوم که خداوند قوم خود را از سرزمین مصر رهانید، امّا زمانی دیگر آنان را که ایمان نداشتند، هلاک کرد."
        },
        {
          "verse": 6,
          "usfm": "JUD.1.6",
          "line_type": "p",
          "text": "او فرشتگانی را نیز که مقام والای خود را حفظ نکردند، بلکه منزلگاه مناسب خویش را ترک گفتند، به زنجیرهای ابدی کشیده و برای محاکمه در آن روز عظیم، در تاریکی مطلق نگاه داشته است."
        },
        {
          "verse": 7,
          "usfm": "JUD.1.7",
          "line_type": "p",
          "text": "به همین گونه، سُدوم و عَمورَه و شهرهای اطراف، که همانند آنان بی‌عفتی کردند و در پی شهوات غیرطبیعی رفتند، با تحمّل مجازاتِ آتش ابدی، چون درس عبرت مقرر گشتند."
        },
        {
          "verse": 8,
          "usfm": "JUD.1.8",
          "line_type": "p",
          "text": "با این همه، به گونه‌ای مشابه، این کسان نیز بر پایۀ خوابهایی که می‌بینند بدنهای خویش را نجس می‌سازند و اقتدار خداوند را رد می‌کنند و به بزرگان آسمانی اهانت می‌ورزند."
        },
        {
          "verse": 9,
          "usfm": "JUD.1.9",
          "line_type": "p",
          "text": "حال آنکه حتی میکائیل، فرشتۀ اعظم، آنگاه که با ابلیس دربارۀ جسد موسی مجادله می‌کرد، جرأت نکرد خودْ او را به سبب اهانت محکوم کند، بلکه فقط گفت: «خداوند، تو را توبیخ فرماید!»"
        },
        {
          "verse": 10,
          "usfm": "JUD.1.10",
          "line_type": "p",
          "text": "امّا اینان به آنچه از آن شناختی ندارند اهانت می‌ورزند، حال آنکه آنچه همچون حیوانات بی‌شعور از روی غریزه می‌فهمند، همان باعث هلاکتشان خواهد شد."
        },
        {
          "verse": 11,
          "usfm": "JUD.1.11",
          "line_type": "p",
          "text": "وای بر آنان، زیرا که به راه قائن رفته‌اند و در پی سود، به گمراهی بَلعام گرفتار آمده و در طغیان قورَح هلاک گشته‌اند."
        },
        {
          "verse": 12,
          "usfm": "JUD.1.12",
          "line_type": "p",
          "text": "اینان صخره‌های دریایی خطرناک در ضیافتهای محبت‌آمیز شمایند که بدون کمترین پروا در جشن شما به عیش و نوش می‌پردازند؛ شبانانی هستند که تنها خود را می‌پرورند؛ ابرهای بی‌بارانِ رانده از باد، و درختان پاییزی بی‌میوه‌اند که دو بار مرده و از ریشه به در آمده‌اند."
        },
        {
          "verse": 13,
          "usfm": "JUD.1.13",
          "line_type": "p",
          "text": "آری، اینان همچون امواج خروشان دریایند که اعمال ننگینشان را چون کف برمی‌آورند، و ستارگانی سرگردانند که تاریکی مطلقِ ابدی برایشان مقرر است."
        },
        {
          "verse": 14,
          "usfm": "JUD.1.14",
          "line_type": "p",
          "text": "خَنوخ، که هفتم پس از آدم بود، دربارۀ همینها پیشگویی کرده، می‌گوید: «هان، خداوند با هزاران هزار فرشتۀ مقدّس خود می‌آید"
        },
        {
          "verse": 15,
          "usfm": "JUD.1.15",
          "line_type": "p",
          "text": "تا بر همگان داوری کند و همۀ بی‌دینان را به سبب تمامی کارهای خلاف دینداری که در بی‌دینی کرده‌اند، و به سزای جملۀ سخنان زشتی که گناهکاران بی‌دین بر ضد او گفته‌اند، محکوم سازد.»"
        },
        {
          "verse": 16,
          "usfm": "JUD.1.16",
          "line_type": "p",
          "text": "اینان گله‌مند و عیب‌جو و غرقه در ارضای شهوات خویشند؛ سخنان تکبرآمیز بر زبان می‌رانند و به نفع خویش مردمان را تملّق می‌گویند."
        },
        {
          "verse": 17,
          "usfm": "JUD.1.17",
          "line_type": "p",
          "text": "امّا شما ای عزیزان، پیشگویی رسولان خداوند ما عیسی مسیح را به یاد داشته باشید"
        },
        {
          "verse": 18,
          "usfm": "JUD.1.18",
          "line_type": "p",
          "text": "که به شما گفتند: «در زمانهای آخر، استهزاکنندگانی خواهند آمد که بنا بر شهوات خود که خلاف دینداری است، رفتار خواهند کرد.»"
        },
        {
          "verse": 19,
          "usfm": "JUD.1.19",
          "line_type": "p",
          "text": "همینهایند که در میان شما جدایی می‌افکنند و نفسانی و عاری از روحند."
        },
        {
          "verse": 20,
          "usfm": "JUD.1.20",
          "line_type": "p",
          "text": "امّا شما ای عزیزان، خویشتن را بر ایمان بس مقدّس خود بنا کنید و در روح‌القدس دعا نمایید"
        },
        {
          "verse": 21,
          "usfm": "JUD.1.21",
          "line_type": "p",
          "text": "و خود را در محبتِ خدا نگاه دارید، در همان حال که منتظر رحمت خداوند ما عیسی مسیح هستید تا شما را به حیات جاویدان رهنمون گردد."
        },
        {
          "verse": 22,
          "usfm": "JUD.1.22",
          "line_type": "p",
          "text": "نسبت به برخی که متزلزلند، رحیم باشید؛"
        },
        {
          "verse": 23,
          "usfm": "JUD.1.23",
          "line_type": "p",
          "text": "برخی را از آتش بیرون کشیده، نجات دهید؛ و بر برخی دیگر با ترس، رحمت نشان دهید. در عین حال، حتی از جامه‌های آلوده به شهوات نفسانی متنفر باشید."
        },
        {
          "verse": 24,
          "usfm": "JUD.1.24",
          "line_type": "p",
          "text": "بر او که قادر است شما را از لغزش محفوظ نگاه دارد و در حضور پرجلال خویش بی‌عیب و آکنده از شادی عظیم حاضر سازد،"
        },
        {
          "verse": 25,
          "usfm": "JUD.1.25",
          "line_type": "p",
          "text": "بر آن خدای یکتا و نجات‌دهندۀ ما، به واسطۀ عیسی مسیح، خداوند ما، از ازل، حال، و تا ابد، جلال و شکوه و توانایی و قدرت باد! آمین."
        }
      ],
      "verse_count": 25,
      "headings": [
        {
          "before_verse": 3,
          "text": "گناه و سرانجام شوم مردمان خدا‌نشناس"
        },
        {
          "before_verse": 17,
          "text": "دعوت به استقامت در ایمان"
        },
        {
          "before_verse": 24,
          "text": "حمد و ستایش خدا"
        }
      ],
