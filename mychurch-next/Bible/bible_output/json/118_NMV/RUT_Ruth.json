    },
    {
      "schema_version": 6,
      "book_id": "RUT",
      "chapter": 4,
      "chapter_usfm": "RUT.4",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "RUT.4.1",
          "line_type": "p",
          "text": "و اما بوعَز به دروازۀ شهر رفت و آنجا بنشست. اینک آن ولیّ که بوعَز درباره‌اش سخن گفته بود، می‌گذشت. پس بوعَز گفت: «فلانی، بدین سو آمده، بنشین.» پس او آمده، بنشست."
        },
        {
          "verse": 2,
          "usfm": "RUT.4.2",
          "line_type": "p",
          "text": "آنگاه بوعَز ده تن از مشایخ شهر را برگرفته، بدیشان گفت: «اینجا بنشینید.» پس ایشان بنشستند."
        },
        {
          "verse": 3,
          "usfm": "RUT.4.3",
          "line_type": "p",
          "text": "سپس به آن ولیّ گفت: «نَعومی که از دیار موآب بازگشته، قطعه زمینی را که از آنِ برادرمان اِلیمِلِک بود، می‌فروشد."
        },
        {
          "verse": 4,
          "usfm": "RUT.4.4",
          "line_type": "p",
          "text": "پس فکر کردم تو را از این امر باخبر سازم و بگویم: ”در حضور کسانی که اینجا نشسته‌اند و در حضور مشایخ قوم من، آن را بخر.“ اگر آن را بازخرید می‌کنی، بکن. و اگر نمی‌کنی، به من بگو تا بدانم، زیرا جز تو کسی نیست که آن را بازخرید کند، و من پس از تو هستم.» آن مرد گفت: «آن را بازخرید می‌کنم.»"
        },
        {
          "verse": 5,
          "usfm": "RUT.4.5",
          "line_type": "p",
          "text": "آنگاه بوعَز گفت: «روزی که زمین را از دست نَعومی بخری، روت موآبی را نیز که بیوۀ آن درگذشته است، از آنِ خود خواهی ساخت تا نام آن متوفی را بر میراثش احیا کنی.»"
        },
        {
          "verse": 6,
          "usfm": "RUT.4.6",
          "line_type": "p",
          "text": "اما آن ولیّ گفت: «من نمی‌توانم آن را برای خود بازخرید کنم، مبادا میراث خویش را به خطر افکنم. تو حق بازخرید مرا برای خود بگیر، زیرا مرا توان بازخرید نیست.»"
        },
        {
          "verse": 7,
          "usfm": "RUT.4.7",
          "line_type": "p",
          "text": "در ایام قدیم رسم بازخرید و مبادله در اسرائیل این بود که برای رسمیت بخشیدن به هر چیز، شخص کفش خود را از پا به در می‌کرد و آن را به شخص دیگر می‌داد. این بود روش گواهی دادن در اسرائیل."
        },
        {
          "verse": 8,
          "usfm": "RUT.4.8",
          "line_type": "p",
          "text": "پس آن ولیّ به بوعَز گفت: «تو آن را برای خود بخر»، و کفش از پا به در آورد."
        },
        {
          "verse": 9,
          "usfm": "RUT.4.9",
          "line_type": "p",
          "text": "آنگاه بوعَز به مشایخ و همۀ قوم گفت: «امروز شما شاهدید که من تمامی مایملک اِلیمِلِک و تمامی مایملک کِلیون و مَحلون را از دست نَعومی خریدم."
        },
        {
          "verse": 10,
          "usfm": "RUT.4.10",
          "line_type": "p",
          "text": "همچنین، روتِ موآبی، بیوۀ مَحلون را نیز به زنی خود گرفتم تا نام آن درگذشته را بر میراث وی باقی نگاه دارم، تا نام او از میان برادرانش و از دروازۀ شهرش محو نگردد. امروز شما شاهد باشید.»"
        },
        {
          "verse": 11,
          "usfm": "RUT.4.11",
          "line_type": "p",
          "text": "آنگاه همۀ مردمانی که نزد دروازه بودند، و مشایخ گفتند: «ما شاهدیم. باشد که خداوند این زن را که به خانۀ تو می‌آید، همچون راحیل و لیَه گرداند که با هم خانۀ اسرائیل را بنا کردند. باشد که در اِفراتَه به شایستگی عمل کنی و در بِیت‌لِحِم پرآوازه شوی"
        },
        {
          "verse": 12,
          "usfm": "RUT.4.12",
          "line_type": "p",
          "text": "و به واسطۀ فرزندانی که خداوند از این زن جوان به تو می‌بخشد، خاندان تو همچون خاندان فِرِص باشد که تامار برای یهودا زایید.»"
        },
        {
          "verse": 13,
          "usfm": "RUT.4.13",
          "line_type": "p",
          "text": "بدین‌سان بوعَز، روت را گرفت و او زن وی شد. پس به او درآمد و خداوند روت را بارور کرد و او پسری به دنیا آورد."
        },
        {
          "verse": 14,
          "usfm": "RUT.4.14",
          "line_type": "p",
          "text": "آنگاه زنان به نَعومی گفتند: «‌متبارک باد خداوندی که امروز تو را بدون ولیّ نگذاشته است. باشد که نام او در اسرائیل پرآوازه شود!"
        },
        {
          "verse": 15,
          "usfm": "RUT.4.15",
          "line_type": "p",
          "text": "این پسر جان تو را تازه کند و در وقت پیری برایت تدارک ببیند، زیرا عروست که تو را دوست می‌دارد و برایت از هفت پسر نیکوتر است، او را زاده است.»"
        },
        {
          "verse": 16,
          "usfm": "RUT.4.16",
          "line_type": "p",
          "text": "آنگاه نَعومی طفل را گرفته، بر دامن خویش نهاد و دایۀ او شد."
        },
        {
          "verse": 17,
          "usfm": "RUT.4.17",
          "line_type": "p",
          "text": "و زنان همسایه‌اش طفل را نام نهاده، گفتند: «پسری برای نَعومی زاده شده است»، و او را عوبید نامیدند. او پدر یَسا، پدر داوود است."
        },
        {
          "verse": 18,
          "usfm": "RUT.4.18",
          "line_type": "p",
          "text": "این است نسل فِرِص: فِرِص پدر حِصرون بود؛"
        },
        {
          "verse": 19,
          "usfm": "RUT.4.19",
          "line_type": "p",
          "text": "حِصرون پدر رام، رام پدر عَمّیناداب،"
        },
        {
          "verse": 20,
          "usfm": "RUT.4.20",
          "line_type": "p",
          "text": "عَمّیناداب پدر نَحشون، نَحشون پدر سَلمون،"
        },
        {
          "verse": 21,
          "usfm": "RUT.4.21",
          "line_type": "p",
          "text": "سَلمون پدر بوعَز، بوعَز پدر عوبید،"
        },
        {
          "verse": 22,
          "usfm": "RUT.4.22",
          "line_type": "p",
          "text": "عوبید پدر یَسا و یَسا پدر داوود."
        }
      ],
