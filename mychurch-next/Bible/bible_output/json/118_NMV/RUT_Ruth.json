  "chapters": [
    {
      "schema_version": 6,
      "book_id": "RUT",
      "chapter": 1,
      "chapter_usfm": "RUT.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "RUT.1.1",
          "line_type": "p",
          "text": "در ایامی که داوران حکم می‌راندند، در سرزمین اسرائیل قحطی شد. پس، مردی از بِیت‌لِحِمِ یهودا، با همسر و دو پسرش به دیار موآب رفت تا در آنجا غربت گزیند."
        },
        {
          "verse": 2,
          "usfm": "RUT.1.2",
          "line_type": "p",
          "text": "نام آن مرد اِلیمِلِک، و نام همسرش نَعومی بود، و پسرانش مَحلون و کِلیون نام داشتند. ایشان اِفراتیانی از بِیت‌لِحِمِ یهودا بودند. پس ایشان به دیار موآب رفته، در آنجا ماندند."
        },
        {
          "verse": 3,
          "usfm": "RUT.1.3",
          "line_type": "p",
          "text": "اما اِلیمِلِک، شوهر نَعومی درگذشت و او با دو پسرش باقی ماند."
        },
        {
          "verse": 4,
          "usfm": "RUT.1.4",
          "line_type": "p",
          "text": "آن پسران زنان موآبی برای خود گرفتند که نام یکی عُرپَه و نام دیگری روت بود. ایشان نزدیک به ده سال در آنجا زندگی کردند."
        },
        {
          "verse": 5,
          "usfm": "RUT.1.5",
          "line_type": "p",
          "text": "اما هر دوی آنان، یعنی مَحلون و کِلیون نیز جان سپردند. بدین‌سان آن زن بدون شوهر و دو پسرش باقی ماند."
        },
        {
          "verse": 6,
          "usfm": "RUT.1.6",
          "line_type": "p",
          "text": "پس نَعومی با عروسانش برخاست تا از دیار موآب بازگردد، زیرا در دیار موآب شنیده بود که خداوند به یاری قوم آمده و بدانها خوراک داده است."
        },
        {
          "verse": 7,
          "usfm": "RUT.1.7",
          "line_type": "p",
          "text": "او با دو عروسش از مکانی که در آن ساکن بود، روانه شد تا به سرزمین یهودا بازگردد."
        },
        {
          "verse": 8,
          "usfm": "RUT.1.8",
          "line_type": "p",
          "text": "اما نَعومی به دو عروس خود گفت: «بروید؛ هر یک از شما به خانۀ مادری خویش بازگردید. خداوند بر شما احسان کند، چنانکه شما بر آن مردگان و بر من احسان کردید."
        },
        {
          "verse": 9,
          "usfm": "RUT.1.9",
          "line_type": "p",
          "text": "خداوند عطا کند که هر یک از شما در خانۀ شوهر خود آسایش یابید!» آنگاه ایشان را بوسید. آنان به صدای بلند گریستند"
        },
        {
          "verse": 10,
          "usfm": "RUT.1.10",
          "line_type": "p",
          "text": "و به او گفتند: «به‌یقین با تو نزد قومت بازمی‌گردیم.»"
        },
        {
          "verse": 11,
          "usfm": "RUT.1.11",
          "line_type": "p",
          "text": "ولی نَعومی گفت: «ای دخترانم، برگردید. چرا با من بیایید؟ آیا پسران دیگر در رحِم دارم تا برای شما شوهر باشند؟"
        },
        {
          "verse": 12,
          "usfm": "RUT.1.12",
          "line_type": "p",
          "text": "ای دخترانم، برگشته، راه خود را در پیش گیرید زیرا من برای شوهر کردن بسیار سالخورده‌ام. حتی اگر بگویم هنوز برایم امیدی هست، و همین امشب نیز به شوهر داده شوم و پسرانی هم بزایم،"
        },
        {
          "verse": 13,
          "usfm": "RUT.1.13",
          "line_type": "p",
          "text": "آیا تا بالغ شدن آنان منتظر خواهید ماند؟ آیا از شوهر کردن خودداری خواهید کرد؟ نه، دخترانم! زیرا جان من به‌خاطر شما بسیار تلخ شده است، چونکه دست خداوند بر ضد من دراز گشته است.»"
        },
        {
          "verse": 14,
          "usfm": "RUT.1.14",
          "line_type": "p",
          "text": "پس دیگر بار به صدای بلند گریستند و عُرپَه مادرشوهر خود را بوسید، اما روت به وی چسبید."
        },
        {
          "verse": 15,
          "usfm": "RUT.1.15",
          "line_type": "p",
          "text": "نَعومی گفت: «ببین، زنِ برادرشوهرت نزد قوم خود و خدایان خویش بازگشته است؛ تو نیز از پی جاری‌ات بازگرد.»"
        },
        {
          "verse": 16,
          "usfm": "RUT.1.16",
          "line_type": "p",
          "text": "اما روت پاسخ داد: «اصرار مکن که ترکت کنم و از نزدت بازگردم. هر جا که بروی، می‌آیم، و هر جا که منزل کنی، منزل می‌کنم. قوم تو قوم من و خدای تو خدای من خواهد بود."
        },
        {
          "verse": 17,
          "usfm": "RUT.1.17",
          "line_type": "p",
          "text": "هر جا که بمیری، می‌میرم و همان جا دفن می‌شوم. خداوند مرا سخت مجازات کند اگر حتی مرگ مرا از تو جدا سازد.»"
        },
        {
          "verse": 18,
          "usfm": "RUT.1.18",
          "line_type": "p",
          "text": "چون نَعومی دید که روت مصمم به رفتن با اوست، دیگر هیچ نگفت."
        },
        {
          "verse": 19,
          "usfm": "RUT.1.19",
          "line_type": "p",
          "text": "پس هر دو روانه شدند تا اینکه به بِیت‌لِحِم رسیدند. و چون به بِیت‌لِحِم درآمدند، تمامی شهر به سبب ایشان به حرکت آمد، و زنان می‌پرسیدند: «آیا این نَعومی است؟»"
        },
        {
          "verse": 20,
          "usfm": "RUT.1.20",
          "line_type": "p",
          "text": "نَعومی ایشان را گفت: «دیگر مرا نه نَعومی بلکه مارا بخوانید، زیرا قادرمطلق به من مرارت بسیار رسانیده است."
        },
        {
          "verse": 21,
          "usfm": "RUT.1.21",
          "line_type": "p",
          "text": "من پُر بیرون رفتم، اما خداوند مرا خالی بازگردانید. چرا مرا نَعومی بخوانید حال آنکه خداوند مرا ذلیل ساخته و قادرمطلق به مصیبت گرفتارم کرده است؟»"
        },
        {
          "verse": 22,
          "usfm": "RUT.1.22",
          "line_type": "p",
          "text": "بدین‌سان نَعومی بازگشت و عروسش، روتِ موآبی، که از دیار موآب بازگشته بود، همراه وی آمد. و ایشان در آغاز موسم درویدن جو به بِیت‌لِحِم رسیدند."
        }
      ],
      "verse_count": 22,
