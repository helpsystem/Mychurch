    {
      "schema_version": 6,
      "book_id": "RUT",
      "chapter": 3,
      "chapter_usfm": "RUT.3",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "RUT.3.1",
          "line_type": "p",
          "text": "روزی نَعومی، مادرشوهر روت، وی را گفت: «دخترم، آیا به جهت تو آسایش نجویم تا برایت نیکو شود؟"
        },
        {
          "verse": 2,
          "usfm": "RUT.3.2",
          "line_type": "p",
          "text": "آیا بوعَز که تو با کنیزانش بودی، خویشِ ما نیست؟ اینک او امشب در خرمنگاه، به پاک کردن جو مشغول خواهد بود."
        },
        {
          "verse": 3,
          "usfm": "RUT.3.3",
          "line_type": "p",
          "text": "پس شستشو کرده، به خود عطر بزن و جامه‌ات را در بر کرده، به خرمنگاه برو، اما تا آن مرد از خوردن و نوشیدن فارغ نشده، خود را به او نشناسان."
        },
        {
          "verse": 4,
          "usfm": "RUT.3.4",
          "line_type": "p",
          "text": "وقتی او دراز می‌کشد، جایگاه خوابش را نشان کن. سپس برو و پوشش پایش را کنار بزن و همان‌جا دراز بکش و او به تو خواهد گفت که چه بکنی.»"
        },
        {
          "verse": 5,
          "usfm": "RUT.3.5",
          "line_type": "p",
          "text": "روت پاسخ داد: «هرآنچه گفتی، خواهم کرد.»"
        },
        {
          "verse": 6,
          "usfm": "RUT.3.6",
          "line_type": "p",
          "text": "پس به خرمنگاه رفت و مطابق هرآنچه مادرشوهرش به او امر فرموده بود، به عمل آورد."
        },
        {
          "verse": 7,
          "usfm": "RUT.3.7",
          "line_type": "p",
          "text": "چون بوعَز خورد و نوشید و دلش شادمان شد، رفت تا در انتهای پشتۀ غَله بخوابد. آنگاه روت آهسته آمده، پوشش پاهای بوعز را کنار زد و همان‌جا خوابید."
        },
        {
          "verse": 8,
          "usfm": "RUT.3.8",
          "line_type": "p",
          "text": "نیمه‌های شب، بوعَز از خواب پرید و چون به سوی برگشت دید که اینک زنی نزد پاهایش خوابیده است!"
        },
        {
          "verse": 9,
          "usfm": "RUT.3.9",
          "line_type": "p",
          "text": "گفت: «تو کیستی؟» روت گفت: «کنیزت روت هستم. بالهای خود را بر کنیزت بگستران زیرا که تو ولیّ هستی.»"
        },
        {
          "verse": 10,
          "usfm": "RUT.3.10",
          "line_type": "p",
          "text": "بوعَز گفت: «دخترم، خداوند تو را برکت دهد! این محبت آخر تو از نخستین بهتر است، چرا‌که از پی مردان جوان، چه فقیر و چه غنی، نرفتی."
        },
        {
          "verse": 11,
          "usfm": "RUT.3.11",
          "line_type": "p",
          "text": "پس اکنون، ای دخترم، ترسان مباش. هرآنچه گفتی برایت خواهم کرد؛ زیرا همۀ همشهریان من می‌دانند که تو زنی شایسته‌ای."
        },
        {
          "verse": 12,
          "usfm": "RUT.3.12",
          "line_type": "p",
          "text": "حال هرچند راست است که من ولیّ تو هستم، اما ولیّ نزدیکتر از من نیز هست."
        },
        {
          "verse": 13,
          "usfm": "RUT.3.13",
          "line_type": "p",
          "text": "امشب اینجا بمان، و بامدادان اگر او حق ولیّ را به تو ادا کرد، چه خوب، بگذار ادا کند. اما اگر نخواست ادا کند، آنگاه به حیات خداوند سوگند که من آن را ادا خواهم کرد. اکنون تا صبح همین‌جا بخواب.»"
        },
        {
          "verse": 14,
          "usfm": "RUT.3.14",
          "line_type": "p",
          "text": "پس روت تا صبح نزد پاهای او خوابید، اما پیش از آنکه کسی قادر به تشخیص دیگری باشد برخاست، زیرا بوعَز گفت: «کسی نفهمد زنی به خرمنگاه آمده است.»"
        },
        {
          "verse": 15,
          "usfm": "RUT.3.15",
          "line_type": "p",
          "text": "او همچنین گفت: «چارقدی را که بر توست، بیاور و بر دستانت بگیر.» پس روت چارقدِ خود را به دست گرفت و او شش پیمانه جو پیمود و بر وی نهاد. آنگاه او به شهر رفت."
        },
        {
          "verse": 16,
          "usfm": "RUT.3.16",
          "line_type": "p",
          "text": "چون نزد مادرشوهر خود آمد، او پرسید: «دخترم، بر تو چه گذشت؟» پس او را از هرآنچه آن مرد برایش کرده بود، خبر داد"
        },
        {
          "verse": 17,
          "usfm": "RUT.3.17",
          "line_type": "p",
          "text": "و گفت: «او این شش پیمانه جو را به من داد، زیرا گفت: ”دستِ خالی نزد مادرشوهرت بازمگرد.“»"
        },
        {
          "verse": 18,
          "usfm": "RUT.3.18",
          "line_type": "p",
          "text": "نَعومی پاسخ داد: «دخترم، آرام بنشین تا بدانی که این امر چگونه خواهد شد، زیرا آن مرد تا این کار را امروز تمام نکند، آرام نخواهد گرفت.»"
        }
      ],
      "verse_count": 18,
