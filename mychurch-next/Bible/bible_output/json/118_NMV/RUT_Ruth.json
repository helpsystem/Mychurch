    {
      "schema_version": 6,
      "book_id": "RUT",
      "chapter": 2,
      "chapter_usfm": "RUT.2",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "RUT.2.1",
          "line_type": "p",
          "text": "و اما نَعومی خویشاوندی از طرف شوهر داشت بوعَز نام که مردی بود سرشناس از خاندان اِلیمِلِک."
        },
        {
          "verse": 2,
          "usfm": "RUT.2.2",
          "line_type": "p",
          "text": "روزی روتِ موآبی به نَعومی گفت: «رخصت ده تا به کشتزارها بروم و در پسِ هر کس که بر من نظر لطف افکَنَد، خوشه‌چینی کنم.» نَعومی پاسخ داد: «برو، دخترم.»"
        },
        {
          "verse": 3,
          "usfm": "RUT.2.3",
          "line_type": "p",
          "text": "پس روانه شده، به کشتزار رفت و در پسِ دروگران به خوشه‌چینی مشغول شد. از قضا به قسمتی از کشتزار درآمد که متعلق به بوعَز، از خاندان اِلیمِلِک بود."
        },
        {
          "verse": 4,
          "usfm": "RUT.2.4",
          "line_type": "p",
          "text": "هان بوعَز از بِیت‌لِحِم آمد و به دروگران گفت: «خداوند با شما باد!» پاسخ دادند: «خداوند تو را برکت دهد!»"
        },
        {
          "verse": 5,
          "usfm": "RUT.2.5",
          "line_type": "p",
          "text": "آنگاه بوعَز از خادمی که بر دروگران گماشته شده بود، پرسید: «این زن جوان از آنِ کیست؟»"
        },
        {
          "verse": 6,
          "usfm": "RUT.2.6",
          "line_type": "p",
          "text": "خادمی که بر دروگران گماشته شده بود، پاسخ داد: «این همان زن جوان موآبی است که با نَعومی از دیار موآب بازگشته است."
        },
        {
          "verse": 7,
          "usfm": "RUT.2.7",
          "line_type": "p",
          "text": "او مرا گفت، ”تمنا اینکه رخصت دهی خوشه‌چینی کنم و در پس دروگران در میان بافه‌ها جمع نمایم.“ پس آمده، از صبح تا به حال بی‌وقفه به کار مشغول بوده و فقط اندکی در خانه استراحت کرده است.»"
        },
        {
          "verse": 8,
          "usfm": "RUT.2.8",
          "line_type": "p",
          "text": "آنگاه بوعَز به روت گفت: «دخترم، گوش فرا ده. به کشتزار دیگری برای خوشه‌چینی مرو و اینجا را ترک مکن، بلکه همین‌جا با کنیزان من بمان."
        },
        {
          "verse": 9,
          "usfm": "RUT.2.9",
          "line_type": "p",
          "text": "چشمانت بر کشتزاری باشد که در آن درو می‌کنند و از پسِ ایشان برو. جوانان را امر کرده‌ام که تو را لمس نکنند. و هرگاه تشنه شدی، نزد کوزه‌ها برو و از آبی که جوانان می‌کِشند، بنوش.»"
        },
        {
          "verse": 10,
          "usfm": "RUT.2.10",
          "line_type": "p",
          "text": "روت به روی درافتاده، تا به زمین خم شد و از وی پرسید: «از چه سبب در نظرتان التفات یافتم که به من توجه کردید، حال آنکه غریبی بیش نیستم؟»"
        },
        {
          "verse": 11,
          "usfm": "RUT.2.11",
          "line_type": "p",
          "text": "بوعَز پاسخ داد: «هرآنچه پس از مرگ شوهر خود در حق مادرشوهرت کرده‌ای، به‌تمامی به آگاهی من رسیده است، اینکه چگونه پدر و مادر و زادگاهت را ترک گفته، نزد قومی آمدی که پیشتر نمی‌شناختی."
        },
        {
          "verse": 12,
          "usfm": "RUT.2.12",
          "line_type": "p",
          "text": "خداوند تو را به سبب آنچه کرده‌ای پاداش دهد، و اجر کامل از جانب یهوه خدای اسرائیل که زیر بالهایش پناه گرفته‌ای، به تو برسد.»"
        },
        {
          "verse": 13,
          "usfm": "RUT.2.13",
          "line_type": "p",
          "text": "آنگاه روت گفت: «ای سرورم، باشد که در نظرتان التفات یابم، زیرا تسلی‌ام دادید و به مهربانی با کنیزتان سخن گفتید، اگرچه مانند یکی از کنیزانتان هم نیستم.»"
        },
        {
          "verse": 14,
          "usfm": "RUT.2.14",
          "line_type": "p",
          "text": "به هنگام صرف غذا، بوعَز وی را گفت: «اینجا بیا و قدری نان بخور و لقمه‌ات را در سرکه فرو بَر.» پس روت کنار دروگران نشست و بوعَز به او غَلۀ برشته داد. او خورده سیر شد و اندکی هم اضافه آورد."
        },
        {
          "verse": 15,
          "usfm": "RUT.2.15",
          "line_type": "p",
          "text": "چون برای خوشه‌چینی برخاست، بوعَز خادمانش را امر فرموده، گفت: «بگذارید از میان بافه‌ها نیز خوشه برچیند و او را خجل مسازید."
        },
        {
          "verse": 16,
          "usfm": "RUT.2.16",
          "line_type": "p",
          "text": "همچنین قدری از میان دسته‌ها برایش بیرون کشیده، بگذارید از آن برچیند و توبیخش مکنید.»"
        },
        {
          "verse": 17,
          "usfm": "RUT.2.17",
          "line_type": "p",
          "text": "پس روت تا شامگاه در کشتزار خوشه‌چینی کرد. و آنچه را برچیده بود، کوبید، که در حدود یک ایفَه جو بود."
        },
        {
          "verse": 18,
          "usfm": "RUT.2.18",
          "line_type": "p",
          "text": "پس آن را برگرفته، به شهر درآمد و مادرشوهرش آنچه را برچیده بود، دید. و روت آنچه را که پس از سیر شدنش باقی مانده بود، بیرون آورده، به وی داد."
        },
        {
          "verse": 19,
          "usfm": "RUT.2.19",
          "line_type": "p",
          "text": "مادرشوهرش از او پرسید: «امروز کجا خوشه‌چینی کردی؟ کجا کار کردی؟ مبارک باد آن که به تو توجه کرده است.» پس روت به مادرشوهرش گفت نزد چه کسی کار کرده است و افزود: «نام مردی که امروز نزد او کار کردم، بوعَز است.»"
        },
        {
          "verse": 20,
          "usfm": "RUT.2.20",
          "line_type": "p",
          "text": "نَعومی به عروسش گفت: «مبارک باد او، از جانب خداوندی که محبت خود را نسبت به زندگان و مردگان ترک نکرده است!» نیز گفت: «آن مرد خویشاوند نزدیک و از ولیّ‌های ماست.»"
        },
        {
          "verse": 21,
          "usfm": "RUT.2.21",
          "line_type": "p",
          "text": "روت موآبی گفت: «او همچنین مرا گفت، ”با خادمان من بمان تا زمانی که تمام محصول مرا درو کنند.“»"
        },
        {
          "verse": 22,
          "usfm": "RUT.2.22",
          "line_type": "p",
          "text": "پس نَعومی به عروسش روت گفت: «دخترم، خوب است با کنیزان او بیرون روی، مبادا در کشتزاری دیگر گزندی به تو برسد.»"
        },
        {
          "verse": 23,
          "usfm": "RUT.2.23",
          "line_type": "p",
          "text": "بدین‌گونه روت تا پایان دروِ جو و گندم با کنیزان بوعَز ماند تا خوشه‌چینی کند، و با مادرشوهرش زندگی می‌کرد."
        }
      ],
