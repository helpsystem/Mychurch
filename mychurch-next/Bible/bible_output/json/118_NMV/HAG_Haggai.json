    {
      "schema_version": 6,
      "book_id": "HAG",
      "chapter": 2,
      "chapter_usfm": "HAG.2",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAG.2.1",
          "line_type": "p",
          "text": "در روز بیست و یکم از ماه هفتم، کلام خداوند به واسطۀ حَجَّی نبی نازل شده، گفت:"
        },
        {
          "verse": 2,
          "usfm": "HAG.2.2",
          "line_type": "p",
          "text": "«اکنون با زَروبابِل فرزند شِئَلتیئیل، فرماندار یهودا، یِهوشَع فرزند یِهوصاداق، کاهن اعظم، و نیز با تمامی باقیماندگان قوم سخن بگو و از ایشان بپرس:"
        },
        {
          "verse": 3,
          "usfm": "HAG.2.3",
          "line_type": "p",
          "text": "”کیست از میان شما باقیماندگان که این خانه را در جلال نخستینش دیده باشد؟ اکنون آن را چگونه می‌بینید؟ آیا در نظرتان چون هیچ نمی‌نماید؟"
        },
        {
          "verse": 4,
          "usfm": "HAG.2.4",
          "line_type": "p",
          "text": "«”اما اکنون خداوند می‌فرماید: ای زَروبابِل، قوی باش! ای یِهوشَع فرزند یِهوصاداق، کاهن اعظم، قوی باش! و ای همۀ قومِ این سرزمین، قوی باشید؛ این است فرمودۀ خداوند. خداوند لشکرها می‌گوید: به کار مشغول شوید، زیرا من با شما هستم،"
        },
        {
          "verse": 5,
          "usfm": "HAG.2.5",
          "line_type": "p",
          "text": "بر حسب عهدی که به هنگام خروجتان از مصر با شما بستم. روح من در میان شما باقی است، پس هراسان مباشید."
        },
        {
          "verse": 6,
          "usfm": "HAG.2.6",
          "line_type": "p",
          "text": "زیرا خداوند لشکرها چنین می‌گوید: یک بار دیگر، پس از اندک زمانی، آسمانها و زمین و دریا و خشکی را به لرزه در خواهم آورد."
        },
        {
          "verse": 7,
          "usfm": "HAG.2.7",
          "line_type": "p",
          "text": "و نیز همۀ قومها را خواهم لرزانید، و گنجینه‌های تمامی قومها بدین‌جا در خواهد آمد. و خداوند لشکرها می‌گوید: من این خانه را از جلال پر خواهم ساخت."
        },
        {
          "verse": 8,
          "usfm": "HAG.2.8",
          "line_type": "p",
          "text": "«”خداوند لشکرها می‌فرماید: طلا و نقره از آن من است."
        },
        {
          "verse": 9,
          "usfm": "HAG.2.9",
          "line_type": "p",
          "text": "خداوند لشکرها می‌گوید: جلال این خانه از جلال خانۀ پیشین عظیمتر خواهد بود، و من در این مکان، سلامتی ارزانی خواهم داشت؛ این است فرمودۀ خداوند لشکرها.“»"
        },
        {
          "verse": 10,
          "usfm": "HAG.2.10",
          "line_type": "p",
          "text": "در دوّمین سال داریوش، در روز بیست و چهارم از ماه نهم، کلام خداوند به واسطۀ حَجَّی نبی نازل شده، گفت:"
        },
        {
          "verse": 11,
          "usfm": "HAG.2.11",
          "line_type": "p",
          "text": "«خداوند لشکرها چنین می‌فرماید: از کاهنان دربارۀ شریعت پرسیده، بگویید:"
        },
        {
          "verse": 12,
          "usfm": "HAG.2.12",
          "line_type": "p",
          "text": "”اگر کسی گوشت مقدس را در دامن جامۀ خود حمل کند، و آنگاه دامن جامه‌اش به نان، آش، شراب، روغن، یا هر خوراک دیگری برخورَد، آیا آن خوراک مقدس می‌شود؟“» کاهنان پاسخ دادند: «خیر.»"
        },
        {
          "verse": 13,
          "usfm": "HAG.2.13",
          "line_type": "p",
          "text": "آنگاه حَجَّی گفت: «اگر کسی که به سبب تماس با جنازه‌ای نجس شده است یکی از آن خوراکها را لمس کند، آیا آن خوراک نجس می‌شود؟» کاهنان در پاسخ گفتند: «آری، نجس می‌شود.»"
        },
        {
          "verse": 14,
          "usfm": "HAG.2.14",
          "line_type": "p",
          "text": "آنگاه حَجَّی در جواب گفت: «خداوند می‌فرماید، این قوم نیز چنین‌اند و این ملت نیز در نظر من بدین‌گونه‌اند، و عمل دستهایشان جملگی چنین است. هر هدیه‌ای که بدان‌جا می‌آورند، نجس است."
        },
        {
          "verse": 15,
          "usfm": "HAG.2.15",
          "line_type": "p",
          "text": "به ایام اخیر نیک بیندیشید: از پیش از نهاده شدن سنگی بر سنگِ دیگر در معبد خداوند تا کنون،"
        },
        {
          "verse": 16,
          "usfm": "HAG.2.16",
          "line_type": "p",
          "text": "در تمامی این ایام، چون کسی سراغ پشتۀ خرمنِ بیست مَنی می‌آمد، تنها ده مَن می‌یافت؛ و چون کسی نزد حوضچۀ شراب می‌رفت تا پنجاه پیمانه از آن برگیرد، تنها بیست پیمانه می‌یافت."
        },
        {
          "verse": 17,
          "usfm": "HAG.2.17",
          "line_type": "p",
          "text": "خداوند می‌فرماید: من شما و تمامی دسترنجتان را به باد سوزان و کپک و تگرگ زدم، اما نزد من بازگشت نکردید!"
        },
        {
          "verse": 18,
          "usfm": "HAG.2.18",
          "line_type": "p",
          "text": "به ایام اخیر نیک بیندیشید؛ آری، از روز نهاده شدن پی خانۀ خداوند تا روز بیست و چهارم ماه نهم را از نظر بگذرانید:"
        },
        {
          "verse": 19,
          "usfm": "HAG.2.19",
          "line_type": "p",
          "text": "آیا هنوز بذری در انبار هست؟ براستی که درختان مو و انجیر و انار و زیتون هیچ میوه نداده‌اند؛ ولی من از امروز شما را برکت خواهم داد!»"
        },
        {
          "verse": 20,
          "usfm": "HAG.2.20",
          "line_type": "p",
          "text": "و کلام خداوند بار دوّم، در بیست و چهارمین روزِ ماه، بر حَجَّی نازل شده، گفت:"
        },
        {
          "verse": 21,
          "usfm": "HAG.2.21",
          "line_type": "p",
          "text": "«زَروبابِل، فرماندار یهودا را خطاب کرده، بگو که من به‌زودی آسمانها و زمین را به لرزه در خواهم آورد،"
        },
        {
          "verse": 22,
          "usfm": "HAG.2.22",
          "line_type": "p",
          "text": "و تخت پادشاهی ممالک را واژگون خواهم ساخت. به‌زودی قدرت ممالکِ قومها را از میان خواهم برد، ارابه‌ها و سوارانشان را سرنگون خواهم کرد، و اسبان و سوارانشان به شمشیر یکدیگر از پا در خواهند آمد."
        },
        {
          "verse": 23,
          "usfm": "HAG.2.23",
          "line_type": "p",
          "text": "«خداوند لشکرها می‌فرماید: در آن روز، ای خادم من زَروبابِل، فرزند شِئَلتیئیل، تو را بر خواهم گرفت، و خداوند می‌گوید که تو را چون انگشترِ مُهر خواهم ساخت، زیرا که تو را برگزیده‌ام؛» این است فرمودۀ خداوند لشکرها."
        }
      ],
      "verse_count": 23,
      "headings": [
