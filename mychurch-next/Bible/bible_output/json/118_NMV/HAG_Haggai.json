    {
      "schema_version": 6,
      "book_id": "HAG",
      "chapter": 1,
      "chapter_usfm": "HAG.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAG.1.1",
          "line_type": "p",
          "text": "در سال دوّم داریوش پادشاه، در نخستین روز از ماه ششم، کلام خداوند به واسطۀ حَجَّی نبی به زَروبابِل فرزند شِئَلتیئیل، فرماندار یهودا، و نیز به یِهوشَع فرزند یِهوصاداق، کاهن اعظم رسید:"
        },
        {
          "verse": 2,
          "usfm": "HAG.1.2",
          "line_type": "p",
          "text": "«خداوند لشکرها چنین می‌فرماید: این قوم می‌گویند هنوز زمان بازسازی خانۀ خداوند فرا نرسیده است.»"
        },
        {
          "verse": 3,
          "usfm": "HAG.1.3",
          "line_type": "p",
          "text": "آنگاه کلام خداوند به واسطۀ حَجَّی نبی نازل شده، گفت:"
        },
        {
          "verse": 4,
          "usfm": "HAG.1.4",
          "line_type": "p",
          "text": "«آیا اکنون زمان آن است که خود در خانه‌های مُجلل‌خویش ساکن شوید و این خانه ویران بماند؟"
        },
        {
          "verse": 5,
          "usfm": "HAG.1.5",
          "line_type": "p",
          "text": "پس حال خداوندِ لشکرها چنین می‌گوید: به راههای خویش نیک بیندیشید!"
        },
        {
          "verse": 6,
          "usfm": "HAG.1.6",
          "line_type": "p",
          "text": "بسیار کاشته‌اید، ولی کم درویده‌اید؛ می‌خورید، اما هرگز سیر نمی‌شوید؛ می‌نوشید، اما هرگز سیراب نمی‌گردید؛ می‌پوشید، اما گرم نمی‌شوید؛ و آن که مزد می‌گیرد، مزد خود را در کیسۀ سوراخ می‌نهد!"
        },
        {
          "verse": 7,
          "usfm": "HAG.1.7",
          "line_type": "p",
          "text": "«خداوندِ لشکرها چنین می‌فرماید: به راههای خویش نیک بیندیشید!"
        },
        {
          "verse": 8,
          "usfm": "HAG.1.8",
          "line_type": "p",
          "text": "بر فراز کوهها برآمده، چوب بیاورید و این خانه را بنا کنید، تا از آن خشنود شوم و جلال یابم. این است فرمودۀ خداوند."
        },
        {
          "verse": 9,
          "usfm": "HAG.1.9",
          "line_type": "p",
          "text": "بیش از اینها انتظار داشتید، اما بنگرید که چه اندک حاصل آمد. و آنگاه که همان اندک را به منزل بردید، بر آن دمیدم و بر باد شد. چرا؟ خداوند لشکرها می‌فرماید: به سبب خانۀ من که ویران مانده است، در حالی که شما هر یک به خانۀ خویش مشغولید!"
        },
        {
          "verse": 10,
          "usfm": "HAG.1.10",
          "line_type": "p",
          "text": "از این رو، آسمانها بر فرازتان شبنم را بازداشته‌اند، و زمین نیز محصول خویش را."
        },
        {
          "verse": 11,
          "usfm": "HAG.1.11",
          "line_type": "p",
          "text": "و من بر زمینها و کوهها خشکسالی فراخوانده‌ام، و نیز بر غلّه و شراب تازه و روغن و بر هر چه زمین می‌رویانَد، و بر انسان و حیوان، و بر تمامی محنت دستها.»"
        },
        {
          "verse": 12,
          "usfm": "HAG.1.12",
          "line_type": "p",
          "text": "آنگاه زَروبابِل فرزند شِئَلتیئیل و یِهوشَع فرزند یِهوصاداق، کاهن اعظم، و تمامی باقیماندگان قوم به صدای یهوه خدای خویش گوش فرا دادند، و به سخنان حَجَّی نبی نیز، زیرا که او را یهوه خدایشان فرستاده بود. و قوم از خداوند ترسیدند."
        },
        {
          "verse": 13,
          "usfm": "HAG.1.13",
          "line_type": "p",
          "text": "آنگاه حَجَّی، پیام‌آور خداوند، پیام خداوند را به قوم بیان کرده، گفت: «خداوند می‌فرماید: من با شما هستم.»"
        },
        {
          "verse": 14,
          "usfm": "HAG.1.14",
          "line_type": "p",
          "text": "و خداوند روحِ زَروبابِل فرزند شِئَلتیئیل فرماندار یهودا، و روحِ یِهوشَع فرزند یِهوصاداق کاهن اعظم، و روح تمامی باقیماندگان قوم را برانگیخت. و آنان آمده، به کار بر روی خانۀ یهوه خدای خویش، خدای لشکرها، پرداختند."
        },
        {
          "verse": 15,
          "usfm": "HAG.1.15",
          "line_type": "p",
          "text": "این در دوّمین سال داریوش پادشاه، در روز بیست و چهارم از ماه ششم، رخ داد."
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 12,
          "text": "اطاعت از فرمان خداوند"
        }
      ],
