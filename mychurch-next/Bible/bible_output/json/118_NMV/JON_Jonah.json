    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 4,
      "chapter_usfm": "JON.4",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.4.1",
          "line_type": "p",
          "text": "اما این در نظر یونس بسیار بد آمد و خشمش افروخته شده،"
        },
        {
          "verse": 2,
          "usfm": "JON.4.2",
          "line_type": "p",
          "text": "به درگاه خداوند دعا کرده، گفت: «ای خداوند، آیا همین نبود سخن من، آنگاه که هنوز در ولایت خود بودم؟ از همین رو، شتابان به تَرشیش گریختم. می‌دانستم تو خدایی هستی فیّاض و رحیم و دیرخشم، که محبتت را پایانی نیست و از فرستادن بلا منصرف می‌شوی."
        },
        {
          "verse": 3,
          "usfm": "JON.4.3",
          "line_type": "p",
          "text": "اکنون ای خداوند، جانم را بستان که مردن برایم بهتر از زیستن است.»"
        },
        {
          "verse": 4,
          "usfm": "JON.4.4",
          "line_type": "p",
          "text": "اما خداوند پاسخ داد: «آیا رواست که خشمگین شوی؟»"
        },
        {
          "verse": 5,
          "usfm": "JON.4.5",
          "line_type": "p",
          "text": "آنگاه یونس از شهر بیرون رفت و جایی در شرق شهر بر زمین نشست. در آنجا برای خود سایه‌بانی ساخت و زیر سایه‌اش نشست تا ببیند بر سر شهر چه می‌آید."
        },
        {
          "verse": 6,
          "usfm": "JON.4.6",
          "line_type": "p",
          "text": "آنگاه یهوه خدا، گیاهی برگماشت و آن را تا بالای سر یونس نمو داد تا بر او سایه افکَنَد و از ناخشنودی او اندکی بکاهد. یونس از بابت آن گیاه بسیار شادمان شد."
        },
        {
          "verse": 7,
          "usfm": "JON.4.7",
          "line_type": "p",
          "text": "اما سپیده‌دمِ روز بعد، خدا کِرمی برگماشت که گیاه را زد، و خشک شد."
        },
        {
          "verse": 8,
          "usfm": "JON.4.8",
          "line_type": "p",
          "text": "چون خورشید برآمد، خدا بادی سوزان از جانب شرق برگماشت و آفتاب چنان بر سر یونس تابید که بی‌تاب شد و آرزوی مرگ کرده، گفت: «مردن برایم بهتر از زیستن است.»"
        },
        {
          "verse": 9,
          "usfm": "JON.4.9",
          "line_type": "p",
          "text": "آنگاه خدا به یونس گفت: «آیا رواست که به‌خاطر گیاهی خشمگین شوی؟» یونس گفت: «آری، رواست که تا به مرگ خشمگین شوم.»"
        },
        {
          "verse": 10,
          "usfm": "JON.4.10",
          "line_type": "p",
          "text": "خداوند گفت: «تو بر گیاهی که محنتی برایش نبردی و آن را نرویانیدی، دل سوزاندی، گیاهی که شبی سر برکشید و شبی دیگر پژمرد."
        },
        {
          "verse": 11,
          "usfm": "JON.4.11",
          "line_type": "p",
          "text": "پس من چگونه می‌توانم بر نینوا دل نسوزانم، بر آن شهر بزرگ با بیش از یکصد و بیست هزار جمعیت که دست راست و چپ خویش از هم تشخیص نمی‌دهند، با حیوانات بسیار؟»"
        }
      ],
