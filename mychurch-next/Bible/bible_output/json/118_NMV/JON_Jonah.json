  "chapters": [
    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 1,
      "chapter_usfm": "JON.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.1.1",
          "line_type": "p",
          "text": "کلام خداوند بر یونس پسر اَمِتّای نازل شده، گفت:"
        },
        {
          "verse": 2,
          "usfm": "JON.1.2",
          "line_type": "p",
          "text": "«برخیز و به نینوا، آن شهر بزرگ برو و بر ضد آن فریاد برآور، زیرا شرارت آن به حضور من سر برکشیده است.»"
        },
        {
          "verse": 3,
          "usfm": "JON.1.3",
          "line_type": "p",
          "text": "اما یونس برخاست تا از حضور خداوند به تَرشیش بگریزد! پس به یافا فرود آمد. در آنجا کشتی‌ای یافت که عازم تَرشیش بود. کرایه‌اش را داد و سوار شد تا همراه ایشان از حضور خداوند به تَرشیش بگریزد."
        },
        {
          "verse": 4,
          "usfm": "JON.1.4",
          "line_type": "p",
          "text": "اما خداوند بادی شدید بر دریا وزانید، و چنان توفانی عظیم برخاست که چیزی نمانده بود کشتی در هم بشکند."
        },
        {
          "verse": 5,
          "usfm": "JON.1.5",
          "line_type": "p",
          "text": "ملوانان به وحشت افتادند و هریک نزد خدای خویش فریاد برآوردند. آنها بار کشتی را به دریا ریختند تا آن را سبک کنند. اما پیش از این، یونس به اندرون کشتی فرود شده و دراز کشیده بود، و در خوابی سنگین بود."
        },
        {
          "verse": 6,
          "usfm": "JON.1.6",
          "line_type": "p",
          "text": "ناخدای کشتی نزد او رفت و گفت: «چگونه می‌توانی راحت بخوابی؟ برخیز و خدایت را بخوان، شاید آن خدا بر ما نظر کند و هلاک نشویم.»"
        },
        {
          "verse": 7,
          "usfm": "JON.1.7",
          "line_type": "p",
          "text": "آنگاه ملوانان به یکدیگر گفتند: «بیایید قرعه بیفکنیم تا دریابیم به سبب چه کسی این بلا بر ما نازل شده است.» پس چنین کردند و قرعه به نام یونس افتاد."
        },
        {
          "verse": 8,
          "usfm": "JON.1.8",
          "line_type": "p",
          "text": "بنابراین از او پرسیدند: «به ما بگو به سبب چه کسی این بلا بر ما نازل شده است؟ پیشه‌ات چیست؟ از کجا می‌آیی؟ سرزمینت کجاست؟ از کدامین قوم هستی؟»"
        },
        {
          "verse": 9,
          "usfm": "JON.1.9",
          "line_type": "p",
          "text": "یونس پاسخ داد: «من عبرانی هستم و ترس یهوه، خدای آسمان را به دل دارم، همان که دریا و خشکی را آفرید.»"
        },
        {
          "verse": 10,
          "usfm": "JON.1.10",
          "line_type": "p",
          "text": "آن مردان سخت به وحشت افتادند و از او پرسیدند: «این چه کاری است که کرده‌ای؟» زیرا می‌دانستند از حضور خداوند می‌گریزد، چراکه خود پیشتر بدیشان گفته بود."
        },
        {
          "verse": 11,
          "usfm": "JON.1.11",
          "line_type": "p",
          "text": "دریا همچنان متلاطم و متلاطم‌تر می‌شد. پس از او پرسیدند: «با تو چه کنیم تا دریا بر ما آرام شود؟»"
        },
        {
          "verse": 12,
          "usfm": "JON.1.12",
          "line_type": "p",
          "text": "یونس گفت: «مرا برگرفته، به دریا افکنید تا دریا بر شما آرام شود. زیرا می‌دانم این توفان عظیم به سبب من بر شما نازل شده است.»"
        },
        {
          "verse": 13,
          "usfm": "JON.1.13",
          "line_type": "p",
          "text": "اما آن مردان سخت پارو زدند تا کشتی را به خشکی بازگردانند، ولی نتوانستند. زیرا دریا هر لحظه بر ضد آنها متلاطم و متلاطم‌تر می‌شد."
        },
        {
          "verse": 14,
          "usfm": "JON.1.14",
          "line_type": "p",
          "text": "پس به درگاه خداوند فریاد برآوردند که: «آه، ای خداوند، تمنا اینکه به سبب جان این شخص تلف نشویم. مگذار دست ما به خون بی‌گناهی آلوده شود. زیرا تو ای خداوند، هر چه بخواهی می‌کنی.»"
        },
        {
          "verse": 15,
          "usfm": "JON.1.15",
          "line_type": "p",
          "text": "آنگاه یونس را برگرفته، به دریا افکندند، و دریا از خروش خود آرام گرفت."
        },
        {
          "verse": 16,
          "usfm": "JON.1.16",
          "line_type": "p",
          "text": "آن مردان سخت از خداوند ترسیدند و قربانیها به او تقدیم کرده، برایش نذرها نمودند."
        },
        {
          "verse": 17,
          "usfm": "JON.1.17",
          "line_type": "p",
          "text": "آنگاه خداوند ماهی بزرگی برگماشت تا یونس را فرو بلعد. و یونس سه روز و سه شب در شکم ماهی بود."
        }
      ],
      "verse_count": 17,
