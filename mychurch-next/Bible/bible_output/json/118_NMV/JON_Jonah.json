    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 2,
      "chapter_usfm": "JON.2",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.2.1",
          "line_type": "p",
          "text": "و یونس از شکم ماهی نزد یهوه، خدای خود دعا کرد"
        },
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "line_type": "p",
          "text": "و گفت:«در تنگی خویش نزد خداوند فریاد برآوردمو او مرا مستجاب فرمود.از شکم هاویه فریاد کمک سر دادمو تو آواز مرا شنیدی."
        },
        {
          "verse": 3,
          "usfm": "JON.2.3",
          "line_type": "q1",
          "text": "مرا به ژرفا افکنده بودی،به قعر دریاها؛سیلابها مرا احاطه کرد،و همۀ موج و خیزابهایتمرا درنوردید."
        },
        {
          "verse": 4,
          "usfm": "JON.2.4",
          "line_type": "q1",
          "text": "گفتم: ”از چشم تو افتادم.چگونه دیگر‌بار بر قُدس تو خواهم نگریست؟“"
        },
        {
          "verse": 5,
          "usfm": "JON.2.5",
          "line_type": "q1",
          "text": "آبهای خروشان جانم را تهدید کرد،ژرفا مرا در میان گرفت؛خزه‌ها گِرد سرم تنید."
        },
        {
          "verse": 6,
          "usfm": "JON.2.6",
          "line_type": "q1",
          "text": "به بُنِ کوهها فرو رفتم،و زمین برای همیشه در بندم کشید.«اما تو حیاتم را از گور برکشیدی،تو ای یهوه، خدای من."
        },
        {
          "verse": 7,
          "usfm": "JON.2.7",
          "line_type": "q1",
          "text": "چون جانم در اندرونم بی‌هوش می‌شد،خداوند را یاد کردم؛دعایم به درگاه تو بلند شدو به معبد مقدس تو رسید."
        },
        {
          "verse": 8,
          "usfm": "JON.2.8",
          "line_type": "q1",
          "text": "آنان که بتهای بی‌ارزش را عبادت می‌کنند،وفاداری خویش را ترک می‌گویند."
        },
        {
          "verse": 9,
          "usfm": "JON.2.9",
          "line_type": "q1",
          "text": "اما من با آواز شکرگزاریبرای تو قربانی خواهم کرد،و نذرم را اَدا خواهم نمود.نجات از آن خداوند است.»"
        },
        {
          "verse": 10,
          "usfm": "JON.2.10",
          "line_type": "m",
          "text": "پس خداوند ماهی را امر فرمود، و ماهی یونس را بر زمین خشک قِی کرد."
        }
      ],
