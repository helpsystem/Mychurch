    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 3,
      "chapter_usfm": "COL.3",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.3.1",
          "line_type": "p",
          "text": "پس چون با مسیح برخیزانیده شده‌اید، آنچه را که در بالاست بجویید، آنجا که مسیح به دست راست خدا نشسته است."
        },
        {
          "verse": 2,
          "usfm": "COL.3.2",
          "line_type": "p",
          "text": "به آنچه در بالاست بیندیشید، نه به آنچه بر زمین است."
        },
        {
          "verse": 3,
          "usfm": "COL.3.3",
          "line_type": "p",
          "text": "زیرا مُردید و زندگی شما اکنون با مسیح در خدا پنهان است."
        },
        {
          "verse": 4,
          "usfm": "COL.3.4",
          "line_type": "p",
          "text": "چون مسیح که زندگی شماست، ظهور کند، آنگاه شما نیز همراه او با جلال ظاهر خواهید شد."
        },
        {
          "verse": 5,
          "usfm": "COL.3.5",
          "line_type": "p",
          "text": "پس، هرآنچه را در وجود شما زمینی است، بکُشید، یعنی بی‌عفتی، ناپاکی، هوی و هوس، امیال زشت و شهوت‌پرستی را که همان بت‌پرستی است."
        },
        {
          "verse": 6,
          "usfm": "COL.3.6",
          "line_type": "p",
          "text": "به سبب همینهاست که غضب خدا بر سرکشان نازل می‌شود."
        },
        {
          "verse": 7,
          "usfm": "COL.3.7",
          "line_type": "p",
          "text": "شما نیز در زندگی گذشتۀ خود به این راهها می‌رفتید."
        },
        {
          "verse": 8,
          "usfm": "COL.3.8",
          "line_type": "p",
          "text": "امّا اکنون باید همۀ اینها را از خود دور کنید، یعنی خشم، عصبانیت، بدخواهی، ناسزاگویی و سخنان زشت را از دهان خود."
        },
        {
          "verse": 9,
          "usfm": "COL.3.9",
          "line_type": "p",
          "text": "به یکدیگر دروغ مگویید، زیرا آن انسانِ قدیم را با کارهایش از تن به در آورده‌اید"
        },
        {
          "verse": 10,
          "usfm": "COL.3.10",
          "line_type": "p",
          "text": "و انسانِ جدید را در بر کرده‌اید، که در معرفتِ حقیقیْ هر آن نو می‌شود تا به صورت آفرینندۀ خویش در‌آید."
        },
        {
          "verse": 11,
          "usfm": "COL.3.11",
          "line_type": "p",
          "text": "در این انسانِ جدید، یونانی یا یهودی، ختنه‌شده یا ختنه‌ناشده، بَربَر یا سَکایی، غلام یا آزاد دیگر معنی ندارد، بلکه مسیح همه چیز و در همه است."
        },
        {
          "verse": 12,
          "usfm": "COL.3.12",
          "line_type": "p",
          "text": "پس همچون قوم برگزیدۀ خدا که مقدّس و بسیار محبوب است، خویشتن را به شفقت، مهربانی، فروتنی، ملایمت و صبر ملبس سازید."
        },
        {
          "verse": 13,
          "usfm": "COL.3.13",
          "line_type": "p",
          "text": "نسبت به یکدیگر بردبار باشید و چنانچه کسی نسبت به دیگری کدورتی دارد، او را ببخشاید. چنانکه خداوند شما را بخشود، شما نیز یکدیگر را ببخشایید."
        },
        {
          "verse": 14,
          "usfm": "COL.3.14",
          "line_type": "p",
          "text": "و بر روی همۀ اینها محبت را در بر کنید که همه چیز را به هم می‌پیوندد و شما را کامل می‌گرداند."
        },
        {
          "verse": 15,
          "usfm": "COL.3.15",
          "line_type": "p",
          "text": "صلح مسیح بر دلهایتان حکمفرما باشد، زیرا فرا خوانده شده‌اید تا چون اعضای یک بدن در صلح و صفا به سر برید، و شکرگزار باشید."
        },
        {
          "verse": 16,
          "usfm": "COL.3.16",
          "line_type": "p",
          "text": "کلام مسیح به دولتمندی در شما ساکن شود؛ و با مزامیر، سرودها و نغمه‌هایی که از روح است، با کمال حکمت یکدیگر را پند و تعلیم دهید؛ و با شکرگزاری و از صمیم دل برای خدا بسرایید."
        },
        {
          "verse": 17,
          "usfm": "COL.3.17",
          "line_type": "p",
          "text": "و هرآنچه کنید، چه در گفتار و چه در کردار، همه را به نام خداوندْ عیسی انجام دهید، و به واسطۀ او خدای پدر را شکر‌گزارید."
        },
        {
          "verse": 18,
          "usfm": "COL.3.18",
          "line_type": "p",
          "text": "ای زنان، تسلیم شوهران خود باشید، چنانکه در خداوند شایسته است."
        },
        {
          "verse": 19,
          "usfm": "COL.3.19",
          "line_type": "p",
          "text": "ای شوهران، زنان خود را محبت کنید و به آنان تندی روا مدارید."
        },
        {
          "verse": 20,
          "usfm": "COL.3.20",
          "line_type": "p",
          "text": "ای فرزندان، والدین خود را در هر امری اطاعت کنید، زیرا این خداوند را خشنود می‌سازد."
        },
        {
          "verse": 21,
          "usfm": "COL.3.21",
          "line_type": "p",
          "text": "ای پدران، فرزندان خویش را تلخکام مسازید، مبادا دلسرد شوند."
        },
        {
          "verse": 22,
          "usfm": "COL.3.22",
          "line_type": "p",
          "text": "ای غلامان، اربابان زمینی خویش را در هر امری اطاعت کنید، نه فقط آنگاه که مراقب شما هستند و یا برای جلب توجه‌شان، بلکه با اخلاص قلبی و به احترام خداوند مطیع باشید."
        },
        {
          "verse": 23,
          "usfm": "COL.3.23",
          "line_type": "p",
          "text": "هر کاری را از جان و دل چنان انجام دهید که گویی برای خداوند کار می‌کنید، نه برای انسان،"
        },
        {
          "verse": 24,
          "usfm": "COL.3.24",
          "line_type": "p",
          "text": "زیرا می‌دانید پاداشتان میراثی است که از خداوند خواهید یافت، چرا که در حقیقت خداوندْ مسیح را خدمت می‌کنید."
        },
        {
          "verse": 25,
          "usfm": "COL.3.25",
          "line_type": "p",
          "text": "هر کس بدی کند، سزای عمل بد خویش را خواهد دید و تبعیضی در کار نیست."
        }
      ],
      "verse_count": 25,
      "headings": [
