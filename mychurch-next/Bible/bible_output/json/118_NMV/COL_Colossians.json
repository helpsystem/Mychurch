    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 2,
      "chapter_usfm": "COL.2",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.2.1",
          "line_type": "p",
          "text": "پس می‌خواهم بدانید که به‌خاطر شما و کسانی که در لائودیکیه هستند، و برای همۀ آنان که روی مرا ندیده‌اند، چه مجاهده‌ای دارم،"
        },
        {
          "verse": 2,
          "usfm": "COL.2.2",
          "line_type": "p",
          "text": "تا دلگرم شده، در محبت متحد گردند، و از همۀ غنای فهم و درکی کامل برخوردار گشته، راز خدا یعنی مسیح را بشناسند،"
        },
        {
          "verse": 3,
          "usfm": "COL.2.3",
          "line_type": "p",
          "text": "که در او همۀ گنجهای حکمت و معرفت نهفته است."
        },
        {
          "verse": 4,
          "usfm": "COL.2.4",
          "line_type": "p",
          "text": "این را می‌گویم تا هیچ‌کس شما را با استدلالهای فریبنده گمراه نسازد."
        },
        {
          "verse": 5,
          "usfm": "COL.2.5",
          "line_type": "p",
          "text": "زیرا هرچند در جسم از شما دورم، لیکن در روح با شما هستم و از مشاهدۀ نظم و ایمان پایدارتان به مسیح شادمانم."
        },
        {
          "verse": 6,
          "usfm": "COL.2.6",
          "line_type": "p",
          "text": "پس همان‌گونه که مسیحْ عیسای خداوند را پذیرفتید، در او سلوک کنید:"
        },
        {
          "verse": 7,
          "usfm": "COL.2.7",
          "line_type": "p",
          "text": "در او ریشه گیرید و بنا شوید، و همان‌گونه که تعلیم یافتید، در ایمان استوار شده، لبریز از شکرگزاری باشید."
        },
        {
          "verse": 8,
          "usfm": "COL.2.8",
          "line_type": "p",
          "text": "به‌هوش باشید کسی شما را با فلسفه‌ای پوچ و فریبنده اسیر نسازد، که نه بر مسیح، بلکه بر سنّت آدمیان و اصول ابتدایی این دنیا استوار است."
        },
        {
          "verse": 9,
          "usfm": "COL.2.9",
          "line_type": "p",
          "text": "زیرا الوهیت با همۀ کمالش به صورت جسمانی در مسیح ساکن است،"
        },
        {
          "verse": 10,
          "usfm": "COL.2.10",
          "line_type": "p",
          "text": "و شما در او، که همۀ ریاستها و قدرتها را سَر است، از کمال برخوردار گشته‌اید."
        },
        {
          "verse": 11,
          "usfm": "COL.2.11",
          "line_type": "p",
          "text": "و در او ختنه نیز شده‌اید، به ختنه‌ای که با دست انجام نشده است. این ختنه همانا از تن به در آوردنِ شخصیت نفسانی است در ختنۀ مسیح."
        },
        {
          "verse": 12,
          "usfm": "COL.2.12",
          "line_type": "p",
          "text": "و در تعمید، با او مدفون گشتید و با ایمان به قدرت خدا که مسیح را از مردگان برخیزانید، با او برخیزانیده شدید."
        },
        {
          "verse": 13,
          "usfm": "COL.2.13",
          "line_type": "p",
          "text": "آن زمان که در گناهان و حالت ختنه‌ناشدۀ نَفْس خود مرده بودید، خدا شما را با مسیح زنده کرد. او همۀ گناهان ما را آمرزید"
        },
        {
          "verse": 14,
          "usfm": "COL.2.14",
          "line_type": "p",
          "text": "و آن سندِ قرضها را که به موجب قوانین بر ضد ما نوشته شده و علیه ما قد علم کرده بود، باطل کرد و بر صلیب میخکوبش کرده، از میان برداشت."
        },
        {
          "verse": 15,
          "usfm": "COL.2.15",
          "line_type": "p",
          "text": "و ریاستها و قدرتها را خلع‌سلاح کرده، در نظر همگان رسوا ساخت و به وسیلۀ صلیب بر آنها پیروز شد."
        },
        {
          "verse": 16,
          "usfm": "COL.2.16",
          "line_type": "p",
          "text": "پس مگذارید کسی در خصوص آنچه می‌خورید و می‌آشامید، یا در خصوص نگاه داشتن اعیاد و ماه نو و روز شَبّات، محکومتان کند."
        },
        {
          "verse": 17,
          "usfm": "COL.2.17",
          "line_type": "p",
          "text": "اینها تنها سایۀ امور آینده بود، امّا اصل آنها در مسیح یافت می‌شود."
        },
        {
          "verse": 18,
          "usfm": "COL.2.18",
          "line_type": "p",
          "text": "مگذارید کسی که دل به خوار کردن خویشتن و عبادتِ فرشتگان مشغول داشته است، شما را مردود گرداند. چنین کسی شیفتۀ اموری است که در رؤیاهایش دیده است، و افکار نفسانی‌اش او را با خیالهای پوچ مغرور ساخته است."
        },
        {
          "verse": 19,
          "usfm": "COL.2.19",
          "line_type": "p",
          "text": "او پیوندش را با سَر از دست داده است؛ حال آنکه تمام بدن، در حالی که به وسیلۀ مفاصل و بندها نگاه داشته می‌شود و به هم متصل می‌گردد، به مدد سر رشد می‌کند، با رشدی که از خدا سرچشمه می‌گیرد."
        },
        {
          "verse": 20,
          "usfm": "COL.2.20",
          "line_type": "p",
          "text": "پس حال که با مسیح نسبت به اصول ابتدایی این دنیا مرده‌اید، چرا همچون کسانی که گویی هنوز به دنیا تعلق دارند، تن به قواعد آن می‌دهید، قواعدی که می‌گوید:"
        },
        {
          "verse": 21,
          "usfm": "COL.2.21",
          "line_type": "p",
          "text": "«این را لمس مکن! به آن لب نزن و بر آن دست مگذار!»؟"
        },
        {
          "verse": 22,
          "usfm": "COL.2.22",
          "line_type": "p",
          "text": "اینها همه مربوط به چیزهایی است که با مصرف از بین می‌رود، و بر احکام و تعالیم بشری بنا شده است."
        },
        {
          "verse": 23,
          "usfm": "COL.2.23",
          "line_type": "p",
          "text": "و هرچند به سبب در بر داشتن عبادتِ داوطلبانه و خوار کردن خویشتن و ریاضت بدنی، ظاهری حکیمانه دارد، امّا فاقد هر گونه ارزش برای مهار تمایلات نفسانی است."
        }
      ],
      "verse_count": 23,
      "headings": [
        {
          "before_verse": 6,
          "text": "آزادی از مقررات انسانی"
        }
      ],
