    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 4,
      "chapter_usfm": "COL.4",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.4.1",
          "line_type": "p",
          "text": "ای اربابان، با غلامان خود به عدل و انصاف رفتار کنید، زیرا می‌دانید که شما را نیز اربابی است در آسمان."
        },
        {
          "verse": 2,
          "usfm": "COL.4.2",
          "line_type": "p",
          "text": "با هوشیاری و شکرگزاری، خود را وقف دعا کنید."
        },
        {
          "verse": 3,
          "usfm": "COL.4.3",
          "line_type": "p",
          "text": "و برای ما نیز دعا کنید، تا خدا دری به روی پیام ما بگشاید تا بتوانیم راز مسیح را بیان کنیم، رازی که به‌خاطر آن به زنجیر کشیده شده‌ام."
        },
        {
          "verse": 4,
          "usfm": "COL.4.4",
          "line_type": "p",
          "text": "دعا کنید که بتوانم آن را به‌روشنی بیان کنم، چنانکه شایسته است."
        },
        {
          "verse": 5,
          "usfm": "COL.4.5",
          "line_type": "p",
          "text": "با مردمانِ بیرون حکیمانه رفتار کنید و از هر فرصتی بیشترین بهره را برگیرید."
        },
        {
          "verse": 6,
          "usfm": "COL.4.6",
          "line_type": "p",
          "text": "سخنان شما همیشه پر از فیض و سنجیده باشد، تا بدانید هر کس را چگونه پاسخ دهید."
        },
        {
          "verse": 7,
          "usfm": "COL.4.7",
          "line_type": "p",
          "text": "تیخیکوس شما را به کمال از احوال من آگاه خواهد ساخت. او برادری عزیز، خادمی امین و همکار من در خداوند است."
        },
        {
          "verse": 8,
          "usfm": "COL.4.8",
          "line_type": "p",
          "text": "او را نزدتان می‌فرستم تا از احوال ما آگاه شوید، و تا دل شما را تشویق کند."
        },
        {
          "verse": 9,
          "usfm": "COL.4.9",
          "line_type": "p",
          "text": "او همراه اونِسیموس، برادر امین و عزیز ما که از خود شماست، نزدتان می‌آید. ایشان شما را از هرآنچه در اینجا می‌گذرد آگاه خواهند ساخت."
        },
        {
          "verse": 10,
          "usfm": "COL.4.10",
          "line_type": "p",
          "text": "آریستارخوس که با من در زندان است، برای شما سلام می‌فرستد؛ همچنین مَرقُس، پسر عموی برنابا، برایتان سلام دارد. پیشتر به شما دربارۀ او سفارش کرده‌ام که هر گاه نزدتان بیاید، به‌گرمی پذیرایش شوید."
        },
        {
          "verse": 11,
          "usfm": "COL.4.11",
          "line_type": "p",
          "text": "عیسی نیز که یوستوس خوانده می‌شود، برای شما سلام می‌فرستد. در میان همکارانم در کار پادشاهی خدا، تنها این چند تن، یهودی‌نژادند، و ایشان مایۀ تسلی من بوده‌اند."
        },
        {
          "verse": 12,
          "usfm": "COL.4.12",
          "line_type": "p",
          "text": "اِپافْراس که از خود شما و خادم مسیحْ عیسی است، برایتان سلام دارد. او همواره در دعا برای شما مجاهده می‌کند، تا با بلوغ کامل، استوار بایستید، و از هرآنچه مطابق با خواست خداست، آکنده باشید."
        },
        {
          "verse": 13,
          "usfm": "COL.4.13",
          "line_type": "p",
          "text": "من شاهدم که او برای شما و آنان که در لائودیکیه و هیراپولیس هستند، چه بسیار محنت می‌کشد."
        },
        {
          "verse": 14,
          "usfm": "COL.4.14",
          "line_type": "p",
          "text": "لوقا پزشک محبوب و همچنین دیماس شما را سلام می‌فرستند."
        },
        {
          "verse": 15,
          "usfm": "COL.4.15",
          "line_type": "p",
          "text": "به برادران ما در لائودیکیه و همچنین به نیمفا و کلیسایی که در خانۀ این بانو بر پا می‌شود، سلام برسانید."
        },
        {
          "verse": 16,
          "usfm": "COL.4.16",
          "line_type": "p",
          "text": "پس از آنکه این نامه برای شما خوانده شد، ترتیبی دهید که در کلیسای لائودیکیه نیز خوانده شود؛ شما نیز نامه به لائودیکیه را بخوانید."
        },
        {
          "verse": 17,
          "usfm": "COL.4.17",
          "line_type": "p",
          "text": "به آرخیپوس بگویید: «به هوش باش تا خدمتی را که در خداوند یافته‌ای به کمال رسانی.»"
        },
        {
          "verse": 18,
          "usfm": "COL.4.18",
          "line_type": "p",
          "text": "من، پولس، این درود را با خط خود می‌نویسم. زنجیرهای مرا به یاد داشته باشید. فیض با شما باد."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 7,
          "text": "درودهای آخر نامه"
        }
      ],
      "footnotes": [
