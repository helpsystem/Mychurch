  "chapters": [
    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 1,
      "chapter_usfm": "COL.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.1.1",
          "line_type": "p",
          "text": "از پولس که به خواست خدا، رسول مسیحْ عیسی است، و از برادرمان، تیموتائوس،"
        },
        {
          "verse": 2,
          "usfm": "COL.1.2",
          "line_type": "p",
          "text": "به مقدسین و برادران وفادار در مسیح که در شهر کولُسی هستند:فیض و سلامتی از سوی خدا، پدر ما، بر شما باد."
        },
        {
          "verse": 3,
          "usfm": "COL.1.3",
          "line_type": "p",
          "text": "ما همواره به هنگام دعا برای شما، خدا، پدر خداوندمان عیسی مسیح را شکر می‌گزاریم،"
        },
        {
          "verse": 4,
          "usfm": "COL.1.4",
          "line_type": "p",
          "text": "زیرا وصف ایمان شما به مسیحْ عیسی و محبتی را که به همۀ مقدسین دارید، شنیده‌ایم."
        },
        {
          "verse": 5,
          "usfm": "COL.1.5",
          "line_type": "p",
          "text": "اینها از امیدی سرچشمه می‌گیرد که در آسمان برای شما محفوظ است و پیشتر درباره‌اش از پیام حقیقت یعنی انجیل شنیده‌اید،"
        },
        {
          "verse": 6,
          "usfm": "COL.1.6",
          "line_type": "p",
          "text": "انجیلی که به شما رسیده است و در سرتاسر جهان ثمر می‌دهد و رشد می‌کند، همان‌گونه که در میان شما نیز، از روزی که آن را شنیدید و فیض خدا را به معنای واقعی درک کردید، عمل کرده است."
        },
        {
          "verse": 7,
          "usfm": "COL.1.7",
          "line_type": "p",
          "text": "شما آن را از همکار عزیز ما، اِپافْراس آموختید که خادم وفادار مسیح به نیابت از ماست."
        },
        {
          "verse": 8,
          "usfm": "COL.1.8",
          "line_type": "p",
          "text": "او ما را از محبت شما که در روح است، آگاه ساخت."
        },
        {
          "verse": 9,
          "usfm": "COL.1.9",
          "line_type": "p",
          "text": "از همین رو، از روزی که این را شنیدیم، از دعا کردن برای شما باز نایستاده‌ایم، بلکه پیوسته از خدا می‌خواهیم که شما از شناخت ارادۀ او در هر حکمت و فهم روحانی پر شوید،"
        },
        {
          "verse": 10,
          "usfm": "COL.1.10",
          "line_type": "p",
          "text": "تا رفتار شما شایستۀ خداوند باشد، و بتوانید او را از هر جهت خشنود سازید: یعنی در هر کارِ نیک ثمر آورید و در شناخت خدا رشد کنید"
        },
        {
          "verse": 11,
          "usfm": "COL.1.11",
          "line_type": "p",
          "text": "و با همۀ نیرویی که از قدرت پرجلال او سرچشمه می‌گیرد، از هر حیث نیرومند شوید تا صبر و تحمّل بسیار داشته باشید، و تا شادمانه"
        },
        {
          "verse": 12,
          "usfm": "COL.1.12",
          "line_type": "p",
          "text": "پدر را شکر گویید که شما را شایستۀ سهیم شدن در میراث مقدسین در قلمرو نور گردانیده است."
        },
        {
          "verse": 13,
          "usfm": "COL.1.13",
          "line_type": "p",
          "text": "زیرا ما را از قدرت تاریکی رهانیده و به پادشاهی پسر عزیزش منتقل ساخته است،"
        },
        {
          "verse": 14,
          "usfm": "COL.1.14",
          "line_type": "p",
          "text": "که در او از رهایی، یعنی از آمرزش گناهان برخورداریم."
        },
        {
          "verse": 15,
          "usfm": "COL.1.15",
          "line_type": "p",
          "text": "او صورت خدای نادیده است و فرزند ارشد بر تمامی آفرینش،"
        },
        {
          "verse": 16,
          "usfm": "COL.1.16",
          "line_type": "p",
          "text": "زیرا همه چیز به واسطۀ او آفریده شد: آنچه در آسمان و آنچه بر زمین است، دیدنیها و نادیدنیها، تختها و فرمانرواییها، ریاستها و قدرتها، همه به واسطۀ او و برای او آفریده شدند."
        },
        {
          "verse": 17,
          "usfm": "COL.1.17",
          "line_type": "p",
          "text": "او پیش از همه چیز وجود داشته، و همه چیز در او قوام دارد."
        },
        {
          "verse": 18,
          "usfm": "COL.1.18",
          "line_type": "p",
          "text": "او بدن، یعنی کلیسا، را سَر است. او سرآغاز و نخست‌زاده از میان مردگان است، تا در همه چیزْ برتری از آن او باشد."
        },
        {
          "verse": 19,
          "usfm": "COL.1.19",
          "line_type": "p",
          "text": "زیرا خشنودی خدا در این بود که با همۀ کمال خود در او ساکن شود،"
        },
        {
          "verse": 20,
          "usfm": "COL.1.20",
          "line_type": "p",
          "text": "و به واسطۀ او همه چیز را، چه در آسمان و چه بر زمین، با خود آشتی دهد، به وسیلۀ صلحی که با ریخته شدن خون وی بر صلیب پدید آورد."
        },
        {
          "verse": 21,
          "usfm": "COL.1.21",
          "line_type": "p",
          "text": "شما نیز زمانی بیگانه با خدا، و در افکار خویش دشمن او بودید، و این در اعمال شریرانۀ شما پدیدار می‌گشت."
        },
        {
          "verse": 22,
          "usfm": "COL.1.22",
          "line_type": "p",
          "text": "امّا اکنون مسیح شما را به واسطۀ بدن بشری خود و از طریق مرگ آشتی داده است، تا شما را مقدّس و بی‌عیب و بَری از هر ملامت به حضور خدا بیاورد،"
        },
        {
          "verse": 23,
          "usfm": "COL.1.23",
          "line_type": "p",
          "text": "به شرطی که در ایمان مستحکم بوده، استوار بمانید و از امید انجیل جنبش نخورید، همان انجیل که شنیدید و به تمامی خلقتِ زیر آسمان موعظه شده است، و من، پولس، خادم آن گشته‌ام."
        },
        {
          "verse": 24,
          "usfm": "COL.1.24",
          "line_type": "p",
          "text": "اکنون از رنجهایی که به‌خاطر شما کشیدم شادمانم و هر کاستی رنجهای مسیح را در بدن خود جبران می‌کنم، به‌خاطر بدن او که کلیساست."
        },
        {
          "verse": 25,
          "usfm": "COL.1.25",
          "line_type": "p",
          "text": "من بنا بر مأموریتی که خدا به من سپرد، خادم کلیسا گشتم، تا کلام خدا را به کمال به شما بیان کنم،"
        },
        {
          "verse": 26,
          "usfm": "COL.1.26",
          "line_type": "p",
          "text": "یعنی آن راز را که طی اعصار و نسلهای متمادی پنهان نگاه داشته شده بود، امّا اکنون بر مقدسین او آشکار شده است."
        },
        {
          "verse": 27,
          "usfm": "COL.1.27",
          "line_type": "p",
          "text": "خدا چنین اراده فرمود که بر ایشان آشکار سازد که این راز از چه جلال عظیمی در میان غیریهودیان برخوردار است، رازی که همانا مسیح در شماست، که امید جلال است."
        },
        {
          "verse": 28,
          "usfm": "COL.1.28",
          "line_type": "p",
          "text": "ما او را وعظ می‌کنیم، و هر کس را هشدار می‌دهیم و با کمال حکمت می‌آموزیم، تا همه را کامل در مسیح حاضر سازیم."
        },
        {
          "verse": 29,
          "usfm": "COL.1.29",
          "line_type": "p",
          "text": "از این روست که من زحمت می‌کشم و با نیروی او که در من نیرومندانه عمل می‌کند، به مجاهده مشغولم."
        }
      ],
      "verse_count": 29,
