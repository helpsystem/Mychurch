  "chapters": [
    {
      "schema_version": 6,
      "book_id": "3JN",
      "chapter": 1,
      "chapter_usfm": "3JN.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "3JN.1.1",
          "line_type": "p",
          "text": "از شیخ کلیسا،به گایوس عزیز که او را در ’حقیقت‘ دوست می‌دارم."
        },
        {
          "verse": 2,
          "usfm": "3JN.1.2",
          "line_type": "p",
          "text": "ای عزیز، دعایم این است که از هر جهت کامیاب باشی و در تندرستی به سر بَری، همچنان که جانت نیز کامیاب است."
        },
        {
          "verse": 3,
          "usfm": "3JN.1.3",
          "line_type": "p",
          "text": "بسی شادمان شدم که برادران آمده، بر وفاداری‌ات به حقیقت و شیوۀ سلوکت در آن شهادت دادند."
        },
        {
          "verse": 4,
          "usfm": "3JN.1.4",
          "line_type": "p",
          "text": "هیچ چیز مرا بیش از این شاد نمی‌کند که بشنوم فرزندانم در ’حقیقت‘ سلوک می‌کنند."
        },
        {
          "verse": 5,
          "usfm": "3JN.1.5",
          "line_type": "p",
          "text": "ای عزیز، تو در همۀ کارهایت برای برادران، امانت خود را نشان می‌دهی، بخصوص اینکه نزد تو بیگانه‌اند."
        },
        {
          "verse": 6,
          "usfm": "3JN.1.6",
          "line_type": "p",
          "text": "ایشان نیز در حضور کلیسا بر محبت تو شهادت داده‌اند؛ پس کاری نیکو می‌کنی اگر ایشان را آن گونه که سزاوار خداست، روانۀ سفر کنی."
        },
        {
          "verse": 7,
          "usfm": "3JN.1.7",
          "line_type": "p",
          "text": "زیرا که ایشان به خاطر آن نام عزیمت کرده‌اند و از غیریهودیان کمکی دریافت نداشته‌اند."
        },
        {
          "verse": 8,
          "usfm": "3JN.1.8",
          "line_type": "p",
          "text": "پس باید که ما چنین کسان را حمایت کنیم تا با ایشان در پیشبرد حقیقت همکاری کرده باشیم."
        },
        {
          "verse": 9,
          "usfm": "3JN.1.9",
          "line_type": "p",
          "text": "مطلبی به کلیسا نوشتم، امّا دیوتْرِفیس که جایگاه نخست را دوست می‌دارد، اقتدار ما را گردن نمی‌نهد."
        },
        {
          "verse": 10,
          "usfm": "3JN.1.10",
          "line_type": "p",
          "text": "پس چون بیایم، به آنچه می‌کند رسیدگی خواهم کرد، چرا که مغرضانه دربارۀ ما بد می‌گوید، و به این هم بسنده نکرده، از پذیرش برادران سر باز می‌زند؛ و کسانی را نیز که می‌خواهند ایشان را بپذیرند، بازداشته، از کلیسا بیرون می‌راند."
        },
        {
          "verse": 11,
          "usfm": "3JN.1.11",
          "line_type": "p",
          "text": "ای عزیز، بدی را سرمشق خود مساز، بلکه از نیکویی سرمشق گیر؛ زیرا نیکو‌کردار از خداست، امّا بدکردار خدا را ندیده است."
        },
        {
          "verse": 12,
          "usfm": "3JN.1.12",
          "line_type": "p",
          "text": "همگان دربارۀ دیمیتریوس نیکو شهادت می‌دهند، حتی خودِ حق. ما نیز چنین شهادت می‌دهیم و می‌دانی که شهادت ما راست است."
        },
        {
          "verse": 13,
          "usfm": "3JN.1.13",
          "line_type": "p",
          "text": "بسیار چیزها داشتم به تو بنویسم، لیکن نمی‌خواهم با مرکّب و قلم باشد."
        },
        {
          "verse": 14,
          "usfm": "3JN.1.14",
          "line_type": "p",
          "text": "امّا امیدوارم بزودی تو را ببینم و رویاروی گفتگو کنیم."
        },
        {
          "verse": 15,
          "usfm": "3JN.1.15",
          "line_type": "p",
          "text": "سلامتی بر تو باد!دوستان برای تو سلام می‌فرستند. دوستان را در آنجا به نام سلام بده."
        }
      ],
      "verse_count": 15,
