  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 1,
      "chapter_usfm": "2PE.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.1.1",
          "line_type": "p",
          "text": "از شَمعون پطرس، خادم و رسول عیسی مسیح،به آنان که به برکتِ عدالت خدا و نجات‌دهندۀ ما عیسی مسیح، ایمانی همتراز با ایمان ما نصیبشان شده است:"
        },
        {
          "verse": 2,
          "usfm": "2PE.1.2",
          "line_type": "p",
          "text": "فیض و سلامتی به واسطۀ شناخت خدا و خداوند ما عیسی، به‌فزونی بر شما باد."
        },
        {
          "verse": 3,
          "usfm": "2PE.1.3",
          "line_type": "p",
          "text": "قدرت الهیِ او هرآنچه را برای حیات و دینداری نیاز داریم بر ما ارزانی داشته است. این از طریق شناختِ او میسّر شده که ما را به واسطۀ جلال و نیکویی خویش فرا خوانده است."
        },
        {
          "verse": 4,
          "usfm": "2PE.1.4",
          "line_type": "p",
          "text": "او به واسطۀ اینها وعده‌های عظیم و گرانبهای خود را به ما بخشیده، تا از طریق آنها شریک طبیعت الهی شوید و از فسادی که در نتیجۀ امیال نفسانی در دنیا وجود دارد، بِرَهید."
        },
        {
          "verse": 5,
          "usfm": "2PE.1.5",
          "line_type": "p",
          "text": "از همین رو، به سعی تمام بکوشید تا به واسطۀ ایمان خود نیکویی بار آورید و به واسطۀ نیکویی، شناخت،"
        },
        {
          "verse": 6,
          "usfm": "2PE.1.6",
          "line_type": "p",
          "text": "و به واسطۀ شناخت، خویشتنداری، و به واسطۀ خویشتنداری، پایداری، و به واسطۀ پایداری، دینداری،"
        },
        {
          "verse": 7,
          "usfm": "2PE.1.7",
          "line_type": "p",
          "text": "و به واسطۀ دینداری، مهرِ برادرانه و به واسطۀ مهرِ برادرانه، محبت."
        },
        {
          "verse": 8,
          "usfm": "2PE.1.8",
          "line_type": "p",
          "text": "زیرا چون اینها در شما باشد و فزونی یابد، نخواهد گذاشت در شناخت خداوند ما عیسی مسیح، بی‌فایده و بی‌ثمر باشید."
        },
        {
          "verse": 9,
          "usfm": "2PE.1.9",
          "line_type": "p",
          "text": "امّا آن که عاری از اینهاست، کور است و کوته‌بین، و از یاد برده که از گناهان گذشتۀ خویش پاک شده است."
        },
        {
          "verse": 10,
          "usfm": "2PE.1.10",
          "line_type": "p",
          "text": "پس ای برادران، هر چه بیشتر بکوشید تا فراخواندگی و برگزیدگی خویش را تثبیت نمایید، چرا که اگر چنین کنید هرگز سقوط نخواهید کرد."
        },
        {
          "verse": 11,
          "usfm": "2PE.1.11",
          "line_type": "p",
          "text": "زیرا این‌چنین، دخول به پادشاهیِ جاودانِ خداوند و نجات‌دهندۀ ما عیسی مسیح به‌فراوانی به شما عطا خواهد شد."
        },
        {
          "verse": 12,
          "usfm": "2PE.1.12",
          "line_type": "p",
          "text": "پس این امور را همواره به شما یادآوری خواهم کرد، هرچند آنها را می‌دانید و در آن حقیقت که یافته‌اید، استوارید."
        },
        {
          "verse": 13,
          "usfm": "2PE.1.13",
          "line_type": "p",
          "text": "آری، مصلحت چنین می‌دانم تا آنگاه که در این خیمه ساکنم، شما را از طریق یادآوری برانگیزانم،"
        },
        {
          "verse": 14,
          "usfm": "2PE.1.14",
          "line_type": "p",
          "text": "زیرا می‌دانم به‌زودی این خیمه را وداع خواهم گفت، چنانکه خداوندِ ما عیسی مسیح مرا آگاهانید."
        },
        {
          "verse": 15,
          "usfm": "2PE.1.15",
          "line_type": "p",
          "text": "از این رو هر چه در توان دارم خواهم کرد تا بتوانید پس از رحلتم همواره این امور را به یاد آورید."
        },
        {
          "verse": 16,
          "usfm": "2PE.1.16",
          "line_type": "p",
          "text": "زیرا آنگاه که ظهور پرقدرتِ خداوندمان عیسی مسیح را به شما اعلام می‌کردیم، از پی افسانه‌هایی که زیرکانه ابداع شده باشند نرفته بودیم، بلکه کبریای او را به چشم دیده بودیم."
        },
        {
          "verse": 17,
          "usfm": "2PE.1.17",
          "line_type": "p",
          "text": "زیرا از خدای پدر، جلال و اکرام یافت و سروشی از جلال کبریایی به او در رسید که، «این است پسر محبوبم که از او خشنودم.»"
        },
        {
          "verse": 18,
          "usfm": "2PE.1.18",
          "line_type": "p",
          "text": "ما خود بر آن کوه مقدّس با او بودیم و آن سروش آسمانی را به گوش شنیدیم."
        },
        {
          "verse": 19,
          "usfm": "2PE.1.19",
          "line_type": "p",
          "text": "به علاوه، کلامِ بس مطمئن انبیا را داریم که نیکوست بدان توجه کنید، چرا که همچون چراغی در مکان تیره و تار می‌درخشد تا آنگاه که سپیده بردَمد و ستارۀ صبح در دلهایتان طلوع کند."
        },
        {
          "verse": 20,
          "usfm": "2PE.1.20",
          "line_type": "p",
          "text": "قبل از هر چیز، بدانید که هیچ وحیِ کتب مقدّس زاییدۀ تفسیر خودِ نبی نیست."
        },
        {
          "verse": 21,
          "usfm": "2PE.1.21",
          "line_type": "p",
          "text": "زیرا وحی هیچ‌گاه به ارادۀ انسان آورده نشد، بلکه آدمیان تحت نفوذ روح‌القدس از جانب خدا سخن گفتند."
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 3,
          "text": "زندگی مسیحی در پرتو دعوت الهی"
        },
        {
          "before_verse": 12,
          "text": "وحی کتب مقدّس"
        }
      ],
