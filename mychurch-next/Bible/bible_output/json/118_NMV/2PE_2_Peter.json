    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 3,
      "chapter_usfm": "2PE.3",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.3.1",
          "line_type": "p",
          "text": "ای عزیزان، این نامۀ دوّم است که به شما می‌نویسم. هر دو نامه را به قصد یادآوری نگاشتم تا شما را به تفکری سالم برانگیزانم،"
        },
        {
          "verse": 2,
          "usfm": "2PE.3.2",
          "line_type": "p",
          "text": "تا کلامی را که پیامبران مقدّس در ایام گذشته گفته‌اند، به یاد آرید و نیز حکم خداوند و نجات‌دهندۀ ما را که به واسطۀ رسولان شما بیان شد."
        },
        {
          "verse": 3,
          "usfm": "2PE.3.3",
          "line_type": "p",
          "text": "قبل از هر چیز، بدانید که در ایام آخر استهزاکنندگانی ظهور خواهند کرد که پیرو امیال پلید خود خواهند بود و استهزاکنان"
        },
        {
          "verse": 4,
          "usfm": "2PE.3.4",
          "line_type": "p",
          "text": "خواهند گفت: «پس چه شد وعدۀ آمدن او؟ از زمانی که پدران ما به خواب رفتند، همه چیز همان‌گونه است که از بدو آفرینش بود!»"
        },
        {
          "verse": 5,
          "usfm": "2PE.3.5",
          "line_type": "p",
          "text": "بدین‌سان، آنان به عمد بر این حقیقت چشم می‌پوشند که به کلام خدا آسمانها از قدیم بود و زمین از آب و به وسیلۀ آب شکل گرفت؛"
        },
        {
          "verse": 6,
          "usfm": "2PE.3.6",
          "line_type": "p",
          "text": "و به وسیلۀ همین آب، دنیای آن زمان غرق و نابود شد."
        },
        {
          "verse": 7,
          "usfm": "2PE.3.7",
          "line_type": "p",
          "text": "و به همان کلام، آسمانها و زمینِ کنونی برای آتش ذخیره شده است و تا روز داوری و هلاکت بی‌دینان نگاه داشته می‌شود."
        },
        {
          "verse": 8,
          "usfm": "2PE.3.8",
          "line_type": "p",
          "text": "امّا ای عزیزان، از این نکته غافل مباشید که نزد خداوند یک روز همچون هزار سال است و هزار سال همچون یک روز."
        },
        {
          "verse": 9,
          "usfm": "2PE.3.9",
          "line_type": "p",
          "text": "برخلاف گمان برخی، خداوند در انجام وعده‌اش تأخیر نمی‌ورزد، بلکه با شما بردبار است، چه نمی‌خواهد کسی هلاک شود بلکه می‌خواهد همگان به توبه گرایند."
        },
        {
          "verse": 10,
          "usfm": "2PE.3.10",
          "line_type": "p",
          "text": "امّا روز خداوند چون دزد خواهد آمد، که در آن آسمانها با غریوی مَهیب از میان خواهد رفت و اجرام سماوی سوخته شده فرو خواهد پاشید، زمین و همۀ کارهایش عیان خواهد شد."
        },
        {
          "verse": 11,
          "usfm": "2PE.3.11",
          "line_type": "p",
          "text": "پس حال که همۀ اینها بدین سان فرو خواهد پاشید، شما چگونه مردمان باید باشید؟ بر شماست که زندگی مقدّس و خداپسندانه‌ای داشته،"
        },
        {
          "verse": 12,
          "usfm": "2PE.3.12",
          "line_type": "p",
          "text": "انتظار روز خدا را بکشید و فرا رسیدن آن را بشتابانید. آن روز سبب خواهد شد که آسمانها به آتش کشیده شده، فرو پاشند و اجرام سماوی از گرما ذوب گردند."
        },
        {
          "verse": 13,
          "usfm": "2PE.3.13",
          "line_type": "p",
          "text": "امّا ما بنا بر وعدۀ او مشتاقانه در انتظار آسمانی جدید و زمینی جدید هستیم که منزلگه پارسایی است."
        },
        {
          "verse": 14,
          "usfm": "2PE.3.14",
          "line_type": "p",
          "text": "پس ای عزیزان، حال که این امور را انتظار می‌کشید، به سعی تمام بکوشید تا در حضور او بی‌لکه و بی‌عیب و در صلح یافت شوید."
        },
        {
          "verse": 15,
          "usfm": "2PE.3.15",
          "line_type": "p",
          "text": "و شکیبایی خداوندِ ما را رستگاری بینگارید، همان‌گونه که برادر عزیز ما پولس نیز مطابق حکمتی که به او عطا شده است، به شما نوشت."
        },
        {
          "verse": 16,
          "usfm": "2PE.3.16",
          "line_type": "p",
          "text": "او در همۀ نامه‌های خود چنین می‌نویسد، هر آنگاه که از این امور سخن می‌گوید. نامه‌های او شامل مطالبی است که درکش دشوار است و جاهلان و سست‌مایگان تحریفش می‌کنند، همان‌گونه که با دیگر نوشته‌های مقدّس چنین می‌کنند، و این موجب هلاکتشان خواهد شد."
        },
        {
          "verse": 17,
          "usfm": "2PE.3.17",
          "line_type": "p",
          "text": "پس شما ای عزیزان، حال که این را می‌دانید، به‌هوش باشید مبادا به راه نادرستِ بی‌دینان گمراه شوید و پایداری‌تان را از کف بدهید،"
        },
        {
          "verse": 18,
          "usfm": "2PE.3.18",
          "line_type": "p",
          "text": "بلکه در فیض و شناخت خداوند و نجات‌دهندۀ ما عیسی مسیح نمو کنید، که او را از حال تا ابدالآباد جلال باد! آمین."
        }
      ],
      "verse_count": 18,
      "headings": [],
