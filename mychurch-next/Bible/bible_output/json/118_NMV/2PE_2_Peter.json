    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 2,
      "chapter_usfm": "2PE.2",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.2.1",
          "line_type": "p",
          "text": "امّا در میان قوم، انبیای دروغین نیز بودند، همان‌گونه که در میان شما نیز معلّمان دروغین خواهند بود که پنهانی بدعتهای مهلک خواهند آورد و حتی سَروری را که ایشان را خریده، انکار خواهند کرد و این‌گونه، هلاکتی سریع بر خود فرو خواهند آورد."
        },
        {
          "verse": 2,
          "usfm": "2PE.2.2",
          "line_type": "p",
          "text": "بسیاریْ فجور ایشان را پیروی خواهند کرد، و به سبب آنان راه حق مذمّت خواهد شد."
        },
        {
          "verse": 3,
          "usfm": "2PE.2.3",
          "line_type": "p",
          "text": "ایشان از طمع، با توسل به سخنان فریبنده، از شما بهره‌کشی خواهند کرد. امّا محکومیتشان که از دیرباز رقم خورده، بی‌کار ننشسته و نابودی‌شان نخوابیده است!"
        },
        {
          "verse": 4,
          "usfm": "2PE.2.4",
          "line_type": "p",
          "text": "زیرا اگر خدا بر فرشتگانی که گناه ورزیدند رحم نکرد، بلکه ایشان را به تَه هاویه افکند و در سیاهچالهای تاریک محبوس کرد تا برای داوری نگاه داشته شوند؛"
        },
        {
          "verse": 5,
          "usfm": "2PE.2.5",
          "line_type": "p",
          "text": "و اگر بر دنیای قدیم نیز رحم نکرد، بلکه بر آن عالَمِ بی‌دینان توفان فرستاد و تنها نوح، آن واعظِ پارسایی را، با هفت تن دیگر محفوظ داشت؛"
        },
        {
          "verse": 6,
          "usfm": "2PE.2.6",
          "line_type": "p",
          "text": "و اگر شهرهای سُدوم و عَمورَه را خاکستر نمود و به نابودی محکوم کرد و عبرتی ساخت از سرانجام بی‌دینی،"
        },
        {
          "verse": 7,
          "usfm": "2PE.2.7",
          "line_type": "p",
          "text": "و لوطِ پارسا را که از فجور بی‌دینان به ستوه آمده بود، رهایی بخشید -"
        },
        {
          "verse": 8,
          "usfm": "2PE.2.8",
          "line_type": "p",
          "text": "زیرا آن مردِ پارسا هر روزه در میان ایشان به سر می‌برد و روحِ پارسایش از دیدن و شنیدن کردار قبیحشان در عذاب بود -"
        },
        {
          "verse": 9,
          "usfm": "2PE.2.9",
          "line_type": "p",
          "text": "پس خداوند می‌داند چگونه پارسایان را از آزمایشها برهاند و گنهکاران را برای مکافاتِ روز داوری نگاه دارد،"
        },
        {
          "verse": 10,
          "usfm": "2PE.2.10",
          "line_type": "p",
          "text": "بخصوص آنان را که در پی تمایلاتِ فاسدِ نَفْس خویشند و اقتدار خداوند را خوار می‌شمارند.اینان چنان گستاخند و متکبّر که از اهانت به بزرگان آسمانی پروایی ندارند؛"
        },
        {
          "verse": 11,
          "usfm": "2PE.2.11",
          "line_type": "p",
          "text": "حال آنکه حتی فرشتگان که از قدرت و اقتدار بیشتر نیز برخوردارند، هرگز به هنگام اعلام محکومیتِ خداوند بر این بزرگان، اهانتشان نمی‌کنند."
        },
        {
          "verse": 12,
          "usfm": "2PE.2.12",
          "line_type": "p",
          "text": "در مقابل، اینان در اموری اهانت می‌ورزند که از آن هیچ شناختی ندارند. آنان همچون وحوش عاری از شعورند که تنها تابع غرایز خویشند و زاده شده‌اند تا به دام افتند و هلاک گردند. پس بسان وحوش نیز هلاک خواهند شد"
        },
        {
          "verse": 13,
          "usfm": "2PE.2.13",
          "line_type": "p",
          "text": "و در سزای آن بدی که کرده‌اند، بد خواهند دید. تفریح اینان عیش و عشرت در روز روشن است. لکه‌های ننگی هستند که حتی به هنگام شرکت در ضیافت با شما، از غرقه شدن در لذات فریبندۀ خویش دست برنمی‌کشند."
        },
        {
          "verse": 14,
          "usfm": "2PE.2.14",
          "line_type": "p",
          "text": "چشمانی دارند پر از زنا که از گناه کردن سیر نمی‌شود. این ملعونان، سست‌مایگان را اغوا می‌کنند و در طمع‌ورزی بسی چیره‌دستند!"
        },
        {
          "verse": 15,
          "usfm": "2PE.2.15",
          "line_type": "p",
          "text": "راهِ راست را ترک گفته و با در پیش گرفتن راه بَلعام بن بِعور که مزد ناراستی را دوست می‌داشت، گمراه گشته‌اند."
        },
        {
          "verse": 16,
          "usfm": "2PE.2.16",
          "line_type": "p",
          "text": "امّا بَلعام به سبب بدکرداری‌اش از زبان الاغی توبیخ شد. حیوان بی‌زبان همانند انسان سخن گفت و بر دیوانگی نبی لگام زد."
        },
        {
          "verse": 17,
          "usfm": "2PE.2.17",
          "line_type": "p",
          "text": "این معلّمان دروغین، چشمه‌هایی بی‌آب و بخارهایی رانده از تندبادند که تاریکی مطلق برایشان مقرر است."
        },
        {
          "verse": 18,
          "usfm": "2PE.2.18",
          "line_type": "p",
          "text": "زیرا سخنان تکبّرآمیز و باطل می‌گویند و با بهره‌جویی از تمایلات نَفْس و شهوت‌انگیزی، کسانی را که به‌تازگی از چنگ گمراهان رسته‌اند، اغوا می‌کنند."
        },
        {
          "verse": 19,
          "usfm": "2PE.2.19",
          "line_type": "p",
          "text": "بدیشان وعدۀ آزادی می‌دهند، حال آنکه خود بندۀ فسادند؛ چه، آدمی بندۀ هر آن چیز است که بر او مسلط است."
        },
        {
          "verse": 20,
          "usfm": "2PE.2.20",
          "line_type": "p",
          "text": "زیرا آنان که با شناخت خداوند و نجات‌دهندۀ ما عیسی مسیح، از فساد دنیا رَستند، اگر باز بدان گرفتار و مغلوب آیند، سرانجامشان بدتر از آغاز خواهد بود."
        },
        {
          "verse": 21,
          "usfm": "2PE.2.21",
          "line_type": "p",
          "text": "بهتر آن می‌بود که از آغاز، راه پارسایی را نمی‌شناختند، تا اینکه پس از شناختن، از حکم مقدّسی که بدیشان سپرده شد، روی برتابند."
        },
        {
          "verse": 22,
          "usfm": "2PE.2.22",
          "line_type": "p",
          "text": "پس آنان مصداق این مَثَلِ راستین‌اند که:«سگ به قی خود بازمی‌گردد»،و«خوکِ شسته شده، به غلتیدن در گِل.»"
        }
      ],
      "verse_count": 22,
      "headings": [],
      "footnotes": [
        {
          "verse": 4,
          "usfm": "2PE.2.4",
          "note_ref": "2‏:4",
          "note_type": "footnote",
          "references": [],
          "text": "در اصل یونانی: ”تارتاروس“."
        },
        {
          "verse": 9,
          "usfm": "2PE.2.9",
          "note_ref": "2‏:9",
          "note_type": "footnote",
          "references": [],
          "text": "یا: «... و گنهکاران را تا روز داوری، تحت مجازات نگاه دارد»."
        },
        {
          "verse": 10,
          "usfm": "2PE.2.10",
          "note_ref": "2‏:10",
          "note_type": "footnote",
          "references": [],
          "text": "یا ”جسم“."
        },
        {
