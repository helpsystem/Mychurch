  "chapters": [
    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 1,
      "chapter_usfm": "TIT.1",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.1.1",
          "line_type": "p",
          "text": "از پولس، خادم خدا و رسول عیسی مسیح، در خدمتِ ایمانِ برگزیدگانِ خدا و شناخت آن حقیقت که منطبق بر دینداری است،"
        },
        {
          "verse": 2,
          "usfm": "TIT.1.2",
          "line_type": "p",
          "text": "و به امید حیات جاویدان که خدای منزّه از هر دروغ از ایام ازل بدان وعده فرمود"
        },
        {
          "verse": 3,
          "usfm": "TIT.1.3",
          "line_type": "p",
          "text": "و کلام خود را در زمان مقرر آشکار ساخت، به واسطۀ موعظه‌ای که به حکم نجات‌دهندۀ ما خدا به من سپرده شد،"
        },
        {
          "verse": 4,
          "usfm": "TIT.1.4",
          "line_type": "p",
          "text": "به تیتوس، فرزند راستینم در ایمانی مشترک:فیض و سلامتی از جانب خدای پدر و نجات‌دهندۀ ما عیسی مسیح بر تو باد."
        },
        {
          "verse": 5,
          "usfm": "TIT.1.5",
          "line_type": "p",
          "text": "تو را از آن رو در کْرِت بر جا گذاشتم تا کارهای ناتمام را سامان دهی و همان‌گونه که تو را امر کردم، در هر شهر مشایخی برگماری."
        },
        {
          "verse": 6,
          "usfm": "TIT.1.6",
          "line_type": "p",
          "text": "شیخ کلیسا باید به دور از ملامت، شوهرِ وفادارِ یک زن، و دارای فرزندانی باایمان باشد که از هر گونه اتهامِ لجام گسیختگی و سرکشی مبرا باشند."
        },
        {
          "verse": 7,
          "usfm": "TIT.1.7",
          "line_type": "p",
          "text": "چرا که ناظر کلیسا مباشر خداست و از همین رو باید به دور از ملامت باشد، نه خودرأی یا تندخو یا میگسار یا خشن یا در پی منافع نامشروع،"
        },
        {
          "verse": 8,
          "usfm": "TIT.1.8",
          "line_type": "p",
          "text": "بلکه شهره به میهمان‌نوازی و دوستدارِ نیکویی و خویشتندار و پارسا و مقدّس و منظم؛"
        },
        {
          "verse": 9,
          "usfm": "TIT.1.9",
          "line_type": "p",
          "text": "و پایدار بر کلام مطمئنی که تعلیم داده شده است تا بتواند دیگران را بر پایۀ تعلیم صحیح پند دهد و نظر مخالفان را رد کند."
        },
        {
          "verse": 10,
          "usfm": "TIT.1.10",
          "line_type": "p",
          "text": "زیرا گردنکشانِ یاوه‌گوی و فریبکار بسیارند، بخصوص از ختنه‌شدگان،"
        },
        {
          "verse": 11,
          "usfm": "TIT.1.11",
          "line_type": "p",
          "text": "که دهانشان را باید بست، زیرا برای کسب منافع نامشروع، تعالیم ناشایسته می‌دهند و بدین‌گونه خانواده‌ها را به تمامی تباه می‌سازند."
        },
        {
          "verse": 12,
          "usfm": "TIT.1.12",
          "line_type": "p",
          "text": "حتی یکی از انبیای خودشان گفته است: «کْرِتیان همواره مردمانی دروغگو و وحوشی شریر و شکم‌پرستانی تن‌پرورند.»"
        },
        {
          "verse": 13,
          "usfm": "TIT.1.13",
          "line_type": "p",
          "text": "این شهادت راست است. پس آنان را سخت توبیخ کن تا از سلامتِ ایمان برخوردار باشند و"
        },
        {
          "verse": 14,
          "usfm": "TIT.1.14",
          "line_type": "p",
          "text": "به افسانه‌های یهود و احکامِ منکرانِ حقیقت گوش نسپارند."
        },
        {
          "verse": 15,
          "usfm": "TIT.1.15",
          "line_type": "p",
          "text": "برای پاکان همه چیزْ پاک است، امّا برای آنان که آلوده‌اند و بی‌ایمان، هیچ چیز پاک نیست، بلکه هم فکرشان آلوده است و هم وجدانشان."
        },
        {
          "verse": 16,
          "usfm": "TIT.1.16",
          "line_type": "p",
          "text": "مدّعی خداشناسی‌اند، امّا با کردارشان او را انکار می‌کنند. نفرت‌انگیزند و نافرمان، و نامناسب برای هر کار نیکو."
        }
      ],
      "verse_count": 16,
      "headings": [
        {
          "before_verse": 5,
          "text": "مأموریت تیتوس در کْرِت"
        }
      ],
      "footnotes": [
        {
          "verse": 1,
          "usfm": "TIT.1.1",
          "note_ref": "1‏:1",
          "note_type": "footnote",
          "references": [],
          "text": "یا ”غلام“."
        },
        {
          "verse": 2,
          "usfm": "TIT.1.2",
          "note_ref": "1‏:2",
          "note_type": "footnote",
          "references": [],
          "text": "یا:‏ «و بر امید حیات جاویدان استوار است که ...»."
        },
        {
