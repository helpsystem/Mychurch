    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 2,
      "chapter_usfm": "TIT.2",
      "version_id": 118,
      "version_abbr": "NMV",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.2.1",
          "line_type": "p",
          "text": "امّا تو از آنچه مطابق با تعلیم صحیح است، سخن بگو."
        },
        {
          "verse": 2,
          "usfm": "TIT.2.2",
          "line_type": "p",
          "text": "مردان سالخورده را بگو که معتدل و باوقار و خویشتندار باشند و در ایمان و محبت و پایداری، به شایستگی رفتار کنند."
        },
        {
          "verse": 3,
          "usfm": "TIT.2.3",
          "line_type": "p",
          "text": "به همین‌سان، زنان سالخورده باید شیوۀ زندگی محترمانه‌ای داشته باشند. نباید غیبت‌گو یا بندۀ شراب باشند، بلکه باید آنچه را که نیکوست تعلیم دهند،"
        },
        {
          "verse": 4,
          "usfm": "TIT.2.4",
          "line_type": "p",
          "text": "تا بتوانند زنان جوانتر را خرد بیاموزند که شوهردوست و فرزنددوست باشند"
        },
        {
          "verse": 5,
          "usfm": "TIT.2.5",
          "line_type": "p",
          "text": "و خویشتندار و عفیف و کدبانو و مهربان و تسلیمِ شوهر، تا کلام خدا بد گفته نشود."
        },
        {
          "verse": 6,
          "usfm": "TIT.2.6",
          "line_type": "p",
          "text": "نیز مردان جوان را پند ده تا خویشتندار باشند."
        },
        {
          "verse": 7,
          "usfm": "TIT.2.7",
          "line_type": "p",
          "text": "خودْ در همه چیز سرمشقِ اعمال نیکو باش. در تعلیم خود صداقت و جدیّت به خرج ده،"
        },
        {
          "verse": 8,
          "usfm": "TIT.2.8",
          "line_type": "p",
          "text": "و سلامتِ گفتارت چنان باشد که کسی آن را مذمّت نتواند کرد، تا مخالفان چون فرصت بد گفتن از ما نیابند، شرمسار شوند."
        },
        {
          "verse": 9,
          "usfm": "TIT.2.9",
          "line_type": "p",
          "text": "غلامان را بیاموز که در هر چیز تسلیم اربابانشان باشند و برای جلب خشنودی آنها بکوشند؛ و چون و چرا نکنند"
        },
        {
          "verse": 10,
          "usfm": "TIT.2.10",
          "line_type": "p",
          "text": "و از آنان ندزدند، بلکه کمال امانت را نشان دهند تا در هر چیز تعلیم مربوط به نجات‌دهندۀ ما خدا را زینت بخشند."
        },
        {
          "verse": 11,
          "usfm": "TIT.2.11",
          "line_type": "p",
          "text": "زیرا فیض خدا به ظهور رسیده است، فیضی که همگان را نجات‌بخش است"
        },
        {
          "verse": 12,
          "usfm": "TIT.2.12",
          "line_type": "p",
          "text": "و به ما می‌آموزد که بی‌دینی و امیال دنیوی را ترک گفته، با خویشتنداری و پارسایی و دینداری در این عصر زیست کنیم،"
        },
        {
          "verse": 13,
          "usfm": "TIT.2.13",
          "line_type": "p",
          "text": "در حینی که منتظر آن امید مبارک، یعنی ظهور پرجلال خدای عظیم و نجات‌دهندۀ خویش عیسی مسیح هستیم،"
        },
        {
          "verse": 14,
          "usfm": "TIT.2.14",
          "line_type": "p",
          "text": "که خود را فدای ما ساخت تا از هر شرارت رهایی‌مان بخشد و قومی برای خود طاهر سازد که از آنِ خودش باشند و غیور برای کار نیکو."
        },
        {
          "verse": 15,
          "usfm": "TIT.2.15",
          "line_type": "p",
          "text": "اینها را بگو، و با کمال اقتدار تشویق و توبیخ کن، و مگذار کسی تو را حقیر شمارد."
        }
      ],
      "verse_count": 15,
      "headings": [],
      "footnotes": [
        {
          "verse": 12,
          "usfm": "TIT.2.12",
          "note_ref": "2‏:12",
          "note_type": "footnote",
          "references": [],
          "text": "یا:‏ ”در این دنیا“."
        },
        {
          "verse": 14,
          "usfm": "TIT.2.14",
          "note_ref": "2‏:14",
          "note_type": "footnote",
          "references": [],
          "text": "یا:‏ «بازخریدمان کند». اصل یونانی این فعل، در بسیاری مواقع حاوی مفهوم رهانیدن بردگان اسیر با پرداخت بها است."
        }
      ],
