  "chapters": [
    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 1,
      "chapter_usfm": "TIT.1",
      "version_id": 100,
      "version_abbr": "NASB1995",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.1.1",
          "line_type": "p",
          "text": "Paul, a bond-servant of God and an apostle of Jesus Christ, for the faith of those chosen of God and the knowledge of the truth which is according to godliness,"
        },
        {
          "verse": 2,
          "usfm": "TIT.1.2",
          "line_type": "p",
          "text": "in the hope of eternal life, which God, who cannot lie, promised long ages ago,"
        },
        {
          "verse": 3,
          "usfm": "TIT.1.3",
          "line_type": "p",
          "text": "but at the proper time manifested, even His word, in the proclamation with which I was entrusted according to the commandment of God our Savior,"
        },
        {
          "verse": 4,
          "usfm": "TIT.1.4",
          "line_type": "p",
          "text": "To Titus, my true child in a common faith: Grace and peace from God the Father and Christ Jesus our Savior."
        },
        {
          "verse": 5,
          "usfm": "TIT.1.5",
          "line_type": "p",
          "text": "For this reason I left you in Crete, that you would set in order what remains and appoint elders in every city as I directed you,"
        },
        {
          "verse": 6,
          "usfm": "TIT.1.6",
          "line_type": "p",
          "text": "namely, if any man is above reproach, the husband of one wife, having children who believe, not accused of dissipation or rebellion."
        },
        {
          "verse": 7,
          "usfm": "TIT.1.7",
          "line_type": "p",
          "text": "For the overseer must be above reproach as God’s steward, not self-willed, not quick-tempered, not addicted to wine, not pugnacious, not fond of sordid gain,"
        },
        {
          "verse": 8,
          "usfm": "TIT.1.8",
          "line_type": "p",
          "text": "but hospitable, loving what is good, sensible, just, devout, self-controlled,"
        },
        {
          "verse": 9,
          "usfm": "TIT.1.9",
          "line_type": "p",
          "text": "holding fast the faithful word which is in accordance with the teaching, so that he will be able both to exhort in sound doctrine and to refute those who contradict."
        },
        {
          "verse": 10,
          "usfm": "TIT.1.10",
          "line_type": "p",
          "text": "For there are many rebellious men, empty talkers and deceivers, especially those of the circumcision,"
        },
        {
          "verse": 11,
          "usfm": "TIT.1.11",
          "line_type": "p",
          "text": "who must be silenced because they are upsetting whole families, teaching things they should not teach for the sake of sordid gain."
        },
        {
          "verse": 12,
          "usfm": "TIT.1.12",
          "line_type": "p",
          "text": "One of themselves, a prophet of their own, said, “Cretans are always liars, evil beasts, lazy gluttons.”"
        },
        {
          "verse": 13,
          "usfm": "TIT.1.13",
          "line_type": "p",
          "text": "This testimony is true. For this reason reprove them severely so that they may be sound in the faith,"
        },
        {
          "verse": 14,
          "usfm": "TIT.1.14",
          "line_type": "p",
          "text": "not paying attention to Jewish myths and commandments of men who turn away from the truth."
        },
        {
          "verse": 15,
          "usfm": "TIT.1.15",
          "line_type": "p",
          "text": "To the pure, all things are pure; but to those who are defiled and unbelieving, nothing is pure, but both their mind and their conscience are defiled."
        },
        {
          "verse": 16,
          "usfm": "TIT.1.16",
          "line_type": "p",
          "text": "They profess to know God, but by their deeds they deny Him, being detestable and disobedient and worthless for any good deed."
        }
      ],
      "verse_count": 16,
      "headings": [
        {
          "before_verse": 5,
          "text": "Qualifications of Elders"
        }
      ],
