  "chapters": [
    {
      "schema_version": 6,
      "book_id": "OBA",
      "chapter": 1,
      "chapter_usfm": "OBA.1",
      "version_id": 100,
      "version_abbr": "NASB1995",
      "verses": [
        {
          "verse": 1,
          "usfm": "OBA.1.1",
          "line_type": "p",
          "text": "The vision of Obadiah.Thus says the Lord God concerning Edom—We have heard a report from the Lord,And an envoy has been sent among the nations saying,“Arise and let us go against her for battle”—"
        },
        {
          "verse": 2,
          "usfm": "OBA.1.2",
          "line_type": "q",
          "text": "“Behold, I will make you small among the nations;You are greatly despised."
        },
        {
          "verse": 3,
          "usfm": "OBA.1.3",
          "line_type": "q",
          "text": "The arrogance of your heart has deceived you,You who live in the clefts of the rock,In the loftiness of your dwelling place,Who say in your heart,‘Who will bring me down to earth?’"
        },
        {
          "verse": 4,
          "usfm": "OBA.1.4",
          "line_type": "q",
          "text": "Though you build high like the eagle,Though you set your nest among the stars,From there I will bring you down,” declares the Lord."
        },
        {
          "verse": 5,
          "usfm": "OBA.1.5",
          "line_type": "q",
          "text": "“If thieves came to you,If robbers by night—O how you will be ruined!—Would they not steal only until they had enough?If grape gatherers came to you,Would they not leave some gleanings?"
        },
        {
          "verse": 6,
          "usfm": "OBA.1.6",
          "line_type": "q",
          "text": "O how Esau will be ransacked, And his hidden treasures searched out!"
        },
        {
          "verse": 7,
          "usfm": "OBA.1.7",
          "line_type": "q",
          "text": "All the men allied with youWill send you forth to the border,And the men at peace with youWill deceive you and overpower you. They who eat your breadWill set an ambush for you.(There is no understanding in him.)"
        },
        {
          "verse": 8,
          "usfm": "OBA.1.8",
          "line_type": "q",
          "text": "Will I not on that day,” declares the Lord,“Destroy wise men from EdomAnd understanding from the mountain of Esau?"
        },
        {
          "verse": 9,
          "usfm": "OBA.1.9",
          "line_type": "q",
          "text": "Then your mighty men will be dismayed, O Teman,So that everyone may be cut off from the mountain of Esau by slaughter."
        },
        {
          "verse": 10,
          "usfm": "OBA.1.10",
          "line_type": "q",
          "text": "“Because of violence to your brother Jacob,You will be covered with shame,And you will be cut off forever."
        },
        {
          "verse": 11,
          "usfm": "OBA.1.11",
          "line_type": "q",
          "text": "On the day that you stood aloof,On the day that strangers carried off his wealth,And foreigners entered his gateAnd cast lots for Jerusalem—You too were as one of them."
        },
        {
          "verse": 12,
          "usfm": "OBA.1.12",
          "line_type": "q",
          "text": "Do not gloat over your brother’s day,The day of his misfortune.And do not rejoice over the sons of JudahIn the day of their destruction;Yes, do not boastIn the day of their distress."
        },
        {
          "verse": 13,
          "usfm": "OBA.1.13",
          "line_type": "q",
          "text": "Do not enter the gate of My peopleIn the day of their disaster.Yes, you, do not gloat over their calamityIn the day of their disaster.And do not loot their wealthIn the day of their disaster."
        },
        {
          "verse": 14,
          "usfm": "OBA.1.14",
          "line_type": "q",
          "text": "Do not stand at the fork of the roadTo cut down their fugitives;And do not imprison their survivorsIn the day of their distress."
        },
        {
          "verse": 15,
          "usfm": "OBA.1.15",
          "line_type": "q",
          "text": "“For the day of the Lord draws near on all the nations.As you have done, it will be done to you.Your dealings will return on your own head."
        },
        {
          "verse": 16,
          "usfm": "OBA.1.16",
          "line_type": "q",
          "text": "Because just as you drank on My holy mountain,All the nations will drink continually.They will drink and swallowAnd become as if they had never existed."
        },
        {
          "verse": 17,
          "usfm": "OBA.1.17",
          "line_type": "q",
          "text": "But on Mount Zion there will be those who escape,And it will be holy.And the house of Jacob will possess their possessions."
        },
        {
          "verse": 18,
          "usfm": "OBA.1.18",
          "line_type": "q",
          "text": "Then the house of Jacob will be a fireAnd the house of Joseph a flame;But the house of Esau will be as stubble.And they will set them on fire and consume them,So that there will be no survivor of the house of Esau,”For the Lord has spoken."
        },
        {
          "verse": 19,
          "usfm": "OBA.1.19",
          "line_type": "q",
          "text": "Then those of the Negev will possess the mountain of Esau,And those of the Shephelah the Philistine plain;Also, possess the territory of Ephraim and the territory of Samaria,And Benjamin will possess Gilead."
        },
        {
          "verse": 20,
          "usfm": "OBA.1.20",
          "line_type": "q",
          "text": "And the exiles of this host of the sons of Israel,Who are among the Canaanites as far as Zarephath,And the exiles of Jerusalem who are in SepharadWill possess the cities of the Negev."
        },
        {
          "verse": 21,
          "usfm": "OBA.1.21",
          "line_type": "q",
          "text": "The deliverers will ascend Mount ZionTo judge the mountain of Esau,And the kingdom will be the Lord’s."
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 15,
          "text": "The Day of the L"
        },
        {
          "before_verse": 15,
