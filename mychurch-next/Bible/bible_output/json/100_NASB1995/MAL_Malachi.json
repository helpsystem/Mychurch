    {
      "schema_version": 6,
      "book_id": "MAL",
      "chapter": 3,
      "chapter_usfm": "MAL.3",
      "version_id": 100,
      "version_abbr": "NASB1995",
      "verses": [
        {
          "verse": 1,
          "usfm": "MAL.3.1",
          "line_type": "p",
          "text": "“Behold, I am going to send My messenger, and he will clear the way before Me. And the Lord, whom you seek, will suddenly come to His temple; and the messenger of the covenant, in whom you delight, behold, He is coming,” says the Lord of hosts."
        },
        {
          "verse": 2,
          "usfm": "MAL.3.2",
          "line_type": "p",
          "text": "“But who can endure the day of His coming? And who can stand when He appears? For He is like a refiner’s fire and like fullers’ soap."
        },
        {
          "verse": 3,
          "usfm": "MAL.3.3",
          "line_type": "p",
          "text": "He will sit as a smelter and purifier of silver, and He will purify the sons of Levi and refine them like gold and silver, so that they may present to the Lord offerings in righteousness."
        },
        {
          "verse": 4,
          "usfm": "MAL.3.4",
          "line_type": "p",
          "text": "Then the offering of Judah and Jerusalem will be pleasing to the Lord as in the days of old and as in former years."
        },
        {
          "verse": 5,
          "usfm": "MAL.3.5",
          "line_type": "p",
          "text": "“Then I will draw near to you for judgment; and I will be a swift witness against the sorcerers and against the adulterers and against those who swear falsely, and against those who oppress the wage earner in his wages, the widow and the orphan, and those who turn aside the alien and do not fear Me,” says the Lord of hosts."
        },
        {
          "verse": 6,
          "usfm": "MAL.3.6",
          "line_type": "p",
          "text": "“For I, the Lord, do not change; therefore you, O sons of Jacob, are not consumed."
        },
        {
          "verse": 7,
          "usfm": "MAL.3.7",
          "line_type": "p",
          "text": "“From the days of your fathers you have turned aside from My statutes and have not kept them. Return to Me, and I will return to you,” says the Lord of hosts. “But you say, ‘How shall we return?’"
        },
        {
          "verse": 8,
          "usfm": "MAL.3.8",
          "line_type": "p",
          "text": "“Will a man rob God? Yet you are robbing Me! But you say, ‘How have we robbed You?’ In tithes and offerings."
        },
        {
          "verse": 9,
          "usfm": "MAL.3.9",
          "line_type": "p",
          "text": "You are cursed with a curse, for you are robbing Me, the whole nation of you!"
        },
        {
          "verse": 10,
          "usfm": "MAL.3.10",
          "line_type": "p",
          "text": "Bring the whole tithe into the storehouse, so that there may be food in My house, and test Me now in this,” says the Lord of hosts, “if I will not open for you the windows of heaven and pour out for you a blessing until it overflows."
        },
        {
          "verse": 11,
          "usfm": "MAL.3.11",
          "line_type": "p",
          "text": "Then I will rebuke the devourer for you, so that it will not destroy the fruits of the ground; nor will your vine in the field cast its grapes,” says the Lord of hosts."
        },
        {
          "verse": 12,
          "usfm": "MAL.3.12",
          "line_type": "p",
          "text": "“All the nations will call you blessed, for you shall be a delightful land,” says the Lord of hosts."
        },
        {
          "verse": 13,
          "usfm": "MAL.3.13",
          "line_type": "p",
          "text": "“Your words have been arrogant against Me,” says the Lord. “Yet you say, ‘What have we spoken against You?’"
        },
        {
          "verse": 14,
          "usfm": "MAL.3.14",
          "line_type": "p",
          "text": "You have said, ‘It is vain to serve God; and what profit is it that we have kept His charge, and that we have walked in mourning before the Lord of hosts?"
        },
        {
          "verse": 15,
          "usfm": "MAL.3.15",
          "line_type": "p",
          "text": "So now we call the arrogant blessed; not only are the doers of wickedness built up but they also test God and escape.’ ”"
        },
        {
          "verse": 16,
          "usfm": "MAL.3.16",
          "line_type": "p",
          "text": "Then those who feared the Lord spoke to one another, and the Lord gave attention and heard it, and a book of remembrance was written before Him for those who fear the Lord and who esteem His name."
        },
        {
          "verse": 17,
          "usfm": "MAL.3.17",
          "line_type": "p",
          "text": "“They will be Mine,” says the Lord of hosts, “on the day that I prepare My own possession, and I will spare them as a man spares his own son who serves him.”"
        },
        {
          "verse": 18,
          "usfm": "MAL.3.18",
          "line_type": "p",
          "text": "So you will again distinguish between the righteous and the wicked, between one who serves God and one who does not serve Him."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 8,
          "text": "You Have Robbed God"
        },
        {
          "before_verse": 16,
          "text": "The Book of Remembrance"
        }
      ],
      "footnotes": [
