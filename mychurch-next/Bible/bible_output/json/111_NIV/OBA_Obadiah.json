  "chapters": [
    {
      "schema_version": 6,
      "book_id": "OBA",
      "chapter": 1,
      "chapter_usfm": "OBA.1",
      "version_id": 111,
      "version_abbr": "NIV",
      "verses": [
        {
          "verse": 1,
          "usfm": "OBA.1.1",
          "line_type": "p",
          "text": "The vision of Obadiah.This is what the Sovereign Lord says about Edom—We have heard a message from the Lord:An envoy was sent to the nations to say,“Rise, let us go against her for battle”—"
        },
        {
          "verse": 2,
          "usfm": "OBA.1.2",
          "line_type": "q1",
          "text": "“See, I will make you small among the nations;you will be utterly despised."
        },
        {
          "verse": 3,
          "usfm": "OBA.1.3",
          "line_type": "q1",
          "text": "The pride of your heart has deceived you,you who live in the clefts of the rocksand make your home on the heights,you who say to yourself,‘Who can bring me down to the ground?’"
        },
        {
          "verse": 4,
          "usfm": "OBA.1.4",
          "line_type": "q1",
          "text": "Though you soar like the eagleand make your nest among the stars,from there I will bring you down,”declares the Lord."
        },
        {
          "verse": 5,
          "usfm": "OBA.1.5",
          "line_type": "q1",
          "text": "“If thieves came to you,if robbers in the night—oh, what a disaster awaits you!—would they not steal only as much as they wanted?If grape pickers came to you,would they not leave a few grapes?"
        },
        {
          "verse": 6,
          "usfm": "OBA.1.6",
          "line_type": "q1",
          "text": "But how Esau will be ransacked,his hidden treasures pillaged!"
        },
        {
          "verse": 7,
          "usfm": "OBA.1.7",
          "line_type": "q1",
          "text": "All your allies will force you to the border;your friends will deceive and overpower you;those who eat your bread will set a trap for you,but you will not detect it."
        },
        {
          "verse": 8,
          "usfm": "OBA.1.8",
          "line_type": "q1",
          "text": "“In that day,” declares the Lord,“will I not destroy the wise men of Edom,those of understanding in the mountains of Esau?"
        },
        {
          "verse": 9,
          "usfm": "OBA.1.9",
          "line_type": "q1",
          "text": "Your warriors, Teman, will be terrified,and everyone in Esau’s mountainswill be cut down in the slaughter."
        },
        {
          "verse": 10,
          "usfm": "OBA.1.10",
          "line_type": "q1",
          "text": "Because of the violence against your brother Jacob,you will be covered with shame;you will be destroyed forever."
        },
        {
          "verse": 11,
          "usfm": "OBA.1.11",
          "line_type": "q1",
          "text": "On the day you stood aloofwhile strangers carried off his wealthand foreigners entered his gatesand cast lots for Jerusalem,you were like one of them."
        },
        {
          "verse": 12,
          "usfm": "OBA.1.12",
          "line_type": "q1",
          "text": "You should not gloat over your brotherin the day of his misfortune,nor rejoice over the people of Judahin the day of their destruction,nor boast so muchin the day of their trouble."
        },
        {
          "verse": 13,
          "usfm": "OBA.1.13",
          "line_type": "q1",
          "text": "You should not march through the gates of my peoplein the day of their disaster,nor gloat over them in their calamityin the day of their disaster,nor seize their wealthin the day of their disaster."
        },
        {
          "verse": 14,
          "usfm": "OBA.1.14",
          "line_type": "q1",
          "text": "You should not wait at the crossroadsto cut down their fugitives,nor hand over their survivorsin the day of their trouble."
        },
        {
          "verse": 15,
          "usfm": "OBA.1.15",
          "line_type": "q1",
          "text": "“The day of the Lord is nearfor all nations.As you have done, it will be done to you;your deeds will return upon your own head."
        },
        {
          "verse": 16,
          "usfm": "OBA.1.16",
          "line_type": "q1",
          "text": "Just as you drank on my holy hill,so all the nations will drink continually;they will drink and drinkand be as if they had never been."
        },
        {
          "verse": 17,
          "usfm": "OBA.1.17",
          "line_type": "q1",
          "text": "But on Mount Zion will be deliverance;it will be holy,and Jacob will possess his inheritance."
        },
        {
          "verse": 18,
          "usfm": "OBA.1.18",
          "line_type": "q1",
          "text": "Jacob will be a fireand Joseph a flame;Esau will be stubble,and they will set him on fire and destroy him.There will be no survivorsfrom Esau.”The Lord has spoken."
        },
        {
          "verse": 19,
          "usfm": "OBA.1.19",
          "line_type": "q1",
          "text": "People from the Negev will occupythe mountains of Esau,and people from the foothills will possessthe land of the Philistines.They will occupy the fields of Ephraim and Samaria,and Benjamin will possess Gilead."
        },
        {
          "verse": 20,
          "usfm": "OBA.1.20",
          "line_type": "q1",
          "text": "This company of Israelite exiles who are in Canaanwill possess the land as far as Zarephath;the exiles from Jerusalem who are in Sepharadwill possess the towns of the Negev."
        },
        {
          "verse": 21,
          "usfm": "OBA.1.21",
          "line_type": "q1",
          "text": "Deliverers will go up on Mount Zionto govern the mountains of Esau.And the kingdom will be the Lord’s."
        }
      ],
      "verse_count": 21,
