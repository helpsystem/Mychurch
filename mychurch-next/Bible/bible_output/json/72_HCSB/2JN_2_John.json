      "version_abbr": "HCSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2JN.1.1",
          "line_type": "p",
          "text": "The Elder: To the elect lady and her children: I love all of you in the truth — and not only I, but also all who have come to know the truth —"
        },
        {
          "verse": 2,
          "usfm": "2JN.1.2",
          "line_type": "p",
          "text": "because of the truth that remains in us and will be with us forever."
        },
        {
          "verse": 3,
          "usfm": "2JN.1.3",
          "line_type": "p",
          "text": "Grace, mercy, and peace will be with us from God the Father and from Jesus Christ, the Son of the Father, in truth and love."
        },
        {
          "verse": 4,
          "usfm": "2JN.1.4",
          "line_type": "p",
          "text": "I was very glad to find some of your children walking in the truth, in keeping with a command we have received from the Father."
        },
        {
          "verse": 5,
          "usfm": "2JN.1.5",
          "line_type": "p",
          "text": "So now I urge you, dear lady — not as if I were writing you a new command, but one we have had from the beginning — that we love one another."
        },
        {
          "verse": 6,
          "usfm": "2JN.1.6",
          "line_type": "p",
          "text": "And this is love: that we walk according to His commands. This is the command as you have heard it from the beginning: you must walk in love."
        },
        {
          "verse": 7,
          "usfm": "2JN.1.7",
          "line_type": "p",
          "text": "Many deceivers have gone out into the world; they do not confess the coming of Jesus Christ in the flesh. This is the deceiver and the antichrist."
        },
        {
          "verse": 8,
          "usfm": "2JN.1.8",
          "line_type": "p",
          "text": "Watch yourselves so you don’t lose what we have worked for, but that you may receive a full reward."
        },
        {
          "verse": 9,
          "usfm": "2JN.1.9",
          "line_type": "p",
          "text": "Anyone who does not remain in Christ’s teaching but goes beyond it, does not have God. The one who remains in that teaching, this one has both the Father and the Son."
        },
        {
          "verse": 10,
          "usfm": "2JN.1.10",
          "line_type": "p",
          "text": "If anyone comes to you and does not bring this teaching, do not receive him into your home, and don’t say, “Welcome,” to him;"
        },
        {
          "verse": 11,
          "usfm": "2JN.1.11",
          "line_type": "p",
          "text": "for the one who says, “Welcome,” to him shares in his evil works."
        },
        {
          "verse": 12,
          "usfm": "2JN.1.12",
          "line_type": "p",
          "text": "Though I have many things to write to you, I don’t want to do so with paper and ink. Instead, I hope to be with you and talk face to face so that our joy may be complete."
        },
        {
          "verse": 13,
          "usfm": "2JN.1.13",
          "line_type": "p",
          "text": "The children of your elect sister send you greetings."
        }
      ],
      "verse_count": 13,
      "headings": [
        {
          "before_verse": 4,
          "text": "Truth and Deception"
        },
        {
          "before_verse": 12,
          "text": "Farewell"
        }
      ],
