      "version_id": 72,
      "version_abbr": "HCSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHM.1.1",
          "line_type": "p",
          "text": "Paul, a prisoner of Christ Jesus, and Timothy our brother:To Philemon our dear friend and coworker,"
        },
        {
          "verse": 2,
          "usfm": "PHM.1.2",
          "line_type": "p",
          "text": "to Apphia our sister, to Archippus our fellow soldier, and to the church that meets in your home."
        },
        {
          "verse": 3,
          "usfm": "PHM.1.3",
          "line_type": "p",
          "text": "Grace to you and peace from God our Father and the Lord Jesus Christ."
        },
        {
          "verse": 4,
          "usfm": "PHM.1.4",
          "line_type": "p",
          "text": "I always thank my God when I mention you in my prayers,"
        },
        {
          "verse": 5,
          "usfm": "PHM.1.5",
          "line_type": "p",
          "text": "because I hear of your love and faith toward the Lord Jesus and for all the saints."
        },
        {
          "verse": 6,
          "usfm": "PHM.1.6",
          "line_type": "p",
          "text": "I pray that your participation in the faith may become effective through knowing every good thing that is in us for the glory of Christ."
        },
        {
          "verse": 7,
          "usfm": "PHM.1.7",
          "line_type": "p",
          "text": "For I have great joy and encouragement from your love, because the hearts of the saints have been refreshed through you, brother."
        },
        {
          "verse": 8,
          "usfm": "PHM.1.8",
          "line_type": "p",
          "text": "For this reason, although I have great boldness in Christ to command you to do what is right,"
        },
        {
          "verse": 9,
          "usfm": "PHM.1.9",
          "line_type": "p",
          "text": "I appeal to you, instead, on the basis of love. I, Paul, as an elderly man and now also as a prisoner of Christ Jesus,"
        },
        {
          "verse": 10,
          "usfm": "PHM.1.10",
          "line_type": "p",
          "text": "appeal to you for my son, Onesimus. I fathered him while I was in chains."
        },
        {
          "verse": 11,
          "usfm": "PHM.1.11",
          "line_type": "p",
          "text": "Once he was useless to you, but now he is useful both to you and to me."
        },
        {
          "verse": 12,
          "usfm": "PHM.1.12",
          "line_type": "p",
          "text": "I am sending him back to you as a part of myself."
        },
        {
          "verse": 13,
          "usfm": "PHM.1.13",
          "line_type": "p",
          "text": "I wanted to keep him with me, so that in my imprisonment for the gospel he might serve me in your place."
        },
        {
          "verse": 14,
          "usfm": "PHM.1.14",
          "line_type": "p",
          "text": "But I didn’t want to do anything without your consent, so that your good deed might not be out of obligation, but of your own free will."
        },
        {
          "verse": 15,
          "usfm": "PHM.1.15",
          "line_type": "p",
          "text": "For perhaps this is why he was separated from you for a brief time, so that you might get him back permanently,"
        },
        {
          "verse": 16,
          "usfm": "PHM.1.16",
          "line_type": "p",
          "text": "no longer as a slave, but more than a slave — as a dearly loved brother. He is especially so to me, but even more to you, both in the flesh and in the Lord."
        },
        {
          "verse": 17,
          "usfm": "PHM.1.17",
          "line_type": "p",
          "text": "So if you consider me a partner, accept him as you would me."
        },
        {
          "verse": 18,
          "usfm": "PHM.1.18",
          "line_type": "p",
          "text": "And if he has wronged you in any way, or owes you anything, charge that to my account."
        },
        {
          "verse": 19,
          "usfm": "PHM.1.19",
          "line_type": "p",
          "text": "I, Paul, write this with my own hand: I will repay it — not to mention to you that you owe me even your own self."
        },
        {
          "verse": 20,
          "usfm": "PHM.1.20",
          "line_type": "p",
          "text": "Yes, brother, may I have joy from you in the Lord; refresh my heart in Christ."
        },
        {
          "verse": 21,
          "usfm": "PHM.1.21",
          "line_type": "p",
          "text": "Since I am confident of your obedience, I am writing to you, knowing that you will do even more than I say."
        },
        {
          "verse": 22,
          "usfm": "PHM.1.22",
          "line_type": "p",
          "text": "But meanwhile, also prepare a guest room for me, for I hope that through your prayers I will be restored to you."
        },
        {
          "verse": 23,
          "usfm": "PHM.1.23",
          "line_type": "p",
          "text": "Epaphras, my fellow prisoner in Christ Jesus, greets you, and so do"
        },
        {
          "verse": 24,
          "usfm": "PHM.1.24",
          "line_type": "p",
          "text": "Mark, Aristarchus, Demas, and Luke, my coworkers."
        },
        {
          "verse": 25,
          "usfm": "PHM.1.25",
          "line_type": "p",
          "text": "The grace of the Lord Jesus Christ be with your spirit."
        }
      ],
      "verse_count": 25,
