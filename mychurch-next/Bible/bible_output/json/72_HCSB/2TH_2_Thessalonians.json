    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 2,
      "chapter_usfm": "2TH.2",
      "version_id": 72,
      "version_abbr": "HCSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.2.1",
          "line_type": "p",
          "text": "Now concerning the coming of our Lord Jesus Christ and our being gathered to Him: We ask you, brothers,"
        },
        {
          "verse": 2,
          "usfm": "2TH.2.2",
          "line_type": "p",
          "text": "not to be easily upset in mind or troubled, either by a spirit or by a message or by a letter as if from us, alleging that the Day of the Lord has come."
        },
        {
          "verse": 3,
          "usfm": "2TH.2.3",
          "line_type": "p",
          "text": "Don’t let anyone deceive you in any way. For that day will not come unless the apostasy comes first and the man of lawlessness is revealed, the son of destruction."
        },
        {
          "verse": 4,
          "usfm": "2TH.2.4",
          "line_type": "p",
          "text": "He opposes and exalts himself above every so-called god or object of worship, so that he sits in God’s sanctuary, publicizing that he himself is God."
        },
        {
          "verse": 5,
          "usfm": "2TH.2.5",
          "line_type": "p",
          "text": "Don’t you remember that when I was still with you I told you about this?"
        },
        {
          "verse": 6,
          "usfm": "2TH.2.6",
          "line_type": "p",
          "text": "And you know what currently restrains him, so that he will be revealed in his time."
        },
        {
          "verse": 7,
          "usfm": "2TH.2.7",
          "line_type": "p",
          "text": "For the mystery of lawlessness is already at work, but the one now restraining will do so until he is out of the way,"
        },
        {
          "verse": 8,
          "usfm": "2TH.2.8",
          "line_type": "p",
          "text": "and then the lawless one will be revealed. The Lord Jesus will destroy him with the breath of His mouth and will bring him to nothing with the brightness of His coming."
        },
        {
          "verse": 9,
          "usfm": "2TH.2.9",
          "line_type": "p",
          "text": "The coming of the lawless one is based on Satan’s working, with all kinds of false miracles, signs, and wonders,"
        },
        {
          "verse": 10,
          "usfm": "2TH.2.10",
          "line_type": "p",
          "text": "and with every unrighteous deception among those who are perishing. They perish because they did not accept the love of the truth in order to be saved."
        },
        {
          "verse": 11,
          "usfm": "2TH.2.11",
          "line_type": "p",
          "text": "For this reason God sends them a strong delusion so that they will believe what is false,"
        },
        {
          "verse": 12,
          "usfm": "2TH.2.12",
          "line_type": "p",
          "text": "so that all will be condemned — those who did not believe the truth but enjoyed unrighteousness."
        },
        {
          "verse": 13,
          "usfm": "2TH.2.13",
          "line_type": "p",
          "text": "But we must always thank God for you, brothers loved by the Lord, because from the beginning God has chosen you for salvation through sanctification by the Spirit and through belief in the truth."
        },
        {
          "verse": 14,
          "usfm": "2TH.2.14",
          "line_type": "p",
          "text": "He called you to this through our gospel, so that you might obtain the glory of our Lord Jesus Christ."
        },
        {
          "verse": 15,
          "usfm": "2TH.2.15",
          "line_type": "p",
          "text": "Therefore, brothers, stand firm and hold to the traditions you were taught, either by our message or by our letter."
        },
        {
          "verse": 16,
          "usfm": "2TH.2.16",
          "line_type": "p",
          "text": "May our Lord Jesus Christ Himself and God our Father, who has loved us and given us eternal encouragement and good hope by grace,"
        },
        {
          "verse": 17,
          "usfm": "2TH.2.17",
          "line_type": "p",
          "text": "encourage your hearts and strengthen you in every good work and word."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 13,
          "text": "Stand Firm"
        }
      ],
