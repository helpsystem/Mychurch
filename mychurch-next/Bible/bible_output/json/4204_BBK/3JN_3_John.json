  "chapters": [
    {
      "schema_version": 6,
      "book_id": "3JN",
      "chapter": 1,
      "chapter_usfm": "3JN.1",
      "version_id": 4204,
      "version_abbr": "BBK",
      "verses": [
        {
          "verse": 1,
          "usfm": "3JN.1.1",
          "line_type": "p",
          "text": "اَ مه شیخ،به گایوس عزیز که به اُ در ’حکیکت‘ دوست اُمهَه."
        },
        {
          "verse": 2,
          "usfm": "3JN.1.2",
          "line_type": "p",
          "text": "ای عزیز، دعا اَکُنُم اَ همه لحاظ، خوش و خُرم بِشی همیطوَم سالم و تندرست بُبی، همطو که جُنِت خوش و خُرمن."
        },
        {
          "verse": 3,
          "usfm": "3JN.1.3",
          "line_type": "p",
          "text": "چون خیلی خوشال بودُم وختی که کاکائُن هُندَن، و شهادت شُدا که تو به حکیکت وفاداری، همطو که واکعنم توو حکیکت زندگی اَکُنی."
        },
        {
          "verse": 4,
          "usfm": "3JN.1.4",
          "line_type": "p",
          "text": "هیچ چی به مه بِشتِه اَ ایی شاد ناکُن که بِشنُوُم که اولادُم توو ’حکیکت‘ زندگی اَکُنِن."
        },
        {
          "verse": 5,
          "usfm": "3JN.1.5",
          "line_type": "p",
          "text": "ای عزیز، تو توو همۀ کاروت که بِی ایی کاکائُن اَنجُم اَدِی، نِشُن اَدِی که امُنتداری مخصوصاً که ایشُ غریبه اَن."
        },
        {
          "verse": 6,
          "usfm": "3JN.1.6",
          "line_type": "p",
          "text": "اُشُ هم توو کلیسا به محبت تو شهادت شُدادِن؛ پَ کار خُبی اَکُنی اگه به اُشُ طوری که در شأن خدان، راهی سفر بُکنی."
        },
        {
          "verse": 7,
          "usfm": "3JN.1.7",
          "line_type": "p",
          "text": "چونکه اُشُ وا خاطر اُ نُم راه کَفتَن و اَ غیریهودیُن کمکی ناگیرن."
        },
        {
          "verse": 8,
          "usfm": "3JN.1.8",
          "line_type": "p",
          "text": "پَ ما بایه پشت ایطو کسوئی بَشیم تا با اُشُ توو پیش بُردِن حکیکت همکاری بُکنیم."
        },
        {
          "verse": 9,
          "usfm": "3JN.1.9",
          "line_type": "p",
          "text": "نومه ای به کلیسا اُمنوشتِن، ولی دیوتْرفیس که دوست ایشَه به خوش اَ همه بالاته بُدُنِت، اقتدار مائُو کبول ناکُن."
        },
        {
          "verse": 10,
          "usfm": "3JN.1.10",
          "line_type": "p",
          "text": "پَ اگه بیام، کارویی که اَکِردِنُ رو اَکُنُم. به چه که اَ رو غَرَض به ضدّ ما بد اَگِتُ، حالا به ایی اَم راضی نی، بلکه به کاکائُو هم راه نادِه؛ و به کسوئی هم که شاوات به کاکائُو راه هادَن، جلوشُ اَگِنتُ، اَ کلیسا دَرِشُ اَکُنت."
        },
        {
          "verse": 11,
          "usfm": "3JN.1.11",
          "line_type": "p",
          "text": "ای عزیز، بدیُ الگو خو مَکُن، بلکه خُبیُ الگو خو بُکن؛ آدم درستکار اَ خدان. آدم بدکار به خدا اینَدیدِن."
        },
        {
          "verse": 12,
          "usfm": "3JN.1.12",
          "line_type": "p",
          "text": "همۀ مردم و حتی خودِ حکیکت هم دربارۀ دیمیتریوس شهادت خُب شُدادِن، ما هم شهادت اَدِیم و اَدونی که شهادت ما راستِن."
        },
        {
          "verse": 13,
          "usfm": "3JN.1.13",
          "line_type": "p",
          "text": "چیزُی زیادی اُمهَستَه به تو بنویسُم، ولی اُمناوا وا کَلَم و مرکّب بَشِت."
        },
        {
          "verse": 14,
          "usfm": "3JN.1.14",
          "line_type": "p",
          "text": "امید اُمهَه به همی زودیُ به تو بِگینُم و رو وا رو با هم گَپ بِزِنیم."
        },
        {
          "verse": 15,
          "usfm": "3JN.1.15",
          "line_type": "p",
          "text": "سلامت بِشی!رفیکُ به تو سلام اَرِسونِن. تو هم به تک تک رفیکُ سلام بِرَسُن."
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 13,
          "text": "گَپ آخِر"
        }
      ],
