    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 2,
      "chapter_usfm": "PHP.2",
      "version_id": 4204,
      "version_abbr": "BBK",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.2.1",
          "line_type": "p",
          "text": "پَ اگه در مسیح تشویق اِبین، اگه محبت اُ باعث دلگرمیتُن، اگه در روح خدا رفاکت تُهَه، اگه مهر و همدردی تُهَه،"
        },
        {
          "verse": 2,
          "usfm": "PHP.2.2",
          "line_type": "p",
          "text": "پَ شادی مه ئو کامل بُکنی و همفکر بَشین، بِی همدگه محبت بُکنین، یَکدل و یَک رِی بَشین."
        },
        {
          "verse": 3,
          "usfm": "PHP.2.3",
          "line_type": "p",
          "text": "هیچ کاری ئو اَ سرِ خودخواهی یا تکبر مَکُنی، بلکه وا افتادگی بکیه ئو اَ خوتُ بِهتِه بُدُنی."
        },
        {
          "verse": 4,
          "usfm": "PHP.2.4",
          "line_type": "p",
          "text": "هیچِتاتُ فَکَه به فکر نَعف خویی نَبَشِت، بلکه به فکر نَعف بکیه هم بَشِت."
        },
        {
          "verse": 5,
          "usfm": "PHP.2.5",
          "line_type": "p",
          "text": "میون خوتُ همو فکریُ تُبَشِت که مسیح عیسی ایشَستَه:"
        },
        {
          "verse": 6,
          "usfm": "PHP.2.6",
          "line_type": "q1",
          "text": "اُ با ایکه وا خدا هم شکل هَستَه،به برابری خو وا خدا نچسبی،"
        },
        {
          "verse": 7,
          "usfm": "PHP.2.7",
          "line_type": "q1",
          "text": "بلکه وا گِفتِن شکل یه غُلُم به خوشبه خویی خالی ایکه،و به شباهت آدمیزاد وا دنیا هُند."
        },
        {
          "verse": 8,
          "usfm": "PHP.2.8",
          "line_type": "q1",
          "text": "و وختی که به شکل آدمیزاد در هُند،به خویی افتاده ایکه،و تا حدّ مرگ،حتی مرگ رو صلیب،مطیع بو."
        },
        {
          "verse": 9,
          "usfm": "PHP.2.9",
          "line_type": "q1",
          "text": "پَ خدا بِی اُ خیلی سرفراز ایکِردِن،و نُمی بالاته اَ همۀ نُمُ به اُ ایبَخشیدِن،"
        },
        {
          "verse": 10,
          "usfm": "PHP.2.10",
          "line_type": "q1",
          "text": "تا به نُم عیسی، هر زانویی خم بَشِت،توو آسَمُن، رو زمین و زیر زمین،"
        },
        {
          "verse": 11,
          "usfm": "PHP.2.11",
          "line_type": "q1",
          "text": "و هر زَبُنی اقرار بُکنت که عیسی مسیح ’خداوند‘ اِن،بِی جلال خدای بَپ."
        },
        {
          "verse": 12,
          "usfm": "PHP.2.12",
          "line_type": "p",
          "text": "پَ، ای عزیزُنُم، همطو که همیشه اطاعت تُکِردِن، الانَم نه فَکَه موکعی که مه اُجائوم، بلکه خیلی بِشتِه موکعی که اُجا نَهُم، نجات خو وا تِرس و لِرز به کار بگیری؛"
        },
        {
          "verse": 13,
          "usfm": "PHP.2.13",
          "line_type": "p",
          "text": "به چه که ایی خدان که بِی خوشنودی خویی در شما کار اَکُنت، هم توو اراده هم توو عمل."
        },
        {
          "verse": 14,
          "usfm": "PHP.2.14",
          "line_type": "p",
          "text": "همۀ کارو ئو بدون سُک سُک یا جر و بحث اَنجُم هادِین،"
        },
        {
          "verse": 15,
          "usfm": "PHP.2.15",
          "line_type": "p",
          "text": "تا بی‌‌عیب و ساده دل و چوکُن بی لکه خدا بَشین، بین نسل ناخلف و سرکش که میونشُ مثه اِستالَه ئُو توو دنیا اَدِرخشین،"
        },
        {
          "verse": 16,
          "usfm": "PHP.2.16",
          "line_type": "p",
          "text": "همطو که به کَلُم زندگی تُگناشتِن، تا ایطوکا توو روز برگشتِن مسیح مه افتخار بُکنُم که الکی ندُویدَم یا الکی زحمت اُمنکشی."
        },
        {
          "verse": 17,
          "usfm": "PHP.2.17",
          "line_type": "p",
          "text": "حتی اگه لازم بَشِت که خون مه مثه شرابِ وَخف بودَه، روی هدیۀ کُربُنی ایمُنِتُ رِختَه بَشِت، توو اَنجُم ایی کار خوشالُم و وا همتُ شادی اَکُنُم."
        },
        {
          "verse": 18,
          "usfm": "PHP.2.18",
          "line_type": "p",
          "text": "همیطوَم شما بایه خوشال بَشین و وا مه شادی بُکنین."
        },
        {
          "verse": 19,
          "usfm": "PHP.2.19",
          "line_type": "p",
          "text": "در خداوندْ عیسی امید اُمهَستِن که تیموتائوسُ به همی زودیُ حدتُ بفرستُم، تا مه اَم وا خبر گِفتِن اَ حالتُ دلُم خاش بَشِت."
        },
        {
          "verse": 20,
          "usfm": "PHP.2.20",
          "line_type": "p",
          "text": "به چه که کسیُ مثه اُ اُمنی، که وا خلوص نیّت دل نِگرون راحتیِ شما بَشِت."
        },
        {
          "verse": 21,
          "usfm": "PHP.2.21",
          "line_type": "p",
          "text": "به چه که همۀ اُشُ پِی نَعف خوشُئَن، نه نَعف عیسی مسیح."
        },
        {
          "verse": 22,
          "usfm": "PHP.2.22",
          "line_type": "p",
          "text": "ولی شما اَدونی که تیموتائوس امتحان خو پس ایدادِن، که چطو مثه پُسی که وا بَپِشِن، توو کار انجیل واکلُم خذمت ایکِردِن."
        },
        {
          "verse": 23,
          "usfm": "PHP.2.23",
          "line_type": "p",
          "text": "پَ مه امید اُمهَه هِمی که تکلیفُم روشن بو، بِی اُ حدتُ بفرستُم؛"
        },
        {
          "verse": 24,
          "usfm": "PHP.2.24",
          "line_type": "p",
          "text": "و در خداوند اطمینُن اُمهَستِن که خومَم وا هِمی زودیُ اَتام."
        },
        {
          "verse": 25,
          "usfm": "PHP.2.25",
          "line_type": "p",
          "text": "مه لازم اُمدونستِن که اِپافْرودیتوسُ حدتُ بفرستُم، بِی اُ که اَ یه طَرَه کاکام، همکارُم و همرزمُمِن، و اَ یه طَرَه کاصِد و خادم شما بِی رفع احتیاجوی مِن."
        },
        {
          "verse": 26,
          "usfm": "PHP.2.26",
          "line_type": "p",
          "text": "به چه که اُ مشتاق دیدن همۀ شمان و اَ ایکه اَ مریضی اُ واخبر بودین، ناراحتِن."
        },
        {
          "verse": 27,
          "usfm": "PHP.2.27",
          "line_type": "p",
          "text": "واکعنم که تا حدّ مرگ مریضَ. ولی خدا بهش رحم ایکه، نه فَکَه به اُ، بلکه به مه اَم، تا نَکه غُصتَه ای رو غُصتَم بیاد."
        },
        {
          "verse": 28,
          "usfm": "PHP.2.28",
          "line_type": "p",
          "text": "پَ مه بِی فرستادِن اُ بِشتِه شوک و ذوک اُمهَه تا اَ دوبارَه دیدن اُ خوشال بَشین و ایطوکا مه کمتِه دل نِگرون بَشُم."
        },
        {
          "verse": 29,
          "usfm": "PHP.2.29",
          "line_type": "p",
          "text": "پَ در خداوند، اُ رو وا شادی تَمُن کبول بُکنی و به ایطو کسوئی احترام بُنوسین،"
        },
        {
          "verse": 30,
          "usfm": "PHP.2.30",
          "line_type": "p",
          "text": "به چه که اُ بِی کار مسیح تا حدّ مرگ رَه و وا خاطر جبران کَم و کسری خذمتتُ به مه، جُنِ خو توو خطر ایکَردی."
        }
      ],
      "verse_count": 30,
