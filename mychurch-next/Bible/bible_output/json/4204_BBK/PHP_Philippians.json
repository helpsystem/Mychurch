    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 4,
      "chapter_usfm": "PHP.4",
      "version_id": 4204,
      "version_abbr": "BBK",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.4.1",
          "line_type": "p",
          "text": "پَ، ای کاکائُنُم که دوستِتُ اُمهَه، و شوک دیدنتُ اُمهَه، ای شمایی که شادی و تاج سَرُمین، ای عزیزُنُم، ایطوکا در خداوند کایُم بُمونی."
        },
        {
          "verse": 2,
          "usfm": "PHP.4.2",
          "line_type": "p",
          "text": "اَ اِفُودیه خواهش اَکُنُم و اَ سینتیخی خواهش اُمهَه که در خداوند همفکر بَشِن."
        },
        {
          "verse": 3,
          "usfm": "PHP.4.3",
          "line_type": "p",
          "text": "بله، ای همکار حکیکی، اَ تو اَم مَوات به ایی دو زن کمک بُکنی، که واکل اَکْلیمِنتُس و بکیه همکارُم که نُمِشُ توو دفتر زندگی نوشته بودِن، توو کار انجیل شُنَه وا شُنَه مه زحمت شُکِشیدِن."
        },
        {
          "verse": 4,
          "usfm": "PHP.4.4",
          "line_type": "p",
          "text": "همه وَه در خداوند شاد بَشین؛ دوبارَه هم اَگَم: شاد بَشین."
        },
        {
          "verse": 5,
          "usfm": "PHP.4.5",
          "line_type": "p",
          "text": "بُوالی همه بُدُنِن که چِکَک آدموی با ملاحظه ایین. هُندِن خداوند نِزیکِن."
        },
        {
          "verse": 6,
          "usfm": "PHP.4.6",
          "line_type": "p",
          "text": "دل نِگرون هیچ چی مَبَشین، بلکه توو هر چیزی وا دعا و خواهش و تمنا، همراه وا شکرگزاری خواسته ئُو خو به خدا بِگِی."
        },
        {
          "verse": 7,
          "usfm": "PHP.4.7",
          "line_type": "p",
          "text": "و صُل و سلامتی خدا که بالاته اَ هر فهمین، اَ دلُتُ و فکرُتُ در مسیح عیسی محافظت اَکُنت."
        },
        {
          "verse": 8,
          "usfm": "PHP.4.8",
          "line_type": "p",
          "text": "سرآخِر، ای کاکائُن، به هرچه که حکیکین، به هرچه که حرمت ایشَه، به هرچه که دُرستن، به هرچه که پاکِن، به هرچه که دوس داشتنین و به هرچه که لایِک تعریفن فکر بُکنین. اگه چیزی هَه که خیلی خُبِن، اگه چیزی هَه که ارزش تعریف ایشَه، به ایی چیزُ فکر بُکنین."
        },
        {
          "verse": 9,
          "usfm": "PHP.4.9",
          "line_type": "p",
          "text": "اُنچه که اَ مه یاد تُگِفتِن و کبول تُکِردِن و اَ مه تُشنُتِن و در مه تُدیدِن، ایی چیزُئو اَنجُم هادِین، و خدای صُل و سلامتی وا شما اِبو."
        },
        {
          "verse": 10,
          "usfm": "PHP.4.10",
          "line_type": "p",
          "text": "در خداوند خیلی شادی اَکُنُم که الان شما سر آخِر دوباره به فکر مه کَفتِین، شما واکعاً به فکر مه هَستِرین، ولی فرصتی تُنَهَستَه."
        },
        {
          "verse": 11,
          "usfm": "PHP.4.11",
          "line_type": "p",
          "text": "نَکه اییُ اَ سر نیاز بگم، چونکه یاد اُمگِفتِن که توو هر وضعی که هَستُم، بایه کانع بَشُم."
        },
        {
          "verse": 12,
          "usfm": "PHP.4.12",
          "line_type": "p",
          "text": "مه هم اَدونُم، فَخیری چطوکان و هم اَدونُم زندگی توو فَرایُنی چطوکان. توو هر وضع و حالی، راز زندگی کِردِن توو سیری و گُشنه ای، توو فَرایُنی و توو نیاز یاد اُمگِفتِن."
        },
        {
          "verse": 13,
          "usfm": "PHP.4.13",
          "line_type": "p",
          "text": "مه هر کاری اِتونُم بُکنُم، به واسطه مسیح که به مه کُوّت اَدِت."
        },
        {
          "verse": 14,
          "usfm": "PHP.4.14",
          "line_type": "p",
          "text": "با ایی حال، لطف تُکه که توو تَنگیُم وا مه همباش بودِین."
        },
        {
          "verse": 15,
          "usfm": "PHP.4.15",
          "line_type": "p",
          "text": "شما فیلیپیُ، خوتُ اَدونین که توو شروع کار انجیل، وختی که اَ منطکه مقدونیه رفتُم، هیچ کلیسایی توو دادِن و گِفتِنِ وا مه همباش نِبو، جُلَ شما و بس."
        },
        {
          "verse": 16,
          "usfm": "PHP.4.16",
          "line_type": "p",
          "text": "حتی موکعی که توو شهر تَسالونیکی هَستَرُم، شما بِی رفع نیازوم وازِم کمک تُفرستا، و دوبارَه اَم تُفرستا."
        },
        {
          "verse": 17,
          "usfm": "PHP.4.17",
          "line_type": "p",
          "text": "نه ایکه دُمبال هدیه گِفتِن بَشُم، بلکه دُمبال ثمریُم که به حساب شما اضاف بَشِت."
        },
        {
          "verse": 18,
          "usfm": "PHP.4.18",
          "line_type": "p",
          "text": "مه همۀ اُ پولُ اُمگه و حتی بِشتِه. حالا که هدیه ئُویی که تُفرستا اَ اِپافْرودیتوس اُمگه، همِی چی فَرایُن اُمهَه. هدیه شما یه عطر خوشبو و یه کُربُنی کابِل کبولِن و خدائو خشنود اَکُنت."
        },
        {
          "verse": 19,
          "usfm": "PHP.4.19",
          "line_type": "p",
          "text": "و خدای مه، همۀ نیازوی شمائُو طِبکِ دولت پُر جلال خوش در مسیح عیسی رفع اَکُنت."
        },
        {
          "verse": 20,
          "usfm": "PHP.4.20",
          "line_type": "p",
          "text": "بِی خدامُ، بَپِ آسَمُنیمُ تا ابدالآباد جلال بُبوت. آمین."
        },
        {
          "verse": 21,
          "usfm": "PHP.4.21",
          "line_type": "p",
          "text": "به همۀ مقدّسُن در مسیح عیسی سلام بِرَسُنین. کاکائُنی که واکلُمَن بهتُ سلام اَرِسونِن."
        },
        {
          "verse": 22,
          "usfm": "PHP.4.22",
          "line_type": "p",
          "text": "همۀ ایمُندارُن به مسیح به شما سلام اَرِسونِن، مخصوصاً اُشُ که اهل لَهَر امپراطورن."
        },
        {
          "verse": 23,
          "usfm": "PHP.4.23",
          "line_type": "p",
          "text": "فیض خداوندْ عیسی مسیح وا روح شما بُبوت."
        }
      ],
      "verse_count": 23,
      "headings": [
        {
          "before_verse": 2,
          "text": "نصیحت، تشویق و دعا"
        },
        {
          "before_verse": 10,
          "text": "تشکر بِی هدایا"
        },
        {
          "before_verse": 21,
          "text": "سلاموی آخِر"
        }
      ],
