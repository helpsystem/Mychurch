  "chapters": [
    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 1,
      "chapter_usfm": "PHP.1",
      "version_id": 4204,
      "version_abbr": "BBK",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.1.1",
          "line_type": "p",
          "text": "اَ طَرَه پولس و تیموتائوس، غُلُمُوی مسیح عیسی،به همۀ مقدّسُن در مسیح عیسی که توو شهر فیلیپی اَن، با ناظرُن و شَماسُن:"
        },
        {
          "verse": 2,
          "usfm": "PHP.1.2",
          "line_type": "p",
          "text": "فیض و صُل و سلامتی اَ طَرَه بَپمُ خدا، و خداوندْ عیسی مسیح، وا شما بُبوت."
        },
        {
          "verse": 3,
          "usfm": "PHP.1.3",
          "line_type": "p",
          "text": "هروَه که شمائو وا یاد اَتارُم، خدا خو شُکر اَکُنُم،"
        },
        {
          "verse": 4,
          "usfm": "PHP.1.4",
          "line_type": "p",
          "text": "همیشه توو همۀ دعائوم بِی همتُ وا شادی دعا اَکُنُم،"
        },
        {
          "verse": 5,
          "usfm": "PHP.1.5",
          "line_type": "p",
          "text": "وا خاطر همکاریتُ توو کار انجیل که اَ روز اَوِّل تا الان تُهَه."
        },
        {
          "verse": 6,
          "usfm": "PHP.1.6",
          "line_type": "p",
          "text": "مه اَ ایی مطمئنُم اُ که کار خُبُ در شما شروع ایکه اُ رو تا روز برگشتِن عیسی مسیح کامل اَکُنت."
        },
        {
          "verse": 7,
          "usfm": "PHP.1.7",
          "line_type": "p",
          "text": "مه ایی حَک اُمهَه که دربارۀ همۀ شما ایطو حسی اُمبَشِت، چونکه توو دل مه جا تُهَه؛ به چه که همتُ وا مه توو فیض خدا همباشین، چه توو زندون بَشُم چه توو دفاع اَ انجیل و تأیید بر حَک بودِنی."
        },
        {
          "verse": 8,
          "usfm": "PHP.1.8",
          "line_type": "p",
          "text": "به چه که خدا شاهدُمِن که وا علاکه زیادِ خودِ مسیح عیسی، چِکَک بِی همۀ شما شوک و ذوک اُمهَه."
        },
        {
          "verse": 9,
          "usfm": "PHP.1.9",
          "line_type": "p",
          "text": "دعام ایین که محبت شما بِشتِه و بِشتِه بُبوت و همراه وا شناخت و فهمِ کامل بَشِت."
        },
        {
          "verse": 10,
          "usfm": "PHP.1.10",
          "line_type": "p",
          "text": "تا اُنچه که بِهتِه اَ همه اَن تأیید بُکنی و بِی روز برگشتِ مسیح، پاک و بی‌عیب بَشین"
        },
        {
          "verse": 11,
          "usfm": "PHP.1.11",
          "line_type": "p",
          "text": "و اَ ثمر صالح بودِن پُر بَشین که به واسطه عیسی مسیح بِی جلال و حمد و ثنای خدا وا دَس اَتات."
        },
        {
          "verse": 12,
          "usfm": "PHP.1.12",
          "line_type": "p",
          "text": "ای کاکائُن، مَوات بُدُنی که اُ چیزی که بِی مه اِتفاک کَفتِن، واکعاً به پیشرفت انجیل کمک ایکِردِن،"
        },
        {
          "verse": 13,
          "usfm": "PHP.1.13",
          "line_type": "p",
          "text": "طوری که به همۀ نگهبُنوی کاخ سلطنتی و بِی بکیه جُملگی نَمایُن بودِن که مه، وا خاطر مسیحِن که توو زندونُم؛"
        },
        {
          "verse": 14,
          "usfm": "PHP.1.14",
          "line_type": "p",
          "text": "و خیلی اَ کاکائُن وا زندونی بودِنِ مه، در خداوند دلشُ کایُم بودِن و بِشتِه پاهار اَکُنِن، تا کَلُم خدائو بدون تِرس بگن."
        },
        {
          "verse": 15,
          "usfm": "PHP.1.15",
          "line_type": "p",
          "text": "در واکع بعضیُ اَ رو دیدن کوری و اَ رو چِهمُ هم چِهمی مسیحُ اعلام اَکُنِن، ولی بعضی دگه وا نیّت خُب."
        },
        {
          "verse": 16,
          "usfm": "PHP.1.16",
          "line_type": "p",
          "text": "گرو دوّم ایی کارُ اَ رو محبت اَنجُم اَدِن، به چه که اَدونِن که مه ئو بِی دفاع اَ انجیل ایجا شُناهادِن."
        },
        {
          "verse": 17,
          "usfm": "PHP.1.17",
          "line_type": "p",
          "text": "اُ گرو اَوِّل اَ رو خودخواهی مسیحُ اعلام اَکُنِن نه وا نیّت خُب، گَمون اَکُنِن که ایطوکا مصیبتوی مه ئو توو زندون بِشتِه اَکُنِن."
        },
        {
          "verse": 18,
          "usfm": "PHP.1.18",
          "line_type": "p",
          "text": "پَ چه؟ فَکَه هر طور که بودِن چه الکی، چه حکیکتاً، مسیح اعلام بُبوت، و مه اَ ایی دلخاشُم، بله، مه دلخاشُم،"
        },
        {
          "verse": 19,
          "usfm": "PHP.1.19",
          "line_type": "p",
          "text": "به چه که اَدونُم که وا دعائُوی شما و وا کمک روح عیسی مسیح، ایی باعث آزادی مه اِبو."
        },
        {
          "verse": 20,
          "usfm": "PHP.1.20",
          "line_type": "p",
          "text": "همطو که وا شوک و ذوک انتظار اَکشُم و امید اُمهَستِن که، توو هیچ چی شرمُنده نابُم، بلکه وا پاهار تَمُن، الانَم مثه همیشه، چه وا زندگی و چه وا مرگ، مسیح در بدنُم جلال پیدا اَکُنت."
        },
        {
          "verse": 21,
          "usfm": "PHP.1.21",
          "line_type": "p",
          "text": "به چه که بِی مه زندگی کِردِن مسیحِن، و مُردِن سود."
        },
        {
          "verse": 22,
          "usfm": "PHP.1.22",
          "line_type": "p",
          "text": "اگه بایه توو جسم زندگی بُکنُم، معنیش بِی مه ایین که کار پُر ثمر بِشتِه ای اَنجُم اَدَم. با ایی حال نادونُم کَم تِی ئو گُزین بُکنُم!"
        },
        {
          "verse": 23,
          "usfm": "PHP.1.23",
          "line_type": "p",
          "text": "مه بین ایی دو تا بدطورکا گیر اُمکِردِن. آرزوم ایین که اَ ایی دنیا بِرَم و وا مسیح بَشُم، به چه که ایی خیلی بِهتِرِن؛"
        },
        {
          "verse": 24,
          "usfm": "PHP.1.24",
          "line_type": "p",
          "text": "ولی وا خاطر شما مُندِنُم توو جسم بِشتِه لازمِن."
        },
        {
          "verse": 25,
          "usfm": "PHP.1.25",
          "line_type": "p",
          "text": "به چه که اَ ایی خاطر جمعُم، اَدونُم که بِی پیشرفت و شادی شما توو ایمُن، اَمونُم و وا همۀ شما ادامه اَدَم،"
        },
        {
          "verse": 26,
          "usfm": "PHP.1.26",
          "line_type": "p",
          "text": "تا با دوبارَه هُندِنُم حدتُ، فخر کِردِنتُ به مسیح عیسی وا خاطر مه بِشتِه بَشِت."
        },
        {
          "verse": 27,
          "usfm": "PHP.1.27",
          "line_type": "p",
          "text": "فَکَه بُوالی روش زندگیتُ شایسته انجیل مسیح بَشِت، تا ایطوکا چه بیام و بِگینُمتُ و چه نَبَشُم، دربارَتُ بِشنُوُم که در یَک روح کایُم ووستادِین، وا یَک فکر، شونه وا شونۀ همدگه، بِی ایمُنِ انجیل سعی اَکِردِین،"
        },
        {
          "verse": 28,
          "usfm": "PHP.1.28",
          "line_type": "p",
          "text": "و توو هیچ چیزی اَ اُشُویی که باهاتُ ضدکاری اَکُنِن تِرسی تُنی. ایی بِی اُشُ یه نِشُنۀ نَمایُنِن اَ هلاکتشُ، ولی یه نِشُنه اَن بِی نجات شما و ایی اَ طَرَه خدان."
        },
        {
          "verse": 29,
          "usfm": "PHP.1.29",
          "line_type": "p",
          "text": "به چه که ایی افتخار نصیبتُ بودِن که نه فَکَه به مسیح ایمُن بیارین، بلکه وا خاطری عذاب هم بِکِشین،"
        },
        {
          "verse": 30,
          "usfm": "PHP.1.30",
          "line_type": "p",
          "text": "چونکه شمام درگیر همو مبارزه هَستِین که تُدی مه درگیری هَستَرُم و الانم اَشنُوین که هِنوزا درگیرشُم."
        }
      ],
