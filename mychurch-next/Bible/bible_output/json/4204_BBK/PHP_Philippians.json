    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 3,
      "chapter_usfm": "PHP.3",
      "version_id": 4204,
      "version_abbr": "BBK",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.3.1",
          "line_type": "p",
          "text": "سر آخِر، ای کاکائُنُم، در خداوند شادی بُکنی! نوشتِن همو چیزُ بِی شما، زحمتی بهم اینین، بلکه بِی امنیتِ شمان."
        },
        {
          "verse": 2,
          "usfm": "PHP.3.2",
          "line_type": "p",
          "text": "اَ اُ سَغُ دوری بُکنین! اَ اُ آدموی بدکار دوری بُکنین؛ اَ کسوئی که بِی سُنَّت کِردِن، جسمُ اَبُرِن دوری بُکنین!"
        },
        {
          "verse": 3,
          "usfm": "PHP.3.3",
          "line_type": "p",
          "text": "به چه که سُنَّت بودَه ئُون ماییم که وا روح خدا پرستش اَکُنیم، و به مسیح عیسی افتخار اَکُنیم و تَگّه مو به جسم نَن -"
        },
        {
          "verse": 4,
          "usfm": "PHP.3.4",
          "line_type": "p",
          "text": "با ایکه مه خوم دلیلی بِی تَگّه زدن به جسم اُمهَه.اگه یه کَسِ دگه ای فکر اَکُنت که دلیلی بِی تَگّه زدن به جسم ایشَه، مه بِشتِه اُمهَه:"
        },
        {
          "verse": 5,
          "usfm": "PHP.3.5",
          "line_type": "p",
          "text": "مه سُنَّت بودَه توو روز هشتمُم، اَ کوم یهود، اَ طِیفهٔ بِنیامین، یه عبرانی اَ مُم و بَپ عبرانی؛ اَ لحاظ شریعت، اَ فرقۀ فَریسی؛"
        },
        {
          "verse": 6,
          "usfm": "PHP.3.6",
          "line_type": "p",
          "text": "اَ لحاظ غیرت، آزار رسون به کلیسا؛ اَ لحاظ صالح بودِنی که اَ شریعت اَتا، بی‌عیب."
        },
        {
          "verse": 7,
          "usfm": "PHP.3.7",
          "line_type": "p",
          "text": "ولی هرچه که بِی مه نَعفَ، به خاطر مسیح ضرر اُمدونست."
        },
        {
          "verse": 8,
          "usfm": "PHP.3.8",
          "line_type": "p",
          "text": "در واکع، مه وا خاطریکه شناختِن خداوندُم مسیح عیسی، با ارزشتِه اَ هر چیزین، همِی چیُ ضرر اَدونُم. وا خاطر اُ همه چیُ اَ دَس اُمدادِن و اُشُ رو مثه سُمات به حساب اَتارُم تا نَعفُم مسیح بَشِت."
        },
        {
          "verse": 9,
          "usfm": "PHP.3.9",
          "line_type": "p",
          "text": "و در اُ پیدا بَشُم، نه وا صالح بودِن خوم که اَ شریعت اَتات، بلکه وا صالح بودِنی که اَ راه ایمُنِ به مسیح اَتات، اُ صالح بودِنی که اَ طَرَه خدان و وابسته به ایمُنِن."
        },
        {
          "verse": 10,
          "usfm": "PHP.3.10",
          "line_type": "p",
          "text": "تا مسیح و کُدرَتِ زنده بودِنشُ بِشناسُم و توو زجروی اُ همباش بُبُم و توو مرگش شکل اُ بَشُم،"
        },
        {
          "verse": 11,
          "usfm": "PHP.3.11",
          "line_type": "p",
          "text": "تا هر طور که اِبوت، زنده بودِن اَ مُردَه ئُونُ وا دَس بیارُم."
        },
        {
          "verse": 12,
          "usfm": "PHP.3.12",
          "line_type": "p",
          "text": "ایطو نَن که مه همی الانَم اییُ وا دَسِش اُمواردِن یا همی الانَم کاملُم، بلکه به خوم به جلو اَکشُم تا اُ چیزیُ وا دَس بیارُم، که مسیح عیسی وا خاطر اُ، بِی مه مال خوش ایکِردِن."
        },
        {
          "verse": 13,
          "usfm": "PHP.3.13",
          "line_type": "p",
          "text": "ای کاکائُن، گَمون ناکُنُم اُ رو وا دَس اُمواردِن؛ ولی یَک کار اَکُنُم: اُنچه که پشت سَرُمِنُ اَ یاد اَکُنُم و وا طَرَه اُنچه که جلوِ رومِن بِی خوم جلو اَکشُم،"
        },
        {
          "verse": 14,
          "usfm": "PHP.3.14",
          "line_type": "p",
          "text": "به رسیدِن به هدف تقلا اَکُنُم، تا جایزه‌ای رو وا دَس بیارُم که خدا بِی اُ، مه ئو در مسیح عیسی به بالا دعوت ایکِردِن."
        },
        {
          "verse": 15,
          "usfm": "PHP.3.15",
          "line_type": "p",
          "text": "بُوال اُشُویی که اَ میونمُ بالغن ایطوکا فکر بُکنِن؛ و اگه درباره چیزی جُلَ ایی فکر اَکُنین، خدا اُ رو هم بِی شما نَمایُن اَکُن."
        },
        {
          "verse": 16,
          "usfm": "PHP.3.16",
          "line_type": "p",
          "text": "فَکَه بُوالی به هر مقامی که بهش رسیدِیم طِبکِ اُ رفتار بُکنیم."
        },
        {
          "verse": 17,
          "usfm": "PHP.3.17",
          "line_type": "p",
          "text": "ای کاکائُن، همتُ اَ مه الگو بگیرین، و چِهمِتُ رو کسوئی بَشِت که طِبکِ نمونه ای که در ما تُهَه، رفتار اَکُنِن،"
        },
        {
          "verse": 18,
          "usfm": "PHP.3.18",
          "line_type": "p",
          "text": "به چه که خیلیُ که مه چَن دُفَه دربارَشُ بهتُ اُمگُفتِن و الانم حتی وا خَرس بهتُ اَگَم، مثه دشمنوی صلیب مسیح رفتار اَکُنِن."
        },
        {
          "verse": 19,
          "usfm": "PHP.3.19",
          "line_type": "p",
          "text": "آخِر عاکِبت اُشُ هلاکتِن. خداشُ اُشکُمِشُن و به چیزُی ننگشُ افتخار اَکُنِن، و فکرشُ درگیر چیزُی زمینین."
        },
        {
          "verse": 20,
          "usfm": "PHP.3.20",
          "line_type": "p",
          "text": "ولی وطن ما آسَمُنِن و اَ اُجان که چِش وا راه نجات‌دهنده، یعنی خداوند عیسی مسیحیم."
        },
        {
          "verse": 21,
          "usfm": "PHP.3.21",
          "line_type": "p",
          "text": "اُ وا کُدرَتی که بهش کُوّت اَدِت تا همِی چیُ به اطاعت خویی در بیارِه، بدن لَهوِز مائو تبدیل اَکُن تا شبیه بدن پُر جلال خویی بَشِت."
