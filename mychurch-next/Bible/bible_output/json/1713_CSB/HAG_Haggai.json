  "chapters": [
    {
      "schema_version": 6,
      "book_id": "HAG",
      "chapter": 1,
      "chapter_usfm": "HAG.1",
      "version_id": 1713,
      "version_abbr": "CSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAG.1.1",
          "line_type": "m",
          "text": "In the second year of King Darius, , on the first day of the sixth month, the word of the Lord came through the prophet Haggai to Zerubbabel son of Shealtiel, the governor of Judah, and to Joshua son of Jehozadak, the high priest:"
        },
        {
          "verse": 2,
          "usfm": "HAG.1.2",
          "line_type": "p",
          "text": "“The Lord of Armies says this: These people say: The time has not come for the house of the Lord to be rebuilt.”"
        },
        {
          "verse": 3,
          "usfm": "HAG.1.3",
          "line_type": "p",
          "text": "The word of the Lord came through the prophet Haggai:"
        },
        {
          "verse": 4,
          "usfm": "HAG.1.4",
          "line_type": "p",
          "text": "“Is it a time for you yourselves to live in your paneled houses, while this house lies in ruins? ”"
        },
        {
          "verse": 5,
          "usfm": "HAG.1.5",
          "line_type": "p",
          "text": "Now, the Lord of Armies says this: “Think carefully about your ways:"
        },
        {
          "verse": 6,
          "usfm": "HAG.1.6",
          "line_type": "q1",
          "text": "You have planted muchbut harvested little.You eatbut never have enough to be satisfied.You drinkbut never have enough to be happy.You put on clothesbut never have enough to get warm.The wage earner puts his wagesinto a bag with a hole in it.”"
        },
        {
          "verse": 7,
          "usfm": "HAG.1.7",
          "line_type": "p",
          "text": "The Lord of Armies says this: “Think carefully about your ways."
        },
        {
          "verse": 8,
          "usfm": "HAG.1.8",
          "line_type": "p",
          "text": "Go up into the hills, bring down lumber, and build the house; and I will be pleased with it and be glorified,” says the Lord."
        },
        {
          "verse": 9,
          "usfm": "HAG.1.9",
          "line_type": "p",
          "text": "“You expected much, but then it amounted to little. When you brought the harvest to your house, I ruined it. Why? ” This is the declaration of the Lord of Armies. “Because my house still lies in ruins, while each of you is busy with his own house."
        },
        {
          "verse": 10,
          "usfm": "HAG.1.10",
          "line_type": "q1",
          "text": "So on your account, the skies have withheld the dewand the land its crops."
        },
        {
          "verse": 11,
          "usfm": "HAG.1.11",
          "line_type": "q1",
          "text": "I have summoned a droughton the fields and the hills,on the grain, new wine, fresh oil,and whatever the ground yields,on people and animals,and on all that your hands produce.”"
        },
        {
          "verse": 12,
          "usfm": "HAG.1.12",
          "line_type": "m",
          "text": "Then Zerubbabel son of Shealtiel, the high priest Joshua son of Jehozadak, and the entire remnant of the people obeyed the Lord their God and the words of the prophet Haggai, because the Lord their God had sent him. So the people feared the Lord."
        },
        {
          "verse": 13,
          "usfm": "HAG.1.13",
          "line_type": "p",
          "text": "Then Haggai, the Lord’s messenger, delivered the Lord’s message to the people: “I am with you — this is the Lord’s declaration.”"
        },
        {
          "verse": 14,
          "usfm": "HAG.1.14",
          "line_type": "p",
          "text": "The Lord roused the spirit of Zerubbabel son of Shealtiel, governor of Judah, the spirit of the high priest Joshua son of Jehozadak, and the spirit of all the remnant of the people. They began work on the house of the Lord of Armies, their God,"
        },
        {
          "verse": 15,
          "usfm": "HAG.1.15",
          "line_type": "p",
          "text": "on the twenty-fourth day of the sixth month, in the second year of King Darius."
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 12,
          "text": "The People’s Response"
        }
      ],
