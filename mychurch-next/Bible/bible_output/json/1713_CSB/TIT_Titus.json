  "chapters": [
    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 1,
      "chapter_usfm": "TIT.1",
      "version_id": 1713,
      "version_abbr": "CSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.1.1",
          "line_type": "m",
          "text": "Paul, a servant of God and an apostle of Jesus Christ, for the faith of God’s elect and their knowledge of the truth that leads to godliness,"
        },
        {
          "verse": 2,
          "usfm": "TIT.1.2",
          "line_type": "m",
          "text": "in the hope of eternal life that God, who cannot lie, promised before time began."
        },
        {
          "verse": 3,
          "usfm": "TIT.1.3",
          "line_type": "m",
          "text": "In his own time he has revealed his word in the preaching with which I was entrusted by the command of God our Savior:"
        },
        {
          "verse": 4,
          "usfm": "TIT.1.4",
          "line_type": "p",
          "text": "To Titus, my true son in our common faith.Grace and peace from God the Father and Christ Jesus our Savior."
        },
        {
          "verse": 5,
          "usfm": "TIT.1.5",
          "line_type": "m",
          "text": "The reason I left you in Crete was to set right what was left undone and, as I directed you, to appoint elders in every town."
        },
        {
          "verse": 6,
          "usfm": "TIT.1.6",
          "line_type": "m",
          "text": "An elder must be blameless, the husband of one wife, with faithful children who are not accused of wildness or rebellion."
        },
        {
          "verse": 7,
          "usfm": "TIT.1.7",
          "line_type": "m",
          "text": "As an overseer of God’s household, he must be blameless, not arrogant, not hot-tempered, not an excessive drinker, not a bully, not greedy for money,"
        },
        {
          "verse": 8,
          "usfm": "TIT.1.8",
          "line_type": "m",
          "text": "but hospitable, loving what is good, sensible, righteous, holy, self-controlled,"
        },
        {
          "verse": 9,
          "usfm": "TIT.1.9",
          "line_type": "m",
          "text": "holding to the faithful message as taught, so that he will be able both to encourage with sound teaching and to refute those who contradict it."
        },
        {
          "verse": 10,
          "usfm": "TIT.1.10",
          "line_type": "p",
          "text": "For there are many rebellious people, full of empty talk and deception, especially those from the circumcision party."
        },
        {
          "verse": 11,
          "usfm": "TIT.1.11",
          "line_type": "p",
          "text": "It is necessary to silence them; they are ruining entire households by teaching what they shouldn’t in order to get money dishonestly."
        },
        {
          "verse": 12,
          "usfm": "TIT.1.12",
          "line_type": "p",
          "text": "One of their very own prophets said, “Cretans are always liars, evil beasts, lazy gluttons.”"
        },
        {
          "verse": 13,
          "usfm": "TIT.1.13",
          "line_type": "p",
          "text": "This testimony is true. For this reason, rebuke them sharply, so that they may be sound in the faith"
        },
        {
          "verse": 14,
          "usfm": "TIT.1.14",
          "line_type": "p",
          "text": "and may not pay attention to Jewish myths and the commands of people who reject the truth."
        },
        {
          "verse": 15,
          "usfm": "TIT.1.15",
          "line_type": "p",
          "text": "To the pure, everything is pure, but to those who are defiled and unbelieving nothing is pure; in fact, both their mind and conscience are defiled."
        },
        {
          "verse": 16,
          "usfm": "TIT.1.16",
          "line_type": "p",
          "text": "They claim to know God, but they deny him by their works. They are detestable, disobedient, and unfit for any good work."
        }
      ],
      "verse_count": 16,
      "headings": [
        {
          "before_verse": 5,
          "text": "Titus’s Ministry in Crete"
        }
      ],
