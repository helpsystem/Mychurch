    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 3,
      "chapter_usfm": "TIT.3",
      "version_id": 1713,
      "version_abbr": "CSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.3.1",
          "line_type": "m",
          "text": "Remind them to submit to rulers and authorities, to obey, to be ready for every good work,"
        },
        {
          "verse": 2,
          "usfm": "TIT.3.2",
          "line_type": "m",
          "text": "to slander no one, to avoid fighting, and to be kind, always showing gentleness to all people."
        },
        {
          "verse": 3,
          "usfm": "TIT.3.3",
          "line_type": "m",
          "text": "For we too were once foolish, disobedient, deceived, enslaved by various passions and pleasures, living in malice and envy, hateful, detesting one another."
        },
        {
          "verse": 4,
          "usfm": "TIT.3.4",
          "line_type": "p",
          "text": "But when the kindness of God our Savior and his love for mankind appeared,"
        },
        {
          "verse": 5,
          "usfm": "TIT.3.5",
          "line_type": "p",
          "text": "he saved us — not by works of righteousness that we had done, but according to his mercy — through the washing of regeneration and renewal by the Holy Spirit."
        },
        {
          "verse": 6,
          "usfm": "TIT.3.6",
          "line_type": "p",
          "text": "He poured out his Spirit on us abundantly through Jesus Christ our Savior"
        },
        {
          "verse": 7,
          "usfm": "TIT.3.7",
          "line_type": "p",
          "text": "so that, having been justified by his grace, we may become heirs with the hope of eternal life."
        },
        {
          "verse": 8,
          "usfm": "TIT.3.8",
          "line_type": "p",
          "text": "This saying is trustworthy. I want you to insist on these things, so that those who have believed God might be careful to devote themselves to good works. These are good and profitable for everyone."
        },
        {
          "verse": 9,
          "usfm": "TIT.3.9",
          "line_type": "p",
          "text": "But avoid foolish debates, genealogies, quarrels, and disputes about the law, because they are unprofitable and worthless."
        },
        {
          "verse": 10,
          "usfm": "TIT.3.10",
          "line_type": "p",
          "text": "Reject a divisive person after a first and second warning."
        },
        {
          "verse": 11,
          "usfm": "TIT.3.11",
          "line_type": "p",
          "text": "For you know that such a person has gone astray and is sinning; he is self-condemned."
        },
        {
          "verse": 12,
          "usfm": "TIT.3.12",
          "line_type": "m",
          "text": "When I send Artemas or Tychicus to you, make every effort to come to me in Nicopolis, because I have decided to spend the winter there."
        },
        {
          "verse": 13,
          "usfm": "TIT.3.13",
          "line_type": "m",
          "text": "Diligently help Zenas the lawyer and Apollos on their journey, so that they will lack nothing."
        },
        {
          "verse": 14,
          "usfm": "TIT.3.14",
          "line_type": "p",
          "text": "Let our people learn to devote themselves to good works for pressing needs, so that they will not be unfruitful."
        },
        {
          "verse": 15,
          "usfm": "TIT.3.15",
          "line_type": "p",
          "text": "All those who are with me send you greetings. Greet those who love us in the faith. Grace be with all of you."
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 12,
          "text": "Final Instructions and Closing"
        }
      ],
