    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 3,
      "chapter_usfm": "2TI.3",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.3.1",
          "line_type": "p",
          "text": "ولی اییُ بُدُن که توو روزُی آخِر، زَمُنُویِ سختی، اَتات."
        },
        {
          "verse": 2,
          "usfm": "2TI.3.2",
          "line_type": "p",
          "text": "به چه که مردم، خودخواه، پول پرست، مغرور و متکبّر و بد دهن اَبِن، نافرمُن نسبت به بَپ و مُمِشُ اَبِن، ناشکر، ناپاک،"
        },
        {
          "verse": 3,
          "usfm": "2TI.3.3",
          "line_type": "p",
          "text": "بی عاطفه و کینه ای اَبِن، تهمت زن، بی‌بندوبار، وحشی و دشمن خُبی اَبِن،"
        },
        {
          "verse": 4,
          "usfm": "2TI.3.4",
          "line_type": "p",
          "text": "خیانتکار، بی ملاحظه و خودگیر اَبِن و عیاشیُ بِشتِه اَ خدا دوست شُهَه"
        },
        {
          "verse": 5,
          "usfm": "2TI.3.5",
          "line_type": "p",
          "text": "توو ظاهر دیندار اَبِن ولی بِی کُدرَتش حاشا اَکُنِن. اَ ایطو آدمُ دوری بُکن."
        },
        {
          "verse": 6,
          "usfm": "2TI.3.6",
          "line_type": "p",
          "text": "به چه که میون اُشُ کسونی هَستَن که وا حیله سر اَ لَهَر مردم در اَتارِن، و زنوی کم عکلُ اسیر اَکُنِن، اُ زنُنیُ که زیر بار گناهُو کمرِشُ خم بودِن و با هوا و هوسوی جور وا جور اَ راه به در اَبِن."
        },
        {
          "verse": 7,
          "usfm": "2TI.3.7",
          "line_type": "p",
          "text": "ایی زنُن همیشه تعلیم اَگِفتَن، ولی ابداً ناتونِن به شناخت حکیکت بِرسِن."
        },
        {
          "verse": 8,
          "usfm": "2TI.3.8",
          "line_type": "p",
          "text": "همطو که یَنّیس و یَمْبْریس با موسی پیغُمبَر ضدکاری شُکِه، ایی مَردُن اَم، که فکرشُ فاسد و ایمُنِشُ رد بودِن، با حکیکت ضدّ اَکُنِن."
        },
        {
          "verse": 9,
          "usfm": "2TI.3.9",
          "line_type": "p",
          "text": "ولی اُشُ راه وا جایی نابَرِن، به چه که نادونیشُ بِی همه معلوم اِبوت، هموطو که نادونی اُ دو نُفر، معلوم بو."
        },
        {
          "verse": 10,
          "usfm": "2TI.3.10",
          "line_type": "p",
          "text": "ولی تو اَ نِزیک شاهد تعلیمُم، رفتارم، هدفم توو زندگی، ایمُنُم، صبرُم، محبتُم و پایداریُم بودِی"
        },
        {
          "verse": 11,
          "usfm": "2TI.3.11",
          "line_type": "p",
          "text": "و اذیت و آزارُ و عذابویی که توو شهروی اَنطاکیه، قونیه و لِستْره وا سرم هُندُ، اِتدیدن، همو اذیت و آزارویی که تحمل اُمکه. ولی خداوند به مه اَ همه اُشُ خلاص ایکه."
        },
        {
          "verse": 12,
          "usfm": "2TI.3.12",
          "line_type": "p",
          "text": "واکعاً، همۀ کسونی که دلشُ شَوات در مسیح عیسی وا دینداری زندگی بُکنِن اذیت و آزار اَگینِن"
        },
        {
          "verse": 13,
          "usfm": "2TI.3.13",
          "line_type": "p",
          "text": "در حالیکه آدموی شریر و دَغَل باز، بدته و بدته اَبِن؛ گول اَزَنِن و گول اَخارِن."
        },
        {
          "verse": 14,
          "usfm": "2TI.3.14",
          "line_type": "p",
          "text": "ولی تو، به اُنچه که یاد اِدگِفتِن و بهش وا جد ایمُن اِدواردِن ادامه هادَه به چه که اَدونی ایشُ ئو اَ چه کسونی یاد اِدگِفتِن،"
        },
        {
          "verse": 15,
          "usfm": "2TI.3.15",
          "line_type": "p",
          "text": "و چطو اَ چولنگی، نوشته ئُوی مقدّس اِتفهمیدن که اِتونِن وازت حکمت هادَن، بِی اُ نجاتی که اَ طریق ایمُن به مسیح عیسان."
        },
        {
          "verse": 16,
          "usfm": "2TI.3.16",
          "line_type": "p",
          "text": "همۀ نوشته ئُوی مقدّس الهام خدان و بِی تعلیم، توبیخ، اصلاح، و تربیت توو صالح بودِن، مفیدن،"
        },
        {
          "verse": 17,
          "usfm": "2TI.3.17",
          "line_type": "p",
          "text": "تا مَرد خدا کامل بُبوت و بِی هر کار خُب آماده بَشِت."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 10,
          "text": "همۀ نوشته ئُوی مقدّس الهام خدان"
        }
      ],
