  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 1,
      "chapter_usfm": "2TI.1",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.1.1",
          "line_type": "p",
          "text": "اَ طَرَه پولس، که به خواست خدا، طِبکِ اُ وعدۀ زندگی که در مسیح عیسان، یه حَواری مسیح عیسان،"
        },
        {
          "verse": 2,
          "usfm": "2TI.1.2",
          "line_type": "p",
          "text": "به چوک عزیزُم، تیموتائوس:اَ طَرَه خدای بَپ و خداوندمُ مسیح عیسی فیض و رحمت و صُل و سلامتی بُبوت."
        },
        {
          "verse": 3,
          "usfm": "2TI.1.3",
          "line_type": "p",
          "text": "وختی که شُو و رو، یکسره توو دعائُوم یادت اَکُنُم، خدائو شُکر اَکُنُم، همو خدایی که مه هم مثه جدُم، وا یه وجدان پاک خذمتش اَکُنُم."
        },
        {
          "verse": 4,
          "usfm": "2TI.1.4",
          "line_type": "p",
          "text": "وختی خَرسُت وا یاد اَتارُم، آرزو اَکُنُم اِدبگینُم تا شاهِن شادی بَشُم."
        },
        {
          "verse": 5,
          "usfm": "2TI.1.5",
          "line_type": "p",
          "text": "مه ایمُن خالصت وا یاد اَتارُم ایمُنی که اَوِّل توو مُم گِپوت لوئیس و توو مُمِت یونیکی ساکن هَستَه و حالا مطمئنُم که در تو اَم ساکنِن."
        },
        {
          "verse": 6,
          "usfm": "2TI.1.6",
          "line_type": "p",
          "text": "به هِمی خاطر، وا یادت اَتارُم که اُ عطای خدائو غَلمَش بُکنی همو عطایی که اَ طریق دَس ناهادِن مه، در تُن."
        },
        {
          "verse": 7,
          "usfm": "2TI.1.7",
          "line_type": "p",
          "text": "به چه که روحی که خدا بهمُ ایدا، روح تِرس نَن، بلکه روح کُوّت و محبت و خوددارین."
        },
        {
          "verse": 8,
          "usfm": "2TI.1.8",
          "line_type": "p",
          "text": "پَ، نه اَ گواهی دادن دربارۀ خداوندمُ عار اِتبَشِت، و نه اَ مه که وا خاطری توو زندونُم، بلکه، وا کُوّت خدا توو زجر کشیدِن بِی انجیل، همباش بَش."
        },
        {
          "verse": 9,
          "usfm": "2TI.1.9",
          "line_type": "p",
          "text": "همو خدایی که به ما نجات ایدا و به یه زندگی مقدّس دعوت ایکه. ایی نه وا خاطر کارومُ، بلکه وا خاطر هدف و فیض خوشِن، همو فیضی که در مسیح عیسی کَبل اَ شروع دوران بِی ما ایدا،"
        },
        {
          "verse": 10,
          "usfm": "2TI.1.10",
          "line_type": "p",
          "text": "و الان وا نَمایُن بودِن نجات دهندمُ مسیح عیسی معلوم بودِن. همو مسیح عیسی که اَ طریق انجیل مرگُ اَ بین ایبُرد و زندگی و بقا ئو زیر نور ایوا."
        },
        {
          "verse": 11,
          "usfm": "2TI.1.11",
          "line_type": "p",
          "text": "مه گُزین بودَم تا اعلام کننده، حَواری و معلّم ایی انجیل بَشُم."
        },
        {
          "verse": 12,
          "usfm": "2TI.1.12",
          "line_type": "p",
          "text": "دلیلی که عذاب اَکشُم هم همین، ولی عار اُمنی، به چه که اَدونُم به کِ ایمُن اُمواردِن و مه کانع بودُم که اُ اِتون اُ چیزیُ که به مه سپرده بودِن تا اُ رو، سار بُکنت."
        },
        {
          "verse": 13,
          "usfm": "2TI.1.13",
          "line_type": "p",
          "text": "توو ایمُن و محبتی که در مسیح عیسان، اُ گَپوی درستی که اَ مه تِشنُتِن، الگو خو بُکن."
        },
        {
          "verse": 14,
          "usfm": "2TI.1.14",
          "line_type": "p",
          "text": "اَ طریق روح قدّوس خدا که در ما ساکنِن، اُ امانت خُبُ که بهت سپرده بودِن سار بُکن."
        },
        {
          "verse": 15,
          "usfm": "2TI.1.15",
          "line_type": "p",
          "text": "خبر اِتهَه که همۀ کسونی که توو منطکه آسیان، اَ مه رو بر شُگردوندِن، که میونشُ فیگِلوس و هِرموگِنِس هم هَستَن."
        },
        {
          "verse": 16,
          "usfm": "2TI.1.16",
          "line_type": "p",
          "text": "خداوند به اهل لَهَر اونیسیفوروس مرحمت بُکنت، به چه که اُ چَن دُفَه جُنُم تازه ایکه و اَ زنجیلوی مه عاری اینَهَستَه،"
        },
        {
          "verse": 17,
          "usfm": "2TI.1.17",
          "line_type": "p",
          "text": "بلکه وختی وا شهر روم رِسی، خیلی جُست مه گَردی و پیدام ایکه."
        },
        {
          "verse": 18,
          "usfm": "2TI.1.18",
          "line_type": "p",
          "text": "باشتا خداوند بهش عطا بُکنت که توو اُ روز اَ طَرَه خداوند بهش مرحمت بَشِت. و تو اَ همۀ خذمتویی که اُ توو شهر اَفِسُس ایکه خُب واخبری."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 3,
          "text": "تشویق به وفاداری"
        }
      ],
