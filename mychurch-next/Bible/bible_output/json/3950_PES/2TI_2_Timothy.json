    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 2,
      "chapter_usfm": "2TI.2",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.2.1",
          "line_type": "p",
          "text": "پَ تو، ای چوکُم، با فیضی که در مسیح عیسان کِوی بَش،"
        },
        {
          "verse": 2,
          "usfm": "2TI.2.2",
          "line_type": "p",
          "text": "و اُنچه که جلو شاهدوی زیادی اَ مه تِشنُتِن، به آدموی وفاداری بِسپار تا بُتونِن به بکیه هم یاد هادِن."
        },
        {
          "verse": 3,
          "usfm": "2TI.2.3",
          "line_type": "p",
          "text": "مثه یه سرباز خُبِ مسیح عیسی توو تحمل زجرُ همباش بَش."
        },
        {
          "verse": 4,
          "usfm": "2TI.2.4",
          "line_type": "p",
          "text": "هیچ سربازی وختی که خذمت اَکِردِن، به خوش گرفتار مشغولیتوی زندگی روزونه خو ناکُنت، به چه که هدفش ایین که به اُ که به خذمت شیگِفتِن، خشنود بُکنت."
        },
        {
          "verse": 5,
          "usfm": "2TI.2.5",
          "line_type": "p",
          "text": "یه پَهلوُن اگه طِبکِ قانونُ پَهلوُنی نَکُن، تاج کهرمونیُ نابَرِت."
        },
        {
          "verse": 6,
          "usfm": "2TI.2.6",
          "line_type": "p",
          "text": "برزگری که سخت کار اَکُنت اُن که بایه اَوِّلین کسی بَشِت که اَ محصول خو سهم اَبَرِه."
        },
        {
          "verse": 7,
          "usfm": "2TI.2.7",
          "line_type": "p",
          "text": "دربارۀ اُچه اَگَم فکر بُکن، به چه که خداوند توو همِی چی بهت فهم اَدِت."
        },
        {
          "verse": 8,
          "usfm": "2TI.2.8",
          "line_type": "p",
          "text": "عیسی مسیحُ وا یاد بیار که اَ مُردَئُن زنده بو، و اَ نسل داوود پادشاهَ؛ همطو که توو انجیلی که مه اعلام اَکُنُم گفته اِبو،"
        },
        {
          "verse": 9,
          "usfm": "2TI.2.9",
          "line_type": "p",
          "text": "که وا خاطری زجر اَکشُم، طوری که مثه یه جنایتکار وا زنجیل اُمشُکشیدِن. ولی کَلُم خدا توو زنجیل نَن."
        },
        {
          "verse": 10,
          "usfm": "2TI.2.10",
          "line_type": "p",
          "text": "پَ مه وا خاطر گُزین بودَئُن همِی چیُ طاکَت اَکُنُم تا اُشُ هم اُ نجاتیُ که در مسیح عیسان، وا جلال ابدی وا دَس بیارِن."
        },
        {
          "verse": 11,
          "usfm": "2TI.2.11",
          "line_type": "p",
          "text": "اِبو به ایی گَپ اطمینُن بُکنی که:اگه ما وا اُ مُردِیم،وا اُ اَم زندگی اَکُنیم."
        },
        {
          "verse": 12,
          "usfm": "2TI.2.12",
          "line_type": "q1",
          "text": "اگه طاکَت بُکنیموا اُ اَم حمکرانی اَکُنیم.اگه حاشایی بُکنیماُ اَم حاشامُ اَکُنت."
        },
        {
          "verse": 13,
          "usfm": "2TI.2.13",
          "line_type": "q1",
          "text": "اگه بی‌وفا بُبیم،اُ وفادار اَمونِتبه چه که ناتون به خوش حاشا بُکنت."
        },
        {
          "verse": 14,
          "usfm": "2TI.2.14",
          "line_type": "p",
          "text": "ایی چیزُئو وا یادشُ بیار و توو محضر خدا بهشُ سفارش بُکن که سر کلمه ئُو جر و دعوا نَکُنَن، که خُب نَن، بلکه فَکَه اُشُویی که اَشنُوِنُ تباه اَکُنت."
        },
        {
          "verse": 15,
          "usfm": "2TI.2.15",
          "line_type": "p",
          "text": "تَمُن سعی خو بُکن که مورد کبول خدا بِشی، مثه یه کارگری كه دلیلی بِی شرمُندگی اینین و کَلُم حکیکتُ وا درستی به کار اَگِنت."
        },
        {
          "verse": 16,
          "usfm": "2TI.2.16",
          "line_type": "p",
          "text": "ولی اَ یاوه‌گویی‌ئُوی پوچ دوری بُکن، به چه که مردمُ وا طَرَه بی‌دینیِ بِشتِه و بِشتِه اَبرِت."
        },
        {
          "verse": 17,
          "usfm": "2TI.2.17",
          "line_type": "p",
          "text": "گَپوی ایی آدمُ مثه مرض خوره پخش اِبو. هیمِنائوس و فیلِتوس اَ همی قُماشَن،"
        },
        {
          "verse": 18,
          "usfm": "2TI.2.18",
          "line_type": "p",
          "text": "که اَ راه حکیکت در هُندَن. و اَگِن که زنده بودِن اَ مُردَئُن، همی حالام اِتفاک کَفتِن. اُشُ ایمُن بعضی اَ آدمُ وِیرون اَکِردَن."
        },
        {
          "verse": 19,
          "usfm": "2TI.2.19",
          "line_type": "p",
          "text": "ولی، شالده کایُمی که خدا ایناهادِن، پابرجان، و وا ایی نوشته مُهر بودِن که: «خداوند به کسونی که مال خوشَن اَشناسه» و «بُوال هَر‌کَ نُم خداوند وا زَبُن اَتارِه، اَ نادرستی دوری بُکن.»"
        },
        {
          "verse": 20,
          "usfm": "2TI.2.20",
          "line_type": "p",
          "text": "الان توو یه لَهَر گَپ، فَکَه ظرفوی طِلا و نُگره نین، بلکه ظرفوی چوبی و گِلی اَم هَه؛ بعضیُشُ بِی کاروی مُهمِن، بعضیُشُ بِی کاروی دَمِ دستی."
        },
        {
          "verse": 21,
          "usfm": "2TI.2.21",
          "line_type": "p",
          "text": "پَ اگه کسی به خوش اَ اُنچه که اُمگو، پاک بُگنارِه، یه ظرفی اِبو بِی کاروی مهم، گُزین بودَه به عنوان یه ظرف مقدّس، که به کار صابخونه اَتات و بِی هر کار خُبی آماده اَن."
        },
        {
          "verse": 22,
          "usfm": "2TI.2.22",
          "line_type": "p",
          "text": "پَ اَ هوا و هوسوی جَوُنی در بِرَه، و واکل اُشُ که با دلی پاک خداوند صدا اَکُنِن، دُمبال صالح بودِن، ایمُن، محبت و صُل و سلامتی بَش."
        },
        {
          "verse": 23,
          "usfm": "2TI.2.23",
          "line_type": "p",
          "text": "اَ بحثویی که اَ رو نادونی و نفهمین، دوری بُکن، خوت اَدونی که جر و دعوا راه اَکَردُنِن."
        },
        {
          "verse": 24,
          "usfm": "2TI.2.24",
          "line_type": "p",
          "text": "نوکر خداوند نبایه جر و دعوا بُکنت، بلکه بایه وا همه مهربُن بَشِت، بُتون تعلیم هادِه، و در مُکابل بدی، وا صبر طاکَت بُکنت،"
        },
        {
          "verse": 25,
          "usfm": "2TI.2.25",
          "line_type": "p",
          "text": "بایه آدموییُ که ضدکاری اَکُنِن وا آرُمی اصلاحشُ بُکنت، تا بلکم خدا وازشُ توبه عطا بُکنت تا حکیکتُ بِشناسِن"
        },
        {
          "verse": 26,
          "usfm": "2TI.2.26",
          "line_type": "p",
          "text": "و به خوشُ بیانُ، اَ تله ابلیس که اسیرشُ ایکِردِن، تا خواسته ئُوی اُ رو اَنجُم هادِن در بِرَن."
