    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 4,
      "chapter_usfm": "2TI.4",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.4.1",
          "line_type": "p",
          "text": "مه، در محضر خدا و مسیح عیسی که به زندئُن و مُردَئُن حکم اَکُنت، و وا خاطر نَمایُن بودِنی و پادشاهیش، وازت سفارش اَکُنُم که:"
        },
        {
          "verse": 2,
          "usfm": "2TI.4.2",
          "line_type": "p",
          "text": "کَلُم خدائو اعلام بُکن؛ وخت و بی وخت آماده بَش و وا صبر و تعلیمِ تَمُم و کمال، نهیب هادَه و توبیخ و تشویق بُکن."
        },
        {
          "verse": 3,
          "usfm": "2TI.4.3",
          "line_type": "p",
          "text": "به چه که زَمُنی اَرِسِه که مردم طاکَت گوش دادن به تعلیم درستُ شونین، بلکه معلّمویی دور خو جمع اَکُنِن تا اُنچه که گوشِشُ شَوات و با هوا و هوسُشُ جور در اَتات اَ اُشُ بِشنُوِن؛"
        },
        {
          "verse": 4,
          "usfm": "2TI.4.4",
          "line_type": "p",
          "text": "اُشُ به گوش دادن به حکیکت پشت اَکُنِن، و وا طَرَه چیچکائُو اَ راه به در اَبِن."
        },
        {
          "verse": 5,
          "usfm": "2TI.4.5",
          "line_type": "p",
          "text": "ولی تو، همیشه هُشیار بَش، توو زجر طاکَت بیار، کار اعلام انجیلُ اَنجُم هادَه، و خذمت خو تَمُم و کمال به اَنجُم بِرَسُن."
        },
        {
          "verse": 6,
          "usfm": "2TI.4.6",
          "line_type": "p",
          "text": "به چه که خون مه، همی حالاشم مثه هدیه‌ٔ شراب رِختَه اِبودِن، و وخت رفتِنُم اَ ایی دنیا رسیدِن."
        },
        {
          "verse": 7,
          "usfm": "2TI.4.7",
          "line_type": "p",
          "text": "توو جنگ خُب، اُمجنگیدن، مسابِکهُ تَمُن اُمکِردِن، ایمُنُ نگه اُمکِردِن."
        },
        {
          "verse": 8,
          "usfm": "2TI.4.8",
          "line_type": "p",
          "text": "اَ ایی به بعد تاج صالحی بهم آماده اَن، تاجی که خداوند، اُ حاکم عادل، توو اُ روز به مه جایزه اَدِت - نه فَکَه به مه، بلکه به همه اُشُویی هم که توو شوک نَمایُن بودِنی هَستَرِن."
        },
        {
          "verse": 9,
          "usfm": "2TI.4.9",
          "line_type": "p",
          "text": "تَمُن سعی خو بُکن خیلی سریع پهلو مه بیِی."
        },
        {
          "verse": 10,
          "usfm": "2TI.4.10",
          "line_type": "p",
          "text": "به چه که دیماس وا خاطر دوست داشتن ایی دنیا به مه ول ایکِردِن و وا شهر تَسالونیکی رفتِن. کْریسکیس وا منطکه غَلاطیه و تیتوس هم وا منطکه دَلماتیه رفتِن."
        },
        {
          "verse": 11,
          "usfm": "2TI.4.11",
          "line_type": "p",
          "text": "تهنا لوقا باهامِن. به مَرقُس بِسَه و وا خوت بیار، به چه که بِی خذمت خیلی به کارُم اَتات."
        },
        {
          "verse": 12,
          "usfm": "2TI.4.12",
          "line_type": "p",
          "text": "تیخیکوسُ وا شهر اَفِسُس اُمفِرِستادِن."
        },
        {
          "verse": 13,
          "usfm": "2TI.4.13",
          "line_type": "p",
          "text": "موکِع هُندِنت قباییُ که توو شهر تْروآس پهلو کارپوس اُمناها، و همیطوَم کتابُ و مخصوصاً نوشته ئُوی پوستیُ وا خوت بیار."
        },
        {
          "verse": 14,
          "usfm": "2TI.4.14",
          "line_type": "p",
          "text": "اسکندر مِسگر، بِی مه خیلی بدی ایکه. خداوند طِبکِ کاروش سزاش اَدِت."
        },
        {
          "verse": 15,
          "usfm": "2TI.4.15",
          "line_type": "p",
          "text": "تو خوتَم اَ اُ دوری بُکن به چه که وا پیغُم ما شدید ضدکاری ایکه."
        },
        {
          "verse": 16,
          "usfm": "2TI.4.16",
          "line_type": "p",
          "text": "اَوِّلین باری که اَ خوم دفاع اُمکه، هیچکَ پُشتُم اینَگِه، بلکه همه به مه ول شُکِه. نَکه ایی به حسابشُ نوشته بَشِت."
        },
        {
          "verse": 17,
          "usfm": "2TI.4.17",
          "line_type": "p",
          "text": "ولی خداوند پهلو مه ووستا و به مه کُوّت ایدا تا اُ پیغُم اَ طریق مه تَمُم و کمال اعلام بَشِت و همۀ غیریهودیُ اُ رو بِشنُوِن. پَ مه اَ لُوِ شیر خلاص بودُم."
        },
        {
          "verse": 18,
          "usfm": "2TI.4.18",
          "line_type": "p",
          "text": "خداوند به مه اَ هر کار بدی رها اَکُنت و بِی مه به سلامت وا پادشاهی آسَمُنی خوش اَتارِه. جلال وا اُ بَشِت تا ابدالآباد. آمین!"
        },
        {
          "verse": 19,
          "usfm": "2TI.4.19",
          "line_type": "p",
          "text": "به پْریسکیلا و آکیلا و اهل لَهَر اونیسیفوروس سلام بِرَسُن."
        },
        {
          "verse": 20,
          "usfm": "2TI.4.20",
          "line_type": "p",
          "text": "اِراستوس توو شهر قُرِنتُس مُند، و مه تْروفیموسُ که مریضَ، توو شهر میلیتوس ول اُمکه."
        },
        {
          "verse": 21,
          "usfm": "2TI.4.21",
          "line_type": "p",
          "text": "تَمُن سعی خو بُکن کَبل اَ زِمستُن بیِی. یوبولوس و همیطوَم پودِنْس، لینوس، کْلودیا و همۀ کاکائُن بهت سلام اَرِسونِن."
        },
        {
          "verse": 22,
          "usfm": "2TI.4.22",
          "line_type": "p",
          "text": "خداوند وا روح تو بَشِت. فیض خدا وا شما بُبوت."
        }
      ],
