    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 3,
      "chapter_usfm": "2TH.3",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.3.1",
          "line_type": "p",
          "text": "سرآخِر، ای کاکائُن، بِی ما دعا بُکنی تا کَلُم خداوند سریع جلو بِرِت و بهش حرمت بُکنِن، همطو که میون شما بو."
        },
        {
          "verse": 2,
          "usfm": "2TH.3.2",
          "line_type": "p",
          "text": "و تا ما اَ آدموی شریر و بد خلاص بَشیم. به چه که همه ایمُن شُنی."
        },
        {
          "verse": 3,
          "usfm": "2TH.3.3",
          "line_type": "p",
          "text": "ولی خداوند وفادارِن. اُ بِی شما پابرجا اَکُنت و در مُکابل اُ شریر ازتُ محافظت اَکُنت."
        },
        {
          "verse": 4,
          "usfm": "2TH.3.4",
          "line_type": "p",
          "text": "ما در خداوند اَ شما خاطر جمعیم که اُ چیزُیی که بِی شما حکم اَکُنیم اَنجُم اَدادِین و اَ ایی به بعدَم اَنجُم اَدِین."
        },
        {
          "verse": 5,
          "usfm": "2TH.3.5",
          "line_type": "p",
          "text": "و باشتا خداوند دلُوی شمائو به محبت خدا و پایداری مسیح راهبِری بُکنت."
        },
        {
          "verse": 6,
          "usfm": "2TH.3.6",
          "line_type": "p",
          "text": "حالا، ای کاکائُن، به نُم خداوندمُ عیسی مسیح بهتُ حکم اَکُنیم که اَ هر کاکائی که تَمپَلی اَکُنت و طِبکِ رسمی که اَ ما تُگِفتِن، رفتار ناکُنت، دوری بُکنی."
        },
        {
          "verse": 7,
          "usfm": "2TH.3.7",
          "line_type": "p",
          "text": "به چه که شما خوتُ اَدونین چطو بایه اَ ما الگو بگیری، بِی چه که ما توو زَمُنی که وا شمائَریم نه تَمپَل‌ئَریم"
        },
        {
          "verse": 8,
          "usfm": "2TH.3.8",
          "line_type": "p",
          "text": "و نه نُن کسیُ مفت مُخاردِن، بلکه وا سختی و زحمت، شُووُ و رو کار مُکِه تا سربار هیچِتا اَ شما نِبیم."
        },
        {
          "verse": 9,
          "usfm": "2TH.3.9",
          "line_type": "p",
          "text": "نه وا خاطریکه ما ایی حَک مُنی، بلکه تا اَ خومُ بهتُ یه نمونه هادِیم تا شما الگو بگیری."
        },
        {
          "verse": 10,
          "usfm": "2TH.3.10",
          "line_type": "p",
          "text": "به چه که حتی زَمُنی که وا شمائَریم اییُ بهتُ حکم مُکِه که: «اگه کسی ایناوا کار بُکنت، نُن هم نَخارِت.»"
        },
        {
          "verse": 11,
          "usfm": "2TH.3.11",
          "line_type": "p",
          "text": "به چه که اَشنُویم که اَ میون شما یه عده تَمپَلی اَکُنِن، ایشُ کار ناکُنِن، بلکه توو کار بکیه سَرَک اَکِشِن."
        },
        {
          "verse": 12,
          "usfm": "2TH.3.12",
          "line_type": "p",
          "text": "حالا به ایطو آدمویی در خداوند عیسی مسیح حکم اَکُنیم و تشویقشُ اَکُنیم که بی سر و صدا کار خوشُ بُکنِن و نُنِ خو در بیارِن."
        },
        {
          "verse": 13,
          "usfm": "2TH.3.13",
          "line_type": "p",
          "text": "ولی شما ای کاکائُن، اَ خوبی کِردِن خسته نِبی."
        },
        {
          "verse": 14,
          "usfm": "2TH.3.14",
          "line_type": "p",
          "text": "اگه کسی اَ اُنچه که ما توو ایی نومه اَگِیم اطاعت اینَکِه، رو اُ آدم یه نِشُنه بُنوسی، و با اُ آمد و رفت مَکُنی، تا شرمُنده بُبوت."
        },
        {
          "verse": 15,
          "usfm": "2TH.3.15",
          "line_type": "p",
          "text": "بِی اُ به چشم دشمن نگاه مَکُنی، بلکه مثه یه کاکا بهش هشدار هادِین."
        },
        {
          "verse": 16,
          "usfm": "2TH.3.16",
          "line_type": "p",
          "text": "حالا خداوندِ صُل و سلامتی خوش، همیشه اَ هر لحاظ بِی شما صُل و سلامتی هادِه. خداوند وا همۀ شما بُبوت."
        },
        {
          "verse": 17,
          "usfm": "2TH.3.17",
          "line_type": "p",
          "text": "مه، پولس، ایی سلامُ وا دَس خوم اَنویسُم. این نِشُنهٔ مه توو همۀ نومه ئُومِن. مه ایطو اَنویسُم."
        },
        {
          "verse": 18,
          "usfm": "2TH.3.18",
          "line_type": "p",
          "text": "فیض خداوندمُ عیسی مسیح وا همۀ شما بُبوت."
        }
      ],
