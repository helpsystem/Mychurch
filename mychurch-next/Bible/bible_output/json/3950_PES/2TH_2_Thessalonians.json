    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 2,
      "chapter_usfm": "2TH.2",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.2.1",
          "line_type": "p",
          "text": "حالا ای کاکائُن، دربارۀ هُندِن خداوندمُ عیسی مسیح و جمع بودِن ما پهلو اُ، اَ شما خواهش اَکُنیم که،"
        },
        {
          "verse": 2,
          "usfm": "2TH.2.2",
          "line_type": "p",
          "text": "سریع فکرتُ بهم نریزه و توو هول وَلا نَکی، چه اَ طریق یه روح چه وا یه گَپ، چه وا یه نومه ای که انگار اَ طَرَه مان، که اَگِت روز برگشتِن خداوند عیسی رسیدِن."
        },
        {
          "verse": 3,
          "usfm": "2TH.2.3",
          "line_type": "p",
          "text": "مَوالی هیچکَ هیچ رَکَمَ گولتُ بِزَنت. به چه که اُ روز نِتا، مگه ایکه اَوِّل شورشت به ضدّ خدا اِتفاک بِکِت، و اُ مَرد بی‌دین، که پُس هلاکتِن، نَمایُن بَشِت،"
        },
        {
          "verse": 4,
          "usfm": "2TH.2.4",
          "line_type": "p",
          "text": "اُ وا هر چه که نُمی خدا بَشِت و پرستش بَشِت ضدکاری اَکُنت، و بِی خوش بالاته اَبَرِه، طوری که توو معبد خدا اَنینگِت و بِی خو خدا اعلام اَکُنت."
        },
        {
          "verse": 5,
          "usfm": "2TH.2.5",
          "line_type": "p",
          "text": "مگه یادتُ نِتا وختی که هِنو باهاتُ ئَرُم، ایی چیزُئو بهتُ اُمگو؟"
        },
        {
          "verse": 6,
          "usfm": "2TH.2.6",
          "line_type": "p",
          "text": "شما اَدونی که حالا چه چیزی جلوی هُندِنی اَگِنت، و باعث اِبوت که اُ فَکَه توو زَمُن مناسب خویی نَمایُن بَشِت."
        },
        {
          "verse": 7,
          "usfm": "2TH.2.7",
          "line_type": "p",
          "text": "بِی چه که رازِ بی‌دینی، هِمی حالائَم کار اَکِردِن، ولی فَکَه تا وختی که اُ کسی که تا الان جلو دارِشن، اَ بین بِرِت."
        },
        {
          "verse": 8,
          "usfm": "2TH.2.8",
          "line_type": "p",
          "text": "اُغایه اُ مَرد بی‌دین نَمایُن اِبو، همو که خداوند عیسی بِی اُ وا نَفس دهن خو اَکُشِه و وا جلال هُندِنِ خو، بِی اُ نابود اَکُنت."
        },
        {
          "verse": 9,
          "usfm": "2TH.2.9",
          "line_type": "p",
          "text": "هُندِن اُ مَرد بی‌دین اَ طریق کار شِیطُن، وا تَمُن کُدرَت و وا نِشُنه ئُو و معجزه ئُوی دوروغکایی،"
        },
        {
          "verse": 10,
          "usfm": "2TH.2.10",
          "line_type": "p",
          "text": "و وا تَمُن فریبوی شرارتِن، بِی کسونی که هلاک اِبودَن، به چه که اُشُ زیر بار نَرفتَن که بِی حکیکت دوس شُبَشِت و ایطوکا نجات پیدا بُکنِن."
        },
        {
          "verse": 11,
          "usfm": "2TH.2.11",
          "line_type": "p",
          "text": "پَ خدا گرفتار یه فریب گپی شاکُن، تا اُشُ اُنچه که دروغنُ باور بُکنِن."
        },
        {
          "verse": 12,
          "usfm": "2TH.2.12",
          "line_type": "p",
          "text": "تا ایطوکا همۀ اُشُویی که به حکیکت ایمُن شُنَواردِن، بلکه اَ هر چه که نادرستن کیف شُکِردِن، محکوم بَشِن."
        },
        {
          "verse": 13,
          "usfm": "2TH.2.13",
          "line_type": "p",
          "text": "ولی ای کاکائُنی که عزیز خداوندین، ما بایه همیشه خدائو وا خاطر شما شُکر بُکنیم، به چه که خدا شمائو مثه بر اَوِّل گُزین ایکه تا نجات پیدا بُکنین، اَ طریق مقدّس بودِن به وسیله روح خدا و اَ طریق ایمُن واردن به حکیکت."
        },
        {
          "verse": 14,
          "usfm": "2TH.2.14",
          "line_type": "p",
          "text": "اُ بِی شما اَ طریق انجیلی که ما اعلام مُکِه دعوت ایکه، تا شما اَ جلال خداوندمُ عیسی مسیح سهمی تُبَشِت."
        },
        {
          "verse": 15,
          "usfm": "2TH.2.15",
          "line_type": "p",
          "text": "پَ ای کاکائُن، کایُم ووستین و رسم و رسوم ئُویی که چه وا گَپِمُ چه وا نومه مو اَ ما یاد تُگفِتنُ کایُم بُگناری."
        },
        {
          "verse": 16,
          "usfm": "2TH.2.16",
          "line_type": "p",
          "text": "حالا خودِ خداوندمُ عیسی مسیح، و بَپمُ خدا، که به ما دوس ایشَستَه و اَ طریق فیض، بِی ما دلگرمی ابدی و یه امید خُب ایدا،"
        },
        {
          "verse": 17,
          "usfm": "2TH.2.17",
          "line_type": "p",
          "text": "به شما دلگرم بُکنت و توو هر کار و گَپ خُبی پابرجا بُکنت."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 13,
          "text": "کایُم ووستِی"
        }
      ],
