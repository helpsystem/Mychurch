  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 1,
      "chapter_usfm": "2TH.1",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.1.1",
          "line_type": "p",
          "text": "اَ طَرَه پولس، سیلاس و تیموتائوس،به کلیسای شهر تَسالونیکی که در بَپِمُ خدا، و خداوند عیسی مسیحَن:"
        },
        {
          "verse": 2,
          "usfm": "2TH.1.2",
          "line_type": "p",
          "text": "فیض و صُل و سلامتی اَ طَرَه بَپِمُ خدا، و خداوند عیسی مسیح وا شما بُبوت."
        },
        {
          "verse": 3,
          "usfm": "2TH.1.3",
          "line_type": "p",
          "text": "ای کاکائُن، ما بایه همیشه خدائو وا خاطر شما شُکر بُکنیم، دُرستِشم همین، به چه که ایمُن شما فَرایُن رشد اَکِردِن، و محبت هر تِی اَ شما نسبت بی همدگه بِشتِه اِبودِن."
        },
        {
          "verse": 4,
          "usfm": "2TH.1.4",
          "line_type": "p",
          "text": "پَ، ما خومُ توو کلیسائُوی خدا وا خاطر پایداریتُ و ایمُنِتُ توو همۀ اذیت و آزارُ و توو مصیبتویی که طاکَت اَتارین، بِی شما اَبالیم."
        },
        {
          "verse": 5,
          "usfm": "2TH.1.5",
          "line_type": "p",
          "text": "ایی گواهیِ حکمِ عادلانۀ خدان، تا شما لایِک پادشاهی خدا به حساب بیِین، که وا خاطری زجر اَم اَکِشین."
        },
        {
          "verse": 6,
          "usfm": "2TH.1.6",
          "line_type": "p",
          "text": "به چه که واکعاً خدا اییُ انصاف اَدونت که به اُشُویی که به شما زجر اَدِن، وا زجر جوابشُ هادِه،"
        },
        {
          "verse": 7,
          "usfm": "2TH.1.7",
          "line_type": "p",
          "text": "و به شمایی که زجر اَکِشیدِین وا ما آرُمی اَدِت. ایی کار موکعی اَنجُم اِبو که خداوند عیسی واکل فرشته‌ئُون کُدرَتمندش وا آتِش غَلمَش اَ آسَمُن نَمایُن بُبوت،"
        },
        {
          "verse": 8,
          "usfm": "2TH.1.8",
          "line_type": "p",
          "text": "اُ اَ اُشُویی که خدائو ناشناسَن و اَ اُشُویی که اَ انجیل خداوندمُ عیسی اطاعت ناکُنِن، تکاص اَگِنت."
        },
        {
          "verse": 9,
          "usfm": "2TH.1.9",
          "line_type": "p",
          "text": "مجازات اُشُ نابودی ابدین، دور اَ محضر خداوند و دور اَ جلالِ کُدرَتی،"
        },
        {
          "verse": 10,
          "usfm": "2TH.1.10",
          "line_type": "p",
          "text": "توو اُ روزی که اُ اَتات، تا میون ایمُندارُن خوش جلال پیدا بُکنت، و تا همۀ اُشُوییُ که ایمُن شُواردِن، اَ اُ بُهتِشُ بِزَنت و شمام که به شهادت ما ایمُن تُواردِن، جزوِشُ اِبین."
        },
        {
          "verse": 11,
          "usfm": "2TH.1.11",
          "line_type": "p",
          "text": "به هِمی خاطر ما همیشه بِی شما دعا اَکُنیم تا خدای ما بِی شما لایِک دعوت خو بُدُنِت و وا کُدرَت خویی هر کَصد خُب و هر کاری که اَ رو ایمُنِن، به اَنجُم بِرَسُنه،"
        },
        {
          "verse": 12,
          "usfm": "2TH.1.12",
          "line_type": "p",
          "text": "تا نُم خداوندمُ عیسی در شما جلال پیدا بُکنت، و شمام در اُ جلال پیدا بُکنی، طِبکِ فیض خدامُ و خداوند عیسی مسیح."
        }
      ],
      "verse_count": 12,
      "headings": [
        {
          "before_verse": 3,
          "text": "شکرگزاری"
        },
        {
          "before_verse": 5,
          "text": "حکم کِردِن موکِع برگشتِن مسیح"
        }
      ],
