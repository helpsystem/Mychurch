    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 4,
      "chapter_usfm": "JAS.4",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.4.1",
          "line_type": "p",
          "text": "چه اِبو که جنگ و جر و دعوا میونتُ راه اَکِت؟ مگه ایی نَن که هوا و هوسُتُ تو وجودتُ جنگ اَکُنِن؟"
        },
        {
          "verse": 2,
          "usfm": "JAS.4.2",
          "line_type": "p",
          "text": "دلتُ پَل پَل اَزَنت و تُنی؛ پَ کَتل اَکُنین. حرص اَزِنین و ناتونین وا دَس بیارین، پَ جنگُ و جر و دعوا راه اَکَردُنین. تُنی وا خاطر ایکه تُناوا."
        },
        {
          "verse": 3,
          "usfm": "JAS.4.3",
          "line_type": "p",
          "text": "تاوا و به دَس نِتارین، وا خاطر ایکه اُ رو وا نیّت بد درخواست اَکُنی تا صرف هوا و هوسُ خو بُکنی."
        },
        {
          "verse": 4,
          "usfm": "JAS.4.4",
          "line_type": "p",
          "text": "شما ای مردم زناکار، مگه نادونی دوستی با دنیا دشمنی با خدان؟ پَ هَرکَ شَوا با دنیا دوستی بُکنت، به خوش دشمن خدا اَکُنت."
        },
        {
          "verse": 5,
          "usfm": "JAS.4.5",
          "line_type": "p",
          "text": "یا گَمون اَکُنی نوشته مقدّس بی هدف اَگِت که: «خدا به روحی که در ما ساکن ایکِردِن خیلی غیرت ایشَه»؟"
        },
        {
          "verse": 6,
          "usfm": "JAS.4.6",
          "line_type": "p",
          "text": "ولی خدا بِشتِه فیض اَدِت. وا هِمی خاطر توو کتاب مَثَلُو نوشته بودِن:«خدا جلو آدموی متکبّر اِووسته،ولی به آدموی افتاده با لطف رفتار اَکُنت.»"
        },
        {
          "verse": 7,
          "usfm": "JAS.4.7",
          "line_type": "p",
          "text": "پَ اَ خدا اطاعت بُکنی. جلو ابلیس ووستِی، که ابلیس هم اَ شما فرار اَکُنت."
        },
        {
          "verse": 8,
          "usfm": "JAS.4.8",
          "line_type": "p",
          "text": "به خدا نِزیک بِشی، که خدا هم به شما نِزیک اِبو. ای شما آدموی گناهکار، دَسُ خو تمیز بُکنی، و ای شما آدموی دَمدَمی، دلُ خو پاک بُکنی."
        },
        {
          "verse": 9,
          "usfm": "JAS.4.9",
          "line_type": "p",
          "text": "عزا و ماتَم بگیری و گیریک بُکنی. بُوالی خندَتُ به ماتَم، و شادیتُ به غم تبدیل بَشِت."
        },
        {
          "verse": 10,
          "usfm": "JAS.4.10",
          "line_type": "p",
          "text": "بِی خوتُ در محضر خداوند افتاده بُکنی که اُ به شما سرفراز اَکُنت."
        },
        {
          "verse": 11,
          "usfm": "JAS.4.11",
          "line_type": "p",
          "text": "ای کاکائُن، به ضدّ هم بدگویی مَکُنی، هَرکَ به ضدّ کاکا خو بدگویی بُکنت و یا بِی کاکا خو حکم بُکنت، به ضدّ شریعت بدگویی ایکِردِن و شریعتُ حکم ایکِردِن. ولی اگه تو شریعتُ حکم بُکنی، دگه عمل کنندۀ شریعت نِهی، بلکه قاضی اُیی!"
        },
        {
          "verse": 12,
          "usfm": "JAS.4.12",
          "line_type": "p",
          "text": "فَکَه یکی هَه که شریعت اَدِت و حکم اَکُنت، همو کسی که اِتون هم نجات هادِه هم نابود بُکنت. ولی تو کی که به هَمسادَه خو حکم اَکُنی!"
        },
        {
          "verse": 13,
          "usfm": "JAS.4.13",
          "line_type": "p",
          "text": "حالا شما که اَگِی: «اِمرو یا صَبا به فلان شهر اَرِیم و یه سال اُجا اَمونیم و کار و کاسبی راه اَکَردُنیم و سود اَکُنیم،» خُب گوش هادِین:"
        },
        {
          "verse": 14,
          "usfm": "JAS.4.14",
          "line_type": "p",
          "text": "شما هِنوزا نادونین صَبا چه سر راهتُ اَنوسِه؛ مگه زندگی شما چِن؟ به چه که شما مثه گِراهین که یه لحظه نَمایُن اِبو و بعد محو اِبو."
        },
        {
          "verse": 15,
          "usfm": "JAS.4.15",
          "line_type": "p",
          "text": "در عوض شما بایه ایطو بِگِی که: «اگه خداوند بُخواد، زنده اَمونیم و ایطو و اُطُو اَکُنیم.»"
        },
        {
          "verse": 16,
          "usfm": "JAS.4.16",
          "line_type": "p",
          "text": "ولی الان شما به تکبر خو اَنازین. هر تکبری که ایطوکا بُبو، بَدِن!"
        },
        {
          "verse": 17,
          "usfm": "JAS.4.17",
          "line_type": "p",
          "text": "پَ، هَرکَ بُدُنِت چه کاری درستِن و اَنجُمی نَدِه، گناه ایکِردِن."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 13,
          "text": "تکبر دربارۀ صَبا"
        }
      ],
