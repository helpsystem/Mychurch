  "chapters": [
    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 1,
      "chapter_usfm": "JAS.1",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.1.1",
          "line_type": "p",
          "text": "اَ یَعکوب، غُلُم خدا و خداوند عیسی مسیح،به دوازده کبیله کوم خدا که بکیه جائُو پَخشَن.سلام!"
        },
        {
          "verse": 2,
          "usfm": "JAS.1.2",
          "line_type": "p",
          "text": "ای کاکائُن مه، هروَه با امتحانوی مختلف رو وا رو اِبین، اییُ یه شادی گپی بُدُنی!"
        },
        {
          "verse": 3,
          "usfm": "JAS.1.3",
          "line_type": "p",
          "text": "چون اَدونین امتحان بودِنِ ایمُنِتُ، باعث پایداری اِبو."
        },
        {
          "verse": 4,
          "usfm": "JAS.1.4",
          "line_type": "p",
          "text": "بُوالی پایداری کار خو کامل اَنجُم هادِه تا بالغ و کامل بَشین و چیزی کم تُنِبو."
        },
        {
          "verse": 5,
          "usfm": "JAS.1.5",
          "line_type": "p",
          "text": "اگه کسی اَ شما محتاج حکمتِن، اَ خدا بُخواد و بهش داده اِبو. اَ همو خدایی که با سخاوت و بدون ایکه سرزنش بُکنت، به همه اَدِت."
        },
        {
          "verse": 6,
          "usfm": "JAS.1.6",
          "line_type": "p",
          "text": "ولی اُ آدم با ایمُن بُخواد و هیچ شکی اینَبَشِت، چون کسی که شک ایشَه، مثه موج دیریان که باد به اُ اَبَرِه و به ایی طَرَه و اُ طَرَه شَکردُنه."
        },
        {
          "verse": 7,
          "usfm": "JAS.1.7",
          "line_type": "p",
          "text": "ایطو آدمی نبایه فکر بُکنت که اَ خداوند چیزی اَگِنت،"
        },
        {
          "verse": 8,
          "usfm": "JAS.1.8",
          "line_type": "p",
          "text": "اُ یه آدم دَمدَمین و توو هیچِتا اَ رفتارُش ثبات اینی."
        },
        {
          "verse": 9,
          "usfm": "JAS.1.9",
          "line_type": "p",
          "text": "کاکائی که فَخیرِن بایه به سرفرازی خو در حضور خدا بُباله،"
        },
        {
          "verse": 10,
          "usfm": "JAS.1.10",
          "line_type": "p",
          "text": "و کاکای پولدار هم به فروتنی خو، چونکه اُ مثه گل صحرا اَ بین اَرِه."
        },
        {
          "verse": 11,
          "usfm": "JAS.1.11",
          "line_type": "p",
          "text": "به چه که خورشید با گرمای سوزُن خو در اَتا، و علفُ اَخُشکُنِه؛ گُلِش اَکِت و جُنیش نابود اِبو، همیطوَم آدم پولدار میون مشغله ئُوش، اَ بین اَرِه."
        },
        {
          "verse": 12,
          "usfm": "JAS.1.12",
          "line_type": "p",
          "text": "خوش به حال آدمی که توو امتحانُ پایدار اَمونِت، چون وختی اَ امتحان سربلند در بیاد، اُ تاج زندگیُ اَگِنت، همو تاجی که خدا به کسونی که دوستی شُهَه وعده ایدادِن."
        },
        {
          "verse": 13,
          "usfm": "JAS.1.13",
          "line_type": "p",
          "text": "هیچکَ وختی وسوسه اِبو نَگِت: «خدان که به مه وسوسه اَکُنت،» چونکه خدا با هیچ بدی ناتون وسوسه بَشِت، و خویی هم به کسی وسوسه ناکُنت."
        },
        {
          "verse": 14,
          "usfm": "JAS.1.14",
          "line_type": "p",
          "text": "ولی موکعی که کسی وسوسه اِبو، هوا و هوس خوشِن که گولش اَزَنت و به اُ اَ راه به در اَکُنت."
        },
        {
          "verse": 15,
          "usfm": "JAS.1.15",
          "line_type": "p",
          "text": "پَ وختی هوا و هوس اُشکُمی بَشِت، گناه اَزائِت و گناه هم وختی حسابی گَپ بُبوت، مرگ به بار اَتارِه."
        },
        {
          "verse": 16,
          "usfm": "JAS.1.16",
          "line_type": "p",
          "text": "کاکائُن عزیز مه، گول مَخواری!"
        },
        {
          "verse": 17,
          "usfm": "JAS.1.17",
          "line_type": "p",
          "text": "هر عطای خُب و هر عطای کامل اَ بالان، اَ طَرَه بَپِ نورُ اَتا. همو بَپی که در اُ نه تغییرین و نه هیچ سایه ای که نتیجه تغییر بَشِت."
        },
        {
          "verse": 18,
          "usfm": "JAS.1.18",
          "line_type": "p",
          "text": "اُ طِبکِ اراده خو مائُو با کَلُم حکیکت بوجود ایوا تا مثه بَرِ اَوِّل آفریده‌ئُوی اُ بَشیم."
        },
        {
          "verse": 19,
          "usfm": "JAS.1.19",
          "line_type": "p",
          "text": "کاکائُن عزیز مه، اییُ بُدُنی: هر‌کسی توو شنیدِنْ تُند، توی گُفتِنْ کُند و توو خشم اَم کُند بَشِت!"
        },
        {
          "verse": 20,
          "usfm": "JAS.1.20",
          "line_type": "p",
          "text": "به چه که خشم آدمی اُ صالحی که خدا شَوا به بار نِتارِه."
        },
        {
          "verse": 21,
          "usfm": "JAS.1.21",
          "line_type": "p",
          "text": "پَ هر نوع فسادی و هر اثری که اَ شرارتِن اَ خوتُ دور بُکنی و با افتادگی، کَلُمی که توو دل شما کاشته بودِن کبول بُکنی، همو کَلُمی که اِتون جُنِتُ نجات هادِه."
        },
        {
          "verse": 22,
          "usfm": "JAS.1.22",
          "line_type": "p",
          "text": "ولی اَنجُم دهنده ئُوی کَلُم خدا بَشین، نه ایکه فَکَه شنونده ئُوی اُ؛ که به خوشُ گول اَزَنِن!"
        },
        {
          "verse": 23,
          "usfm": "JAS.1.23",
          "line_type": "p",
          "text": "چون اُ آدمی که کَلُم خدائو اَشنُوِه و به اُ کَلُم عمل ناکُن، مثه کسین که توو اُینه نگاه رو خو اَکُنت"
        },
        {
          "verse": 24,
          "usfm": "JAS.1.24",
          "line_type": "p",
          "text": "چونکه اُ به خوش نگاه اَکُنتُ اَرِه، و درجا یادش اَرِه که چه شکلیَ."
        },
        {
          "verse": 25,
          "usfm": "JAS.1.25",
          "line_type": "p",
          "text": "ولی اُ کِ به شریعتِ کامل نگاه اَکُنت به اُ شریعت آزادی، و به اُ عمل اَکُنت، شنوندۀ فراموشکار نَن بلکه اَنجُم دهندۀ اُن. اُ توو کاری که اَکُنت برکت اَگِنت."
        },
        {
          "verse": 26,
          "usfm": "JAS.1.26",
          "line_type": "p",
          "text": "اگه کسی گَمون اَکُنت که دیندارِن ولی جلو زَبُن خو ناگُناره و به دل خو گول بِزَنت، دینداری اُ آدم بی ارزشِن."
        },
        {
          "verse": 27,
          "usfm": "JAS.1.27",
          "line_type": "p",
          "text": "دینداریِ پاک و بی لکه که مد نظر خدای بَپِن، ایین: کمک کِردِن به یتیمُ و بیوه‌زنُ موکِع مصیبتُشُ، و حفظ کِردِن خومُ اَ فسادوی ایی دنیا."
        }
      ],
      "verse_count": 27,
      "headings": [
        {
          "before_verse": 2,
          "text": "امتحان کِردِن ایمُن"
        },
        {
          "before_verse": 19,
          "text": "کَلُمُ شنیدِن و اَنجُم دادن"
        }
      ],
