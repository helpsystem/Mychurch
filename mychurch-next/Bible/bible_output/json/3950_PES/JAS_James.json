    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 5,
      "chapter_usfm": "JAS.5",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.5.1",
          "line_type": "p",
          "text": "حالا شما ای پولدارُن، وا خاطر مصیبتویی که سرتُ اَتات گیریک و زاری بُکنی."
        },
        {
          "verse": 2,
          "usfm": "JAS.5.2",
          "line_type": "p",
          "text": "مال و منالتُ اَ بین رفتِن و جِمه ئُوتُ بید ایخاردِن!"
        },
        {
          "verse": 3,
          "usfm": "JAS.5.3",
          "line_type": "p",
          "text": "طِلا و نُگره ئُوتُ مَنگ ایزدِن، و مَنگِ اُشُ به ضدّ شما شهادت اَدِن و مثه آتِش، گوشت جُنِتُ اَخارِن. شما بِی روزُیِ آخِر ایطو مال و مِنالی جمع تُکِردِن!"
        },
        {
          "verse": 4,
          "usfm": "JAS.5.4",
          "line_type": "p",
          "text": "حالا مُزد کارگرویی که زمینوتُ دِرُو شُکِردِن، همو مُزدی که شما وا گول پهلو خوتُ نگه تُکِردِن و تُنَدادِن، به ضدّ شما فریاد اَزَنِن و نالِشت دروگرُن به گوش خداوندِ لشکرُ رسیدِن."
        },
        {
          "verse": 5,
          "usfm": "JAS.5.5",
          "line_type": "p",
          "text": "شما توو ایی دنیا توو تجمل و عیش و نوش زندگی تُکِردِن. شما دلُ خو بِی روز کشتار پروار تُکِردِن!"
        },
        {
          "verse": 6,
          "usfm": "JAS.5.6",
          "line_type": "p",
          "text": "شما به آدم صالح، محکوم تُکِردِن و ایتُکُشتِن. اُ در مُکابل شما ناووسته."
        },
        {
          "verse": 7,
          "usfm": "JAS.5.7",
          "line_type": "p",
          "text": "پَ ای کاکائُن، تا زَمُنی که خداوند اَتا صبر بُکنی. بیگینی که چطو برزگر به محصول با ارزش زمین انتظار اَکِشِه و بهش صبر اَکُنت؛ تا زَمُنی که بارونوی اَوِّل و آخِر یعنی پاییزی و بهاری رو زمین بُباره."
        },
        {
          "verse": 8,
          "usfm": "JAS.5.8",
          "line_type": "p",
          "text": "شمام صبر بُکنی. دلتُ کایُم بُبوت، چونکه هُندِنِ خداوند نِزیکِن!"
        },
        {
          "verse": 9,
          "usfm": "JAS.5.9",
          "line_type": "p",
          "text": "ای کاکائُن، اَ همدگه شاکی مَبَشی، تا به شما هم حکم نَبَشه، بیگینی ’قاضی‘ دَمِ در ووستادِن."
        },
        {
          "verse": 10,
          "usfm": "JAS.5.10",
          "line_type": "p",
          "text": "ای کاکائُن، پیغُمبَرُنی که در نُم خداوند گَپ شازَه، توو زجر کشیدِن و صبر کِردِن بهتُ نمونه بَشِن."
        },
        {
          "verse": 11,
          "usfm": "JAS.5.11",
          "line_type": "p",
          "text": "ما به آدمویی که پایدارن اَ خدا برکت گِفتَه اَدونیم. شما دربارۀ پایداری ایوب تُشنُتِن، و سرانجُمِ کار خداوندُ تُدیدِن که خداوند چِکَک مهربُن و رحیمن."
        },
        {
          "verse": 12,
          "usfm": "JAS.5.12",
          "line_type": "p",
          "text": "ولی ای کاکائُنُم، مهمته اَ همه اینَکِه کَسَم مَخاری؛ نه به آسَمُن نه به زمین و نه به هیچ چیز دگه. بلکه بُوالی ’بله‘ شما همو بله بَشِت و ’نه‘ شما همو نه، تا محکوم نَبِشین."
        },
        {
          "verse": 13,
          "usfm": "JAS.5.13",
          "line_type": "p",
          "text": "بین شما کسی هَن که زجر اَکِشِه؟ اُ دعا بُکنت؛ اَ شما کسی هَن که شادِن؟ اُ حمد و ثنا بُخونه."
        },
        {
          "verse": 14,
          "usfm": "JAS.5.14",
          "line_type": "p",
          "text": "بین شما کسی هَن که مریضِن؟، اُ به شیخوی کلیسا صدا بُکن تا اُشُ بهش دعا بُکنِن و به نُم خداوند به اُ با روغن تدهین بُکنِن."
        },
        {
          "verse": 15,
          "usfm": "JAS.5.15",
          "line_type": "p",
          "text": "با ایمُن دعا کِردِن، آدم مریضُ نجات اَدِت و خداوند به اُ اَ جاش بلند اَکُنت، و اگه هم گناهُنی ایکِردِن، بخشیده اِبو."
        },
        {
          "verse": 16,
          "usfm": "JAS.5.16",
          "line_type": "p",
          "text": "پَ پهلوی همدگه به گناهُن خو اعتراف بُکنی و به همدگه دعا بُکنی تا شفا پیدا بُکنین. دعای آدم صالح کُدرَت زیادی ایشَه و مؤثّرن."
        },
        {
          "verse": 17,
          "usfm": "JAS.5.17",
          "line_type": "p",
          "text": "الیاس پیغُمبَر یه آدمیَ مثه ما، و اَ تِه دل دعا ایکه که بارون نیاد و سه سال و نیم رو زمین بارون نَهُند؛"
        },
        {
          "verse": 18,
          "usfm": "JAS.5.18",
          "line_type": "p",
          "text": "بعد دوبارَه الیاس دعا ایکه و اَ آسَمُن بارون زیر ایدا و زمین ثمر خو ایدا."
        },
        {
          "verse": 19,
          "usfm": "JAS.5.19",
          "line_type": "p",
          "text": "ای کاکائُن مه، اگه بین شما یکی اَ حکیکت منحرف بَشِت، و یه نُفر به اُ بَربِگَردُنه،"
        },
        {
          "verse": 20,
          "usfm": "JAS.5.20",
          "line_type": "p",
          "text": "اُ آدم بُدُنِت که هَرکَ گناهکاریُ اَ گمراهیش بَربِگَردُنه، جُنِش اَ مرگ نجات اَدِت و گناهوی زیادیُ اَپوشُنه."
        }
      ],
