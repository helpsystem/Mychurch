    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 3,
      "chapter_usfm": "JAS.3",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.3.1",
          "line_type": "p",
          "text": "کاکائُن مه، خیلیُتُ دُمبال ایی مَبی که معلّم بَشین، چون اَدونین به ما که یاد اَدِیم، محاکمه سخت‌ته اِبو."
        },
        {
          "verse": 2,
          "usfm": "JAS.3.2",
          "line_type": "p",
          "text": "چونکه ما همه توو خیلی چیزُ خطا اَکُنیم. اگه کسی توو گَپ زدن خو خطا نَکُن، آدم کاملین و اِتون تَمُن بدن خو مهار بُکنت."
        },
        {
          "verse": 3,
          "usfm": "JAS.3.3",
          "line_type": "p",
          "text": "ما وا لُوو اسبُ اُوسار اَبَندیم، و ایطوکا به اُشُ مطیع خو اَکُنیم تا اَ ما اطاعت بُکنِن، و کل هیکل حیونُ هم به هر طَرَه که ماوات اَبِریم."
        },
        {
          "verse": 4,
          "usfm": "JAS.3.4",
          "line_type": "p",
          "text": "به غُرابُ هم نگاه بُکنین با ایکه خیلی گَپَن و بادوی کِوی حرکتشُ اَدَن ولی با یه سطحه کوچِک، به هر طَرَه که ناخدا شَوا راهبِری اَبِن."
        },
        {
          "verse": 5,
          "usfm": "JAS.3.5",
          "line_type": "p",
          "text": "همیطوَم، زَبُن عضو کوچِکین، ولی بازم ادعائُوی گَپ ایشَن. یه پُروک کوچِکی چطو یه جنگل گِپیُ آتِش اَزَنت!"
        },
        {
          "verse": 6,
          "usfm": "JAS.3.6",
          "line_type": "p",
          "text": "زَبُن آتِشِن؛ یه دنیا شرارتِن. زَبُن یه عضوین بین اعضای بدنمُ که تَمُنِ بدنُ ساحار اَکُنت و همۀ دوران زندگیُ به آتِش اَکِشِه - آتِشی که اَ جَهَندم شعله اَگِفتِن!"
        },
        {
          "verse": 7,
          "usfm": "JAS.3.7",
          "line_type": "p",
          "text": "چونکه آدمی همه نوع جناور وحشی و پرنده و خزنده و جناور دیریائو اِتون اهلی بُکنت و ایکِردِن،"
        },
        {
          "verse": 8,
          "usfm": "JAS.3.8",
          "line_type": "p",
          "text": "ولی هیچ آدمی ناتون به زَبُن اهلی بُکنت. زَبُن یه شَرین که آرُم و کرار اینی و پُر اَ زهر کُشنده اَن!"
        },
        {
          "verse": 9,
          "usfm": "JAS.3.9",
          "line_type": "p",
          "text": "وا ایی زَبُن بِی خداوندمُ و بَپ آسَمُنیمُ حمد و ثنا اَکُنیم و وا همی زَبُنَم مَردُمیُ که به شباهت خدا خَلک بودَن، اِسپار اَکُنیم."
        },
        {
          "verse": 10,
          "usfm": "JAS.3.10",
          "line_type": "p",
          "text": "اَ یه لُوو، هم حمد و ثنا در اَتا، هم اِسپار! ای کاکائُن مه، ایی چیزُ درست نَن ایطو بَشِت."
        },
        {
          "verse": 11,
          "usfm": "JAS.3.11",
          "line_type": "p",
          "text": "مگه اِبو اَ یه چشمه هم هُووِ شیرین در بیات، هم هُووِ سور؟"
        },
        {
          "verse": 12,
          "usfm": "JAS.3.12",
          "line_type": "p",
          "text": "ای کاکائُن مه، مگه اِبو دِرَهت انجیر، زیتون بَر هادِه؟ یا دِرَهت انگور، انجیر هادِه؟ همیطوَم اَ چشمۀ هُووِ سور ناتون هُووِ شیرین در بیات."
        },
        {
          "verse": 13,
          "usfm": "JAS.3.13",
          "line_type": "p",
          "text": "میون شما حکیم و داناتُ کِن؟ بُوالی اُ آدم اییُ با درست زندگی کِردِن خو نِشُن هادِه، با کارُش که همراه با افتادگین که اَ حکمت سرچشمه اَگِنت."
        },
        {
          "verse": 14,
          "usfm": "JAS.3.14",
          "line_type": "p",
          "text": "ولی اگه توو دل خو دیدن کوری تلخ و خودخواهی تُهَه، به خوتُ مبالی و به ضدّ حکیکت گَپ مَزِنی."
        },
        {
          "verse": 15,
          "usfm": "JAS.3.15",
          "line_type": "p",
          "text": "ایطو حکمتی اَ آسَمُن نِتا، بلکه زمینی و نفسانی و شیطانین."
        },
        {
          "verse": 16,
          "usfm": "JAS.3.16",
          "line_type": "p",
          "text": "به چه که هر جا دیدن کوری و خودخواهی بَشِت، اُجا بی نظمی به پا اِبو و هر نوع رفتار زشتی هم هَستِن."
        },
        {
          "verse": 17,
          "usfm": "JAS.3.17",
          "line_type": "p",
          "text": "ولی اُ حکمت که اَ آسَمُنِن، اَوِّل پاکِن، بعد صُل‌طلب و آرُم، نصیحت پَذیرِن، و پُر اَ رحمت و ثمرُیِ خُبِن، و بدون دوچِشی و دورویی!"
        },
        {
          "verse": 18,
          "usfm": "JAS.3.18",
          "line_type": "p",
          "text": "و صالح بودِن، ثمرین که توو صُل و صفا، و به دَسِ آدموی صُل جو کاشته اِبو."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 13,
          "text": "حکمت اَ بالا"
        }
      ],
