    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 2,
      "chapter_usfm": "JAS.2",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.2.1",
          "line_type": "p",
          "text": "کاکائُن مه، شمائُویی که به سرورمُ عیسی مسیح، اُ خداوند جلال، ایمُن تُهَه، دو چِشی به مردم نگاه مَکُنی."
        },
        {
          "verse": 2,
          "usfm": "JAS.2.2",
          "line_type": "p",
          "text": "چون اگه کسی با انگشتر طِلا و جِمه گرون به مجلس شما بیاد و یه فَخیر هم با جِمه کُنَه داخل بَشِت،"
        },
        {
          "verse": 3,
          "usfm": "JAS.2.3",
          "line_type": "p",
          "text": "و اگه شما به اُ که جِمه گرون گَر ایکِردِن بِشتِه توجه بُکنی و به اُ بِگِی که: «بُفرما ایجا بالا بِنین،» ولی به فَخیرُ بِگِی: «همو جا ووستا!» و یا: «ایجا پهلو پائُوی مه بِنین،»"
        },
        {
          "verse": 4,
          "usfm": "JAS.2.4",
          "line_type": "p",
          "text": "حالا ایطو بین خوتُ دو چِشی نگاه تُنَکِردِن و با فکروی شریر حکم تُنَکِردِن؟"
        },
        {
          "verse": 5,
          "usfm": "JAS.2.5",
          "line_type": "p",
          "text": "کاکائُن عزیز مه، گوش هادِی! مگه خدا به فَخیروی ایی دنیا گُزین اینَکِه تا در ایمُن غنی بَشِن و اُ پادشاهیُ وا ارث بُبَرِن که به کسونی که دوستی شُهَه وعده ایدادِن؟"
        },
        {
          "verse": 6,
          "usfm": "JAS.2.6",
          "line_type": "p",
          "text": "ولی شما به آدم فَخیر بی حرمتی تُکِردِن. مگه همی آدموی پولدار نَهَن که به شما ظلم اَکُنِن و به مَحکمه اَکِشِن؟"
        },
        {
          "verse": 7,
          "usfm": "JAS.2.7",
          "line_type": "p",
          "text": "مگه همیشُ نَهَن که به اُ نُمی که حرمت ایشَه و رو شما ناهادَه بودِن، کفر اَگَن؟"
        },
        {
          "verse": 8,
          "usfm": "JAS.2.8",
          "line_type": "p",
          "text": "اگه شما حکیکتاً اُ شریعت شاهُنه ئو طِبکِ نوشته مقدّس به اَنجُم بِرَسُنین که اَگِت: «به هَمسادَت مثه خوت دوست اِتبَشِت،» کارِ خُب اَکِردِین."
        },
        {
          "verse": 9,
          "usfm": "JAS.2.9",
          "line_type": "p",
          "text": "ولی اگه دو چِشی به مردم نگاه بُکنی، گناه اَکِردِین و شریعت، به شما مقصّر اَدونه و محکومتُ اَکُنت."
        },
        {
          "verse": 10,
          "usfm": "JAS.2.10",
          "line_type": "p",
          "text": "چون هَرکَ تَمُنِ شریعتُ اَنجُم هادِه ولی توو یه مورد خطا بُکنت، اُ آدم مقصّرن به ایکه همۀ شریعتُ زیر پا ایناهادِن."
        },
        {
          "verse": 11,
          "usfm": "JAS.2.11",
          "line_type": "p",
          "text": "چون همو خدایی که ایگو: «زنا مَکُن،» همیطوَم ایگو: «کَتل مَکُن.» اگه تو زنا نکنی، ولی کَتل بُکنی، شریعتُ زیر پا اِتناهادِن."
        },
        {
          "verse": 12,
          "usfm": "JAS.2.12",
          "line_type": "p",
          "text": "پَ مثه کسونی گَپ بِزِنی و رفتار بُکنی که طِبکِ شریعتِ آزادی، به اُشُ حکم اِبو،"
        },
        {
          "verse": 13,
          "usfm": "JAS.2.13",
          "line_type": "p",
          "text": "به چه که به اُ آدمی که به هیچکَ رحم اینَکِردِن، با رحم حکم نابو. رحم بِی حکم کِردِن حریف اِبو!"
        },
        {
          "verse": 14,
          "usfm": "JAS.2.14",
          "line_type": "p",
          "text": "کاکائُن مه، چه فُیدَه ایشَه اگه کسی بِگِت ایمُن ایشَه، ولی عمل اینَبَشِت؟ مگه ایطو ایمُنی اِتون به اُ نجات هادِه؟"
        },
        {
          "verse": 15,
          "usfm": "JAS.2.15",
          "line_type": "p",
          "text": "اگه کاکا یا دادایی محتاج جِمه و جیره روزونه بَشِت"
        },
        {
          "verse": 16,
          "usfm": "JAS.2.16",
          "line_type": "p",
          "text": "و یه تا اَ شما بهشُ بِگِت: «بِرِی به سلامت، گرم و سیر بِشی،» بدون ایکه نیازوی جسمشُ بهشُ هادِه، چه فُیدَه ایشَه؟"
        },
        {
          "verse": 17,
          "usfm": "JAS.2.17",
          "line_type": "p",
          "text": "همیطوَم ایمُنِ تهنا اگه عمل اینَبَشِت، یه ایمُنِ مُرده اَن."
        },
        {
          "verse": 18,
          "usfm": "JAS.2.18",
          "line_type": "p",
          "text": "حالا یکی اَگِت: «تو ایمُن اِتهَه ئو مه هم عمل اُمهَستِن!» تو ایمُنِت، بدون عملت به مه نِشُن هادَه و مه هم ایمُنُم با عمل خو به تو نِشُن اَدَم."
        },
        {
          "verse": 19,
          "usfm": "JAS.2.19",
          "line_type": "p",
          "text": "تو ایمُن اِتهَه که خدا یکتان. خُب اَکُنی! حتی زارُ هم ایطو ایمُن شُهَه و اَ تِرس اَلَرزِن!"
        },
        {
          "verse": 20,
          "usfm": "JAS.2.20",
          "line_type": "p",
          "text": "ای نادون، تَوا بُدُنی به چه ایمُنِ بدون عمل بی فُیدَه اَن؟"
        },
        {
          "verse": 21,
          "usfm": "JAS.2.21",
          "line_type": "p",
          "text": "مگه جد ما اِبرائیم پیغُمبَر، اُ موکَع که به پُس خو اِسحاک رو جای کُربُنی تکدیم ایکه، با عمل، صالح به حساب نَهُند؟"
        },
        {
          "verse": 22,
          "usfm": "JAS.2.22",
          "line_type": "p",
          "text": "اَگینی که ایمُن واکل عملِ اُ کار شَکِه، و ایمُن با عمل اُ کامل بو."
        },
        {
          "verse": 23,
          "usfm": "JAS.2.23",
          "line_type": "p",
          "text": "و اُ نوشته ای که توو توراتِن اَنجُم بو که اَگِت: «اِبرائیم به خدا ایمُن ایوا و ایی باعث بو که اُ صالح به حساب بیاد،» و به اُ دوست خدا شُگُو."
        },
        {
          "verse": 24,
          "usfm": "JAS.2.24",
          "line_type": "p",
          "text": "اَگینین که آدم با عمل، صالح به حساب اَتا نه فَکَه با ایمُنِ تهنا."
        },
        {
          "verse": 25,
          "usfm": "JAS.2.25",
          "line_type": "p",
          "text": "همیطوَم مگه راحابِ بدکارَه نَهَستَه که با عمل، صالح به حساب هُند، اُ موکَع که به فرستادَه ئُون پناه ایدا و به اُشُ اَ یه راه دگه رَوُنه ایکه؟"
        },
        {
          "verse": 26,
          "usfm": "JAS.2.26",
          "line_type": "p",
          "text": "چون همطو که جسم بدون روح مُرده اَن، ایمُن هم بدون عمل مُرده اَن."
        }
      ],
      "verse_count": 26,
      "headings": [
        {
          "before_verse": 14,
          "text": "ایمُن بدون عمل مُرده اَن"
        }
      ],
