  "chapters": [
    {
      "schema_version": 6,
      "book_id": "PHM",
      "chapter": 1,
      "chapter_usfm": "PHM.1",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHM.1.1",
          "line_type": "p",
          "text": "اَ طَرَه پولس، که وا خاطر مسیح عیسی توو زندونِن، و کاکامُ تیموتائوس،به فیلیمون همکار عزیزمُ،"
        },
        {
          "verse": 2,
          "usfm": "PHM.1.2",
          "line_type": "p",
          "text": "به دادامُ آپْفیا و هم رزمِمُ آرخیپوس، و به کلیسایی که توو لَهَرتِن:"
        },
        {
          "verse": 3,
          "usfm": "PHM.1.3",
          "line_type": "p",
          "text": "اَ طَرَه بَپمُ خدا، و خداوندْ عیسی مسیح فیض و صُل و سلامتی وا شما بُبوت."
        },
        {
          "verse": 4,
          "usfm": "PHM.1.4",
          "line_type": "p",
          "text": "موکعی که به تو توو دعائُوم وا یاد اَتارُم، همیشه بِی خدا خو شُکر اَکُنُم،"
        },
        {
          "verse": 5,
          "usfm": "PHM.1.5",
          "line_type": "p",
          "text": "به چه که مه اَ محبت و ایمُنی که به خداوند عیسی و همۀ ایمُندارُن به مسیح، اِتهَه، اَشنُوُم."
        },
        {
          "verse": 6,
          "usfm": "PHM.1.6",
          "line_type": "p",
          "text": "دعا اَکُنُم که همباشی ایمُنِت، کمک بُکن که نسبت به هر چیز خُبی که وا خاطر مسیح در مان یه شناخت تَمُم و کمال وا دَس بیاد."
        },
        {
          "verse": 7,
          "usfm": "PHM.1.7",
          "line_type": "p",
          "text": "به چه که، ای کاکام، اَ محبتِت خیلی شاد و دلگرم بودُم، به چه که دلُوی اُشُ که به مسیح ایمُن شُهَه اَ طریق تو یه جُن تازه شُگِفتِن."
        },
        {
          "verse": 8,
          "usfm": "PHM.1.8",
          "line_type": "p",
          "text": "به هِمی خاطر، گرچه که مه ایکَک در مسیح پاهار اُمهَه، که بهت حکم بُکنُم اُنچه که لازمِنُ اَنجُم هادِی،"
        },
        {
          "verse": 9,
          "usfm": "PHM.1.9",
          "line_type": "p",
          "text": "با ایی حال وا خاطر محبت، بِهتِه اِن که ازت خواهش بُکنُم. مه، پولس، که یه پیرمردیُم و الانَم وا خاطر مسیح عیسی توو زندونُم،"
        },
        {
          "verse": 10,
          "usfm": "PHM.1.10",
          "line_type": "p",
          "text": "مه بِی چوکُم، اونِسیموس، که اُ موکَع که توو زندون ئَرُم، بَپِش بودُم، ازت خواهش اُمهَستِن."
        },
        {
          "verse": 11,
          "usfm": "PHM.1.11",
          "line_type": "p",
          "text": "اُ پِشتِه بهت نَعف اینَهَستَه، ولی الان واکعاً هم بِی تو و هم بِی مه نَعف ایشَه."
        },
        {
          "verse": 12,
          "usfm": "PHM.1.12",
          "line_type": "p",
          "text": "مه حدت بَرِش اَگَردُنُم یعنی به جِغَربندُم پهلوت اَفِرِستُم."
        },
        {
          "verse": 13,
          "usfm": "PHM.1.13",
          "line_type": "p",
          "text": "دلُم شَواستَه که به اُ حد خو نگه بُکنُم تا مدتیُ که وا خاطر انجیل توو زندونُم، به جای تو بِی مه خذمت بُکنت."
        },
        {
          "verse": 14,
          "usfm": "PHM.1.14",
          "line_type": "p",
          "text": "ولی اُمنخواست که بدون رضایتت کاری بُکنُم، تا خُبی کِردِنت نه اَ سر زور، بلکه اَ رو میل و رغبتِت بَشِت."
        },
        {
          "verse": 15,
          "usfm": "PHM.1.15",
          "line_type": "p",
          "text": "چون بلکم وا هِمی خاطرَ که اُ یه مدت ازت جدا بو تا بِی همیشه حدِت بَربِگَردِه."
        },
        {
          "verse": 16,
          "usfm": "PHM.1.16",
          "line_type": "p",
          "text": "دگه نه مثه یه غُلُم، بلکه بالاته اَ یه غُلُم، مثه یه کاکای عزیز - مخصوصاً بِی مه، ولی چِکَک بِشتِه بِی تو، هم در جسم و هم در خداوند."
        },
        {
          "verse": 17,
          "usfm": "PHM.1.17",
          "line_type": "p",
          "text": "پَ اگه به مه رفیک خو اَدونی، به اُ یه طوری کبول بُکن مِثکه به مه کبول اَکِردِی."
        },
        {
          "verse": 18,
          "usfm": "PHM.1.18",
          "line_type": "p",
          "text": "اگه در حَکت بدی ایکِردِن، یا چیزی بهت بدهکارِن، اُ رو به حساب مه بُنوس."
        },
        {
          "verse": 19,
          "usfm": "PHM.1.19",
          "line_type": "p",
          "text": "مه، پولس اییُ وا دَس خوم اَنویسُم: مه اُ رو پَسِت اَدَم، نیازی اَم نی بگم که تو حتی جُن خوتَم به مه مدیونی."
        },
        {
          "verse": 20,
          "usfm": "PHM.1.20",
          "line_type": "p",
          "text": "بله، کاکا، مَوات در خداوند یه نَعفی اَ تو بهم بِرَسه. دلُم در مسیح تازه بُکن."
        },
        {
          "verse": 21,
          "usfm": "PHM.1.21",
          "line_type": "p",
          "text": "اییُ وازت اَنویسُم چون اَ اطاعتِت، خاطر جمعُم، و اَدونُم تو حتی بِشتِه اَ اُ چیزی که مه اَگَم، اَنجُم اَدِی."
        },
        {
          "verse": 22,
          "usfm": "PHM.1.22",
          "line_type": "p",
          "text": "در ضمن، بِی مه یه مهمونخونه آماده بُکن، به چه که امید اُمهَه كه خدا دعاهوتُ کبول بُکن و وا لطف خویی، به مه حدتُ بَربِگَردُنه."
        },
        {
          "verse": 23,
          "usfm": "PHM.1.23",
          "line_type": "p",
          "text": "اِپافْراس، که وا خاطر مسیح عیسی وا مه توو زندونِن، وازت سلام اَرِسونه،"
        },
        {
          "verse": 24,
          "usfm": "PHM.1.24",
          "line_type": "p",
          "text": "و همیطوَم همکارُم مَرقُس، آریستارخوس، دیماس و لوقا، وازت سلام اَرِسونَن."
        },
        {
          "verse": 25,
          "usfm": "PHM.1.25",
          "line_type": "p",
          "text": "فیض خداوند عیسی مسیح وا روح شما بُبوت."
        }
      ],
      "verse_count": 25,
      "headings": [
        {
          "before_verse": 4,
          "text": "محبت و ایمُن فیلیمون"
        },
        {
          "before_verse": 8,
          "text": "خواسته پولس بِی اونیسیموس"
        }
      ],
