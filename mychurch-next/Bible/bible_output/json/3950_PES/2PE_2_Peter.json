    },
    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 2,
      "chapter_usfm": "2PE.2",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.2.1",
          "line_type": "p",
          "text": "ولی میون کوم یهود، نِبیُنِ دوروغکایی هم هَستَرِن، همطو که میون شما هم معلّمون دوروغکایی اَتان، که زَفتکایی تعلیموی غلطی که هلاک اَکُنت، اَتارِن، و حتی اربابیُ که اُشُ ئو ایخِری حاشا اَکُنِن، و ایطوکا هلاکت سریعی ئو وا سرخو اَتارِن."
        },
        {
          "verse": 2,
          "usfm": "2PE.2.2",
          "line_type": "p",
          "text": "خیلیُ دُمباله‌رُو هوس بازی اُشُ اَبِن و وا خاطر اُشُ به راه حکیکت کفر اَگِن."
        },
        {
          "verse": 3,
          "usfm": "2PE.2.3",
          "line_type": "p",
          "text": "اُشُ اَ رو طمع خو، وا گَپُن گول زنک شمائو چَپو اَکُنِن. محکومیت اُشُ که اَ پِشتِرُن مَعیَن بودِن، بیکار نَنِشتِن و هلاکت اُشُ نخوافتِن!"
        },
        {
          "verse": 4,
          "usfm": "2PE.2.4",
          "line_type": "p",
          "text": "چونکه اگه خدا، وختی فرشته‌ئُون گناه شُکِه بهشُ رحم اینَکِه، بلکه اُشُ رو توو سیاچال جَهَندم ایکَردی و اُشُ ئو به زنجیلوی تُریکی و ظلُمات ایسپارد، تا به روز محاکمه نگه بَشِن،"
        },
        {
          "verse": 5,
          "usfm": "2PE.2.5",
          "line_type": "p",
          "text": "و اگه اُ به دنیای کِدیم رحم اینَکِه، بلکه وختی که به دنیای بی‌دینُ توفُن ایفِرِستا، فَکَه نوحُ که کاصِد صالحی بو، وا هفت نُفر دگه حفظ ایکه؛"
        },
        {
          "verse": 6,
          "usfm": "2PE.2.6",
          "line_type": "p",
          "text": "و اگه وا خاکستر کِردِن شهروی سُدوم و عَمورَه اُشُ ئو به نابودی محکوم ایکه و اُشُ ئو درس عبرتی ایکه به عاکِبت بی‌دینی،"
        },
        {
          "verse": 7,
          "usfm": "2PE.2.7",
          "line_type": "p",
          "text": "و اگه لوطِ صالحُ، که اَ هوس بازیوی اُ آدموی شریر خیلی پریشون بودَه، آزاد ایکه"
        },
        {
          "verse": 8,
          "usfm": "2PE.2.8",
          "line_type": "p",
          "text": "به چه که اُ مَرد صالح هر رو میون اُشُ زندگی شَکِه، و جُنِ صالحش رفتاروی گناه آلودِ اُشُ ئو که شَدی و شَشنُت عذاب شَکشی،"
        },
        {
          "verse": 9,
          "usfm": "2PE.2.9",
          "line_type": "p",
          "text": "پَ خداوند اَدونه که چطو آدموی دیندار، اَ امتحانُ خلاص بُکنت و به آدمویی که صالح نَهَن تا روز داوری زیر مجازات نگه بُکنت،"
        },
        {
          "verse": 10,
          "usfm": "2PE.2.10",
          "line_type": "p",
          "text": "مخصوصنَم اُشُویی که، به خوشُ توو شهوتِ هوا هوسوی نجس کننده ول اَکُنِن و اقتدارُ کوچِک اَکُنِن.ایشُ ایکَک گستاخ و خود‌سَرَن، که وختی به موجودات پُر جلال آسَمُنی کفر اَگَن، ناتِرسَن؛"
        },
        {
          "verse": 11,
          "usfm": "2PE.2.11",
          "line_type": "p",
          "text": "با ایکه حتی فرشته‌ئُون که، زورشُ و کُدرَتشُ خیلی بِشتِرِن در محضر خداوند موکعی که حکمُ وازشُ اعلام اَکُنِن بهشُ توهین ناکُنِن."
        },
        {
          "verse": 12,
          "usfm": "2PE.2.12",
          "line_type": "p",
          "text": "ولی ایشُ، مثه حیوُنُوی بی‌شعوری‌اَن، که اَ رو غریزه رفتار اَکُنِن، که وا دنیا هُندَن تا توو تله بِکَن و نابود بُبِن، و دربارهٔ چیزُیی که ازشُ غافلن، کُفر اَگِن، پَ اُشُ توو هلاکتشُ نابود اَبِن،"
        },
        {
          "verse": 13,
          "usfm": "2PE.2.13",
          "line_type": "p",
          "text": "و به عوض بدی که شُکِردِن بدی اَگینِن، خاشیشُ عیاشی توو روز روشنِن. اُشُ لکه ئُوی ننگی اَن که وختی وا شما توو مهمونی اَن، اَ حیله ئُوی خوشُ کیف اَکُنِن."
        },
        {
          "verse": 14,
          "usfm": "2PE.2.14",
          "line_type": "p",
          "text": "چِهمُنی پُر اَ زنا شُهَه که اَ گناه کِردِن سیر نابِن. اُشُ آدمویی که سُستن توو تله اَکَردُنِن. اُشُ دلُشُ به طمع عادت ایکِردِن. ایی چوکُن نَعلت بودَه!"
        },
        {
          "verse": 15,
          "usfm": "2PE.2.15",
          "line_type": "p",
          "text": "اُشُ راه راستُ ول شُکِردِن و اَ راه به در بودِن و دُمبال راه بَلعام پُس بعور رفتِن، همو کسی که مُزد ناراستیُ دوست ایشَستَه."
        },
        {
          "verse": 16,
          "usfm": "2PE.2.16",
          "line_type": "p",
          "text": "ولی بَلعام وا خاطر خطاش توبیخ بو. یه خر بی زَبُن با صدای آدم گَپ ایزَه و گنوغی اُ پیغُمبَرُ مهار ایکه."
        },
        {
          "verse": 17,
          "usfm": "2PE.2.17",
          "line_type": "p",
          "text": "ایی معلّموی دوروغکایی، چشمه ئُوی بی هُووَن و گِراهویی اَن که با توفُن تاک و پراک اَبِن. بِی اُشُ تُریکی و ظلُمات آماده بودِن."
        },
        {
          "verse": 18,
          "usfm": "2PE.2.18",
          "line_type": "p",
          "text": "به چه که اُشُ بلند بلند گَپونی اَزَنِن که پُر اَ تکبر و نادونین، و وا هوا و هوسوی هرزۀ جسم، به اُشُویی گول اَزَنِن که تازگیُ اَ چنگ آدموی گمراه در رفتِن."
        },
        {
          "verse": 19,
          "usfm": "2PE.2.19",
          "line_type": "p",
          "text": "بهشُ وعدۀ آزادی اَدِن، ولی خوشُ غُلُم فسادَن؛ چون هر چه که حریف آدم بُبو، آدم غُلُم اُ اِبوت."
        },
        {
          "verse": 20,
          "usfm": "2PE.2.20",
          "line_type": "p",
          "text": "چون اُشُ که به واسطه شناخت خداوندمُ و نجات دهندمُ عیسی مسیح اَ نجاستوی دنیا فرار شُکِردِن، اگه دوبارَه گیر اُشُ بِکَن و شکست بُخارِن، آخِر عاکِبتشُ بدته اَ اَوِّل اِبوت."
        },
        {
          "verse": 21,
          "usfm": "2PE.2.21",
          "line_type": "p",
          "text": "به چه که بهشُ بِهتِه هَستَه که ابداً، راه صالح بودِنُ شُنَشناختَ، تا ایکه بعد اَ شناختِن، اَ اُ حکم مقدّسی که بهشُ سپرده بو، رو بَربِگَردُنِن."
        },
        {
          "verse": 22,
          "usfm": "2PE.2.22",
          "line_type": "p",
          "text": "هر چه که ایی مَثَل حکیکی اَگِت، وا سرشُ هُندِن که:«سَغ به استفراغ خو بَراَگَردِه»،و«خوک بعد اَ ایکه شوشته بو، به پِل خاردن توو گِل بَراَگَردِه.»"
        }
      ],
