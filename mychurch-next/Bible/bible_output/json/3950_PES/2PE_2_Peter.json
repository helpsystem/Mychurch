    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 3,
      "chapter_usfm": "2PE.3",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.3.1",
          "line_type": "p",
          "text": "ای عزیزُن، الان ایی نومهٔ دُوّمِن که وازتُ اَنویسُم. هر دو تا نومه ئو بِی کَصد یادآوری اُمنوشت تا شمائو به یه فکر پاک سُک بُکنُم،"
        },
        {
          "verse": 2,
          "usfm": "2PE.3.2",
          "line_type": "p",
          "text": "تا وا یاد بیاری پیشگویی ئُوی پیغُمبَرُن مقدّسُ و همیطوَم حکم خداوند و نجات دهنده ئو که توسط حَواریُتُ داده بو."
        },
        {
          "verse": 3,
          "usfm": "2PE.3.3",
          "line_type": "p",
          "text": "کَبل اَ هرچه، اییُ بُدُنین که توو روزُی آخِر، رشخندکُنکویی اَتان که دُمبال خواسته ئُوی گناه آلود خوشوئَن و همیطو که رشخند اَکُنِن"
        },
        {
          "verse": 4,
          "usfm": "2PE.3.4",
          "line_type": "p",
          "text": "اَگِن: «پَ کان وعده هُندِنِ اُ؟ به چه که اَ زَمُنی که جدُمُ به خُوو مرگ رفتِن، همه چی همطوِن که اَ شروع خلکت هَستَه.»"
        },
        {
          "verse": 5,
          "usfm": "2PE.3.5",
          "line_type": "p",
          "text": "به چه که اُشُ عمداً ایی حکیکتُ نادیده اَگیرِن، که آسَمُنُ اَ خیلی پِشتِه بودِن، و زمین اَ هُوو و بوسیله هُوو شکل ایگِه، توسط کَلُم خدا،"
        },
        {
          "verse": 6,
          "usfm": "2PE.3.6",
          "line_type": "p",
          "text": "و بوسیله همی هُوو، اُ دنیایی که اُ زَمُن هَستَه، توو هُوو غَرک بو و اَ بین رَه."
        },
        {
          "verse": 7,
          "usfm": "2PE.3.7",
          "line_type": "p",
          "text": "ولی وا همو کَلُم، آسَمُنُ و زمینی که الان هَن، بی آتِش هَمبار اَبِن، و تا روز داوری و هلاکتِ بی‌دینُ، نگه اَبِن."
        },
        {
          "verse": 8,
          "usfm": "2PE.3.8",
          "line_type": "p",
          "text": "ولی عزیزُن، چِهم رو ایی حکیکت مَبَندی، که حد خداوند یه روز مثه هزار سالِن و هزار سال مثه یه روز."
        },
        {
          "verse": 9,
          "usfm": "2PE.3.9",
          "line_type": "p",
          "text": "بر خلاف گَمون یه عده، خداوند توو اَنجُم وعده اَش دیر ناکُنت، بلکه نسبت به شما صبورِن، و ایناوا که کسی هلاک بَشِت، بلکه شَوات همه توبه بُکنِن."
        },
        {
          "verse": 10,
          "usfm": "2PE.3.10",
          "line_type": "p",
          "text": "ولی روز برگشتِن خداوند عیسی مثه دُز اَتات و اُغایه آسَمُنُ وا غُرِش سِهمِناکی اَ بین اَرِن و اجسام آسَمُنی آتِش اَگیرِن و اَ همدگه اَپاشِن، و زمین و کارویی که روش اَنجُم بودِن، نَمایُن اِبو."
        },
        {
          "verse": 11,
          "usfm": "2PE.3.11",
          "line_type": "p",
          "text": "حالا که همۀ ایی چیزُ ایطوکا اَ هم اَپاشِن، شما چطو مردمی بایه بَشین؟ شما بایه یه زندگی مقدّس و دینداری تُبَشِت،"
        },
        {
          "verse": 12,
          "usfm": "2PE.3.12",
          "line_type": "p",
          "text": "و چِش وا راهِ هُندِن روز خدا بَشین و طوری زندگی بُکنین که اُ روز زودتِه بِرَسه، اُ روز باعث اِبو که آسَمُن‌ُ آتِش بِگِرِن و بپاشن و اجسام آسَمُنی همیطو که اَسوختن، ذوب بَشِن."
        },
        {
          "verse": 13,
          "usfm": "2PE.3.13",
          "line_type": "p",
          "text": "ولی ما طِبکِ وعده اُ، منتظر آسَمُنُوی جدید و یه زمین جدیدیم که هر چیزی که توو چِهم خدا درستِن، توو اُشُ جاگیرِن."
        },
        {
          "verse": 14,
          "usfm": "2PE.3.14",
          "line_type": "p",
          "text": "پَ ای عزیزُن، حالا که چِش وا راه ایی چیزُیین، خیلی سعی بُکنین که توو محضر اُ بی لکه و بی عیب و توو صُل و سلامتی بَشین."
        },
        {
          "verse": 15,
          "usfm": "2PE.3.15",
          "line_type": "p",
          "text": "و صبر خداوندمُ رو نجات وا حساب بیاری، همطو که کاکا عزیزمُ پولس هم، طِبکِ حکمتی که به اُ داده بودِن وازتُ اینِوشت."
        },
        {
          "verse": 16,
          "usfm": "2PE.3.16",
          "line_type": "p",
          "text": "اُ توو تَمُن نومه ئُوش هروَه که اَ ایی چیزُ گَپ اَزَنت، ایطو اَنویسه. چیزُئویی توو نومه ئُوش هَه، که فهمیدنی سختِن، که آدموی نادون و سُست، تحریفشُ اَکُنِن، همطو که با نوشته ئُوی مقدّس دگه هم اَنجُم اَدِن و ایی باعث هلاکتشُ اِبوت."
        },
        {
          "verse": 17,
          "usfm": "2PE.3.17",
          "line_type": "p",
          "text": "پَ شما ای عزیزُن، حالا که ایی چیزُئو اَ جلوته اَدونین واسار بُبین که وا خطای مردمِ شریر اَ راه به در نَبِشین و پایداریتُ اَ دَس نَدِین."
        },
        {
          "verse": 18,
          "usfm": "2PE.3.18",
          "line_type": "p",
          "text": "بلکه توو فیض و شناختِ خداوندمُ و نجات دهندمُ عیسی مسیح رشد بُکنی. بِی اُ اَ الان تا ابدالآباد جلال بُبوت. آمین."
        }
      ],
