  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 1,
      "chapter_usfm": "2PE.1",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.1.1",
          "line_type": "p",
          "text": "اَ طَرَه شَمعونِ پطرس، غُلُم و حَواری عیسی مسیح،به اُشُویی که بوسیله درستی خدامُ و نجات‌دهندمُ عیسی مسیح، ایمُنی مثه ایمُن ما وا دَس شُواردِن:"
        },
        {
          "verse": 2,
          "usfm": "2PE.1.2",
          "line_type": "p",
          "text": "به واسطه شناخت خدا و خداوندمُ عیسی، فیضُ و صُل و سلامتی، فَرایُن وا شما بُبوت."
        },
        {
          "verse": 3,
          "usfm": "2PE.1.3",
          "line_type": "p",
          "text": "کُدرَت الهیِ اُ، همهٔ چیزُیی که بِی زندگی و دینداری لازمِن، به ما ایدادِن. ایی اَ طریق شناختِ اُن که مائو به جلال و فضیلت خوش دعوت ایکه."
        },
        {
          "verse": 4,
          "usfm": "2PE.1.4",
          "line_type": "p",
          "text": "که بوسیله ایشُ وعده ئُوی کیمتی و خیلی گَپ خو، به ما ایدادِن، تا اَ طریق اُشُ همباش طبیعت الهی بَشین و اَ اُ فسادی که توو دنیا وا خاطر میل به گناهِن، در بِرِین."
        },
        {
          "verse": 5,
          "usfm": "2PE.1.5",
          "line_type": "p",
          "text": "به هِمی خاطر شما تَمُن سعی خو بُکنی که به ایمُنِتُ خُبی اضافه بُکنی و به خُبی شناختُ،"
        },
        {
          "verse": 6,
          "usfm": "2PE.1.6",
          "line_type": "p",
          "text": "و به شناخت خودداریُ، و به خودداری پایداریُ، و به پایداری دینداریُ،"
        },
        {
          "verse": 7,
          "usfm": "2PE.1.7",
          "line_type": "p",
          "text": "و به دینداری، محبت برادرانه، و به محبت برادرانه، دوست داشتِن."
        },
        {
          "verse": 8,
          "usfm": "2PE.1.8",
          "line_type": "p",
          "text": "چونکه اگه ایی خصلتُ در شما بَشِت و بِشتِه هم بُبوت، ناوالِن شما توو شناخت خداوندمُ عیسی مسیح، بی‌اثر یا بی‌ثمر بَشین."
        },
        {
          "verse": 9,
          "usfm": "2PE.1.9",
          "line_type": "p",
          "text": "به چه که هَرکَ ایی خصلتُ ئو اینِبو، ایکَک کورِن که اَ نوک دماغ خو اُ راه‌تِه ئو ناگینه، و اَ یاد ایبُردِن، که اَ گناهوی کَبلَنی پاک بودِن."
        },
        {
          "verse": 10,
          "usfm": "2PE.1.10",
          "line_type": "p",
          "text": "پَ ای کاکائُن، هرچه بِشتِه سعی بُکنی تا دعوتتُ و گُزین بودِنتُ ثابت بُکنی، به چه که اگه ایی خصلتُ ئو بکار بُبِری ابداً ناکِی."
        },
        {
          "verse": 11,
          "usfm": "2PE.1.11",
          "line_type": "p",
          "text": "و ایطوکا، تَمُم و کمال به شما اجازه داده اِبوت تا به پادشاهی ابدی خداوندمُ و نجات دهندمُ عیسی مسیح داخل بُبی."
        },
        {
          "verse": 12,
          "usfm": "2PE.1.12",
          "line_type": "p",
          "text": "پَ مه مَوات که همیشه ایی خصلتُ ئو وا یادتُ بیارُم، با ایکه اُشُ رو اَدونین و توو حکیکتی که تُهَه پا برجایین."
        },
        {
          "verse": 13,
          "usfm": "2PE.1.13",
          "line_type": "p",
          "text": "مه گَمون اَکُنُم ایی درستِن که، تا زَمُنی که توو ایی بدنُم، وا یاد آوری ایی خصلتُ شمائو سُک بُکنُم،"
        },
        {
          "verse": 14,
          "usfm": "2PE.1.14",
          "line_type": "p",
          "text": "به چه که اَدونُم به همی زودیُ ایی بدنُ اَنوسُم و اَرَم، همطو که خداوندمُ عیسی مسیح به مه روشن ایکه."
        },
        {
          "verse": 15,
          "usfm": "2PE.1.15",
          "line_type": "p",
          "text": "و مه تَمُن سعی خو اَکُنُم، تا بعد اَ رفتِنُم اَ ایی دنیا، شما بُتونی که همه وَه ایی چیزُئو وا یاد بیاری."
        },
        {
          "verse": 16,
          "usfm": "2PE.1.16",
          "line_type": "p",
          "text": "به چه که وختی که کُدرَت و هُندِن خداوندمُ عیسی مسیحُ وازتُ اعلام مُکِه، دُمبال چیچکائُویی که وا رمالی ساخته بودَه نرفتریم، بلکه وا چِهموی خومُ عظمت اُ رو مُدیدَه."
        },
        {
          "verse": 17,
          "usfm": "2PE.1.17",
          "line_type": "p",
          "text": "به چه که اُغایه که اُ اَ طَرَه خدای بَپ حرمت و جلال ایگِه و صدایی اَ جلال عظیم بهش رِسی که، «ایین پُس عزیزُم، که ازش خیلی راضیُم.»"
        },
        {
          "verse": 18,
          "usfm": "2PE.1.18",
          "line_type": "p",
          "text": "ما خومُ همی صدائو که اَ آسَمُن رِسی، مُشنُت، به چه که ما رو اُ کوه مقدّس واکِلی هَستِریم."
        },
        {
          "verse": 19,
          "usfm": "2PE.1.19",
          "line_type": "p",
          "text": "ما کَلُم کابِل اطمینُن پیغُمبَرُنُ مُهَه که خُبِن بهش توجه بُکنی، به چه که مثه یه چراغ توو یه جای تُریک اَدِرخشه، تا اُغایه که روز بِزَنت و اِستالَه صُحب توو دلُتُ طلوع بُکنت."
        },
        {
          "verse": 20,
          "usfm": "2PE.1.20",
          "line_type": "p",
          "text": "کَبل اَ هر چیزی اییُ بُدُنی که هیچِتا اَ نبوّتوی نوشته مقدّس، تفسیر خود نبی نَن."
        },
        {
          "verse": 21,
          "usfm": "2PE.1.21",
          "line_type": "p",
          "text": "چونکه هیچ نبوّتی ابداً به خواست آدمیزاد نَهُندِن، بلکه آدمُ توسط روح قدّوس خدا، اَ طَرَه خدا گَپ شُزَه."
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 3,
          "text": "گُزین بودَئُن خدا"
        }
      ],
