    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 2,
      "chapter_usfm": "COL.2",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.2.1",
          "line_type": "p",
          "text": "به چه که مَوات بُدُنین که وا خاطر شما و وا خاطر کسونی که توو شهر لائودیکیه اَن، و وا خاطر همۀ اُشُویی که به مه رو در رو شُنِدیدِن، چِکَک سخت تقلا اَکُنُم،"
        },
        {
          "verse": 2,
          "usfm": "COL.2.2",
          "line_type": "p",
          "text": "تا دلگرم بَشِن و توو محبت، واکل همدگه بُبِن، و اَ همۀ فَرایُنیِ اُ اطمینُنِ کاملی که اَ طریق فهم وا دَس اَتات، بهره بُبَرِن، و اَ ایی راه به راز خدا یعنی مسیح پِی بُبَرِن."
        },
        {
          "verse": 3,
          "usfm": "COL.2.3",
          "line_type": "p",
          "text": "همو مسیح که همۀ گنجوی حکمت و شناخت، در اُ پِنهونِن."
        },
        {
          "verse": 4,
          "usfm": "COL.2.4",
          "line_type": "p",
          "text": "اییُ اَگَم تا کسی بِی شما وا بحثوی کانع کننده گولتُ نَزَنت."
        },
        {
          "verse": 5,
          "usfm": "COL.2.5",
          "line_type": "p",
          "text": "چون با ایکه در جسم پهلوتُ نَهُم، ولی در روح با شمام و اَ دیدن نظمتُ و ایمُنِ کایُمِتُ که در مسیح تُهَه، دلخاشُم."
        },
        {
          "verse": 6,
          "usfm": "COL.2.6",
          "line_type": "p",
          "text": "پَ همطو که خداوند مسیح عیسائو کبول تُکه، در اُ هم رفتار بُکنین:"
        },
        {
          "verse": 7,
          "usfm": "COL.2.7",
          "line_type": "p",
          "text": "در اُ ریشه بگیرین و بنا بَشین و همطو که یاد تُگِه، توو ایمُن پابرجا بُمونین و شاهِن شکرگزاری بَشین."
        },
        {
          "verse": 8,
          "usfm": "COL.2.8",
          "line_type": "p",
          "text": "واسار بُبی کسی شمائو با فلسفه و فریبِ توو خالی اسیر نَکُنت، که طِبکِ رسم آدمیزاد و طِبکِ اصول ابتدایی ایی دنیان نه طِبکِ مسیح."
        },
        {
          "verse": 9,
          "usfm": "COL.2.9",
          "line_type": "p",
          "text": "به چه که تَمُن پُری ذات الهی به صورت جسمانی در مسیح ساکنِن،"
        },
        {
          "verse": 10,
          "usfm": "COL.2.10",
          "line_type": "p",
          "text": "و شما در مسیح که سرِ تَمُنی ریاست و اقتدارِن، پُر بودِین."
        },
        {
          "verse": 11,
          "usfm": "COL.2.11",
          "line_type": "p",
          "text": "شمائَم توو اتحاد وا مسیح سُنَّت بودِین، سُنَّتی که وا دَس آدم انجُم نِبودِن. بلکه ایی، سُنَّتین توسط مسیح، که همو بریدنِ طبیعتِ نفسانین."
        },
        {
          "verse": 12,
          "usfm": "COL.2.12",
          "line_type": "p",
          "text": "با مسیح توو غسل تعمید، دفن بودِین و با اُ هم زنده بودِین، اَ طریق ایمُن به کار کُدرَتمند خدایی که به مسیح اَ مُردَئُن زنده ایکه."
        },
        {
          "verse": 13,
          "usfm": "COL.2.13",
          "line_type": "p",
          "text": "و خدا به شما که توو خطائُوتُ و توو حالت سُنَّت نبوده جسمتُ مُردِرین، با مسیح زنده ایکه، و همۀ خطائُوی مائو ایبَخشی."
        },
        {
          "verse": 14,
          "usfm": "COL.2.14",
          "line_type": "p",
          "text": "اُ سَندِ کَرض ئو که وا قانونُش به ضدّمُ نوشته بودَه و به ضدّمُ ووستادَه، باطل ایکه. اُ اییُ به صلیب میخکوب ایکه و اَ میون ایسِی."
        },
        {
          "verse": 15,
          "usfm": "COL.2.15",
          "line_type": "p",
          "text": "مسیح رو صلیب، حاکمُن و صاحب منصبُنُ خلع سلاح ایکه و بهشُ پیروز بو و اُشُ جلو چِهم همه رسوا ایکه."
        },
        {
          "verse": 16,
          "usfm": "COL.2.16",
          "line_type": "p",
          "text": "پَ مَوالی کسی دربارۀ اُنچه که اَخارین و اَنوشین، یا دربارۀ نگه کِردِن عیدُ و ماه نو و روز شنبه مقدّس محکومتُ بُکنت."
        },
        {
          "verse": 17,
          "usfm": "COL.2.17",
          "line_type": "p",
          "text": "ایشُ یه سایۀ ای اَ چیزُیین که کرارِن بیاد، ولی اصل اُشُ مالِ مسیحَن."
        },
        {
          "verse": 18,
          "usfm": "COL.2.18",
          "line_type": "p",
          "text": "مَوالی کسی که اصرار ایشَه بِی خوار کِردِن بدن و پرستش فرشته‌ئُون، شمائو محروم بُکنت. ایطو کسی به خوش وا رؤیائُوش سرگرم اَکُنت و فکر نفسانی اُ آدم الکی به اُ مغرور ایکِردِن."
        },
        {
          "verse": 19,
          "usfm": "COL.2.19",
          "line_type": "p",
          "text": "ایطو آدمی پیوند خو وا سر اَ دَس ایدادِن، سری که همۀ بدن اَ اُ تغذیه اِبوت، و به همدگه اَچسبه، اَ طریق مفصلُ و بندُش، و ایطوکا بدن، با رشدی که اَ خدا سرچشمه اَگِنت، رشد اَکُنت."
        },
        {
          "verse": 20,
          "usfm": "COL.2.20",
          "line_type": "p",
          "text": "اگه وا مسیح نسبت به اصول ابتدایی ایی دنیا مُردِین، به چه مثه کسونی که انگار هِنوزا مال ایی دنیائَن، اَ دستوروی اُ اطاعت نَکِردِین، اُ دستورویی که اَگِن:"
        },
        {
          "verse": 21,
          "usfm": "COL.2.21",
          "line_type": "p",
          "text": "«دَس مَزَن، مِزَه مَکُن، دَس مَنوس!»؟"
        },
        {
          "verse": 22,
          "usfm": "COL.2.22",
          "line_type": "p",
          "text": "ایشُ همه مربوط به چیزُیین که با مصرف کِردِن، اَ بین اَرِن، و طِبکِ حکمُ و تعلیموی آدمیَن."
        },
        {
          "verse": 23,
          "usfm": "COL.2.23",
          "line_type": "p",
          "text": "واکعنم وختی که گَپ اَ ایی مذهب مَن‌دَر‌آوردی و خوار کِردِن بدن و سخت گِفتِن بِی بدن اِبوت، ظاهراً معقول وا نظر اَتان، ولی ایی دستورُ کاری اَ دَسِشُ بر نِتا که جلو هوا و هوس جسمُ بِگِرِن."
        }
      ],
      "verse_count": 23,
      "headings": [
        {
          "before_verse": 6,
          "text": "زندگی در مسیح"
        }
      ],
