    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 4,
      "chapter_usfm": "COL.4",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.4.1",
          "line_type": "p",
          "text": "ای اربابُن، با غُلُمُن خو وا عدل و انصاف رفتار بُکنین، چون اَدونین که شمائَم یه اربابی توو آسَمُن تُهَستِن."
        },
        {
          "verse": 2,
          "usfm": "COL.4.2",
          "line_type": "p",
          "text": "توو دعا پا برجا ادامه هادِین، و توو دعا وا شُکرگزاری هُشیار بَشین."
        },
        {
          "verse": 3,
          "usfm": "COL.4.3",
          "line_type": "p",
          "text": "در عین حال، بِی ما هم دعا بُکنین که خدا یه دری بِی کَلُم جلو رومو واز بُکن تا راز مسیحُ اعلام بُکنیم، همو رازی که وا خاطری توو زندونُم."
        },
        {
          "verse": 4,
          "usfm": "COL.4.4",
          "line_type": "p",
          "text": "دعا بُکنین تا همطو که لازمِن، اُ رو روشن بگم."
        },
        {
          "verse": 5,
          "usfm": "COL.4.5",
          "line_type": "p",
          "text": "وا آدموی بی‌ایمُن وا حکمت رفتار بُکنین، و اَ وخت خُب استفاده بُکنین."
        },
        {
          "verse": 6,
          "usfm": "COL.4.6",
          "line_type": "p",
          "text": "بُوالی گَپُن شما همیشه پُر اَ فیض و سنجیده بَشِت، تا بُدُنین که چطو بایه جواب هَرکَ ئو هادِین."
        },
        {
          "verse": 7,
          "usfm": "COL.4.7",
          "line_type": "p",
          "text": "تیخیکوس شمائو کاملاً اَ احوال مه وا خبر اَکُنت. اُ یه کاکای عزیز و خادم وفادار و همخذمت مه در خداوندِن."
        },
        {
          "verse": 8,
          "usfm": "COL.4.8",
          "line_type": "p",
          "text": "مه بِی هِمی کَصد به اُ حد شما اُمفِرِستادِن تا اَ احوال ما واخبر بَشین، و تا دلُتُ تشویق بُکنت."
        },
        {
          "verse": 9,
          "usfm": "COL.4.9",
          "line_type": "p",
          "text": "واکلش اونِسیموس، کاکای وفادار و عزیزمُ که یکی اَ شمان، حدتُ اَتات. اُشُ اَ هرچه که ایجا اِتفاک کَفتِن وازتُ نَکل اَکُنِن."
        },
        {
          "verse": 10,
          "usfm": "COL.4.10",
          "line_type": "p",
          "text": "آریستارخوس که وا مه توو زندونِن و همیطوَم مَرقُس پُس عاموی برنابا وازتُ سلام اَرِسونِن، پِشتِه دربارۀ مَرقُس سفارش اُمکِردِن که اگه پهلوتُ هُند وا روی خاش کبولی بُکنین."
        },
        {
          "verse": 11,
          "usfm": "COL.4.11",
          "line_type": "p",
          "text": "عیسی که یوستوس شَگن، وازتُ سلام اَرِسونه، میون همکارُم توو کار پادشاهی خدا، فَکَه ایی چَن نُفرَن که سُنَّت بودَه یعنی یهودی اَن، و ایشُ دلگرمی مه بودِن."
        },
        {
          "verse": 12,
          "usfm": "COL.4.12",
          "line_type": "p",
          "text": "اِپافْراس که یکی اَ شما و نوکر مسیح عیسان، وازتُ سلام اَرِسونه. اُ همیشه توو دعائُوش بِی شما تقلا اَکُنت، تا شما مثه آدموی بالغ و کاملاً خاطرجمع پا برجا بُمونین و اراده خدائو کامل به جا بیارین."
        },
        {
          "verse": 13,
          "usfm": "COL.4.13",
          "line_type": "p",
          "text": "چون مه شاهدُم که اُ بِی شما و بِی اُشُویی که توو شهروی لائودیکیه و هیراپولیسَن، چِکَک سخت زحمت ایکِشیدِن."
        },
        {
          "verse": 14,
          "usfm": "COL.4.14",
          "line_type": "p",
          "text": "لوقا دکتر عزیز و همیطوَم دیماس به شما سلام اَرِسونِن."
        },
        {
          "verse": 15,
          "usfm": "COL.4.15",
          "line_type": "p",
          "text": "به کاکائُن توو لائودیکیه و همیطوَم به نیمفا و کلیسایی که توو لَهَر ایی دادان، سلام مِئو بِرَسُنین."
        },
        {
          "verse": 16,
          "usfm": "COL.4.16",
          "line_type": "p",
          "text": "بعد اَ ایکه ایی نومه میونتُ خونده بو، یه کاری بُکنین که توو کلیسای لائودیکیه هم خونده بَشِت؛ حواستُ بُبو که شمائَم نومه ای که به کلیسای لائودیکیه اُمنوشت، بُخونی."
        },
        {
          "verse": 17,
          "usfm": "COL.4.17",
          "line_type": "p",
          "text": "به آرخیپوس بِگِی: «واسار بَش تا خذمتیُ که در خداوند بهت داده بودِن، وا اَنجُم بِرَسُنی.»"
        },
        {
          "verse": 18,
          "usfm": "COL.4.18",
          "line_type": "p",
          "text": "مه، پولس، ایی سلامُ وا دَس خوم اَنویسُم. زنجیلوی مه ئو توو ایی زندون وا یاد بیاری. فیض خدا وا شما بُبوت."
        }
      ],
