    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 3,
      "chapter_usfm": "COL.3",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.3.1",
          "line_type": "p",
          "text": "پَ اگه شما وا مسیح زنده بودِین، دُمبال اُ چیزُیی بَشین که بالان، همو جا که مسیحِن، و وا دَس راست خدا نِشتِن."
        },
        {
          "verse": 2,
          "usfm": "COL.3.2",
          "line_type": "p",
          "text": "فکرُتُ بُنوسی رو اُ چیزُیی که بالان، نه اُ چیزُیی که رو زمینِن."
        },
        {
          "verse": 3,
          "usfm": "COL.3.3",
          "line_type": "p",
          "text": "چون شما مُردِین و زندگی شما وا مسیح در خدا پِنهونِن."
        },
        {
          "verse": 4,
          "usfm": "COL.3.4",
          "line_type": "p",
          "text": "وختی مسیح که زندگی شمان نَمایُن بُبوت، اُغایه شمام وا اُ توو جلال نَمایُن اِبین."
        },
        {
          "verse": 5,
          "usfm": "COL.3.5",
          "line_type": "p",
          "text": "پَ اُنچه که در شما زمینین، بُکُشین، یعنی بی‌عفتی، ناپاکی، هوا و هوس، خواسته بد و طمع که همو بُت‌پرستین."
        },
        {
          "verse": 6,
          "usfm": "COL.3.6",
          "line_type": "p",
          "text": "وا خاطر ایی چیزُن که خشم خدا وا سر چوکُن نااطاعتی اَتات."
        },
        {
          "verse": 7,
          "usfm": "COL.3.7",
          "line_type": "p",
          "text": "شمام یه زَمُنی توو ایی چیزُ رفتار تاکه، اُغایه که توو اُشُ زندگی تاکه."
        },
        {
          "verse": 8,
          "usfm": "COL.3.8",
          "line_type": "p",
          "text": "ولی الان شما بایه همۀ ایشُ رو بُنوسی کنار: یعنی جَهل، خشم، بدتالی، تهمت و گَپُن زشتُ اَ دَهنِتُ."
        },
        {
          "verse": 9,
          "usfm": "COL.3.9",
          "line_type": "p",
          "text": "به همدگَه دورو مَگِی، به چه که اُ انسانیّت کُنَه با کاروش اَ گَرِخو در تُواردِن."
        },
        {
          "verse": 10,
          "usfm": "COL.3.10",
          "line_type": "p",
          "text": "و اُ انسانیّت جدیدیُ گَرِخو تُکِردِن که توو شناخت حکیکی تازه اِبودِن، تا به شکل و شمایل خالکش در بیاد."
        },
        {
          "verse": 11,
          "usfm": "COL.3.11",
          "line_type": "p",
          "text": "توو ایی انسانیّت جدید، نه یونانی و نه یهودی، نه سُنَّت بودَه و نه سُنَّت نبوده، نه بربر و نه سَکایی، نه غُلُم و نه آزاد، دگه معنی اینین، بلکه مسیح همِی چیزِن و در همه هَمَن."
        },
        {
          "verse": 12,
          "usfm": "COL.3.12",
          "line_type": "p",
          "text": "پَ مثه برگزیدئُن خدا که مقدّس و عزیزَن، دلسوزی، مهربُنی، فروتنی، افتادگی، و صبوریُ گَرِخو بُکنی."
        },
        {
          "verse": 13,
          "usfm": "COL.3.13",
          "line_type": "p",
          "text": "بِی همدگه تحمل بُکنی و اگه یه تِیتُ اَ یه تِی دگه شکایت ایشَه، همدگه ئو بُبَخشی. همطو که خداوند بِی شما ایبَخشیدِن، شما هم بایه بِی همدگَه بُبَخشی."
        },
        {
          "verse": 14,
          "usfm": "COL.3.14",
          "line_type": "p",
          "text": "و رو همۀ ایشُ محبتُ گَرِخو بُکنی، که همِی چیُ توو یه اتحاد تَمُم و کمال وا هم، پیوند اَدِت."
        },
        {
          "verse": 15,
          "usfm": "COL.3.15",
          "line_type": "p",
          "text": "بُوالی صُل و سلامتی مسیح توو دلُتُ حاکم بَشِت، که واکعاً توو یَک بدن به اُ دعوت بودین. و شکرگزار بَشین."
        },
        {
          "verse": 16,
          "usfm": "COL.3.16",
          "line_type": "p",
          "text": "بُوالی کَلُم مسیح به فَرایُنی در شما ساکن بَشِت، وا تَمُنی حکمت، به همدگه تعلیم هادِی و نصیحت بُکنی؛ مزمورُ، سرودُ و شَروِندوی روحانی بُخونین، با اُ شُکرگزاری که توو دلُتُ به خدا تُهَه."
        },
        {
          "verse": 17,
          "usfm": "COL.3.17",
          "line_type": "p",
          "text": "هر کاری اَکُنین، توو گفتار یا توو رفتار، همِی چیُ به نُم خداوندْ عیسی اَنجُم هادِین، و اَ طریق اُ خدای بَپُ شُکر بُکنین."
        },
        {
          "verse": 18,
          "usfm": "COL.3.18",
          "line_type": "p",
          "text": "ای زنُن، مطیع شوئُو خو بَشین همطو که در خداوند شایسته اَن."
        },
        {
          "verse": 19,
          "usfm": "COL.3.19",
          "line_type": "p",
          "text": "ای شوئُو، بِی زنُ خو دوست تُبَشِت و با اُشُ تُندی مَکُنی."
        },
        {
          "verse": 20,
          "usfm": "COL.3.20",
          "line_type": "p",
          "text": "ای چوکُن، توو همِی چی اَ مُم و بَپ خو اطاعت بُکنی، چون ایی خداوندُ خشنود اَکُنت."
        },
        {
          "verse": 21,
          "usfm": "COL.3.21",
          "line_type": "p",
          "text": "ای بَپُن، به چوکُتُ جَهلی مَکُنی، نَکه دلسرد بَشِن."
        },
        {
          "verse": 22,
          "usfm": "COL.3.22",
          "line_type": "p",
          "text": "ای غُلُمُن، توو همِی چی اَ کسونی که اربابُنِ زمینی توئَن اطاعت بُکنی، نه فَکَه وختی که جلو چِهمِشوئین مثه اُشُویی که دُمبال راضی کِردِن مَردُمَن، بلکه وا خلوص نیّت و وا تِرس اَ خداوند."
        },
        {
          "verse": 23,
          "usfm": "COL.3.23",
          "line_type": "p",
          "text": "هر کاری که اَنجُم اَدِین وا جُن و دل اَنجُم هادِین طوری که انگار بِی خداوند اَکُنین، نه بِی آدمُ،"
        },
        {
          "verse": 24,
          "usfm": "COL.3.24",
          "line_type": "p",
          "text": "به چه که اَدونین که اَ خداوند بِی اجرتُ، میراث اَگیرین. شما خداوند مسیحُ خذمت اَکِردِین."
        },
        {
          "verse": 25,
          "usfm": "COL.3.25",
          "line_type": "p",
          "text": "چون آدمی که بدی اَکُنت، عوض کار بدِ خو اَگِنت، دو چِشی در کار نین."
        }
      ],
      "verse_count": 25,
      "headings": [
        {
          "before_verse": 18,
          "text": "قانونی بِی خانواده ئُوی مسیحی"
        }
      ],
