  "chapters": [
    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 1,
      "chapter_usfm": "COL.1",
      "version_id": 3950,
      "version_abbr": "PES",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.1.1",
          "line_type": "p",
          "text": "اَ طَرَه پولس که به خواست خدا، یه حَواری مسیح عیسان، و اَ طَرَه کاکامُ، تیموتائوس،"
        },
        {
          "verse": 2,
          "usfm": "COL.1.2",
          "line_type": "p",
          "text": "بِی مقدّسُن و کاکائُن وفادار در مسیح که توو شهر کولُسی اَن:فیض و صُل و سلامتی اَ طَرَه بَپمُ خدا، وا شما بُبوت."
        },
        {
          "verse": 3,
          "usfm": "COL.1.3",
          "line_type": "p",
          "text": "ما وختی که بِی شما دعا اَکُنیم، همیشه خدا بَپِ خداوندمُ عیسی مسیح شُکر اَکُنیم،"
        },
        {
          "verse": 4,
          "usfm": "COL.1.4",
          "line_type": "p",
          "text": "به چه که ما اَ ایمُنِتُ به مسیح عیسی و اَ محبتی که به همۀ ایمُندارُنِ به مسیح تُهَه مُشنُت."
        },
        {
          "verse": 5,
          "usfm": "COL.1.5",
          "line_type": "p",
          "text": "ایشُ، اَ اُ امیدی سرچشمه اَگِنت که توو آسَمُن وازتُ ناهادَه بودِن. پِشتِه دربارۀ ایی امید، توو کَلُم حکیکت یعنی انجیل تُشنُتِن،"
        },
        {
          "verse": 6,
          "usfm": "COL.1.6",
          "line_type": "p",
          "text": "همو انجیلی که به شما رسیدِن، همطو که واکعاً توو همۀ دنیا ثمر اَدِت و زیاد اِبوت، طوری که میونتُ اَم اَ اُ روزی که اُ رو تُشنُت و فیض خدا ئو توو حکیکت تُفَهمی، کار اَکُنت."
        },
        {
          "verse": 7,
          "usfm": "COL.1.7",
          "line_type": "p",
          "text": "همطو که شما اُ رو اَ اِپافْراس همخذمت عزیزمُ یاد تُگِه، اُ اَ طَرَه شما یه خادم وفادارِ مسیحِن،"
        },
        {
          "verse": 8,
          "usfm": "COL.1.8",
          "line_type": "p",
          "text": "و اُ ما ئو اَ محبت شما که در روح خدان، وا خبر ایکه."
        },
        {
          "verse": 9,
          "usfm": "COL.1.9",
          "line_type": "p",
          "text": "بِی هِمی خاطر، ما هم اَ روزی که اییُ مُشنُت، اَ دعا کِردِن بِی شما دَس مُنَکِشیدِن، بلکه اَ خدا ماوات که شما اَ شناخت ارادۀ اُ، توو هر حکمت و فهم روحانی، پُر بَشین،"
        },
        {
          "verse": 10,
          "usfm": "COL.1.10",
          "line_type": "p",
          "text": "تا طوری رفتار بُکنی که شایسته خداوند بَشِت، و به اُ تَمُم و کمال خشنود بُکنی، یعنی توو هر کار خُب ثمر بیاری و توو شناخت خدا رشد بُکنی."
        },
        {
          "verse": 11,
          "usfm": "COL.1.11",
          "line_type": "p",
          "text": "وا تَمُن کُوّتی که طِبکِ کُدرَتِ پُر جلال اُن، کِوی بَشین تا وا شادی، پایداری و صبر کامل تُبَشِت،"
        },
        {
          "verse": 12,
          "usfm": "COL.1.12",
          "line_type": "p",
          "text": "و بَپ آسَمُنیُ شُکر بُکنی که شمائو لایِک ایکِردِن تا توو میراثی که ایمُندارُن بِی مسیح در نور شُهَه، همباش بَشین."
        },
        {
          "verse": 13,
          "usfm": "COL.1.13",
          "line_type": "p",
          "text": "اُ بِی ما اَ حمکرانی تُریکی آزاد ایکِردِن و به پادشاهی پُس عزیز خو منتقل ایکِردِن،"
        },
        {
          "verse": 14,
          "usfm": "COL.1.14",
          "line_type": "p",
          "text": "که در اُ ما آزادی مُهَه یعنی بخشش گناهُمُ."
        },
        {
          "verse": 15,
          "usfm": "COL.1.15",
          "line_type": "p",
          "text": "مسیح شکل و شمایل خدایین که نابو بیگینی، چوک اَوِّل جلوته و بالاته اَ تَمُنی خلکت،"
        },
        {
          "verse": 16,
          "usfm": "COL.1.16",
          "line_type": "p",
          "text": "چون همِی چی به واسطه اُ خَلک بو، توو آسَمُن و رو زمین، هرچه که اِبو بیگینی و هرچه که نابو بیگینی، چه تختوی پادشاهی، چه حکمرانیُ، چه حاکمُن یا صاحب منصبُ، همِی چی توسط اُ و بِی اُ خَلک بو."
        },
        {
          "verse": 17,
          "usfm": "COL.1.17",
          "line_type": "p",
          "text": "اُ کَبل اَ همِی چی هَه، و در اُ همِی چی کنار هم نگه اَبِن."
        },
        {
          "verse": 18,
          "usfm": "COL.1.18",
          "line_type": "p",
          "text": "اُ بِی بدن یعنی کلیسا سَرِن. اُ شُروعِن، چوک اَوِّل اَ میون مُردَئُن، تا توو همِی چی، اُ سر بَشِت."
        },
        {
          "verse": 19,
          "usfm": "COL.1.19",
          "line_type": "p",
          "text": "بِی چه که تَمُنی پُری خدا خشنودَ که در اُ ساکن بَشِت،"
        },
        {
          "verse": 20,
          "usfm": "COL.1.20",
          "line_type": "p",
          "text": "و به واسطۀ مسیح همِی چیُ وا خوش صُل هادِه، چه رو زمین و چه توو آسَمُن، به وسیله صُلی که وا رِختَه بودِن خون اُ رو صلیب بوجود ایوا."
        },
        {
          "verse": 21,
          "usfm": "COL.1.21",
          "line_type": "p",
          "text": "شما که یه زَمُنی وا خدا غریبه ئَرین، و توو فکرتُ وا اُ دشمن ئَرین، و کاروی بد اَنجُم تادا،"
        },
        {
          "verse": 22,
          "usfm": "COL.1.22",
          "line_type": "p",
          "text": "الان مسیح به وسیله مرگش توو بدن جسمانی خو، بِی شما صُل ایدادِن، تا به شما مقدّس و بی‌عیب، و بدون ایکه کسی سرکوفتتُ بِزَنت، به محضر خدا بیارِت،"
        },
        {
          "verse": 23,
          "usfm": "COL.1.23",
          "line_type": "p",
          "text": "اگه واکعاً توو ایمُن کایُم و پابرجا بُمونین، و اَ امیدِ اُ انجیلی که تُشنُت، تکون نخاری، انجیلی که به تَمُن خلکت زیر آسَمُن اعلام بودِن و مه، پولس، خادم اُ بودُم."
        },
        {
          "verse": 24,
          "usfm": "COL.1.24",
          "line_type": "p",
          "text": "الان اَ زجرویی که وا خاطر شما اَکشُم شادُم و هر کم و کسریِ اُ مصیبتویُ که مسیح وا خاطر بدنِش یعنی کلیسا ایکِشی، توو جسم خو کامل اَکُنُم."
        },
        {
          "verse": 25,
          "usfm": "COL.1.25",
          "line_type": "p",
          "text": "مه طِبکِ خذمت نظارتی که خدا بِی خیریَتِتُ بهم ایدا، خادم کلیسا بودُم تا کَلُم خدائو تَمُم و کمال بِشناسُنُم،"
        },
        {
          "verse": 26,
          "usfm": "COL.1.26",
          "line_type": "p",
          "text": "یعنی اُ رازیُ که توو طول دوران و نسلوی زیادی زَفتَ، ولی الان به مقدّسُن اُ نَمایُن بو،"
        },
        {
          "verse": 27,
          "usfm": "COL.1.27",
          "line_type": "p",
          "text": "خدا ایطو اراده ایکه که بِی اُشُ نَمایُن بُکنت که ایی راز میون غیر یهودیُن چه جلال گپی ایشَه، همو رازی که مسیح در شمان، امید جلالِن."
        },
        {
          "verse": 28,
          "usfm": "COL.1.28",
          "line_type": "p",
          "text": "ما مسیحُ اعلام اَکُنیم، و بِی همه هشدار اَدِیم و به همه با تَمُن حکمت تعلیم اَدِیم، تا در مسیح همه ئو بالغ بِی محضر خدا بیاریم."
        },
        {
          "verse": 29,
          "usfm": "COL.1.29",
          "line_type": "p",
          "text": "به هِمی خاطرِن که مه زحمت اَکشُم و با تَمُن کُوّت اُ، که وا کُدرَت در مه کار اَکُنت، تقلا اَکُنُم."
        }
      ],
      "verse_count": 29,
      "headings": [
        {
          "before_verse": 3,
          "text": "شُکر کِردِن و دعا"
        },
        {
