    {
      "schema_version": 6,
      "book_id": "MAL",
      "chapter": 4,
      "chapter_usfm": "MAL.4",
      "version_id": 3034,
      "version_abbr": "BSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "MAL.4.1",
          "line_type": "p",
          "text": "“For behold, the day is coming, burning like a furnace, when all the arrogant and every evildoer will be stubble; the day is coming when I will set them ablaze,” says the Lord"
        },
        {
          "verse": 2,
          "usfm": "MAL.4.2",
          "line_type": "p",
          "text": "“But for you who fear My name, the sun of righteousness will rise with healing in its wings, and you will go out and leap like calves from the stall."
        },
        {
          "verse": 3,
          "usfm": "MAL.4.3",
          "line_type": "p",
          "text": "Then you will trample the wicked, for they will be ashes under the soles of your feet on the day I am preparing,” says the Lord"
        },
        {
          "verse": 4,
          "usfm": "MAL.4.4",
          "line_type": "p",
          "text": "“Remember the law of My servant Moses, the statutes and ordinances I commanded him for all Israel at Horeb."
        },
        {
          "verse": 5,
          "usfm": "MAL.4.5",
          "line_type": "p",
          "text": "Behold, I will send you Elijah the prophet before the coming of the great and awesome Day of the Lord"
        },
        {
          "verse": 6,
          "usfm": "MAL.4.6",
          "line_type": "p",
          "text": "And he will turn the hearts of the fathers to their children, and the hearts of the children to their fathers. Otherwise, I will come and strike the land with a curse.”"
        }
      ],
      "verse_count": 6,
      "headings": [],
      "footnotes": [
        {
          "verse": 2,
          "usfm": "MAL.4.2",
          "note_ref": "4:2",
          "note_type": "footnote",
          "references": [],
          "text": "Or the Sun of Righteousness will rise with healing in His wings"
        },
        {
          "verse": 4,
          "usfm": "MAL.4.4",
          "note_ref": "4:4",
          "note_type": "footnote",
          "references": [],
          "text": "That is, Mount Sinai, or possibly a mountain in the range containing Mount Sinai"
        },
        {
          "verse": 5,
          "usfm": "MAL.4.5",
          "note_ref": "4:5",
          "note_type": "footnote",
          "references": [],
          "text": "Or dreadful; LXX glorious"
        },
        {
          "verse": 6,
          "usfm": "MAL.4.6",
          "note_ref": "4:6",
          "note_type": "footnote",
          "references": [],
          "text": "Cited in Luke 1:17"
        }
      ],
