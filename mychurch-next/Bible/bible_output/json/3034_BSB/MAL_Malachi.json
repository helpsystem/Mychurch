  "chapters": [
    {
      "schema_version": 6,
      "book_id": "MAL",
      "chapter": 1,
      "chapter_usfm": "MAL.1",
      "version_id": 3034,
      "version_abbr": "BSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "MAL.1.1",
          "line_type": "p",
          "text": "This is the burden of the word of the Lord"
        },
        {
          "verse": 2,
          "usfm": "MAL.1.2",
          "line_type": "p",
          "text": "“I have loved you,” says the LordBut you ask, “How have You loved us?”“Was not Esau Jacob’s brother?” declares the Lord"
        },
        {
          "verse": 3,
          "usfm": "MAL.1.3",
          "line_type": "p",
          "text": "but Esau I have hated, and I have made his mountains a wasteland and left his inheritance to the desert jackals.”"
        },
        {
          "verse": 4,
          "usfm": "MAL.1.4",
          "line_type": "p",
          "text": "Though Edom may say, “We have been devastated, but we will rebuild the ruins,” this is what the Lord"
        },
        {
          "verse": 5,
          "usfm": "MAL.1.5",
          "line_type": "p",
          "text": "You will see this with your own eyes, and you yourselves will say, ‘The Lord"
        },
        {
          "verse": 6,
          "usfm": "MAL.1.6",
          "line_type": "p",
          "text": "“A son honors his father, and a servant his master. But if I am a father, where is My honor? And if I am a master, where is your fear of Me?” says the Lord“But you ask, ‘How have we despised Your name?’"
        },
        {
          "verse": 7,
          "usfm": "MAL.1.7",
          "line_type": "p",
          "text": "By presenting defiled food on My altar.But you ask, ‘How have we defiled You?’By saying that the table of the Lord"
        },
        {
          "verse": 8,
          "usfm": "MAL.1.8",
          "line_type": "p",
          "text": "When you offer blind animals for sacrifice, is it not wrong? And when you present the lame and sick ones, is it not wrong? Try offering them to your governor! Would he be pleased with you or show you favor?” asks the Lord"
        },
        {
          "verse": 9,
          "usfm": "MAL.1.9",
          "line_type": "p",
          "text": "“But ask now for God’s favor. Will He be gracious? Since this has come from your hands, will He show you favor?” asks the Lord"
        },
        {
          "verse": 10,
          "usfm": "MAL.1.10",
          "line_type": "p",
          "text": "“Oh, that one of you would shut the temple doors, so that you would no longer kindle useless fires on My altar! I take no pleasure in you,” says the Lord"
        },
        {
          "verse": 11,
          "usfm": "MAL.1.11",
          "line_type": "p",
          "text": "For My name will be great among the nations, from where the sun rises to where it sets. In every place, incense and pure offerings will be presented in My name, because My name will be great among the nations,” says the Lord"
        },
        {
          "verse": 12,
          "usfm": "MAL.1.12",
          "line_type": "p",
          "text": "“But you profane it when you say, ‘The table of the Lord is defiled, and as for its fruit, its food is contemptible.’"
        },
        {
          "verse": 13,
          "usfm": "MAL.1.13",
          "line_type": "p",
          "text": "You also say: ‘Oh, what a nuisance!’ And you turn up your nose at it,” says the Lord“You bring offerings that are stolen, lame, or sick! Should I accept these from your hands?” asks the Lord"
        },
        {
          "verse": 14,
          "usfm": "MAL.1.14",
          "line_type": "p",
          "text": "“But cursed is the deceiver who has an acceptable male in his flock and vows to give it, but sacrifices a defective animal to the Lord. For I am a great King,” says the Lord"
        }
      ],
      "verse_count": 14,
      "headings": [
        {
          "before_verse": 6,
          "text": "The Polluted Offerings"
        }
      ],
      "footnotes": [
        {
          "verse": 1,
          "usfm": "MAL.1.1",
          "note_ref": "1:1",
          "note_type": "footnote",
          "references": [],
          "text": "Malachi means My messenger."
        },
        {
          "verse": 3,
          "usfm": "MAL.1.3",
          "note_ref": "1:3",
          "note_type": "footnote",
          "references": [],
          "text": "Cited in Romans 9:13"
        },
        {
          "verse": 3,
          "usfm": "MAL.1.3",
          "note_ref": "1:3",
          "note_type": "footnote",
          "references": [],
          "text": "Or to the serpents of the wilderness or to the dragons of the wilderness"
        },
        {
          "verse": 7,
          "usfm": "MAL.1.7",
          "note_ref": "1:7",
          "note_type": "footnote",
          "references": [],
          "text": "LXX defiled it"
        }
      ],
