    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 3,
      "chapter_usfm": "JON.3",
      "version_id": 3034,
      "version_abbr": "BSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.3.1",
          "line_type": "p",
          "text": "Then the word of the Lord"
        },
        {
          "verse": 2,
          "usfm": "JON.3.2",
          "line_type": "p",
          "text": "“Get up! Go to the great city of Nineveh and proclaim to it the message that I give you.”"
        },
        {
          "verse": 3,
          "usfm": "JON.3.3",
          "line_type": "p",
          "text": "This time Jonah got up and went to Nineveh, in accordance with the word of the LordNow Nineveh was an exceedingly great city, requiring a three-day journey."
        },
        {
          "verse": 4,
          "usfm": "JON.3.4",
          "line_type": "p",
          "text": "On the first day of his journey, Jonah set out into the city and proclaimed, “Forty more days and Nineveh will be overturned!”"
        },
        {
          "verse": 5,
          "usfm": "JON.3.5",
          "line_type": "p",
          "text": "And the Ninevites believed God. They proclaimed a fast and dressed in sackcloth, from the greatest of them to the least."
        },
        {
          "verse": 6,
          "usfm": "JON.3.6",
          "line_type": "p",
          "text": "When word reached the king of Nineveh, he got up from his throne, took off his royal robe, covered himself with sackcloth, and sat in ashes."
        },
        {
          "verse": 7,
          "usfm": "JON.3.7",
          "line_type": "p",
          "text": "Then he issued a proclamation in Nineveh:“By the decree of the king and his nobles:Let no man or beast, herd or flock, taste anything at all. They must not eat or drink."
        },
        {
          "verse": 8,
          "usfm": "JON.3.8",
          "line_type": "p",
          "text": "Furthermore, let both man and beast be covered with sackcloth, and have everyone call out earnestly to God. Let each one turn from his evil ways and from the violence in his hands."
        },
        {
          "verse": 9,
          "usfm": "JON.3.9",
          "line_type": "p",
          "text": "Who knows? God may turn and relent; He may turn from His fierce anger, so that we will not perish.”"
        },
        {
          "verse": 10,
          "usfm": "JON.3.10",
          "line_type": "p",
          "text": "When God saw their actions— that they had turned from their evil ways— He relented from the disaster He had threatened to bring upon them."
        }
      ],
      "verse_count": 10,
      "headings": [],
      "footnotes": [
        {
          "verse": 3,
          "usfm": "JON.3.3",
          "note_ref": "3:3",
          "note_type": "footnote",
          "references": [],
          "text": "Or was a great city to God"
        },
        {
          "verse": 3,
          "usfm": "JON.3.3",
          "note_ref": "3:3",
          "note_type": "footnote",
          "references": [],
          "text": "Literally great city, a three-day journey"
        }
      ],
