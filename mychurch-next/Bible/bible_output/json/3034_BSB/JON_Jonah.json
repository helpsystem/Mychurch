  "chapters": [
    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 1,
      "chapter_usfm": "JON.1",
      "version_id": 3034,
      "version_abbr": "BSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.1.1",
          "line_type": "p",
          "text": "Now the word of the Lord"
        },
        {
          "verse": 2,
          "usfm": "JON.1.2",
          "line_type": "p",
          "text": "“Get up! Go to the great city of Nineveh and preach against it, because its wickedness has come up before Me.”"
        },
        {
          "verse": 3,
          "usfm": "JON.1.3",
          "line_type": "p",
          "text": "Jonah, however, got up to flee to Tarshish, away from the presence of the Lord"
        },
        {
          "verse": 4,
          "usfm": "JON.1.4",
          "line_type": "p",
          "text": "Then the Lord"
        },
        {
          "verse": 5,
          "usfm": "JON.1.5",
          "line_type": "p",
          "text": "The sailors were afraid, and each cried out to his own god. And they threw the ship’s cargo into the sea to lighten the load. But Jonah had gone down to the lowest part of the vessel, where he lay down and fell into a deep sleep."
        },
        {
          "verse": 6,
          "usfm": "JON.1.6",
          "line_type": "p",
          "text": "The captain approached him and said, “How can you sleep? Get up and call upon your God. Perhaps this God will consider us, so that we may not perish.”"
        },
        {
          "verse": 7,
          "usfm": "JON.1.7",
          "line_type": "p",
          "text": "“Come!” said the sailors to one another. “Let us cast lots to find out who is responsible for this calamity that is upon us.”So they cast lots, and the lot fell on Jonah."
        },
        {
          "verse": 8,
          "usfm": "JON.1.8",
          "line_type": "p",
          "text": "“Tell us now,” they demanded, “who is to blame for this calamity that is upon us? What is your occupation, and where have you come from? What is your country, and who are your people?”"
        },
        {
          "verse": 9,
          "usfm": "JON.1.9",
          "line_type": "p",
          "text": "“I am a Hebrew,” replied Jonah. “I worship the Lord"
        },
        {
          "verse": 10,
          "usfm": "JON.1.10",
          "line_type": "p",
          "text": "Then the men were even more afraid and said to him, “What have you done?” The men knew that he was fleeing from the presence of the Lord"
        },
        {
          "verse": 11,
          "usfm": "JON.1.11",
          "line_type": "p",
          "text": "Now the sea was growing worse and worse, so they said to Jonah, “What must we do to you to calm this sea for us?”"
        },
        {
          "verse": 12,
          "usfm": "JON.1.12",
          "line_type": "p",
          "text": "“Pick me up,” he answered, “and cast me into the sea, so it may quiet down for you. For I know that I am to blame for this violent storm that has come upon you.”"
        },
        {
          "verse": 13,
          "usfm": "JON.1.13",
          "line_type": "p",
          "text": "Nevertheless, the men rowed hard to get back to dry land, but they could not, for the sea was raging against them more and more."
        },
        {
          "verse": 14,
          "usfm": "JON.1.14",
          "line_type": "p",
          "text": "So they cried out to the Lord"
        },
        {
          "verse": 15,
          "usfm": "JON.1.15",
          "line_type": "p",
          "text": "Then they picked up Jonah and cast him into the sea, and the raging sea grew calm."
        },
        {
          "verse": 16,
          "usfm": "JON.1.16",
          "line_type": "p",
          "text": "Then the men feared the Lord"
        },
        {
          "verse": 17,
          "usfm": "JON.1.17",
          "line_type": "p",
          "text": "Now the Lord"
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 4,
          "text": "The Great Storm"
        },
        {
          "before_verse": 11,
          "text": "Jonah Cast into the Sea"
        }
      ],
      "footnotes": [
        {
          "verse": 13,
          "usfm": "JON.1.13",
          "note_ref": "1:13",
          "note_type": "footnote",
          "references": [],
          "text": "Hebrew the men dug in"
        }
      ],
