    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 2,
      "chapter_usfm": "JON.2",
      "version_id": 3034,
      "version_abbr": "BSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.2.1",
          "line_type": "p",
          "text": "From inside the fish, Jonah prayed to the Lord"
        },
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "line_type": "p",
          "text": "saying:“In my distress I called to the Lordand He answered me.From the belly of Sheol I called for help,and You heard my voice."
        },
        {
          "verse": 3,
          "usfm": "JON.2.3",
          "line_type": "q1",
          "text": "For You cast me into the deep,into the heart of the seas,and the current swirled about me;all Your breakers and waves swept over me."
        },
        {
          "verse": 4,
          "usfm": "JON.2.4",
          "line_type": "q1",
          "text": "At this, I said,‘I have been banished from Your sight;yet I will look once moretoward Your holy temple.’"
        },
        {
          "verse": 5,
          "usfm": "JON.2.5",
          "line_type": "q1",
          "text": "The waters engulfed meto take my life;the watery depths closed around me;the seaweed wrapped around my head."
        },
        {
          "verse": 6,
          "usfm": "JON.2.6",
          "line_type": "q1",
          "text": "To the roots of the mountains I descended;the earth beneath me barred me in forever!But You raised my life from the pit,O Lord"
        },
        {
          "verse": 7,
          "usfm": "JON.2.7",
          "line_type": "q1",
          "text": "As my life was fading away,I remembered the LordMy prayer went up to You,to Your holy temple."
        },
        {
          "verse": 8,
          "usfm": "JON.2.8",
          "line_type": "q1",
          "text": "Those who cling to worthless idolsforsake His loving devotion."
        },
        {
          "verse": 9,
          "usfm": "JON.2.9",
          "line_type": "q1",
          "text": "But I, with the voice of thanksgiving,will sacrifice to You.I will fulfill what I have vowed.Salvation is from the Lord"
        },
        {
          "verse": 10,
          "usfm": "JON.2.10",
          "line_type": "p",
          "text": "And the Lord"
        }
      ],
      "verse_count": 10,
      "headings": [],
      "footnotes": [
        {
          "verse": 8,
          "usfm": "JON.2.8",
          "note_ref": "2:8",
          "note_type": "footnote",
          "references": [],
          "text": "Forms of the Hebrew chesed are translated here and in most cases throughout the Scriptures as loving devotion; the range of meaning includes love, goodness, kindness, faithfulness, and mercy, as well as loyalty to a covenant."
        }
      ],
