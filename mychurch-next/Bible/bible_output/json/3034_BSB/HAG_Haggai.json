  "chapters": [
    {
      "schema_version": 6,
      "book_id": "HAG",
      "chapter": 1,
      "chapter_usfm": "HAG.1",
      "version_id": 3034,
      "version_abbr": "BSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAG.1.1",
          "line_type": "p",
          "text": "In the second year of the reign of Darius, on the first day of the sixth month, the word of the Lord the high priest, stating"
        },
        {
          "verse": 2,
          "usfm": "HAG.1.2",
          "line_type": "p",
          "text": "that this is what the Lord“These people say, ‘The time has not yet cometo rebuild the house of the Lord"
        },
        {
          "verse": 3,
          "usfm": "HAG.1.3",
          "line_type": "p",
          "text": "Then the word of the Lord"
        },
        {
          "verse": 4,
          "usfm": "HAG.1.4",
          "line_type": "q1",
          "text": "“Is it a time for you yourselvesto live in your paneled houses,while this house lies in ruins?”"
        },
        {
          "verse": 5,
          "usfm": "HAG.1.5",
          "line_type": "p",
          "text": "Now this is what the Lord“Consider carefully your ways."
        },
        {
          "verse": 6,
          "usfm": "HAG.1.6",
          "line_type": "q1",
          "text": "You have planted muchbut harvested little.You eat but never have enough.You drink but never have your fill.You put on clothes but never get warm.You earn wages to put into a bag pierced through.”"
        },
        {
          "verse": 7,
          "usfm": "HAG.1.7",
          "line_type": "p",
          "text": "This is what the Lord“Consider carefully your ways."
        },
        {
          "verse": 8,
          "usfm": "HAG.1.8",
          "line_type": "q1",
          "text": "Go up into the hills,bring down lumber, and build the house,so that I may take pleasure in it and be glorified,says the Lord"
        },
        {
          "verse": 9,
          "usfm": "HAG.1.9",
          "line_type": "q1",
          "text": "You expected much,but behold, it amounted to little.And what you brought home, I blew away.Why? declares the LordBecause My house still lies in ruins,while each of you is busywith his own house."
        },
        {
          "verse": 10,
          "usfm": "HAG.1.10",
          "line_type": "q1",
          "text": "Therefore, on account of youthe heavens have withheld their dewand the earth has withheld its crops."
        },
        {
          "verse": 11,
          "usfm": "HAG.1.11",
          "line_type": "q1",
          "text": "I have summoned a droughton the fields and on the mountains,on the grain, new wine, and oil,and on whatever the ground yields,on man and beast,and on all the labor of your hands.”"
        },
        {
          "verse": 12,
          "usfm": "HAG.1.12",
          "line_type": "p",
          "text": "Then Zerubbabel son of Shealtiel and Joshua son of Jehozadak, the high priest, as well as all the remnant of the people, obeyed the voice of the Lord"
        },
        {
          "verse": 13,
          "usfm": "HAG.1.13",
          "line_type": "p",
          "text": "Haggai, the messenger of the Lord“I am with you,”declares the Lord"
        },
        {
          "verse": 14,
          "usfm": "HAG.1.14",
          "line_type": "p",
          "text": "So the Lord"
        },
        {
          "verse": 15,
          "usfm": "HAG.1.15",
          "line_type": "p",
          "text": "on the twenty-fourth day of the sixth month, in the second year of King Darius."
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 12,
          "text": "The People Obey"
        }
      ],
      "footnotes": [
        {
          "verse": 1,
          "usfm": "HAG.1.1",
          "note_ref": "1:1",
          "note_type": "footnote",
          "references": [],
          "text": "Jehozadak is a variant of Jozadak; also in verses 12 and 14; see Ezra 3:2."
        }
      ],
