  "chapters": [
    {
      "schema_version": 6,
      "book_id": "OBA",
      "chapter": 1,
      "chapter_usfm": "OBA.1",
      "version_id": 3034,
      "version_abbr": "BSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "OBA.1.1",
          "line_type": "p",
          "text": "This is the vision of Obadiah:This is what the Lord GOD says about Edom —We have heard a message from the Lordan envoy has been sent among the nationsto say, “Rise up,and let us go to battle against her!”—"
        },
        {
          "verse": 2,
          "usfm": "OBA.1.2",
          "line_type": "q1",
          "text": "“Behold, I will make you small among the nations;you will be deeply despised."
        },
        {
          "verse": 3,
          "usfm": "OBA.1.3",
          "line_type": "q1",
          "text": "The pride of your heart has deceived you,O dwellers in the clefts of the rockswhose habitation is the heights,who say in your heart,‘Who can bring me down to the ground?’"
        },
        {
          "verse": 4,
          "usfm": "OBA.1.4",
          "line_type": "q1",
          "text": "Though you soar like the eagleand make your nest among the stars,even from there I will bring you down,”declares the Lord"
        },
        {
          "verse": 5,
          "usfm": "OBA.1.5",
          "line_type": "q1",
          "text": "“If thieves came to you,if robbers by night —oh, how you will be ruined —would they not steal only what they wanted?If grape gatherers came to you,would they not leave some gleanings?"
        },
        {
          "verse": 6,
          "usfm": "OBA.1.6",
          "line_type": "q1",
          "text": "But how Esau will be pillaged,his hidden treasures sought out!"
        },
        {
          "verse": 7,
          "usfm": "OBA.1.7",
          "line_type": "q1",
          "text": "All the men allied with youwill drive you to the border;the men at peace with youwill deceive and overpower you.Those who eat your breadwill set a trap for youwithout your awareness of it."
        },
        {
          "verse": 8,
          "usfm": "OBA.1.8",
          "line_type": "q1",
          "text": "In that day, declares the Lordwill I not destroy the wise men of Edomand the men of understandingin the mountains of Esau?"
        },
        {
          "verse": 9,
          "usfm": "OBA.1.9",
          "line_type": "q1",
          "text": "Then your mighty men, O Teman,will be terrified,so that everyone in the mountains of Esauwill be cut down in the slaughter."
        },
        {
          "verse": 10,
          "usfm": "OBA.1.10",
          "line_type": "q1",
          "text": "Because of the violence against your brother Jacob,you will be covered with shameand cut off forever."
        },
        {
          "verse": 11,
          "usfm": "OBA.1.11",
          "line_type": "q1",
          "text": "On the day you stood aloofwhile strangers carried off his wealthand foreigners entered his gateand cast lots for Jerusalem,you were just like one of them."
        },
        {
          "verse": 12,
          "usfm": "OBA.1.12",
          "line_type": "q1",
          "text": "But you should not gloat in that day,your brother’s day of misfortune,nor rejoice over the people of Judahin the day of their destruction,nor boast proudlyin the day of their distress."
        },
        {
          "verse": 13,
          "usfm": "OBA.1.13",
          "line_type": "q1",
          "text": "You should not enter the gate of My peoplein the day of their disaster,nor gloat over their afflictionin the day of their disaster,nor loot their wealthin the day of their disaster."
        },
        {
          "verse": 14,
          "usfm": "OBA.1.14",
          "line_type": "q1",
          "text": "Nor should you stand at the crossroadsto cut off their fugitives,nor deliver up their survivorsin the day of their distress."
        },
        {
          "verse": 15,
          "usfm": "OBA.1.15",
          "line_type": "q1",
          "text": "For the Day of the Lordfor all the nations.As you have done, it will be done to you;your recompense will return upon your own head."
        },
        {
          "verse": 16,
          "usfm": "OBA.1.16",
          "line_type": "q1",
          "text": "For as you drank on My holy mountain,so all the nations will drink continually.They will drink and gulp it down;they will be as if they had never existed."
        },
        {
          "verse": 17,
          "usfm": "OBA.1.17",
          "line_type": "q1",
          "text": "But on Mount Zion there will be deliverance,and it will be holy,and the house of Jacobwill reclaim their possession."
        },
        {
          "verse": 18,
          "usfm": "OBA.1.18",
          "line_type": "q1",
          "text": "Then the house of Jacob will be a blazing fire,and the house of Joseph a burning flame;but the house of Esau will be stubble —Jacob will set it ablaze and consume it.Therefore no survivor will remainfrom the house of Esau.”For the Lord"
        },
        {
          "verse": 19,
          "usfm": "OBA.1.19",
          "line_type": "q1",
          "text": "Those from the Negev will possess the mountains of Esau;those from the foothills will possess the land of the Philistines.They will occupy the fields of Ephraim and Samaria,and Benjamin will possess Gilead."
        },
        {
          "verse": 20,
          "usfm": "OBA.1.20",
          "line_type": "q1",
          "text": "And the exiles of this host of the Israeliteswill possess the land of the Canaanites as far as Zarephath;and the exiles from Jerusalem who are in Sepharadwill possess the cities of the Negev."
        },
        {
          "verse": 21,
          "usfm": "OBA.1.21",
          "line_type": "q1",
          "text": "The deliverers will ascend Mount Zionto rule over the mountains of Esau.And the kingdom will belong to the Lord"
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 15,
          "text": "The Deliverance of Israel"
        }
      ],
