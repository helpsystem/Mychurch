  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 1,
      "chapter_usfm": "2TI.1",
      "version_id": 3034,
      "version_abbr": "BSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.1.1",
          "line_type": "p",
          "text": "Paul, an apostle of Christ Jesus by the will of God, according to the promise of life in Christ Jesus,"
        },
        {
          "verse": 2,
          "usfm": "2TI.1.2",
          "line_type": "p",
          "text": "To Timothy, my beloved child:Grace, mercy, and peace from God the Father and Christ Jesus our Lord."
        },
        {
          "verse": 3,
          "usfm": "2TI.1.3",
          "line_type": "p",
          "text": "I thank God, whom I serve with a clear conscience as did my forefathers, as I constantly remember you night and day in my prayers."
        },
        {
          "verse": 4,
          "usfm": "2TI.1.4",
          "line_type": "p",
          "text": "Recalling your tears, I long to see you so that I may be filled with joy."
        },
        {
          "verse": 5,
          "usfm": "2TI.1.5",
          "line_type": "p",
          "text": "I am reminded of your sincere faith, which first dwelt in your grandmother Lois and your mother Eunice, and I am convinced is in you as well."
        },
        {
          "verse": 6,
          "usfm": "2TI.1.6",
          "line_type": "p",
          "text": "For this reason I remind you to fan into flame the gift of God, which is in you through the laying on of my hands."
        },
        {
          "verse": 7,
          "usfm": "2TI.1.7",
          "line_type": "p",
          "text": "For God has not given us a spirit of fear, but of power, love, and self-control."
        },
        {
          "verse": 8,
          "usfm": "2TI.1.8",
          "line_type": "p",
          "text": "So do not be ashamed of the testimony of our Lord, or of me, His prisoner. Instead, join me in suffering for the gospel by the power of God."
        },
        {
          "verse": 9,
          "usfm": "2TI.1.9",
          "line_type": "p",
          "text": "He has saved us and called us to a holy calling, not because of our works, but by His own purpose and by the grace He granted us in Christ Jesus before time began."
        },
        {
          "verse": 10,
          "usfm": "2TI.1.10",
          "line_type": "p",
          "text": "And now He has revealed this grace through the appearing of our Savior, Christ Jesus, who has abolished death and illuminated the way to life and immortality through the gospel,"
        },
        {
          "verse": 11,
          "usfm": "2TI.1.11",
          "line_type": "p",
          "text": "to which I was appointed as a preacher, an apostle, and a teacher."
        },
        {
          "verse": 12,
          "usfm": "2TI.1.12",
          "line_type": "p",
          "text": "For this reason, even though I suffer as I do, I am not ashamed; for I know whom I have believed, and I am convinced that He is able to guard what I have entrusted to Him for that day."
        },
        {
          "verse": 13,
          "usfm": "2TI.1.13",
          "line_type": "p",
          "text": "Hold on to the pattern of sound teaching you have heard from me, with the faith and love that are in Christ Jesus."
        },
        {
          "verse": 14,
          "usfm": "2TI.1.14",
          "line_type": "p",
          "text": "Guard the treasure entrusted to you, with the help of the Holy Spirit who dwells in us."
        },
        {
          "verse": 15,
          "usfm": "2TI.1.15",
          "line_type": "p",
          "text": "You know that everyone in the Province of Asia has deserted me, including Phygelus and Hermogenes."
        },
        {
          "verse": 16,
          "usfm": "2TI.1.16",
          "line_type": "p",
          "text": "May the Lord grant mercy to the household of Onesiphorus, because he has often refreshed me and was unashamed of my chains."
        },
        {
          "verse": 17,
          "usfm": "2TI.1.17",
          "line_type": "p",
          "text": "Indeed, when he arrived in Rome, he searched diligently until he found me."
        },
        {
          "verse": 18,
          "usfm": "2TI.1.18",
          "line_type": "p",
          "text": "May the Lord grant Onesiphorus His mercy on that day. You know very well how much he ministered to me in Ephesus."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 3,
          "text": "Faithfulness under Persecution"
        },
        {
          "before_verse": 13,
          "text": "Holding to Sound Teaching"
        }
      ],
      "footnotes": [
        {
          "verse": 7,
          "usfm": "2TI.1.7",
          "note_ref": "1:7",
          "note_type": "footnote",
