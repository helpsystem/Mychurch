    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 4,
      "chapter_usfm": "2TI.4",
      "version_id": 3034,
      "version_abbr": "BSB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.4.1",
          "line_type": "p",
          "text": "I charge you in the presence of God and of Christ Jesus, who will judge the living and the dead, and in view of His appearing and His kingdom:"
        },
        {
          "verse": 2,
          "usfm": "2TI.4.2",
          "line_type": "p",
          "text": "Preach the word; be prepared in season and out of season; reprove, rebuke, and encourage with every form of patient instruction."
        },
        {
          "verse": 3,
          "usfm": "2TI.4.3",
          "line_type": "p",
          "text": "For the time will come when men will not tolerate sound doctrine, but with itching ears they will gather around themselves teachers to suit their own desires."
        },
        {
          "verse": 4,
          "usfm": "2TI.4.4",
          "line_type": "p",
          "text": "So they will turn their ears away from the truth and turn aside to myths."
        },
        {
          "verse": 5,
          "usfm": "2TI.4.5",
          "line_type": "p",
          "text": "But you, be sober in all things, endure hardship, do the work of an evangelist, fulfill your ministry."
        },
        {
          "verse": 6,
          "usfm": "2TI.4.6",
          "line_type": "p",
          "text": "For I am already being poured out like a drink offering, and the time of my departure is at hand."
        },
        {
          "verse": 7,
          "usfm": "2TI.4.7",
          "line_type": "p",
          "text": "I have fought the good fight, I have finished the race, I have kept the faith."
        },
        {
          "verse": 8,
          "usfm": "2TI.4.8",
          "line_type": "p",
          "text": "From now on there is laid up for me the crown of righteousness, which the Lord, the righteous Judge, will award to me on that day — and not only to me, but to all who crave His appearing."
        },
        {
          "verse": 9,
          "usfm": "2TI.4.9",
          "line_type": "p",
          "text": "Make every effort to come to me quickly,"
        },
        {
          "verse": 10,
          "usfm": "2TI.4.10",
          "line_type": "p",
          "text": "because Demas, in his love of this world, has deserted me and gone to Thessalonica. Crescens has gone to Galatia, and Titus to Dalmatia."
        },
        {
          "verse": 11,
          "usfm": "2TI.4.11",
          "line_type": "p",
          "text": "Only Luke is with me. Get Mark and bring him with you, because he is useful to me in the ministry."
        },
        {
          "verse": 12,
          "usfm": "2TI.4.12",
          "line_type": "p",
          "text": "Tychicus, however, I have sent to Ephesus."
        },
        {
          "verse": 13,
          "usfm": "2TI.4.13",
          "line_type": "p",
          "text": "When you come, bring the cloak that I left with Carpus at Troas, and my scrolls, especially the parchments."
        },
        {
          "verse": 14,
          "usfm": "2TI.4.14",
          "line_type": "p",
          "text": "Alexander the coppersmith did great harm to me. The Lord will repay him according to his deeds."
        },
        {
          "verse": 15,
          "usfm": "2TI.4.15",
          "line_type": "p",
          "text": "You too should beware of him, for he has vigorously opposed our message."
        },
        {
          "verse": 16,
          "usfm": "2TI.4.16",
          "line_type": "p",
          "text": "At my first defense, no one stood with me, but everyone deserted me. May it not be charged against them."
        },
        {
          "verse": 17,
          "usfm": "2TI.4.17",
          "line_type": "p",
          "text": "But the Lord stood by me and strengthened me, so that through me the message would be fully proclaimed, and all the Gentiles would hear it. So I was delivered from the mouth of the lion."
        },
        {
          "verse": 18,
          "usfm": "2TI.4.18",
          "line_type": "p",
          "text": "And the Lord will rescue me from every evil action and bring me safely into His heavenly kingdom. To Him be the glory forever and ever. Amen."
        },
        {
          "verse": 19,
          "usfm": "2TI.4.19",
          "line_type": "p",
          "text": "Greet Prisca and Aquila, as well as the household of Onesiphorus."
        },
        {
          "verse": 20,
          "usfm": "2TI.4.20",
          "line_type": "p",
          "text": "Erastus has remained at Corinth, and Trophimus I left sick in Miletus."
        },
        {
          "verse": 21,
          "usfm": "2TI.4.21",
          "line_type": "p",
          "text": "Make every effort to come to me before winter.Eubulus sends you greetings, as do Pudens, Linus, Claudia, and all the brothers."
        },
        {
          "verse": 22,
          "usfm": "2TI.4.22",
          "line_type": "p",
          "text": "The Lord be with your spirit. Grace be with you all."
        }
      ],
      "verse_count": 22,
      "headings": [
        {
          "before_verse": 9,
          "text": "Personal Concerns"
        },
        {
          "before_verse": 16,
          "text": "The Lord Remains Faithful"
        },
        {
          "before_verse": 19,
          "text": "Final Greetings"
        }
      ],
      "footnotes": [
        {
          "verse": 19,
          "usfm": "2TI.4.19",
          "note_ref": "4:19",
          "note_type": "footnote",
          "references": [],
          "text": "Prisca is a variant of Priscilla; see Acts 18:2."
        },
        {
          "verse": 22,
          "usfm": "2TI.4.22",
          "note_ref": "4:22",
          "note_type": "footnote",
          "references": [],
          "text": "BYZ and TR include Amen."
        }
      ],
