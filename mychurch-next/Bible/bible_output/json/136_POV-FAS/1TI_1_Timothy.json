    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 4,
      "chapter_usfm": "1TI.4",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.4.1",
          "line_type": "p",
          "text": "و لیکن روح صریح میگوید که در زمان آخر بعضی از ایمان برگشته، به ارواح مضل و تعالیم شیاطین اصغا خواهند نمود،"
        },
        {
          "verse": 2,
          "usfm": "1TI.4.2",
          "line_type": "p",
          "text": "به ریاکاری دروغگویان که ضمایر خود را داغ کردهاند؛"
        },
        {
          "verse": 3,
          "usfm": "1TI.4.3",
          "line_type": "p",
          "text": "که از مزاوجت منع میکنند و حکم مینمایند به احتراز از خوراک هایی که خدا آفریدبرای مومنین و عارفین حق تا آنها را به شکرگزاری بخورند."
        },
        {
          "verse": 4,
          "usfm": "1TI.4.4",
          "line_type": "p",
          "text": "زیرا که هر مخلوق خدا نیکو است وهیچچیز را رد نباید کرد، اگر به شکرگزاری پذیرند،"
        },
        {
          "verse": 5,
          "usfm": "1TI.4.5",
          "line_type": "p",
          "text": "زیرا که از کلام خدا و دعا تقدیس میشود."
        },
        {
          "verse": 6,
          "usfm": "1TI.4.6",
          "line_type": "p",
          "text": "اگر این امور را به برادران بسپاری، خادم نیکوی مسیح عیسی خواهی بود، تربیت یافته درکلام ایمان و تعلیم خوب که پیروی آن راکردهای."
        },
        {
          "verse": 7,
          "usfm": "1TI.4.7",
          "line_type": "p",
          "text": "لیکن از افسانه های حرام عجوزهااحتراز نما و در دینداری ریاضت بکش."
        },
        {
          "verse": 8,
          "usfm": "1TI.4.8",
          "line_type": "p",
          "text": "که ریاضت بدنی اندک فایدهای دارد، لیکن دینداری برای هر چیز مفید است که وعده زندگی حال وآینده را دارد."
        },
        {
          "verse": 9,
          "usfm": "1TI.4.9",
          "line_type": "p",
          "text": "این سخن امین است و لایق قبول تام،"
        },
        {
          "verse": 10,
          "usfm": "1TI.4.10",
          "line_type": "p",
          "text": "زیراکه برای این زحمت و بیاحترامی میکشیم، زیراامید داریم به خدای زنده که جمیع مردمان علی الخصوص مومنین را نجاتدهنده است."
        },
        {
          "verse": 11,
          "usfm": "1TI.4.11",
          "line_type": "p",
          "text": "این امور را حکم و تعلیم فرما."
        },
        {
          "verse": 12,
          "usfm": "1TI.4.12",
          "line_type": "p",
          "text": "هیچکس جوانی تو را حقیر نشمارد، بلکه مومنین را درکلام و سیرت و محبت و ایمان و عصمت، نمونه باش."
        },
        {
          "verse": 13,
          "usfm": "1TI.4.13",
          "line_type": "p",
          "text": "تا مادامی که نه آیم، خود را به قرائت ونصیحت و تعلیم بسپار."
        },
        {
          "verse": 14,
          "usfm": "1TI.4.14",
          "line_type": "p",
          "text": "زنهار از آن کرامتی که در تو است که بوسیله نبوت با نهادن دستهای کشیشان به تو داده شد، بیاعتنایی منما."
        },
        {
          "verse": 15,
          "usfm": "1TI.4.15",
          "line_type": "p",
          "text": "در این امور تامل نما و در اینها راسخ باش تا ترقی تو برهمه ظاهر شود."
        },
        {
          "verse": 16,
          "usfm": "1TI.4.16",
          "line_type": "p",
          "text": "خویشتن را و تعلیم را احتیاطکن و در این امور قائم باش که هرگاه چنین کنی، خویشتن را و شنوندگان خویش را نیز نجات خواهی داد."
        }
      ],
