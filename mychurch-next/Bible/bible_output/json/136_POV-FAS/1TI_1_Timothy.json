    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 5,
      "chapter_usfm": "1TI.5",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.5.1",
          "line_type": "p",
          "text": "مرد پیر را توبیخ منما بلکه چون پدر او رانصیحت کن، و جوانان را چون برادران؛"
        },
        {
          "verse": 2,
          "usfm": "1TI.5.2",
          "line_type": "p",
          "text": "زنان پیر را چون مادران؛ و زنان جوان را مثل خواهران با کمال عفت؛"
        },
        {
          "verse": 3,
          "usfm": "1TI.5.3",
          "line_type": "p",
          "text": "بیوهزنان را اگرفی الحقیقت بیوه باشند، محترم دار."
        },
        {
          "verse": 4,
          "usfm": "1TI.5.4",
          "line_type": "p",
          "text": "اما اگربیوهزنی فرزندان یا نوادهها دارد، آموخته بشوندکه خانه خود را با دینداری نگاه دارند و حقوق اجداد خود را ادا کنند که این در حضور خدا نیکوو پسندیده است."
        },
        {
          "verse": 5,
          "usfm": "1TI.5.5",
          "line_type": "p",
          "text": "اما زنی که فی الحقیقت بیوه وبی کس است، به خدا امیدوار است و در صلوات ودعاها شبانهروز مشغول میباشد."
        },
        {
          "verse": 6,
          "usfm": "1TI.5.6",
          "line_type": "p",
          "text": "لیکن زن عیاش در حال حیات مرده است."
        },
        {
          "verse": 7,
          "usfm": "1TI.5.7",
          "line_type": "p",
          "text": "و به این معانی امر فرما تا بیملامت باشند."
        },
        {
          "verse": 8,
          "usfm": "1TI.5.8",
          "line_type": "p",
          "text": "ولی اگر کسی برای خویشان و علی الخصوص اهل خانه خود تدبیرنکند، منکر ایمان و پستتر از بیایمان است."
        },
        {
          "verse": 9,
          "usfm": "1TI.5.9",
          "line_type": "p",
          "text": "بیوهزنی که کمتر از شصت ساله نباشد و یک شوهر کرده باشد، باید نام او ثبت گردد،"
        },
        {
          "verse": 10,
          "usfm": "1TI.5.10",
          "line_type": "p",
          "text": "که دراعمال صالح نیک نام باشد، اگر فرزندان را پرورده و غربا را مهمانی نموده و پایهای مقدسین راشسته و زحمت کشان را اعانتی نموده و هر کارنیکو را پیروی کرده باشد."
        },
        {
          "verse": 11,
          "usfm": "1TI.5.11",
          "line_type": "p",
          "text": "اما بیوه های جوانتراز این را قبول مکن، زیرا که چون از مسیح سرکش شوند، خواهش نکاح دارند"
        },
        {
          "verse": 12,
          "usfm": "1TI.5.12",
          "line_type": "p",
          "text": "و ملزم میشوند ازاینکه ایمان نخست را برطرف کردهاند؛"
        },
        {
          "verse": 13,
          "usfm": "1TI.5.13",
          "line_type": "p",
          "text": "وعلاوه بر این خانه به خانه گردش کرده، آموخته میشوند که بیکار باشند؛ و نه فقط بیکار بلکه بیهوده گو و فضول هم که حرفهای ناشایسته میزنند."
        },
        {
          "verse": 14,
          "usfm": "1TI.5.14",
          "line_type": "p",
          "text": "پس رای من این است که زنان جوان نکاح شوند و اولاد بزایند و کدبانو شوند و خصم را مجال مذمت ندهند؛"
        },
        {
          "verse": 15,
          "usfm": "1TI.5.15",
          "line_type": "p",
          "text": "زیرا که بعضی برگشتندبه عقب شیطان."
        },
        {
          "verse": 16,
          "usfm": "1TI.5.16",
          "line_type": "p",
          "text": "اگر مرد یا زن مومن، بیوه هادارد ایشان را بپرورد و بار بر کلیسا ننهد تا آنانی راکه فی الحقیقت بیوه باشند، پرورش نماید."
        },
        {
          "verse": 17,
          "usfm": "1TI.5.17",
          "line_type": "p",
          "text": "کشیشانی که نیکو پیشوایی کردهاند، مستحق حرمت مضاعف میباشند، علی الخصوص آنانی که در کلام و تعلیم محنت میکشند."
        },
        {
          "verse": 18,
          "usfm": "1TI.5.18",
          "line_type": "p",
          "text": "زیرا کتاب میگوید: «گاو را وقتی که خرمن را خرد میکند، دهن مبند» و «مزدورمستحق اجرت خود است»."
        },
        {
          "verse": 19,
          "usfm": "1TI.5.19",
          "line_type": "p",
          "text": "ادعایی بر یکی ازکشیشان جز به زبان دو یا سه شاهد مپذیر."
        },
        {
          "verse": 20,
          "usfm": "1TI.5.20",
          "line_type": "p",
          "text": "آنانی که گناه کنند، پیش همه توبیخ فرما تا دیگران بترسند."
        },
        {
          "verse": 21,
          "usfm": "1TI.5.21",
          "line_type": "p",
          "text": "در حضور خدا و مسیح عیسی و فرشتگان برگزیده تو را قسم میدهم که این امور را بدون غرض نگاه داری و هیچ کاری از روی طرفداری مکن."
        },
        {
          "verse": 22,
          "usfm": "1TI.5.22",
          "line_type": "p",
          "text": "و دستها به زودی بر هیچکس مگذار و درگناهان دیگران شریک مشو بلکه خود را طاهرنگاه دار."
        },
        {
          "verse": 23,
          "usfm": "1TI.5.23",
          "line_type": "p",
          "text": "دیگر آشامنده آب فقط مباش، بلکه بجهت شکمت و ضعفهای بسیار خود شرابی کم میل فرما."
        },
        {
          "verse": 24,
          "usfm": "1TI.5.24",
          "line_type": "p",
          "text": "گناهان بعضی آشکار است و پیش روی ایشان به داوری میخرامد، اما بعضی را تعاقب میکند."
        },
        {
          "verse": 25,
          "usfm": "1TI.5.25",
          "line_type": "p",
          "text": "و همچنین اعمال نیکو واضح است وآنهایی که دیگرگون باشد، نتوان مخفی داشت."
        }
      ],
