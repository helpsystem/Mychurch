    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 6,
      "chapter_usfm": "1TI.6",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.6.1",
          "line_type": "p",
          "text": "آنانی که غلامان زیر یوغ میباشند، آقایان خویش را لایق کمال احترام بدانند که مبادانام و تعلیم خدا بد گفته شود."
        },
        {
          "verse": 2,
          "usfm": "1TI.6.2",
          "line_type": "p",
          "text": "اما کسانی که آقایان مومن دارند، ایشان را تحقیر ننمایند، ازآنجا که برادرانند بلکه بیشتر خدمت کنند از آنروکه آنانی که در این احسان مشارکند، مومن ومحبوبند."
        },
        {
          "verse": 3,
          "usfm": "1TI.6.3",
          "line_type": "p",
          "text": "و اگرکسی بطور دیگر تعلیم دهد و کلام صحیح خداوند ما عیسی مسیح و آن تعلیمی را که به طریق دینداری است قبول ننماید،"
        },
        {
          "verse": 4,
          "usfm": "1TI.6.4",
          "line_type": "p",
          "text": "از غرورمست شده، هیچ نمی داند بلکه در مباحثات ومجادلات دیوانه گشته است که از آنها پدیدمی آید حسد و نزاع و کفر و ظنون شر"
        },
        {
          "verse": 5,
          "usfm": "1TI.6.5",
          "line_type": "p",
          "text": "و منازعات مردم فاسدالعقل و مرتد از حق که میپندارند دینداری سود است. از چنین اشخاص اعراض نما."
        },
        {
          "verse": 6,
          "usfm": "1TI.6.6",
          "line_type": "p",
          "text": "لیکن دینداری با قناعت سود عظیمی است."
        },
        {
          "verse": 7,
          "usfm": "1TI.6.7",
          "line_type": "p",
          "text": "زیرا که در این دنیا هیچ نیاوردیم و واضح است که از آن هیچ نمی توانیم برد."
        },
        {
          "verse": 8,
          "usfm": "1TI.6.8",
          "line_type": "p",
          "text": "پس اگر خوراک وپوشاک داریم، به آنها قانع خواهیم بود."
        },
        {
          "verse": 9,
          "usfm": "1TI.6.9",
          "line_type": "p",
          "text": "اماآنانی که میخواهند دولتمند شوند، گرفتارمی شوند در تجربه و دام و انواع شهوات بیفهم ومضر که مردم را به تباهی و هلاکت غرق میسازند."
        },
        {
          "verse": 10,
          "usfm": "1TI.6.10",
          "line_type": "p",
          "text": "زیرا که طمع ریشه همه بدیهااست که بعضی چون درپی آن میکوشیدند، ازایمان گمراه گشته، خود را به اقسام دردهاسفتند."
        },
        {
          "verse": 11,
          "usfm": "1TI.6.11",
          "line_type": "p",
          "text": "ولی توای مرد خدا، از اینها بگریز وعدالت و دینداری و ایمان و محبت و صبر وتواضع را پیروی نما."
        },
        {
          "verse": 12,
          "usfm": "1TI.6.12",
          "line_type": "p",
          "text": "و جنگ نیکوی ایمان رابکن و بدست آور آن حیات جاودانی را که برای آن دعوت شدی و اعتراف نیکو کردی در حضورگواهان بسیار."
        },
        {
          "verse": 13,
          "usfm": "1TI.6.13",
          "line_type": "p",
          "text": "تو را وصیت میکنم به حضور آن خدایی که همه را زندگی میبخشد و مسیح عیسی که درپیش پنطیوس پیلاطس اعتراف نیکونمود،"
        },
        {
          "verse": 14,
          "usfm": "1TI.6.14",
          "line_type": "p",
          "text": "که تو وصیت را بیداغ و ملامت حفظکن تا به ظهور خداوند ما عیسی مسیح."
        },
        {
          "verse": 15,
          "usfm": "1TI.6.15",
          "line_type": "p",
          "text": "که آن را آن متبارک و قادر وحید و ملک الملوک وربالارباب در زمان معین به ظهور خواهد آورد."
        },
        {
          "verse": 16,
          "usfm": "1TI.6.16",
          "line_type": "p",
          "text": "که تنها لایموت و ساکن در نوری است که نزدیک آن نتوان شد و احدی از انسان او را ندیده و نمی تواند دید. او را تا ابدالاباد اکرام و قدرت باد. آمین."
        },
        {
          "verse": 17,
          "usfm": "1TI.6.17",
          "line_type": "p",
          "text": "دولتمندان این جهان را امر فرما که بلندپروازی نکنند و به دولت ناپایدار امید ندارند، بلکه به خدای زنده که همهچیز را دولتمندانه برای تمتع به ما عطا میکند؛"
        },
        {
          "verse": 18,
          "usfm": "1TI.6.18",
          "line_type": "p",
          "text": "که نیکوکار بوده، در اعمال صالحه دولتمند و سخی و گشادهدست باشند؛"
        },
        {
          "verse": 19,
          "usfm": "1TI.6.19",
          "line_type": "p",
          "text": "و برای خود اساس نیکو بجهت عالم آینده نهند تا حیات جاودانی را بدست آرند."
        },
        {
          "verse": 20,
          "usfm": "1TI.6.20",
          "line_type": "p",
          "text": "ای تیموتاوس تو آن امانت را محفوظ دار واز بیهودهگویی های حرام و از مباحثات معرفت دروغ اعراض نما،"
        }
      ],
