    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 2,
      "chapter_usfm": "1TI.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.2.1",
          "line_type": "p",
          "text": "پس از همهچیز اول، سفارش میکنم که صلوات و دعاها و مناجات و شکرها رابرای جمیع مردم بهجا آورند؛"
        },
        {
          "verse": 2,
          "usfm": "1TI.2.2",
          "line_type": "p",
          "text": "بجهت پادشاهان و جمیع صاحبان منصب تا به آرامی و استراحت و با کمال دینداری و وقار، عمر خود را بسر بریم."
        },
        {
          "verse": 3,
          "usfm": "1TI.2.3",
          "line_type": "p",
          "text": "زیرا که این نیکو و پسندیده است، در حضورنجاتدهنده ما خدا"
        },
        {
          "verse": 4,
          "usfm": "1TI.2.4",
          "line_type": "p",
          "text": "که میخواهد جمیع مردم نجات یابند و به معرفت راستی گرایند."
        },
        {
          "verse": 5,
          "usfm": "1TI.2.5",
          "line_type": "p",
          "text": "زیراخدا واحد است و در میان خدا و انسان یک متوسطی است یعنی انسانی که مسیح عیسی باشد،"
        },
        {
          "verse": 6,
          "usfm": "1TI.2.6",
          "line_type": "p",
          "text": "که خود را در راه همه فدا داد، شهادتی درزمان معین."
        },
        {
          "verse": 7,
          "usfm": "1TI.2.7",
          "line_type": "p",
          "text": "و برای این، من واعظ و رسول ومعلم امتها در ایمان و راستی مقرر شدم. در مسیح راست میگویم و دروغ نی."
        },
        {
          "verse": 8,
          "usfm": "1TI.2.8",
          "line_type": "p",
          "text": "پس آرزوی این دارم که مردان، دست های مقدس را بدون غیظ و جدال برافراخته، در هر جادعا کنند."
        },
        {
          "verse": 9,
          "usfm": "1TI.2.9",
          "line_type": "p",
          "text": "و همچنین زنان خویشتن را بیارایند به لباس مزین به حیا و پرهیز نه به زلفها و طلا ومروارید و رخت گرانبها؛"
        },
        {
          "verse": 10,
          "usfm": "1TI.2.10",
          "line_type": "p",
          "text": "بلکه چنانکه زنانی رامی شاید که دعوای دینداری میکنند به اعمال صالحه."
        },
        {
          "verse": 11,
          "usfm": "1TI.2.11",
          "line_type": "p",
          "text": "زن با سکوت، بهکمال اطاعت تعلیم گیرد."
        },
        {
          "verse": 12,
          "usfm": "1TI.2.12",
          "line_type": "p",
          "text": "و زن را اجازت نمی دهم که تعلیم دهد یابر شوهر مسلط شود بلکه در سکوت بماند."
        },
        {
          "verse": 13,
          "usfm": "1TI.2.13",
          "line_type": "p",
          "text": "زیرا که آدم اول ساخته شد و بعد حوا."
        },
        {
          "verse": 14,
          "usfm": "1TI.2.14",
          "line_type": "p",
          "text": "وآدم فریب نخورد بلکه زن فریب خورده، درتقصیر گرفتار شد."
        },
        {
          "verse": 15,
          "usfm": "1TI.2.15",
          "line_type": "p",
          "text": "اما به زاییدن رستگارخواهد شد، اگر در ایمان و محبت و قدوسیت وتقوا ثابت بمانند."
        }
      ],
