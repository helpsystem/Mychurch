  "chapter_count": 6,
  "total_verses": 112,
  "chapters": [
    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 1,
      "chapter_usfm": "1TI.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.1.1",
          "line_type": "p",
          "text": "پولس، رسول عیسی مسیح به حکم نجاتدهنده ما خدا و مسیح عیسی خداوند که امید ما است،"
        },
        {
          "verse": 2,
          "usfm": "1TI.1.2",
          "line_type": "p",
          "text": "به فرزند حقیقی خود در ایمان، تیموتاوس.فیض و رحم و سلامتی از جانب خدای پدر وخداوند ما مسیح عیسی بر تو باد."
        },
        {
          "verse": 3,
          "usfm": "1TI.1.3",
          "line_type": "p",
          "text": "چنانکه هنگامی که عازم مکادونیه بودم، به شما التماس نمودم که در افسس بمانی تا بعضی را امر کنی که تعلیمی دیگر ندهند،"
        },
        {
          "verse": 4,
          "usfm": "1TI.1.4",
          "line_type": "p",
          "text": "و افسانهها ونسب نامه های نامتناهی را اصغا ننمایند که اینهامباحثات را نه آن تعمیر الهی را که در ایمان است پدید میآورد."
        },
        {
          "verse": 5,
          "usfm": "1TI.1.5",
          "line_type": "p",
          "text": "اما غایت حکم، محبت است ازدل پاک و ضمیر صالح و ایمان بیریا."
        },
        {
          "verse": 6,
          "usfm": "1TI.1.6",
          "line_type": "p",
          "text": "که از این امور بعضی منحرف گشته به بیهودهگویی توجه نمودهاند،"
        },
        {
          "verse": 7,
          "usfm": "1TI.1.7",
          "line_type": "p",
          "text": "و میخواهند معلمان شریعت بشوندو حال آنکه نمی فهمند آنچه میگویند و نه آنچه به تاکید اظهار مینمایند."
        },
        {
          "verse": 8,
          "usfm": "1TI.1.8",
          "line_type": "p",
          "text": "لیکن میدانیم که شریعت نیکو است اگرکسی آن را برحسب شریعت بکار برد."
        },
        {
          "verse": 9,
          "usfm": "1TI.1.9",
          "line_type": "p",
          "text": "و این بداند که شریعت بجهت عادل موضوع نمی شود، بلکه برای سرکشان و طاغیان و بیدینان وگناهکاران و ناپاکان و حرامکاران و قاتلان پدر و قاتلان مادر و قاتلان مردم"
        },
        {
          "verse": 10,
          "usfm": "1TI.1.10",
          "line_type": "p",
          "text": "و زانیان و لواطان ومردم دزدان و دروغگویان و قسم دروغ خوران وبرای هر عمل دیگری که برخلاف تعلیم صحیح باشد،"
        },
        {
          "verse": 11,
          "usfm": "1TI.1.11",
          "line_type": "p",
          "text": "برحسب انجیل جلال خدای متبارک که به من سپرده شده است."
        },
        {
          "verse": 12,
          "usfm": "1TI.1.12",
          "line_type": "p",
          "text": "و شکر میکنم خداوند خود مسیح عیسی را که مرا تقویت داد، چونکه امین شمرده، به این خدمتم ممتاز فرمود،"
        },
        {
          "verse": 13,
          "usfm": "1TI.1.13",
          "line_type": "p",
          "text": "که سابق کفرگو و مضر وسقطگو بودم، لیکن رحم یافتم از آنرو که ازجهالت در بیایمانی کردم."
        },
        {
          "verse": 14,
          "usfm": "1TI.1.14",
          "line_type": "p",
          "text": "اما فیض خداوندما بینهایت افزود باایمان و محبتی که در مسیح عیسی است."
        },
        {
          "verse": 15,
          "usfm": "1TI.1.15",
          "line_type": "p",
          "text": "این سخن امین است و لایق قبول تام که مسیح عیسی بهدنیا آمد تا گناهکاران را نجاتبخشد که من بزرگترین آنها هستم."
        },
        {
          "verse": 16,
          "usfm": "1TI.1.16",
          "line_type": "p",
          "text": "بلکه از این جهت بر من رحم شد تا اول درمن، مسیح عیسی کمال حلم را ظاهر سازد تا آنانی را که بجهت حیات جاودانی به وی ایمان خواهندآورد، نمونه باشم."
        },
        {
          "verse": 17,
          "usfm": "1TI.1.17",
          "line_type": "p",
          "text": "باری پادشاه سرمدی و باقی ونادیده را، خدای حکیم وحید را اکرام و جلال تاابدالاباد باد. آمین."
        },
        {
          "verse": 18,
          "usfm": "1TI.1.18",
          "line_type": "p",
          "text": "ای فرزند تیموتاوس، این وصیت را به تو می سپارم برحسب نبوتهایی که سابق بر تو شد تادر آنها جنگ نیکو کنی،"
        },
        {
          "verse": 19,
          "usfm": "1TI.1.19",
          "line_type": "p",
          "text": "و ایمان و ضمیرصالح را نگاه داری که بعضی این را از خود دورانداخته، مر ایمان را شکسته کشتی شدند."
        },
        {
          "verse": 20,
          "usfm": "1TI.1.20",
          "line_type": "p",
          "text": "که از آن جمله هیمیناوس و اسکندر میباشند که ایشان را به شیطان سپردم تا تادیب شده، دیگرکفر نگویند."
        }
      ],
      "verse_count": 20,
