{
  "book_id": "1TI",
  "book_name_en": "1 Timothy",
  "book_name_fa": "اول تیموتائوس",
  "testament": "NT",
  "version_id": 136,
  "version_abbr": "POV",
  "version_name": "ترجمۀ قدیم",
