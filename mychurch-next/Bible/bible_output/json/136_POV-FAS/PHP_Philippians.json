    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 4,
      "chapter_usfm": "PHP.4",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.4.1",
          "line_type": "p",
          "text": "بنابراین، ای بردران عزیز و مورد اشتیاق من و شادی و تاج من، به همینطور در خداونداستوار باشیدای عزیزان."
        },
        {
          "verse": 2,
          "usfm": "PHP.4.2",
          "line_type": "p",
          "text": "از افودیه استدعا دارم و به سنتیخی التماس دارم که در خداوند یک رای باشند."
        },
        {
          "verse": 3,
          "usfm": "PHP.4.3",
          "line_type": "p",
          "text": "و از تو نیزای همقطار خالص خواهش میکنم که ایشان را امداد کنی، زیرا درجهاد انجیل با من شریک میبودند با اکلیمنتس نیز و سایر همکاران من که نام ایشان در دفترحیاتاست."
        },
        {
          "verse": 4,
          "usfm": "PHP.4.4",
          "line_type": "p",
          "text": "در خداوند دائم شاد باشید. و باز میگویم شاد باشید."
        },
        {
          "verse": 5,
          "usfm": "PHP.4.5",
          "line_type": "p",
          "text": "اعتدال شما بر جمیع مردم معروف بشود. خداوند نزدیک است."
        },
        {
          "verse": 6,
          "usfm": "PHP.4.6",
          "line_type": "p",
          "text": "برای هیچچیزاندیشه مکنید، بلکه در هرچیز با صلات و دعا باشکرگزاری مسولات خود را به خدا عرض کنید."
        },
        {
          "verse": 7,
          "usfm": "PHP.4.7",
          "line_type": "p",
          "text": "و سلامتی خدا که فوق از تمامی عقل است، دلها و ذهنهای شما را در مسیح عیسی نگاه خواهد داشت."
        },
        {
          "verse": 8,
          "usfm": "PHP.4.8",
          "line_type": "p",
          "text": "خلاصهای برادران، هرچه راست باشد وهرچه مجید و هرچه عادل و هرچه پاک و هرچه جمیل و هرچه نیک نام است و هر فضیلت و هرمدحی که بوده باشد، در آنها تفکر کنید."
        },
        {
          "verse": 9,
          "usfm": "PHP.4.9",
          "line_type": "p",
          "text": "و آنچه در من آموخته و پذیرفته و شنیده و دیدهاید، آنهارا بعمل آرید، و خدای سلامتی با شما خواهدبود."
        },
        {
          "verse": 10,
          "usfm": "PHP.4.10",
          "line_type": "p",
          "text": "و در خداوند بسیار شاد گردیدم که الان آخر، فکر شما برای من شکوفه آورد و در این نیزتفکر میکردید، لیکن فرصت نیافتید."
        },
        {
          "verse": 11,
          "usfm": "PHP.4.11",
          "line_type": "p",
          "text": "نه آنکه درباره احتیاج سخن میگویم، زیرا که آموختهام که در هر حالتی که باشم، قناعت کنم."
        },
        {
          "verse": 12,
          "usfm": "PHP.4.12",
          "line_type": "p",
          "text": "و ذلت رامی دانم و دولتمندی را هم میدانم، در هرصورت و در همهچیز، سیری و گرسنگی ودولتنمدی و افلاس را یاد گرفتهام."
        },
        {
          "verse": 13,
          "usfm": "PHP.4.13",
          "line_type": "p",
          "text": "قوت هرچیز را دارم در مسیح که مرا تقویت میبخشد."
        },
        {
          "verse": 14,
          "usfm": "PHP.4.14",
          "line_type": "p",
          "text": "لیکن نیکویی کردید که در تنگی من شریک شدید."
        },
        {
          "verse": 15,
          "usfm": "PHP.4.15",
          "line_type": "p",
          "text": "اماای فیلیپیان شما هم آگاهید که درابتدای انجیل، چون از مکادونیه روانه شدم، هیچ کلیسا در امر دادن و گرفتن با من شراکت نکرد جزشما و بس."
        },
        {
          "verse": 16,
          "usfm": "PHP.4.16",
          "line_type": "p",
          "text": "زیرا که در تسالونیکی هم یک دودفعه برای احتیاج من فرستادید."
        },
        {
          "verse": 17,
          "usfm": "PHP.4.17",
          "line_type": "p",
          "text": "نه آنکه طالب بخشش باشم، بلکه طالب ثمری هستم که به حساب شما بیفزاید."
        },
        {
          "verse": 18,
          "usfm": "PHP.4.18",
          "line_type": "p",
          "text": "ولی همهچیز بلکه بیشتر از کفایت دارم. پر گشتهام چونکه هدایای شما را از اپفردتس یافتهام که عطر خوشبوی و قربانی مقبول و پسندیده خداست."
        },
        {
          "verse": 19,
          "usfm": "PHP.4.19",
          "line_type": "p",
          "text": "اماخدای من همه احتیاجات شما را برحسب دولت خود در جلال در مسیح عیسی رفع خواهد نمود."
        },
        {
          "verse": 20,
          "usfm": "PHP.4.20",
          "line_type": "p",
          "text": "و خدا و پدر ما را تا ابدالابادجلال باد. آمین."
        },
        {
          "verse": 21,
          "usfm": "PHP.4.21",
          "line_type": "p",
          "text": "هر مقدس را در مسیح عیسی سلام برسانید. و برادرانی که با من میباشند به شماسلام میفرستند."
        },
        {
          "verse": 22,
          "usfm": "PHP.4.22",
          "line_type": "p",
          "text": "جمیع مقدسان به شما سلام میرسانند، علی الخصوص آنانی که از اهل خانه قیصر هستند."
        }
      ],
