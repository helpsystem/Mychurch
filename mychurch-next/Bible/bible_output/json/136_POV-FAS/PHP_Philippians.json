  "chapters": [
    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 1,
      "chapter_usfm": "PHP.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.1.1",
          "line_type": "p",
          "text": "پولس و تیموتاوس، غلامان عیسی مسیح، به همه مقدسین در مسیح عیسی که درفیلپی میباشند با اسقفان و شماسان."
        },
        {
          "verse": 2,
          "usfm": "PHP.1.2",
          "line_type": "p",
          "text": "فیض و سلامتی از جانب پدر ما خدا وعیسی مسیح خداوند بر شما باد."
        },
        {
          "verse": 3,
          "usfm": "PHP.1.3",
          "line_type": "p",
          "text": "در تمامی یادگاری شما خدای خود را شکرمی گذارم،"
        },
        {
          "verse": 4,
          "usfm": "PHP.1.4",
          "line_type": "p",
          "text": "و پیوسته در هر دعای خود برای جمیع شما به خوشی دعا میکنم،"
        },
        {
          "verse": 5,
          "usfm": "PHP.1.5",
          "line_type": "p",
          "text": "بهسبب مشارکت شما برای انجیل از روز اول تا به حال."
        },
        {
          "verse": 6,
          "usfm": "PHP.1.6",
          "line_type": "p",
          "text": "چونکه به این اعتماد دارم که او که عمل نیکو رادر شما شروع کرد، آن را تا روز عیسی مسیح بهکمال خواهد رسانید."
        },
        {
          "verse": 7,
          "usfm": "PHP.1.7",
          "line_type": "p",
          "text": "چنانکه مرا سزاوار است که درباره همه شما همین فکر کنم زیرا که شما رادر دل خود میدارم که در زنجیرهای من و درحجت و اثبات انجیل همه شما با من شریک دراین نعمت هستید."
        },
        {
          "verse": 8,
          "usfm": "PHP.1.8",
          "line_type": "p",
          "text": "زیرا خدا مرا شاهد است که چقدر در احشای عیسی مسیح، مشتاق همه شماهستم."
        },
        {
          "verse": 9,
          "usfm": "PHP.1.9",
          "line_type": "p",
          "text": "و برای این دعا میکنم تا محبت شما درمعرفت و کمال فهم بسیار افزونتر شود."
        },
        {
          "verse": 10,
          "usfm": "PHP.1.10",
          "line_type": "p",
          "text": "تاچیزهای بهتر را برگزینید و در روز مسیح بیغش و بیلغزش باشید،"
        },
        {
          "verse": 11,
          "usfm": "PHP.1.11",
          "line_type": "p",
          "text": "و پر شوید از میوه عدالت که بوسیله عیسی مسیح برای تمجید و حمدخداست."
        },
        {
          "verse": 12,
          "usfm": "PHP.1.12",
          "line_type": "p",
          "text": "اماای برادران، میخواهم شما بدانید که آنچه بر من واقع گشت، برعکس به ترقی انجیل انجامید،"
        },
        {
          "verse": 13,
          "usfm": "PHP.1.13",
          "line_type": "p",
          "text": "بحدی که زنجیرهای من آشکارا شددر مسیح در تمام فوج خاص و به همه دیگران."
        },
        {
          "verse": 14,
          "usfm": "PHP.1.14",
          "line_type": "p",
          "text": "و اکثر از برادران در خداوند از زنجیرهای من اعتماد به هم رسانیده، بیشتر جرات میکنند که کلام خدا را بیترس بگویند."
        },
        {
          "verse": 15,
          "usfm": "PHP.1.15",
          "line_type": "p",
          "text": "اما بعضی ازحسد و نزاع به مسیح موعظه میکنند، ولی بعضی هم از خشنودی."
        },
        {
          "verse": 16,
          "usfm": "PHP.1.16",
          "line_type": "p",
          "text": "اما آنان از تعصب نه ازاخلاص به مسیح اعلام میکنند و گمان میبرندکه به زنجیرهای من زحمت میافزایند."
        },
        {
          "verse": 17,
          "usfm": "PHP.1.17",
          "line_type": "p",
          "text": "ولی اینان از راه محبت، چونکه میدانند که من بجهت حمایت انجیل معین شدهام."
        },
        {
          "verse": 18,
          "usfm": "PHP.1.18",
          "line_type": "p",
          "text": "پس چه؟ جز اینکه به هر صورت، خواه به بهانه و خواه به راستی، به مسیح موعظه میشود واز این شادمانم بلکه شادی هم خواهم کرد،"
        },
        {
          "verse": 19,
          "usfm": "PHP.1.19",
          "line_type": "p",
          "text": "زیرا میدانم که به نجات من خواهد انجامیدبوسیله دعای شما و تایید روح عیسی مسیح،"
        },
        {
          "verse": 20,
          "usfm": "PHP.1.20",
          "line_type": "p",
          "text": "برحسب انتظار و امید من که در هیچچیزخجالت نخواهم کشید، بلکه در کمال دلیری، چنانکه همیشه، الان نیز مسیح در بدن من جلال خواهد یافت، خواه در حیات و خواه در موت."
        },
        {
          "verse": 21,
          "usfm": "PHP.1.21",
          "line_type": "p",
          "text": "زیرا که مرا زیستن مسیح است و مردن نفع."
        },
        {
          "verse": 22,
          "usfm": "PHP.1.22",
          "line_type": "p",
          "text": "و لیکن اگر زیستن در جسم، همان ثمر کار من است، پس نمی دانم کدام را اختیار کنم."
        },
        {
          "verse": 23,
          "usfm": "PHP.1.23",
          "line_type": "p",
          "text": "زیرادر میان این دو سخت گرفتار هستم، چونکه خواهش دارم که رحلت کنم و با مسیح باشم، زیرااین بسیار بهتر است."
        },
        {
          "verse": 24,
          "usfm": "PHP.1.24",
          "line_type": "p",
          "text": "لیکن در جسم ماندن برای شما لازمتر است."
        },
        {
          "verse": 25,
          "usfm": "PHP.1.25",
          "line_type": "p",
          "text": "و چون این اعتماد را دارم، میدانم که خواهم ماند و نزد همه شما توقف خواهم نمود بجهت ترقی و خوشی ایمان شما،"
        },
        {
          "verse": 26,
          "usfm": "PHP.1.26",
          "line_type": "p",
          "text": "تا فخر شما در مسیح عیسی در من افزوده شودبوسیله آمدن من بار دیگر نزد شما."
        },
        {
          "verse": 27,
          "usfm": "PHP.1.27",
          "line_type": "p",
          "text": "باری بطور شایسته انجیل مسیح رفتارنمایید تا خواه آیم و شما را بینم و خواه غایب باشم، احوال شما را بشنوم که به یک روح برقرارید و به یک نفس برای ایمان انجیل مجاهده میکنید."
        },
        {
          "verse": 28,
          "usfm": "PHP.1.28",
          "line_type": "p",
          "text": "و در هیچ امری از دشمنان ترسان نیستید که همین برای ایشان دلیل هلاکت است، اما شما را دلیل نجات و این از خداست."
        },
        {
          "verse": 29,
          "usfm": "PHP.1.29",
          "line_type": "p",
          "text": "زیراکه به شما عطا شد بهخاطر مسیح نه فقط ایمان آوردن به او بلکه زحمت کشیدن هم برای او. وشما را همان مجاهده است که در من دیدید و الان هم میشنوید که در من است."
        }
      ],
