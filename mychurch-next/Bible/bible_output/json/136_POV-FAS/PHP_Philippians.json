    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 3,
      "chapter_usfm": "PHP.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.3.1",
          "line_type": "p",
          "text": "خلاصهای برادران من، در خداوند خوش باشید. همان مطالب را به شما نوشتن بر من سنگین نیست و ایمنی شما است."
        },
        {
          "verse": 2,
          "usfm": "PHP.3.2",
          "line_type": "p",
          "text": "از سگهاباحذر باشید. از عاملان شریر احتراز نمایید. ازمقطوعان بپرهیزید."
        },
        {
          "verse": 3,
          "usfm": "PHP.3.3",
          "line_type": "p",
          "text": "زیرا مختونان ما هستیم که خدا را در روح عبادت میکنیم و به مسیح عیسی فخر میکنیم و بر جسم اعتماد نداریم."
        },
        {
          "verse": 4,
          "usfm": "PHP.3.4",
          "line_type": "p",
          "text": "هرچندمرا در جسم نیز اعتماد است. اگر کسی دیگرگمان برد که در جسم اعتماد دارد، من بیشتر."
        },
        {
          "verse": 5,
          "usfm": "PHP.3.5",
          "line_type": "p",
          "text": "روز هشتم مختون شده و از قبیله اسرائیل، ازسبط بنیامین، عبرانی از عبرانیان، از جهت شریعت فریسی،"
        },
        {
          "verse": 6,
          "usfm": "PHP.3.6",
          "line_type": "p",
          "text": "از جهت غیرت جفا کننده برکلیسا، از جهت عدالت شریعتی، بیعیب."
        },
        {
          "verse": 7,
          "usfm": "PHP.3.7",
          "line_type": "p",
          "text": "اما آنچه مرا سود میبود، آن را بهخاطرمسیح زیان دانستم."
        },
        {
          "verse": 8,
          "usfm": "PHP.3.8",
          "line_type": "p",
          "text": "بلکه همهچیز را نیز بهسبب فضیلت معرفت خداوند خود مسیح عیسی زیان میدانم که بخاطر او همهچیز را زیان کردم وفضله شمردم تا مسیح را دریابم."
        },
        {
          "verse": 9,
          "usfm": "PHP.3.9",
          "line_type": "p",
          "text": "و در وی یافت شوم نه با عدالت خود که شریعت است، بلکه با آن که بوسیله ایمان مسیح میشود، یعنی عدالتی که از خدا بر ایمان است."
        },
        {
          "verse": 10,
          "usfm": "PHP.3.10",
          "line_type": "p",
          "text": "و تا او را و قوت قیامت وی را و شراکت در رنجهای وی را بشناسم و باموت او مشابه گردم."
        },
        {
          "verse": 11,
          "usfm": "PHP.3.11",
          "line_type": "p",
          "text": "مگر به هر وجه به قیامت از مردگان برسم."
        },
        {
          "verse": 12,
          "usfm": "PHP.3.12",
          "line_type": "p",
          "text": "نه اینکه تا به حال به چنگ آورده یا تابحال کامل شده باشم، ولی درپی آن میکوشم بلکه شاید آن را بدست آورم که برای آن مسیح نیز مرا بدست آورد."
        },
        {
          "verse": 13,
          "usfm": "PHP.3.13",
          "line_type": "p",
          "text": "ای برادران، گمان نمی برم که من بدست آوردهام؛ لیکن یک چیز میکنم که آنچه در عقب است فراموش کرده و به سوی آنچه درپیش است، خویشتن را کشیده،"
        },
        {
          "verse": 14,
          "usfm": "PHP.3.14",
          "line_type": "p",
          "text": "درپی مقصدمی کوشم بجهت انعام دعوت بلند خدا که درمسیح عیسی است."
        },
        {
          "verse": 15,
          "usfm": "PHP.3.15",
          "line_type": "p",
          "text": "پس جمیع ما که کامل هستیم، این فکر داشته باشیم و اگر فی الجمله فکردیگر دارید، خدا این را هم بر شما کشف خواهدفرمود."
        },
        {
          "verse": 16,
          "usfm": "PHP.3.16",
          "line_type": "p",
          "text": "اما به هر مقامی که رسیدهایم، به همان قانون رفتار باید کرد."
        },
        {
          "verse": 17,
          "usfm": "PHP.3.17",
          "line_type": "p",
          "text": "ای برادران، با هم به من اقتدا نمایید وملاحظه کنید آنانی را که بحسب نمونهای که در مادارید، رفتار میکنند."
        },
        {
          "verse": 18,
          "usfm": "PHP.3.18",
          "line_type": "p",
          "text": "زیرا که بسیاری رفتارمی نمایند که ذکر ایشان را بارها برای شما کردهام و حال نیز با گریه میکنم که دشمنان صلیب مسیح میباشند،"
        },
        {
          "verse": 19,
          "usfm": "PHP.3.19",
          "line_type": "p",
          "text": "که انجام ایشان هلاکت است وخدای ایشان شکم ایشان و فخر ایشان در ننگ ایشان، و چیزهای دنیوی را اندیشه میکنند."
        },
        {
          "verse": 20,
          "usfm": "PHP.3.20",
          "line_type": "p",
          "text": "اما وطن ما در آسمان است که از آنجا نیزنجاتدهنده یعنی عیسی مسیح خداوند را انتظارمی کشیم،"
        },
        {
          "verse": 21,
          "usfm": "PHP.3.21",
          "line_type": "p",
          "text": "که شکل جسد ذلیل ما را تبدیل خواهد نمود تا به صورت جسد مجید او مصورشود، برحسب عمل قوت خود که همهچیز رامطیع خود بگرداند."
        }
      ],
