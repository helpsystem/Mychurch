    },
    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 2,
      "chapter_usfm": "PHP.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.2.1",
          "line_type": "p",
          "text": "بنابراین اگر نصیحتی در مسیح، یا تسلی محبت، یا شراکت در روح، یا شفقت ورحمت هست،"
        },
        {
          "verse": 2,
          "usfm": "PHP.2.2",
          "line_type": "p",
          "text": "پس خوشی مرا کامل گردانید تابا هم یک فکر کنید و همان محبت نموده، یک دل بشوید و یک فکر داشته باشید."
        },
        {
          "verse": 3,
          "usfm": "PHP.2.3",
          "line_type": "p",
          "text": "و هیچچیز را ازراه تعصب و عجب مکنید، بلکه با فروتنی دیگران را از خود بهتر بدانید."
        },
        {
          "verse": 4,
          "usfm": "PHP.2.4",
          "line_type": "p",
          "text": "و هریک از شما ملاحظه کارهای خود را نکند، بلکه هرکدام کارهای دیگران را نیز."
        },
        {
          "verse": 5,
          "usfm": "PHP.2.5",
          "line_type": "p",
          "text": "پس همین فکر در شما باشد که در مسیح عیسی نیز بود"
        },
        {
          "verse": 6,
          "usfm": "PHP.2.6",
          "line_type": "p",
          "text": "که چون در صورت خدا بود، باخدا برابر بودن را غنیمت نشمرد،"
        },
        {
          "verse": 7,
          "usfm": "PHP.2.7",
          "line_type": "p",
          "text": "لیکن خود راخالی کرده، صورت غلام را پذیرفت و درشباهت مردمان شد؛"
        },
        {
          "verse": 8,
          "usfm": "PHP.2.8",
          "line_type": "p",
          "text": "و چون در شکل انسان یافت شد، خویشتن را فروتن ساخت و تا به موت بلکه تا به موت صلیب مطیع گردید."
        },
        {
          "verse": 9,
          "usfm": "PHP.2.9",
          "line_type": "p",
          "text": "از این جهت خدا نیز او را بغایت سرافراز نمود و نامی را که فوق از جمیع نامها است، بدو بخشید."
        },
        {
          "verse": 10,
          "usfm": "PHP.2.10",
          "line_type": "p",
          "text": "تا به نام عیسی هر زانویی از آنچه در آسمان و بر زمین وزیر زمین است خم شود،"
        },
        {
          "verse": 11,
          "usfm": "PHP.2.11",
          "line_type": "p",
          "text": "و هر زبانی اقرار کندکه عیسی مسیح، خداوند است برای تمجیدخدای پدر."
        },
        {
          "verse": 12,
          "usfm": "PHP.2.12",
          "line_type": "p",
          "text": "پسای عزیزان من چنانکه همیشه مطیع میبودید، نه در حضور من فقط بلکه بسیار زیادترالان وقتی که غایبم، نجات خود را به ترس و لرزبعمل آورید."
        },
        {
          "verse": 13,
          "usfm": "PHP.2.13",
          "line_type": "p",
          "text": "زیرا خداست که در شمابرحسب رضامندی خود، هم اراده و هم فعل رابعمل ایجاد میکند."
        },
        {
          "verse": 14,
          "usfm": "PHP.2.14",
          "line_type": "p",
          "text": "و هرکاری را بدون همهمه و مجادله بکنید،"
        },
        {
          "verse": 15,
          "usfm": "PHP.2.15",
          "line_type": "p",
          "text": "تا بیعیب و ساده دل و فرزندان خدا بیملامت باشید، در میان قومی کج رو و گردنکش که در آن میان چون نیرها درجهان میدرخشید،"
        },
        {
          "verse": 16,
          "usfm": "PHP.2.16",
          "line_type": "p",
          "text": "و کلام حیات رابرمی افرازید، بجهت فخر من در روز مسیح تاآنکه عبث ندویده و عبث زحمت نکشیده باشم."
        },
        {
          "verse": 17,
          "usfm": "PHP.2.17",
          "line_type": "p",
          "text": "بلکه هرگاه بر قربانی و خدمت ایمان شماریخته شوم، شادمان هستم و با همه شما شادی میکنم."
        },
        {
          "verse": 18,
          "usfm": "PHP.2.18",
          "line_type": "p",
          "text": "و همچنین شما نیز شادمان هستید و بامن شادی میکنید."
        },
        {
          "verse": 19,
          "usfm": "PHP.2.19",
          "line_type": "p",
          "text": "و در عیسی خداوند امیدوارم که تیموتاوس را به زودی نزد شما بفرستم تامن نیز ازاحوال شما مطلع شده، تازه روح گردم."
        },
        {
          "verse": 20,
          "usfm": "PHP.2.20",
          "line_type": "p",
          "text": "زیراکسی دیگر را همدل ندارم که به اخلاص درباره شما اندیشد."
        },
        {
          "verse": 21,
          "usfm": "PHP.2.21",
          "line_type": "p",
          "text": "زانرو که همه نفع خود رامی طلبند، نه امور عیسی مسیح را."
        },
        {
          "verse": 22,
          "usfm": "PHP.2.22",
          "line_type": "p",
          "text": "اما دلیل اورا میدانید، زیرا چنانکه فرزند پدر را خدمت میکند، او با من برای انجیل خدمت کرده است."
        },
        {
          "verse": 23,
          "usfm": "PHP.2.23",
          "line_type": "p",
          "text": "پس امیدوارم که چون دیدم کار من چطورمی شود، او را بیدرنگ بفرستم."
        },
        {
          "verse": 24,
          "usfm": "PHP.2.24",
          "line_type": "p",
          "text": "اما در خداونداعتماد دارم که خود هم به زودی بیایم."
        },
        {
          "verse": 25,
          "usfm": "PHP.2.25",
          "line_type": "p",
          "text": "ولی لازم دانستم که اپفردتس را به سوی شما روانه نمایم که مرا برادر و همکار و همجنگ میباشد، اما شما را رسول و خادم حاجت من."
        },
        {
          "verse": 26,
          "usfm": "PHP.2.26",
          "line_type": "p",
          "text": "زیرا که مشتاق همه شما بود و غمگین شد ازاینکه شنیده بودید که او بیمار شده بود."
        },
        {
          "verse": 27,
          "usfm": "PHP.2.27",
          "line_type": "p",
          "text": "وفی الواقع بیمار و مشرف بر موت بود، لیکن خدا بروی ترحم فرمود و نه بر او فقط بلکه بر من نیز تامرا غمی بر غم نباشد."
        },
        {
          "verse": 28,
          "usfm": "PHP.2.28",
          "line_type": "p",
          "text": "پس به سعی بیشتر او راروانه نمودم تا از دیدنش باز شاد شوید و حزن من کمتر شود."
        },
        {
          "verse": 29,
          "usfm": "PHP.2.29",
          "line_type": "p",
          "text": "پس او را در خداوند با کمال خوشی بپذیرید و چنین کسان را محترم بدارید،"
        },
        {
          "verse": 30,
          "usfm": "PHP.2.30",
          "line_type": "p",
          "text": "زیرا در کار مسیح مشرف بر موت شد و جان خود را به خطر انداخت تا نقص خدمت شما را برای من بهکمال رساند."
        }
      ],
