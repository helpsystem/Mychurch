    },
    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 2,
      "chapter_usfm": "COL.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.2.1",
          "line_type": "p",
          "text": "زیرا میخواهم شما آگاه باشید که مرا چه نوع اجتهاد است برای شما و اهل لاودکیه و آنانی که صورت مرا در جسم ندیدهاند،"
        },
        {
          "verse": 2,
          "usfm": "COL.2.2",
          "line_type": "p",
          "text": "تا دلهای ایشان تسلی یابد و ایشان در محبت پیوند شده، به دولت یقین فهم تمام و به معرفت سر خدا برسند؛"
        },
        {
          "verse": 3,
          "usfm": "COL.2.3",
          "line_type": "p",
          "text": "یعنی سر مسیح که در وی تمامی خزاین حکمت و علم مخفی است."
        },
        {
          "verse": 4,
          "usfm": "COL.2.4",
          "line_type": "p",
          "text": "امااین را میگویم تا هیچکس شما را به سخنان دلاویز اغوا نکند،"
        },
        {
          "verse": 5,
          "usfm": "COL.2.5",
          "line_type": "p",
          "text": "زیرا که هرچند در جسم غایبم لیکن در روح با شما بوده، شادی میکنم ونظم و استقامت ایمانتان را در مسیح نظاره میکنم."
        },
        {
          "verse": 6,
          "usfm": "COL.2.6",
          "line_type": "p",
          "text": "پس چنانکه مسیح عیسی خداوند راپذیرفتید، در وی رفتار نمایید،"
        },
        {
          "verse": 7,
          "usfm": "COL.2.7",
          "line_type": "p",
          "text": "که در او ریشه کرده و بنا شده و در ایمان راسخ گشتهاید، بطوری که تعلیم یافتهاید و در آن شکرگزاری بسیارمی نمایید."
        },
        {
          "verse": 8,
          "usfm": "COL.2.8",
          "line_type": "p",
          "text": "باخبر باشید که کسی شما را نرباید به فلسفه و مکر باطل، برحسب تقلید مردم وبرحسب اصول دنیوی نه برحسب مسیح،"
        },
        {
          "verse": 9,
          "usfm": "COL.2.9",
          "line_type": "p",
          "text": "که دروی از جهت جسم، تمامی پری الوهیت ساکن است."
        },
        {
          "verse": 10,
          "usfm": "COL.2.10",
          "line_type": "p",
          "text": "و شما در وی تکمیل شدهاید که سرتمامی ریاست و قدرت است."
        },
        {
          "verse": 11,
          "usfm": "COL.2.11",
          "line_type": "p",
          "text": "و در وی مختون شدهاید، به ختنه ناساخته بهدست یعنی بیرون کردن بدن جسمانی، بوسیله اختتان مسیح."
        },
        {
          "verse": 12,
          "usfm": "COL.2.12",
          "line_type": "p",
          "text": "و با وی در تعمید مدفون گشتید که در آن هم برخیزانیده شدید به ایمان بر عمل خدا که او را ازمردگان برخیزانید."
        },
        {
          "verse": 13,
          "usfm": "COL.2.13",
          "line_type": "p",
          "text": "و شما را که در خطایا ونامختونی جسم خود مرده بودید، با او زنده گردانید چونکه همه خطایای شما را آمرزید،"
        },
        {
          "verse": 14,
          "usfm": "COL.2.14",
          "line_type": "p",
          "text": "و آن دستخطی را که ضد ما و مشتمل برفرایض و به خلاف ما بود محو ساخت و آن را به صلیب خود میخ زده از میان برداشت."
        },
        {
          "verse": 15,
          "usfm": "COL.2.15",
          "line_type": "p",
          "text": "و ازخویشتن ریاسات و قوات را بیرون کرده، آنها راعلانیه آشکار نمود، چون در آن بر آنها ظفریافت."
        },
        {
          "verse": 16,
          "usfm": "COL.2.16",
          "line_type": "p",
          "text": "پس کسی درباره خوردن و نوشیدن ودرباره عید و هلال و سبت بر شما حکم نکند،"
        },
        {
          "verse": 17,
          "usfm": "COL.2.17",
          "line_type": "p",
          "text": "زیرا که اینها سایه چیزهای آینده است، لیکن بدن از آن مسیح است."
        },
        {
          "verse": 18,
          "usfm": "COL.2.18",
          "line_type": "p",
          "text": "و کسی انعام شما رانرباید از رغبت به فروتنی و عبادت فرشتگان ومداخلت در اموری که دیده است که از ذهن جسمانی خود بیجا مغرور شده است؛"
        },
        {
          "verse": 19,
          "usfm": "COL.2.19",
          "line_type": "p",
          "text": "و بهسر متمسک نشده که از آن تمامی بدن به توسطمفاصل و بندها مدد یافته و با هم پیوند شده، نمومی کند به نموی که از خداست."
        },
        {
          "verse": 20,
          "usfm": "COL.2.20",
          "line_type": "p",
          "text": "چونکه بامسیح از اصول دنیوی مردید، چگونه است که مثل زندگان در دنیا بر شما فرایض نهاده میشود؟"
        },
        {
          "verse": 21,
          "usfm": "COL.2.21",
          "line_type": "p",
          "text": "که لمس مکن و مچش بلکه دست مگذار!"
        },
        {
          "verse": 22,
          "usfm": "COL.2.22",
          "line_type": "p",
          "text": "(که همه اینها محض استعمال فاسد میشود)برحسب تقالید و تعالیم مردم،"
        },
        {
          "verse": 23,
          "usfm": "COL.2.23",
          "line_type": "p",
          "text": "که چنین چیزهاهرچند در عبادت نافله و فروتنی و آزار بدن صورت حکمت دارد، ولی فایدهای برای رفع تن پروری ندارد."
        }
      ],
