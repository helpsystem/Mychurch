    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 3,
      "chapter_usfm": "COL.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.3.1",
          "line_type": "p",
          "text": "پس چون با مسیح برخیزانیده شدید، آنچه را که در بالا است بطلبید در آنجایی که مسیح است، بهدست راست خدا نشسته."
        },
        {
          "verse": 2,
          "usfm": "COL.3.2",
          "line_type": "p",
          "text": "درآنچه بالا است تفکر کنید، نه در آنچه بر زمین است."
        },
        {
          "verse": 3,
          "usfm": "COL.3.3",
          "line_type": "p",
          "text": "زیرا که مردید و زندگی شما با مسیح در خدا مخفی است."
        },
        {
          "verse": 4,
          "usfm": "COL.3.4",
          "line_type": "p",
          "text": "چون مسیح که زندگی مااست ظاهر شود آنگاه شما هم با وی در جلال ظاهر خواهید شد."
        },
        {
          "verse": 5,
          "usfm": "COL.3.5",
          "line_type": "p",
          "text": "پس اعضای خود را که بر زمین است مقتول سازید، زنا و ناپاکی و هوی و هوس و شهوت قبیح و طمع که بتپرستی است"
        },
        {
          "verse": 6,
          "usfm": "COL.3.6",
          "line_type": "p",
          "text": "که بهسبب اینهاغضب خدا بر ابنای معصیت وارد میآید."
        },
        {
          "verse": 7,
          "usfm": "COL.3.7",
          "line_type": "p",
          "text": "که شما نیز سابق در اینها رفتار میکردید، هنگامی که در آنها زیست مینمودید."
        },
        {
          "verse": 8,
          "usfm": "COL.3.8",
          "line_type": "p",
          "text": "لیکن الحال شماهمه را ترک کنید، یعنی خشم و غیظ و بدخویی وبدگویی و فحش را از زبان خود."
        },
        {
          "verse": 9,
          "usfm": "COL.3.9",
          "line_type": "p",
          "text": "به یکدیگردروغ مگویید، چونکه انسانیت کهنه را با اعمالش از خود بیرون کردهاید،"
        },
        {
          "verse": 10,
          "usfm": "COL.3.10",
          "line_type": "p",
          "text": "و تازه را پوشیدهاید که به صورت خالق خویش تا به معرفت کامل، تازه میشود،"
        },
        {
          "verse": 11,
          "usfm": "COL.3.11",
          "line_type": "p",
          "text": "که در آن نه یونانی است، نه یهود، نه ختنه، نه نامختونی، نه بربری، نه سکیتی، نه غلام و نه آزاد، بلکه مسیح همه و در همه است."
        },
        {
          "verse": 12,
          "usfm": "COL.3.12",
          "line_type": "p",
          "text": "پس مانند برگزیدگان مقدس و محبوب خدا احشای رحمت و مهربانی و تواضع و تحمل و حلم را بپوشید؛"
        },
        {
          "verse": 13,
          "usfm": "COL.3.13",
          "line_type": "p",
          "text": "و متحمل یکدیگر شده، همدیگر را عفو کنید هرگاه بر دیگری ادعایی داشته باشید؛ چنانکه مسیح شما را آمرزید، شمانیز چنین کنید."
        },
        {
          "verse": 14,
          "usfm": "COL.3.14",
          "line_type": "p",
          "text": "و بر این همه محبت را که کمربند کمال است بپوشید."
        },
        {
          "verse": 15,
          "usfm": "COL.3.15",
          "line_type": "p",
          "text": "و سلامتی خدا دردلهای شما مسلط باشد که به آن هم در یک بدن خوانده شدهاید و شاکر باشید."
        },
        {
          "verse": 16,
          "usfm": "COL.3.16",
          "line_type": "p",
          "text": "کلام مسیح درشما به دولتمندی و بهکمال حکمت ساکن بشودو یکدیگر را تعلیم و نصیحت کنید به مزامیر وتسبیحات و سرودهای روحانی و با فیض در دلهای خود خدا را بسرایید."
        },
        {
          "verse": 17,
          "usfm": "COL.3.17",
          "line_type": "p",
          "text": "و آنچه کنید درقول و فعل، همه را به نام عیسی خداوند بکنید وخدای پدر را بوسیله او شکر کنید."
        },
        {
          "verse": 18,
          "usfm": "COL.3.18",
          "line_type": "p",
          "text": "ای زنان، شوهران خود را اطاعت نمایید، چنانکه در خداوند میشاید."
        },
        {
          "verse": 19,
          "usfm": "COL.3.19",
          "line_type": "p",
          "text": "ای شوهران، زوجه های خود را محبت نمایید و با ایشان تلخی مکنید."
        },
        {
          "verse": 20,
          "usfm": "COL.3.20",
          "line_type": "p",
          "text": "ای فرزندان، والدین خود را در همهچیز اطاعت کنید زیرا که این پسندیده است درخداوند."
        },
        {
          "verse": 21,
          "usfm": "COL.3.21",
          "line_type": "p",
          "text": "ای پدران، فرزندان خود را خشمگین مسازید، مبادا شکسته دل شوند."
        },
        {
          "verse": 22,
          "usfm": "COL.3.22",
          "line_type": "p",
          "text": "ای غلامان، آقایان جسمانی خود را در هر چیز اطاعت کنید، نه به خدمت حضور مثل جویندگان رضامندی مردم، بلکه به اخلاص قلب و از خداوند بترسید."
        },
        {
          "verse": 23,
          "usfm": "COL.3.23",
          "line_type": "p",
          "text": "و آنچه کنید، از دل کنید بخاطر خداوند نه به بخاطر انسان."
        },
        {
          "verse": 24,
          "usfm": "COL.3.24",
          "line_type": "p",
          "text": "چون میدانید که از خداوندمکافات میراث را خواهید یافت، چونکه مسیح خداوند را بندگی میکنید."
        },
        {
          "verse": 25,
          "usfm": "COL.3.25",
          "line_type": "p",
          "text": "زیرا هرکه ظلم کند، آن ظلمی را که کرد، خواهد یافت وظاهربینی نیست."
        }
      ],
