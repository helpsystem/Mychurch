  "chapters": [
    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 1,
      "chapter_usfm": "COL.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.1.1",
          "line_type": "p",
          "text": "پولس به اراده خدا رسول مسیح عیسی وتیموتاوس برادر،"
        },
        {
          "verse": 2,
          "usfm": "COL.1.2",
          "line_type": "p",
          "text": "به مقدسان در کولسی و برادران امین، در مسیح فیض و سلامتی از جانب پدر ما خداو عیسی مسیح خداوند بر شما باد."
        },
        {
          "verse": 3,
          "usfm": "COL.1.3",
          "line_type": "p",
          "text": "خدا و پدر خداوند خود عیسی مسیح راشکر میکنیم و پیوسته برای شما دعا مینماییم،"
        },
        {
          "verse": 4,
          "usfm": "COL.1.4",
          "line_type": "p",
          "text": "چونکه ایمان شما را در مسیح عیسی و محبتی را که با جمیع مقدسان مینمایید شنیدیم،"
        },
        {
          "verse": 5,
          "usfm": "COL.1.5",
          "line_type": "p",
          "text": "بهسبب امیدی که بجهت شما در آسمان گذاشته شده است که خبر آن را در کلام راستی انجیل سابق شنیدید،"
        },
        {
          "verse": 6,
          "usfm": "COL.1.6",
          "line_type": "p",
          "text": "که به شما وارد شد چنانکه درتمامی عالم نیز و میوه میآورد و نمو میکند، چنانکه در میان شما نیز از روزی که آن را شنیدیدو فیض خدا را در راستی دانستهاید."
        },
        {
          "verse": 7,
          "usfm": "COL.1.7",
          "line_type": "p",
          "text": "چنانکه ازاپفراس تعلیم یافتید که همخدمت عزیز ما وخادم امین مسیح برای شما است."
        },
        {
          "verse": 8,
          "usfm": "COL.1.8",
          "line_type": "p",
          "text": "و او ما را نیز ازمحبت شما که در روح است خبر داد."
        },
        {
          "verse": 9,
          "usfm": "COL.1.9",
          "line_type": "p",
          "text": "و از آن جهت ما نیز از روزی که این راشنیدیم، باز نمی ایستیم از دعا کردن برای شما ومسالت نمودن تا از کمال معرفت اراده او در هرحکمت و فهم روحانی پر شوید،"
        },
        {
          "verse": 10,
          "usfm": "COL.1.10",
          "line_type": "p",
          "text": "تا شما به طریق شایسته خداوند بهکمال رضامندی رفتارنمایید و در هر عمل نیکو بار آورید و به معرفت کامل خدا نمو کنید،"
        },
        {
          "verse": 11,
          "usfm": "COL.1.11",
          "line_type": "p",
          "text": "و به اندازه توانایی جلال او به قوت تمام زورآور شوید تا صبر کامل وتحمل را با شادمانی داشته باشید؛"
        },
        {
          "verse": 12,
          "usfm": "COL.1.12",
          "line_type": "p",
          "text": "و پدر راشکر گزارید که ما را لایق بهره میراث مقدسان درنور گردانیده است،"
        },
        {
          "verse": 13,
          "usfm": "COL.1.13",
          "line_type": "p",
          "text": "و ما را از قدرت ظلمت رهانیده، به ملکوت پسر محبت خود منتقل ساخت،"
        },
        {
          "verse": 14,
          "usfm": "COL.1.14",
          "line_type": "p",
          "text": "که در وی فدیه خود یعنی آمرزش گناهان خویش را یافتهایم."
        },
        {
          "verse": 15,
          "usfm": "COL.1.15",
          "line_type": "p",
          "text": "و او صورت خدای نادیده است، نخست زاده تمامی آفریدگان."
        },
        {
          "verse": 16,
          "usfm": "COL.1.16",
          "line_type": "p",
          "text": "زیرا که در اوهمهچیز آفریده شد، آنچه در آسمان و آنچه برزمین است از چیزهای دیدنی و نادیدنی و تختهاو سلطنتها و ریاسات و قوات؛ همه بوسیله او وبرای او آفریده شد."
        },
        {
          "verse": 17,
          "usfm": "COL.1.17",
          "line_type": "p",
          "text": "و او قبل از همه است و دروی همهچیز قیام دارد."
        },
        {
          "verse": 18,
          "usfm": "COL.1.18",
          "line_type": "p",
          "text": "و او بدن یعنی کلیسا راسر است، زیرا که او ابتدا است و نخست زاده ازمردگان تا در همهچیز او مقدم شود."
        },
        {
          "verse": 19,
          "usfm": "COL.1.19",
          "line_type": "p",
          "text": "زیرا خدارضا بدین داد که تمامی پری در او ساکن شود،"
        },
        {
          "verse": 20,
          "usfm": "COL.1.20",
          "line_type": "p",
          "text": "و اینکه بوساطت او همهچیز را با خودمصالحه دهد، چونکه به خون صلیب وی سلامتی را پدید آورد. بلی بوسیله او خواه آنچه بر زمین وخواه آنچه در آسمان است."
        },
        {
          "verse": 21,
          "usfm": "COL.1.21",
          "line_type": "p",
          "text": "و شما را که سابق از نیت دل در اعمال بد خویش اجنبی و دشمن بودید، بالفعل مصالحه داده است،"
        },
        {
          "verse": 22,
          "usfm": "COL.1.22",
          "line_type": "p",
          "text": "در بدن بشری خود بوسیله موت تا شما را در حضورخود مقدس و بیعیب و بیملامت حاضر سازد،"
        },
        {
          "verse": 23,
          "usfm": "COL.1.23",
          "line_type": "p",
          "text": "به شرطی که در ایمان بنیاد نهاده و قایم بمانیدو جنبش نخورید از امید انجیل که در آن تعلیم یافتهاید و به تمامی خلقت زیر آسمان بدان موعظه شده است و من پولس خادم آن شدهام."
        },
        {
          "verse": 24,
          "usfm": "COL.1.24",
          "line_type": "p",
          "text": "الان از زحمتهای خود در راه شما شادی میکنم و نقصهای زحمات مسیح را در بدن خودبهکمال میرسانم برای بدن او که کلیسا است،"
        },
        {
          "verse": 25,
          "usfm": "COL.1.25",
          "line_type": "p",
          "text": "که من خادم آن گشتهام برحسب نظارت خداکه به من برای شما سپرده شد تا کلام خدا را بهکمال رسانم؛"
        },
        {
          "verse": 26,
          "usfm": "COL.1.26",
          "line_type": "p",
          "text": "یعنی آن سری که از دهرها وقرنها مخفی داشته شده بود، لیکن الحال به مقدسان او مکشوف گردید،"
        },
        {
          "verse": 27,
          "usfm": "COL.1.27",
          "line_type": "p",
          "text": "که خدا اراده نمودتا بشناساند که چیست دولت جلال این سر درمیان امتها که آن مسیح در شما و امید جلال است."
        },
        {
          "verse": 28,
          "usfm": "COL.1.28",
          "line_type": "p",
          "text": "و ما او را اعلان مینماییم، در حالتیکه هر شخص را تنبیه میکنیم و هر کس را به هرحکمت تعلیم میدهیم تا هرکس را کامل درمسیح عیسی حاضر سازیم."
        },
        {
          "verse": 29,
          "usfm": "COL.1.29",
          "line_type": "p",
          "text": "و برای این نیزمحنت میکشم و مجاهده مینمایم بحسب عمل او که در من به قوت عمل میکند."
        }
      ],
