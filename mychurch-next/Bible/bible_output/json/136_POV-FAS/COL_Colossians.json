    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 4,
      "chapter_usfm": "COL.4",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.4.1",
          "line_type": "p",
          "text": "ای آقایان، با غلامان خود عدل و انصاف رابهجا آرید، چونکه میدانید شما را نیزآقایی هست در آسمان."
        },
        {
          "verse": 2,
          "usfm": "COL.4.2",
          "line_type": "p",
          "text": "در دعا مواظب باشید و در آن با شکرگزاری بیدار باشید."
        },
        {
          "verse": 3,
          "usfm": "COL.4.3",
          "line_type": "p",
          "text": "و درباره ما نیز دعا کنید که خدا در کلام را به روی ما بگشاید تا سر مسیح را که بجهت آن در قید هم افتادهام بگویم،"
        },
        {
          "verse": 4,
          "usfm": "COL.4.4",
          "line_type": "p",
          "text": "و آن رابطوری که میباید تکلم کنم و مبین سازم."
        },
        {
          "verse": 5,
          "usfm": "COL.4.5",
          "line_type": "p",
          "text": "زمان را دریافته، پیش اهل خارج به حکمت رفتار کنید."
        },
        {
          "verse": 6,
          "usfm": "COL.4.6",
          "line_type": "p",
          "text": "گفتگوی شما همیشه با فیض باشد و اصلاح شده به نمک، تا بدانید هرکس را چگونه جواب باید داد."
        },
        {
          "verse": 7,
          "usfm": "COL.4.7",
          "line_type": "p",
          "text": "تیخیکس، برادر عزیز و خادم امین وهمخدمت من در خداوند، از همه احوال من شمارا خواهد آگاهانید،"
        },
        {
          "verse": 8,
          "usfm": "COL.4.8",
          "line_type": "p",
          "text": "که او را به همین جهت نزدشما فرستادم تا از حالات شما آگاه شود و دلهای شما را تسلی دهد،"
        },
        {
          "verse": 9,
          "usfm": "COL.4.9",
          "line_type": "p",
          "text": "با انیسیمس، برادر امین وحبیب که از خود شماست، شما را از همه گزارش اینجا آگاه خواهند ساخت."
        },
        {
          "verse": 10,
          "usfm": "COL.4.10",
          "line_type": "p",
          "text": "ارسترخس همزندان من شما را سلام میرساند، و مرقس عموزاده برنابا که درباره او حکم یافتهاید، هرگاه نزد شما آید او را بپذیرید،"
        },
        {
          "verse": 11,
          "usfm": "COL.4.11",
          "line_type": "p",
          "text": "و یسوع، ملقب به یسطس که ایشان تنها از اهل ختنه برای ملکوت خدا همخدمت شده، باعث تسلی من گردیدند."
        },
        {
          "verse": 12,
          "usfm": "COL.4.12",
          "line_type": "p",
          "text": "اپفراس به شما سلام میرساند که یکی از شماو غلام مسیح است و پیوسته برای شما دردعاهای خود جد و جهد میکند تا در تمامی اراده خدا کامل و متیقن شوید."
        },
        {
          "verse": 13,
          "usfm": "COL.4.13",
          "line_type": "p",
          "text": "و برای اوگواهی میدهم که درباره شما و اهل لاودکیه واهل هیراپولس بسیار محنت میکشد."
        },
        {
          "verse": 14,
          "usfm": "COL.4.14",
          "line_type": "p",
          "text": "و لوقای طبیب حبیب و دیماس به شما سلام میرسانند."
        },
        {
          "verse": 15,
          "usfm": "COL.4.15",
          "line_type": "p",
          "text": "برادران در لاودکیه و نیمفاس و کلیسایی را که در خانه ایشان است سلام رسانید."
        },
        {
          "verse": 16,
          "usfm": "COL.4.16",
          "line_type": "p",
          "text": "و چون این رساله برای شما خوانده شد، مقرر دارید که در کلیسای لاودکیان نیز خوانده شود و رساله از لاودکیه را هم شما بخوانید."
        },
        {
          "verse": 17,
          "usfm": "COL.4.17",
          "line_type": "p",
          "text": "و به ارخپس گویید: «باخبر باش تا آن خدمتی را که در خداوند یافتهای بهکمال رسانی.»"
        }
      ],
