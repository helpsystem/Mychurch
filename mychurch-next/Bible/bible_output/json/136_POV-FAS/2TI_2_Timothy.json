{
  "book_id": "2TI",
  "book_name_en": "2 Timothy",
  "book_name_fa": "دوم تیموتائوس",
  "testament": "NT",
  "version_id": 136,
  "version_abbr": "POV",
  "version_name": "ترجمۀ قدیم",
  "language": "fa",
  "chapter_count": 4,
  "total_verses": 82,
  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 1,
      "chapter_usfm": "2TI.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.1.1",
          "line_type": "p",
          "text": "پولس به اراده خدا رسول مسیح عیسی، برحسب وعده حیاتی که در مسیح عیسی است،"
        },
        {
          "verse": 2,
          "usfm": "2TI.1.2",
          "line_type": "p",
          "text": "فرزند حبیب خود تیموتاوس را.فیض و رحمت و سلامتی از جانب خدای پدرو خداوند ما عیسی مسیح باد."
        },
        {
          "verse": 3,
          "usfm": "2TI.1.3",
          "line_type": "p",
          "text": "شکر میکنم آن خدایی را که از اجداد خودبه ضمیر خالص بندگی او را میکنم، چونکه دائم در دعاهای خود تو را شبانهروز یاد میکنم،"
        },
        {
          "verse": 4,
          "usfm": "2TI.1.4",
          "line_type": "p",
          "text": "و مشتاق ملاقات تو هستم چونکه اشکهای تورا بخاطر میدارم تا از خوشی سیر شوم."
        },
        {
          "verse": 5,
          "usfm": "2TI.1.5",
          "line_type": "p",
          "text": "زیرا که یاد میدارم ایمان بیریای تو را که نخست درجده ات لوئیس و مادرت افنیکی ساکن میبود ومرا یقین است که در تو نیز هست."
        },
        {
          "verse": 6,
          "usfm": "2TI.1.6",
          "line_type": "p",
          "text": "لهذا بیاد تومی آورم که آن عطای خدا را که بوسیله گذاشتن دستهای من بر تو است برافروزی."
        },
        {
          "verse": 7,
          "usfm": "2TI.1.7",
          "line_type": "p",
          "text": "زیرا خداروح جبن را به ما نداده است بلکه روح قوت ومحبت و تادیب را."
        },
        {
          "verse": 8,
          "usfm": "2TI.1.8",
          "line_type": "p",
          "text": "پس از شهادت خداوند ما عار مدار و نه ازمن که اسیر او میباشم، بلکه در زحمات انجیل شریک باش برحسب قوت خدا،"
        },
        {
          "verse": 9,
          "usfm": "2TI.1.9",
          "line_type": "p",
          "text": "که ما را نجات داد و به دعوت مقدس خواند نه به حسب اعمال ما بلکه برحسب اراده خود و آن فیضی که قبل ازقدیم الایام در مسیح عیسی به ما عطا شد."
        },
        {
          "verse": 10,
          "usfm": "2TI.1.10",
          "line_type": "p",
          "text": "اماالحال آشکار گردید به ظهور نجاتدهنده ماعیسی مسیح که موت را نیست ساخت و حیات وبی فسادی را روشن گردانید بوسیله انجیل،"
        },
        {
          "verse": 11,
          "usfm": "2TI.1.11",
          "line_type": "p",
          "text": "که برای آن من واعظ و رسول و معلم امتها مقررشدهام."
        },
        {
          "verse": 12,
          "usfm": "2TI.1.12",
          "line_type": "p",
          "text": "و از این جهت این زحمات را میکشم بلکه عار ندارم چون میدانم به که ایمان آوردم ومرا یقین است که او قادر است که امانت مرا تا به آن روز حفظ کند."
        },
        {
          "verse": 13,
          "usfm": "2TI.1.13",
          "line_type": "p",
          "text": "نمونهای بگیر از سخنان صحیح که از من شنیدی در ایمان و محبتی که در مسیح عیسی است."
        },
        {
          "verse": 14,
          "usfm": "2TI.1.14",
          "line_type": "p",
          "text": "آن امانت نیکو را بوسیله روحالقدس که در ما ساکن است، حفظ کن."
        },
        {
          "verse": 15,
          "usfm": "2TI.1.15",
          "line_type": "p",
          "text": "از این آگاه هستی که همه آنانی که در آسیا هستند، از من رخ تافتهاند که از آنجمله فیجلس و هرموجنس میباشند."
        },
        {
          "verse": 16,
          "usfm": "2TI.1.16",
          "line_type": "p",
          "text": "خداوند اهل خانه انیسیفورس را ترحم کناد زیرا که او بارها دل مرا تازه کرد و از زنجیر من عار نداشت،"
        },
        {
          "verse": 17,
          "usfm": "2TI.1.17",
          "line_type": "p",
          "text": "بلکه چون به روم رسید، مرا به کوشش بسیار تفحص کرده، پیدا نمود."
        },
        {
          "verse": 18,
          "usfm": "2TI.1.18",
          "line_type": "p",
          "text": "(خداوند بدو عطا کناد که در آن روز در حضورخداوند رحمت یابد. ) و خدمتهایی را که درافسس کرد تو بهتر میدانی."
        }
      ],
      "verse_count": 18,
