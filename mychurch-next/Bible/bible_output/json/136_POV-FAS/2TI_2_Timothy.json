    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 3,
      "chapter_usfm": "2TI.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.3.1",
          "line_type": "p",
          "text": "اما این را بدان که در ایام آخر زمانهای سخت پدید خواهد آمد،"
        },
        {
          "verse": 2,
          "usfm": "2TI.3.2",
          "line_type": "p",
          "text": "زیرا که مردمان، خودپرست خواهند بود و طماع ولافزن و متکبر و بدگو و نامطیع والدین و ناسپاس و ناپاک"
        },
        {
          "verse": 3,
          "usfm": "2TI.3.3",
          "line_type": "p",
          "text": "و بیالفت و کینه دل و غیبتگو و ناپرهیزو بیمروت و متنفر از نیکویی"
        },
        {
          "verse": 4,
          "usfm": "2TI.3.4",
          "line_type": "p",
          "text": "و خیانت کار وتندمزاج و مغرور که عشرت را بیشتر از خدادوست میدارند؛"
        },
        {
          "verse": 5,
          "usfm": "2TI.3.5",
          "line_type": "p",
          "text": "که صورت دینداری دارند، لیکن قوت آن را انکار میکنند. از ایشان اعراض نما."
        },
        {
          "verse": 6,
          "usfm": "2TI.3.6",
          "line_type": "p",
          "text": "زیرا که از اینها هستند آنانی که به حیله داخل خانهها گشته، زنان کم عقل را اسیر میکنندکه بار گناهان را میکشند و به انواع شهوات ربوده میشوند."
        },
        {
          "verse": 7,
          "usfm": "2TI.3.7",
          "line_type": "p",
          "text": "و دائم تعلیم میگیرند، لکن هرگز به معرفت راستی نمی توانند رسید."
        },
        {
          "verse": 8,
          "usfm": "2TI.3.8",
          "line_type": "p",
          "text": "و همچنانکه ینیس و یمبریس با موسی مقاومت کردند، ایشان نیز با راستی مقاومت میکنند که مردم فاسدالعقل و مردود از ایمانند."
        },
        {
          "verse": 9,
          "usfm": "2TI.3.9",
          "line_type": "p",
          "text": "لیکن بیشتر ترقی نخواهندکرد زیرا که حماقت ایشان بر جمیع مردم واضح خواهد شد، چنانکه حماقت آنها نیز شد."
        },
        {
          "verse": 10,
          "usfm": "2TI.3.10",
          "line_type": "p",
          "text": "لیکن تو تعلیم و سیرت و قصد و ایمان وحلم و محبت و صبر مرا پیروی نمودی،"
        },
        {
          "verse": 11,
          "usfm": "2TI.3.11",
          "line_type": "p",
          "text": "وزحمات و آلام مرا مثل آنهایی که در انطاکیه وایقونیه و لستره بر من واقع شد، چگونه زحمات راتحمل مینمودم و خداوند مرا از همه رهایی داد."
        },
        {
          "verse": 12,
          "usfm": "2TI.3.12",
          "line_type": "p",
          "text": "و همه کسانی که میخواهند در مسیح عیسی به دینداری زیست کنند، زحمت خواهند کشید."
        },
        {
          "verse": 13,
          "usfm": "2TI.3.13",
          "line_type": "p",
          "text": "لیکن مردمان شریر و دغاباز در بدی ترقی خواهند کرد که فریبنده و فریب خورده میباشند."
        },
        {
          "verse": 14,
          "usfm": "2TI.3.14",
          "line_type": "p",
          "text": "اما تو در آنچه آموختی و ایمان آوردی قایم باش چونکه میدانی از چه کسان تعلیم یافتی،"
        },
        {
          "verse": 15,
          "usfm": "2TI.3.15",
          "line_type": "p",
          "text": "و اینکه از طفولیت کتب مقدسه را دانستهای که میتواند تو را حکمت آموزدبرای نجات بوسیله ایمانی که بر مسیح عیسی است."
        },
        {
          "verse": 16,
          "usfm": "2TI.3.16",
          "line_type": "p",
          "text": "تمامی کتب از الهام خداست و بجهت تعلیم و تنبیه و اصلاح و تربیت در عدالت مفیداست،"
        },
        {
          "verse": 17,
          "usfm": "2TI.3.17",
          "line_type": "p",
          "text": "تا مرد خدا کامل و بجهت هر عمل نیکوآراسته بشود."
        }
      ],
