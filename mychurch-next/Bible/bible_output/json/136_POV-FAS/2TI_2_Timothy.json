    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 4,
      "chapter_usfm": "2TI.4",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.4.1",
          "line_type": "p",
          "text": "تو را در حضور خدا و مسیح عیسی که برزندگان و مردگان داوری خواهد کرد قسم میدهم و به ظهور وملکوت او"
        },
        {
          "verse": 2,
          "usfm": "2TI.4.2",
          "line_type": "p",
          "text": "که به کلام موعظه کنی و در فرصت و غیر فرصت مواظب باشی و تنبیه و توبیخ و نصیحت نمایی باکمال تحمل و تعلیم."
        },
        {
          "verse": 3,
          "usfm": "2TI.4.3",
          "line_type": "p",
          "text": "زیرا ایامی میآید که تعلیم صحیح را متحمل نخواهند شد، بلکه برحسب شهوات خود خارش گوشها داشته، معلمان را برخود فراهم خواهندآورد،"
        },
        {
          "verse": 4,
          "usfm": "2TI.4.4",
          "line_type": "p",
          "text": "و گوشهای خود رااز راستی برگردانیده، به سوی افسانهها خواهندگرایید."
        },
        {
          "verse": 5,
          "usfm": "2TI.4.5",
          "line_type": "p",
          "text": "لیکن تو در همهچیز هشیار بوده، متحمل زحمات باش و عمل مبشر را بجا آور وخدمت خود را بهکمال رسان."
        },
        {
          "verse": 6,
          "usfm": "2TI.4.6",
          "line_type": "p",
          "text": "زیرا که من الان ریخته میشوم و وقت رحلت من رسیده است."
        },
        {
          "verse": 7,
          "usfm": "2TI.4.7",
          "line_type": "p",
          "text": "به جنگ نیکو جنگ کردهام و دوره خود را بهکمال رسانیده، ایمان رامحفوظ داشتهام."
        },
        {
          "verse": 8,
          "usfm": "2TI.4.8",
          "line_type": "p",
          "text": "بعد از این تاج عدالت برای من حاضر شده است که خداوند داور عادل در آن روز به من خواهد داد؛ و نه به من فقط بلکه نیز به همه کسانی که ظهور او را دوست میدارند."
        },
        {
          "verse": 9,
          "usfm": "2TI.4.9",
          "line_type": "p",
          "text": "سعی کن که به زودی نزد من آیی،"
        },
        {
          "verse": 10,
          "usfm": "2TI.4.10",
          "line_type": "p",
          "text": "زیرا که دیماس برای محبت این جهان حاضر مرا ترک کرده، به تسالونیکی رفته است و کریسکیس به غلاطیه و تیطس به دلماطیه."
        },
        {
          "verse": 11,
          "usfm": "2TI.4.11",
          "line_type": "p",
          "text": "لوقا تنها با من است. مرقس را برداشته، با خود بیاور زیرا که مرابجهت خدمت مفید است."
        },
        {
          "verse": 12,
          "usfm": "2TI.4.12",
          "line_type": "p",
          "text": "اما تیخیکس را به افسس فرستادم."
        },
        {
          "verse": 13,
          "usfm": "2TI.4.13",
          "line_type": "p",
          "text": "ردایی را که در تروآس نزدکرپس گذاشتم، وقت آمدنت بیاور و کتب را نیز وخصوص رقوق را."
        },
        {
          "verse": 14,
          "usfm": "2TI.4.14",
          "line_type": "p",
          "text": "اسکندر مسکر با من بسیاربدیها کرد. خداوند او را بحسب افعالش جزاخواهد داد."
        },
        {
          "verse": 15,
          "usfm": "2TI.4.15",
          "line_type": "p",
          "text": "و تو هم از او باحذر باش زیرا که باسخنان ما بشدت مقاومت نمود."
        },
        {
          "verse": 16,
          "usfm": "2TI.4.16",
          "line_type": "p",
          "text": "در محاجه اول من، هیچکس با من حاضر نشد بلکه همه مراترک کردند. مباد که این بر ایشان محسوب شود."
        },
        {
          "verse": 17,
          "usfm": "2TI.4.17",
          "line_type": "p",
          "text": "لیکن خداوند با من ایستاده، به من قوت داد تاموعظه بوسیله من بهکمال رسد و تمامی امت هابشنوند و از دهان شیر رستم."
        },
        {
          "verse": 18,
          "usfm": "2TI.4.18",
          "line_type": "p",
          "text": "و خداوند مرا ازهر کار بد خواهد رهانید و تا به ملکوت آسمانی خود نجات خواهد داد. او را تا ابدالاباد جلال باد. آمین."
        },
        {
          "verse": 19,
          "usfm": "2TI.4.19",
          "line_type": "p",
          "text": "فرسکا و اکیلا و اهل خانه انیسیفورس راسلام رسان."
        },
        {
          "verse": 20,
          "usfm": "2TI.4.20",
          "line_type": "p",
          "text": "ارستس در قرنتس ماند؛ اماترفیمس را در میلیتس بیمار واگذاردم."
        },
        {
          "verse": 21,
          "usfm": "2TI.4.21",
          "line_type": "p",
          "text": "سعی کن که قبل از زمستان بیایی. افبولس و پودیس ولینس و کلادیه و همه برادران تو را سلام میرسانند."
        }
      ],
