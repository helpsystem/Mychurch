    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 2,
      "chapter_usfm": "2TI.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.2.1",
          "line_type": "p",
          "text": "پس توای فرزند من، در فیضی که در مسیح عیسی است زورآور باش."
        },
        {
          "verse": 2,
          "usfm": "2TI.2.2",
          "line_type": "p",
          "text": "و آنچه به شهود بسیار از من شنیدی، به مردمان امین بسپارکه قابل تعلیم دیگران هم باشند."
        },
        {
          "verse": 3,
          "usfm": "2TI.2.3",
          "line_type": "p",
          "text": "چون سپاهی نیکوی مسیح عیسی در تحمل زحمات شریک باش."
        },
        {
          "verse": 4,
          "usfm": "2TI.2.4",
          "line_type": "p",
          "text": "هیچ سپاهی خود را در امور روزگار گرفتارنمی سازد تا رضایت آنکه او را سپاهی ساخت بجوید."
        },
        {
          "verse": 5,
          "usfm": "2TI.2.5",
          "line_type": "p",
          "text": "و اگر کسی نیز پهلوانی کند، تاج را بدونمی دهند اگر به قانون پهلوانی نکرده باشد."
        },
        {
          "verse": 6,
          "usfm": "2TI.2.6",
          "line_type": "p",
          "text": "برزگری که محنت میکشد، باید اول نصیبی ازحاصل ببرد."
        },
        {
          "verse": 7,
          "usfm": "2TI.2.7",
          "line_type": "p",
          "text": "در آنچه میگویم تفکر کن زیراخداوند تو را در همهچیز فهم خواهد بخشید."
        },
        {
          "verse": 8,
          "usfm": "2TI.2.8",
          "line_type": "p",
          "text": "عیسی مسیح را بخاطر دار که از نسل داودبوده، از مردگان برخاست برحسب بشارت من،"
        },
        {
          "verse": 9,
          "usfm": "2TI.2.9",
          "line_type": "p",
          "text": "که در آن چون بدکار تا به بندها زحمت میکشم، لیکن کلام خدا بسته نمی شود."
        },
        {
          "verse": 10,
          "usfm": "2TI.2.10",
          "line_type": "p",
          "text": "و ازاین جهت همه زحمات را بخاطر برگزیدگان متحمل میشوم تا ایشان نیز نجاتی را که درمسیح عیسی است با جلال جاودانی تحصیل کنند."
        },
        {
          "verse": 11,
          "usfm": "2TI.2.11",
          "line_type": "p",
          "text": "این سخن امین است زیرا اگر با وی مردیم، با او زیست هم خواهیم کرد."
        },
        {
          "verse": 12,
          "usfm": "2TI.2.12",
          "line_type": "p",
          "text": "و اگرتحمل کنیم، با او سلطنت هم خواهیم کرد؛ وهرگاه او را انکار کنیم او نیز ما را انکار خواهدکرد."
        },
        {
          "verse": 13,
          "usfm": "2TI.2.13",
          "line_type": "p",
          "text": "اگر بیایمان شویم، او امین میماند زیراخود را انکار نمی تواند نمود."
        },
        {
          "verse": 14,
          "usfm": "2TI.2.14",
          "line_type": "p",
          "text": "این چیزها را به یاد ایشان آور و در حضورخداوند قدغن فرما که مجادله نکنند، زیرا هیچ سود نمی بخشد بلکه باعث هلاکت شنوندگان میباشد."
        },
        {
          "verse": 15,
          "usfm": "2TI.2.15",
          "line_type": "p",
          "text": "و سعی کن که خود را مقبول خداسازی، عاملی که خجل نشود و کلام خدا رابخوبی انجام دهد."
        },
        {
          "verse": 16,
          "usfm": "2TI.2.16",
          "line_type": "p",
          "text": "و از یاوهگویی های حرام اعراض نما زیرا که تا به فزونی بیدینی ترقی خواهد کرد."
        },
        {
          "verse": 17,
          "usfm": "2TI.2.17",
          "line_type": "p",
          "text": "و کلام ایشان، چون آکله میخورد و از آنجمله هیمیناوس و فلیطس میباشند"
        },
        {
          "verse": 18,
          "usfm": "2TI.2.18",
          "line_type": "p",
          "text": "که ایشان از حق برگشته، میگویندکه قیامت الان شده است و بعضی را از ایمان منحرف میسازند."
        },
        {
          "verse": 19,
          "usfm": "2TI.2.19",
          "line_type": "p",
          "text": "و لیکن بنیاد ثابت خدا قائم است و این مهر را دارد که «خداوند کسان خود رامی شناسد» و «هرکه نام مسیح را خواند، ازناراستی کناره جوید.»"
        },
        {
          "verse": 20,
          "usfm": "2TI.2.20",
          "line_type": "p",
          "text": "اما در خانه بزرگ نه فقطظروف طلا و نقره میباشد، بلکه چوبی و گلی نیز؛ اما آنها برای عزت و اینها برای ذلت."
        },
        {
          "verse": 21,
          "usfm": "2TI.2.21",
          "line_type": "p",
          "text": "پس اگرکسی خویشتن را از اینها طاهر سازد، ظرف عزت خواهد بود مقدس و نافع برای مالک خود ومستعد برای هر عمل نیکو."
        },
        {
          "verse": 22,
          "usfm": "2TI.2.22",
          "line_type": "p",
          "text": "اما از شهوات جوانی بگریز و با آنانی که ازقلب خالص نام خداوند را میخوانند، عدالت وایمان و محبت و سلامتی را تعاقب نما."
        },
        {
          "verse": 23,
          "usfm": "2TI.2.23",
          "line_type": "p",
          "text": "لیکن ازمسائل بیهوده و بیتادیب اعراض نما چون میدانی که نزاعها پدید میآورد."
        },
        {
          "verse": 24,
          "usfm": "2TI.2.24",
          "line_type": "p",
          "text": "اما بنده خدانباید نزاع کند، بلکه با همه کس ملایم و راغب به تعلیم و صابر در مشقت باشد،"
        },
        {
          "verse": 25,
          "usfm": "2TI.2.25",
          "line_type": "p",
          "text": "و با حلم مخالفین را تادیب نماید که شاید خدا ایشان راتوبه بخشد تا راستی را بشناسند."
        },
        {
          "verse": 26,
          "usfm": "2TI.2.26",
          "line_type": "p",
          "text": "تا از دام ابلیس باز به هوش آیند که به حسب اراده او صیداو شدهاند."
        }
      ],
