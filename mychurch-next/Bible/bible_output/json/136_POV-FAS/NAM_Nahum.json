    {
      "schema_version": 6,
      "book_id": "NAM",
      "chapter": 3,
      "chapter_usfm": "NAM.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "NAM.3.1",
          "line_type": "p",
          "text": "وای بر شهر خون ریز که تمامش از دروغ وقتل مملو است و غارت از آن دورنمی شود!"
        },
        {
          "verse": 2,
          "usfm": "NAM.3.2",
          "line_type": "p",
          "text": "آواز تازیانهها و صدای غرغر چرخهاو جهیدن اسبان و جستن ارابهها."
        },
        {
          "verse": 3,
          "usfm": "NAM.3.3",
          "line_type": "p",
          "text": "سواران هجوم میآورند و شمشیرها براق و نیزهها لامع میباشدو کثرت مجروحان و فراوانی مقتولان و لاشها راانتها نیست. بر لاشهای یکدیگر میافتند."
        },
        {
          "verse": 4,
          "usfm": "NAM.3.4",
          "line_type": "p",
          "text": "ازکثرت زنای زانیه خوش منظر که صاحب سحرهااست و امتها را به زناهای خود و قبایل را بهجادوگریهای خویش میفروشد."
        },
        {
          "verse": 5,
          "usfm": "NAM.3.5",
          "line_type": "p",
          "text": "اینک یهوه صبایوت میگوید: «من به ضد تو هستم ودامنهایت را بر روی تو منکشف ساخته، عورت تو را بر امتها و رسوایی تو را بر مملکتها ظاهرخواهم ساخت."
        },
        {
          "verse": 6,
          "usfm": "NAM.3.6",
          "line_type": "p",
          "text": "و نجاسات بر تو ریخته تو راذلیل خواهم ساخت و تو را عبرت خواهم گردانید."
        },
        {
          "verse": 7,
          "usfm": "NAM.3.7",
          "line_type": "p",
          "text": "و واقع خواهد شد که هرکه تو را بیند ازتو فرار کرده، خواهد گفت: نینوا ویران شده است! کیست که برای وی ماتم گیرد و از کجا برای توتعزیه کنندگان بطلبم؟»"
        },
        {
          "verse": 8,
          "usfm": "NAM.3.8",
          "line_type": "p",
          "text": "آیا تو از نوآمون بهتر هستی که در میان نهرهاساکن بوده، آبها او را احاطه میداشت که دریاحصار او و بحرها دیوار او میبود؟"
        },
        {
          "verse": 9,
          "usfm": "NAM.3.9",
          "line_type": "p",
          "text": "حبش ومصر قوتش میبودند و آن انتها نداشت، فوط ولوبیم از معاونت کنندگان تو میبودند."
        },
        {
          "verse": 10,
          "usfm": "NAM.3.10",
          "line_type": "p",
          "text": "معهذاجلای وطن شده و به اسیری رفته است و اطفالش نیز بر سر هر کوچه کوبیده شدهاند و بر شرفایش قرعه انداختهاند و جمیع بزرگانش به زنجیرهابسته شدهاند."
        },
        {
          "verse": 11,
          "usfm": "NAM.3.11",
          "line_type": "p",
          "text": "پس تو نیز مست شده، خویشتن را پنهان خواهی کرد و ملجایی بهسبب دشمن خواهی جست."
        },
        {
          "verse": 12,
          "usfm": "NAM.3.12",
          "line_type": "p",
          "text": "جمیع قلعه هایت به درختان انجیر با نوبرها مشابه خواهد بود که چون تکانیده شود به دهان خورنده میافتد."
        },
        {
          "verse": 13,
          "usfm": "NAM.3.13",
          "line_type": "p",
          "text": "اینک اهل تو دراندرونت زنان میباشند. دروازه های زمینت برای دشمنانت بالکل گشاده شده، آتش پشت بندهایت را میسوزاند."
        },
        {
          "verse": 14,
          "usfm": "NAM.3.14",
          "line_type": "p",
          "text": "برای محاصره ات آب بیاور. قلعه های خودرا مستحکم ساز. به گل داخل شو و ملاط را پا بزن و کوره آجر پزی را مرمت نما."
        },
        {
          "verse": 15,
          "usfm": "NAM.3.15",
          "line_type": "p",
          "text": "در آنجا آتش تو را خواهد سوزانید و شمشیر تو را منقطع ساخته، تو را مثل کرم خواهد خورد، خویشتن رامثل کرم کثیر کن و مثل ملخ بیشمار گردان."
        },
        {
          "verse": 16,
          "usfm": "NAM.3.16",
          "line_type": "p",
          "text": "تاجرانت را از ستارگان آسمان زیادتر کردی. مثل کرمها تاراج میکنند و میپرند."
        },
        {
          "verse": 17,
          "usfm": "NAM.3.17",
          "line_type": "p",
          "text": "تاجداران تو مانند ملخهایند و سردارانت مانند انبوه جراداند که در روز سرد بر دیوارها فرود میآیند، اماچون آفتاب گرم شود میپرند و جای ایشان معلوم نیست که کجاست."
        },
        {
          "verse": 18,
          "usfm": "NAM.3.18",
          "line_type": "p",
          "text": "ای پادشاه آشورشبانانت به خواب رفته و شرفایت خوابیدهاند وقوم تو بر کوهها پراکنده شده، کسی نیست که ایشان را جمع کند."
        }
      ],
      "verse_count": 18,
