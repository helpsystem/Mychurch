    {
      "schema_version": 6,
      "book_id": "NAM",
      "chapter": 2,
      "chapter_usfm": "NAM.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "NAM.2.1",
          "line_type": "p",
          "text": "خراب کننده در مقابل تو برمی آید. حصاررا حفظ کن، راه را دیدبانی نما، کمر خود راقوی گردان و قوت خویش را بسیار زیاد کن."
        },
        {
          "verse": 2,
          "usfm": "NAM.2.2",
          "line_type": "p",
          "text": "زیرا خداوند عظمت یعقوب را مثل عظمت اسرائیل باز میآورد و تاراج کنندگان ایشان را تاراج میکنند و شاخه های موهای ایشان را تلف مینمایند."
        },
        {
          "verse": 3,
          "usfm": "NAM.2.3",
          "line_type": "p",
          "text": "سپر جباران او سرخ شده و مردان جنگی به قرمز ملبس و ارابهها در روز تهیه او ازفولاد لامع است و نیزهها متحرک میباشد."
        },
        {
          "verse": 4,
          "usfm": "NAM.2.4",
          "line_type": "p",
          "text": "ارابهها را در کوچهها بتندی میرانند، درچهارسوها بهم برمی خورند. نمایش آنها مثل مشعلها است و مانند برقها میدوند."
        },
        {
          "verse": 5,
          "usfm": "NAM.2.5",
          "line_type": "p",
          "text": "او بزرگان خود را به یاد میآورد و ایشان در راه رفتن لغزش میخورند. دوان دوان به حصار میآیند ومنجنیق را حاضر میسازند."
        },
        {
          "verse": 6,
          "usfm": "NAM.2.6",
          "line_type": "p",
          "text": "دروازه های نهرهاگشاده است و قصر گداخته میگردد."
        },
        {
          "verse": 7,
          "usfm": "NAM.2.7",
          "line_type": "p",
          "text": "و حصب برهنه شده، (به اسیری ) برده میشود و کنیزانش مثل ناله فاختهها سینه زنان ناله میکنند."
        },
        {
          "verse": 8,
          "usfm": "NAM.2.8",
          "line_type": "p",
          "text": "و نینوااز روزی که به وجود آمد، مانند برکه آب میبود. اما اهلش فرار میکنند، (و اگرچه صدا میزنند)که «بایستید! بایستید!»، لیکن احدی ملتفت نمی شود."
        },
        {
          "verse": 9,
          "usfm": "NAM.2.9",
          "line_type": "p",
          "text": "نقره را غارت کنید و طلا را به یغما برید زیراکه اندوخته های او را و کثرت هرگونه متاع نفیسهاش را انتهایی نیست."
        },
        {
          "verse": 10,
          "usfm": "NAM.2.10",
          "line_type": "p",
          "text": "او خالی و ویران وخراب است و دلش گداخته و زانوهایش لرزان ودر همه کمرها درد شدید میباشد و رنگ رویهای همه پریده است."
        },
        {
          "verse": 11,
          "usfm": "NAM.2.11",
          "line_type": "p",
          "text": "بیشه شیران و مرتع شیران ژیان کجا است که در آن شیر نر و شیر ماده و شیر بچه میخرامیدند و ترسانندهای نبود؟"
        },
        {
          "verse": 12,
          "usfm": "NAM.2.12",
          "line_type": "p",
          "text": "شیر نر برای حاجت بچه های خود میدرید وبه جهت شیرهای مادهاش خفه میکرد ومغاره های خود را از شکار و بیشه های خویش رااز صید پر میساخت."
        },
        {
          "verse": 13,
          "usfm": "NAM.2.13",
          "line_type": "p",
          "text": "اما الان یهوه صبایوت میگوید: «من به ضدتو هستم و ارابه هایش را به دود خواهم سوزانید وشمشیر، شیران ژیان تو را هلاک خواهد ساخت و شکار تو را از زمین منقطع خواهم نمود و آوازایلچیانت دیگر مسموع نخواهد شد.»"
        }
      ],
