  "chapters": [
    {
      "schema_version": 6,
      "book_id": "NAM",
      "chapter": 1,
      "chapter_usfm": "NAM.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "NAM.1.1",
          "line_type": "p",
          "text": "القوشی."
        },
        {
          "verse": 2,
          "usfm": "NAM.1.2",
          "line_type": "p",
          "text": "یهوه خدای غیور و انتقام گیرنده است. خداوند انتقام گیرنده و صاحب غضب است. خداوند از دشمنان خویش انتقام میگیرد و برای خصمان خود خشم را نگاه میدارد."
        },
        {
          "verse": 3,
          "usfm": "NAM.1.3",
          "line_type": "p",
          "text": "خداونددیرغضب و عظیم القوت است و گناه را هرگزبی سزا نمی گذارد. راه خداوند در تند باد و طوفان است و ابرها خاک پای او میباشد."
        },
        {
          "verse": 4,
          "usfm": "NAM.1.4",
          "line_type": "p",
          "text": "دریا را عتاب میکند و آن را میخشکاند و جمیع نهرها راخشک میسازد. باشان و کرمل کاهیده میشوند وگل لبنان پژمرده میگردد."
        },
        {
          "verse": 5,
          "usfm": "NAM.1.5",
          "line_type": "p",
          "text": "کوهها از او متزلزل وتلها گداخته میشوند و جهان از حضور وی متحرک میگردد و ربع مسکون و جمیع ساکنانش."
        },
        {
          "verse": 6,
          "usfm": "NAM.1.6",
          "line_type": "p",
          "text": "پیش خشم وی که تواند ایستاد؟ و درحدت غضب او که تواند برخاست؟ غضب او مثل آتش ریخته میشود و صخرهها از او خردمی گردد."
        },
        {
          "verse": 7,
          "usfm": "NAM.1.7",
          "line_type": "p",
          "text": "خداوند نیکو است و در روز تنگی ملجا میباشد و متوکلان خود را میشناسد."
        },
        {
          "verse": 8,
          "usfm": "NAM.1.8",
          "line_type": "p",
          "text": "و به سیل سرشار، مکان آن را بالکل خراب خواهدساخت و تاریکی دشمنان او را تعاقب خواهدنمود."
        },
        {
          "verse": 9,
          "usfm": "NAM.1.9",
          "line_type": "p",
          "text": "کدام تدبیر را به ضد خداوند توانید نمود؟ او دفعه هلاک خواهد کرد و مصیبت دفعه دیگر برپا نخواهد شد."
        },
        {
          "verse": 10,
          "usfm": "NAM.1.10",
          "line_type": "p",
          "text": "زیرا اگرچه مثل خارها بهم پیچیده و مانند میگساران مست بشوند، لیکن چون کاه خشک بالکل سوخته خواهند شد."
        },
        {
          "verse": 11,
          "usfm": "NAM.1.11",
          "line_type": "p",
          "text": "مشیر بلیعال که به ضد خداوند بد میاندیشد، از تو بیرون آمده است."
        },
        {
          "verse": 12,
          "usfm": "NAM.1.12",
          "line_type": "p",
          "text": "خداوند چنین میگوید: «اگرچه ایشان درقوت سالم و در شماره نیز بسیار باشند لیکن منقطع شده، در خواهند گذشت. و اگرچه تو راذلیل ساختم، لیکن بار دیگر تو را ذلیل نخواهم نمود."
        },
        {
          "verse": 13,
          "usfm": "NAM.1.13",
          "line_type": "p",
          "text": "و الان یوغ او را از گردن تو خواهم شکست و بندهای تو را خواهم گسیخت.»"
        },
        {
          "verse": 14,
          "usfm": "NAM.1.14",
          "line_type": "p",
          "text": "وخداوند درباره تو امر فرموده است که بار دیگرذریتی به نام تو نخواهد بود و از خانه خدایانت بتهای تراشیده و اصنام ریخته شده را منقطع خواهم نمود و قبر تو را خواهم ساخت زیرا خوارشدهای."
        },
        {
          "verse": 15,
          "usfm": "NAM.1.15",
          "line_type": "p",
          "text": "اینک بر کوهها پایهای مبشر که سلامتی را ندا میکند! ای یهودا عیدهای خود رانگاه دار و نذرهای خود را وفا کن زیرا که مردبلیعال بار دیگر از تو نخواهد گذشت بلکه بالکل منقطع خواهد شد."
        }
      ],
      "verse_count": 15,
