    {
      "schema_version": 6,
      "book_id": "EPH",
      "chapter": 3,
      "chapter_usfm": "EPH.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "EPH.3.1",
          "line_type": "p",
          "text": "از این سبب من که پولس هستم و اسیر مسیح عیسی برای شماای امت ها-"
        },
        {
          "verse": 2,
          "usfm": "EPH.3.2",
          "line_type": "p",
          "text": "اگر شنیده باشید تدبیر فیض خدا را که بجهت شما به من عطا شده است،"
        },
        {
          "verse": 3,
          "usfm": "EPH.3.3",
          "line_type": "p",
          "text": "که این سر ازراه کشف بر من اعلام شد، چنانکه مختصر پیش نوشتم،"
        },
        {
          "verse": 4,
          "usfm": "EPH.3.4",
          "line_type": "p",
          "text": "و از مطالعه آن میتوانید ادراک مرا درسر میسح بفهمید."
        },
        {
          "verse": 5,
          "usfm": "EPH.3.5",
          "line_type": "p",
          "text": "که آن در قرنهای گذشته به بنی آدم آشکار نشده بود، بطوری که الحال بررسولان مقدس و انبیای او به روح مکشوف گشته است،"
        },
        {
          "verse": 6,
          "usfm": "EPH.3.6",
          "line_type": "p",
          "text": "که امتها در میراث و در بدن و در بهره وعده او در مسیح بوساطت انجیل شریک هستند."
        },
        {
          "verse": 7,
          "usfm": "EPH.3.7",
          "line_type": "p",
          "text": "که خادم آن شدم بحسب عطای فیض خدا که برحسب عمل قوت او به من داده شده است."
        },
        {
          "verse": 8,
          "usfm": "EPH.3.8",
          "line_type": "p",
          "text": "یعنی به من که کمتر از کمترین همه مقدسینم، این فیض عطا شد که در میان امتها به دولت بیقیاس مسیح بشارت دهم،"
        },
        {
          "verse": 9,
          "usfm": "EPH.3.9",
          "line_type": "p",
          "text": "و همه را روشن سازم که چیست انتظام آن سری که از بنای عالمهامستور بود، در خدایی که همهچیز را بوسیله عیسی مسیح آفرید."
        },
        {
          "verse": 10,
          "usfm": "EPH.3.10",
          "line_type": "p",
          "text": "تا آنکه الحال بر ارباب ریاستها و قدرتها در جایهای آسمانی، حکمت گوناگون خدا بوسیله کلیسا معلوم شود،"
        },
        {
          "verse": 11,
          "usfm": "EPH.3.11",
          "line_type": "p",
          "text": "برحسب تقدیر ازلی که در خداوند ما مسیح عیسی نمود،"
        },
        {
          "verse": 12,
          "usfm": "EPH.3.12",
          "line_type": "p",
          "text": "که در وی جسارت و دخول بااعتماد داریم بهسبب ایمان وی."
        },
        {
          "verse": 13,
          "usfm": "EPH.3.13",
          "line_type": "p",
          "text": "لهذا استدعادارم که از زحمات من به جهت شما خسته خاطرمشوید که آنها فخر شما است."
        },
        {
          "verse": 14,
          "usfm": "EPH.3.14",
          "line_type": "p",
          "text": "از این سبب، زانو میزنم نزد آن پدر،"
        },
        {
          "verse": 15,
          "usfm": "EPH.3.15",
          "line_type": "p",
          "text": "که از او هر خانوادهای در آسمان و بر زمین مسمی میشود؛"
        },
        {
          "verse": 16,
          "usfm": "EPH.3.16",
          "line_type": "p",
          "text": "که بحسب دولت جلال خود به شماعطا کند که در انسانیت باطنی خود از روح او به قوت زورآور شوید،"
        },
        {
          "verse": 17,
          "usfm": "EPH.3.17",
          "line_type": "p",
          "text": "تا مسیح به وساطت ایمان در دلهای شما ساکن شود؛"
        },
        {
          "verse": 18,
          "usfm": "EPH.3.18",
          "line_type": "p",
          "text": "و در محبت ریشه کرده و بنیاد نهاده، استطاعت یابید که باتمامی مقدسین ادراک کنید که عرض و طول وعمق و بلندی چیست؛"
        },
        {
          "verse": 19,
          "usfm": "EPH.3.19",
          "line_type": "p",
          "text": "و عارف شوید به محبت مسیح که فوق از معرفت است تا پر شویدتا تمامی پری خدا."
        },
        {
          "verse": 20,
          "usfm": "EPH.3.20",
          "line_type": "p",
          "text": "الحال او را که قادر است که بکند بینهایت زیادتر از هرآنچه بخواهیم یا فکر کنیم، بحسب آن قوتی که در ما عمل میکند،"
        },
        {
          "verse": 21,
          "usfm": "EPH.3.21",
          "line_type": "p",
          "text": "مر او را درکلیسا و در مسیح عیسی تا جمیع قرنها تا ابدالابادجلال باد. آمین."
        }
      ],
