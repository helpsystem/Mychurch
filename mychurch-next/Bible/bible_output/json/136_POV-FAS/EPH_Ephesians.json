    {
      "schema_version": 6,
      "book_id": "EPH",
      "chapter": 5,
      "chapter_usfm": "EPH.5",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "EPH.5.1",
          "line_type": "p",
          "text": "پس چون فرزندان عزیز به خدا اقتدا کنید."
        },
        {
          "verse": 2,
          "usfm": "EPH.5.2",
          "line_type": "p",
          "text": "و در محبت رفتار نمایید، چنانکه مسیح هم ما را محبت نمود و خویشتن را برای ما به خداهدیه و قربانی برای عطر خوشبوی گذرانید."
        },
        {
          "verse": 3,
          "usfm": "EPH.5.3",
          "line_type": "p",
          "text": "اما زنا و هر ناپاکی و طمع در میان شما هرگزمذکور هم نشود، چنانکه مقدسین را میشاید."
        },
        {
          "verse": 4,
          "usfm": "EPH.5.4",
          "line_type": "p",
          "text": "ونه قباحت و بیهودهگویی و چرب زبانی که اینها شایسته نیست بلکه شکرگزاری."
        },
        {
          "verse": 5,
          "usfm": "EPH.5.5",
          "line_type": "p",
          "text": "زیرا این را یقین میدانید که هیچ زانی یا ناپاک یا طماع که بتپرست باشد، میراثی در ملکوت مسیح و خداندارد."
        },
        {
          "verse": 6,
          "usfm": "EPH.5.6",
          "line_type": "p",
          "text": "هیچکس شما را به سخنان باطل فریب ندهد، زیرا که بهسبب اینها غضب خدا بر ابنای معصیت نازل میشود."
        },
        {
          "verse": 7,
          "usfm": "EPH.5.7",
          "line_type": "p",
          "text": "پس با ایشان شریک مباشید."
        },
        {
          "verse": 8,
          "usfm": "EPH.5.8",
          "line_type": "p",
          "text": "زیرا که پیشتر ظلمت بودید، لیکن الحال درخداوند نور میباشید. پس چون فرزندان نوررفتار کنید."
        },
        {
          "verse": 9,
          "usfm": "EPH.5.9",
          "line_type": "p",
          "text": "زیرا که میوه نور در کمال، نیکویی وعدالت و راستی است."
        },
        {
          "verse": 10,
          "usfm": "EPH.5.10",
          "line_type": "p",
          "text": "و تحقیق نمایید که پسندیده خداوند چیست."
        },
        {
          "verse": 11,
          "usfm": "EPH.5.11",
          "line_type": "p",
          "text": "و در اعمال بیثمرظلمت شریک مباشید بلکه آنها را مذمت کنید،"
        },
        {
          "verse": 12,
          "usfm": "EPH.5.12",
          "line_type": "p",
          "text": "زیرا کارهایی که ایشان در خفا میکنند، حتی ذکر آنها هم قبیح است."
        },
        {
          "verse": 13,
          "usfm": "EPH.5.13",
          "line_type": "p",
          "text": "لیکن هرچیزی که مذمت شود، از نور ظاهر میگردد، زیرا که هرچه ظاهر میشود نور است."
        },
        {
          "verse": 14,
          "usfm": "EPH.5.14",
          "line_type": "p",
          "text": "بنابراین میگویدای تو که خوابیدهای، بیدار شده، از مردگان برخیز تامسیح بر تو درخشد."
        },
        {
          "verse": 15,
          "usfm": "EPH.5.15",
          "line_type": "p",
          "text": "پس باخبر باشید که چگونه به دقت رفتارنمایید، نه چون جاهلان بلکه چون حکیمان."
        },
        {
          "verse": 16,
          "usfm": "EPH.5.16",
          "line_type": "p",
          "text": "ووقت را دریابید زیرا اینروزها شریر است."
        },
        {
          "verse": 17,
          "usfm": "EPH.5.17",
          "line_type": "p",
          "text": "ازاین جهت بیفهم مباشید، بلکه بفهمید که اراده خداوند چیست."
        },
        {
          "verse": 18,
          "usfm": "EPH.5.18",
          "line_type": "p",
          "text": "و مست شراب مشوید که درآن فجور است، بلکه از روح پر شوید."
        },
        {
          "verse": 19,
          "usfm": "EPH.5.19",
          "line_type": "p",
          "text": "و بایکدیگر به مزامیر و تسبیحات و سرودهای روحانی گفتگو کنید و در دلهای خود به خداوندبسرایید و ترنم نمایید."
        },
        {
          "verse": 20,
          "usfm": "EPH.5.20",
          "line_type": "p",
          "text": "و پیوسته بجهت هرچیز خدا و پدر را به نام خداوند ما عیسی مسیح شکر کنید."
        },
        {
          "verse": 21,
          "usfm": "EPH.5.21",
          "line_type": "p",
          "text": "همدیگر را در خدا ترسی اطاعت کنید."
        },
        {
          "verse": 22,
          "usfm": "EPH.5.22",
          "line_type": "p",
          "text": "ای زنان، شوهران خود را اطاعت کنیدچنانکه خداوند را."
        },
        {
          "verse": 23,
          "usfm": "EPH.5.23",
          "line_type": "p",
          "text": "زیرا که شوهر سر زن است چنانکه مسیح نیز سر کلیسا و او نجاتدهنده بدن است."
        },
        {
          "verse": 24,
          "usfm": "EPH.5.24",
          "line_type": "p",
          "text": "لیکن همچنانکه کلیسا مطیع مسیح است، همچنین زنان نیز شوهران خود را در هرامری باشند."
        },
        {
          "verse": 25,
          "usfm": "EPH.5.25",
          "line_type": "p",
          "text": "ای شوهران زنان خود را محبت نمایید، چنانکه مسیح هم کلیسا را محبت نمود وخویشتن را برای آن داد."
        },
        {
          "verse": 26,
          "usfm": "EPH.5.26",
          "line_type": "p",
          "text": "تا آن را به غسل آب بوسیله کلام طاهر ساخته، تقدیس نماید،"
        },
        {
          "verse": 27,
          "usfm": "EPH.5.27",
          "line_type": "p",
          "text": "تاکلیسای مجید را به نزد خود حاضر سازد که لکه وچین یا هیچچیز مثل آن نداشته باشد، بلکه تامقدس و بیعیب باشد."
        },
        {
          "verse": 28,
          "usfm": "EPH.5.28",
          "line_type": "p",
          "text": "به همین طور، بایدمردان زنان خویش را مثل بدن خود محبت نمایند زیرا هرکه زوجه خود را محبت نماید، خویشتن را محبت مینماید."
        },
        {
          "verse": 29,
          "usfm": "EPH.5.29",
          "line_type": "p",
          "text": "زیرا هیچکس هرگز جسم خود را دشمن نداشته است بلکه آن راتربیت و نوازش میکند، چنانکه خداوند نیزکلیسا را."
        },
        {
          "verse": 30,
          "usfm": "EPH.5.30",
          "line_type": "p",
          "text": "زانرو که اعضای بدن وی میباشیم، از جسم و از استخوانهای او."
        },
        {
          "verse": 31,
          "usfm": "EPH.5.31",
          "line_type": "p",
          "text": "از اینجاست که مرد پدر و مادر را رها کرده، با زوجه خویش خواهد پیوست و آن دو یکتن خواهند بود."
        },
        {
          "verse": 32,
          "usfm": "EPH.5.32",
          "line_type": "p",
          "text": "این سر، عظیم است، لیکن من درباره مسیح و کلیساسخن میگویم."
        },
        {
          "verse": 33,
          "usfm": "EPH.5.33",
          "line_type": "p",
          "text": "خلاصه هریکی از شما نیز زن خود را مثل نفس خود محبت بنماید و زن شوهر خود را باید احترام نمود."
        }
      ],
