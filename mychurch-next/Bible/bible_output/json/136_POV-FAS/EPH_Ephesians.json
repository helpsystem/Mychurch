    {
      "schema_version": 6,
      "book_id": "EPH",
      "chapter": 4,
      "chapter_usfm": "EPH.4",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "EPH.4.1",
          "line_type": "p",
          "text": "لهذا من که در خداوند اسیر میباشم، ازشما استدعا دارم که به شایستگی آن دعوتی که به آن خوانده شدهاید، رفتار کنید،"
        },
        {
          "verse": 2,
          "usfm": "EPH.4.2",
          "line_type": "p",
          "text": "باکمال فروتنی و تواضع و حلم، و متحمل یکدیگردر محبت باشید؛"
        },
        {
          "verse": 3,
          "usfm": "EPH.4.3",
          "line_type": "p",
          "text": "و سعی کنید که یگانگی روح را در رشته سلامتی نگاه دارید."
        },
        {
          "verse": 4,
          "usfm": "EPH.4.4",
          "line_type": "p",
          "text": "یک جسدهست و یک روح، چنانکه نیز دعوت شدهاید دریک امید دعوت خویش."
        },
        {
          "verse": 5,
          "usfm": "EPH.4.5",
          "line_type": "p",
          "text": "یک خداوند، یک ایمان، یک تعمید؛"
        },
        {
          "verse": 6,
          "usfm": "EPH.4.6",
          "line_type": "p",
          "text": "یک خدا و پدر همه که فوق همه و در میان همه و در همه شما است."
        },
        {
          "verse": 7,
          "usfm": "EPH.4.7",
          "line_type": "p",
          "text": "لیکن هریکی از ما را فیض بخشیده شد بحسب اندازه بخشش مسیح."
        },
        {
          "verse": 8,
          "usfm": "EPH.4.8",
          "line_type": "p",
          "text": "بنابراین میگوید: «چون او به اعلی علیین صعود نمود، اسیری را به اسیری برد و بخششها به مردم داد.»"
        },
        {
          "verse": 9,
          "usfm": "EPH.4.9",
          "line_type": "p",
          "text": "اما این صعود نمودچیست؟ جز اینکه اول نزول هم کرد به اسفل زمین."
        },
        {
          "verse": 10,
          "usfm": "EPH.4.10",
          "line_type": "p",
          "text": "آنکه نزول نمود، همان است که صعودنیز کرد بالاتر از جمیع افلاک تا همهچیزها را پرکند."
        },
        {
          "verse": 11,
          "usfm": "EPH.4.11",
          "line_type": "p",
          "text": "و او بخشید بعضی رسولان و بعضی انبیا وبعضی مبشرین و بعضی شبانان و معلمان را،"
        },
        {
          "verse": 12,
          "usfm": "EPH.4.12",
          "line_type": "p",
          "text": "برای تکمیل مقدسین، برای کار خدمت، برای بنای جسد مسیح،"
        },
        {
          "verse": 13,
          "usfm": "EPH.4.13",
          "line_type": "p",
          "text": "تا همه به یگانگی ایمان ومعرفت تام پسر خدا و به انسان کامل، به اندازه قامت پری مسیح برسیم."
        },
        {
          "verse": 14,
          "usfm": "EPH.4.14",
          "line_type": "p",
          "text": "تا بعد از این اطفال متموج و رانده شده از باد هر تعلیم نباشیم، ازدغابازی مردمان در حیله اندیشی برای مکرهای گمراهی؛"
        },
        {
          "verse": 15,
          "usfm": "EPH.4.15",
          "line_type": "p",
          "text": "بلکه در محبت پیروی راستی نموده، در هرچیز ترقی نماییم در او که سر است، یعنی مسیح؛"
        },
        {
          "verse": 16,
          "usfm": "EPH.4.16",
          "line_type": "p",
          "text": "که از او تمام بدن مرکب و مرتب گشته، به مدد هر مفصلی و برحسب عمل به اندازه هرعضوی بدن را نمو میدهد برای بنای خویشتن در محبت."
        },
        {
          "verse": 17,
          "usfm": "EPH.4.17",
          "line_type": "p",
          "text": "پس این را میگویم و در خداوند شهادت میدهم که شما دیگر رفتار منمایید، چنانکه امتها در بطالت ذهن خود رفتار مینمایند."
        },
        {
          "verse": 18,
          "usfm": "EPH.4.18",
          "line_type": "p",
          "text": "که در عقل خود تاریک هستند و از حیات خدامحروم، بهسبب جهالتی که بجهت سخت دلی ایشان در ایشان است."
        },
        {
          "verse": 19,
          "usfm": "EPH.4.19",
          "line_type": "p",
          "text": "که بیفکر شده، خود رابه فجور تسلیم کردهاند تا هرقسم ناپاکی را به حرص به عمل آورند."
        },
        {
          "verse": 20,
          "usfm": "EPH.4.20",
          "line_type": "p",
          "text": "لیکن شما مسیح را به اینطور نیاموختهاید."
        },
        {
          "verse": 21,
          "usfm": "EPH.4.21",
          "line_type": "p",
          "text": "هرگاه او را شنیدهاید و در او تعلیم یافتهاید، به نهجی که راستی در عیسی است."
        },
        {
          "verse": 22,
          "usfm": "EPH.4.22",
          "line_type": "p",
          "text": "تا آنکه شمااز جهت رفتار گذشته خود، انسانیت کهنه را که ازشهوات فریبنده فاسد میگردد، از خود بیرون کنید."
        },
        {
          "verse": 23,
          "usfm": "EPH.4.23",
          "line_type": "p",
          "text": "و به روح ذهن خود تازه شوید."
        },
        {
          "verse": 24,
          "usfm": "EPH.4.24",
          "line_type": "p",
          "text": "وانسانیت تازه را که به صورت خدا در عدالت وقدوسیت حقیقی آفریده شده است بپوشید."
        },
        {
          "verse": 25,
          "usfm": "EPH.4.25",
          "line_type": "p",
          "text": "لهذا دروغ را ترک کرده، هرکس با همسایه خود راست بگوید، زیرا که ما اعضای یکدیگریم."
        },
        {
          "verse": 26,
          "usfm": "EPH.4.26",
          "line_type": "p",
          "text": "خشم گیرید و گناه مورزید؛ خورشید بر غیظشما غروب نکند."
        },
        {
          "verse": 27,
          "usfm": "EPH.4.27",
          "line_type": "p",
          "text": "ابلیس را مجال ندهید."
        },
        {
          "verse": 28,
          "usfm": "EPH.4.28",
          "line_type": "p",
          "text": "دزد دیگر دزدی نکند بلکه بهدستهای خود کارنیکو کرده، زحمت بکشد تا بتواند نیازمندی راچیزی دهد."
        },
        {
          "verse": 29,
          "usfm": "EPH.4.29",
          "line_type": "p",
          "text": "هیچ سخن بد از دهان شما بیرون نیاید، بلکه آنچه بحسب حاجت و برای بنا نیکوباشد تا شنوندگان را فیض رساند."
        },
        {
          "verse": 30,
          "usfm": "EPH.4.30",
          "line_type": "p",
          "text": "و روح قدوس خدا را که به او تا روز رستگاری مختوم شدهاید، محزون مسازید."
        },
        {
          "verse": 31,
          "usfm": "EPH.4.31",
          "line_type": "p",
          "text": "و هرقسم تلخی وغیظ و خشم و فریاد و بدگویی و خباثت را ازخود دور کنید،"
        },
        {
          "verse": 32,
          "usfm": "EPH.4.32",
          "line_type": "p",
          "text": "و با یگدیگر مهربان باشید ورحیم و همدیگر را عفو نمایید چنانکه خدا درمسیح شما را هم آمرزیده است."
        }
      ],
