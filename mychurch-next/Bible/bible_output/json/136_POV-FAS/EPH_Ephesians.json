{
  "book_id": "EPH",
  "book_name_en": "Ephesians",
  "book_name_fa": "افسسیان",
  "testament": "NT",
  "version_id": 136,
  "version_abbr": "POV",
  "version_name": "ترجمۀ قدیم",
  "language": "fa",
  "chapter_count": 6,
  "total_verses": 154,
  "chapters": [
    {
      "schema_version": 6,
      "book_id": "EPH",
      "chapter": 1,
      "chapter_usfm": "EPH.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "EPH.1.1",
          "line_type": "p",
          "text": "پولس به اراده خدا رسول عیسی مسیح، به مقدسینی که در افسس میباشند وایمانداران در مسیح عیسی."
        },
        {
          "verse": 2,
          "usfm": "EPH.1.2",
          "line_type": "p",
          "text": "فیض و سلامتی از جانب پدر ما خدا وعیسی مسیح خداوند بر شما باد."
        },
        {
          "verse": 3,
          "usfm": "EPH.1.3",
          "line_type": "p",
          "text": "متبارک باد خدا و پدر خداوند ما عیسی مسیح که ما را مبارک ساخت به هر برکت روحانی در جایهای آسمانی در مسیح."
        },
        {
          "verse": 4,
          "usfm": "EPH.1.4",
          "line_type": "p",
          "text": "چنانکه ما راپیش از بنیاد عالم در او برگزید تا در حضور او درمحبت مقدس و بیعیب باشیم."
        },
        {
          "verse": 5,
          "usfm": "EPH.1.5",
          "line_type": "p",
          "text": "که ما را از قبل تعیین نمود تا او را پسر خوانده شویم بوساطت عیسی مسیح برحسب خشنودی اراده خود،"
        },
        {
          "verse": 6,
          "usfm": "EPH.1.6",
          "line_type": "p",
          "text": "برای ستایش جلال فیض خود که ما را به آن مستفیض گردانید در آن حبیب."
        },
        {
          "verse": 7,
          "usfm": "EPH.1.7",
          "line_type": "p",
          "text": "که در وی بهسبب خون او فدیه یعنی آمرزش گناهان را به اندازه دولت فیض او یافتهایم."
        },
        {
          "verse": 8,
          "usfm": "EPH.1.8",
          "line_type": "p",
          "text": "که آن را به ما به فراوانی عطا فرمود در حکمت و فطانت."
        },
        {
          "verse": 9,
          "usfm": "EPH.1.9",
          "line_type": "p",
          "text": "چونکه سر اراده خود را به ما شناسانید، برحسب خشنودی خود که در خود عزم نموده بود،"
        },
        {
          "verse": 10,
          "usfm": "EPH.1.10",
          "line_type": "p",
          "text": "برای انتظام کمال زمانها تا همهچیز را خواه آنچه در آسمان و خواه آنچه بر زمین است، درمسیح جمع کند، یعنی در او."
        },
        {
          "verse": 11,
          "usfm": "EPH.1.11",
          "line_type": "p",
          "text": "که ما نیز در وی میراث او شدهایم، چنانکه پیش معین گشتیم برحسب قصد او. که همهچیزها را موافق رای اراده خود میکند."
        },
        {
          "verse": 12,
          "usfm": "EPH.1.12",
          "line_type": "p",
          "text": "تا از ما که اول امیدوار به مسیح میبودیم، جلال او ستوده شود."
        },
        {
          "verse": 13,
          "usfm": "EPH.1.13",
          "line_type": "p",
          "text": "و دروی شما نیز چون کلام راستی، یعنی بشارت نجات خود را شنیدید، در وی چون ایمان آوردید، از روح قدوس وعده مختوم شدید."
        },
        {
          "verse": 14,
          "usfm": "EPH.1.14",
          "line_type": "p",
          "text": "که بیعانه میراث ما است برای فدای آن ملک خاص او تا جلال او ستوده شود."
        },
        {
          "verse": 15,
          "usfm": "EPH.1.15",
          "line_type": "p",
          "text": "بنابراین، من نیز چون خبر ایمان شما را درعیسی خداوند ومحبت شما را با همه مقدسین شنیدم،"
        },
        {
          "verse": 16,
          "usfm": "EPH.1.16",
          "line_type": "p",
          "text": "باز نمی ایستم از شکر نمودن برای شما و از یاد آوردن شما در دعاهای خود،"
        },
        {
          "verse": 17,
          "usfm": "EPH.1.17",
          "line_type": "p",
          "text": "تاخدای خداوند ما عیسی مسیح که پدر ذوالجلال است، روح حکمت و کشف را در معرفت خود به شما عطا فرماید."
        },
        {
          "verse": 18,
          "usfm": "EPH.1.18",
          "line_type": "p",
          "text": "تا چشمان دل شما روشن گشته، بدانید که امید دعوت او چیست و کدام است دولت جلال میراث او در مقدسین،"
        },
        {
          "verse": 19,
          "usfm": "EPH.1.19",
          "line_type": "p",
          "text": "و چه مقدار است عظمت بینهایت قوت او نسبت به مامومنین برحسب عمل توانایی قوت او"
        },
        {
          "verse": 20,
          "usfm": "EPH.1.20",
          "line_type": "p",
          "text": "که درمسیح عمل کرد چون او را از مردگان برخیزانید وبهدست راست خود در جایهای آسمانی نشانید،"
        },
        {
          "verse": 21,
          "usfm": "EPH.1.21",
          "line_type": "p",
          "text": "بالاتر از هر ریاست و قدرت و قوت و سلطنت و هر نامی که خوانده میشود، نه در این عالم فقطبلکه در عالم آینده نیز."
        },
        {
          "verse": 22,
          "usfm": "EPH.1.22",
          "line_type": "p",
          "text": "و همهچیز را زیر پایهای او نهاد و او را سرهمهچیز به کلیسا داد،"
        },
        {
          "verse": 23,
          "usfm": "EPH.1.23",
          "line_type": "p",
          "text": "که بدن اوست یعنی پری او که همه را در همه پر میسازد."
        }
      ],
