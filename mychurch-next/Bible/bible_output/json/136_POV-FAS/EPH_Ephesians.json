    {
      "schema_version": 6,
      "book_id": "EPH",
      "chapter": 2,
      "chapter_usfm": "EPH.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "EPH.2.1",
          "line_type": "p",
          "text": "و شما را که در خطایا و گناهان مرده بودید، زنده گردانید،"
        },
        {
          "verse": 2,
          "usfm": "EPH.2.2",
          "line_type": "p",
          "text": "که در آنها قبل، رفتارمی کردید برحسب دوره این جهان بر وفق رئیس قدرت هوا یعنی آن روحی که الحال در فرزندان معصیت عمل میکند."
        },
        {
          "verse": 3,
          "usfm": "EPH.2.3",
          "line_type": "p",
          "text": "که در میان ایشان، همه مانیز در شهوات جسمانی خود قبل از این زندگی میکردیدم و هوسهای جسمانی و افکار خود رابه عمل میآوردیم و طبعا فرزندان غضب بودیم، چنانکه دیگران."
        },
        {
          "verse": 4,
          "usfm": "EPH.2.4",
          "line_type": "p",
          "text": "لیکن خدا که در رحمانیت، دولتمند است، از حیثیت محبت عظیم خود که باما نمود،"
        },
        {
          "verse": 5,
          "usfm": "EPH.2.5",
          "line_type": "p",
          "text": "ما را نیز که در خطایا مرده بودیم بامسیح زنده گردانید، زیرا که محض فیض نجات یافتهاید."
        },
        {
          "verse": 6,
          "usfm": "EPH.2.6",
          "line_type": "p",
          "text": "و با او برخیزانید و در جایهای آسمانی در مسیح عیسی نشانید."
        },
        {
          "verse": 7,
          "usfm": "EPH.2.7",
          "line_type": "p",
          "text": "تا در عالمهای آینده دولت بینهایت فیض خود را به لطفی که بر ما درمسیح عیسی دارد ظاهر سازد."
        },
        {
          "verse": 8,
          "usfm": "EPH.2.8",
          "line_type": "p",
          "text": "زیرا که محض فیض نجات یافتهاید، بوسیله ایمان و این از شمانیست بلکه بخشش خداست،"
        },
        {
          "verse": 9,
          "usfm": "EPH.2.9",
          "line_type": "p",
          "text": "و نه از اعمال تا هیچ کس فخر نکند."
        },
        {
          "verse": 10,
          "usfm": "EPH.2.10",
          "line_type": "p",
          "text": "زیرا که صنعت او هستیم، آفریده شده در مسیح عیسی برای کارهای نیکوکه خدا قبل مهیا نمود تا در آنها سلوک نماییم."
        },
        {
          "verse": 11,
          "usfm": "EPH.2.11",
          "line_type": "p",
          "text": "لهذا به یاد آورید که شما در زمان سلف (ای امت های در جسم که آنانی که به اهل ختنه نامیده میشوند، اما ختنه ایشان در جسم وساخته شده بهدست است، شما را نامختون میخوانند)،"
        },
        {
          "verse": 12,
          "usfm": "EPH.2.12",
          "line_type": "p",
          "text": "که شما در آن زمان از مسیح جدا و از وطنیت خاندان اسرائیل، اجنبی و از عهدهای وعده بیگانه و بیامید و بیخدا در دنیا بودید."
        },
        {
          "verse": 13,
          "usfm": "EPH.2.13",
          "line_type": "p",
          "text": "لیکن الحال در مسیح عیسی شما که درآن وقت دور بودید، به خون مسیح نزدیک شدهاید."
        },
        {
          "verse": 14,
          "usfm": "EPH.2.14",
          "line_type": "p",
          "text": "زیرا که او سلامتی ما است که هر دو را یک گردانید و دیوار جدایی را که در میان بود منهدم ساخت،"
        },
        {
          "verse": 15,
          "usfm": "EPH.2.15",
          "line_type": "p",
          "text": "و عداوت یعنی شریعت احکام را که در فرایض بود، به جسم خود نابود ساخت تا که مصالحه کرده، از هر دو یک انسان جدید در خود بیافریند."
        },
        {
          "verse": 16,
          "usfm": "EPH.2.16",
          "line_type": "p",
          "text": "و تا هر دو را در یک جسد با خدا مصالحه دهد، بوساطت صلیب خود که بر آن عداوت را کشت،"
        },
        {
          "verse": 17,
          "usfm": "EPH.2.17",
          "line_type": "p",
          "text": "و آمده بشارت مصالحه را رسانید به شما که دور بودید ومصالحه را به آنانی که نزدیک بودند."
        },
        {
          "verse": 18,
          "usfm": "EPH.2.18",
          "line_type": "p",
          "text": "زیرا که بوسیله او هر دو نزد پدر در یک روح دخول داریم."
        },
        {
          "verse": 19,
          "usfm": "EPH.2.19",
          "line_type": "p",
          "text": "پس از این به بعد غریب و اجنبی نیستیدبلکه هموطن مقدسین هستید و از اهل خانه خدا."
        },
        {
          "verse": 20,
          "usfm": "EPH.2.20",
          "line_type": "p",
          "text": "و بر بنیاد رسولان و انبیا بنا شدهاید که خودعیسی مسیح سنگ زاویه است."
        },
        {
          "verse": 21,
          "usfm": "EPH.2.21",
          "line_type": "p",
          "text": "که در وی تمامی عمارت با هم مرتب شده، به هیکل مقدس در خداوند نمو میکند."
        },
        {
          "verse": 22,
          "usfm": "EPH.2.22",
          "line_type": "p",
          "text": "و در وی شما نیز با هم بنا کرده میشوید تا در روح مسکن خدا شوید."
        }
      ],
