    },
    {
      "schema_version": 6,
      "book_id": "EPH",
      "chapter": 6,
      "chapter_usfm": "EPH.6",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "EPH.6.1",
          "line_type": "p",
          "text": "ای فرزندان، والدین خود را در خداونداطاعت نمایید، زیرا که این انصاف است."
        },
        {
          "verse": 2,
          "usfm": "EPH.6.2",
          "line_type": "p",
          "text": "«پدر و مادر خود را احترام نما» که این حکم اول با وعده است."
        },
        {
          "verse": 3,
          "usfm": "EPH.6.3",
          "line_type": "p",
          "text": "«تا تو را عافیت باشد و عمر درازبر زمین کنی.»"
        },
        {
          "verse": 4,
          "usfm": "EPH.6.4",
          "line_type": "p",
          "text": "وای پدران، فرزندان خود را به خشم میاورید بلکه ایشان را به تادیب و نصیحت خداوند تربیت نمایید."
        },
        {
          "verse": 5,
          "usfm": "EPH.6.5",
          "line_type": "p",
          "text": "ای غلامان، آقایان بشری خود را چون مسیح با ترس و لرز با ساده دلی اطاعت کنید."
        },
        {
          "verse": 6,
          "usfm": "EPH.6.6",
          "line_type": "p",
          "text": "نه به خدمت حضور مثل طالبان رضامندی انسان، بلکه چون غلامان مسیح که اراده خدا را از دل به عمل میآورند،"
        },
        {
          "verse": 7,
          "usfm": "EPH.6.7",
          "line_type": "p",
          "text": "و به نیت خالص خداوند رابندگی میکنند نه انسان را،"
        },
        {
          "verse": 8,
          "usfm": "EPH.6.8",
          "line_type": "p",
          "text": "و میدانند هرکس که عمل نیکو کند، مکافات آن را از خداوند خواهدیافت، خواه غلام و خواه آزاد."
        },
        {
          "verse": 9,
          "usfm": "EPH.6.9",
          "line_type": "p",
          "text": "وای آقایان، باایشان به همین نسق رفتار نمایید و از تهدید کردن احتراز کنید، چونکه میدانید که خود شما را هم آقایی هست در آسمان و او را نظر به ظاهر نیست."
        },
        {
          "verse": 10,
          "usfm": "EPH.6.10",
          "line_type": "p",
          "text": "خلاصهای برادران من، در خداوند و درتوانایی قوت او زورآور شوید."
        },
        {
          "verse": 11,
          "usfm": "EPH.6.11",
          "line_type": "p",
          "text": "اسلحه تمام خدا را بپوشید تا بتوانید با مکرهای ابلیس مقاومت کنید."
        },
        {
          "verse": 12,
          "usfm": "EPH.6.12",
          "line_type": "p",
          "text": "زیرا که ما را کشتی گرفتن با خون و جسم نیست بلکه با ریاستها و قدرتها وجهان داران این ظلمت و با فوجهای روحانی شرارت در جایهای آسمانی."
        },
        {
          "verse": 13,
          "usfm": "EPH.6.13",
          "line_type": "p",
          "text": "لهذا اسلحه تام خدا را بردارید تا بتوانید در روز شریر مقاومت کنید و همه کار را بهجا آورده، بایستید."
        },
        {
          "verse": 14,
          "usfm": "EPH.6.14",
          "line_type": "p",
          "text": "پس کمر خود را به راستی بسته و جوشن عدالت رادربر کرده، بایستید."
        },
        {
          "verse": 15,
          "usfm": "EPH.6.15",
          "line_type": "p",
          "text": "و نعلین استعداد انجیل سلامتی را در پا کنید."
        },
        {
          "verse": 16,
          "usfm": "EPH.6.16",
          "line_type": "p",
          "text": "و بر روی این همه سپرایمان را بکشید که به آن بتوانید تمامی تیرهای آتشین شریر را خاموش کنید."
        },
        {
          "verse": 17,
          "usfm": "EPH.6.17",
          "line_type": "p",
          "text": "و خود نجات وشمشیر روح را که کلام خداست بردارید."
        },
        {
          "verse": 18,
          "usfm": "EPH.6.18",
          "line_type": "p",
          "text": "و بادعا والتماس تمام در هر وقت در روح دعا کنید وبرای همین به اصرار و التماس تمام بجهت همه مقدسین بیدار باشید."
        },
        {
          "verse": 19,
          "usfm": "EPH.6.19",
          "line_type": "p",
          "text": "و برای من نیز تا کلام به من عطا شود تا باگشادگی زبان سر انجیل را به دلیری اعلام نمایم،"
        },
        {
          "verse": 20,
          "usfm": "EPH.6.20",
          "line_type": "p",
          "text": "که برای آن در زنجیرها ایلچیگری میکنم تادر آن به دلیری سخن گویم، بطوری که میبایدگفت."
        },
        {
          "verse": 21,
          "usfm": "EPH.6.21",
          "line_type": "p",
          "text": "اما تا شما هم از احوال من و از آنچه میکنم مطلع شوید، تیخیکس که برادر عزیز و خادم امین در خداوند است، شما را از هرچیز خواهدآگاهانید،"
        },
        {
          "verse": 22,
          "usfm": "EPH.6.22",
          "line_type": "p",
          "text": "که او را بجهت همین به نزد شمافرستادم تا از احوال ما آگاه باشید و او دلهای شمارا تسلی بخشد."
        },
        {
          "verse": 23,
          "usfm": "EPH.6.23",
          "line_type": "p",
          "text": "برادران را سلام و محبت باایمان از جانب خدای پدر و عیسی مسیح خداوند باد."
        }
      ],
