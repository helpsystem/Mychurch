    {
      "schema_version": 6,
      "book_id": "LAM",
      "chapter": 4,
      "chapter_usfm": "LAM.4",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "LAM.4.1",
          "line_type": "p",
          "text": "چگونه طلا زنگ گرفته و زر خالص منقلب گردیده است؟ سنگهای قدس بهسر هرکوچه ریخته شده است."
        },
        {
          "verse": 2,
          "usfm": "LAM.4.2",
          "line_type": "p",
          "text": "چگونه پسران گرانبهای صهیون که به زر ناب برابر میبودند مثل ظروف سفالین که عمل دست کوزهگر باشد شمرده شدهاند."
        },
        {
          "verse": 3,
          "usfm": "LAM.4.3",
          "line_type": "p",
          "text": "شغالها تیز پستانهای خود را بیرون آورده، بچه های خویش را شیر میدهند. اما دختر قوم من مانند شتر مرغ بری، بیرحم گردیده است."
        },
        {
          "verse": 4,
          "usfm": "LAM.4.4",
          "line_type": "p",
          "text": "زبان اطفال شیرخواره از تشنگی به کام ایشان میچسبد، و کودکان نان میخواهند وکسی به ایشان نمی دهد."
        },
        {
          "verse": 5,
          "usfm": "LAM.4.5",
          "line_type": "p",
          "text": "آنانی که خوراک لذیذ میخورند در کوچه ها بینوا گشتهاند. آنانی که در لباس قرمز تربیت یافتهاند مزبلهها را در آغوش میکشند."
        },
        {
          "verse": 6,
          "usfm": "LAM.4.6",
          "line_type": "p",
          "text": "زیرا که عصیان دختر قوم من از گناه سدوم زیاده است، که در لحظهای واژگون شد و کسی دست بر او ننهاد."
        },
        {
          "verse": 7,
          "usfm": "LAM.4.7",
          "line_type": "p",
          "text": "نذیرگان او از برف، صاف تر و از شیر، سفیدتر بودند. بدن ایشان از لعل سرختر و جلوه ایشان مثل یاقوت کبود بود."
        },
        {
          "verse": 8,
          "usfm": "LAM.4.8",
          "line_type": "p",
          "text": "اما صورت ایشان از سیاهی سیاهتر شده است که در کوچهها شناخته نمی شوند. پوست ایشان به استخوانهایشان چسبیده و خشک شده، مثل چوب گردیده است."
        },
        {
          "verse": 9,
          "usfm": "LAM.4.9",
          "line_type": "p",
          "text": "کشتگان شمشیر از کشتگان گرسنگی بهترند. زیرا که اینان از عدم محصول زمین مجروح شده، کاهیده میگردند."
        },
        {
          "verse": 10,
          "usfm": "LAM.4.10",
          "line_type": "p",
          "text": "زنان مهربان، اولاد خود را میپزند بهدستهای خویش. و آنها در هلاکت دختر قوم من غذای ایشان هستند."
        },
        {
          "verse": 11,
          "usfm": "LAM.4.11",
          "line_type": "p",
          "text": "خداوند غضب خود را به اتمام رسانیده، حدت خشم خویش را ریخته است، و آتشی درصهیون افروخته که اساس آن را سوزانیده است."
        },
        {
          "verse": 12,
          "usfm": "LAM.4.12",
          "line_type": "p",
          "text": "پادشاهان جهان و جمیع سکنه ربع مسکون باور نمی کردند که عدو و دشمن به دروازه های اورشلیم داخل شود."
        },
        {
          "verse": 13,
          "usfm": "LAM.4.13",
          "line_type": "p",
          "text": "بهسبب گناه انبیا و گناه کاهنانش، که خون عادلان را در اندرونش ریختند."
        },
        {
          "verse": 14,
          "usfm": "LAM.4.14",
          "line_type": "p",
          "text": "مثل کوران در کوچهها نوان میشوند و ازخون نجس شدهاند، که لباس ایشان را لمس نمی توانند کرد."
        },
        {
          "verse": 15,
          "usfm": "LAM.4.15",
          "line_type": "p",
          "text": "و به ایشان ندا میکنند که دور شوید، نجس (هستید)! دور شوید دور شوید و لمس منمایید! چون فرار میکردند نوان میشدند و در میان امتها میگفتند که در اینجا دیگر توقف نخواهند کرد."
        },
        {
          "verse": 16,
          "usfm": "LAM.4.16",
          "line_type": "p",
          "text": "خشم خداوند ایشان را پراکنده ساخته وایشان را دیگر منظور نخواهد داشت. به کاهنان ایشان اعتنا نمی کنند و بر مشایخ، رافت ندارند."
        },
        {
          "verse": 17,
          "usfm": "LAM.4.17",
          "line_type": "p",
          "text": "چشمان ما تا حال در انتظار اعانت باطل ماکاهیده میشود. بر دیده بانگاههای خود انتظارکشیدیم، برای امتی که نجات نمی توانند داد."
        },
        {
          "verse": 18,
          "usfm": "LAM.4.18",
          "line_type": "p",
          "text": "قدمهای ما را تعاقب نمودند به حدی که درکوچه های خود راه نمی توانیم رفت. آخرت مانزدیک است و روزهای ما تمام شده زیرا که اجل ما رسیده است."
        },
        {
          "verse": 19,
          "usfm": "LAM.4.19",
          "line_type": "p",
          "text": "تعاقب کنندگان ما از عقابهای هواتیزروتراند. ما را بر کوهها تعاقب میکنند و برای ما در صحرا کمین میگذارند."
        },
        {
          "verse": 20,
          "usfm": "LAM.4.20",
          "line_type": "p",
          "text": "مسیح خداوند که نفخه بینی ما میبود درحفره های ایشان گرفتار شد، که درباره اومی گفتم زیر سایه او در میان امتها، زیست خواهیم نمود."
        },
        {
          "verse": 21,
          "usfm": "LAM.4.21",
          "line_type": "p",
          "text": "مسرور باش و شادی کنای دختر ادوم که در زمین عوص ساکن هستی! بر تو نیز اینجام خواهد رسید و مست شده، عریان خواهی شد."
        },
        {
          "verse": 22,
          "usfm": "LAM.4.22",
          "line_type": "p",
          "text": "ای دختر صهیون سزای گناه تو تمام شد وتو را دیگر جلای وطن نخواهد ساخت. ای دخترادوم، عقوبت گناه تو را به تو خواهد رسانید وگناهان تو را کشف خواهد نمود."
        }
      ],
