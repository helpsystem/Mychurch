  "chapters": [
    {
      "schema_version": 6,
      "book_id": "LAM",
      "chapter": 1,
      "chapter_usfm": "LAM.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "LAM.1.1",
          "line_type": "p",
          "text": "چگونه شهری که پر از مخلوق بود منفردنشسته است! چگونه آنکه در میان امت هابزرگ بود مثل بیوهزن شده است! چگونه آنکه درمیان کشورها ملکه بود خراجگذار گردیده است!"
        },
        {
          "verse": 2,
          "usfm": "LAM.1.2",
          "line_type": "p",
          "text": "شبانگاه زارزار گریه میکند و اشکهایش بررخسارهایش میباشد. از جمیع محبانش برای وی تسلی دهندهای نیست. همه دوستانش بدوخیانت ورزیده، دشمن او شدهاند."
        },
        {
          "verse": 3,
          "usfm": "LAM.1.3",
          "line_type": "p",
          "text": "یهودا بهسبب مصیبت و سختی بندگی، جلای وطن شده است. در میان امتها نشسته، راحت نمی یابد. و جمیع تعاقب کنندگانش درمیان جایهای تنگ به او دررسیدهاند."
        },
        {
          "verse": 4,
          "usfm": "LAM.1.4",
          "line_type": "p",
          "text": "راههای صهیون ماتم میگیرند، چونکه کسی به عیدهای او نمی آید. همه دروازه هایش خراب شده، کاهنانش آه میکشند. دوشیزگانش در مرارت میباشند و خودش در تلخی."
        },
        {
          "verse": 5,
          "usfm": "LAM.1.5",
          "line_type": "p",
          "text": "خصمانش سر شدهاند و دشمنانش فیروزگردیده، زیرا که یهوه بهسبب کثرت عصیانش، اورا ذلیل ساخته است. اطفالش پیش روی دشمن به اسیری رفتهاند."
        },
        {
          "verse": 6,
          "usfm": "LAM.1.6",
          "line_type": "p",
          "text": "و تمامی زیبایی دختر صهیون از او زایل شده، سرورانش مثل غزالهایی که مرتعی پیدانمی کنند گردیده، از حضور تعاقب کننده بیقوت میروند."
        },
        {
          "verse": 7,
          "usfm": "LAM.1.7",
          "line_type": "p",
          "text": "اورشلیم در روزهای مذلت و شقاوت خویش تمام نفایسی را که در ایام سابق داشته بودبه یاد میآورد. زیرا که قوم او بهدست دشمن افتادهاند و برای وی مدد کنندهای نیست. دشمنانش او را دیده، بر خرابیهایش خندیدند."
        },
        {
          "verse": 8,
          "usfm": "LAM.1.8",
          "line_type": "p",
          "text": "اورشلیم به شدت گناه ورزیده و از این سبب مکروه گردیده است. جمیع آنانی که او را محترم میداشتند او را خوار میشمارند چونکه برهنگی او را دیدهاند. و خودش نیز آه میکشد و به عقب برگشته است."
        },
        {
          "verse": 9,
          "usfm": "LAM.1.9",
          "line_type": "p",
          "text": "نجاست او در دامنش میباشد و آخرت خویش را به یاد نمی آورد. و بطور عجیب پست گردیده، برای وی تسلی دهندهای نیست. ای یهوه مذلت مرا ببین زیرا که دشمن تکبر مینماید."
        },
        {
          "verse": 10,
          "usfm": "LAM.1.10",
          "line_type": "p",
          "text": "دشمن دست خویش را بر همه نفایس اودراز کرده است. زیرا امت هایی را که امر فرمودی که به جماعت تو داخل نشوند دیده است که به مقدس او در میآیند."
        },
        {
          "verse": 11,
          "usfm": "LAM.1.11",
          "line_type": "p",
          "text": "تمام قوم او آه کشیده، نان میجویند. تمام نفایس خود را به جهت خوراک دادهاند تا جان خود را تازه کنند. ای یهوه ببین و ملاحظه فرمازیرا که من خوار شدهام."
        },
        {
          "verse": 12,
          "usfm": "LAM.1.12",
          "line_type": "p",
          "text": "ای جمیع راه گذریان آیا این در نظر شماهیچ است؟ ملاحظه کنید و ببینید آیا غمی مثل غم من بوده است که بر من عارض گردیده و یهوه در روز حدت خشم خویش مرا به آن مبتلاساخته است؟"
        },
        {
          "verse": 13,
          "usfm": "LAM.1.13",
          "line_type": "p",
          "text": "آتش از اعلی علیین به استخوانهای من فرستاده، آنها را زبون ساخته است. دام برای پایهایم گسترانیده، مرا به عقب برگردانیده، و مراویران و در تمام روز غمگین ساخته است."
        },
        {
          "verse": 14,
          "usfm": "LAM.1.14",
          "line_type": "p",
          "text": "یوغ عصیان من بهدست وی محکم بسته شده، آنها به هم پیچیده بر گردن من برآمده است. خداوند قوت مرا زایل ساخته و مرا بهدست کسانی که با ایشان مقاومت نتوانم نمود تسلیم کرده است."
        },
        {
          "verse": 15,
          "usfm": "LAM.1.15",
          "line_type": "p",
          "text": "خداوند جمیع شجاعان مرا در میانم تلف ساخته است. جماعتی بر من خوانده است تاجوانان مرا منکسر سازند. و خداوند آن دوشیزه یعنی دختر یهودا را در چرخشت پایمال کرده است."
        },
        {
          "verse": 16,
          "usfm": "LAM.1.16",
          "line_type": "p",
          "text": "بهسبب این چیزها گریه میکنم. از چشم من، از چشم من آب میریزد زیرا تسلی دهنده وتازه کننده جانم از من دور است. پسرانم هلاک شدهاند زیرا که دشمن، غالب آمده است."
        },
        {
          "verse": 17,
          "usfm": "LAM.1.17",
          "line_type": "p",
          "text": "صهیون دستهای خود را دراز میکند امابرایش تسلی دهندهای نیست. یهوه درباره یعقوب امر فرموده است که مجاورانش دشمن اوبشوند، پس اورشلیم در میان آنها مکروه گردیده است."
        },
        {
          "verse": 18,
          "usfm": "LAM.1.18",
          "line_type": "p",
          "text": "یهوه عادل است زیرا که من از فرمان اوعصیان ورزیدهام. ای جمیع امتها بشنوید و غم مرا مشاهده نمایید! دوشیزگان و جوانان من به اسیری رفتهاند."
        },
        {
          "verse": 19,
          "usfm": "LAM.1.19",
          "line_type": "p",
          "text": "محبان خویش را خواندم اما ایشان مرافریب دادند. کاهنان و مشایخ من که خوراک میجستند تا جان خود را تازه کنند در شهر جان دادند."
        },
        {
          "verse": 20,
          "usfm": "LAM.1.20",
          "line_type": "p",
          "text": "ای یهوه نظر کن زیرا که در تنگی هستم. احشایم میجوشد و دلم در اندرون من منقلب شده است چونکه به شدت عصیان ورزیدهام. دربیرون شمشیر هلاک میکند و در خانهها مثل موت است."
        },
        {
          "verse": 21,
          "usfm": "LAM.1.21",
          "line_type": "p",
          "text": "میشنوند که آه میکشم اما برایم تسلی دهندهای نیست. دشمنانم چون بلای مراشنیدند، مسرور شدند که تو این را کردهای. اما توروزی را که اعلان نمودهای خواهی آورد و ایشان مثل من خواهند شد."
        },
        {
          "verse": 22,
          "usfm": "LAM.1.22",
          "line_type": "p",
          "text": "تمامی شرارت ایشان به نظر تو بیاید. وچنانکه با من بهسبب تمامی معصیتم عمل نمودی به ایشان نیز عمل نما. زیرا که ناله های من بسیار است و دلم بیتاب شده است."
        }
      ],
