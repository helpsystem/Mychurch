    {
      "schema_version": 6,
      "book_id": "LAM",
      "chapter": 5,
      "chapter_usfm": "LAM.5",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "LAM.5.1",
          "line_type": "p",
          "text": "ای یهوه آنچه بر ما واقع شد به یاد آور وملاحظه فرموده، عار ما را ببین."
        },
        {
          "verse": 2,
          "usfm": "LAM.5.2",
          "line_type": "p",
          "text": "میراث ما از آن غریبان و خانه های ما از آن اجنبیان گردیده است."
        },
        {
          "verse": 3,
          "usfm": "LAM.5.3",
          "line_type": "p",
          "text": "ما یتیم و بیپدر شدهایم و مادران ما مثل بیوهها گردیدهاند."
        },
        {
          "verse": 4,
          "usfm": "LAM.5.4",
          "line_type": "p",
          "text": "آب خود را به نقره مینوشیم و هیزم ما به مافروخته میشود."
        },
        {
          "verse": 5,
          "usfm": "LAM.5.5",
          "line_type": "p",
          "text": "تعاقب کنندگان ما به گردن ما رسیدهاند وخسته شده، راحت نداریم."
        },
        {
          "verse": 6,
          "usfm": "LAM.5.6",
          "line_type": "p",
          "text": "با اهل مصر و آشور دست دادیم تا از نان سیرشویم."
        },
        {
          "verse": 7,
          "usfm": "LAM.5.7",
          "line_type": "p",
          "text": "پدران ما گناه ورزیده، نابود شدهاند و مامتحمل عصیان ایشان گردیدهایم."
        },
        {
          "verse": 8,
          "usfm": "LAM.5.8",
          "line_type": "p",
          "text": "غلامان بر ما حکمرانی میکنند و کسی نیست که از دست ایشان رهایی دهد."
        },
        {
          "verse": 9,
          "usfm": "LAM.5.9",
          "line_type": "p",
          "text": "از ترس شمشیر اهل بیابان، نان خود را بخطرجان خویش مییابیم."
        },
        {
          "verse": 10,
          "usfm": "LAM.5.10",
          "line_type": "p",
          "text": "پوست ما بهسبب سموم قحط مثل تنورسوخته شده است."
        },
        {
          "verse": 11,
          "usfm": "LAM.5.11",
          "line_type": "p",
          "text": "زنان را در صهیون بیعصمت کردند ودوشیزگان را در شهرهای یهودا."
        },
        {
          "verse": 12,
          "usfm": "LAM.5.12",
          "line_type": "p",
          "text": "سروران از دست ایشان به دار کشیده شده و به مشایخ اعتنا ننمودند."
        },
        {
          "verse": 13,
          "usfm": "LAM.5.13",
          "line_type": "p",
          "text": "جوانان سنگهای آسیا را برمی دارند وکودکان زیر بار هیزم میافتند."
        },
        {
          "verse": 14,
          "usfm": "LAM.5.14",
          "line_type": "p",
          "text": "مشایخ از دروازهها نابود شدند و جوانان ازنغمه سرایی خویش."
        },
        {
          "verse": 15,
          "usfm": "LAM.5.15",
          "line_type": "p",
          "text": "شادی دل ما نیست شد و رقص ما به ماتم مبدل گردید."
        },
        {
          "verse": 16,
          "usfm": "LAM.5.16",
          "line_type": "p",
          "text": "تاج از سر ما افتاد، وای بر ما زیرا که گناه کردیم."
        },
        {
          "verse": 17,
          "usfm": "LAM.5.17",
          "line_type": "p",
          "text": "از این جهت دل ما بیتاب شده است و بهسبب این چیزها چشمان ما تار گردیده است."
        },
        {
          "verse": 18,
          "usfm": "LAM.5.18",
          "line_type": "p",
          "text": "یعنی بهخاطر کوه صهیون که ویران شد وروباهان در آن گردش میکنند."
        },
        {
          "verse": 19,
          "usfm": "LAM.5.19",
          "line_type": "p",
          "text": "اما توای یهوه تا ابدالاباد جلوس میفرمایی و کرسی تو تا جمیع دهرها خواهدبود."
        },
        {
          "verse": 20,
          "usfm": "LAM.5.20",
          "line_type": "p",
          "text": "پس برای چه ما را تا به ابد فراموش کرده وما را مدت مدیدی ترک نمودهای."
        },
        {
          "verse": 21,
          "usfm": "LAM.5.21",
          "line_type": "p",
          "text": "ای یهوه ما را بسوی خود برگردان وبازگشت خواهیم کرد و ایام ما را مثل زمان سلف تازه کن."
        }
      ],
