    {
      "schema_version": 6,
      "book_id": "LAM",
      "chapter": 3,
      "chapter_usfm": "LAM.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "LAM.3.1",
          "line_type": "p",
          "text": "من آن مرد هستم که از عصای غضب وی مذلت دیدهام."
        },
        {
          "verse": 2,
          "usfm": "LAM.3.2",
          "line_type": "p",
          "text": "او مرا رهبری نموده، به تاریکی درآورده است و نه به روشنایی."
        },
        {
          "verse": 3,
          "usfm": "LAM.3.3",
          "line_type": "p",
          "text": "به درستی که دست خویش را تمامی روز به ضد من بارها برگردانیده است."
        },
        {
          "verse": 4,
          "usfm": "LAM.3.4",
          "line_type": "p",
          "text": "گوشت و پوست مرا مندرس ساخته واستخوانهایم را خرد کرده است."
        },
        {
          "verse": 5,
          "usfm": "LAM.3.5",
          "line_type": "p",
          "text": "به ضد من بنا نموده، مرا به تلخی و مشقت احاطه کرده است."
        },
        {
          "verse": 6,
          "usfm": "LAM.3.6",
          "line_type": "p",
          "text": "مرا مثل آنانی که از قدیم مردهاند در تاریکی نشانیده است."
        },
        {
          "verse": 7,
          "usfm": "LAM.3.7",
          "line_type": "p",
          "text": "گرد من حصار کشیده که نتوانم بیرون آمد وزنجیر مرا سنگین ساخته است."
        },
        {
          "verse": 8,
          "usfm": "LAM.3.8",
          "line_type": "p",
          "text": "و نیز چون فریاد و استغاثه مینمایم دعای مرا منع میکند."
        },
        {
          "verse": 9,
          "usfm": "LAM.3.9",
          "line_type": "p",
          "text": "راههای مرا با سنگهای تراشیده سد کرده است و طریقهایم را کج نموده است."
        },
        {
          "verse": 10,
          "usfm": "LAM.3.10",
          "line_type": "p",
          "text": "او برای من خرسی است در کمین نشسته وشیری که در بیشه خود میباشد."
        },
        {
          "verse": 11,
          "usfm": "LAM.3.11",
          "line_type": "p",
          "text": "راه مرا منحرف ساخته، مرا دریده است ومرا مبهوت گردانیده است."
        },
        {
          "verse": 12,
          "usfm": "LAM.3.12",
          "line_type": "p",
          "text": "کمان خود را زه کرده، مرا برای تیرهای خویش، هدف ساخته است."
        },
        {
          "verse": 13,
          "usfm": "LAM.3.13",
          "line_type": "p",
          "text": "و تیرهای ترکش خود را به گرده های من فرو برده است."
        },
        {
          "verse": 14,
          "usfm": "LAM.3.14",
          "line_type": "p",
          "text": "من به جهت تمامی قوم خود مضحکه وتمامی روز سرود ایشان شدهام."
        },
        {
          "verse": 15,
          "usfm": "LAM.3.15",
          "line_type": "p",
          "text": "مرا به تلخیها سیر کرده و مرا به افسنتین مست گردانیده است."
        },
        {
          "verse": 16,
          "usfm": "LAM.3.16",
          "line_type": "p",
          "text": "دندانهایم را به سنگ ریزها شکسته و مرا به خاکستر پوشانیده است."
        },
        {
          "verse": 17,
          "usfm": "LAM.3.17",
          "line_type": "p",
          "text": "تو جان مرا از سلامتی دور انداختی و من سعادتمندی را فراموش کردم،"
        },
        {
          "verse": 18,
          "usfm": "LAM.3.18",
          "line_type": "p",
          "text": "و گفتم که قوت و امید من از یهوه تلف شده است."
        },
        {
          "verse": 19,
          "usfm": "LAM.3.19",
          "line_type": "p",
          "text": "مذلت و شقاوت مرا افسنتین و تلخی به یادآور."
        },
        {
          "verse": 20,
          "usfm": "LAM.3.20",
          "line_type": "p",
          "text": "تو البته به یاد خواهی آورد زیرا که جان من در من منحنی شده است."
        },
        {
          "verse": 21,
          "usfm": "LAM.3.21",
          "line_type": "p",
          "text": "و من آن را در دل خود خواهم گذرانید و ازاین سبب امیدوار خواهم بود."
        },
        {
          "verse": 22,
          "usfm": "LAM.3.22",
          "line_type": "p",
          "text": "از رافت های خداوند است که تلف نشدیم زیرا که رحمت های او بیزوال است."
        },
        {
          "verse": 23,
          "usfm": "LAM.3.23",
          "line_type": "p",
          "text": "آنها هر صبح تازه میشود و امانت تو بسیاراست."
        },
        {
          "verse": 24,
          "usfm": "LAM.3.24",
          "line_type": "p",
          "text": "و جان من میگوید که خداوند نصیب من است، بنابراین بر او امیدوارم."
        },
        {
          "verse": 25,
          "usfm": "LAM.3.25",
          "line_type": "p",
          "text": "خداوند به جهت کسانی که بر او توکل دارند و برای آنانی که او را میطلبند نیکو است."
        },
        {
          "verse": 26,
          "usfm": "LAM.3.26",
          "line_type": "p",
          "text": "خوب است که انسان امیدوار باشد و باسکوت انتظار نجات خداوند را بکشد."
        },
        {
          "verse": 27,
          "usfm": "LAM.3.27",
          "line_type": "p",
          "text": "برای انسان نیکو است که یوغ را در جوانی خود بردارد."
        },
        {
          "verse": 28,
          "usfm": "LAM.3.28",
          "line_type": "p",
          "text": "به تنهایی بنشیند و ساکت باشد زیرا که اوآن را بر وی نهاده است."
        },
        {
          "verse": 29,
          "usfm": "LAM.3.29",
          "line_type": "p",
          "text": "دهان خود را بر خاک بگذارد که شاید امیدباشد."
        },
        {
          "verse": 30,
          "usfm": "LAM.3.30",
          "line_type": "p",
          "text": "رخسار خود را به زنندگان بسپارد و ازخجالت سیر شود."
        },
        {
          "verse": 31,
          "usfm": "LAM.3.31",
          "line_type": "p",
          "text": "زیرا خداوند تا به ابد او را ترک نخواهدنمود."
        },
        {
          "verse": 32,
          "usfm": "LAM.3.32",
          "line_type": "p",
          "text": "زیرا اگرچه کسی را محزون سازد لیکن برحسب کثرت رافت خود رحمت خواهد فرمود."
        },
        {
          "verse": 33,
          "usfm": "LAM.3.33",
          "line_type": "p",
          "text": "چونکه بنی آدم را از دل خود نمی رنجاند ومحزون نمی سازد."
        },
        {
          "verse": 34,
          "usfm": "LAM.3.34",
          "line_type": "p",
          "text": "تمامی اسیران زمین را زیر پا پایمال کردن،"
        },
        {
          "verse": 35,
          "usfm": "LAM.3.35",
          "line_type": "p",
          "text": "و منحرف ساختن حق انسان به حضورحضرت اعلی،"
        },
        {
          "verse": 36,
          "usfm": "LAM.3.36",
          "line_type": "p",
          "text": "و منقلب نمودن آدمی در دعویش منظورخداوند نیست."
        },
        {
          "verse": 37,
          "usfm": "LAM.3.37",
          "line_type": "p",
          "text": "کیست که بگوید و واقع شود اگر خداوندامر نفرموده باشد."
        },
        {
          "verse": 38,
          "usfm": "LAM.3.38",
          "line_type": "p",
          "text": "آیا از فرمان حضرت اعلی هم بدی و هم نیکویی صادر نمی شود؟"
        },
        {
          "verse": 39,
          "usfm": "LAM.3.39",
          "line_type": "p",
          "text": "پس چرا انسان تا زنده است و آدمی بهسبب سزای گناهان خویش شکایت کند؟"
        },
        {
          "verse": 40,
          "usfm": "LAM.3.40",
          "line_type": "p",
          "text": "راههای خود را تجسس و تفحص بنماییم و بسوی خداوند بازگشت کنیم."
        },
        {
          "verse": 41,
          "usfm": "LAM.3.41",
          "line_type": "p",
          "text": "دلها و دستهای خویش را بسوی خدایی که در آسمان است برافرازیم،"
        },
        {
          "verse": 42,
          "usfm": "LAM.3.42",
          "line_type": "p",
          "text": "(و بگوییم ): «ما گناه کردیم و عصیان ورزیدیم و تو عفو نفرمودی."
        },
        {
          "verse": 43,
          "usfm": "LAM.3.43",
          "line_type": "p",
          "text": "خویشتن را به غضب پوشانیده، ما را تعاقب نمودی و به قتل رسانیده، شفقت نفرمودی."
        },
        {
          "verse": 44,
          "usfm": "LAM.3.44",
          "line_type": "p",
          "text": "خویشتن را به ابر غلیظ مستور ساختی، تادعای ما نگذرد."
        },
        {
          "verse": 45,
          "usfm": "LAM.3.45",
          "line_type": "p",
          "text": "ما را در میان امتها فضله و خاکروبه گردانیدهای.»"
        },
        {
          "verse": 46,
          "usfm": "LAM.3.46",
          "line_type": "p",
          "text": "تمامی دشمنان ما بر ما دهان خود رامی گشایند."
        },
        {
          "verse": 47,
          "usfm": "LAM.3.47",
          "line_type": "p",
          "text": "خوف و دام و هلاکت و خرابی بر ما عارض گردیده است."
        },
        {
          "verse": 48,
          "usfm": "LAM.3.48",
          "line_type": "p",
          "text": "بهسبب هلاکت دختر قوم من، نهرهای آب از چشمانم میریزد."
        },
        {
          "verse": 49,
          "usfm": "LAM.3.49",
          "line_type": "p",
          "text": "چشم من بلا انقطاع جاری است و بازنمی ایستد."
        },
        {
          "verse": 50,
          "usfm": "LAM.3.50",
          "line_type": "p",
          "text": "تا خداوند از آسمان ملاحظه نماید و ببیند."
        },
        {
          "verse": 51,
          "usfm": "LAM.3.51",
          "line_type": "p",
          "text": "چشمانم به جهت جمیع دختران شهرم، جان مرا میرنجاند."
        },
        {
          "verse": 52,
          "usfm": "LAM.3.52",
          "line_type": "p",
          "text": "آنانی که بیسبب دشمن منند مرا مثل مرغ بشدت تعاقب مینمایند."
        },
        {
          "verse": 53,
          "usfm": "LAM.3.53",
          "line_type": "p",
          "text": "جان مرا در سیاه چال منقطع ساختند وسنگها بر منانداختند."
        },
        {
          "verse": 54,
          "usfm": "LAM.3.54",
          "line_type": "p",
          "text": "آبها از سر من گذشت پس گفتم: منقطع شدم."
        },
        {
          "verse": 55,
          "usfm": "LAM.3.55",
          "line_type": "p",
          "text": "آنگاهای خداوند، از عمق های سیاه چال اسم تو را خواندم."
        },
        {
          "verse": 56,
          "usfm": "LAM.3.56",
          "line_type": "p",
          "text": "آواز مرا شنیدی، پس گوش خود را از آه واستغاثه من مپوشان!"
        },
        {
          "verse": 57,
          "usfm": "LAM.3.57",
          "line_type": "p",
          "text": "در روزی که تو را خواندم نزدیک شده، فرمودی که نترس."
        },
        {
          "verse": 58,
          "usfm": "LAM.3.58",
          "line_type": "p",
          "text": "ای خداوند دعوی جان مرا انجام داده و حیات مرا فدیه نمودهای!"
        },
        {
          "verse": 59,
          "usfm": "LAM.3.59",
          "line_type": "p",
          "text": "ای خداوند ظلمی را که به من نموده انددیدهای پس مرا دادرسی فرما!"
        },
        {
          "verse": 60,
          "usfm": "LAM.3.60",
          "line_type": "p",
          "text": "تمامی کینه ایشان و همه تدبیرهایی را که به ضد من کردند دیدهای."
        },
        {
          "verse": 61,
          "usfm": "LAM.3.61",
          "line_type": "p",
          "text": "ای خداوند مذمت ایشان را و همه تدبیرهایی را که به ضد من کردند شنیدهای!"
        },
        {
          "verse": 62,
          "usfm": "LAM.3.62",
          "line_type": "p",
          "text": "سخنان مقاومت کنندگانم را و فکرهایی راکه تمامی روز به ضد من دارند (دانستهای )."
        },
        {
          "verse": 63,
          "usfm": "LAM.3.63",
          "line_type": "p",
          "text": "نشستن و برخاستن ایشان را ملاحظه فرمازیرا که من سرود ایشان شدهام."
        },
        {
          "verse": 64,
          "usfm": "LAM.3.64",
          "line_type": "p",
          "text": "ای خداوند موافق اعمال دستهای ایشان مکافات به ایشان برسان."
        },
        {
          "verse": 65,
          "usfm": "LAM.3.65",
          "line_type": "p",
          "text": "غشاوه قلب به ایشان بده و لعنت تو برایشان باد!"
        },
        {
          "verse": 66,
          "usfm": "LAM.3.66",
          "line_type": "p",
          "text": "ایشان را به غضب تعاقب نموده، از زیرآسمانهای خداوند هلاک کن."
        }
      ],
