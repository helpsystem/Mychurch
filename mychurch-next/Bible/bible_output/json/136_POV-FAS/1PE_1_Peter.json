    {
      "schema_version": 6,
      "book_id": "1PE",
      "chapter": 4,
      "chapter_usfm": "1PE.4",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1PE.4.1",
          "line_type": "p",
          "text": "لهذا چون مسیح بحسب جسم برای مازحمت کشید، شما نیز به همان نیت مسلح شوید زیرا آنکه بحسب جسم زحمت کشید، ازگناه بازداشته شده است."
        },
        {
          "verse": 2,
          "usfm": "1PE.4.2",
          "line_type": "p",
          "text": "تا آنکه بعد از آن مابقی عمر را در جسم نه بحسب شهوات انسانی بلکه موافق اراده خدا بسر برد."
        },
        {
          "verse": 3,
          "usfm": "1PE.4.3",
          "line_type": "p",
          "text": "زیرا که عمر گذشته کافی است برای عمل نمودن به خواهش امتها ودر فجور و شهوات و میگساری و عیاشی و بزمهاو بتپرستیهای حرام رفتار نمودن."
        },
        {
          "verse": 4,
          "usfm": "1PE.4.4",
          "line_type": "p",
          "text": "و در این متعجب هستند که شما همراه ایشان به سوی همین اسراف اوباشی نمی شتابید و شما را دشنام میدهند."
        },
        {
          "verse": 5,
          "usfm": "1PE.4.5",
          "line_type": "p",
          "text": "و ایشان حساب خواهند داد بدو که مستعد است تا زندگان و مردگان را داوری نماید."
        },
        {
          "verse": 6,
          "usfm": "1PE.4.6",
          "line_type": "p",
          "text": "زیرا که از اینجهت نیز به مردگان بشارت داده شد تا بر ایشان موافق مردم بحسب جسم حکم شود و موافق خدا بحسب روح زیست نمایند."
        },
        {
          "verse": 7,
          "usfm": "1PE.4.7",
          "line_type": "p",
          "text": "لکن انتهای همهچیز نزدیک است. پس خرداندیش و برای دعا هشیار باشید."
        },
        {
          "verse": 8,
          "usfm": "1PE.4.8",
          "line_type": "p",
          "text": "و اول همه با یکدیگر بشدت محبت نمایید زیرا که محبت کثرت گناهان را میپوشاند."
        },
        {
          "verse": 9,
          "usfm": "1PE.4.9",
          "line_type": "p",
          "text": "و یکدیگر را بدون همهمه مهمانی کنید."
        },
        {
          "verse": 10,
          "usfm": "1PE.4.10",
          "line_type": "p",
          "text": "و هریک بحسب نعمتی که یافته باشد، یکدیگر را در آن خدمت نماید، مثل وکلاء امین فیض گوناگون خدا."
        },
        {
          "verse": 11,
          "usfm": "1PE.4.11",
          "line_type": "p",
          "text": "اگر کسی سخن گوید، مانند اقوال خدا بگوید و اگر کسی خدمت کند، برحسب توانایی که خدا بدو داده باشد بکند تا در همهچیز، خدا بواسطه عیسی مسیح جلال یابد که او را جلال و توانایی تاابدالاباد هست، آمین."
        },
        {
          "verse": 12,
          "usfm": "1PE.4.12",
          "line_type": "p",
          "text": "ای حبیبان، تعجب منمایید از این آتشی که در میان شماست و بجهت امتحان شما میآید که گویا چیزی غریب بر شما واقع شده باشد."
        },
        {
          "verse": 13,
          "usfm": "1PE.4.13",
          "line_type": "p",
          "text": "بلکه بقدری که شریک زحمات مسیح هستید، خشنودشوید تا در هنگام ظهور جلال وی شادی و وجدنمایید."
        },
        {
          "verse": 14,
          "usfm": "1PE.4.14",
          "line_type": "p",
          "text": "اگر بخاطر نام مسیح رسوایی میکشید، خوشابحال شما زیرا که روح جلال وروح خدا بر شما آرام میگیرد."
        },
        {
          "verse": 15,
          "usfm": "1PE.4.15",
          "line_type": "p",
          "text": "پس زنهار هیچیکی از شما چون قاتل یا دزد یا شریر یا فضول عذاب نکشد."
        },
        {
          "verse": 16,
          "usfm": "1PE.4.16",
          "line_type": "p",
          "text": "لکن اگر چون مسیحی عذاب بکشد، پس شرمنده نشود بلکه به این اسم خدا راتمجید نماید."
        },
        {
          "verse": 17,
          "usfm": "1PE.4.17",
          "line_type": "p",
          "text": "زیرا این زمان است که داوری ازخانه خدا شروع شود؛ و اگر شروع آن از ماست، پس عاقبت کسانی که انجیل خدا را اطاعت نمی کنند چه خواهد شد؟"
        },
        {
          "verse": 18,
          "usfm": "1PE.4.18",
          "line_type": "p",
          "text": "و اگر عادل به دشواری نجات یابد، بیدین و گناهکار کجا یافت خواهد شد؟"
        },
        {
          "verse": 19,
          "usfm": "1PE.4.19",
          "line_type": "p",
          "text": "پس کسانی نیز که برحسب اراده خدا زحمت کشند، جانهای خود را در نیکوکاری به خالق امین بسپارند."
        }
      ],
