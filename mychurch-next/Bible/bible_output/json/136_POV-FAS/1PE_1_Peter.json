    {
      "schema_version": 6,
      "book_id": "1PE",
      "chapter": 5,
      "chapter_usfm": "1PE.5",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1PE.5.1",
          "line_type": "p",
          "text": "پیران را در میان شما نصیحت میکنم، من که نیز با شما پیر هستم و شاهد بر زحمات مسیح و شریک در جلالی که مکشوف خواهدشد."
        },
        {
          "verse": 2,
          "usfm": "1PE.5.2",
          "line_type": "p",
          "text": "گله خدا را که در میان شماست بچرانید ونظارت آن را بکنید، نه به زور بلکه به رضامندی ونه بجهت سود قبیح بلکه به رغبت؛"
        },
        {
          "verse": 3,
          "usfm": "1PE.5.3",
          "line_type": "p",
          "text": "و نهچنانکه بر قسمت های خود خداوندی بکنید بلکه بجهت گله نمونه باشید،"
        },
        {
          "verse": 4,
          "usfm": "1PE.5.4",
          "line_type": "p",
          "text": "تا در وقتی که رئیس شبانان ظاهر شود، تاج ناپژمرده جلال را بیابید."
        },
        {
          "verse": 5,
          "usfm": "1PE.5.5",
          "line_type": "p",
          "text": "همچنینای جوانان، مطیع پیران باشید بلکه همه با یکدیگر فروتنی را بر خود ببندید زیرا خدابا متکبران مقاومت میکند و فروتنان را فیض میبخشد."
        },
        {
          "verse": 6,
          "usfm": "1PE.5.6",
          "line_type": "p",
          "text": "پس زبردست زورآور خدا فروتنی نمایید تا شما را در وقت معین سرافراز نماید."
        },
        {
          "verse": 7,
          "usfm": "1PE.5.7",
          "line_type": "p",
          "text": "وتمام اندیشه خود را به وی واگذارید زیرا که اوبرای شما فکر میکند."
        },
        {
          "verse": 8,
          "usfm": "1PE.5.8",
          "line_type": "p",
          "text": "هشیار و بیدار باشید زیراکه دشمن شما ابلیس مانند شیر غران گردش میکند و کسی را میطلبد تا ببلعد."
        },
        {
          "verse": 9,
          "usfm": "1PE.5.9",
          "line_type": "p",
          "text": "پس به ایمان استوار شده، با او مقاومت کنید، چون آگاه هستیدکه همین زحمات بر برادران شما که در دنیاهستند، میآید."
        },
        {
          "verse": 10,
          "usfm": "1PE.5.10",
          "line_type": "p",
          "text": "و خدای همه فیضها که ما را به جلال ابدی خود در عیسی مسیح خوانده، است، شما را بعداز کشیدن زحمتی قلیل کامل و استوار و تواناخواهد ساخت."
        },
        {
          "verse": 11,
          "usfm": "1PE.5.11",
          "line_type": "p",
          "text": "او را تا ابدالاباد جلال وتوانایی باد، آمین."
        },
        {
          "verse": 12,
          "usfm": "1PE.5.12",
          "line_type": "p",
          "text": "به توسط سلوانس که او را برادر امین شمامی شمارم، مختصری نوشتم و نصیحت وشهادت میدهم که همین است فیض حقیقی خداکه بر آن قائم هستید."
        },
        {
          "verse": 13,
          "usfm": "1PE.5.13",
          "line_type": "p",
          "text": "خواهر برگزیده با شما که در بابل است و پسر من مرقس به شما سلام میرسانند."
        }
      ],
