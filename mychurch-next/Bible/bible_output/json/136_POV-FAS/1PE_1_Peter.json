    {
      "schema_version": 6,
      "book_id": "1PE",
      "chapter": 3,
      "chapter_usfm": "1PE.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1PE.3.1",
          "line_type": "p",
          "text": "همچنینای زنان، شوهران خود را اطاعت نمایید تا اگر بعضی نیز مطیع کلام نشوند، سیرت زنان، ایشان را بدون کلام دریابد،"
        },
        {
          "verse": 2,
          "usfm": "1PE.3.2",
          "line_type": "p",
          "text": "چونکه سیرت طاهر و خداترس شما را بینند."
        },
        {
          "verse": 3,
          "usfm": "1PE.3.3",
          "line_type": "p",
          "text": "و شما رازینت ظاهری نباشد، از بافتن موی و متحلی شدن به طلا و پوشیدن لباس،"
        },
        {
          "verse": 4,
          "usfm": "1PE.3.4",
          "line_type": "p",
          "text": "بلکه انسانیت باطنی قلبی در لباس غیر فاسد روح حلیم و آرام که نزدخدا گرانبهاست."
        },
        {
          "verse": 5,
          "usfm": "1PE.3.5",
          "line_type": "p",
          "text": "زیرا بدینگونه زنان مقدسه درسابق نیز که متوکل به خدا بودند، خویشتن رازینت مینمودند و شوهران خود را اطاعت میکردند."
        },
        {
          "verse": 6,
          "usfm": "1PE.3.6",
          "line_type": "p",
          "text": "مانند ساره که ابراهیم را مطیع میبودو او را آقا میخواند و شما دختران او شدهاید، اگر نیکویی کنید و از هیچ خوف ترسان نشوید."
        },
        {
          "verse": 7,
          "usfm": "1PE.3.7",
          "line_type": "p",
          "text": "و همچنینای شوهران، با فطانت با ایشان زیست کنید، چون با ظروف ضعیف تر زنانه، وایشان را محترم دارید چون با شما وارث فیض حیات نیز هستند تا دعاهای شما بازداشته نشود."
        },
        {
          "verse": 8,
          "usfm": "1PE.3.8",
          "line_type": "p",
          "text": "خلاصه همه شما یکرای و همدرد و برادردوست و مشفق و فروتن باشید."
        },
        {
          "verse": 9,
          "usfm": "1PE.3.9",
          "line_type": "p",
          "text": "و بدی بعوض بدی و دشنام بعوض دشنام مدهید، بلکه برعکس برکت بطلبید زیرا که میدانید برای این خوانده شدهاید تا وارث برکت شوید."
        },
        {
          "verse": 10,
          "usfm": "1PE.3.10",
          "line_type": "p",
          "text": "زیرا «هرکه میخواهد حیات را دوست دارد و ایام نیکو بیند، زبان خود را از بدی و لبهای خود را از فریب گفتن باز بدارد؛"
        },
        {
          "verse": 11,
          "usfm": "1PE.3.11",
          "line_type": "p",
          "text": "از بدی اعراض نماید و نیکویی رابهجا آورد؛ سلامتی را بطلبد و آن را تعاقب نماید."
        },
        {
          "verse": 12,
          "usfm": "1PE.3.12",
          "line_type": "p",
          "text": "از آنرو که چشمان خداوند بر عادلان است وگوشهای او به سوی دعای ایشان، لکن روی خداوند بر بدکاران است.»"
        },
        {
          "verse": 13,
          "usfm": "1PE.3.13",
          "line_type": "p",
          "text": "و اگر برای نیکویی غیور هستید، کیست که به شما ضرری برساند؟"
        },
        {
          "verse": 14,
          "usfm": "1PE.3.14",
          "line_type": "p",
          "text": "بلکه هرگاه برای عدالت زحمت کشیدید، خوشابحال شما. پس ازخوف ایشان ترسان و مضطرب مشوید."
        },
        {
          "verse": 15,
          "usfm": "1PE.3.15",
          "line_type": "p",
          "text": "بلکه خداوند مسیح را در دل خود تقدیس نمایید وپیوسته مستعد باشید تا هرکه سبب امیدی را که دارید از شما بپرسد، او را جواب دهید، لیکن باحلم و ترس."
        },
        {
          "verse": 16,
          "usfm": "1PE.3.16",
          "line_type": "p",
          "text": "و ضمیر خود را نیکو بدارید تاآنانی که بر سیرت نیکوی شما در مسیح طعن میزنند، در همان چیزی که شما را بد میگویندخجالت کشند،"
        },
        {
          "verse": 17,
          "usfm": "1PE.3.17",
          "line_type": "p",
          "text": "زیرا اگر اراده خدا چنین است، نیکوکار بودن و زحمت کشیدن، بهتر است ازبدکردار بودن."
        },
        {
          "verse": 18,
          "usfm": "1PE.3.18",
          "line_type": "p",
          "text": "زیرا که مسیح نیز برای گناهان یک بار زحمت کشید، یعنی عادلی برای ظالمان، تا ما را نزد خدا بیاورد؛ در حالیکه بحسب جسم مرد، لکن بحسب روح زنده گشت،"
        },
        {
          "verse": 19,
          "usfm": "1PE.3.19",
          "line_type": "p",
          "text": "و به آن روح نیز رفت و موعظه نمود به ارواحی که درزندان بودند،"
        },
        {
          "verse": 20,
          "usfm": "1PE.3.20",
          "line_type": "p",
          "text": "که سابق نافرمانبردار بودندهنگامی که حلم خدا در ایام نوح انتظار میکشید، وقتی که کشتی بنا میشد، که در آن جماعتی قلیل یعنی هشت نفر به آب نجات یافتند،"
        },
        {
          "verse": 21,
          "usfm": "1PE.3.21",
          "line_type": "p",
          "text": "که نمونه آن یعنی تعمید اکنون ما را نجات میبخشد (نه دور کردن کثافت جسم بلکه امتحان ضمیر صالح به سوی خدا) بواسطه برخاستن عیسی مسیح،"
        },
        {
          "verse": 22,
          "usfm": "1PE.3.22",
          "line_type": "p",
          "text": "که به آسمان رفت و بدست راست خدا است وفرشتگان و قدرتها و قوات مطیع او شدهاند."
        }
      ],
