    {
      "schema_version": 6,
      "book_id": "1PE",
      "chapter": 2,
      "chapter_usfm": "1PE.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1PE.2.1",
          "line_type": "p",
          "text": "لهذا هر نوع کینه و هر مکر و ریا و حسد وهرقسم بدگویی را ترک کرده،"
        },
        {
          "verse": 2,
          "usfm": "1PE.2.2",
          "line_type": "p",
          "text": "چون اطفال نوزاده، مشتاق شیر روحانی و بیغش باشید تا از آن برای نجات نمو کنید،"
        },
        {
          "verse": 3,
          "usfm": "1PE.2.3",
          "line_type": "p",
          "text": "اگرفی الواقع چشیدهاید که خداوند مهربان است."
        },
        {
          "verse": 4,
          "usfm": "1PE.2.4",
          "line_type": "p",
          "text": "و به او تقرب جسته، یعنی به آن سنگ زنده رد شده از مردم، لکن نزد خدا برگزیده و مکرم."
        },
        {
          "verse": 5,
          "usfm": "1PE.2.5",
          "line_type": "p",
          "text": "شما نیز مثل سنگهای زنده بنا کرده میشوید به عمارت روحانی و کهانت مقدس تا قربانی های روحانی و مقبول خدا را بواسطه عیسی مسیح بگذرانید."
        },
        {
          "verse": 6,
          "usfm": "1PE.2.6",
          "line_type": "p",
          "text": "بنابراین، در کتاب مکتوب است که «اینک مینهم در صهیون سنگی سر زاویه برگزیده و مکرم و هرکه به وی ایمان آورد خجل نخواهد شد.»"
        },
        {
          "verse": 7,
          "usfm": "1PE.2.7",
          "line_type": "p",
          "text": "پس شما را که ایمان دارید اکرام است، لکن آنانی را که ایمان ندارند، «آن سنگی که معماران رد کردند، همان سر زاویه گردید»،"
        },
        {
          "verse": 8,
          "usfm": "1PE.2.8",
          "line_type": "p",
          "text": "و «سنگ لغزش دهنده و صخره مصادم»، زیرا که اطاعت کلام نکرده، لغزش میخورند که برای همین معین شدهاند."
        },
        {
          "verse": 9,
          "usfm": "1PE.2.9",
          "line_type": "p",
          "text": "لکن شما قبیله برگزیده و کهانت ملوکانه وامت مقدس و قومی که ملک خاص خدا باشدهستید تا فضایل او را که شما را از ظلمت، به نورعجیب خود خوانده است، اعلام نمایید."
        },
        {
          "verse": 10,
          "usfm": "1PE.2.10",
          "line_type": "p",
          "text": "که سابق قومی نبودید و الان قوم خدا هستید. آن وقت از رحمت محروم، اما الحال رحمت کرده شدهاید."
        },
        {
          "verse": 11,
          "usfm": "1PE.2.11",
          "line_type": "p",
          "text": "ای محبوبان، استدعا دارم که چون غریبان و بیگانگان از شهوات جسمی که با نفس در نزاع هستند، اجتناب نمایید؛"
        },
        {
          "verse": 12,
          "usfm": "1PE.2.12",
          "line_type": "p",
          "text": "و سیرت خود را درمیان امتها نیکو دارید تا در همان امری که شمارا مثل بدکاران بد میگویند، از کارهای نیکوی شما که ببینند، در روز تفقد، خدا را تمجیدنمایند."
        },
        {
          "verse": 13,
          "usfm": "1PE.2.13",
          "line_type": "p",
          "text": "لهذا هر منصب بشری را بخاطر خداونداطاعت کنید، خواه پادشاه را که فوق همه است،"
        },
        {
          "verse": 14,
          "usfm": "1PE.2.14",
          "line_type": "p",
          "text": "و خواه حکام را که رسولان وی هستند، بجهت انتقام کشیدن از بدکاران و تحسین نیکوکاران."
        },
        {
          "verse": 15,
          "usfm": "1PE.2.15",
          "line_type": "p",
          "text": "زیرا که همین است اراده خدا که به نیکوکاری خود، جهالت مردمان بیفهم را ساکت نمایید،"
        },
        {
          "verse": 16,
          "usfm": "1PE.2.16",
          "line_type": "p",
          "text": "مثل آزادگان، اما نه مثل آنانی که آزادی خود را پوشش شرارت میسازند بلکه چون بندگان خدا."
        },
        {
          "verse": 17,
          "usfm": "1PE.2.17",
          "line_type": "p",
          "text": "همه مردمان را احترام کنید. برادران را محبت نمایید. از خدا بترسید. پادشاه رااحترام نمایید."
        },
        {
          "verse": 18,
          "usfm": "1PE.2.18",
          "line_type": "p",
          "text": "ای نوکران، مطیع آقایان خود باشید با کمال ترس؛ و نه فقط صالحان و مهربانان را بلکه کج خلقان را نیز."
        },
        {
          "verse": 19,
          "usfm": "1PE.2.19",
          "line_type": "p",
          "text": "زیرا این ثواب است که کسی بجهت ضمیری که چشم بر خدا دارد، در وقتی که ناحق زحمت میکشد، دردها را متحمل شود."
        },
        {
          "verse": 20,
          "usfm": "1PE.2.20",
          "line_type": "p",
          "text": "زیرا چه فخر دارد هنگامی که گناهکار بوده، تازیانه خورید و متحمل آن شوید. لکن اگرنیکوکار بوده، زحمت کشید و صبر کنید، این نزدخدا ثواب است."
        },
        {
          "verse": 21,
          "usfm": "1PE.2.21",
          "line_type": "p",
          "text": "زیرا که برای همین خوانده شدهاید، چونکه مسیح نیز برای ما عذاب کشید وشما را نمونهای گذاشت تا در اثر قدمهای وی رفتار نمایید،"
        },
        {
          "verse": 22,
          "usfm": "1PE.2.22",
          "line_type": "p",
          "text": "«که هیچ گناه نکرد و مکر درزبانش یافت نشد.»"
        },
        {
          "verse": 23,
          "usfm": "1PE.2.23",
          "line_type": "p",
          "text": "چون او را دشنام میدادند، دشنام پس نمی داد و چون عذاب میکشید تهدیدنمی نمود، بلکه خویشتن را به داور عادل تسلیم کرد."
        },
        {
          "verse": 24,
          "usfm": "1PE.2.24",
          "line_type": "p",
          "text": "که خود گناهان ما را در بدن خویش بردارمتحمل شد تا از گناه مرده شده، به عدالت زیست نماییم که به ضربهای او شفا یافتهاید."
        },
        {
          "verse": 25,
          "usfm": "1PE.2.25",
          "line_type": "p",
          "text": "از آنروکه مانند گوسفندان گمشده بودید، لکن الحال به سوی شبان و اسقف جانهای خود برگشتهاید."
        }
      ],
