  "chapters": [
    {
      "schema_version": 6,
      "book_id": "1PE",
      "chapter": 1,
      "chapter_usfm": "1PE.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1PE.1.1",
          "line_type": "p",
          "text": "به غریبانی که پراکندهاند در پنطس وغلاطیه و قپدوقیه و آسیا و بطانیه؛"
        },
        {
          "verse": 2,
          "usfm": "1PE.1.2",
          "line_type": "p",
          "text": "برگزیدگان برحسب علم سابق خدای پدر، به تقدیس روح برای اطاعت و پاشیدن خون عیسی مسیح.فیض و سلامتی بر شما افزون باد."
        },
        {
          "verse": 3,
          "usfm": "1PE.1.3",
          "line_type": "p",
          "text": "متبارک باد خدا و پدر خداوند ما عیسی مسیح که بحسب رحمت عظیم خود ما رابوساطت برخاستن عیسی مسیح از مردگان از نوتولید نمود برای امید زنده،"
        },
        {
          "verse": 4,
          "usfm": "1PE.1.4",
          "line_type": "p",
          "text": "بجهت میراث بیفساد و بیآلایش و ناپژمرده که نگاه داشته شده است در آسمان برای شما؛"
        },
        {
          "verse": 5,
          "usfm": "1PE.1.5",
          "line_type": "p",
          "text": "که به قوت خدامحروس هستید به ایمان برای نجاتی که مهیاشده است تا در ایام آخر ظاهر شود."
        },
        {
          "verse": 6,
          "usfm": "1PE.1.6",
          "line_type": "p",
          "text": "و در آن وجد مینمایید، هرچند در حال، اندکی از راه ضرورت در تجربه های گوناگون محزون شدهاید،"
        },
        {
          "verse": 7,
          "usfm": "1PE.1.7",
          "line_type": "p",
          "text": "تا آزمایش ایمان شما که از طلای فانی باآزموده شدن در آتش، گرانبهاتر است، برای تسبیح و جلال و اکرام یافت شود در حین ظهورعیسی مسیح."
        },
        {
          "verse": 8,
          "usfm": "1PE.1.8",
          "line_type": "p",
          "text": "که او را اگرچه ندیدهاید محبت مینمایید و الان اگرچه او را نمی بینید، لکن بر اوایمان آورده، وجد مینمایید با خرمیای که نمی توان بیان کرد و پر از جلال است."
        },
        {
          "verse": 9,
          "usfm": "1PE.1.9",
          "line_type": "p",
          "text": "و انجام ایمان خود یعنی نجات جان خویش را مییابید."
        },
        {
          "verse": 10,
          "usfm": "1PE.1.10",
          "line_type": "p",
          "text": "که درباره این نجات، انبیایی که از فیضی که برای شما مقرر بود، اخبار نمودند، تفتیش وتفحص میکردند"
        },
        {
          "verse": 11,
          "usfm": "1PE.1.11",
          "line_type": "p",
          "text": "و دریافت مینمودند که کدام و چگونه زمان است که روح مسیح که درایشان بود از آن خبر میداد، چون از زحماتی که برای مسیح مقرر بود و جلالهایی که بعد از آنهاخواهد بود، شهادت میداد؛"
        },
        {
          "verse": 12,
          "usfm": "1PE.1.12",
          "line_type": "p",
          "text": "و بدیشان مکشوف شد که نه به خود بلکه به ما خدمت میکردند، در آن اموری که شما اکنون از آنها خبریافتهاید از کسانی که به روحالقدس که از آسمان فرستاده شده است، بشارت دادهاند و فرشتگان نیز مشتاق هستند که در آنها نظر کنند."
        },
        {
          "verse": 13,
          "usfm": "1PE.1.13",
          "line_type": "p",
          "text": "لهذا کمر دلهای خود را ببندید و هشیارشده، امید کامل آن فیضی را که در مکاشفه عیسی مسیح به شما عطا خواهد شد، بدارید."
        },
        {
          "verse": 14,
          "usfm": "1PE.1.14",
          "line_type": "p",
          "text": "و چون ابنای اطاعت هستید، مشابه مشوید بدان شهواتی که در ایام جهالت میداشتید."
        },
        {
          "verse": 15,
          "usfm": "1PE.1.15",
          "line_type": "p",
          "text": "بلکه مثل آن قدوس که شما را خوانده است، خود شما نیز درهر سیرت، مقدس باشید."
        },
        {
          "verse": 16,
          "usfm": "1PE.1.16",
          "line_type": "p",
          "text": "زیرا مکتوب است: «مقدس باشید زیرا که من قدوسم.»"
        },
        {
          "verse": 17,
          "usfm": "1PE.1.17",
          "line_type": "p",
          "text": "و چون او را پدر میخوانید که بدون ظاهربینی برحسب اعمال هرکس داوری مینماید، پس هنگام غربت خود را با ترس صرف نمایید."
        },
        {
          "verse": 18,
          "usfm": "1PE.1.18",
          "line_type": "p",
          "text": "زیرا میدانید که خریده شدهاید از سیرت باطلی که از پدران خود یافتهاید نه به چیزهای فانی مثل نقره و طلا،"
        },
        {
          "verse": 19,
          "usfm": "1PE.1.19",
          "line_type": "p",
          "text": "بلکه به خون گرانبها چون خون بره بیعیب و بیداغ یعنی خون مسیح،"
        },
        {
          "verse": 20,
          "usfm": "1PE.1.20",
          "line_type": "p",
          "text": "که پیش از بنیاد عالم معین شد، لکن درزمان آخر برای شما ظاهر گردید،"
        },
        {
          "verse": 21,
          "usfm": "1PE.1.21",
          "line_type": "p",
          "text": "که بوساطت او شما بر آن خدایی که او را از مردگان برخیزانیدو او را جلال داد، ایمان آوردهاید تا ایمان و امیدشما بر خدا باشد."
        },
        {
          "verse": 22,
          "usfm": "1PE.1.22",
          "line_type": "p",
          "text": "چون نفسهای خود را به اطاعت راستی طاهر ساختهاید تا محبت برادرانه بیریا داشته باشید، پس یکدیگر را از دل بشدت محبت بنمایید."
        },
        {
          "verse": 23,
          "usfm": "1PE.1.23",
          "line_type": "p",
          "text": "از آنرو که تولد تازه یافتید نه از تخم فانی بلکه از غیرفانی یعنی به کلام خدا که زنده وتا ابدالاباد باقی است."
        },
        {
          "verse": 24,
          "usfm": "1PE.1.24",
          "line_type": "p",
          "text": "زیرا که «هر بشری مانندگیاه است و تمام جلال او چون گل گیاه. گیاه پژمرده شد و گلش ریخت."
        },
        {
          "verse": 25,
          "usfm": "1PE.1.25",
          "line_type": "p",
          "text": "لکن کلمه خدا تاابدالاباد باقی است.» و این است آن کلامی که به شما بشارت داده شده است."
        }
      ],
