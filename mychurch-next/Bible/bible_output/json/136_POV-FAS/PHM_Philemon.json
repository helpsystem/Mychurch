  "chapters": [
    {
      "schema_version": 6,
      "book_id": "PHM",
      "chapter": 1,
      "chapter_usfm": "PHM.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHM.1.1",
          "line_type": "p",
          "text": "پولس، اسیر مسیح عیسی و تیموتاوس برادر، به فلیمون عزیز و همکار ما"
        },
        {
          "verse": 2,
          "usfm": "PHM.1.2",
          "line_type": "p",
          "text": "و به اپفیه محبوبه و ارخپس همسپاه ما به کلیسایی که در خانه ات میباشد."
        },
        {
          "verse": 3,
          "usfm": "PHM.1.3",
          "line_type": "p",
          "text": "فیض و سلامتی از جانب پدر ما خدا وعیسی مسیح خداوند با شما باد."
        },
        {
          "verse": 4,
          "usfm": "PHM.1.4",
          "line_type": "p",
          "text": "خدای خود را شکر میکنم و پیوسته تو رادر دعاهای خود یاد میآورم"
        },
        {
          "verse": 5,
          "usfm": "PHM.1.5",
          "line_type": "p",
          "text": "چونکه ذکرمحبت و ایمان تو را شنیدهام که به عیسی خداوندو به همه مقدسین داری،"
        },
        {
          "verse": 6,
          "usfm": "PHM.1.6",
          "line_type": "p",
          "text": "تا شراکت ایمانت موثرشود در معرفت کامل هر نیکویی که در ما است برای مسیح عیسی."
        },
        {
          "verse": 7,
          "usfm": "PHM.1.7",
          "line_type": "p",
          "text": "زیرا که مرا خوشی کامل وتسلی رخ نمود از محبت تو از آنرو که دلهای مقدسین از توای برادر استراحت میپذیرند."
        },
        {
          "verse": 8,
          "usfm": "PHM.1.8",
          "line_type": "p",
          "text": "بدین جهت هرچند در مسیح کمال جسارت را دارم که به آنچه مناسب است تو را حکم دهم،"
        },
        {
          "verse": 9,
          "usfm": "PHM.1.9",
          "line_type": "p",
          "text": "لیکن برای محبت، سزاوارتر آن است که التماس نمایم، هرچند مردی چون پولس پیر والان اسیر مسیح عیسی نیز میباشم."
        },
        {
          "verse": 10,
          "usfm": "PHM.1.10",
          "line_type": "p",
          "text": "پس تو را التماس میکنم درباره فرزند خود انیسیمس که در زنجیرهای خود او را تولید نمودم،"
        },
        {
          "verse": 11,
          "usfm": "PHM.1.11",
          "line_type": "p",
          "text": "که سابق او برای تو بیفایده بود، لیکن الحال تو را و مرافایده مند میباشد؛"
        },
        {
          "verse": 12,
          "usfm": "PHM.1.12",
          "line_type": "p",
          "text": "که او را نزد تو پس میفرستم. پس تو او را بپذیر که جان من است."
        },
        {
          "verse": 13,
          "usfm": "PHM.1.13",
          "line_type": "p",
          "text": "و من میخواستم که او را نزد خود نگاه دارم تابه عوض تو مرا در زنجیرهای انجیل خدمت کند،"
        },
        {
          "verse": 14,
          "usfm": "PHM.1.14",
          "line_type": "p",
          "text": "اما نخواستم کاری بدون رای تو کرده باشم تااحسان تو از راه اضطرار نباشد، بلکه از روی اختیار."
        },
        {
          "verse": 15,
          "usfm": "PHM.1.15",
          "line_type": "p",
          "text": "زیرا که شاید بدین جهت ساعتی از توجدا شد تا او را تا به ابد دریابی."
        },
        {
          "verse": 16,
          "usfm": "PHM.1.16",
          "line_type": "p",
          "text": "لیکن بعد از این نه چون غلام بلکه فوق از غلام یعنی برادر عزیزخصوص به من اما چند مرتبه زیادتر به تو هم درجسم و هم در خداوند."
        },
        {
          "verse": 17,
          "usfm": "PHM.1.17",
          "line_type": "p",
          "text": "پس هرگاه مرا رفیق میدانی، او را چون من قبول فرما."
        },
        {
          "verse": 18,
          "usfm": "PHM.1.18",
          "line_type": "p",
          "text": "اما اگرضرری به تو رسانیده باشد یا طلبی از او داشته باشی، آن را بر من محسوب دار."
        },
        {
          "verse": 19,
          "usfm": "PHM.1.19",
          "line_type": "p",
          "text": "من که پولس هستم، بهدست خود مینویسم، خود ادا خواهم کرد، تا به تو نگویم که بهجان خود نیز مدیون من هستی."
        },
        {
          "verse": 20,
          "usfm": "PHM.1.20",
          "line_type": "p",
          "text": "بلیای برادر، تا من از تو در خداوندبرخوردار شوم. پس جان مرا در مسیح تازگی بده."
        },
        {
          "verse": 21,
          "usfm": "PHM.1.21",
          "line_type": "p",
          "text": "چون بر اطاعت تو اعتماد دارم، به تومی نویسم از آن جهت که میدانم بیشتر از آنچه میگویم هم خواهی کرد."
        },
        {
          "verse": 22,
          "usfm": "PHM.1.22",
          "line_type": "p",
          "text": "معهذا منزلی نیز برای من حاضر کن، زیراکه امیدوارم از دعاهای شما به شما بخشیده شوم."
        },
        {
          "verse": 23,
          "usfm": "PHM.1.23",
          "line_type": "p",
          "text": "اپفراس که در مسیح عیسی همزندان من است و مرقس"
        },
        {
          "verse": 24,
          "usfm": "PHM.1.24",
          "line_type": "p",
          "text": "و ارسترخس و دیماس و لوقاهمکاران من تو را سلام میرسانند."
        }
      ],
