    {
      "schema_version": 6,
      "book_id": "MIC",
      "chapter": 2,
      "chapter_usfm": "MIC.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "MIC.2.1",
          "line_type": "p",
          "text": "وای بر آنانی که بر بسترهای خود ظلم راتدبیر مینمایند و مرتکب شرارت می شوند. در روشنایی صبح آن را بجا میآورند، چونکه در قوت دست ایشان است."
        },
        {
          "verse": 2,
          "usfm": "MIC.2.2",
          "line_type": "p",
          "text": "بر زمینهاطمع میورزند و آنها را غصب مینمایند و برخانهها نیز و آنها را میگیرند و بر مرد و خانهاش وشخص و میراثش ظلم مینمایند."
        },
        {
          "verse": 3,
          "usfm": "MIC.2.3",
          "line_type": "p",
          "text": "بنابراین خداوند چنین میگوید: هان من بر این قبیله بلایی را تدبیر مینمایم که شما گردن خود را از آن نتوانید بیرون آورد و متکبرانه نخواهید خرامیدزیرا که آن زمان زمان بد است."
        },
        {
          "verse": 4,
          "usfm": "MIC.2.4",
          "line_type": "p",
          "text": "در آن روز بر شمامثل خواهند زد و مرثیه سوزناک خواهند خواندو خواهند گفت بالکل هلاک شدهایم. نصیب قوم مرا به دیگران داده است. چگونه آن را از من دورمی کند و زمینهای مرا به مرتدان تقسیم مینماید."
        },
        {
          "verse": 5,
          "usfm": "MIC.2.5",
          "line_type": "p",
          "text": "بنابراین برای تو کسی نخواهد بود که ریسمان رابه قرعه در جماعت خداوند بکشد."
        },
        {
          "verse": 6,
          "usfm": "MIC.2.6",
          "line_type": "p",
          "text": "ایشان نبوت کرده، میگویند نبوت مکنید. اگر به اینها نبوت ننمایند رسوایی دور نخواهدشد."
        },
        {
          "verse": 7,
          "usfm": "MIC.2.7",
          "line_type": "p",
          "text": "ای که به خاندان یعقوب مسمی هستی آیاروح خداوند قاصر شده است و آیا اینها اعمال اومی باشد؟ آیا کلام من برای هرکه به استقامت سالک میباشد نیکو نیست؟"
        },
        {
          "verse": 8,
          "usfm": "MIC.2.8",
          "line_type": "p",
          "text": "لکن قوم من در اینروزها به دشمنی برخاستهاند. شما ردا را از رخت آنانی که به اطمینان میگذرند و از جنگ روگردانند میکنید."
        },
        {
          "verse": 9,
          "usfm": "MIC.2.9",
          "line_type": "p",
          "text": "و زنان قوم مرا از خانه های مرغوب ایشان بیرون میکنید و زینت مرا ازاطفال ایشان تا به ابد میگیرید."
        },
        {
          "verse": 10,
          "usfm": "MIC.2.10",
          "line_type": "p",
          "text": "برخیزید وبروید زیرا که این آرامگاه شما نیست چونکه نجس شده است. شما را به هلاکت سخت هلاک خواهد ساخت."
        },
        {
          "verse": 11,
          "usfm": "MIC.2.11",
          "line_type": "p",
          "text": "اگر کسی به بطالت و دروغ سالک باشد و کاذبانه گوید که من برای تو درباره شراب و مسکرات نبوت خواهم نمود هرآینه اونبی این قوم خواهد بود."
        },
        {
          "verse": 12,
          "usfm": "MIC.2.12",
          "line_type": "p",
          "text": "ای یعقوب، من البته تمامی اهل تو را جمع خواهم نمود و بقیه اسرائیل را فراهم آورده، ایشان را مثل گوسفندان بصره در یک جا خواهم گذاشت. ایشان مثل گلهای که در آغل خود باشد، بهسبب کثرت مردمان غوغا خواهند کرد."
        },
        {
          "verse": 13,
          "usfm": "MIC.2.13",
          "line_type": "p",
          "text": "رخنه کننده پیش روی ایشان برآمده است. ایشان رخنه نموده و از دروازه عبور کرده، از آن بیرون رفتهاند و پادشاه ایشان پیش روی ایشان وخداوند بر سر ایشان پیش رفته است."
        }
      ],
      "verse_count": 13,
