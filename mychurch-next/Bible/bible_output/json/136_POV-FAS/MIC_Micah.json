    {
      "schema_version": 6,
      "book_id": "MIC",
      "chapter": 5,
      "chapter_usfm": "MIC.5",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "MIC.5.1",
          "line_type": "p",
          "text": "ای دختر افواج، الان در فوجها جمع خواهی شد! ایشان به ضد ما سنگرهابستهاند. با عصا بر رخسار داور اسرائیل خواهندزد."
        },
        {
          "verse": 2,
          "usfm": "MIC.5.2",
          "line_type": "p",
          "text": "و توای بیت لحم افراته اگرچه در هزاره های یهودا کوچک هستی، از تو برای من کسی بیرون خواهد آمد که بر قوم من اسرائیل حکمرانی خواهد نمود و طلوع های او از قدیم و از ایام ازل بوده است."
        },
        {
          "verse": 3,
          "usfm": "MIC.5.3",
          "line_type": "p",
          "text": "بنابراین ایشان را تا زمانی که زن حامله بزاید تسلیم خواهد نمود و بقیه برادرانش با بنیاسرائیل بازخواهند گشت."
        },
        {
          "verse": 4,
          "usfm": "MIC.5.4",
          "line_type": "p",
          "text": "و او خواهدایستاد و در قوت خداوند و در کبریایی اسم یهوه خدای خویش (گله خود را) خواهد چرانید وایشان به آرامی ساکن خواهند شد زیرا که او الان تا اقصای زمین بزرگ خواهد شد."
        },
        {
          "verse": 5,
          "usfm": "MIC.5.5",
          "line_type": "p",
          "text": "و او سلامتی خواهد بود.هنگامی که آشور به زمین ما داخل شده، برقصرهای ما قدم نهد، آنگاه هفت شبان و هشت سرور آدمیان را به مقابل او برپا خواهیم داشت."
        },
        {
          "verse": 6,
          "usfm": "MIC.5.6",
          "line_type": "p",
          "text": "و ایشان زمین آشور و مدخل های زمین نمرود رابا شمشیر حکمرانی خواهند نمود و او ما را ازآشور رهایی خواهد داد، هنگامی که به زمین ماداخل شده، حدود ما را پایمال کند."
        },
        {
          "verse": 7,
          "usfm": "MIC.5.7",
          "line_type": "p",
          "text": "و بقیه یعقوب در میان قوم های بسیار مثل شبنم از جانب خداوند خواهد بود و مانند بارشی که بر گیاه میآید که برای انسان انتظار نمی کشد و به جهت بنی آدم صبر نمی نماید."
        },
        {
          "verse": 8,
          "usfm": "MIC.5.8",
          "line_type": "p",
          "text": "و بقیه یعقوب در میان امتها و در وسط قوم های بسیار، مثل شیر درمیان جانوران جنگل و مانند شیر ژیان در میان گله های گوسفندان خواهند بود که چون عبورمی نماید پایمال میکند و میدرد و رهانندهای نمی باشد."
        },
        {
          "verse": 9,
          "usfm": "MIC.5.9",
          "line_type": "p",
          "text": "و دست تو بر خصمانت بلند خواهدشد و جمیع دشمنانت منقطع خواهند گردید."
        },
        {
          "verse": 10,
          "usfm": "MIC.5.10",
          "line_type": "p",
          "text": "و خداوند میگوید که در آن روز اسبان تورا از میانت منقطع و ارابه هایت را معدوم خواهم نمود."
        },
        {
          "verse": 11,
          "usfm": "MIC.5.11",
          "line_type": "p",
          "text": "و شهرهای ولایت تو را خراب نموده، همه قلعه هایت را منهدم خواهم ساخت."
        },
        {
          "verse": 12,
          "usfm": "MIC.5.12",
          "line_type": "p",
          "text": "وجادوگری را از دست تو تلف خواهم نمود که فالگیران دیگر در تو یافت نشوند."
        },
        {
          "verse": 13,
          "usfm": "MIC.5.13",
          "line_type": "p",
          "text": "و بتهای تراشیده و تمثالهای تو را از میانت نابود خواهم ساخت که بار دیگر به صنعت دست خود سجده ننمایی."
        },
        {
          "verse": 14,
          "usfm": "MIC.5.14",
          "line_type": "p",
          "text": "و اشیره هایت را از میانت کنده، شهرهایت را منهدم خواهم ساخت."
        },
        {
          "verse": 15,
          "usfm": "MIC.5.15",
          "line_type": "p",
          "text": "و با خشم و غضب از امت هایی که نمی شنوند انتقام خواهم کشید."
        }
      ],
