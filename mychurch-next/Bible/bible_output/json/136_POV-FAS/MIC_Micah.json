    {
      "schema_version": 6,
      "book_id": "MIC",
      "chapter": 4,
      "chapter_usfm": "MIC.4",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "MIC.4.1",
          "line_type": "p",
          "text": "و در ایام آخر، کوه خانه خداوند بر قله کوها ثابت خواهد شد و بر فوق تلهابرافراشته خواهد گردید و قومها بر آن روان خواهند شد."
        },
        {
          "verse": 2,
          "usfm": "MIC.4.2",
          "line_type": "p",
          "text": "و امت های بسیار عزیمت کرده، خواهند گفت: بیایید تا به کوه خداوند و به خانه خدای یعقوب برآییم تا طریق های خویش را به ما تعلیم دهد و به راههای وی سلوک نماییم زیراکه شریعت از صهیون و کلام خداوند از اورشلیم صادر خواهد شد."
        },
        {
          "verse": 3,
          "usfm": "MIC.4.3",
          "line_type": "p",
          "text": "و او در میان قوم های بسیارداوری خواهد نمود و امت های عظیم را از جای دور تنبیه خواهد کرد و ایشان شمشیرهای خودرا برای گاوآهن و نیزه های خویش را برای اره هاخواهند شکست و امتی بر امتی شمشیر نخواهدکشید و بار دیگر جنگ را نخواهند آموخت."
        },
        {
          "verse": 4,
          "usfm": "MIC.4.4",
          "line_type": "p",
          "text": "وهر کس زیر مو خود و زیر انجیر خویش خواهدنشست و ترسانندهای نخواهد بود زیرا که دهان یهوه صبایوت تکلم نموده است."
        },
        {
          "verse": 5,
          "usfm": "MIC.4.5",
          "line_type": "p",
          "text": "زیرا که جمیع قومها هر کدام به اسم خدای خویش سلوک مینمایند اما ما به اسم یهوه خدای خود تاابدالاباد سلوک خواهیم نمود."
        },
        {
          "verse": 6,
          "usfm": "MIC.4.6",
          "line_type": "p",
          "text": "خداوند میگوید که در آن روز لنگان راجمع خواهم کرد و رانده شدگان و آنانی را که مبتلا ساختهام فراهم خواهم آورد."
        },
        {
          "verse": 7,
          "usfm": "MIC.4.7",
          "line_type": "p",
          "text": "و لنگان رابقیتی و دور شدگان را قوم قوی خواهم ساخت وخداوند در کوه صهیون برایشان از الان تا ابدالابادسلطنت خواهند نمود."
        },
        {
          "verse": 8,
          "usfm": "MIC.4.8",
          "line_type": "p",
          "text": "و توای برج گله وای کوه دختر صهیون این به تو خواهد رسید وسلطنت اول یعنی مملکت دختر اورشلیم خواهدآمد."
        },
        {
          "verse": 9,
          "usfm": "MIC.4.9",
          "line_type": "p",
          "text": "الان چرا فریاد برمی آوری؟ آیا در توپادشاهی نیست و آیا مشیر تو نابود شده است که درد تو را مثل زنی که میزاید گرفته است؟"
        },
        {
          "verse": 10,
          "usfm": "MIC.4.10",
          "line_type": "p",
          "text": "ای دختر صهیون مثل زنی که میزاید درد زه کشیده، وضع حمل نما زیرا که الان از شهر بیرون رفته، درصحرا خواهی نشست و به بابل رفته، در آنجارهایی خواهی یافت و در آنجا خداوند تو را ازدست دشمنانت رهایی خواهد داد."
        },
        {
          "verse": 11,
          "usfm": "MIC.4.11",
          "line_type": "p",
          "text": "و الان امت های بسیار بر تو جمع شده، میگویند که صهیون نجس خواهد شد و چشمان ما بر او خواهد نگریست."
        },
        {
          "verse": 12,
          "usfm": "MIC.4.12",
          "line_type": "p",
          "text": "اما ایشان تدبیرات خداوندرا نمی دانند و مشورت او را نمی فهمند زیرا که ایشان را مثل بافهها در خرمنگاه جمع کرده است."
        },
        {
          "verse": 13,
          "usfm": "MIC.4.13",
          "line_type": "p",
          "text": "ای دختر صهیون برخیز و پایمال کن زیرا که شاخ تو را آهن خواهم ساخت و سمهای تو رابرنج خواهم نمود و قوم های بسیار را خواهی کوبید و حاصل ایشان را برای یهوه و دولت ایشان را برای خداوند تمامی زمین وقف خواهی نمود."
        }
      ],
