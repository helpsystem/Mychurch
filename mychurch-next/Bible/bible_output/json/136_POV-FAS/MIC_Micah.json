    {
      "schema_version": 6,
      "book_id": "MIC",
      "chapter": 6,
      "chapter_usfm": "MIC.6",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "MIC.6.1",
          "line_type": "p",
          "text": "آنچه خداوند میگوید بشنوید! برخیز ونزد کوهها مخاصمه نما و تلها آواز تو را بشنوند."
        },
        {
          "verse": 2,
          "usfm": "MIC.6.2",
          "line_type": "p",
          "text": "ای کوهها مخاصمه خداوند را بشنویدوای اساسهای جاودانی زمین! زیرا خداوند را باقوم خود مخاصمهای است و با اسرائیل محاکمه خواهد کرد."
        },
        {
          "verse": 3,
          "usfm": "MIC.6.3",
          "line_type": "p",
          "text": "ای قوم من به تو چه کردهام و به چه چیز تو را خسته ساختهام؟ به ضد من شهادت بده."
        },
        {
          "verse": 4,
          "usfm": "MIC.6.4",
          "line_type": "p",
          "text": "زیرا که تو را از زمین مصر برآوردم و تو را ازخانه بندگی فدیه دادم و موسی و هارون و مریم راپیش روی تو ارسال نمودم."
        },
        {
          "verse": 5,
          "usfm": "MIC.6.5",
          "line_type": "p",
          "text": "ای قوم من آنچه راکه بالاق پادشاه موآب مشورت داد و آنچه بلعام بن بعور او را جواب فرستاد بیاد آور و آنچه را که از شطیم تا جلجال (واقع شد بهخاطر دار) تاعدالت خداوند را بدانی."
        },
        {
          "verse": 6,
          "usfm": "MIC.6.6",
          "line_type": "p",
          "text": "با چه چیز به حضورخداوند بیایم و نزد خدای تعالی رکوع نمایم؟ آیابا قربانی های سوختنی و با گوساله های یک ساله به حضور وی بیایم؟"
        },
        {
          "verse": 7,
          "usfm": "MIC.6.7",
          "line_type": "p",
          "text": "آیا خداوند از هزارها قوچ و از ده هزارها نهر روغن راضی خواهد شد؟ آیانخست زاده خود را به عوض معصیتم و ثمره بدن خویش را به عوض گناه جانم بدهم؟"
        },
        {
          "verse": 8,
          "usfm": "MIC.6.8",
          "line_type": "p",
          "text": "ای مرد ازآنچه نیکو است تو را اخبار نموده است؛ وخداوند از تو چه چیز را میطلبد غیر از اینکه انصاف را بجا آوری و رحمت را دوست بداری ودر حضور خدای خویش با فروتنی سلوک نمایی؟"
        },
        {
          "verse": 9,
          "usfm": "MIC.6.9",
          "line_type": "p",
          "text": "آواز خداوند به شهر ندا میدهد و حکمت اسم او را مشاهده مینماید. عصا و تعیین کننده آن را بشنوید."
        },
        {
          "verse": 10,
          "usfm": "MIC.6.10",
          "line_type": "p",
          "text": "آیا تا به حال گنجهای شرارت وایفای ناقص ملعون در خانه شریران میباشد؟"
        },
        {
          "verse": 11,
          "usfm": "MIC.6.11",
          "line_type": "p",
          "text": "آیا من با میزانهای شرارت و با کیسه سنگهای ناراست بری خواهم شد؟"
        },
        {
          "verse": 12,
          "usfm": "MIC.6.12",
          "line_type": "p",
          "text": "زیرا که دولتمندان او از ظلم مملواند و ساکنانش دروغ میگویند وزبان ایشان در دهانشان فریب محض است."
        },
        {
          "verse": 13,
          "usfm": "MIC.6.13",
          "line_type": "p",
          "text": "پس من نیز تو را بهسبب گناهانت به جراحات مهلک مجروح ساخته، خراب خواهم نمود."
        },
        {
          "verse": 14,
          "usfm": "MIC.6.14",
          "line_type": "p",
          "text": "تو خواهی خورد اما سیر نخواهی شد وگرسنگی تو در اندرونت خواهد ماند و بیرون خواهی برد اما رستگار نخواهی ساخت و آنچه راکه رستگار نمایی من به شمشیر تسلیم خواهم نمود."
        },
        {
          "verse": 15,
          "usfm": "MIC.6.15",
          "line_type": "p",
          "text": "تو خواهی کاشت اما نخواهی دروید؛ توزیتون را به پا خواهی فشرد اما خویشتن را به روغن تدهین نخواهی نمود؛ و عصیر انگور را اماشراب نخواهی نوشید."
        },
        {
          "verse": 16,
          "usfm": "MIC.6.16",
          "line_type": "p",
          "text": "زیرا که قوانین عمری وجمیع اعمال خاندان اخاب نگاه داشته میشود وبه مشورت های ایشان سلوک مینمایید تا تو را به ویرانی و ساکنانش را به سخریه تسلیم نمایم، پس عار قوم مرا متحمل خواهید شد."
        }
      ],
