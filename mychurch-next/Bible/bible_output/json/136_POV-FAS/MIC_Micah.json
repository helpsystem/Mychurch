    {
      "schema_version": 6,
      "book_id": "MIC",
      "chapter": 7,
      "chapter_usfm": "MIC.7",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "MIC.7.1",
          "line_type": "p",
          "text": "وای بر من زیرا که مثل جمع کردن میوهها ومانند چیدن انگورهایی شدهام که نه خوشهای برای خوراک دارد و نه نوبر انجیری که جان من آن را میخواهد."
        },
        {
          "verse": 2,
          "usfm": "MIC.7.2",
          "line_type": "p",
          "text": "مرد متقی از جهان نابود شده، و راست کردار از میان آدمیان معدوم گردیده است. جمع ایشان برای خون کمین میگذارند و یکدیگر را به دام صید مینمایند."
        },
        {
          "verse": 3,
          "usfm": "MIC.7.3",
          "line_type": "p",
          "text": "دستهای ایشان برای شرارت چالاک است، رئیس طلب میکند و داور رشوه میخواهد و مرد بزرگ به هوای نفس خود تکلم مینماید؛ پس ایشان آن را به هم میبافند."
        },
        {
          "verse": 4,
          "usfm": "MIC.7.4",
          "line_type": "p",
          "text": "نیکوترین ایشان مثل خار میباشد و راست کردار ایشان از خاربست بدتر. روز پاسبانانت و (روز) عقوبت تو رسیده است، الان اضطراب ایشان خواهد بود."
        },
        {
          "verse": 5,
          "usfm": "MIC.7.5",
          "line_type": "p",
          "text": "بر یارخود اعتماد مدار و بر دوست خالص خویش توکل منما و در دهان خود را از هم آغوش خودنگاه دار."
        },
        {
          "verse": 6,
          "usfm": "MIC.7.6",
          "line_type": "p",
          "text": "زیرا که پسر، پدر را افتضاح میکند ودختر با مادر خود و عروس با خارسوی خویش مقاومت مینمایند و دشمنان شخص اهل خانه اومی باشند."
        },
        {
          "verse": 7,
          "usfm": "MIC.7.7",
          "line_type": "p",
          "text": "اما من بسوی خداوند نگرانم و برای خدای نجات خود انتظار میکشم و خدای من مرااجابت خواهد نمود."
        },
        {
          "verse": 8,
          "usfm": "MIC.7.8",
          "line_type": "p",
          "text": "ای دشمن من بر من شادی منما زیرا اگرچه بیفتم خواهم برخاست و اگرچه در تاریکی بنشینم خداوند نور من خواهد بود."
        },
        {
          "verse": 9,
          "usfm": "MIC.7.9",
          "line_type": "p",
          "text": "غضب خداوند را متحمل خواهم شد زیرا به او گناه ورزیدهام تا او دعوی مرا فیصل کند و داوری مرابجا آورد. پس مرا به روشنایی بیرون خواهدآورد و عدالت او را مشاهده خواهم نمود."
        },
        {
          "verse": 10,
          "usfm": "MIC.7.10",
          "line_type": "p",
          "text": "دشمنم این را خواهد دید و خجالت او راخواهد پوشانید زیرا به من میگوید: یهوه خدای تو کجا است؟ چشمانم بر او خواهد نگریست واو الان مثل گل کوچهها پایمال خواهد شد."
        },
        {
          "verse": 11,
          "usfm": "MIC.7.11",
          "line_type": "p",
          "text": "درروز بنا نمودن دیوارهایت در آن روز شریعت دور خواهد شد."
        },
        {
          "verse": 12,
          "usfm": "MIC.7.12",
          "line_type": "p",
          "text": "در آن روز از آشور و ازشهرهای مصر و از مصر تا نهر (فرات ) و از دریا تادریا و از کوه تا کوه نزد تو خواهند آمد."
        },
        {
          "verse": 13,
          "usfm": "MIC.7.13",
          "line_type": "p",
          "text": "و زمین بهسبب ساکنانش، به جهت نتیجه اعمالشان ویران خواهد شد."
        },
        {
          "verse": 14,
          "usfm": "MIC.7.14",
          "line_type": "p",
          "text": "قوم خود را به عصای خویش شبانی کن وگوسفندان میراث خود را که در جنگل و در میان کرمل به تنهایی ساکن میباشند. ایشان مثل ایام سابق در باشان و جلعاد بچرند."
        },
        {
          "verse": 15,
          "usfm": "MIC.7.15",
          "line_type": "p",
          "text": "مثل ایامی که ازمصر بیرون آمدی کارهای عجیب به او نشان خواهم داد."
        },
        {
          "verse": 16,
          "usfm": "MIC.7.16",
          "line_type": "p",
          "text": "امتها چون این را بینند، از تمامی توانایی خویش خجل خواهند شد و دست بردهان خواهند گذاشت و گوشهای ایشان کرخواهد شد."
        },
        {
          "verse": 17,
          "usfm": "MIC.7.17",
          "line_type": "p",
          "text": "مثل مار خاک را خواهند لیسید ومانند حشرات زمین از سوراخهای خود با لرزه بیرون خواهند آمد و بسوی یهوه خدای ما باخوف خواهند آمد و از تو خواهند ترسید."
        },
        {
          "verse": 18,
          "usfm": "MIC.7.18",
          "line_type": "p",
          "text": "کیست خدایی مثل تو که عصیان را میآمرزدو از تقصیر بقیه میراث خویش درمی گذرد. اوخشم خود را تا به ابد نگاه نمی دارد زیرا رحمت را دوست میدارد."
        },
        {
          "verse": 19,
          "usfm": "MIC.7.19",
          "line_type": "p",
          "text": "او باز رجوع کرده، بر مارحمت خواهد نمود و عصیان ما را پایمال خواهد کرد و تو جمیع گناهان ایشان را به عمق های دریا خواهی انداخت."
        }
      ],
