    {
      "schema_version": 6,
      "book_id": "MIC",
      "chapter": 3,
      "chapter_usfm": "MIC.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "MIC.3.1",
          "line_type": "p",
          "text": "و گفتم: ای روسای یعقوب وای داوران خاندان اسرائیل بشنوید! آیا بر شما نیست که انصاف را بدانید؟"
        },
        {
          "verse": 2,
          "usfm": "MIC.3.2",
          "line_type": "p",
          "text": "آنانی که از نیکویی نفرت دارند و بر بدی مایل میباشند و پوست را از تن مردم و گوشت را از استخوانهای ایشان میکنند،"
        },
        {
          "verse": 3,
          "usfm": "MIC.3.3",
          "line_type": "p",
          "text": "و کسانی که گوشت قوم مرا میخورند و پوست ایشان را از تن ایشان میکنند و استخوانهای ایشان را خرد کرده، آنها را گویا در دیگ و مثل گوشت در پاتیل میریزند."
        },
        {
          "verse": 4,
          "usfm": "MIC.3.4",
          "line_type": "p",
          "text": "آنگاه نزد خداونداستغاثه خواهند نمود و ایشان را اجابت نخواهدنمود بلکه روی خود را در آنزمان از ایشان خواهد پوشانید چونکه مرتکب اعمال زشت شدهاند."
        },
        {
          "verse": 5,
          "usfm": "MIC.3.5",
          "line_type": "p",
          "text": "خداوند درباره انبیایی که قوم مرا گمراه میکنند و به دندانهای خود میگزند و سلامتی راندا میکنند و اگر کسی چیزی به دهان ایشان نگذارد با او تدارک جنگ میبینند، چنین میگوید:"
        },
        {
          "verse": 6,
          "usfm": "MIC.3.6",
          "line_type": "p",
          "text": "از این جهت برای شما شب خواهدبود که رویا نبینید و ظلمت برای شما خواهد بود که فالگیری ننمایید. آفتاب بر انبیاء غروب خواهد کرد و روز بر ایشان تاریک خواهد شد."
        },
        {
          "verse": 7,
          "usfm": "MIC.3.7",
          "line_type": "p",
          "text": "وراییان خجل و فالگیران رسوا شده، جمیع ایشان لبهای خود را خواهند پوشانید چونکه از جانب خدا جواب نخواهد بود."
        },
        {
          "verse": 8,
          "usfm": "MIC.3.8",
          "line_type": "p",
          "text": "و لیکن من از قوت روح خداوند و از انصاف و توانایی مملو شدهام تایعقوب را از عصیان او و اسرائیل را از گناهش خبر دهم."
        },
        {
          "verse": 9,
          "usfm": "MIC.3.9",
          "line_type": "p",
          "text": "ای روسای خاندان یعقوب وای داوران خاندان اسرائیل این را بشنوید! شما که ازانصاف نفرت دارید و تمامی راستی را منحرف میسازید."
        },
        {
          "verse": 10,
          "usfm": "MIC.3.10",
          "line_type": "p",
          "text": "و صهیون را به خون و اورشلیم را به ظلم بنا مینمایید."
        },
        {
          "verse": 11,
          "usfm": "MIC.3.11",
          "line_type": "p",
          "text": "روسای ایشان برای رشوه داوری مینمایند و کاهنان ایشان برای اجرت تعلیم میدهند و انبیای ایشان برای نقره فال میگیرند و بر خداوند توکل نموده، میگویند: آیاخداوند در میان ما نیست پس بلا به ما نخواهدرسید."
        },
        {
          "verse": 12,
          "usfm": "MIC.3.12",
          "line_type": "p",
          "text": "بنابراین صهیون بهسبب شما مثل مزرعه شیار خواهد شد و اورشلیم به توده های سنگ و کوه خانه به بلندیهای جنگل مبدل خواهد گردید."
        }
      ],
