{
  "book_id": "MIC",
  "book_name_en": "Micah",
  "book_name_fa": "میکاه",
  "testament": "OT",
  "version_id": 136,
  "version_abbr": "POV",
  "version_name": "ترجمۀ قدیم",
  "language": "fa",
  "chapter_count": 7,
  "total_verses": 104,
  "chapters": [
    {
      "schema_version": 6,
      "book_id": "MIC",
      "chapter": 1,
      "chapter_usfm": "MIC.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "MIC.1.1",
          "line_type": "p",
          "text": "کلام خداوند که بر میکاه مورشتی در ایام یوتام و آحاز و حزقیا، پادشاهان یهودانازل شد و آن را درباره سامره و اورشلیم دید."
        },
        {
          "verse": 2,
          "usfm": "MIC.1.2",
          "line_type": "p",
          "text": "ای جمیع قومها بشنوید وای زمین و هرچه در آن است گوش بدهید، و خداوند یهوه یعنی خداوند از هیکل قدسش بر شما شاهد باشد."
        },
        {
          "verse": 3,
          "usfm": "MIC.1.3",
          "line_type": "p",
          "text": "زیرا اینک خداوند از مکان خود بیرون میآید ونزول نموده، بر مکان های بلند زمین میخرامد."
        },
        {
          "verse": 4,
          "usfm": "MIC.1.4",
          "line_type": "p",
          "text": "و کوهها زیر او گداخته میشود و وادیها منشق میگردد، مثل موم پیش آتش و مثل آب که به نشیب ریخته شود."
        },
        {
          "verse": 5,
          "usfm": "MIC.1.5",
          "line_type": "p",
          "text": "این همه بهسبب عصیان یعقوب و گناه خاندان اسرائیل است. عصیان یعقوب چیست؟ آیا سامره نیست؟ و مکان های بلند یهودا چیست؟ آیا اورشلیم نمی باشد؟"
        },
        {
          "verse": 6,
          "usfm": "MIC.1.6",
          "line_type": "p",
          "text": "پس سامره را به توده سنگ صحرا و مکان غرس نمودن موها مبدل خواهم ساخت و سنگهایش رابه دره ریخته، بنیادش را منکشف خواهم نمود."
        },
        {
          "verse": 7,
          "usfm": "MIC.1.7",
          "line_type": "p",
          "text": "و همه بتهای تراشیده شده آن خرد و همه مزدهایش به آتش سوخته خواهد شد و همه تماثیلش را خراب خواهم کرد زیرا که از مزدفاحشه آنها را جمع کرد و به مزد فاحشه خواهدبرگشت."
        },
        {
          "verse": 8,
          "usfm": "MIC.1.8",
          "line_type": "p",
          "text": "به این سبب ماتم گرفته، ولوله خواهم نمود و برهنه و عریان راه خواهم رفت و مثل شغالها ماتم خواهم گرفت و مانند شتر مرغها نوحه گری خواهم نمود."
        },
        {
          "verse": 9,
          "usfm": "MIC.1.9",
          "line_type": "p",
          "text": "زیرا که جراحت های وی علاج پذیر نیست چونکه به یهودا رسیده و به دروازه های قوم من یعنی به اورشلیم داخل گردیده است."
        },
        {
          "verse": 10,
          "usfm": "MIC.1.10",
          "line_type": "p",
          "text": "در جت خبر مرسانید و هرگز گریه منمایید. در خانه عفره، در غبار خویشتن راغلطانیدم."
        },
        {
          "verse": 11,
          "usfm": "MIC.1.11",
          "line_type": "p",
          "text": "ای ساکنه شافیر عریان و خجل شده، بگذر. ساکنه صانان بیرون نمی آید. ماتم بیت ایصل مکانش را از شما میگیرد."
        },
        {
          "verse": 12,
          "usfm": "MIC.1.12",
          "line_type": "p",
          "text": "زیرا که ساکنه ماروت به جهت نیکویی درد زه میکشد، چونکه بلا از جانب خداوند به دروازه اورشلیم فرود آمده است."
        },
        {
          "verse": 13,
          "usfm": "MIC.1.13",
          "line_type": "p",
          "text": "ای ساکنه لاکیش اسب تندرورا به ارابه ببند. او ابتدای گناه دختر صهیون بود، چونکه عصیان اسرائیل در تو یافت شده است."
        },
        {
          "verse": 14,
          "usfm": "MIC.1.14",
          "line_type": "p",
          "text": "بنابراین طلاق نامهای به مورشت جت خواهی داد. خانه های اکذیب، چشمه فریبنده برای پادشاهان اسرائیل خواهد بود."
        },
        {
          "verse": 15,
          "usfm": "MIC.1.15",
          "line_type": "p",
          "text": "ای ساکنه مریشه بار دیگر مالکی بر تو خواهم آورد. جلال اسرائیل تا به عدلام خواهد آمد."
        },
        {
          "verse": 16,
          "usfm": "MIC.1.16",
          "line_type": "p",
          "text": "خویشتن را برای فرزندان نازنین خود گر ساز وموی خود را بتراش. گری سر خود را مثل کرکس زیاد کن زیرا که ایشان از نزد تو به اسیری رفتهاند."
        }
      ],
      "verse_count": 16,
