    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 3,
      "chapter_usfm": "JON.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.3.1",
          "line_type": "p",
          "text": "پس کلام خداوند بار دوم بر یونس نازل شده، گفت:"
        },
        {
          "verse": 2,
          "usfm": "JON.3.2",
          "line_type": "p",
          "text": "«برخیز و به نینوا شهر بزرگ برو و آن وعظ را که من به تو خواهم گفت به ایشان ندا کن.»"
        },
        {
          "verse": 3,
          "usfm": "JON.3.3",
          "line_type": "p",
          "text": "آنگاه یونس برخاسته، برحسب فرمان خداوند به نینوا رفت و نینوا شهر بزرگ بود که مسافت سه روز داشت."
        },
        {
          "verse": 4,
          "usfm": "JON.3.4",
          "line_type": "p",
          "text": "و یونس به مسافت یک روز داخل شهر شده، به ندا کردن شروع نمود وگفت بعد از چهل روز نینوا سرنگون خواهد شد."
        },
        {
          "verse": 5,
          "usfm": "JON.3.5",
          "line_type": "p",
          "text": "و مردمان نینوا به خدا ایمان آوردند و روزه راندا کرده، از بزرگ تا کوچک پلاس پوشیدند."
        },
        {
          "verse": 6,
          "usfm": "JON.3.6",
          "line_type": "p",
          "text": "و چون پادشاه نینوا از این امر اطلاع یافت، ازکرسی خود برخاسته، ردای خود را از برکند وپلاس پوشیده، بر خاکستر نشست."
        },
        {
          "verse": 7,
          "usfm": "JON.3.7",
          "line_type": "p",
          "text": "و پادشاه واکابرش فرمان دادند تا در نینوا ندا دردادند وامرفرموده، گفتند که «مردمان و بهایم و گاوان وگوسفندان چیزی نخورند و نچرند و آب ننوشند."
        },
        {
          "verse": 8,
          "usfm": "JON.3.8",
          "line_type": "p",
          "text": "و مردمان و بهایم به پلاس پوشیده شوند و نزدخدا بشدت استغاثه نمایند و هرکس از راه بدخود و از ظلمی که در دست او است بازگشت نماید."
        },
        {
          "verse": 9,
          "usfm": "JON.3.9",
          "line_type": "p",
          "text": "کیست بداند که شاید خدا برگشته، پشیمان شود و از حدت خشم خود رجوع نمایدتا هلاک نشویم.»"
        },
        {
          "verse": 10,
          "usfm": "JON.3.10",
          "line_type": "p",
          "text": "پس چون خدا اعمال ایشان را دید که از راه زشت خود بازگشت نمودند، آنگاه خدا از بلایی که گفته بود که به ایشان برساند پشیمان گردید وآن را بعمل نیاورد."
        }
      ],
