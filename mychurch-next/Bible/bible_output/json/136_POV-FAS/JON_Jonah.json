    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 4,
      "chapter_usfm": "JON.4",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.4.1",
          "line_type": "p",
          "text": "اما این امر یونس را به غایت ناپسند آمد وغیظش افروخته شد،"
        },
        {
          "verse": 2,
          "usfm": "JON.4.2",
          "line_type": "p",
          "text": "و نزد خداوند دعانموده، گفت: «آهای خداوند، آیا این سخن من نبود حینی که در ولایت خود بودم و از این سبب به فرار کردن به ترشیش مبادرت نمودم زیرامی دانستم که تو خدای کریم و رحیم و دیر غضب و کثیر احسان هستی و از بلا پشیمان میشوی؟"
        },
        {
          "verse": 3,
          "usfm": "JON.4.3",
          "line_type": "p",
          "text": "پس حالای خداوند جانم را از من بگیر زیرا که مردن از زنده ماندن برای من بهتر است.»"
        },
        {
          "verse": 4,
          "usfm": "JON.4.4",
          "line_type": "p",
          "text": "خداوندگفت: «آیا صواب است که خشمناک شوی؟»"
        },
        {
          "verse": 5,
          "usfm": "JON.4.5",
          "line_type": "p",
          "text": "و یونس از شهر بیرون رفته، بطرف شرقی شهر نشست و در آنجا سایه بانی برای خودساخته زیر سایهاش نشست تا ببیند بر شهرچه واقع خواهد شد."
        },
        {
          "verse": 6,
          "usfm": "JON.4.6",
          "line_type": "p",
          "text": "و یهوه خدا کدویی رویانید وآن را بالای یونس نمو داد تا بر سر وی سایه افکنده، او را از حزنش آسایش دهد و یونس ازکدو بینهایت شادمان شد."
        },
        {
          "verse": 7,
          "usfm": "JON.4.7",
          "line_type": "p",
          "text": "اما در فردای آن روزدر وقت طلوع فجر خدا کرمی پیدا کرد که کدو رازد و خشک شد."
        },
        {
          "verse": 8,
          "usfm": "JON.4.8",
          "line_type": "p",
          "text": "و چون آفتاب برآمد خدا بادشرقی گرم وزانید و آفتاب بر سر یونس تابید به حدی که بیتاب شده، برای خود مسالت نمود که بمیرد و گفت: «مردن از زنده ماندن برای من بهتراست.»"
        },
        {
          "verse": 9,
          "usfm": "JON.4.9",
          "line_type": "p",
          "text": "خدا به یونس جواب داد: «آیا صواب است که به جهت کدو غضبناک شوی؟» او گفت: «صواب است که تا به مرگ غضبناک شوم.»"
        },
        {
          "verse": 10,
          "usfm": "JON.4.10",
          "line_type": "p",
          "text": "خداوند گفت: «دل تو برای کدو بسوخت که برای آن زحمت نکشیدی و آن را نمو ندادی که در یک شب بوجود آمد و در یک شب ضایع گردید."
        }
