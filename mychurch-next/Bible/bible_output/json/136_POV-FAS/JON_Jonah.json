    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 2,
      "chapter_usfm": "JON.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.2.1",
          "line_type": "p",
          "text": "و یونس از شکم ماهی نزد یهوه خدای خود دعا نمود"
        },
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "line_type": "p",
          "text": "و گفت: «در تنگی خودخداوند را خواندم و مرا مستجاب فرمود. ازشکم هاویه تضرع نمودم و آواز مرا شنیدی."
        },
        {
          "verse": 3,
          "usfm": "JON.2.3",
          "line_type": "p",
          "text": "زیرا که مرا به ژرفی در دل دریاها انداختی وسیلها مرا احاطه نمود. جمیع خیزابها و موجهای تو بر من گذشت."
        },
        {
          "verse": 4,
          "usfm": "JON.2.4",
          "line_type": "p",
          "text": "و من گفتم از پیش چشم توانداخته شدم. لیکن هیکل قدس تو را باز خواهم دید."
        },
        {
          "verse": 5,
          "usfm": "JON.2.5",
          "line_type": "p",
          "text": "آبها مرا تا بهجان احاطه نمود و لجه دورمرا گرفت و علف دریا بسر من پیچیده شد."
        },
        {
          "verse": 6,
          "usfm": "JON.2.6",
          "line_type": "p",
          "text": "به بنیان کوهها فرود رفتم و زمین به بندهای خود تا به ابد مرا درگرفت. اما توای یهوه خدایم حیات مرااز حفره برآوردی."
        },
        {
          "verse": 7,
          "usfm": "JON.2.7",
          "line_type": "p",
          "text": "چون جان من در اندرونم بیتاب شد، خداوند را بیاد آوردم و دعای من نزدتو به هیکل قدست رسید."
        },
        {
          "verse": 8,
          "usfm": "JON.2.8",
          "line_type": "p",
          "text": "آنانی که اباطیل دروغ را منظور میدارند، احسان های خویش را ترک مینمایند."
        },
        {
          "verse": 9,
          "usfm": "JON.2.9",
          "line_type": "p",
          "text": "اما من به آواز تشکر برای تو قربانی خواهم گذرانید، و به آنچه نذر کردم وفا خواهم نمود. نجات از آن خداوند است.»"
        },
        {
          "verse": 10,
          "usfm": "JON.2.10",
          "line_type": "p",
          "text": "پس خداوند ماهی را امر فرمود و یونس را بر خشکی قی کرد."
        }
      ],
      "verse_count": 10,
