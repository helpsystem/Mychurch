    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 5,
      "chapter_usfm": "1TH.5",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.5.1",
          "line_type": "p",
          "text": "اماای برادران در خصوص وقتها و زمانها، احتیاج ندارید که به شما بنویسم."
        },
        {
          "verse": 2,
          "usfm": "1TH.5.2",
          "line_type": "p",
          "text": "زیراخود شما به تحقیق آگاهید که روز خداوند چون دزد در شب میآید."
        },
        {
          "verse": 3,
          "usfm": "1TH.5.3",
          "line_type": "p",
          "text": "زیرا هنگامی که میگویندسلامتی و امان است، آنگاه هلاکت ایشان راناگهان فرو خواهد گرفت، چون درد زه زن حامله را و هرگز رستگار نخواهند شد."
        },
        {
          "verse": 4,
          "usfm": "1TH.5.4",
          "line_type": "p",
          "text": "لیکن شماای برادران در ظلمت نیستید تا آن روز چون دزد برشما آید،"
        },
        {
          "verse": 5,
          "usfm": "1TH.5.5",
          "line_type": "p",
          "text": "زیرا جمیع شما پسران نور و پسران روز هستید، از شب و ظلمت نیستیم."
        },
        {
          "verse": 6,
          "usfm": "1TH.5.6",
          "line_type": "p",
          "text": "بنابراین مثل دیگران به خواب نرویم بلکه بیدار و هشیارباشیم."
        },
        {
          "verse": 7,
          "usfm": "1TH.5.7",
          "line_type": "p",
          "text": "زیرا خوابیدگان در شب میخوابند ومستان در شب مست میشوند."
        },
        {
          "verse": 8,
          "usfm": "1TH.5.8",
          "line_type": "p",
          "text": "لیکن ما که ازروز هستیم، هشیار بوده، جوشن ایمان و محبت وخود امید نجات را بپوشیم."
        },
        {
          "verse": 9,
          "usfm": "1TH.5.9",
          "line_type": "p",
          "text": "زیرا خدا ما را تعیین نکرد برای غضب بلکه بجهت تحصیل نجات، بوسیله خداوند ما عیسی مسیح،"
        },
        {
          "verse": 10,
          "usfm": "1TH.5.10",
          "line_type": "p",
          "text": "که برای مامرد تا خواه بیدار باشیم و خواه خوابیده، همراه وی زیست کنیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.5.11",
          "line_type": "p",
          "text": "پس همدیگر را تسلی دهیدو یکدیگر را بنا کنید، چنانکه هم میکنید."
        },
        {
          "verse": 12,
          "usfm": "1TH.5.12",
          "line_type": "p",
          "text": "اماای برادران به شما التماس داریم که بشناسید آنانی را که در میان شما زحمت میکشند و پیشوایان شما در خداوند بوده، شمارا نصیحت میکنند."
        },
        {
          "verse": 13,
          "usfm": "1TH.5.13",
          "line_type": "p",
          "text": "و ایشان را در نهایت محبت، بهسبب عملشان محترم دارید و بایکدیگر صلح کنید."
        },
        {
          "verse": 14,
          "usfm": "1TH.5.14",
          "line_type": "p",
          "text": "لیکنای برادران، از شمااستدعا داریم که سرکشان را تنبیه نمایید وکوتاه دلان را دلداری دهید و ضعفا را حمایت کنید و با جمیع مردم تحمل کنید."
        },
        {
          "verse": 15,
          "usfm": "1TH.5.15",
          "line_type": "p",
          "text": "زنهار کسی با کسی به سزای بدی بدی نکند، بلکه دائم بایکدیگر و با جمیع مردم درپی نیکویی بکوشید."
        },
        {
          "verse": 16,
          "usfm": "1TH.5.16",
          "line_type": "p",
          "text": "پیوسته شادمان باشید."
        },
        {
          "verse": 17,
          "usfm": "1TH.5.17",
          "line_type": "p",
          "text": "همیشه دعا کنید."
        },
        {
          "verse": 18,
          "usfm": "1TH.5.18",
          "line_type": "p",
          "text": "در هر امری شاکر باشید که این است اراده خدادر حق شما در مسیح عیسی."
        },
        {
          "verse": 19,
          "usfm": "1TH.5.19",
          "line_type": "p",
          "text": "روح را اطفامکنید."
        },
        {
          "verse": 20,
          "usfm": "1TH.5.20",
          "line_type": "p",
          "text": "نبوتها را خوار مشمارید."
        },
        {
          "verse": 21,
          "usfm": "1TH.5.21",
          "line_type": "p",
          "text": "همهچیزرا تحقیق کنید، و به آنچه نیکو است متمسک باشید."
        },
        {
          "verse": 22,
          "usfm": "1TH.5.22",
          "line_type": "p",
          "text": "از هر نوع بدی احتراز نمایید."
        },
        {
          "verse": 23,
          "usfm": "1TH.5.23",
          "line_type": "p",
          "text": "اما خود خدای سلامتی، شما را بالکل مقدس گرداناد و روح و نفس و بدن شما تمام بیعیب محفوظ باشد در وقت آمدن خداوند ماعیسی مسیح."
        },
        {
          "verse": 24,
          "usfm": "1TH.5.24",
          "line_type": "p",
          "text": "امین است دعوت کننده شما که این را هم خواهد کرد."
        },
        {
          "verse": 25,
          "usfm": "1TH.5.25",
          "line_type": "p",
          "text": "ای برادران، برای ما دعا کنید."
        },
        {
          "verse": 26,
          "usfm": "1TH.5.26",
          "line_type": "p",
          "text": "جمیع برادران را به بوسه مقدسانه تحیت نمایید."
        },
        {
          "verse": 27,
          "usfm": "1TH.5.27",
          "line_type": "p",
          "text": "شمارا به خداوند قسم میدهم که این رساله برای جمیع برادران مقدس خوانده شود."
        }
      ],
