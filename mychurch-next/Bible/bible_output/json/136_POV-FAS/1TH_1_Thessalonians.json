    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 3,
      "chapter_usfm": "1TH.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.3.1",
          "line_type": "p",
          "text": "پس چون دیگر شکیبایی نداشتیم، رضابدین دادیم که ما را در اتینا تنها واگذاردند."
        },
        {
          "verse": 2,
          "usfm": "1TH.3.2",
          "line_type": "p",
          "text": "و تیموتاوس را که برادر ما و خادم خدا درانجیل مسیح است، فرستادیم تا شما را استوارسازد و در خصوص ایمانتان شما را نصیحت کند."
        },
        {
          "verse": 3,
          "usfm": "1TH.3.3",
          "line_type": "p",
          "text": "تا هیچکس از این مصائب متزلزل نشود، زیراخود میدانید که برای همین مقرر شدهایم."
        },
        {
          "verse": 4,
          "usfm": "1TH.3.4",
          "line_type": "p",
          "text": "زیراهنگامی که نزد شما بودیم، شما را پیش خبردادیم که میباید زحمت بکشیم، چنانکه واقع شدو میدانید."
        },
        {
          "verse": 5,
          "usfm": "1TH.3.5",
          "line_type": "p",
          "text": "لهذا من نیز چون شکیبایی نداشتم، فرستادم تا ایمان شما را تحقیق کنم مبادا که آن تجربه کننده، شما را تجربه کرده باشد و محنت ماباطل گردد."
        },
        {
          "verse": 6,
          "usfm": "1TH.3.6",
          "line_type": "p",
          "text": "اما الحال چون تیموتاوس از نزد شما به مارسید و مژده ایمان و محبت شما را به ما رسانید واینکه شما پیوسته ما را نیکو یاد میکنید و مشتاق ملاقات ما میباشید، چنانکه ما نیز شایق شماهستیم،"
        },
        {
          "verse": 7,
          "usfm": "1TH.3.7",
          "line_type": "p",
          "text": "لهذاای برادران، در همه ضیق ومصیبتی که داریم، از شما بهسبب ایمانتان تسلی یافتیم."
        },
        {
          "verse": 8,
          "usfm": "1TH.3.8",
          "line_type": "p",
          "text": "چونکه الان زیست میکنیم، اگر شما درخداوند استوار هستید."
        },
        {
          "verse": 9,
          "usfm": "1TH.3.9",
          "line_type": "p",
          "text": "زیرا چه شکرگزاری به خدا توانیم نمود بهسبب این همه خوشیای که به حضور خدا درباره شما داریم؛"
        },
        {
          "verse": 10,
          "usfm": "1TH.3.10",
          "line_type": "p",
          "text": "که شبانهروزبی شمار دعا میکنیم تا شما را روبرو ملاقات کنیم و نقص ایمان شما را بهکمال رسانیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.3.11",
          "line_type": "p",
          "text": "اماخود خدا یعنی پدر ما و خداوند ما عیسی مسیح راه ما را به سوی شما راست بیاورد."
        },
        {
          "verse": 12,
          "usfm": "1TH.3.12",
          "line_type": "p",
          "text": "و خداوندشما را نمو دهد و درمحبت با یکدیگر و با همه افزونی بخشد، چنانکه ما شما را محبت مینماییم،"
        },
        {
          "verse": 13,
          "usfm": "1TH.3.13",
          "line_type": "p",
          "text": "تا دلهای شما را استوار سازد، بیعیب در قدوسیت، به حضور خدا و پدر ما درهنگام ظهور خداوند ما عیسی مسیح، با جمیع مقدسین خود."
        }
      ],
