  "chapters": [
    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 1,
      "chapter_usfm": "1TH.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.1.1",
          "line_type": "p",
          "text": "پولس و سلوانس و تیموتاوس، به کلیسای تسالونیکیان که در خدای پدر وعیسی مسیح خداوند میباشید.فیض و سلامتی از جانب پدر ما خدا و عیسی مسیح خداوند با شما باد."
        },
        {
          "verse": 2,
          "usfm": "1TH.1.2",
          "line_type": "p",
          "text": "پیوسته درباره جمیع شما خدا را شکرمی کنیم و دائم در دعاهای خود شما را ذکرمی نماییم،"
        },
        {
          "verse": 3,
          "usfm": "1TH.1.3",
          "line_type": "p",
          "text": "چون اعمال ایمان شما و محنت محبت و صبر امید شما را در خداوند ما عیسی مسیح در حضور خدا و پدر خود یاد میکنیم."
        },
        {
          "verse": 4,
          "usfm": "1TH.1.4",
          "line_type": "p",
          "text": "زیرا کهای برادران وای عزیزان خدا، ازبرگزیده شدن شما مطلع هستیم،"
        },
        {
          "verse": 5,
          "usfm": "1TH.1.5",
          "line_type": "p",
          "text": "زیرا که انجیل ما بر شما محض سخن وارد نشده، بلکه با قوت وروحالقدس و یقین کامل، چنانکه میدانید که درمیان شما بخاطر شما چگونه مردمان شدیم."
        },
        {
          "verse": 6,
          "usfm": "1TH.1.6",
          "line_type": "p",
          "text": "وشما به ما و به خداوند اقتدا نمودید و کلام را درزحمت شدید، با خوشی روحالقدس پذیرفتید،"
        },
        {
          "verse": 7,
          "usfm": "1TH.1.7",
          "line_type": "p",
          "text": "به حدی که شما جمیع ایمانداران مکادونیه واخائیه را نمونه شدید،"
        },
        {
          "verse": 8,
          "usfm": "1TH.1.8",
          "line_type": "p",
          "text": "بنوعی که از شما کلام خداوند نه فقط در مکادونیه و اخائیه نواخته شد، بلکه در هرجا ایمان شما به خدا شیوع یافت، بقسمی که احتیاج نیست که ما چیزی بگوییم،"
        },
        {
          "verse": 9,
          "usfm": "1TH.1.9",
          "line_type": "p",
          "text": "زیرا خود ایشان درباره ما خبر میدهند که چه قسم وارد به شما شدیم و به چه نوع شما از بتها به سوی خدا بازگشت کردید تا خدای حی حقیقی را بندگی نمایید،"
        },
        {
          "verse": 10,
          "usfm": "1TH.1.10",
          "line_type": "p",
          "text": "و تا پسر او را از آسمان انتظاربکشید که او را از مردگان برخیزانید، یعنی عیسی که ما را از غضب آینده میرهاند."
        }
      ],
      "verse_count": 10,
