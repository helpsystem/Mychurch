    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 4,
      "chapter_usfm": "1TH.4",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.4.1",
          "line_type": "p",
          "text": "خلاصهای برادران، از شما در عیسی خداوند استدعا و التماس میکنیم که چنانکه از ما یافتهاید که به چه نوع باید رفتار کنیدو خدا را راضی سازید، به همانطور زیادتر ترقی نمایید."
        },
        {
          "verse": 2,
          "usfm": "1TH.4.2",
          "line_type": "p",
          "text": "زیرا میدانید چه احکام از جانب عیسی خداوند به شما دادیم."
        },
        {
          "verse": 3,
          "usfm": "1TH.4.3",
          "line_type": "p",
          "text": "زیرا که این است اراده خدا یعنی قدوسیت شما تا از زنا بپرهیزید."
        },
        {
          "verse": 4,
          "usfm": "1TH.4.4",
          "line_type": "p",
          "text": "تاهرکسی از شما بداند چگونه باید ظرف خویشتن را در قدوسیت و عزت دریابد،"
        },
        {
          "verse": 5,
          "usfm": "1TH.4.5",
          "line_type": "p",
          "text": "و نه در هوس شهوت، مثل امت هایی که خدا را نمی شناسند."
        },
        {
          "verse": 6,
          "usfm": "1TH.4.6",
          "line_type": "p",
          "text": "و تا کسی در این امر دست تطاول یا طمع بر برادر خود دراز نکند، زیرا خداوند از تمامی چنین کارها انتقام کشنده است."
        },
        {
          "verse": 7,
          "usfm": "1TH.4.7",
          "line_type": "p",
          "text": "چنانکه سابق نیز به شما گفته و حکم کردهایم، زیرا خدا ما را به ناپاکی نخوانده است، بلکه به قدوسیت."
        },
        {
          "verse": 8,
          "usfm": "1TH.4.8",
          "line_type": "p",
          "text": "لهذا هرکه حقیر شمارد، انسان را حقیر نمی شمارد، بلکه خدا را که روح قدوس خود را به شما عطا کرده است."
        },
        {
          "verse": 9,
          "usfm": "1TH.4.9",
          "line_type": "p",
          "text": "اما در خصوص محبت برادرانه، لازم نیست که به شما بنویسم، زیرا خود شما از خدا آموخته شدهاید که یکدیگر را محبت نمایید؛"
        },
        {
          "verse": 10,
          "usfm": "1TH.4.10",
          "line_type": "p",
          "text": "و چنین هم میکنید با همه برادرانی که در تمام مکادونیه میباشند. لیکنای برادران از شما التماس داریم که زیادتر ترقی کنید."
        },
        {
          "verse": 11,
          "usfm": "1TH.4.11",
          "line_type": "p",
          "text": "و حریص باشید در اینکه آرام شوید و بهکارهای خود مشغول شده، بهدستهای خویش کسب نمایید، چنانکه شما راحکم کردیم،"
        },
        {
          "verse": 12,
          "usfm": "1TH.4.12",
          "line_type": "p",
          "text": "تا نزد آنانی که خارجاند بطورشایسته رفتار کنید و به هیچچیز محتاج نباشید."
        },
        {
          "verse": 13,
          "usfm": "1TH.4.13",
          "line_type": "p",
          "text": "اماای برادران نمی خواهیم شما از حالت خوابیدگان بیخبر باشید که مبادا مثل دیگران که امید ندارند، محزون شوید."
        },
        {
          "verse": 14,
          "usfm": "1TH.4.14",
          "line_type": "p",
          "text": "زیرا اگر باورمی کنیم که عیسی مرد و برخاست، به همینطورنیز خدا آنانی را که در عیسی خوابیدهاند با وی خواهد آورد."
        },
        {
          "verse": 15,
          "usfm": "1TH.4.15",
          "line_type": "p",
          "text": "زیرا این را به شما از کلام خدامی گوییم که ما که زنده و تا آمدن خداوند باقی باشیم برخوابیدگان سبقت نخواهیم جست."
        },
        {
          "verse": 16,
          "usfm": "1TH.4.16",
          "line_type": "p",
          "text": "زیرا خود خداوند با صدا و با آواز رئیس فرشتگان و با صور خدا از آسمان نازل خواهدشد و مردگان در مسیح اول خواهند برخاست."
        },
        {
          "verse": 17,
          "usfm": "1TH.4.17",
          "line_type": "p",
          "text": "آنگاه ما که زنده و باقی باشیم، با ایشان در ابرهاربوده خواهیم شد تا خداوند را در هوا استقبال کنیم و همچنین همیشه با خداوند خواهیم بود."
        },
        {
          "verse": 18,
          "usfm": "1TH.4.18",
          "line_type": "p",
          "text": "پس بدین سخنان همدیگر را تسلی دهید."
        }
      ],
      "verse_count": 18,
