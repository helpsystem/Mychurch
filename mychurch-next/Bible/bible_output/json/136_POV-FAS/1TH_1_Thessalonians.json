    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 2,
      "chapter_usfm": "1TH.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.2.1",
          "line_type": "p",
          "text": "زیراای برادران، خود میدانید که ورود مادر میان شما باطل نبود."
        },
        {
          "verse": 2,
          "usfm": "1TH.2.2",
          "line_type": "p",
          "text": "بلکه هرچند قبل از آن در فیلپی زحمت کشیده و بیاحترامی دیده بودیم، چنانکه اطلاع دارید، لیکن در خدای خوددلیری کردیم تا انجیل خدا را با جد و جهد شدیدبه شما اعلام نماییم."
        },
        {
          "verse": 3,
          "usfm": "1TH.2.3",
          "line_type": "p",
          "text": "زیرا که نصیحت ما ازگمراهی و خباثت و ریا نیست،"
        },
        {
          "verse": 4,
          "usfm": "1TH.2.4",
          "line_type": "p",
          "text": "بلکه چنانکه مقبول خدا گشتیم که وکلای انجیل بشویم، همچنین سخن میگوییم و طالب رضامندی مردم نیستیم، بلکه رضامندی خدایی که دلهای ما رامی آزماید."
        },
        {
          "verse": 5,
          "usfm": "1TH.2.5",
          "line_type": "p",
          "text": "زیرا هرگز سخن تملقآمیز نگفتیم، چنانکه میدانید، و نه بهانه طمع کردیم، خداشاهد است؛"
        },
        {
          "verse": 6,
          "usfm": "1TH.2.6",
          "line_type": "p",
          "text": "و نه بزرگی از خلق جستیم، نه ازشما و نه از دیگران، هرچند چون رسولان مسیح بودیم، میتوانستیم سنگین باشیم."
        },
        {
          "verse": 7,
          "usfm": "1TH.2.7",
          "line_type": "p",
          "text": "بلکه در میان شما به ملایمت بسر میبردیم، مثل دایهای که اطفال خود را میپرورد."
        },
        {
          "verse": 8,
          "usfm": "1TH.2.8",
          "line_type": "p",
          "text": "بدین طرز شایق شماشده، راضی میبودیم که نه همان انجیل خدا را به شما دهیم، بلکه جانهای خود را نیز از بس که عزیز ما بودید."
        },
        {
          "verse": 9,
          "usfm": "1TH.2.9",
          "line_type": "p",
          "text": "زانرو کهای برادران محنت ومشقت ما را یاد میدارید زیرا که شبانهروز درکار مشغول شده، به انجیل خدا شما راموعظه میکردیم که مبادا بر کسی از شما بارنهیم."
        },
        {
          "verse": 10,
          "usfm": "1TH.2.10",
          "line_type": "p",
          "text": "شما شاهد هستید و خدا نیز که به چه نوع باقدوسیت و عدالت و بیعیبی نزد شما که ایماندارهستید رفتار نمودیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.2.11",
          "line_type": "p",
          "text": "چنانکه میدانید که هریکی از شما را چون پدر، فرزندان خود رانصیحت و دلداری مینمودیم،"
        },
        {
          "verse": 12,
          "usfm": "1TH.2.12",
          "line_type": "p",
          "text": "و وصیت میکردیم که رفتار بکنید بطور شایسته خدایی که شما را به ملکوت و جلال خود میخواند."
        },
        {
          "verse": 13,
          "usfm": "1TH.2.13",
          "line_type": "p",
          "text": "و ازاینجهت ما نیز دائم خدا را شکر میکنیم که چون کلام خدا را که از ما شنیده بودید یافتید، آن راکلام انسانی نپذیرفتید، بلکه چنانکه فی الحقیقه است، کلام خدا که در شما که ایماندار هستیدعمل میکند."
        },
        {
          "verse": 14,
          "usfm": "1TH.2.14",
          "line_type": "p",
          "text": "زیرا کهای برادران، شما اقتدانمودید به کلیساهای خدا که در یهودیه در مسیح عیسی میباشند، زیرا که شما از قوم خود همان زحمات را کشیدید که ایشان نیز از یهود دیدند،"
        },
        {
          "verse": 15,
          "usfm": "1TH.2.15",
          "line_type": "p",
          "text": "که عیسی خداوند و انبیای خود را کشتند و برما جفا کردند؛ و ایشان ناپسند خدا هستند ومخالف جمیع مردم،"
        },
        {
          "verse": 16,
          "usfm": "1TH.2.16",
          "line_type": "p",
          "text": "و ما را منع میکنند که به امتها سخن بگوییم تا نجات یابند و همیشه گناهان خود را لبریز میکنند، اما منتهای غضب ایشان را فروگرفته است."
        },
        {
          "verse": 17,
          "usfm": "1TH.2.17",
          "line_type": "p",
          "text": "لیکن ماای برادران، چون بقدر ساعتی درظاهر نه در دل از شما مهجور شدیم، به اشتیاق بسیار زیادتر کوشیدیم تا روی شما را ببینیم."
        },
        {
          "verse": 18,
          "usfm": "1TH.2.18",
          "line_type": "p",
          "text": "وبدین جهت یک دو دفعه خواستیم نزد شما بیاییم یعنی من، پولس، لیکن شیطان ما را نگذاشت."
        },
        {
          "verse": 19,
          "usfm": "1TH.2.19",
          "line_type": "p",
          "text": "زیرا که چیست امید و سرور و تاج فخر ما؟ مگر شما نیستید در حضور خداوند ما عیسی درهنگام ظهور او؟"
        },
        {
          "verse": 20,
          "usfm": "1TH.2.20",
          "line_type": "p",
          "text": "زیرا که شما جلال و خوشی ما هستید."
        }
      ],
      "verse_count": 20,
