    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 2,
      "chapter_usfm": "2TH.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.2.1",
          "line_type": "p",
          "text": "اماای برادران، از شما استدعا میکنیم درباره آمدن خداوند ما عیسی مسیح وجمع شدن ما به نزد او،"
        },
        {
          "verse": 2,
          "usfm": "2TH.2.2",
          "line_type": "p",
          "text": "که شما از هوش خودبزودی متزلزل نشوید و مضطرب نگردید، نه ازروح و نه از کلام و نه از رسالهای که گویا از ماباشد، بدین مضمون که روز مسیح رسیده است."
        },
        {
          "verse": 3,
          "usfm": "2TH.2.3",
          "line_type": "p",
          "text": "زنهار کسی به هیچ وجه شما را نفریبد، زیرا که تاآن ارتداد، اول واقع نشود و آن مرد شریر یعنی فرزند هلاکت ظاهر نگردد، آن روز نخواهد آمد؛"
        },
        {
          "verse": 4,
          "usfm": "2TH.2.4",
          "line_type": "p",
          "text": "که او مخالفت میکند و خود را بلندتر میسازداز هرچه به خدا یا به معبود مسمی شود، بحدی که مثل خدا در هیکل خدا نشسته، خود را می نماید که خداست."
        },
        {
          "verse": 5,
          "usfm": "2TH.2.5",
          "line_type": "p",
          "text": "آیا یاد نمی کنید که هنگامی که هنوز نزد شمامی بودم، این را به شما میگفتم؟"
        },
        {
          "verse": 6,
          "usfm": "2TH.2.6",
          "line_type": "p",
          "text": "و الان آنچه راکه مانع است میدانید تا او در زمان خود ظاهربشود."
        },
        {
          "verse": 7,
          "usfm": "2TH.2.7",
          "line_type": "p",
          "text": "زیرا که آن سر بیدینی الان عمل میکندفقط تا وقتی که آنکه تا به حال مانع است از میان برداشته شود."
        },
        {
          "verse": 8,
          "usfm": "2TH.2.8",
          "line_type": "p",
          "text": "آنگاه آن بیدین ظاهر خواهد شدکه عیسی خداوند او را به نفس دهان خود هلاک خواهد کرد و به تجلی ظهور خویش، او را نابودخواهد ساخت؛"
        },
        {
          "verse": 9,
          "usfm": "2TH.2.9",
          "line_type": "p",
          "text": "که ظهور او بعمل شیطان است با هر نوع قوت و آیات و عجایب دروغ"
        },
        {
          "verse": 10,
          "usfm": "2TH.2.10",
          "line_type": "p",
          "text": "و به هرقسم فریب ناراستی برای هالکین، از آنجا که محبت راستی را نپذیرفتند تا نجات یابند."
        },
        {
          "verse": 11,
          "usfm": "2TH.2.11",
          "line_type": "p",
          "text": "وبدین جهت خدا به ایشان عمل گمراهی میفرستد تا دروغ را باور کنند"
        },
        {
          "verse": 12,
          "usfm": "2TH.2.12",
          "line_type": "p",
          "text": "و تا فتوایی شود بر همه کسانی که راستی را باور نکردند بلکه به ناراستی شاد شدند."
        },
        {
          "verse": 13,
          "usfm": "2TH.2.13",
          "line_type": "p",
          "text": "اماای برادران وای عزیزان خداوند، میباید ما همیشه برای شما خدا را شکر نماییم که از ابتدا خدا شما را برگزید برای نجات به تقدیس روح و ایمان به راستی."
        },
        {
          "verse": 14,
          "usfm": "2TH.2.14",
          "line_type": "p",
          "text": "و برای آن شمارا دعوت کرد بوسیله بشارت ما برای تحصیل جلال خداوند ما عیسی مسیح."
        },
        {
          "verse": 15,
          "usfm": "2TH.2.15",
          "line_type": "p",
          "text": "پسای برادران، استوار باشید و آن روایات را که خواه ازکلام و خواه از رساله ما آموختهاید، نگاه دارید."
        },
        {
          "verse": 16,
          "usfm": "2TH.2.16",
          "line_type": "p",
          "text": "و خود خداوند ما عیسی مسیح و خدا و پدر ماکه ما را محبت نمود و تسلی ابدی و امید نیکو رابه فیض خود به ما بخشید،"
        },
        {
          "verse": 17,
          "usfm": "2TH.2.17",
          "line_type": "p",
          "text": "دلهای شما راتسلی عطا کناد و شما را در هر فعل و قول نیکواستوار گرداناد."
        }
      ],
      "verse_count": 17,
