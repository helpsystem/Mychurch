    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 3,
      "chapter_usfm": "2TH.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.3.1",
          "line_type": "p",
          "text": "خلاصهای برادران، برای ما دعا کنید تاکلام خداوند جاری شود و جلال یابدچنانکه در میان شما نیز؛"
        },
        {
          "verse": 2,
          "usfm": "2TH.3.2",
          "line_type": "p",
          "text": "و تا از مردم ناشایسته شریر برهیم زیرا که همه را ایمان نیست."
        },
        {
          "verse": 3,
          "usfm": "2TH.3.3",
          "line_type": "p",
          "text": "اما امین است آن خداوندی که شما را استوار و از شریرمحفوظ خواهد ساخت."
        },
        {
          "verse": 4,
          "usfm": "2TH.3.4",
          "line_type": "p",
          "text": "اما بر شما در خداونداعتماد داریم که آنچه به شما امر کنیم، بعمل میآورید و نیز خواهید آورد."
        },
        {
          "verse": 5,
          "usfm": "2TH.3.5",
          "line_type": "p",
          "text": "و خداوند دلهای شما را به محبت خدا و به صبر مسیح هدایت کناد."
        },
        {
          "verse": 6,
          "usfm": "2TH.3.6",
          "line_type": "p",
          "text": "ولیای برادران، شما را به نام خداوند خودعیسی مسیح حکم میکنیم که از هر برادری که بینظم رفتار میکند و نه برحسب آن قانونی که ازما یافتهاید، اجتناب نمایید."
        },
        {
          "verse": 7,
          "usfm": "2TH.3.7",
          "line_type": "p",
          "text": "زیرا خود آگاه هستید که به چه قسم به ما اقتدا میباید نمود، چونکه در میان شما بینظم رفتار نکردیم،"
        },
        {
          "verse": 8,
          "usfm": "2TH.3.8",
          "line_type": "p",
          "text": "و نان هیچکس را مفت نخوردیم بلکه به محنت ومشقت شبانهروز بهکار مشغول میبودیم تا براحدی از شما بار ننهیم."
        },
        {
          "verse": 9,
          "usfm": "2TH.3.9",
          "line_type": "p",
          "text": "نه آنکه اختیار نداریم بلکه تا خود را نمونه برای شما سازیم تا به ما اقتدانمایید."
        },
        {
          "verse": 10,
          "usfm": "2TH.3.10",
          "line_type": "p",
          "text": "زیرا هنگامی که نزد شما هم میبودیم، این را به شما امر فرمودیم که اگر کسی خواهد کارنکند، خوراک هم نخورد."
        },
        {
          "verse": 11,
          "usfm": "2TH.3.11",
          "line_type": "p",
          "text": "زیرا شنیدیم که بعضی در میان شما بینظم رفتار میکنند که کاری نمی کنند بلکه فضول هستند."
        },
        {
          "verse": 12,
          "usfm": "2TH.3.12",
          "line_type": "p",
          "text": "اما چنین اشخاص را در خداوند ما عیسی مسیح حکم ونصیحت میکنیم که به آرامی کار کرده، نان خود را بخورند."
        },
        {
          "verse": 13,
          "usfm": "2TH.3.13",
          "line_type": "p",
          "text": "اما شماای برادران از نیکوکاری خسته خاطر مشوید."
        },
        {
          "verse": 14,
          "usfm": "2TH.3.14",
          "line_type": "p",
          "text": "ولی اگر کسی سخن ما رادر این رساله اطاعت نکند، بر او نشانه گذارید و باوی معاشرت مکنید تا شرمنده شود."
        },
        {
          "verse": 15,
          "usfm": "2TH.3.15",
          "line_type": "p",
          "text": "اما او رادشمن مشمارید بلکه چون برادر او را تنبیه کنید."
        },
        {
          "verse": 16,
          "usfm": "2TH.3.16",
          "line_type": "p",
          "text": "اما خود خداوند سلامتی شما را پیوسته درهر صورت، سلامتی عطا کناد و خداوند با همگی شما باد."
        },
        {
          "verse": 17,
          "usfm": "2TH.3.17",
          "line_type": "p",
          "text": "تحیت بهدست من پولس که علامت در هر رساله است بدینطور مینویسم:"
        }
      ],
