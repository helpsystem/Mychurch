  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 1,
      "chapter_usfm": "2TH.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.1.1",
          "line_type": "p",
          "text": "پولس و سلوانس و تیموتاوس، به کلیسای تسالونیکیان که در خدای پدر ماو عیسی مسیح خداوند میباشید."
        },
        {
          "verse": 2,
          "usfm": "2TH.1.2",
          "line_type": "p",
          "text": "فیض و سلامتی از جانب پدر ما خدا وعیسی مسیح خداوند بر شما باد."
        },
        {
          "verse": 3,
          "usfm": "2TH.1.3",
          "line_type": "p",
          "text": "ای برادران میباید همیشه بجهت شما خدارا شکر کنیم، چنانکه سزاوار است، از آنجا که ایمان شما بغایت نمو میکند و محبت هر یکی ازشما جمیع با همدیگر میافزاید،"
        },
        {
          "verse": 4,
          "usfm": "2TH.1.4",
          "line_type": "p",
          "text": "بحدی که خود ما در خصوص شما در کلیساهای خدا فخرمی کنیم بهسبب صبر و ایمانتان در همه مصایب شما و عذابهایی که متحمل آنها میشوید،"
        },
        {
          "verse": 5,
          "usfm": "2TH.1.5",
          "line_type": "p",
          "text": "که دلیل است بر داوری عادل خدا تا شما مستحق ملکوت خدا بشوید که برای آن هم زحمت میکشید."
        },
        {
          "verse": 6,
          "usfm": "2TH.1.6",
          "line_type": "p",
          "text": "زیرا که این انصاف است نزد خدا که عذاب کنندگان شما را عذاب دهد."
        },
        {
          "verse": 7,
          "usfm": "2TH.1.7",
          "line_type": "p",
          "text": "و شما را که عذاب میکشید، با ما راحت بخشد در هنگامی که عیسی خداوند از آسمان با فرشتگان قوت خودظهور خواهد نمود"
        },
        {
          "verse": 8,
          "usfm": "2TH.1.8",
          "line_type": "p",
          "text": "در آتش مشتعل و انتقام خواهد کشید از آنانی که خدا را نمی شناسند وانجیل خداوند ما عیسی مسیح را اطاعت نمی کنند،"
        },
        {
          "verse": 9,
          "usfm": "2TH.1.9",
          "line_type": "p",
          "text": "که ایشان به قصاص هلاکت جاودانی خواهند رسید از حضور خداوند و جلال قوت او"
        },
        {
          "verse": 10,
          "usfm": "2TH.1.10",
          "line_type": "p",
          "text": "هنگامی که آید تا در مقدسان خود جلال یابدو در همه ایمانداران از او تعجب کنند در آن روز، زیرا که شما شهادت ما را تصدیق کردید."
        },
        {
          "verse": 11,
          "usfm": "2TH.1.11",
          "line_type": "p",
          "text": "و برای این هم پیوسته بجهت شما دعامی کنیم که خدای ما شما را مستحق این دعوت شمارد و تمام مسرت نیکویی و عمل ایمان را باقوت کامل گرداند،"
        },
        {
          "verse": 12,
          "usfm": "2TH.1.12",
          "line_type": "p",
          "text": "تا نام خداوند ما عیسی مسیح در شما تمجید یابد و شما در وی بحسب فیض خدای ما و عیسی مسیح خداوند."
        }
      ],
      "verse_count": 12,
