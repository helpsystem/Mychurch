    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 4,
      "chapter_usfm": "JAS.4",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.4.1",
          "line_type": "p",
          "text": "از کجا در میان شما جنگها و از کجا نزاعهاپدید میآید؟ آیا نه از لذت های شما که دراعضای شما جنگ میکند؟"
        },
        {
          "verse": 2,
          "usfm": "JAS.4.2",
          "line_type": "p",
          "text": "طمع میورزید وندارید؛ میکشید و حسد مینمایید و نمی توانیدبه چنگ آرید؛ و جنگ و جدال میکنید و نداریداز این جهت که سوال نمی کنید."
        },
        {
          "verse": 3,
          "usfm": "JAS.4.3",
          "line_type": "p",
          "text": "و سوال میکنیدو نمی یابید، از اینرو که به نیت بد سوال میکنید تادر لذات خود صرف نمایید."
        },
        {
          "verse": 4,
          "usfm": "JAS.4.4",
          "line_type": "p",
          "text": "ای زانیات، آیا نمی دانید که دوستی دنیا، دشمنی خداست؟ پس هرکه میخواهد دوست دنیا باشد، دشمن خدا گردد."
        },
        {
          "verse": 5,
          "usfm": "JAS.4.5",
          "line_type": "p",
          "text": "آیا گمان دارید که کتاب عبث میگوید روحی که او را در ما ساکن کرده است، تا به غیرت بر ما اشتیاق دارد؟"
        },
        {
          "verse": 6,
          "usfm": "JAS.4.6",
          "line_type": "p",
          "text": "لیکن او فیض زیاده میبخشد. بنابراین میگوید: «خدامتکبران را مخالفت میکند، اما فروتنان را فیض میبخشد.»"
        },
        {
          "verse": 7,
          "usfm": "JAS.4.7",
          "line_type": "p",
          "text": "پس خدا را اطاعت نمایید و با ابلیس مقاومت کنید تا از شما بگریزد."
        },
        {
          "verse": 8,
          "usfm": "JAS.4.8",
          "line_type": "p",
          "text": "و به خدا تقرب جویید تا به شما نزدیکی نماید. دستهای خود راطاهر سازید، ای گناهکاران و دلهای خود را پاک کنید، ای دودلان."
        },
        {
          "verse": 9,
          "usfm": "JAS.4.9",
          "line_type": "p",
          "text": "خود را خوار سازید و ناله وگریه نمایید و خنده شما به ماتم و خوشی شما به غم مبدل شود."
        },
        {
          "verse": 10,
          "usfm": "JAS.4.10",
          "line_type": "p",
          "text": "در حضور خدا فروتنی کنید تاشما را سرافراز فرماید."
        },
        {
          "verse": 11,
          "usfm": "JAS.4.11",
          "line_type": "p",
          "text": "ای برادران، یکدیگررا ناسزا مگویید زیرا هرکه برادر خود را ناسزاگوید و بر او حکم کند، شریعت را ناسزا گفته و برشریعت حکم کرده باشد. لکن اگر بر شریعت حکم کنی، عامل شریعت نیستی بلکه داورهستی."
        },
        {
          "verse": 12,
          "usfm": "JAS.4.12",
          "line_type": "p",
          "text": "صاحب شریعت و داور، یکی است که بر رهانیدن و هلاک کردن قادر میباشد. پس تو کیستی که بر همسایه خود داوری میکنی؟"
        },
        {
          "verse": 13,
          "usfm": "JAS.4.13",
          "line_type": "p",
          "text": "هان، ای کسانی که میگویید: «امروز و فردابه فلان شهر خواهیم رفت و در آنجا یک سال بسرخواهیم برد و تجارت خواهیم کرد و نفع خواهیم برد»،"
        },
        {
          "verse": 14,
          "usfm": "JAS.4.14",
          "line_type": "p",
          "text": "و حال آنکه نمی دانید که فردا چه میشود؛ از آنرو که حیات شما چیست؟ مگربخاری نیستید که اندک زمانی ظاهر است و بعدناپدید میشود؟"
        },
        {
          "verse": 15,
          "usfm": "JAS.4.15",
          "line_type": "p",
          "text": "به عوض آنکه باید گفت که «اگر خدا بخواهد، زنده میمانیم و چنین و چنان میکنیم.»"
        },
        {
          "verse": 16,
          "usfm": "JAS.4.16",
          "line_type": "p",
          "text": "اما الحال به عجب خود فخرمی کنید و هر چنین فخر بد است."
        },
        {
          "verse": 17,
          "usfm": "JAS.4.17",
          "line_type": "p",
          "text": "پس هرکه نیکوییکردن بداند و بعمل نیاورد، او را گناه است."
        }
      ],
      "verse_count": 17,
