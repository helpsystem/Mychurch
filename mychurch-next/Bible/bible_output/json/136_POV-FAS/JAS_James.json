    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 3,
      "chapter_usfm": "JAS.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.3.1",
          "line_type": "p",
          "text": "ای برادران من، بسیار معلم نشوید چونکه می دانید که بر ما داوری سختتر خواهدشد."
        },
        {
          "verse": 2,
          "usfm": "JAS.3.2",
          "line_type": "p",
          "text": "زیرا همگی ما بسیار میلغزیم. و اگر کسی در سخنگفتن نلغزد، او مرد کامل است و میتواندعنان تمام جسد خود را بکشد."
        },
        {
          "verse": 3,
          "usfm": "JAS.3.3",
          "line_type": "p",
          "text": "و اینک لگام رابر دهان اسبان میزنیم تا مطیع ما شوند و تمام بدن آنها را برمی گردانیم."
        },
        {
          "verse": 4,
          "usfm": "JAS.3.4",
          "line_type": "p",
          "text": "اینک کشتیها نیز چقدربزرگ است و از بادهای سخت رانده میشود، لکن با سکان کوچک به هر طرفی که اراده ناخدا باشد، برگردانیده میشود."
        },
        {
          "verse": 5,
          "usfm": "JAS.3.5",
          "line_type": "p",
          "text": "همچنان زبان نیز عضوی کوچک است و سخنان کبرآمیز میگوید. اینک آتش کمی چه جنگل عظیمی را میسوزاند."
        },
        {
          "verse": 6,
          "usfm": "JAS.3.6",
          "line_type": "p",
          "text": "وزبان آتشی است! آن عالم ناراستی در میان اعضای ما زبان است که تمام بدن را میآلاید ودایره کائنات را میسوزاند و از جهنم سوخته میشود!"
        },
        {
          "verse": 7,
          "usfm": "JAS.3.7",
          "line_type": "p",
          "text": "زیرا که هر طبیعتی از وحوش و طیور وحشرات و حیوانات بحری از طبیعت انسان رام میشود و رام شده است."
        },
        {
          "verse": 8,
          "usfm": "JAS.3.8",
          "line_type": "p",
          "text": "لکن زبان را کسی ازمردمان نمی تواند رام کند. شرارتی سرکش و پر اززهر قاتل است!"
        },
        {
          "verse": 9,
          "usfm": "JAS.3.9",
          "line_type": "p",
          "text": "خدا و پدر را به آن متبارک میخوانیم و به همان مردمان را که به صورت خداآفریده شدهاند، لعن میگوییم."
        },
        {
          "verse": 10,
          "usfm": "JAS.3.10",
          "line_type": "p",
          "text": "از یک دهان برکت و لعنت بیرون میآید! ای برادران، شایسته نیست که چنین شود."
        },
        {
          "verse": 11,
          "usfm": "JAS.3.11",
          "line_type": "p",
          "text": "آیا چشمه از یک شکاف آب شیرین و شور جاری میسازد؟"
        },
        {
          "verse": 12,
          "usfm": "JAS.3.12",
          "line_type": "p",
          "text": "یا میشودای برادران من که درخت انجیر، زیتون یا درخت مو، انجیر بار آورد؟ و چشمه شور نمی تواند آب شیرین را موجود سازد."
        },
        {
          "verse": 13,
          "usfm": "JAS.3.13",
          "line_type": "p",
          "text": "کیست در میان شما که حکیم و عالم باشد؟ پس اعمال خود را از سیرت نیکو به تواضع حکمت ظاهر بسازد."
        },
        {
          "verse": 14,
          "usfm": "JAS.3.14",
          "line_type": "p",
          "text": "لکن اگر در دل خودحسد تلخ و تعصب دارید، فخر مکنید و به ضدحق دروغ مگویید."
        },
        {
          "verse": 15,
          "usfm": "JAS.3.15",
          "line_type": "p",
          "text": "این حکمت از بالا نازل نمی شود، بلکه دنیوی و نفسانی و شیطانی است."
        },
        {
          "verse": 16,
          "usfm": "JAS.3.16",
          "line_type": "p",
          "text": "زیرا هرجایی که حسد و تعصب است، درآنجا فتنه و هر امر زشت موجود میباشد."
        },
        {
          "verse": 17,
          "usfm": "JAS.3.17",
          "line_type": "p",
          "text": "لکن آن حکمت که از بالا است، اول طاهر است و بعدصلحآمیز و ملایم و نصیحتپذیر و پر از رحمت و میوه های نیکو و بیتردد و بیریا."
        },
        {
          "verse": 18,
          "usfm": "JAS.3.18",
          "line_type": "p",
          "text": "و میوه عدالت در سلامتی کاشته میشود برای آنانی که سلامتی را بعمل میآورند."
        }
      ],
