    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 2,
      "chapter_usfm": "JAS.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.2.1",
          "line_type": "p",
          "text": "ای برادران من، ایمان خداوند ما عیسی مسیح، رب الجلال را با ظاهربینی مدارید."
        },
        {
          "verse": 2,
          "usfm": "JAS.2.2",
          "line_type": "p",
          "text": "زیرا اگر به کنیسه شما شخصی با انگشتری زرین و لباس نفیس داخل شود و فقیری نیز باپوشاک ناپاک درآید،"
        },
        {
          "verse": 3,
          "usfm": "JAS.2.3",
          "line_type": "p",
          "text": "و به صاحب لباس فاخرمتوجه شده، گویید: «اینجا نیکو بنشین» و به فقیرگویید: «تو در آنجا بایست یا زیر پای انداز من بنشین»،"
        },
        {
          "verse": 4,
          "usfm": "JAS.2.4",
          "line_type": "p",
          "text": "آیا در خود متردد نیستید و داوران خیالات فاسد نشدهاید؟"
        },
        {
          "verse": 5,
          "usfm": "JAS.2.5",
          "line_type": "p",
          "text": "ای برادران عزیز، گوش دهید. آیا خدا فقیران این جهان را برنگزیده است تا دولتمند در ایمان و وارث آن ملکوتی که به محبان خود وعده فرموده است بشوند؟"
        },
        {
          "verse": 6,
          "usfm": "JAS.2.6",
          "line_type": "p",
          "text": "لکن شما فقیر را حقیر شمردهاید. آیا دولتمندان برشما ستم نمی کنند و شما را در محکمه هانمی کشند؟"
        },
        {
          "verse": 7,
          "usfm": "JAS.2.7",
          "line_type": "p",
          "text": "آیا ایشان به آن نام نیکو که بر شما نهاده شده است کفر نمی گویند؟"
        },
        {
          "verse": 8,
          "usfm": "JAS.2.8",
          "line_type": "p",
          "text": "اما اگر آن شریعت ملوکانه را برحسب کتاب بهجا آورید یعنی «همسایه خود را مثل نفس خود محبت نما» نیکو میکنید."
        },
        {
          "verse": 9,
          "usfm": "JAS.2.9",
          "line_type": "p",
          "text": "لکن اگرظاهربینی کنید، گناه میکنید و شریعت شما را به خطاکاری ملزم میسازد."
        },
        {
          "verse": 10,
          "usfm": "JAS.2.10",
          "line_type": "p",
          "text": "زیرا هرکه تمام شریعت را نگاه دارد و در یک جزو بلغزد، ملزم همه میباشد."
        },
        {
          "verse": 11,
          "usfm": "JAS.2.11",
          "line_type": "p",
          "text": "زیرا او که گفت: «زنا مکن»، نیزگفت: «قتل مکن». پس هرچند زنا نکنی، اگر قتل کردی، از شریعت تجاوز نمودی."
        },
        {
          "verse": 12,
          "usfm": "JAS.2.12",
          "line_type": "p",
          "text": "همچنین سخن گویید و عمل نمایید مانند کسانی که برایشان داوری به شریعت آزادی خواهد شد."
        },
        {
          "verse": 13,
          "usfm": "JAS.2.13",
          "line_type": "p",
          "text": "زیرا آن داوری بیرحم خواهد بود برکسیکه رحم نکرده است و رحم بر داوری مفتخرمی شود."
        },
        {
          "verse": 14,
          "usfm": "JAS.2.14",
          "line_type": "p",
          "text": "ای برادران من، چه سود دارد اگر کسی گوید: «ایمان دارم» وقتی که عمل ندارد؟ آیاایمان میتواند او را نجاتبخشد؟"
        },
        {
          "verse": 15,
          "usfm": "JAS.2.15",
          "line_type": "p",
          "text": "پس اگربرادری یا خواهری برهنه و محتاج خوراک روزینه باشد،"
        },
        {
          "verse": 16,
          "usfm": "JAS.2.16",
          "line_type": "p",
          "text": "و کسی از شما بدیشان گوید: «به سلامتی بروید و گرم و سیر شوید»، لیکن مایحتاج بدن را بدیشان ندهد، چه نفع دارد؟"
        },
        {
          "verse": 17,
          "usfm": "JAS.2.17",
          "line_type": "p",
          "text": "همچنین ایمان نیز اگر اعمال ندارد، در خودمرده است."
        },
        {
          "verse": 18,
          "usfm": "JAS.2.18",
          "line_type": "p",
          "text": "بلکه کسی خواهد گفت: «تو ایمان داری و من اعمال دارم. ایمان خود را بدون اعمال به من بنما و من ایمان خود را از اعمال خود به توخواهم نمود.»"
        },
        {
          "verse": 19,
          "usfm": "JAS.2.19",
          "line_type": "p",
          "text": "تو ایمان داری که خدا واحداست؟ نیکو میکنی! شیاطین نیز ایمان دارند و می لرزند!"
        },
        {
          "verse": 20,
          "usfm": "JAS.2.20",
          "line_type": "p",
          "text": "و لیکنای مرد باطل، آیا میخواهی دانست که ایمان بدون اعمال، باطل است؟"
        },
        {
          "verse": 21,
          "usfm": "JAS.2.21",
          "line_type": "p",
          "text": "آیا پدر ما ابراهیم به اعمال، عادل شمرده نشد وقتی که پسر خود اسحاق را به قربانگاه گذرانید؟"
        },
        {
          "verse": 22,
          "usfm": "JAS.2.22",
          "line_type": "p",
          "text": "میبینی که ایمان با اعمال او عمل کرد و ایمان از اعمال، کامل گردید."
        },
        {
          "verse": 23,
          "usfm": "JAS.2.23",
          "line_type": "p",
          "text": "و آن نوشته تمام گشت که میگوید: «ابراهیم به خداایمان آورد و برای او به عدالت محسوب گردید»، و دوست خدا نامیده شد."
        },
        {
          "verse": 24,
          "usfm": "JAS.2.24",
          "line_type": "p",
          "text": "پس میبینید که انسان از اعمال عادل شمرده میشود، نه از ایمان تنها."
        },
        {
          "verse": 25,
          "usfm": "JAS.2.25",
          "line_type": "p",
          "text": "و همچنین آیا راحاب فاحشه نیز ازاعمال عادل شمرده نشد وقتی که قاصدان راپذیرفته، به راهی دیگر روانه نمود؟"
        },
        {
          "verse": 26,
          "usfm": "JAS.2.26",
          "line_type": "p",
          "text": "زیراچنانکه بدن بدون روح مرده است، همچنین ایمان بدون اعمال نیز مرده است."
        }
      ],
