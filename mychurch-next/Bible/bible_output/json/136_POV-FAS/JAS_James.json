  "total_verses": 107,
  "chapters": [
    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 1,
      "chapter_usfm": "JAS.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.1.1",
          "line_type": "p",
          "text": "یعقوب که غلام خدا و عیسی مسیح خداوند است، به دوازده سبط که پراکنده هستند.خوش باشید."
        },
        {
          "verse": 2,
          "usfm": "JAS.1.2",
          "line_type": "p",
          "text": "ای برادران من، وقتی که در تجربه های گوناگون مبتلا شوید، کمال خوشی دانید."
        },
        {
          "verse": 3,
          "usfm": "JAS.1.3",
          "line_type": "p",
          "text": "چونکه میدانید که امتحان ایمان شما صبر راپیدا میکند."
        },
        {
          "verse": 4,
          "usfm": "JAS.1.4",
          "line_type": "p",
          "text": "لکن صبر را عمل تام خود باشد تاکامل و تمام شوید و محتاج هیچچیز نباشید."
        },
        {
          "verse": 5,
          "usfm": "JAS.1.5",
          "line_type": "p",
          "text": "واگر از شما کسی محتاج به حکمت باشد، سوال بکند از خدایی که هر کس را به سخاوت عطامی کند و ملامت نمی نماید و به او داده خواهدشد."
        },
        {
          "verse": 6,
          "usfm": "JAS.1.6",
          "line_type": "p",
          "text": "لکن به ایمان سوال بکند و هرگز شک نکندزیرا هرکه شک کند، مانند موج دریاست که از بادرانده و متلاطم میشود."
        },
        {
          "verse": 7,
          "usfm": "JAS.1.7",
          "line_type": "p",
          "text": "زیرا چنین شخص گمان نبرد که از خداوند چیزی خواهد یافت."
        },
        {
          "verse": 8,
          "usfm": "JAS.1.8",
          "line_type": "p",
          "text": "مرد دودل در تمام رفتار خود ناپایدار است."
        },
        {
          "verse": 9,
          "usfm": "JAS.1.9",
          "line_type": "p",
          "text": "لکن برادر مسکین بهسرافرازی خود فخربنماید،"
        },
        {
          "verse": 10,
          "usfm": "JAS.1.10",
          "line_type": "p",
          "text": "و دولتمند از مسکنت خود، زیرا مثل گل علف در گذر است."
        },
        {
          "verse": 11,
          "usfm": "JAS.1.11",
          "line_type": "p",
          "text": "از آنرو که آفتاب باگرمی طلوع کرده، علف را خشکانید و گلش به زیر افتاده، حسن صورتش زایل شد. به همینطورشخص دولتمند نیز در راههای خود، پژمرده خواهد گردید."
        },
        {
          "verse": 12,
          "usfm": "JAS.1.12",
          "line_type": "p",
          "text": "خوشابحال کسیکه متحمل تجربه شود، زیرا که چون آزموده شد، آن تاج حیاتی را که خداوند به محبان خود وعده فرموده است خواهد یافت."
        },
        {
          "verse": 13,
          "usfm": "JAS.1.13",
          "line_type": "p",
          "text": "هیچکس چون در تجربه افتد، نگوید: «خدا مرا تجربه میکند»، زیرا خدا هرگزاز بدیها تجربه نمی شود و او هیچکس را تجربه نمی کند."
        },
        {
          "verse": 14,
          "usfm": "JAS.1.14",
          "line_type": "p",
          "text": "لکن هرکس در تجربه میافتد وقتی که شهوت وی او را میکشد و فریفته میسازد."
        },
        {
          "verse": 15,
          "usfm": "JAS.1.15",
          "line_type": "p",
          "text": "پس شهوت آبستن شده، گناه را میزاید و گناه به انجام رسیده، موت را تولید میکند."
        },
        {
          "verse": 16,
          "usfm": "JAS.1.16",
          "line_type": "p",
          "text": "ای برادران عزیز من، گمراه مشوید!"
        },
        {
          "verse": 17,
          "usfm": "JAS.1.17",
          "line_type": "p",
          "text": "هر بخشندگی نیکو و هر بخشش کامل از بالا است و نازل میشود از پدر نورها که نزد او هیچ تبدیل و سایه گردش نیست."
        },
        {
          "verse": 18,
          "usfm": "JAS.1.18",
          "line_type": "p",
          "text": "او محض اراده خود ما رابوسیله کلمه حق تولید نمود تا ما چون نوبرمخلوقات او باشیم."
        },
        {
          "verse": 19,
          "usfm": "JAS.1.19",
          "line_type": "p",
          "text": "بنابراین، ای برادران عزیز من، هرکس درشنیدن تند و در گفتن آهسته و در خشم سست باشد."
        },
        {
          "verse": 20,
          "usfm": "JAS.1.20",
          "line_type": "p",
          "text": "زیرا خشم انسان عدالت خدا را به عمل نمی آورد."
        },
        {
          "verse": 21,
          "usfm": "JAS.1.21",
          "line_type": "p",
          "text": "پس هر نجاست و افزونی شر را دورکنید و با فروتنی، کلام کاشته شده را بپذیرید که قادر است که جانهای شما را نجاتبخشد."
        },
        {
          "verse": 22,
          "usfm": "JAS.1.22",
          "line_type": "p",
          "text": "لکن کنندگان کلام باشید نه فقط شنوندگان که خود را فریب میدهند."
        },
        {
          "verse": 23,
          "usfm": "JAS.1.23",
          "line_type": "p",
          "text": "زیرا اگر کسی کلام را بشنود و عمل نکند، شخصی را ماند که صورت طبیعی خود را در آینه مینگرد."
        },
        {
          "verse": 24,
          "usfm": "JAS.1.24",
          "line_type": "p",
          "text": "زیرا خود رانگریست و رفت و فور فراموش کرد که چطورشخصی بود."
        },
        {
          "verse": 25,
          "usfm": "JAS.1.25",
          "line_type": "p",
          "text": "لکن کسیکه بر شریعت کامل آزادی چشم دوخت و در آن ثابت ماند، او چون شنونده فراموشکار نمی باشد، بلکه کننده عمل پس او در عمل خود مبارک خواهد بود."
        },
        {
          "verse": 26,
          "usfm": "JAS.1.26",
          "line_type": "p",
          "text": "اگرکسی از شما گمان برد که پرستنده خدا است وعنان زبان خود را نکشد بلکه دل خود را فریب دهد، پرستش او باطل است."
        },
        {
          "verse": 27,
          "usfm": "JAS.1.27",
          "line_type": "p",
          "text": "پرستش صاف وبی عیب نزد خدا و پدر این است که یتیمان وبیوهزنان را در مصیبت ایشان تفقد کنند و خود رااز آلایش دنیا نگاه دارند."
        }
      ],
