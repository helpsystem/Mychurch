    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 5,
      "chapter_usfm": "JAS.5",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.5.1",
          "line_type": "p",
          "text": "هانای دولتمندان، بجهت مصیبتهایی که بر شما وارد میآید، گریه و ولوله نمایید."
        },
        {
          "verse": 2,
          "usfm": "JAS.5.2",
          "line_type": "p",
          "text": "دولت شما فاسد و رخت شما بیدخورده میشود."
        },
        {
          "verse": 3,
          "usfm": "JAS.5.3",
          "line_type": "p",
          "text": "طلا و نقره شما را زنگ میخورد وزنگ آنها بر شما شهادت خواهد داد و مثل آتش، گوشت شما را خواهد خورد. شما در زمان آخرخزانه اندوختهاید."
        },
        {
          "verse": 4,
          "usfm": "JAS.5.4",
          "line_type": "p",
          "text": "اینک مزد عمله هایی که کشته های شما را درویدهاند و شما آن را به فریب نگاه داشتهاید، فریاد برمی آورد و ناله های دروگران، به گوشهای رب الجنود رسیده است."
        },
        {
          "verse": 5,
          "usfm": "JAS.5.5",
          "line_type": "p",
          "text": "بر روی زمین به ناز و کامرانی مشغول بوده، دلهای خود را در یوم قتل پروردید."
        },
        {
          "verse": 6,
          "usfm": "JAS.5.6",
          "line_type": "p",
          "text": "بر مردعادل فتوی دادید و او را به قتل رسانیدید و با شمامقاومت نمی کند."
        },
        {
          "verse": 7,
          "usfm": "JAS.5.7",
          "line_type": "p",
          "text": "پسای برادران، تا هنگام آمدن خداوند صبرکنید. اینک دهقان انتظار میکشد برای محصول گرانبهای زمین و برایش صبر میکند تا باران اولین و آخرین را بیابد."
        },
        {
          "verse": 8,
          "usfm": "JAS.5.8",
          "line_type": "p",
          "text": "شما نیز صبر نمایید و دلهای خود را قوی سازید زیرا که آمدن خداوند نزدیک است."
        },
        {
          "verse": 9,
          "usfm": "JAS.5.9",
          "line_type": "p",
          "text": "ای برادران، از یکدیگر شکایت مکنید، مبادا بر شما حکم شود. اینک داور بر در ایستاده است."
        },
        {
          "verse": 10,
          "usfm": "JAS.5.10",
          "line_type": "p",
          "text": "ای برادران، نمونه زحمت و صبر رابگیرید از انبیایی که به نام خداوند تکلم نمودند."
        },
        {
          "verse": 11,
          "usfm": "JAS.5.11",
          "line_type": "p",
          "text": "اینک صابران را خوشحال میگوییم و صبرایوب را شنیدهاید و انجام کار خداوند رادانستهاید، زیرا که خداوند بغایت مهربان و کریم است."
        },
        {
          "verse": 12,
          "usfm": "JAS.5.12",
          "line_type": "p",
          "text": "لکن اول همهای برادران من، قسم مخورید نه به آسمان و نه به زمین و نه به هیچ سوگند دیگر، بلکه بلی شما بلی باشد و نی شما نی، مبادا درتحکم بیفتید."
        },
        {
          "verse": 13,
          "usfm": "JAS.5.13",
          "line_type": "p",
          "text": "اگر کسی از شما مبتلای بلایی باشد، دعابنماید و اگر کسی خوشحال باشد، سرود بخواند."
        },
        {
          "verse": 14,
          "usfm": "JAS.5.14",
          "line_type": "p",
          "text": "و هرگاه کسی از شما بیمار باشد، کشیشان کلیسا را طلب کند تا برایش دعا نمایند و او را به نام خداوند به روغن تدهین کنند."
        },
        {
          "verse": 15,
          "usfm": "JAS.5.15",
          "line_type": "p",
          "text": "و دعای ایمان، مریض شما را شفا خواهد بخشید وخداوند او را خواهد برخیزانید، و اگر گناه کرده باشد، از او آمرزیده خواهد شد."
        },
        {
          "verse": 16,
          "usfm": "JAS.5.16",
          "line_type": "p",
          "text": "نزد یکدیگربه گناهان خود اعتراف کنید و برای یکدیگر دعاکنید تا شفا یابید، زیرا دعای مرد عادل در عمل، قوت بسیار دارد."
        },
        {
          "verse": 17,
          "usfm": "JAS.5.17",
          "line_type": "p",
          "text": "الیاس مردی بود صاحب حواس مثل ما و به تمامی دل دعا کرد که باران نبارد و تا مدت سه سال و شش ماه نبارید."
        },
        {
          "verse": 18,
          "usfm": "JAS.5.18",
          "line_type": "p",
          "text": "و بازدعا کرد و آسمان بارید و زمین ثمر خود رارویانید."
        },
        {
          "verse": 19,
          "usfm": "JAS.5.19",
          "line_type": "p",
          "text": "ای برادران من، اگر کسی از شما از راستی منحرف شود و شخصی او را بازگرداند،"
        }
