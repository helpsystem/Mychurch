    {
      "schema_version": 6,
      "book_id": "2JN",
      "chapter": 1,
      "chapter_usfm": "2JN.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2JN.1.1",
          "line_type": "p",
          "text": "من که پیرم، به خاتون برگزیده و فرزندانش که ایشان را درراستی محبت مینمایم و نه من فقط بلکه همه کسانی که راستی را میدانند،"
        },
        {
          "verse": 2,
          "usfm": "2JN.1.2",
          "line_type": "p",
          "text": "بخاطر آن راستی که در ما ساکن است و با ما تا به ابد خواهدبود."
        },
        {
          "verse": 3,
          "usfm": "2JN.1.3",
          "line_type": "p",
          "text": "فیض و رحمت و سلامتی از جانب خدای پدر و عیسی مسیح خداوند و پسر پدر در راستی و محبت با ما خواهد بود."
        },
        {
          "verse": 4,
          "usfm": "2JN.1.4",
          "line_type": "p",
          "text": "بسیار مسرور شدم چونکه بعضی از فرزندان تو را یافتم که در راستی رفتار میکنند، چنانکه ازپدر حکم یافتیم."
        },
        {
          "verse": 5,
          "usfm": "2JN.1.5",
          "line_type": "p",
          "text": "و الانای خاتون از تو التماس دارم نه آنکه حکمی تازه به تو بنویسم، بلکه همان را که از ابتداء داشتیم که یکدیگر را محبت بنماییم."
        },
        {
          "verse": 6,
          "usfm": "2JN.1.6",
          "line_type": "p",
          "text": "و این است محبت که موافق احکام اوسلوک بنماییم و حکم همان است که از اول شنیدید تا در آن سلوک نماییم."
        },
        {
          "verse": 7,
          "usfm": "2JN.1.7",
          "line_type": "p",
          "text": "زیرا گمراه کنندگان بسیار بهدنیا بیرون شدندکه عیسی مسیح ظاهر شده در جسم را اقرارنمی کنند. آن است گمراهکننده و دجال."
        },
        {
          "verse": 8,
          "usfm": "2JN.1.8",
          "line_type": "p",
          "text": "خود رانگاه بدارید مبادا آنچه را که عمل کردیم برباددهید بلکه تا اجرت کامل بیابید."
        },
        {
          "verse": 9,
          "usfm": "2JN.1.9",
          "line_type": "p",
          "text": "هرکه پیشوایی میکند و در تعلیم مسیح ثابت نیست، خدا رانیافته است. اما آنکه در تعلیم مسیح ثابت ماند، اوهم پدر و پسر را دارد."
        },
        {
          "verse": 10,
          "usfm": "2JN.1.10",
          "line_type": "p",
          "text": "اگر کسی به نزد شما آیدو این تعلیم را نیاورد، او را به خانه خود مپذیرید واو را تحیت مگویید."
        },
        {
          "verse": 11,
          "usfm": "2JN.1.11",
          "line_type": "p",
          "text": "زیرا هرکه او را تحیت گوید، در کارهای قبیحش شریک گردد."
        },
        {
          "verse": 12,
          "usfm": "2JN.1.12",
          "line_type": "p",
          "text": "چیزهای بسیار دارم که به شما بنویسم، لکن نخواستم که به کاغذ و مرکب بنویسم، بلکه امیدوارم که به نزد شما بیایم و زبانی گفتگو نمایم تا خوشی ما کامل شود."
        }
      ],
