  "chapters": [
    {
      "schema_version": 6,
      "book_id": "GAL",
      "chapter": 1,
      "chapter_usfm": "GAL.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "GAL.1.1",
          "line_type": "p",
          "text": "پولس، رسول نه از جانب انسان و نه بوسیله انسان بلکه به عیسی مسیح و خدای پدر که او را از مردگان برخیزانید،"
        },
        {
          "verse": 2,
          "usfm": "GAL.1.2",
          "line_type": "p",
          "text": "و همه برادرانی که بامن میباشند، به کلیساهای غلاطیه،"
        },
        {
          "verse": 3,
          "usfm": "GAL.1.3",
          "line_type": "p",
          "text": "فیض و سلامتی از جانب خدای پدر وخداوند ما عیسی مسیح با شما باد؛"
        },
        {
          "verse": 4,
          "usfm": "GAL.1.4",
          "line_type": "p",
          "text": "که خود رابرای گناهان ما داد تا ما را از این عالم حاضر شریربحسب اراده خدا و پدر ما خلاصی بخشد،"
        },
        {
          "verse": 5,
          "usfm": "GAL.1.5",
          "line_type": "p",
          "text": "که او را تا ابدالاباد جلال باد. آمین."
        },
        {
          "verse": 6,
          "usfm": "GAL.1.6",
          "line_type": "p",
          "text": "تعجب میکنم که بدین زودی از آن کس که شما را به فیض مسیح خوانده است، برمی گردیدبه سوی انجیلی دیگر،"
        },
        {
          "verse": 7,
          "usfm": "GAL.1.7",
          "line_type": "p",
          "text": "که (انجیل ) دیگر نیست. لکن بعضی هستند که شما را مضطرب میسازندو میخواهند انجیل مسیح را تبدیل نمایند."
        },
        {
          "verse": 8,
          "usfm": "GAL.1.8",
          "line_type": "p",
          "text": "بلکه هرگاه ما هم یا فرشتهای از آسمان، انجیلی غیر از آنکه ما به آن بشارت دادیم به شما رساند، اناتیما باد."
        },
        {
          "verse": 9,
          "usfm": "GAL.1.9",
          "line_type": "p",
          "text": "چنانکه پیش گفتیم، الان هم بازمی گویم: اگر کسی انجیلی غیر از آنکه پذیرفتیدبیاورد، اناتیما باد."
        },
        {
          "verse": 10,
          "usfm": "GAL.1.10",
          "line_type": "p",
          "text": "آیا الحال مردم را در رای خود میآورم؟ یا خدا را یا رضامندی مردم را می طلبم؟ اگر تابحال رضامندی مردم رامی خواستم، غلام مسیح نمی بودم."
        },
        {
          "verse": 11,
          "usfm": "GAL.1.11",
          "line_type": "p",
          "text": "اماای برادران شما را اعلام میکنم ازانجیلی که من بدان بشارت دادم که به طریق انسان نیست."
        },
        {
          "verse": 12,
          "usfm": "GAL.1.12",
          "line_type": "p",
          "text": "زیرا که من آن را از انسان نیافتم ونیاموختم، مگر به کشف عیسی مسیح."
        },
        {
          "verse": 13,
          "usfm": "GAL.1.13",
          "line_type": "p",
          "text": "زیراسرگذشت سابق مرا در دین یهود شنیدهاید که برکلیسای خدا بینهایت جفا مینمودم و آن راویران میساختم،"
        },
        {
          "verse": 14,
          "usfm": "GAL.1.14",
          "line_type": "p",
          "text": "و در دین یهود از اکثرهمسالان قوم خود سبقت میجستم و در تقالیداجداد خود بغایت غیور میبودم."
        },
        {
          "verse": 15,
          "usfm": "GAL.1.15",
          "line_type": "p",
          "text": "اما چون خداکه مرا از شکم مادرم برگزید و به فیض خود مراخواند، رضا بدین داد"
        },
        {
          "verse": 16,
          "usfm": "GAL.1.16",
          "line_type": "p",
          "text": "که پسر خود را در من آشکار سازد تا در میان امتها بدو بشارت دهم، در آنوقت با جسم و خون مشورت نکردم،"
        },
        {
          "verse": 17,
          "usfm": "GAL.1.17",
          "line_type": "p",
          "text": "و به اورشلیم هم نزد آنانی که قبل از من رسول بودندنرفتم، بلکه به عرب شدم و باز به دمشق مراجعت کردم."
        },
        {
          "verse": 18,
          "usfm": "GAL.1.18",
          "line_type": "p",
          "text": "پس بعد از سه سال، برای ملاقات پطرس به اورشلیم رفتم و پانزده روز با وی بسر بردم."
        },
        {
          "verse": 19,
          "usfm": "GAL.1.19",
          "line_type": "p",
          "text": "اما از سایر رسولان جز یعقوب برادر خداوندرا ندیدم."
        },
        {
          "verse": 20,
          "usfm": "GAL.1.20",
          "line_type": "p",
          "text": "اما درباره آنچه به شما مینویسم، اینک در حضور خدا دروغ نمی گویم."
        },
        {
          "verse": 21,
          "usfm": "GAL.1.21",
          "line_type": "p",
          "text": "بعد از آن به نواحی سوریه و قیلیقیه آمدم."
        },
        {
          "verse": 22,
          "usfm": "GAL.1.22",
          "line_type": "p",
          "text": "و به کلیساهای یهودیه که در مسیح بودند صورت غیرمعروف بودم،"
        },
        {
          "verse": 23,
          "usfm": "GAL.1.23",
          "line_type": "p",
          "text": "جز اینکه شنیده بودند که «آنکه پیشتر بر ما جفا مینمود، الحال بشارت میدهد به همان ایمانی که قبل از این ویران میساخت.»"
        },
        {
          "verse": 24,
          "usfm": "GAL.1.24",
          "line_type": "p",
          "text": "و خدا را در من تمجید نمودند."
        }
      ],
