    },
    {
      "schema_version": 6,
      "book_id": "GAL",
      "chapter": 2,
      "chapter_usfm": "GAL.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "GAL.2.1",
          "line_type": "p",
          "text": "پس بعد از چهارده سال با برنابا باز به اورشلیم رفتم و تیطس را همراه خود بردم."
        },
        {
          "verse": 2,
          "usfm": "GAL.2.2",
          "line_type": "p",
          "text": "ولی به الهام رفتم و انجیلی را که در میان امت هابدان موعظه میکنم، به ایشان عرضه داشتم، امادر خلوت به معتبرین، مبادا عبث بدوم یا دویده باشم."
        },
        {
          "verse": 3,
          "usfm": "GAL.2.3",
          "line_type": "p",
          "text": "لیکن تیطس نیز که همراه من و یونانی بود، مجبور نشد که مختون شود."
        },
        {
          "verse": 4,
          "usfm": "GAL.2.4",
          "line_type": "p",
          "text": "و این بهسبب برادران کذبه بود که ایشان را خفیه درآوردند وخفیه درآمدند تا آزادی ما را که در مسیح عیسی داریم، جاسوسی کنند و تا ما را به بندگی درآوردند."
        },
        {
          "verse": 5,
          "usfm": "GAL.2.5",
          "line_type": "p",
          "text": "که ایشان را یک ساعت هم به اطاعت در این امر تابع نشدیم تا راستی انجیل در شماثابت ماند."
        },
        {
          "verse": 6,
          "usfm": "GAL.2.6",
          "line_type": "p",
          "text": "اما از آنانی که معتبراند که چیزی میباشند -هرچه بودند مرا تفاوتی نیست، خدا بر صورت انسان نگاه نمی کند - زیرا آنانی که معتبراند، به من هیچ نفع نرسانیدند."
        },
        {
          "verse": 7,
          "usfm": "GAL.2.7",
          "line_type": "p",
          "text": "بلکه به خلاف آن، چون دیدند که بشارت نامختونان به من سپرده شد، چنانکه بشارت مختونان به پطرس،"
        },
        {
          "verse": 8,
          "usfm": "GAL.2.8",
          "line_type": "p",
          "text": "زیرا او که برای رسالت مختونان در پطرس عمل کرد، در من هم برای امتها عمل کرد."
        },
        {
          "verse": 9,
          "usfm": "GAL.2.9",
          "line_type": "p",
          "text": "پس چون یعقوب وکیفا و یوحنا که معتبر به ارکان بودند، آن فیضی را که به من عطا شده بود دیدند، دست رفاقت به من وبرنابا دادند تا ما به سوی امتها برویم، چنانکه ایشان به سوی مختونان؛"
        },
        {
          "verse": 10,
          "usfm": "GAL.2.10",
          "line_type": "p",
          "text": "جز آنکه فقرا را یادبداریم و خود نیز غیور به کردن این کار بودم."
        },
        {
          "verse": 11,
          "usfm": "GAL.2.11",
          "line_type": "p",
          "text": "اما چون پطرس به انطاکیه آمد، او را روبرومخالفت نمودم زیرا که مستوجب ملامت بود،"
        },
        {
          "verse": 12,
          "usfm": "GAL.2.12",
          "line_type": "p",
          "text": "چونکه قبل از آمدن بعضی از جانب یعقوب، باامتها غذا میخورد؛ ولی چون آمدند، از آنانی که اهل ختنه بودند ترسیده، باز ایستاد و خویشتن را جدا ساخت."
        },
        {
          "verse": 13,
          "usfm": "GAL.2.13",
          "line_type": "p",
          "text": "و سایر یهودیان هم با وی نفاق کردند، بحدی که برنابا نیز در نفاق ایشان گرفتارشد."
        },
        {
          "verse": 14,
          "usfm": "GAL.2.14",
          "line_type": "p",
          "text": "ولی چون دیدم که به راستی انجیل به استقامت رفتار نمی کنند، پیش روی همه پطرس را گفتم: «اگر تو که یهود هستی، به طریق امتها ونه به طریق یهود زیست میکنی، چون است که امتها را مجبور میسازی که به طریق یهود رفتارکنند؟»"
        },
        {
          "verse": 15,
          "usfm": "GAL.2.15",
          "line_type": "p",
          "text": "ما که طبع یهود هستیم و نه گناهکاران از امتها،"
        },
        {
          "verse": 16,
          "usfm": "GAL.2.16",
          "line_type": "p",
          "text": "اما چونکه یافتیم که هیچکس ازاعمال شریعت عادل شمرده نمی شود، بلکه به ایمان به عیسی مسیح، ما هم به مسیح عیسی ایمان آوردیم تا از ایمان به مسیح و نه از اعمال شریعت عادل شمرده شویم، زیرا که از اعمال شریعت هیچ بشری عادل شمرده نخواهد شد."
        },
        {
          "verse": 17,
          "usfm": "GAL.2.17",
          "line_type": "p",
          "text": "اما اگر چون عدالت در مسیح را میطلبم، خود هم گناهکار یافت شویم، آیا مسیح خادم گناه است؟ حاشا!"
        },
        {
          "verse": 18,
          "usfm": "GAL.2.18",
          "line_type": "p",
          "text": "زیرا اگر باز بنا کنم آنچه راکه خراب ساختم، هرآینه ثابت میکنم که خود متعدی هستم."
        },
        {
          "verse": 19,
          "usfm": "GAL.2.19",
          "line_type": "p",
          "text": "زانرو که من بواسطه شریعت نسبت به شریعت مردم تا نسبت به خدا زیست کنم."
        },
        {
          "verse": 20,
          "usfm": "GAL.2.20",
          "line_type": "p",
          "text": "با مسیح مصلوب شدهام ولی زندگی میکنم لیکن نه من بعد از این، بلکه مسیح در من زندگی میکند. و زندگانی که الحال در جسم میکنم، به ایمان بر پسر خدا میکنم که مرا محبت نمود و خود را برای من داد."
        },
        {
          "verse": 21,
          "usfm": "GAL.2.21",
          "line_type": "p",
          "text": "فیض خدا را باطل نمی سازم، زیرا اگر عدالت به شریعت میبود، هرآینه مسیح عبث مرد."
        }
      ],
