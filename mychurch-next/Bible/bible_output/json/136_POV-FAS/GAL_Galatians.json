    {
      "schema_version": 6,
      "book_id": "GAL",
      "chapter": 5,
      "chapter_usfm": "GAL.5",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "GAL.5.1",
          "line_type": "p",
          "text": "پس به آن آزادی که مسیح ما را به آن آزادکرد استوار باشید و باز در یوغ بندگی گرفتار مشوید."
        },
        {
          "verse": 2,
          "usfm": "GAL.5.2",
          "line_type": "p",
          "text": "اینک من پولس به شما میگویم که اگر مختون شوید، مسیح برای شما هیچ نفع ندارد."
        },
        {
          "verse": 3,
          "usfm": "GAL.5.3",
          "line_type": "p",
          "text": "بلی باز به هرکس که مختون شود شهادت میدهم که مدیون است که تمامی شریعت را بهجا آورد."
        },
        {
          "verse": 4,
          "usfm": "GAL.5.4",
          "line_type": "p",
          "text": "همه شما که از شریعت عادل میشوید، از مسیح باطل و از فیض ساقطگشتهاید."
        },
        {
          "verse": 5,
          "usfm": "GAL.5.5",
          "line_type": "p",
          "text": "زیرا که ما بواسطه روح از ایمان مترقب امید عدالت هستیم."
        },
        {
          "verse": 6,
          "usfm": "GAL.5.6",
          "line_type": "p",
          "text": "و در مسیح عیسی نه ختنه فایده دارد و نه نامختونی بلکه ایمانی که به محبت عمل میکند."
        },
        {
          "verse": 7,
          "usfm": "GAL.5.7",
          "line_type": "p",
          "text": "خوب میدویدید. پس کیست که شما را ازاطاعت راستی منحرف ساخته است؟"
        },
        {
          "verse": 8,
          "usfm": "GAL.5.8",
          "line_type": "p",
          "text": "این ترغیب از او که شما را خوانده است نیست."
        },
        {
          "verse": 9,
          "usfm": "GAL.5.9",
          "line_type": "p",
          "text": "خمیرمایه اندک تمام خمیر را مخمر میسازد."
        },
        {
          "verse": 10,
          "usfm": "GAL.5.10",
          "line_type": "p",
          "text": "من در خداوند بر شما اعتماد دارم که هیچ رای دیگر نخواهید داشت، لیکن آنکه شما رامضطرب سازد هرکه باشد قصاص خود راخواهد یافت."
        },
        {
          "verse": 11,
          "usfm": "GAL.5.11",
          "line_type": "p",
          "text": "اماای برادران اگر من تا به حال به ختنه موعظه میکردم، چرا جفا میدیدم؟ زیراکه در این صورت لغزش صلیب برداشته میشد."
        },
        {
          "verse": 12,
          "usfm": "GAL.5.12",
          "line_type": "p",
          "text": "کاش آنانی که شما را مضطرب میسازند خویشتن را منقطع میساختند."
        },
        {
          "verse": 13,
          "usfm": "GAL.5.13",
          "line_type": "p",
          "text": "زیرا که شماای برادران به آزادی خوانده شدهاید؛ اما زنهار آزادی خود را فرصت جسم مگردانید، بلکه به محبت، یکدیگر را خدمت کنید."
        },
        {
          "verse": 14,
          "usfm": "GAL.5.14",
          "line_type": "p",
          "text": "زیرا که تمامی شریعت در یک کلمه کامل میشود یعنی در اینکه همسایه خود راچون خویشتن محبت نما."
        },
        {
          "verse": 15,
          "usfm": "GAL.5.15",
          "line_type": "p",
          "text": "اما اگر همدیگر رابگزید و بخورید، باحذر باشید که مبادا ازیکدیگر هلاک شوید."
        },
        {
          "verse": 16,
          "usfm": "GAL.5.16",
          "line_type": "p",
          "text": "اما میگویم به روح رفتار کنید پس شهوات جسم را بهجا نخواهید آورد."
        },
        {
          "verse": 17,
          "usfm": "GAL.5.17",
          "line_type": "p",
          "text": "زیرا خواهش جسم به خلاف روح است و خواهش روح به خلاف جسم و این دو با یکدیگر منازعه میکنندبطوری که آنچه میخواهید نمی کنید."
        },
        {
          "verse": 18,
          "usfm": "GAL.5.18",
          "line_type": "p",
          "text": "اما اگراز روح هدایت شدید، زیر شریعت نیستید."
        },
        {
          "verse": 19,
          "usfm": "GAL.5.19",
          "line_type": "p",
          "text": "و اعمال جسم آشکار است، یعنی زنا وفسق و ناپاکی و فجور،"
        },
        {
          "verse": 20,
          "usfm": "GAL.5.20",
          "line_type": "p",
          "text": "و بتپرستی وجادوگری و دشمنی و نزاع و کینه و خشم وتعصب و شقاق و بدعتها،"
        },
        {
          "verse": 21,
          "usfm": "GAL.5.21",
          "line_type": "p",
          "text": "و حسد و قتل ومستی و لهو و لعب و امثال اینها که شما را خبرمی دهم چنانکه قبل از این دادم، که کنندگان چنین کارها وارث ملکوت خدا نمی شوند."
        },
        {
          "verse": 22,
          "usfm": "GAL.5.22",
          "line_type": "p",
          "text": "لیکن ثمره روح، محبت و خوشی وسلامتی و حلم و مهربانی و نیکویی و ایمان وتواضع و پرهیزکاری است،"
        },
        {
          "verse": 23,
          "usfm": "GAL.5.23",
          "line_type": "p",
          "text": "که هیچ شریعت مانع چنین کارها نیست."
        },
        {
          "verse": 24,
          "usfm": "GAL.5.24",
          "line_type": "p",
          "text": "و آنانی که از آن مسیح میباشند، جسم را با هوسها و شهواتش مصلوب ساختهاند."
        },
        {
          "verse": 25,
          "usfm": "GAL.5.25",
          "line_type": "p",
          "text": "اگر به روح زیست کنیم، به روح هم رفتار بکنیم."
        },
        {
          "verse": 26,
          "usfm": "GAL.5.26",
          "line_type": "p",
          "text": "لافزن مشویم تا یکدیگر را به خشم آوریم و بر یکدیگر حسد بریم."
        }
      ],
