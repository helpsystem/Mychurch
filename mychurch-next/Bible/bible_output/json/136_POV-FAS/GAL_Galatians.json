    {
      "schema_version": 6,
      "book_id": "GAL",
      "chapter": 4,
      "chapter_usfm": "GAL.4",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "GAL.4.1",
          "line_type": "p",
          "text": "است، از غلام هیچ فرق ندارد، هرچندمالک همه باشد."
        },
        {
          "verse": 2,
          "usfm": "GAL.4.2",
          "line_type": "p",
          "text": "بلکه زیردست ناظران و وکلامی باشد تا روزی که پدرش تعیین کرده باشد."
        },
        {
          "verse": 3,
          "usfm": "GAL.4.3",
          "line_type": "p",
          "text": "همچنین ما نیز چون صغیر میبودیم، زیر اصول دنیوی غلام میبودیم."
        },
        {
          "verse": 4,
          "usfm": "GAL.4.4",
          "line_type": "p",
          "text": "لیکن چون زمان بهکمال رسید، خدا پسر خود را فرستاد که از زن زاییده شد و زیر شریعت متولد،"
        },
        {
          "verse": 5,
          "usfm": "GAL.4.5",
          "line_type": "p",
          "text": "تا آنانی را که زیرشریعت باشند فدیه کند تا آنکه پسرخواندگی رابیابیم."
        },
        {
          "verse": 6,
          "usfm": "GAL.4.6",
          "line_type": "p",
          "text": "اما چونکه پسر هستید، خدا روح پسرخود را در دلهای شما فرستاد که ندا میکند «یاابا» یعنی «ای پدر.»"
        },
        {
          "verse": 7,
          "usfm": "GAL.4.7",
          "line_type": "p",
          "text": "لهذا دیگر غلام نیستی بلکه پسر، و چون پسر هستی، وارث خدا نیز بوسیله مسیح."
        },
        {
          "verse": 8,
          "usfm": "GAL.4.8",
          "line_type": "p",
          "text": "لیکن در آن زمان چون خدا را نمی شناختید، آنانی را که طبیعت خدایان نبودند، بندگی میکردید."
        },
        {
          "verse": 9,
          "usfm": "GAL.4.9",
          "line_type": "p",
          "text": "اما الحال که خدا را میشناسید بلکه خدا شما را میشناسد، چگونه باز میگردید به سوی آن اصول ضعیف و فقیر که دیگرمی خواهید از سر نو آنها را بندگی کنید؟"
        },
        {
          "verse": 10,
          "usfm": "GAL.4.10",
          "line_type": "p",
          "text": "روزهاو ماهها و فصلها و سالها را نگاه میدارید."
        },
        {
          "verse": 11,
          "usfm": "GAL.4.11",
          "line_type": "p",
          "text": "درباره شما ترس دارم که مبادا برای شما عبث زحمت کشیده باشم."
        },
        {
          "verse": 12,
          "usfm": "GAL.4.12",
          "line_type": "p",
          "text": "ای برادران، از شما استدعا دارم که مثل من بشوید، چنانکه من هم مثل شما شدهام. به من هیچ ظلم نکردید."
        },
        {
          "verse": 13,
          "usfm": "GAL.4.13",
          "line_type": "p",
          "text": "اما آگاهید که بهسبب ضعف بدنی، اول به شما بشارت دادم."
        },
        {
          "verse": 14,
          "usfm": "GAL.4.14",
          "line_type": "p",
          "text": "و آن امتحان مرا که در جسم من بود، خوار نشمردید و مکروه نداشتید، بلکه مرا چون فرشته خدا و مثل مسیح عیسی پذیرفتید."
        },
        {
          "verse": 15,
          "usfm": "GAL.4.15",
          "line_type": "p",
          "text": "پس کجا است آن مبارک بادی شما؟ زیرا به شما شاهدم که اگرممکن بودی، چشمان خود را بیرون آورده، به من میدادید."
        },
        {
          "verse": 16,
          "usfm": "GAL.4.16",
          "line_type": "p",
          "text": "پس چون به شما راست میگویم، آیا دشمن شما شدهام؟"
        },
        {
          "verse": 17,
          "usfm": "GAL.4.17",
          "line_type": "p",
          "text": "شما را به غیرت میطلبند، لیکن نه به خیر، بلکه میخواهند در را بر روی شما ببندند تا شما ایشان را بغیرت بطلبید."
        },
        {
          "verse": 18,
          "usfm": "GAL.4.18",
          "line_type": "p",
          "text": "لیکن غیرت در امر نیکو در هر زمان نیکو است، نهتنها چون من نزد شما حاضر باشم."
        },
        {
          "verse": 19,
          "usfm": "GAL.4.19",
          "line_type": "p",
          "text": "ای فرزندان من که برای شما باز درد زه دارم تاصورت مسیح در شما بسته شود."
        },
        {
          "verse": 20,
          "usfm": "GAL.4.20",
          "line_type": "p",
          "text": "باری خواهش میکردم که الان نزد شما حاضر میبودم تا سخن خود را تبدیل کنم، زیرا که درباره شمامتحیر شدهام."
        },
        {
          "verse": 21,
          "usfm": "GAL.4.21",
          "line_type": "p",
          "text": "شما که میخواهید زیر شریعت باشید، مرابگویید آیا شریعت را نمی شنوید؟"
        },
        {
          "verse": 22,
          "usfm": "GAL.4.22",
          "line_type": "p",
          "text": "زیرامکتوب است ابراهیم را دو پسر بود، یکی از کنیزو دیگری از آزاد."
        },
        {
          "verse": 23,
          "usfm": "GAL.4.23",
          "line_type": "p",
          "text": "لیکن پسر کنیز، بحسب جسم تولد یافت و پسر آزاد، برحسب وعده."
        },
        {
          "verse": 24,
          "usfm": "GAL.4.24",
          "line_type": "p",
          "text": "واین امور بطور مثل گفته شد زیرا که این دو زن، دوعهد میباشند، یکی از کوه سینا برای بندگی میزاید و آن هاجر است."
        },
        {
          "verse": 25,
          "usfm": "GAL.4.25",
          "line_type": "p",
          "text": "زیرا که هاجر کوه سینا است در عرب، و مطابق است با اورشلیمی که موجود است، زیرا که با فرزندانش در بندگی میباشد."
        },
        {
          "verse": 26,
          "usfm": "GAL.4.26",
          "line_type": "p",
          "text": "لیکن اورشلیم بالا آزاد است که مادرجمیع ما میباشد."
        },
        {
          "verse": 27,
          "usfm": "GAL.4.27",
          "line_type": "p",
          "text": "زیرا مکتوب است: «ای نازاد که نزاییدهای، شاد باش! صدا کن و فریادبرآورای تو که درد زه ندیدهای، زیرا که فرزندان زن بیکس از اولاد شوهردار بیشتراند.»"
        },
        {
          "verse": 28,
          "usfm": "GAL.4.28",
          "line_type": "p",
          "text": "لیکن ماای برادران، چون اسحاق فرزندان وعده میباشیم."
        },
        {
          "verse": 29,
          "usfm": "GAL.4.29",
          "line_type": "p",
          "text": "بلکه چنانکه آنوقت آنکه برحسب جسم تولد یافت، بر وی که برحسب روح بود جفامی کرد، همچنین الان نیز هست."
        },
        {
          "verse": 30,
          "usfm": "GAL.4.30",
          "line_type": "p",
          "text": "لیکن کتاب چه میگوید؟ «کنیز و پسر او را بیرون کن زیرا پسرکنیز با پسر آزاد میراث نخواهد یافت.»"
        },
        {
          "verse": 31,
          "usfm": "GAL.4.31",
          "line_type": "p",
          "text": "خلاصهای برادران، فرزندان کنیز نیستیم بلکه از زن آزادیم."
        }
      ],
