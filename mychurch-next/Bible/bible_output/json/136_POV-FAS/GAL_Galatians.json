    {
      "schema_version": 6,
      "book_id": "GAL",
      "chapter": 3,
      "chapter_usfm": "GAL.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "GAL.3.1",
          "line_type": "p",
          "text": "ای غلاطیان بیفهم، کیست که شما راافسون کرد تا راستی را اطاعت نکنید که پیش چشمان شما عیسی مسیح مصلوب شده مبین گردید؟"
        },
        {
          "verse": 2,
          "usfm": "GAL.3.2",
          "line_type": "p",
          "text": "فقط این را میخواهم از شمابفهمم که روح را از اعمال شریعت یافتهاید یا ازخبر ایمان؟"
        },
        {
          "verse": 3,
          "usfm": "GAL.3.3",
          "line_type": "p",
          "text": "آیا اینقدر بیفهم هستید که به روح شروع کرده، الان به جسم کامل میشوید؟"
        },
        {
          "verse": 4,
          "usfm": "GAL.3.4",
          "line_type": "p",
          "text": "آیااینقدر زحمات را عبث کشیدید اگر فی الحقیقه عبث باشد؟"
        },
        {
          "verse": 5,
          "usfm": "GAL.3.5",
          "line_type": "p",
          "text": "پس آنکه روح را به شما عطامی کند و قوات در میان شما به ظهور میآورد، آیااز اعمال شریعت یا از خبر ایمان میکند؟"
        },
        {
          "verse": 6,
          "usfm": "GAL.3.6",
          "line_type": "p",
          "text": "چنانکه ابراهیم به خدا ایمان آورد و برای اوعدالت محسوب شد."
        },
        {
          "verse": 7,
          "usfm": "GAL.3.7",
          "line_type": "p",
          "text": "پس آگاهید که اهل ایمان فرزندان ابراهیم هستند."
        },
        {
          "verse": 8,
          "usfm": "GAL.3.8",
          "line_type": "p",
          "text": "و کتاب چون پیش دیدکه خدا امتها را از ایمان عادل خواهد شمرد به ابراهیم بشارت داد که «جمیع امتها از تو برکت خواهند یافت.»"
        },
        {
          "verse": 9,
          "usfm": "GAL.3.9",
          "line_type": "p",
          "text": "بنابراین اهل ایمان با ابراهیم ایمان دار برکت مییابند."
        },
        {
          "verse": 10,
          "usfm": "GAL.3.10",
          "line_type": "p",
          "text": "زیرا جمیع آنانی که از اعمال شریعت هستند، زیر لعنت میباشند زیرا مکتوب است: «ملعون است هرکه ثابت نماند در تمام نوشته های کتاب شریعت تا آنها را بهجا آرد.»"
        },
        {
          "verse": 11,
          "usfm": "GAL.3.11",
          "line_type": "p",
          "text": "اما واضح است که هیچکس در حضور خدا ازشریعت عادل شمرده نمی شود، زیرا که «عادل به ایمان زیست خواهد نمود.»"
        },
        {
          "verse": 12,
          "usfm": "GAL.3.12",
          "line_type": "p",
          "text": "اما شریعت ازایمان نیست بلکه «آنکه به آنها عمل میکند، درآنها زیست خواهد نمود.»"
        },
        {
          "verse": 13,
          "usfm": "GAL.3.13",
          "line_type": "p",
          "text": "مسیح، ما را ازلعنت شریعت فدا کرد چونکه در راه ما لعنت شد، چنانکه مکتوب است «ملعون است هرکه بر دارآویخته شود.»"
        },
        {
          "verse": 14,
          "usfm": "GAL.3.14",
          "line_type": "p",
          "text": "تا برکت ابراهیم در مسیح عیسی بر امتها آید و تا وعده روح را به وسیله ایمان حاصل کنیم."
        },
        {
          "verse": 15,
          "usfm": "GAL.3.15",
          "line_type": "p",
          "text": "ای برادران، به طریق انسان سخن میگویم، زیرا عهدی را که از انسان نیز استوار میشود، هیچکس باطل نمی سازد و نمی افزاید."
        },
        {
          "verse": 16,
          "usfm": "GAL.3.16",
          "line_type": "p",
          "text": "اماوعدهها به ابراهیم و به نسل او گفته شد ونمی گوید «به نسلها» که گویا درباره بسیاری باشد، بلکه درباره یکی و «به نسل تو» که مسیح است."
        },
        {
          "verse": 17,
          "usfm": "GAL.3.17",
          "line_type": "p",
          "text": "و مقصود این است عهدی را که از خدا به مسیح بسته شده بود، شریعتی که چهارصد و سی سال بعد از آن نازل شد، باطل نمی سازد بطوری که وعده نیست شود."
        },
        {
          "verse": 18,
          "usfm": "GAL.3.18",
          "line_type": "p",
          "text": "زیرا اگر میراث از شریعت بودی، دیگر از وعده نبودی. لیکن خدا آن را به ابراهیم از وعده داد."
        },
        {
          "verse": 19,
          "usfm": "GAL.3.19",
          "line_type": "p",
          "text": "پس شریعت چیست؟ برای تقصیرها بر آن افزوده شد تا هنگام آمدن آن نسلی که وعده بدوداده شد و بوسیله فرشتگان بهدست متوسطی مرتب گردید."
        },
        {
          "verse": 20,
          "usfm": "GAL.3.20",
          "line_type": "p",
          "text": "اما متوسط از یک نیست، اماخدا یک است."
        },
        {
          "verse": 21,
          "usfm": "GAL.3.21",
          "line_type": "p",
          "text": "پس آیا شریعت به خلاف وعده های خداست؟ حاشا! زیرا اگر شریعتی داده میشد که تواند حیاتبخشد، هرآینه عدالت از شریعت حاصل میشد."
        },
        {
          "verse": 22,
          "usfm": "GAL.3.22",
          "line_type": "p",
          "text": "بلکه کتاب همهچیز را زیر گناه بست تا وعدهای که از ایمان به عیسی مسیح است، ایمانداران را عطا شود."
        },
        {
          "verse": 23,
          "usfm": "GAL.3.23",
          "line_type": "p",
          "text": "اما قبل از آمدن ایمان، زیر شریعت نگاه داشته بودیم و برای آن ایمانی که میبایست مکشوف شود، بسته شده بودیم."
        },
        {
          "verse": 24,
          "usfm": "GAL.3.24",
          "line_type": "p",
          "text": "پس شریعت لالای ماشد تا به مسیح برساند تا از ایمان عادل شمرده شویم."
        },
        {
          "verse": 25,
          "usfm": "GAL.3.25",
          "line_type": "p",
          "text": "لیکن چون ایمان آمد، دیگر زیر دست لالا نیستیم."
        },
        {
          "verse": 26,
          "usfm": "GAL.3.26",
          "line_type": "p",
          "text": "زیرا همگی شما بوسیله ایمان در مسیح عیسی، پسران خدا میباشید."
        },
        {
          "verse": 27,
          "usfm": "GAL.3.27",
          "line_type": "p",
          "text": "زیرا همه شما که در مسیح تعمید یافتید، مسیح را در برگرفتید."
        },
        {
          "verse": 28,
          "usfm": "GAL.3.28",
          "line_type": "p",
          "text": "هیچ ممکن نیست که یهود باشد یا یونانی و نه غلام و نه آزاد و نه مرد و نه زن، زیرا که همه شمادر مسیح عیسی یک میباشید."
        },
        {
          "verse": 29,
          "usfm": "GAL.3.29",
          "line_type": "p",
          "text": "اما اگر شما ازآن مسیح میباشید، هرآینه نسل ابراهیم وبرحسب وعده، وارث هستید."
        }
      ],
