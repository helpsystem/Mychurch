    {
      "schema_version": 6,
      "book_id": "GAL",
      "chapter": 6,
      "chapter_usfm": "GAL.6",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "GAL.6.1",
          "line_type": "p",
          "text": "اماای برادران، اگر کسی به خطایی گرفتارشود، شما که روحانی هستید چنین شخص را به روح تواضع اصلاح کنید. و خود راملاحظه کن که مبادا تو نیز در تجربه افتی."
        },
        {
          "verse": 2,
          "usfm": "GAL.6.2",
          "line_type": "p",
          "text": "بارهای سنگین یکدیگر را متحمل شوید و بدین نوع شریعت مسیح را بهجا آرید."
        },
        {
          "verse": 3,
          "usfm": "GAL.6.3",
          "line_type": "p",
          "text": "زیرا اگر کسی خود را شخص گمان برد و حال آنکه چیزی نباشد، خود را میفریبد."
        },
        {
          "verse": 4,
          "usfm": "GAL.6.4",
          "line_type": "p",
          "text": "اما هرکس عمل خودرا امتحان بکند، آنگاه فخر در خود به تنهایی خواهد داشت نه در دیگری،"
        },
        {
          "verse": 5,
          "usfm": "GAL.6.5",
          "line_type": "p",
          "text": "زیرا هرکس حامل بار خود خواهد شد."
        },
        {
          "verse": 6,
          "usfm": "GAL.6.6",
          "line_type": "p",
          "text": "اما هرکه در کلام تعلیم یافته باشد، معلم خود را در همهچیزهای خوب مشارک بسازد."
        },
        {
          "verse": 7,
          "usfm": "GAL.6.7",
          "line_type": "p",
          "text": "خود را فریب مدهید، خدا رااستهزاء نمی توان کرد. زیرا که آنچه آدمی بکارد، همان را درو خواهد کرد."
        },
        {
          "verse": 8,
          "usfm": "GAL.6.8",
          "line_type": "p",
          "text": "زیرا هرکه برای جسم خود کارد، از جسم فساد را درو کند و هرکه برای روح کارد از روح حیات جاودانی خواهد دروید."
        },
        {
          "verse": 9,
          "usfm": "GAL.6.9",
          "line_type": "p",
          "text": "لیکن از نیکوکاری خسته نشویم زیرا که درموسم آن درو خواهیم کرد اگر ملول نشویم."
        },
        {
          "verse": 10,
          "usfm": "GAL.6.10",
          "line_type": "p",
          "text": "خلاصه بقدری که فرصت داریم با جمیع مردم احسان بنماییم، علی الخصوص با اهل بیت ایمان."
        },
        {
          "verse": 11,
          "usfm": "GAL.6.11",
          "line_type": "p",
          "text": "ملاحظه کنید چه حروف جلی بدست خود به شما نوشتم."
        },
        {
          "verse": 12,
          "usfm": "GAL.6.12",
          "line_type": "p",
          "text": "آنانی که میخواهند صورتی نیکو در جسم نمایان سازند، ایشان شمارا مجبور میسازند که مختون شوید، محض اینکه برای صلیب مسیح جفا نبینند."
        },
        {
          "verse": 13,
          "usfm": "GAL.6.13",
          "line_type": "p",
          "text": "زیراایشان نیز که مختون میشوند، خود شریعت رانگاه نمی دارند بلکه میخواهند شما مختون شوید تا در جسم شما فخر کنند."
        },
        {
          "verse": 14,
          "usfm": "GAL.6.14",
          "line_type": "p",
          "text": "لیکن حاشا ازمن که فخر کنم جز از صلیب خداوند ما عیسی مسیح که بوسیله او دنیا برای من مصلوب شد و من برای دنیا."
        },
        {
          "verse": 15,
          "usfm": "GAL.6.15",
          "line_type": "p",
          "text": "زیرا که در مسیح عیسی نه ختنه چیزی است و نه نامختونی بلکه خلقت تازه."
        },
        {
          "verse": 16,
          "usfm": "GAL.6.16",
          "line_type": "p",
          "text": "وآنانی که بدین قانون رفتار میکنند، سلامتی ورحمت بر ایشان باد و بر اسرائیل خدا."
        },
        {
          "verse": 17,
          "usfm": "GAL.6.17",
          "line_type": "p",
          "text": "بعد ازاین هیچکس مرا زحمت نرساند زیرا که من در بدن خود داغهای خداوند عیسی را دارم."
        }
      ],
