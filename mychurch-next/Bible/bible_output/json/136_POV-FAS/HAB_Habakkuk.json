    {
      "schema_version": 6,
      "book_id": "HAB",
      "chapter": 3,
      "chapter_usfm": "HAB.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAB.3.1",
          "line_type": "p",
          "text": "دعای حبقوق نبی بر شجونوت."
        },
        {
          "verse": 2,
          "usfm": "HAB.3.2",
          "line_type": "p",
          "text": "ای خداوند چون خبر تو را شنیدم ترسان گردیدم. ای خداوند عمل خویش را در میان سالها زنده کن! در میان سالها آن را معروف ساز ودر حین غضب رحمت را بیاد آور."
        },
        {
          "verse": 3,
          "usfm": "HAB.3.3",
          "line_type": "p",
          "text": "خدا از تیمان آمد و قدوس از جبل فاران، سلاه. جلال اوآسمانها را پوشانید و زمین از تسبیح او مملوگردید."
        },
        {
          "verse": 4,
          "usfm": "HAB.3.4",
          "line_type": "p",
          "text": "پرتو او مثل نور بود و از دست وی شعاع ساطع گردید. و ستر قوت او در آنجا بود."
        },
        {
          "verse": 5,
          "usfm": "HAB.3.5",
          "line_type": "p",
          "text": "پیش روی وی وبا میرفت و آتش تب نزد پایهای اومی بود."
        },
        {
          "verse": 6,
          "usfm": "HAB.3.6",
          "line_type": "p",
          "text": "او بایستاد و زمین را پیمود. او نظر افکندو امتها را پراکنده ساخت و کوههای ازلی جستند و تلهای ابدی خم شدند. طریق های اوجاودانی است."
        },
        {
          "verse": 7,
          "usfm": "HAB.3.7",
          "line_type": "p",
          "text": "خیمه های کوشان را در بلادیدم. و چادرهای زمین مدیان لرزان شد."
        },
        {
          "verse": 8,
          "usfm": "HAB.3.8",
          "line_type": "p",
          "text": "ای خداوند آیا بر نهرها غضب تو افروخته شد یا خشم تو بر نهرها و غیظ تو بر دریا واردآمد، که بر اسبان خود و ارابه های فتح مندی خویش سوار شدی؟"
        },
        {
          "verse": 9,
          "usfm": "HAB.3.9",
          "line_type": "p",
          "text": "کمان تو تمام برهنه شد، موافق قسمهایی که در کلام خود برای اسباط خوردهای، سلاه. زمین را به نهرها منشق ساختی."
        },
        {
          "verse": 10,
          "usfm": "HAB.3.10",
          "line_type": "p",
          "text": "کوهها تو را دیدند و لرزان گشتند و سیلاب هاجاری شد. لجه آواز خود را داد و دستهای خویش را به بالا برافراشت."
        },
        {
          "verse": 11,
          "usfm": "HAB.3.11",
          "line_type": "p",
          "text": "آفتاب و ماه در برجهای خود ایستادند. ازنور تیرهایت و از پرتو نیزه براق تو برفتند."
        },
        {
          "verse": 12,
          "usfm": "HAB.3.12",
          "line_type": "p",
          "text": "باغضب در جهان خرامیدی، و با خشم امتها راپایمال نمودی."
        },
        {
          "verse": 13,
          "usfm": "HAB.3.13",
          "line_type": "p",
          "text": "برای نجات قوم خویش وخلاصی مسیح خود بیرون آمدی. سر را ازخاندان شریران زدی و اساس آن را تا به گردن عریان نمودی، سلاه."
        },
        {
          "verse": 14,
          "usfm": "HAB.3.14",
          "line_type": "p",
          "text": "سر سرداران ایشان را به عصای خودشان مجروح ساختی، حینی که مثل گردباد آمدند تامرا پراکنده سازند. خوشی ایشان در این بود که مسکینان را در خفیه ببلعند."
        },
        {
          "verse": 15,
          "usfm": "HAB.3.15",
          "line_type": "p",
          "text": "با اسبان خود بردریا و بر انبوه آبهای بسیار خرامیدی."
        },
        {
          "verse": 16,
          "usfm": "HAB.3.16",
          "line_type": "p",
          "text": "چون شنیدم احشایم بلرزید و از آواز آن لبهایم بجنبید، و پوسیدگی به استخوانهایم داخل شده، در جای خود لرزیدم، که در روز تنگی استراحت یابم هنگامی که آن که قوم را ذلیل خواهدساخت، بر ایشان حمله آورد."
        },
        {
          "verse": 17,
          "usfm": "HAB.3.17",
          "line_type": "p",
          "text": "اگرچه انجیر شکوفه نیاورد و میوه در موهایافت نشود و حاصل زیتون ضایع گردد ومزرعهها آذوقه ندهد، و گلهها از آغل منقطع شودو رمهها در طویلهها نباشد،"
        },
        {
          "verse": 18,
          "usfm": "HAB.3.18",
          "line_type": "p",
          "text": "لیکن من درخداوند شادمان خواهم شد و در خدای نجات خویش وجد خواهم نمود."
        }
      ],
