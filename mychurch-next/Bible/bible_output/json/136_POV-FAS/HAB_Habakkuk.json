{
  "book_id": "HAB",
  "book_name_en": "Habakkuk",
  "book_name_fa": "حبقوق",
  "testament": "OT",
  "version_id": 136,
  "version_abbr": "POV",
  "version_name": "ترجمۀ قدیم",
  "language": "fa",
  "chapter_count": 3,
  "total_verses": 55,
  "chapters": [
    {
      "schema_version": 6,
      "book_id": "HAB",
      "chapter": 1,
      "chapter_usfm": "HAB.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAB.1.1",
          "line_type": "p",
          "text": "وحی که حبقوق نبی آن را دید."
        },
        {
          "verse": 2,
          "usfm": "HAB.1.2",
          "line_type": "p",
          "text": "ای خداوند تا به کی فریاد برمی آورم ونمی شنوی؟ تا به کی نزد تو از ظلم فریادبرمی آورم و نجات نمی دهی؟"
        },
        {
          "verse": 3,
          "usfm": "HAB.1.3",
          "line_type": "p",
          "text": "چرا بیانصافی رابه من نشان میدهی و بر ستم نظر مینمایی وغضب و ظلم پیش روی من میباشد؟ منازعه پدید میآید و مخاصمت سر خود را بلندمی کند."
        },
        {
          "verse": 4,
          "usfm": "HAB.1.4",
          "line_type": "p",
          "text": "از این سبب، شریعت سست شده است و عدالت هرگز صادر نمی شود. چونکه شریران عادلان را احاطه مینمایند. بنابراین عدالت معوج شده صادر میگردد."
        },
        {
          "verse": 5,
          "usfm": "HAB.1.5",
          "line_type": "p",
          "text": "در میان امتها نظر کنید و ملاحظه نمایید وبشدت متحیر شوید. زیرا که در ایام شما کاری میکنم که اگر شما را هم از آن مخبر سازند، باورنخواهید کرد."
        },
        {
          "verse": 6,
          "usfm": "HAB.1.6",
          "line_type": "p",
          "text": "زیرا که اینک آن امت تلخ وتندخو، یعنی کلدانیان را برمی انگیزانم که دروسعت جهان میخرامند تا مسکن هایی را که ازآن ایشان نیست به تصرف آورند."
        },
        {
          "verse": 7,
          "usfm": "HAB.1.7",
          "line_type": "p",
          "text": "ایشان هولناک و مهیب میباشند. حکم و جلال ایشان از خودایشان صادر میشود."
        },
        {
          "verse": 8,
          "usfm": "HAB.1.8",
          "line_type": "p",
          "text": "اسبان ایشان از پلنگهاچالاکتر و از گرگان شب تیزروترند و سواران ایشان جست و خیز میکنند. و سواران ایشان ازجای دور آمده، مثل عقابی که برای خوراک بشتابد میپرند."
        },
        {
          "verse": 9,
          "usfm": "HAB.1.9",
          "line_type": "p",
          "text": "جمیع ایشان برای ظلم میآیند. عزیمت روی ایشان بطرف پیش است و اسیران رامثل ریگ جمع میکنند."
        },
        {
          "verse": 10,
          "usfm": "HAB.1.10",
          "line_type": "p",
          "text": "و ایشان پادشاهان رااستهزا مینمایند و سروران مسخره ایشان میباشند. بر همه قلعهها میخندند و خاک راتوده نموده، آنها را مسخر میسازند."
        },
        {
          "verse": 11,
          "usfm": "HAB.1.11",
          "line_type": "p",
          "text": "پس مثل باد بشتاب رفته، عبور میکنند و مجرم میشوند. این قوت ایشان خدای ایشان است."
        },
        {
          "verse": 12,
          "usfm": "HAB.1.12",
          "line_type": "p",
          "text": "ای یهوه خدای من! ای قدوس من! آیا تو ازازل نیستی؟ پس نخواهیم مرد. ای خداوند ایشان را برای داوری معین کردهای وای صخره، ایشان را برای تادیب تاسیس نمودهای."
        },
        {
          "verse": 13,
          "usfm": "HAB.1.13",
          "line_type": "p",
          "text": "چشمان توپاکتر است از اینکه به بدی بنگری و به بیانصافی نظر نمی توانی کرد. پس چرا خیانتکاران راملاحظه مینمایی و حینی که شریر کسی را که ازخودش عادل تر است میبلعد، خاموش میمانی؟"
        },
        {
          "verse": 14,
          "usfm": "HAB.1.14",
          "line_type": "p",
          "text": "و مردمان را مثل ماهیان دریا و مانندحشراتی که حاکمی ندارند میگردانی؟"
        },
        {
          "verse": 15,
          "usfm": "HAB.1.15",
          "line_type": "p",
          "text": "اوهمگی ایشان را به قلاب برمی کشد و ایشان را به دام خود میگیرد و در تور خویش آنها را جمع مینماید. از اینجهت، مسرور و شادمان میشود."
        },
        {
          "verse": 16,
          "usfm": "HAB.1.16",
          "line_type": "p",
          "text": "بنابراین، برای دام خود قربانی میگذراند و برای تور خویش بخور میسوزاند. چونکه نصیب او از آنها فربه و خوراک وی لذیذ میشود."
        },
        {
          "verse": 17,
          "usfm": "HAB.1.17",
          "line_type": "p",
          "text": "آیااز اینجهت دام خود را خالی خواهد کرد و ازپیوسته کشتن امتها دریغ نخواهد نمود؟"
        }
      ],
      "verse_count": 17,
