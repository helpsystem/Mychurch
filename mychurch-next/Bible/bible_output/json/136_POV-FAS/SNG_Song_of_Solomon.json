    {
      "schema_version": 6,
      "book_id": "SNG",
      "chapter": 6,
      "chapter_usfm": "SNG.6",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "SNG.6.1",
          "line_type": "p",
          "text": "محبوب تو کجا رفته استای زیباترین زنان؟ محبوب تو کجا توجه نموده است تااو را با تو بطلبیم؟"
        },
        {
          "verse": 2,
          "usfm": "SNG.6.2",
          "line_type": "p",
          "text": "محبوب من به باغ خویش و نزد باغچه های بلسان فرود شده است، تا در باغات بچراند وسوسنها بچیند."
        },
        {
          "verse": 3,
          "usfm": "SNG.6.3",
          "line_type": "p",
          "text": "من از آن محبوب خود ومحبوبم از آن من است. در میان سوسنها گله رامی چراند."
        },
        {
          "verse": 4,
          "usfm": "SNG.6.4",
          "line_type": "p",
          "text": "ای محبوبه من، تو مثل ترصه جمیل و ماننداورشلیم زیبا و مثل لشکرهای بیدق دار مهیب هستی."
        },
        {
          "verse": 5,
          "usfm": "SNG.6.5",
          "line_type": "p",
          "text": "چشمانت را از من برگردان زیرا آنها برمن غالب شده است. مویهایت مثل گله بزها است که بر جانب کوه جلعاد خوابیده باشند."
        },
        {
          "verse": 6,
          "usfm": "SNG.6.6",
          "line_type": "p",
          "text": "دندانهایت مانند گله گوسفندان است که ازشستن برآمده باشند. و همگی آنها توام زاییده ودر آنها یکی هم نازاد نباشد."
        },
        {
          "verse": 7,
          "usfm": "SNG.6.7",
          "line_type": "p",
          "text": "شقیقه هایت درعقب برقع تو مانند پاره انار است."
        },
        {
          "verse": 8,
          "usfm": "SNG.6.8",
          "line_type": "p",
          "text": "شصت ملکه وهشتاد متعه و دوشیزگان بیشماره هستند."
        },
        {
          "verse": 9,
          "usfm": "SNG.6.9",
          "line_type": "p",
          "text": "اما کبوتر من و کامله من یکی است. او یگانه مادرخویش و مختاره والده خود میباشد. دختران اورا دیده، خجسته گفتند. ملکهها و متعهها بر اونگریستند و او را مدح نمودند."
        },
        {
          "verse": 10,
          "usfm": "SNG.6.10",
          "line_type": "p",
          "text": "این کیست که مثل صبح میدرخشد؟ ومانند ماه جمیل و مثل آفتاب طاهر و مانند لشکربیدق دار مهیب است؟"
        },
        {
          "verse": 11,
          "usfm": "SNG.6.11",
          "line_type": "p",
          "text": "به باغ درختان جوز فرود شدم تا سبزیهای وادی را بنگرم و ببینم که آیا مو شکوفه آورده وانار گل کرده است."
        },
        {
          "verse": 12,
          "usfm": "SNG.6.12",
          "line_type": "p",
          "text": "بیآنکه ملتفت شوم که ناگاه جانم مرا مثل عرابه های عمیناداب ساخت."
        },
        {
          "verse": 13,
          "usfm": "SNG.6.13",
          "line_type": "p",
          "text": "برگرد، برگردای شولمیت برگرد، برگرد تابر تو بنگریم."
        }
      ],
