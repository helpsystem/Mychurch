{
  "book_id": "SNG",
  "book_name_en": "Song of Solomon",
  "book_name_fa": "غزل غزلها",
  "testament": "OT",
  "version_id": 136,
  "version_abbr": "POV",
  "version_name": "ترجمۀ قدیم",
  "language": "fa",
  "chapter_count": 8,
  "total_verses": 116,
  "chapters": [
    {
      "schema_version": 6,
      "book_id": "SNG",
      "chapter": 1,
      "chapter_usfm": "SNG.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "SNG.1.1",
          "line_type": "p",
          "text": "غزل غزلها که از آن سلیمان است."
        },
        {
          "verse": 2,
          "usfm": "SNG.1.2",
          "line_type": "p",
          "text": "او مرا به بوسه های دهان خود ببوسد زیرا که محبت تو از شراب نیکوتر است."
        },
        {
          "verse": 3,
          "usfm": "SNG.1.3",
          "line_type": "p",
          "text": "عطرهای توبوی خوش دارد و اسم تو مثل عطر ریخته شده میباشد. بنابراین دوشیزگان، تو را دوست میدارند."
        },
        {
          "verse": 4,
          "usfm": "SNG.1.4",
          "line_type": "p",
          "text": "مرا بکش تا در عقب تو بدویم. پادشاه مرا به حجله های خود آورد. از تو وجد و شادی خواهیم کرد. محبت تو را از شراب زیاده ذکرخواهیم نمود. تو را از روی خلوص دوست میدارند."
        },
        {
          "verse": 5,
          "usfm": "SNG.1.5",
          "line_type": "p",
          "text": "ای دختران اورشلیم، من سیه فام اماجمیل هستم، مثل خیمه های قیدار و مانندپرده های سلیمان."
        },
        {
          "verse": 6,
          "usfm": "SNG.1.6",
          "line_type": "p",
          "text": "بر من نگاه نکنید چونکه سیه فام هستم، زیرا که آفتاب مرا سوخته است. پسران مادرم بر من خشم نموده، مرا ناطورتاکستانها ساختند، اما تاکستان خود را دیده بانی ننمودم."
        },
        {
          "verse": 7,
          "usfm": "SNG.1.7",
          "line_type": "p",
          "text": "ای حبیب جان من، مرا خبر ده که کجامی چرانی و در وقت ظهر گله را کجا میخوابانی؟ زیرا چرا نزد گله های رفیقانت مثل آواره گردم."
        },
        {
          "verse": 8,
          "usfm": "SNG.1.8",
          "line_type": "p",
          "text": "ای جمیل تر از زنان، اگر نمی دانی، در اثرگلهها بیرون رو و بزغاله هایت را نزد مسکن های شبانان بچران."
        },
        {
          "verse": 9,
          "usfm": "SNG.1.9",
          "line_type": "p",
          "text": "ای محبوبه من، تو را به اسبی که در ارابه فرعون باشد تشبیه دادهام."
        },
        {
          "verse": 10,
          "usfm": "SNG.1.10",
          "line_type": "p",
          "text": "رخسارهایت به جواهرها و گردنت به گردن بندها چه بسیار جمیل است."
        },
        {
          "verse": 11,
          "usfm": "SNG.1.11",
          "line_type": "p",
          "text": "زنجیرهای طلا با حبه های نقره برای توخواهیم ساخت."
        },
        {
          "verse": 12,
          "usfm": "SNG.1.12",
          "line_type": "p",
          "text": "چون پادشاه بر سفره خودمی نشیند، سنبل من بوی خود را میدهد."
        },
        {
          "verse": 13,
          "usfm": "SNG.1.13",
          "line_type": "p",
          "text": "محبوب من، مرا مثل طبله مر است که در میان پستانهای من میخوابد."
        },
        {
          "verse": 14,
          "usfm": "SNG.1.14",
          "line_type": "p",
          "text": "محبوب من، برایم مثل خوشه بان درباغهای عین جدی میباشد."
        },
        {
          "verse": 15,
          "usfm": "SNG.1.15",
          "line_type": "p",
          "text": "اینک تو زیباهستیای محبوبه من، اینک تو زیبا هستی وچشمانت مثل چشمان کبوتر است."
        },
        {
          "verse": 16,
          "usfm": "SNG.1.16",
          "line_type": "p",
          "text": "اینک تو زیبا و شیرین هستیای محبوب من و تخت ما هم سبز است."
        },
        {
          "verse": 17,
          "usfm": "SNG.1.17",
          "line_type": "p",
          "text": "تیرهای خانه ما از سرو آزاد است و سقف ما از چوب صنوبر."
        }
      ],
      "verse_count": 17,
