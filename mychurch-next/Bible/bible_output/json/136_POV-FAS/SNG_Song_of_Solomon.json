      "verses": [
        {
          "verse": 1,
          "usfm": "SNG.4.1",
          "line_type": "p",
          "text": "اینک تو زیبا هستیای محبوبه من، اینک تو زیبا هستی و چشمانت از پشت برقع تومثل چشمان کبوتر است و موهایت مثل گله بزهااست که بر جانب کوه جلعاد خوابیدهاند."
        },
        {
          "verse": 2,
          "usfm": "SNG.4.2",
          "line_type": "p",
          "text": "دندانهایت مثل گله گوسفندان پشم بریده که ازشستن برآمده باشند و همگی آنها توام زاییده ودر آنها یکی هم نازاد نباشد."
        },
        {
          "verse": 3,
          "usfm": "SNG.4.3",
          "line_type": "p",
          "text": "لبهایت مثل رشته قرمز و دهانت جمیل است و شقیقه هایت درعقب برقع تو مانند پاره انار است."
        },
        {
          "verse": 4,
          "usfm": "SNG.4.4",
          "line_type": "p",
          "text": "گردنت مثل برج داود است که به جهت سلاح خانه بنا شده است و در آن هزار سپر یعنی همه سپرهای شجاعان آویزان است."
        },
        {
          "verse": 5,
          "usfm": "SNG.4.5",
          "line_type": "p",
          "text": "دو پستانت مثل دو بچه توام آهو میباشد که در میان سوسنها میچرند،"
        },
        {
          "verse": 6,
          "usfm": "SNG.4.6",
          "line_type": "p",
          "text": "تا نسیم روز بوزد و سایهها بگریزد. به کوه مر وبه تل کندر خواهم رفت."
        },
        {
          "verse": 7,
          "usfm": "SNG.4.7",
          "line_type": "p",
          "text": "ای محبوبه من، تمامی تو زیبا میباشد. در توعیبی نیست."
        },
        {
          "verse": 8,
          "usfm": "SNG.4.8",
          "line_type": "p",
          "text": "بیا با من از لبنانای عروس، با من ازلبنان بیا. از قله امانه از قله شنیر و حرمون ازمغاره های شیرها و از کوههای پلنگها بنگر."
        },
        {
          "verse": 9,
          "usfm": "SNG.4.9",
          "line_type": "p",
          "text": "ای خواهر و عروس من دلم را به یکی از چشمانت وبه یکی از گردن بندهای گردنت ربودی."
        },
        {
          "verse": 10,
          "usfm": "SNG.4.10",
          "line_type": "p",
          "text": "ای خواهر و عروس من، محبتهایت چه بسیار لذیذ است. محبتهایت از شراب چه بسیار نیکوتر است و بوی عطرهایت از جمیع عطرها."
        },
        {
          "verse": 11,
          "usfm": "SNG.4.11",
          "line_type": "p",
          "text": "ای عروس من، لبهای تو عسل را میچکاند زیر زبان تو عسل و شیر است و بوی لباست مثل بوی لبنان است."
        },
        {
          "verse": 12,
          "usfm": "SNG.4.12",
          "line_type": "p",
          "text": "خواهر و عروس من، باغی بسته شده است. چشمه مقفل و منبع مختوم است."
        },
        {
          "verse": 13,
          "usfm": "SNG.4.13",
          "line_type": "p",
          "text": "نهالهایت بستان انارها با میوه های نفیسه و بان و سنبل است."
        },
        {
          "verse": 14,
          "usfm": "SNG.4.14",
          "line_type": "p",
          "text": "سنبل و زعفران و نی و دارچینی با انواع درختان کندر، مر و عود با جمیع عطرهای نفیسه."
        },
        {
          "verse": 15,
          "usfm": "SNG.4.15",
          "line_type": "p",
          "text": "چشمه باغها و برکه آب زنده و نهرهایی که ازلبنان جاری است."
        },
        {
          "verse": 16,
          "usfm": "SNG.4.16",
          "line_type": "p",
          "text": "ای باد شمال، برخیز وای باد جنوب، بیا. برباغ من بوز تا عطرهایش منتشر شود. محبوب من به باغ خود بیاید و میوه نفیسه خود را بخورد."
        }
      ],
