    {
      "schema_version": 6,
      "book_id": "SNG",
      "chapter": 2,
      "chapter_usfm": "SNG.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "SNG.2.1",
          "line_type": "p",
          "text": "من نرگس شارون و سوسن وادیها هستم."
        },
        {
          "verse": 2,
          "usfm": "SNG.2.2",
          "line_type": "p",
          "text": "چنانکه سوسن در میان خارها همچنان محبوبه من در میان دختران است."
        },
        {
          "verse": 3,
          "usfm": "SNG.2.3",
          "line_type": "p",
          "text": "چنانکه سیب در میان درختان جنگل همچنان محبوب من در میان پسران است. درسایه وی به شادمانی نشستم و میوهاش برای کامم شیرین بود."
        },
        {
          "verse": 4,
          "usfm": "SNG.2.4",
          "line_type": "p",
          "text": "مرا به میخانه آورد و علم وی بالای سر من محبت بود."
        },
        {
          "verse": 5,
          "usfm": "SNG.2.5",
          "line_type": "p",
          "text": "مرا به قرصهای کشمش تقویت دهید و مرا به سیبها تازه سازید، زیرا که من از عشق بیمار هستم."
        },
        {
          "verse": 6,
          "usfm": "SNG.2.6",
          "line_type": "p",
          "text": "دست چپش در زیر سر من است و دست راستش مرا در آغوش میکشد."
        },
        {
          "verse": 7,
          "usfm": "SNG.2.7",
          "line_type": "p",
          "text": "ای دختران اورشلیم، شما را به غزالها وآهوهای صحرا قسم میدهم که محبوب مرا تاخودش نخواهد بیدار نکنید و برنینگیزانید."
        },
        {
          "verse": 8,
          "usfm": "SNG.2.8",
          "line_type": "p",
          "text": "آواز محبوب من است، اینک بر کوهها جستان وبر تلها خیزان میآید."
        },
        {
          "verse": 9,
          "usfm": "SNG.2.9",
          "line_type": "p",
          "text": "محبوب من مانند غزال یابچه آهو است. اینک او در عقب دیوار ما ایستاده، از پنجرهها مینگرد و از شبکهها خویشتن رانمایان میسازد."
        },
        {
          "verse": 10,
          "usfm": "SNG.2.10",
          "line_type": "p",
          "text": "محبوب من مرا خطاب کرده، گفت: «ای محبوبه من وای زیبایی من برخیز و بیا."
        },
        {
          "verse": 11,
          "usfm": "SNG.2.11",
          "line_type": "p",
          "text": "زیرا اینک زمستان گذشته و باران تمام شده ورفته است."
        },
        {
          "verse": 12,
          "usfm": "SNG.2.12",
          "line_type": "p",
          "text": "گلها بر زمین ظاهر شده و زمان الحان رسیده و آواز فاخته در ولایت ما شنیده میشود."
        },
        {
          "verse": 13,
          "usfm": "SNG.2.13",
          "line_type": "p",
          "text": "درخت انجیر میوه خود را میرساندو موها گل آورده، رایحه خوش میدهد. ای محبوبه من وای زیبایی من، برخیز و بیا.»"
        },
        {
          "verse": 14,
          "usfm": "SNG.2.14",
          "line_type": "p",
          "text": "ای کبوتر من که در شکافهای صخره و درستر سنگهای خارا هستی، چهره خود را به من بنما و آوازت را به من بشنوان زیرا که آواز تو لذیذو چهره ات خوشنما است."
        },
        {
          "verse": 15,
          "usfm": "SNG.2.15",
          "line_type": "p",
          "text": "شغالها، شغالهای کوچک را که تاکستانها را خراب میکنند برای مابگیرید، زیرا که تاکستانهای ما گل آورده است."
        },
        {
          "verse": 16,
          "usfm": "SNG.2.16",
          "line_type": "p",
          "text": "محبوبم از آن من است و من از آن وی هستم. در میان سوسنها میچراند."
        },
        {
          "verse": 17,
          "usfm": "SNG.2.17",
          "line_type": "p",
          "text": "ای محبوب من، برگرد و تا نسیم روز بوزد و سایهها بگریزد، (مانند) غزال یا بچه آهو بر کوههای باتر باش."
        }
      ],
