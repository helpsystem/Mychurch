    {
      "schema_version": 6,
      "book_id": "SNG",
      "chapter": 7,
      "chapter_usfm": "SNG.7",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "SNG.7.1",
          "line_type": "p",
          "text": "در شولمیت چه میبینی؟ مثل محفل دولشکر."
        },
        {
          "verse": 2,
          "usfm": "SNG.7.2",
          "line_type": "p",
          "text": "ناف تو مثل کاسه مدور است که شراب ممزوج در آن کم نباشد. بر تو توده گندم است که سوسنها آن را احاطه کرده باشد."
        },
        {
          "verse": 3,
          "usfm": "SNG.7.3",
          "line_type": "p",
          "text": "دو پستان تومثل دو بچه توام غزال است."
        },
        {
          "verse": 4,
          "usfm": "SNG.7.4",
          "line_type": "p",
          "text": "گردن تو مثل برج عاج و چشمانت مثل برکه های حشبون نزددروازه بیت ربیم. بینی تو مثل برج لبنان است که بسوی دمشق مشرف میباشد."
        },
        {
          "verse": 5,
          "usfm": "SNG.7.5",
          "line_type": "p",
          "text": "سرت بر تو مثل کرمل و موی سرت مانند ارغوان است. و پادشاه در طره هایش اسیر میباشد."
        },
        {
          "verse": 6,
          "usfm": "SNG.7.6",
          "line_type": "p",
          "text": "ای محبوبه، چه بسیار زیبا و چه بسیار شیرین بهسبب لذتهاهستی."
        },
        {
          "verse": 7,
          "usfm": "SNG.7.7",
          "line_type": "p",
          "text": "این قامت تو مانند درخت خرما وپستانهایت مثل خوشه های انگور میباشد."
        },
        {
          "verse": 8,
          "usfm": "SNG.7.8",
          "line_type": "p",
          "text": "گفتم که به درخت خرما برآمده، شاخه هایش راخواهم گرفت. و پستانهایت مثل خوشه های انگور و بوی نفس تو مثل سیبها باشد."
        },
        {
          "verse": 9,
          "usfm": "SNG.7.9",
          "line_type": "p",
          "text": "و دهان تومانند شراب بهترین برای محبوبم که به ملایمت فرو رود و لبهای خفتگان را متکلم سازد."
        },
        {
          "verse": 10,
          "usfm": "SNG.7.10",
          "line_type": "p",
          "text": "من از آن محبوب خود هستم و اشتیاق وی بر من است."
        },
        {
          "verse": 11,
          "usfm": "SNG.7.11",
          "line_type": "p",
          "text": "بیاای محبوب من به صحرا بیرون برویم، و در دهات ساکن شویم."
        },
        {
          "verse": 12,
          "usfm": "SNG.7.12",
          "line_type": "p",
          "text": "و صبح زود به تاکستانها برویم و ببینیم که آیا انگور گل کرده وگلهایش گشوده و انارها گل داده باشد. در آنجامحبت خود را به تو خواهم داد."
        },
        {
          "verse": 13,
          "usfm": "SNG.7.13",
          "line_type": "p",
          "text": "مهر گیاههابوی خود را میدهد و نزد درهای ما هر قسم میوه نفیس تازه و کهنه هست که آنها را برای توای محبوب من جمع کردهام."
        }
      ],
