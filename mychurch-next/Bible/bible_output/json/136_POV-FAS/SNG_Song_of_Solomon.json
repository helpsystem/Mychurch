    {
      "schema_version": 6,
      "book_id": "SNG",
      "chapter": 3,
      "chapter_usfm": "SNG.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "SNG.3.1",
          "line_type": "p",
          "text": "شبانگاه در بستر خود او را که جانم دوست می دارد طلبیدم. او را جستجو کردم امانیافتم."
        },
        {
          "verse": 2,
          "usfm": "SNG.3.2",
          "line_type": "p",
          "text": "گفتم الان برخاسته، در کوچهها و شوارع شهر گشته، او را که جانم دوست میدارد خواهم طلبید. او را جستجو کردم اما نیافتم."
        },
        {
          "verse": 3,
          "usfm": "SNG.3.3",
          "line_type": "p",
          "text": "کشیکچیانی که در شهر گردش میکنند مرایافتند. گفتم که «آیا محبوب جان مرا دیدهاید؟»"
        },
        {
          "verse": 4,
          "usfm": "SNG.3.4",
          "line_type": "p",
          "text": "از ایشان چندان پیش نرفته بودم که او را که جانم دوست میدارد یافتم. و او را گرفته، رها نکردم تابه خانه مادر خود و به حجره والده خویش درآوردم."
        },
        {
          "verse": 5,
          "usfm": "SNG.3.5",
          "line_type": "p",
          "text": "ای دختران اورشلیم، شما را به غزالها وآهوهای صحرا قسم میدهم که محبوب مرا تاخودش نخواهد بیدار مکنید و برمینگیزانید."
        },
        {
          "verse": 6,
          "usfm": "SNG.3.6",
          "line_type": "p",
          "text": "این کیست که مثل ستونهای دود از بیابان برمی آید وبه مر و بخور و به همه عطریات تاجران معطراست؟"
        },
        {
          "verse": 7,
          "usfm": "SNG.3.7",
          "line_type": "p",
          "text": "اینک تخت روان سلیمان است که شصت جبار از جباران اسرائیل به اطراف آن میباشند."
        },
        {
          "verse": 8,
          "usfm": "SNG.3.8",
          "line_type": "p",
          "text": "همگی ایشان شمشیر گرفته و جنگ آزموده هستند. شمشیر هر یک بهسبب خوف شب بر رانش بسته است."
        },
        {
          "verse": 9,
          "usfm": "SNG.3.9",
          "line_type": "p",
          "text": "سلیمان پادشاه تخت روانی برای خویشتن از چوب لبنان ساخت."
        },
        {
          "verse": 10,
          "usfm": "SNG.3.10",
          "line_type": "p",
          "text": "ستونهایش را از نقره و سقفش را از طلا وکرسیاش را از ارغوان ساخت، و وسطش به محبت دختران اورشلیم معرق بود."
        },
        {
          "verse": 11,
          "usfm": "SNG.3.11",
          "line_type": "p",
          "text": "ای دختران صهیون، بیرون آیید و سلیمان پادشاه راببینید، با تاجی که مادرش در روز عروسی وی ودر روز شادی دلش آن را بر سر وی نهاد."
        }
      ],
