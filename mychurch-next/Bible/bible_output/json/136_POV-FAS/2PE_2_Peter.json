{
  "book_id": "2PE",
  "book_name_en": "2 Peter",
  "book_name_fa": "دوم پطرس",
  "testament": "NT",
  "version_id": 136,
  "version_abbr": "POV",
  "version_name": "ترجمۀ قدیم",
  "language": "fa",
  "chapter_count": 3,
  "total_verses": 60,
  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 1,
      "chapter_usfm": "2PE.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.1.1",
          "line_type": "p",
          "text": "شمعون پطرس، غلام و رسول عیسی مسیح، به آنانی که ایمان گرانبها را به مساوی مایافتهاند، در عدالت خدای ما و عیسی مسیح نجاتدهنده."
        },
        {
          "verse": 2,
          "usfm": "2PE.1.2",
          "line_type": "p",
          "text": "فیض و سلامتی در معرفت خدا و خداوند ماعیسی بر شما افزون باد."
        },
        {
          "verse": 3,
          "usfm": "2PE.1.3",
          "line_type": "p",
          "text": "چنانکه قوت الهیه او همهچیزهایی را که برای حیات و دینداری لازم است، به ما عنایت فرموده است، به معرفت او که ما را به جلال وفضیلت خود دعوت نموده،"
        },
        {
          "verse": 4,
          "usfm": "2PE.1.4",
          "line_type": "p",
          "text": "که بوساطت آنهاوعده های بینهایت عظیم و گرانبها به ما داده شد تاشما به اینها شریک طبیعت الهی گردید و ازفسادی که از شهوت در جهان است، خلاصی یابید."
        },
        {
          "verse": 5,
          "usfm": "2PE.1.5",
          "line_type": "p",
          "text": "و به همین جهت، کمال سعی نموده، درایمان خود فضیلت پیدا نمایید"
        },
        {
          "verse": 6,
          "usfm": "2PE.1.6",
          "line_type": "p",
          "text": "و در فضیلت، علم و در علم، عفت و در عفت، صبر و در صبر، دینداری"
        },
        {
          "verse": 7,
          "usfm": "2PE.1.7",
          "line_type": "p",
          "text": "و در دینداری، محبت برادران و درمحبت برادران، محبت را."
        },
        {
          "verse": 8,
          "usfm": "2PE.1.8",
          "line_type": "p",
          "text": "زیرا هرگاه اینها درشما یافت شود و بیفزاید، شما را نمی گذارد که درمعرفت خداوند ما عیسی مسیح کاهل یا بیثمربوده باشید."
        },
        {
          "verse": 9,
          "usfm": "2PE.1.9",
          "line_type": "p",
          "text": "زیرا هرکه اینها را ندارد، کور وکوتاه نظر است و تطیهر گناهان گذشته خود را فراموش کرده است."
        },
        {
          "verse": 10,
          "usfm": "2PE.1.10",
          "line_type": "p",
          "text": "لهذاای برادران بیشتر جد و جهد کنید تادعوت و برگزیدگی خود را ثابت نمایید زیرا اگرچنین کنید هرگز لغزش نخواهید خورد."
        },
        {
          "verse": 11,
          "usfm": "2PE.1.11",
          "line_type": "p",
          "text": "وهمچنین دخول در ملکوت جاودانی خداوند ونجاتدهنده ما عیسی مسیح به شما به دولتمندی داده خواهد شد."
        },
        {
          "verse": 12,
          "usfm": "2PE.1.12",
          "line_type": "p",
          "text": "لهذا از پیوسته یاد دادن شما از این امورغفلت نخواهم ورزید، هرچند آنها را میدانید ودر آن راستی که نزد شما است استوار هستید."
        },
        {
          "verse": 13,
          "usfm": "2PE.1.13",
          "line_type": "p",
          "text": "لکن این را صواب میدانم، مادامی که در این خیمه هستم، شما را به یاد آوری برانگیزانم."
        },
        {
          "verse": 14,
          "usfm": "2PE.1.14",
          "line_type": "p",
          "text": "چونکه میدانم که وقت بیرون کردن خیمه من نزدیک است، چنانکه خداوند ما عیسی مسیح نیزمرا آگاهانید."
        },
        {
          "verse": 15,
          "usfm": "2PE.1.15",
          "line_type": "p",
          "text": "و برای این نیز کوشش میکنم تاشما در هروقت بعد از رحلت من، بتوانید این اموررا یاد آورید."
        },
        {
          "verse": 16,
          "usfm": "2PE.1.16",
          "line_type": "p",
          "text": "زیرا که درپی افسانه های جعلی نرفتیم، چون از قوت و آمدن خداوند ما عیسی مسیح شما را اعلام دادیم، بلکه کبریایی او رادیده بودیم."
        },
        {
          "verse": 17,
          "usfm": "2PE.1.17",
          "line_type": "p",
          "text": "زیرا از خدای پدر اکرام و جلال یافت هنگامی که آوازی از جلال کبریایی به اورسید که «این است پسر حبیب من که از وی خشنودم.»"
        },
        {
          "verse": 18,
          "usfm": "2PE.1.18",
          "line_type": "p",
          "text": "و این آواز را ما زمانی که با وی درکوه مقدس بودیم، شنیدیم که از آسمان آورده شد."
        },
        {
          "verse": 19,
          "usfm": "2PE.1.19",
          "line_type": "p",
          "text": "و کلام انبیا را نیز محکم تر داریم که نیکومی کنید اگر در آن اهتمام کنید، مثل چراغی درخشنده در مکان تاریک تا روز بشکافد و ستاره صبح در دلهای شما طلوع کند."
        },
        {
          "verse": 20,
          "usfm": "2PE.1.20",
          "line_type": "p",
          "text": "و این رانخست بدانید که هیچ نبوت کتاب از تفسیر خودنبی نیست."
        },
        {
          "verse": 21,
          "usfm": "2PE.1.21",
          "line_type": "p",
          "text": "زیرا که نبوت به اراده انسان هرگزآورده نشد، بلکه مردمان به روحالقدس مجذوب شده، از جانب خدا سخنگفتند."
        }
      ],
