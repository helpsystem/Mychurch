    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 3,
      "chapter_usfm": "2PE.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.3.1",
          "line_type": "p",
          "text": "این رساله دوم راای حبیبان الان به شمامی نویسم که به این هردو، دل پاک شما را به طریق یادگاری برمی انگیزانم،"
        },
        {
          "verse": 2,
          "usfm": "2PE.3.2",
          "line_type": "p",
          "text": "تا بخاطر آریدکلماتی که انبیای مقدس، پیش گفتهاند و حکم خداوند و نجاتدهنده را که به رسولان شما داده شد."
        },
        {
          "verse": 3,
          "usfm": "2PE.3.3",
          "line_type": "p",
          "text": "و نخست این را میدانید که در ایام آخرمستهزئین با استهزا ظاهر خواهند شد که بر وفق شهوات خود رفتار نموده،"
        },
        {
          "verse": 4,
          "usfm": "2PE.3.4",
          "line_type": "p",
          "text": "خواهند گفت: «کجاست وعده آمدن او؟ زیرا از زمانی که پدران به خواب رفتند، هرچیز به همینطوری که ازابتدای آفرینش بود، باقی است.»"
        },
        {
          "verse": 5,
          "usfm": "2PE.3.5",
          "line_type": "p",
          "text": "زیرا که ایشان عمد از این غافل هستند که به کلام خدا آسمانهااز قدیم بود و زمین از آب و به آب قائم گردید."
        },
        {
          "verse": 6,
          "usfm": "2PE.3.6",
          "line_type": "p",
          "text": "وبه این هردو، عالمی که آن وقت بود در آب غرق شده، هلاک گشت."
        },
        {
          "verse": 7,
          "usfm": "2PE.3.7",
          "line_type": "p",
          "text": "لکن آسمان و زمین الان به همان کلام برای آتش ذخیره شده و تا روز داوری و هلاکت، مردم بیدین نگاه داشته شدهاند."
        },
        {
          "verse": 8,
          "usfm": "2PE.3.8",
          "line_type": "p",
          "text": "لکنای حبیبان، این یک چیز از شما مخفی نماند که یک روز نزد خدا چون هزار سال است وهزار سال چون یک روز."
        },
        {
          "verse": 9,
          "usfm": "2PE.3.9",
          "line_type": "p",
          "text": "خداوند در وعده خودتاخیر نمی نماید چنانکه بعضی تاخیرمی پندارند، بلکه بر شما تحمل مینماید چون نمی خواهد که کسی هلاک گردد بلکه همه به توبه گرایند."
        },
        {
          "verse": 10,
          "usfm": "2PE.3.10",
          "line_type": "p",
          "text": "لکن روز خداوند چون دزد خواهدآمد که در آن آسمانها به صدای عظیم زایل خواهند شد و عناصر سوخته شده، از هم خواهدپاشید و زمین و کارهایی که در آن است سوخته خواهد شد."
        },
        {
          "verse": 11,
          "usfm": "2PE.3.11",
          "line_type": "p",
          "text": "پس چون جمیع اینها متفرق خواهندگردید، شما چطور مردمان باید باشید، در هرسیرت مقدس و دینداری؟"
        },
        {
          "verse": 12,
          "usfm": "2PE.3.12",
          "line_type": "p",
          "text": "و آمدن روز خدارا انتظار بکشید و آن را بشتابانید که در آن آسمانها سوخته شده، از هم متفرق خواهند شد وعناصر از حرارت گداخته خواهد گردید."
        },
        {
          "verse": 13,
          "usfm": "2PE.3.13",
          "line_type": "p",
          "text": "ولی بحسب وعده او، منتظر آسمانهای جدید و زمین جدید هستیم که در آنها عدالت ساکن خواهد بود."
        },
        {
          "verse": 14,
          "usfm": "2PE.3.14",
          "line_type": "p",
          "text": "لهذاای حبیبان، چون انتظار این چیزها رامی کشید، جد و جهد نمایید تا نزد او بیداغ و بی عیب در سلامتی یافت شوید."
        },
        {
          "verse": 15,
          "usfm": "2PE.3.15",
          "line_type": "p",
          "text": "و تحمل خداوند ما را نجات بدانید، چنانکه برادر حبیب ماپولس نیز برحسب حکمتی که به وی داده شد، به شما نوشت."
        },
        {
          "verse": 16,
          "usfm": "2PE.3.16",
          "line_type": "p",
          "text": "و همچنین در سایر رساله های خود این چیزها را بیان مینماید که در آنها بعضی چیزهاست که فهمیدن آنها مشکل است و مردمان بیعلم و ناپایدار آنها را مثل سایر کتب تحریف می کنند تا به هلاکت خود برسند."
        },
        {
          "verse": 17,
          "usfm": "2PE.3.17",
          "line_type": "p",
          "text": "پس شماای حبیبان، چون این امور را ازپیش میدانید، باحذر باشید که مبادا به گمراهی بیدینان ربوده شده، از پایداری خود بیفتید."
        }
      ],
