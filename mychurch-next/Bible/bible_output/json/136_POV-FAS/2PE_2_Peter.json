    },
    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 2,
      "chapter_usfm": "2PE.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.2.1",
          "line_type": "p",
          "text": "لکن در میان قوم، انبیای کذبه نیز بودند، چنانکه در میان شما هم معلمان کذبه خواهند بود که بدعتهای مهلک را خفیه خواهندآورد و آن آقایی را که ایشان را خرید انکارخواهند نمود و هلاکت سریع را بر خود خواهندکشید؛"
        },
        {
          "verse": 2,
          "usfm": "2PE.2.2",
          "line_type": "p",
          "text": "و بسیاری فجور ایشان را متابعت خواهند نمود که بهسبب ایشان طریق حق، موردملامت خواهد شد."
        },
        {
          "verse": 3,
          "usfm": "2PE.2.3",
          "line_type": "p",
          "text": "و از راه طمع به سخنان جعلی شما را خرید و فروش خواهند کرد که عقوبت ایشان از مدت مدید تاخیر نمی کند وهلاکت ایشان خوابیده نیست."
        },
        {
          "verse": 4,
          "usfm": "2PE.2.4",
          "line_type": "p",
          "text": "زیرا هرگاه خدا بر فرشتگانی که گناه کردند، شفقت ننمود بلکه ایشان را به جهنم انداخته، به زنجیرهای ظلمت سپرد تا برای داوری نگاه داشته شوند؛"
        },
        {
          "verse": 5,
          "usfm": "2PE.2.5",
          "line_type": "p",
          "text": "و بر عالم قدیم شفقت نفرمود بلکه نوح، واعظ عدالت را با هفت نفر دیگر محفوظداشته، طوفان را بر عالم بیدینان آورد؛"
        },
        {
          "verse": 6,
          "usfm": "2PE.2.6",
          "line_type": "p",
          "text": "وشهرهای سدوم و عموره را خاکستر نموده، حکم به واژگون شدن آنها فرمود و آنها را برای آنانی که بعد از این بیدینی خواهند کرد، عبرتی ساخت؛"
        },
        {
          "verse": 7,
          "usfm": "2PE.2.7",
          "line_type": "p",
          "text": "و لوط عادل را که از رفتار فاجرانه بیدینان رنجیده بود رهانید."
        },
        {
          "verse": 8,
          "usfm": "2PE.2.8",
          "line_type": "p",
          "text": "زیرا که آن مرد عادل درمیانشان ساکن بوده، از آنچه میدید و میشنید، دل صالح خود را بهکارهای قبیح ایشان هرروزه رنجیده میداشت."
        },
        {
          "verse": 9,
          "usfm": "2PE.2.9",
          "line_type": "p",
          "text": "پس خداوند میداند که عادلان را از تجربه رهایی دهد و ظالمان را تا به روز جزا در عذاب نگاه دارد."
        },
        {
          "verse": 10,
          "usfm": "2PE.2.10",
          "line_type": "p",
          "text": "خصوص آنانی که در شهوات نجاست درپی جسم میروند وخداوندی را حقیر میدانند."
        },
        {
          "verse": 11,
          "usfm": "2PE.2.11",
          "line_type": "p",
          "text": "و حال آنکه فرشتگانی که در قدرت و قوت افضل هستند، پیش خداوند برایشان حکم افترا نمی زنند."
        },
        {
          "verse": 12,
          "usfm": "2PE.2.12",
          "line_type": "p",
          "text": "لکن اینها چون حیوانات غیرناطق که برای صید و هلاکت طبع متولد شدهاند، ملامت میکنند بر آنچه نمی دانندو در فساد خود هلاک خواهند شد."
        },
        {
          "verse": 13,
          "usfm": "2PE.2.13",
          "line_type": "p",
          "text": "و مزدناراستی خود را خواهند یافت که عیش و عشرت یک روزه را سرور خود میدانند. لکهها و عیبهاهستند که در ضیافت های محبتانه خود عیش وعشرت مینمایند وقتی که با شما شادی میکنند."
        },
        {
          "verse": 14,
          "usfm": "2PE.2.14",
          "line_type": "p",
          "text": "چشمهای پر از زنا دارند که از گناه بازداشته نمی شود، و کسان ناپایدار را به دام میکشند؛ ابنای لعنت که قلب خود را برای طمع ریاضت دادهاند،"
        },
        {
          "verse": 15,
          "usfm": "2PE.2.15",
          "line_type": "p",
          "text": "و راه مستقیم را ترک کرده، گمراه شدند و طریق بلعام بن بصور را که مزد ناراستی رادوست میداشت، متابعت کردند."
        },
        {
          "verse": 16,
          "usfm": "2PE.2.16",
          "line_type": "p",
          "text": "لکن او ازتقصیر خود توبیخ یافت که حمار گنگ به زبان انسان متنطق شده، دیوانگی نبی را توبیخ نمود."
        },
        {
          "verse": 17,
          "usfm": "2PE.2.17",
          "line_type": "p",
          "text": "اینها چشمه های بیآب و مه های رانده شده به باد شدید هستند که برای ایشان ظلمت تاریکی جاودانی، مقرر است."
        },
        {
          "verse": 18,
          "usfm": "2PE.2.18",
          "line_type": "p",
          "text": "زیرا که سخنان تکبرآمیز و باطل میگویند و آنانی را که از اهل ضلالت تازه رستگار شدهاند، در دام شهوات به فجور جسمی میکشند،"
        },
        {
          "verse": 19,
          "usfm": "2PE.2.19",
          "line_type": "p",
          "text": "و ایشان را به آزادی وعده میدهند و حال آنکه خود غلام فسادهستند، زیرا هرچیزی که بر کسی غلبه یافته باشد، او نیز غلام آن است."
        },
        {
          "verse": 20,
          "usfm": "2PE.2.20",
          "line_type": "p",
          "text": "زیرا هرگاه به معرفت خداوند و نجاتدهنده ما عیسی مسیح ازآلایش دنیوی رستند و بعد از آن، بار دیگر گرفتارو مغلوب آن گشتند، اواخر ایشان از اوایل بدترمی شود."
        },
        {
          "verse": 21,
          "usfm": "2PE.2.21",
          "line_type": "p",
          "text": "زیرا که برای ایشان بهتر میبود که راه عدالت را ندانسته باشند از اینکه بعد از دانستن باردیگر از آن حکم مقدس که بدیشان سپرده شده بود، برگردند."
        },
        {
          "verse": 22,
          "usfm": "2PE.2.22",
          "line_type": "p",
          "text": "لکن معنی مثل حقیقی بر ایشان راست آمد که «سگ به قی خود رجوع کرده است و خنزیر شسته شده، به غلطیدن در گل.»"
        }
      ],
