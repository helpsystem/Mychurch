    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 2,
      "chapter_usfm": "TIT.2",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.2.1",
          "line_type": "p",
          "text": "اما تو سخنان شایسته تعلیم صحیح را بگو:"
        },
        {
          "verse": 2,
          "usfm": "TIT.2.2",
          "line_type": "p",
          "text": "که مردان پیر، هشیار و باوقار وخرداندیش و در ایمان و محبت و صبر، صحیح باشند."
        },
        {
          "verse": 3,
          "usfm": "TIT.2.3",
          "line_type": "p",
          "text": "همچنین زنان پیر، در سیرت متقی باشند و نه غیبتگو و نه بنده شراب زیاده بلکه معلمات تعلیم نیکو،"
        },
        {
          "verse": 4,
          "usfm": "TIT.2.4",
          "line_type": "p",
          "text": "تا زنان جوان را خرد بیاموزند که شوهردوست و فرزنددوست باشند،"
        },
        {
          "verse": 5,
          "usfm": "TIT.2.5",
          "line_type": "p",
          "text": "وخرداندیش و عفیفه و خانه نشین و نیکو و مطیع شوهران خود که مبادا کلام خدا متهم شود."
        },
        {
          "verse": 6,
          "usfm": "TIT.2.6",
          "line_type": "p",
          "text": "و به همین نسق جوانان را نصیحت فرما تا خرداندیش باشند."
        },
        {
          "verse": 7,
          "usfm": "TIT.2.7",
          "line_type": "p",
          "text": "و خود را در همهچیز نمونه اعمال نیکو بسازو در تعلیم خود صفا و وقار و اخلاص را بکار بر،"
        },
        {
          "verse": 8,
          "usfm": "TIT.2.8",
          "line_type": "p",
          "text": "و کلام صحیح بیعیب را تا دشمن چونکه فرصت بدگفتن در حق ما نیابد، خجل شود."
        },
        {
          "verse": 9,
          "usfm": "TIT.2.9",
          "line_type": "p",
          "text": "غلامان را نصیحت نما که آقایان خود رااطاعت کنند و در هر امر ایشان را راضی سازند ونقیض گو نباشند؛"
        },
        {
          "verse": 10,
          "usfm": "TIT.2.10",
          "line_type": "p",
          "text": "و دزدی نکنند بلکه کمال دیانت را ظاهر سازند تا تعلیم نجاتدهنده ما خدارا در هر چیز زینت دهند."
        },
        {
          "verse": 11,
          "usfm": "TIT.2.11",
          "line_type": "p",
          "text": "زیرا که فیض خدا که برای همه مردم نجاتبخش است، ظاهر شده،"
        },
        {
          "verse": 12,
          "usfm": "TIT.2.12",
          "line_type": "p",
          "text": "ما را تادیب میکند که بیدینی و شهوات دنیوی را ترک کرده، با خرداندیشی و عدالت و دینداری در این جهان زیست کنیم."
        },
        {
          "verse": 13,
          "usfm": "TIT.2.13",
          "line_type": "p",
          "text": "و آن امید مبارک و تجلی جلال خدای عظیم و نجاتدهنده خود ما عیسی مسیح را انتظار کشیم،"
        },
        {
          "verse": 14,
          "usfm": "TIT.2.14",
          "line_type": "p",
          "text": "که خود را در راه ما فدا ساخت تا ما را از هر ناراستی برهاند و امتی برای خودطاهر سازد که ملک خاص او و غیور در اعمال نیکو باشند."
        },
        {
          "verse": 15,
          "usfm": "TIT.2.15",
          "line_type": "p",
          "text": "این را بگو و نصیحت فرما و درکمال اقتدار توبیخ نما و هیچکس تو را حقیرنشمارد."
        }
      ],
