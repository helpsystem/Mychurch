  "chapters": [
    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 1,
      "chapter_usfm": "TIT.1",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.1.1",
          "line_type": "p",
          "text": "پولس، غلام خدا و رسول عیسی مسیح برحسب ایمان برگزیدگان خدا و معرفت آن راستی که در دینداری است،"
        },
        {
          "verse": 2,
          "usfm": "TIT.1.2",
          "line_type": "p",
          "text": "به امید حیات جاودانی که خدایی که دروغ نمی تواند گفت، اززمانهای ازلی وعده آن را داد،"
        },
        {
          "verse": 3,
          "usfm": "TIT.1.3",
          "line_type": "p",
          "text": "اما در زمان معین، کلام خود را ظاهر کرد به موعظهای که برحسب حکم نجاتدهنده ما خدا به من سپرده شد،"
        },
        {
          "verse": 4,
          "usfm": "TIT.1.4",
          "line_type": "p",
          "text": "تیطس را که فرزند حقیقی من برحسب ایمان عام است، فیض و رحمت و سلامتی از جانب خدای پدرو نجاتدهنده ما عیسی مسیح خداوند باد."
        },
        {
          "verse": 5,
          "usfm": "TIT.1.5",
          "line_type": "p",
          "text": "بدین جهت تو را در کریت واگذاشتم تا آنچه را که باقیمانده است اصلاح نمایی و چنانکه من به تو امر نمودم، کشیشان در هر شهر مقرر کنی."
        },
        {
          "verse": 6,
          "usfm": "TIT.1.6",
          "line_type": "p",
          "text": "اگر کسی بیملامت و شوهر یک زن باشد که فرزندان مومن دارد، بری از تهمت فجور و تمرد،"
        },
        {
          "verse": 7,
          "usfm": "TIT.1.7",
          "line_type": "p",
          "text": "زیرا که اسقف میباید چون وکیل خدابی ملامت باشد و خودرای یا تندمزاج یا میگساریا زننده یا طماع سود قبیح نباشد،"
        },
        {
          "verse": 8,
          "usfm": "TIT.1.8",
          "line_type": "p",
          "text": "بلکه مهمان دوست و خیردوست و خرداندیش و عادل ومقدس و پرهیزکار؛"
        },
        {
          "verse": 9,
          "usfm": "TIT.1.9",
          "line_type": "p",
          "text": "و متمسک به کلام امین برحسب تعلیمی که یافته تا بتواند به تعلیم صحیح نصیحت کند و مخالفان را توبیخ نماید."
        },
        {
          "verse": 10,
          "usfm": "TIT.1.10",
          "line_type": "p",
          "text": "زیرا که یاوهگویان و فریبندگان، بسیار ومتمرد میباشند، علی الخصوص آنانی که از اهل ختنه هستند؛"
        },
        {
          "verse": 11,
          "usfm": "TIT.1.11",
          "line_type": "p",
          "text": "که دهان ایشان را باید بست زیراخانهها را بالکل واژگون میسازند و برای سودقبیح، تعالیم ناشایسته میدهند."
        },
        {
          "verse": 12,
          "usfm": "TIT.1.12",
          "line_type": "p",
          "text": "یکی از ایشان که نبی خاص ایشان است، گفته است که «اهل کریت همیشه دروغگو و وحوش شریر وشکم پرست بیکاره میباشند.»"
        },
        {
          "verse": 13,
          "usfm": "TIT.1.13",
          "line_type": "p",
          "text": "این شهادت راست است؛ از این جهت ایشان را به سختی توبیخ فرما تا در ایمان، صحیح باشند،"
        },
        {
          "verse": 14,
          "usfm": "TIT.1.14",
          "line_type": "p",
          "text": "و گوش نگیرند به افسانه های یهود و احکام مردمانی که ازراستی انحراف میجویند."
        },
        {
          "verse": 15,
          "usfm": "TIT.1.15",
          "line_type": "p",
          "text": "هرچیز برای پاکان پاک است، لیکن آلودگان و بیایمانان را هیچچیزپاک نیست، بلکه فهم و ضمیر ایشان نیز ملوث است؛"
        },
        {
          "verse": 16,
          "usfm": "TIT.1.16",
          "line_type": "p",
          "text": "مدعی معرفت خدا میباشند، اما به افعال خود او را انکار میکنند، چونکه مکروه ومتمرد هستند و بجهت هر عمل نیکو مردود."
        }
      ],
      "verse_count": 16,
