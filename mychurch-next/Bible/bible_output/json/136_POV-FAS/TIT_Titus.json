    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 3,
      "chapter_usfm": "TIT.3",
      "version_id": 136,
      "version_abbr": "POV",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.3.1",
          "line_type": "p",
          "text": "بیاد ایشان آور که حکام و سلاطین رااطاعت کنند و فرمانبرداری نمایند و برای هرکار نیکو مستعد باشند،"
        },
        {
          "verse": 2,
          "usfm": "TIT.3.2",
          "line_type": "p",
          "text": "و هیچکس را بدنگویند و جنگجو نباشند بلکه ملایم و کمال حلم را با جمیع مردم بهجا آورند."
        },
        {
          "verse": 3,
          "usfm": "TIT.3.3",
          "line_type": "p",
          "text": "زیرا که ما نیز سابق بیفهم و نافرمانبردار وگمراه و بنده انواع شهوات و لذات بوده، در خبث و حسد بسر میبردیم که لایق نفرت بودیم و بریکدیگر بغض میداشتیم."
        },
        {
          "verse": 4,
          "usfm": "TIT.3.4",
          "line_type": "p",
          "text": "لیکن چون مهربانی ولطف نجاتدهنده ما خدا ظاهر شد،"
        },
        {
          "verse": 5,
          "usfm": "TIT.3.5",
          "line_type": "p",
          "text": "نه بهسبب اعمالی که ما به عدالت کرده بودیم، بلکه محض رحمت خود ما را نجات داد به غسل تولد تازه وتازگیای که از روحالقدس است؛"
        },
        {
          "verse": 6,
          "usfm": "TIT.3.6",
          "line_type": "p",
          "text": "که او را به ما به دولتمندی افاضه نمود، به توسط نجاتدهنده ماعیسی مسیح،"
        },
        {
          "verse": 7,
          "usfm": "TIT.3.7",
          "line_type": "p",
          "text": "تا به فیض او عادل شمرده شده، وارث گردیم بحسب امید حیات جاودانی."
        },
        {
          "verse": 8,
          "usfm": "TIT.3.8",
          "line_type": "p",
          "text": "این سخن امین است و در این امور میخواهم تو قدغن بلیغ فرمایی تا آنانی که به خدا ایمان آورند، بکوشند که در اعمال نیکو مواظبت نمایند، زیرا که این امور برای انسان نیکو و مفیداست."
        },
        {
          "verse": 9,
          "usfm": "TIT.3.9",
          "line_type": "p",
          "text": "و از مباحثات نامعقول و نسب نامهها و نزاعهاو جنگهای شرعی اعراض نما زیرا که بیثمر وباطل است."
        },
        {
          "verse": 10,
          "usfm": "TIT.3.10",
          "line_type": "p",
          "text": "و از کسیکه از اهل بدعت باشد، بعد از یک دو نصیحت اجتناب نما،"
        },
        {
          "verse": 11,
          "usfm": "TIT.3.11",
          "line_type": "p",
          "text": "چون میدانی که چنین کس مرتد و از خود ملزم شده درگناه رفتار میکند."
        },
        {
          "verse": 12,
          "usfm": "TIT.3.12",
          "line_type": "p",
          "text": "وقتی که ارتیماس یا تیخیکس را نزد توفرستم، سعی کن که در نیکوپولیس نزد من آیی زیرا که عزیمت دارم زمستان را در آنجا بسر برم."
        },
        {
          "verse": 13,
          "usfm": "TIT.3.13",
          "line_type": "p",
          "text": "زیناس خطیب و اپلس را در سفر ایشان به سعی امداد کن تا محتاج هیچچیز نباشند."
        },
        {
          "verse": 14,
          "usfm": "TIT.3.14",
          "line_type": "p",
          "text": "و کسان ما نیز تعلیم بگیرند که در کارهای نیکومشغول باشند برای رفع احتیاجات ضروری، تابی ثمر نباشند."
        }
      ],
