  "chapters": [
    {
      "schema_version": 6,
      "book_id": "OBA",
      "chapter": 1,
      "chapter_usfm": "OBA.1",
      "version_id": 59,
      "version_abbr": "ESV",
      "verses": [
        {
          "verse": 1,
          "usfm": "OBA.1.1",
          "line_type": "p",
          "text": "The vision of Obadiah.Thus says the Lord God concerning Edom: We have heard a report from the Lord,and a messenger has been sent among the nations:“Rise up! Let us rise against her for battle!”"
        },
        {
          "verse": 2,
          "usfm": "OBA.1.2",
          "line_type": "q1",
          "text": "Behold, I will make you small among the nations;you shall be utterly despised."
        },
        {
          "verse": 3,
          "usfm": "OBA.1.3",
          "line_type": "q1",
          "text": "The pride of your heart has deceived you,you who live in the clefts of the rock,in your lofty dwelling, who say in your heart,“Who will bring me down to the ground?”"
        },
        {
          "verse": 4,
          "usfm": "OBA.1.4",
          "line_type": "q1",
          "text": "Though you soar aloft like the eagle,though your nest is set among the stars,from there I will bring you down,declares the Lord."
        },
        {
          "verse": 5,
          "usfm": "OBA.1.5",
          "line_type": "q1",
          "text": "If thieves came to you,if plunderers came by night—how you have been destroyed!—would they not steal only enough for themselves?If grape gatherers came to you,would they not leave gleanings?"
        },
        {
          "verse": 6,
          "usfm": "OBA.1.6",
          "line_type": "q1",
          "text": "How Esau has been pillaged,his treasures sought out!"
        },
        {
          "verse": 7,
          "usfm": "OBA.1.7",
          "line_type": "q1",
          "text": "All your allies have driven you to your border;those at peace with you have deceived you;they have prevailed against you; those who eat your bread have set a trap beneath you— you have no understanding."
        },
        {
          "verse": 8,
          "usfm": "OBA.1.8",
          "line_type": "q1",
          "text": "Will I not on that day, declares the Lord,destroy the wise men out of Edom,and understanding out of Mount Esau?"
        },
        {
          "verse": 9,
          "usfm": "OBA.1.9",
          "line_type": "q1",
          "text": "And your mighty men shall be dismayed, O Teman,so that every man from Mount Esau will be cut off by slaughter."
        },
        {
          "verse": 10,
          "usfm": "OBA.1.10",
          "line_type": "q1",
          "text": "Because of the violence done to your brother Jacob,shame shall cover you, and you shall be cut off forever."
        },
        {
          "verse": 11,
          "usfm": "OBA.1.11",
          "line_type": "q1",
          "text": "On the day that you stood aloof, on the day that strangers carried off his wealthand foreigners entered his gates and cast lots for Jerusalem,you were like one of them."
        },
        {
          "verse": 12,
          "usfm": "OBA.1.12",
          "line_type": "q1",
          "text": "But do not gloat over the day of your brotherin the day of his misfortune; do not rejoice over the people of Judahin the day of their ruin; do not boastin the day of distress."
        },
        {
          "verse": 13,
          "usfm": "OBA.1.13",
          "line_type": "q1",
          "text": "Do not enter the gate of my peoplein the day of their calamity; do not gloat over his disasterin the day of his calamity; do not loot his wealthin the day of his calamity."
        },
        {
          "verse": 14,
          "usfm": "OBA.1.14",
          "line_type": "q1",
          "text": "Do not stand at the crossroadsto cut off his fugitives;do not hand over his survivorsin the day of distress."
        },
        {
          "verse": 15,
          "usfm": "OBA.1.15",
          "line_type": "q1",
          "text": "For the day of the Lord is near upon all the nations. As you have done, it shall be done to you;your deeds shall return on your own head."
        },
        {
          "verse": 16,
          "usfm": "OBA.1.16",
          "line_type": "q1",
          "text": "For as you have drunk on my holy mountain,so all the nations shall drink continually;they shall drink and swallow,and shall be as though they had never been."
        },
        {
          "verse": 17,
          "usfm": "OBA.1.17",
          "line_type": "q1",
          "text": "But in Mount Zion there shall be those who escape,and it shall be holy, and the house of Jacob shall possess their own possessions."
        },
        {
          "verse": 18,
          "usfm": "OBA.1.18",
          "line_type": "q1",
          "text": "The house of Jacob shall be a fire,and the house of Joseph a flame,and the house of Esau stubble;they shall burn them and consume them, and there shall be no survivor for the house of Esau,for the Lord has spoken."
        },
        {
          "verse": 19,
          "usfm": "OBA.1.19",
          "line_type": "q1",
          "text": "Those of the Negeb shall possess Mount Esau,and those of the Shephelah shall possess the land of the Philistines;they shall possess the land of Ephraim and the land of Samaria,and Benjamin shall possess Gilead."
        },
        {
          "verse": 20,
          "usfm": "OBA.1.20",
          "line_type": "q1",
          "text": "The exiles of this host of the people of Israelshall possess the land of the Canaanites as far as Zarephath,and the exiles of Jerusalem who are in Sepharadshall possess the cities of the Negeb."
        },
        {
          "verse": 21,
          "usfm": "OBA.1.21",
          "line_type": "q1",
          "text": "Saviors shall go up to Mount Zionto rule Mount Esau,and the kingdom shall be the Lord’s."
        }
      ],
      "verse_count": 21,
