    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 2,
      "chapter_usfm": "JON.2",
      "version_id": 2079,
      "version_abbr": "EASY",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.2.1",
          "line_type": "p",
          "text": "From inside the fish's stomach, Jonah prayed to the Lord his God."
        },
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "line_type": "p",
          "text": "He said,‘When I was in trouble, I called out to the Lord,and he answered my prayer.Yes, I called out to you for help from the deep hole of death,and you heard my prayer."
        },
        {
          "verse": 3,
          "usfm": "JON.2.3",
          "line_type": "q1",
          "text": "You threw me into the deep water,and I fell into the middle of the sea.The deep water covered me.You sent big waves to roll over me."
        },
        {
          "verse": 4,
          "usfm": "JON.2.4",
          "line_type": "q1",
          "text": "I said to myself,“You have sent me far away from you.Now I will never see your holy temple again.”"
        },
        {
          "verse": 5,
          "usfm": "JON.2.5",
          "line_type": "q1",
          "text": "The deep water of the sea covered me,so that my life was in danger.The plants in the sea were all around my head."
        },
        {
          "verse": 6,
          "usfm": "JON.2.6",
          "line_type": "q1",
          "text": "I went very deep in the water,as far as the bottom of the mountains.Deep in the earth, I was in a prison,and its gates had shut for ever.But, Lord, my God,you brought me up from that deep hole."
        },
        {
          "verse": 7,
          "usfm": "JON.2.7",
          "line_type": "q1",
          "text": "When my life was nearly gone, I prayed to you, Lord.In your holy temple, you heard my prayer for help."
        },
        {
          "verse": 8,
          "usfm": "JON.2.8",
          "line_type": "q1",
          "text": "Idols cannot help.People who worship them have turned away from God's faithful love."
        },
        {
          "verse": 9,
          "usfm": "JON.2.9",
          "line_type": "q1",
          "text": "But as for me, I will sing to thank you.I will offer a sacrifice to you.I will do everything that I have promised to do.The Lord is the one who saves people!’"
        },
        {
          "verse": 10,
          "usfm": "JON.2.10",
          "line_type": "p",
          "text": "Then the Lord told the great fish to spit Jonah out from its stomach. So it dropped Jonah onto the shore."
        }
      ],
      "verse_count": 10,
      "headings": [
        {
          "before_verse": 1,
          "text": "Jonah prays for God's help from inside the fish"
        }
      ],
      "footnotes": [
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "note_ref": "2:2",
          "note_type": "footnote",
          "references": [],
          "text": "The stomach of the great fish seemed as if it was Jonah's grave. He calls it the deep hole of death, the place where people go when they die."
        },
        {
          "verse": 4,
          "usfm": "JON.2.4",
          "note_ref": "2:4",
          "note_type": "footnote",
          "references": [],
          "text": "Or: ‘But I know that I will see your holy temple again.’"
        }
      ],
