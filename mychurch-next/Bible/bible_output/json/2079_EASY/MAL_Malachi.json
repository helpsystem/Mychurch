    {
      "schema_version": 6,
      "book_id": "MAL",
      "chapter": 4,
      "chapter_usfm": "MAL.4",
      "version_id": 2079,
      "version_abbr": "EASY",
      "verses": [
        {
          "verse": 1,
          "usfm": "MAL.4.1",
          "line_type": "p",
          "text": "‘The great day when I come to judge people will certainly happen. Punishment will come like the great fire of a hot oven. It will destroy all the proud people who do evil things. It will completely destroy them, like a fire that destroys dry grass. Nothing will remain.’That is what the Lord Almighty says."
        },
        {
          "verse": 2,
          "usfm": "MAL.4.2",
          "line_type": "p",
          "text": "‘But it will be different for you who respect my name. On that day, I will come to make you well again, like the sun that rises to shine on you. I will show that you are right. When that happens, you will be very happy. You will jump up and down like young cows when someone lets them go free."
        },
        {
          "verse": 3,
          "usfm": "MAL.4.3",
          "line_type": "p",
          "text": "Then you will walk over the wicked people. They will be like ashes under your feet. That will happen on the day when I do these things.’That is what the Lord Almighty says."
        },
        {
          "verse": 4,
          "usfm": "MAL.4.4",
          "line_type": "p",
          "text": "‘Remember the laws that I gave to my servant Moses at Mount Sinai. Those rules and commands were for all the Israelites to obey."
        },
        {
          "verse": 5,
          "usfm": "MAL.4.5",
          "line_type": "p",
          "text": "Look! I will send my prophet Elijah to you. He will come before that great day of the Lord arrives. That will be a day that makes people afraid."
        },
        {
          "verse": 6,
          "usfm": "MAL.4.6",
          "line_type": "p",
          "text": "He will speak my message, so that fathers and their children return to each other as friends. Then I will not have to come and bring punishment on the land.’"
        }
      ],
      "verse_count": 6,
      "headings": [
        {
          "before_verse": 1,
          "text": "The great day when God will judge people"
        }
      ],
      "footnotes": [
        {
          "verse": 4,
          "usfm": "MAL.4.4",
          "note_ref": "4:4",
          "note_type": "footnote",
          "references": [],
          "text": "Moses was a great leader of the Israelites, who gave God's laws to the people."
        },
        {
          "verse": 4,
          "usfm": "MAL.4.4",
          "note_ref": "4:4",
          "note_type": "footnote",
          "references": [
            "EXO.20.1+EXO.20.2+EXO.20.3+EXO.20.4+EXO.20.5+EXO.20.6+EXO.20.7+EXO.20.8+EXO.20.9+EXO.20.10+EXO.20.11+EXO.20.12+EXO.20.13+EXO.20.14+EXO.20.15+EXO.20.16+EXO.20.17"
          ],
          "text": "See Exodus 20:1-17."
        },
        {
          "verse": 5,
          "usfm": "MAL.4.5",
          "note_ref": "4:5",
          "note_type": "footnote",
          "references": [
            "1KI.17.1",
            "MAT.17.10+MAT.17.11+MAT.17.12+MAT.17.13"
          ],
          "text": "Elijah was a prophet who spoke God's message to the people. See 1 Kings 17:1. Here, God promises that another prophet like Elijah will come. See Matthew 17:10-13."
        }
      ],
