    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 2,
      "chapter_usfm": "TIT.2",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.2.1",
          "line_type": "p",
          "text": "But you, speak the things which are fitting for sound instruction."
        },
        {
          "verse": 2,
          "usfm": "TIT.2.2",
          "line_type": "p",
          "text": "Older men are to be temperate, worthy of respect, self-controlled, sound in faith, in love, and in endurance."
        },
        {
          "verse": 3,
          "usfm": "TIT.2.3",
          "line_type": "p",
          "text": "Older women likewise are to be reverent in their behavior, not slanderous, not enslaved to much wine, teaching what is good,"
        },
        {
          "verse": 4,
          "usfm": "TIT.2.4",
          "line_type": "p",
          "text": "in order that they may encourage the young women to love their husbands and to love their children,"
        },
        {
          "verse": 5,
          "usfm": "TIT.2.5",
          "line_type": "p",
          "text": "to be self-controlled, pure, busy at home, good, being subject to their own husbands, in order that the word of God may not be slandered."
        },
        {
          "verse": 6,
          "usfm": "TIT.2.6",
          "line_type": "p",
          "text": "Likewise, exhort the young men to be self-controlled,"
        },
        {
          "verse": 7,
          "usfm": "TIT.2.7",
          "line_type": "p",
          "text": "concerning everything showing yourself to be an example of good deeds, in your teaching demonstrating soundness, dignity,"
        },
        {
          "verse": 8,
          "usfm": "TIT.2.8",
          "line_type": "p",
          "text": "a sound message beyond reproach, in order that an opponent may be put to shame, because he has nothing bad to say concerning us."
        },
        {
          "verse": 9,
          "usfm": "TIT.2.9",
          "line_type": "p",
          "text": "Slaves must be subject to their own masters in everything, to be well-pleasing, not to talk back,"
        },
        {
          "verse": 10,
          "usfm": "TIT.2.10",
          "line_type": "p",
          "text": "not stealing, but demonstrating all good faith, in order that they may do credit to the teaching of God our Savior in everything."
        },
        {
          "verse": 11,
          "usfm": "TIT.2.11",
          "line_type": "p",
          "text": "For the grace of God has appeared, bringing salvation to all people,"
        },
        {
          "verse": 12,
          "usfm": "TIT.2.12",
          "line_type": "p",
          "text": "training us in order that, denying impiety and worldly desires, we may live self-controlled and righteously and godly in the present age,"
        },
        {
          "verse": 13,
          "usfm": "TIT.2.13",
          "line_type": "p",
          "text": "looking forward to the blessed hope and the glorious appearing of our great God and Savior Jesus Christ,"
        },
        {
          "verse": 14,
          "usfm": "TIT.2.14",
          "line_type": "p",
          "text": "who gave himself for us, in order that he might redeem us from all lawlessness and purify for himself a people for his own possession, zealous for good deeds."
        },
        {
          "verse": 15,
          "usfm": "TIT.2.15",
          "line_type": "p",
          "text": "Speak these things and exhort and reprove with all authority. Let no one disregard you."
        }
      ],
      "verse_count": 15,
      "headings": [],
      "footnotes": [
        {
          "verse": 8,
          "usfm": "TIT.2.8",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "Literally “one from the opposed”"
