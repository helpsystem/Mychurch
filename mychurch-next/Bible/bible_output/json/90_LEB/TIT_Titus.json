  "chapters": [
    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 1,
      "chapter_usfm": "TIT.1",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.1.1",
          "line_type": "p",
          "text": "Paul, a slave of God and an apostle of Jesus Christ for the faith of the chosen of God and the knowledge of the truth that is according to godliness,"
        },
        {
          "verse": 2,
          "usfm": "TIT.1.2",
          "line_type": "p",
          "text": "in the hope of eternal life which God, who does not lie, promised before eternal ages,"
        },
        {
          "verse": 3,
          "usfm": "TIT.1.3",
          "line_type": "p",
          "text": "but at the proper time has disclosed his message in the proclamation with which I was entrusted according to the command of God our Savior,"
        },
        {
          "verse": 4,
          "usfm": "TIT.1.4",
          "line_type": "p",
          "text": "to Titus, my true child according to a common faith. Grace and peace from God the Father and Christ Jesus our Savior."
        },
        {
          "verse": 5,
          "usfm": "TIT.1.5",
          "line_type": "p",
          "text": "On account of this, I left you behind in Crete, in order that what remains may be set in order and you may appoint elders in every town, as I ordered you."
        },
        {
          "verse": 6,
          "usfm": "TIT.1.6",
          "line_type": "p",
          "text": "If anyone is blameless, the husband of one wife, having faithful children, not accused of dissipation or rebellious."
        },
        {
          "verse": 7,
          "usfm": "TIT.1.7",
          "line_type": "p",
          "text": "For it is necessary for the overseer to be blameless as God’s steward, not self-willed, not quick-tempered, not addicted to wine, not violent, not greedy for dishonest gain,"
        },
        {
          "verse": 8,
          "usfm": "TIT.1.8",
          "line_type": "p",
          "text": "but hospitable, loving what is good, prudent, just, devout, self-controlled,"
        },
        {
          "verse": 9,
          "usfm": "TIT.1.9",
          "line_type": "p",
          "text": "holding fast to the faithful message according to the teaching, in order that he may be able both to exhort with sound instruction and to reprove those who speak against it."
        },
        {
          "verse": 10,
          "usfm": "TIT.1.10",
          "line_type": "p",
          "text": "For there are many rebellious people, idle talkers and deceivers, especially those of the circumcision,"
        },
        {
          "verse": 11,
          "usfm": "TIT.1.11",
          "line_type": "p",
          "text": "whom it is necessary to silence, whoever are ruining whole families by teaching things which must not be taught for the sake of dishonest gain."
        },
        {
          "verse": 12,
          "usfm": "TIT.1.12",
          "line_type": "p",
          "text": "A certain one of them, one of their own prophets, has said, “Cretans are always liars, evil beasts, lazy gluttons.”"
        },
        {
          "verse": 13,
          "usfm": "TIT.1.13",
          "line_type": "p",
          "text": "This testimony is true, for which reason reprove them severely, in order that they may be sound in the faith,"
        },
        {
          "verse": 14,
          "usfm": "TIT.1.14",
          "line_type": "p",
          "text": "not paying attention to Jewish myths and commandments of people who turn away from the truth."
        },
        {
          "verse": 15,
          "usfm": "TIT.1.15",
          "line_type": "p",
          "text": "To the pure all things are pure, but to those who are defiled and unbelieving nothing is pure, but both their mind and conscience are defiled."
        },
        {
          "verse": 16,
          "usfm": "TIT.1.16",
          "line_type": "p",
          "text": "They profess to know God, but by their deeds they deny him, because they are detestable and disobedient, and unfit for every good deed."
        }
      ],
      "verse_count": 16,
      "headings": [
        {
          "before_verse": 5,
          "text": "Instructions to Titus in Crete"
        }
      ],
      "footnotes": [
        {
          "verse": 6,
          "usfm": "TIT.1.6",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "Or “believing”"
        },
        {
          "verse": 6,
          "usfm": "TIT.1.6",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "Literally “with an accusation of dissipation”"
        },
        {
          "verse": 11,
          "usfm": "TIT.1.11",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "﻿*Here “by” is supplied as a component of the participle (“teaching”) which is understood as means"
        },
