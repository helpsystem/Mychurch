      "chapter": 1,
      "chapter_usfm": "2JN.1",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2JN.1.1",
          "line_type": "p",
          "text": "The elder, to the elect lady and her children, whom I love in truth—and not I alone, but also all those who know the truth—"
        },
        {
          "verse": 2,
          "usfm": "2JN.1.2",
          "line_type": "p",
          "text": "because of the truth that resides in us and will be with us forever."
        },
        {
          "verse": 3,
          "usfm": "2JN.1.3",
          "line_type": "p",
          "text": "Grace, mercy, peace will be with us from God the Father and from Jesus Christ the Son of the Father in truth and love."
        },
        {
          "verse": 4,
          "usfm": "2JN.1.4",
          "line_type": "p",
          "text": "I was very glad because I found some of your children walking in the truth, just as the Father commanded us."
        },
        {
          "verse": 5,
          "usfm": "2JN.1.5",
          "line_type": "p",
          "text": "And now I ask you, lady (not as if I were writing a new commandment to you, but one that we have had from the beginning), that we should love one another."
        },
        {
          "verse": 6,
          "usfm": "2JN.1.6",
          "line_type": "p",
          "text": "And this is love: that we walk according to his commandments. This is the commandment, just as you have heard from the beginning, so that you should walk in it."
        },
        {
          "verse": 7,
          "usfm": "2JN.1.7",
          "line_type": "p",
          "text": "For many deceivers have gone out into the world, those who do not confess Jesus Christ coming in the flesh. This person is the deceiver and the antichrist!"
        },
        {
          "verse": 8,
          "usfm": "2JN.1.8",
          "line_type": "p",
          "text": "Watch yourselves that you do not lose what we have worked for, but receive a full reward."
        },
        {
          "verse": 9,
          "usfm": "2JN.1.9",
          "line_type": "p",
          "text": "Everyone who goes too far and does not remain in the teaching of Christ does not have God. The one who remains in the teaching—this person has both the Father and the Son."
        },
        {
          "verse": 10,
          "usfm": "2JN.1.10",
          "line_type": "p",
          "text": "If anyone comes to you and does not bring this teaching, do not receive him into your house and do not speak a greeting to him,"
        },
        {
          "verse": 11,
          "usfm": "2JN.1.11",
          "line_type": "p",
          "text": "because the one who speaks a greeting to him shares in his evil deeds."
        },
        {
          "verse": 12,
          "usfm": "2JN.1.12",
          "line_type": "p",
          "text": "Although I have many things to write to you, I do not want to do so by means of paper and ink, but I hope to be with you and to speak face to face, so that your joy may be complete."
        },
        {
          "verse": 13,
          "usfm": "2JN.1.13",
          "line_type": "p",
          "text": "The children of your elect sister greet you."
        }
      ],
      "verse_count": 13,
      "headings": [
        {
          "before_verse": 5,
          "text": "Watch Out for False Teachers"
        },
        {
          "before_verse": 12,
          "text": "Conclusion and Final Greeting"
        }
      ],
