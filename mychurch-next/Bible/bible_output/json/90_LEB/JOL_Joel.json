    {
      "schema_version": 6,
      "book_id": "JOL",
      "chapter": 1,
      "chapter_usfm": "JOL.1",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "JOL.1.1",
          "line_type": "p",
          "text": "The word of Yahweh that came to Joel son of Pethuel."
        },
        {
          "verse": 2,
          "usfm": "JOL.1.2",
          "line_type": null,
          "text": "Hear this, O elders, and give ear, all the inhabitants of the land. Has this happened in your days? Or the days of your ancestors?"
        },
        {
          "verse": 3,
          "usfm": "JOL.1.3",
          "line_type": null,
          "text": "Tell it to your children, and your children to their children, and their children to the following generation."
        },
        {
          "verse": 4,
          "usfm": "JOL.1.4",
          "line_type": null,
          "text": "What the cutting locust left, the swarming locust has eaten. What the swarming locust left, the hopping locust has eaten. And what the hopping locust left, the destroying locust has eaten."
        },
        {
          "verse": 5,
          "usfm": "JOL.1.5",
          "line_type": null,
          "text": "Wake up, drunkards, and weep! Wail, all drinkers of wine, over the new wine, for it is cut off from your mouth."
        },
        {
          "verse": 6,
          "usfm": "JOL.1.6",
          "line_type": null,
          "text": "Because a nation has invaded my land, strong and beyond counting. Its teeth are the teeth of a lion, and its fangs are those of a lioness."
        },
        {
          "verse": 7,
          "usfm": "JOL.1.7",
          "line_type": null,
          "text": "It has made my vine a desolation, and my fig tree a completely splintered stump. It has stripped them bare and thrown them down; their branches have turned white."
        },
        {
          "verse": 8,
          "usfm": "JOL.1.8",
          "line_type": null,
          "text": "Lament like a virgin girded in sackcloth for the husband of her youth."
        },
        {
          "verse": 9,
          "usfm": "JOL.1.9",
          "line_type": null,
          "text": "The offering and libation are withheld from the house of Yahweh. The priests mourn, the ministers of Yahweh."
        },
        {
          "verse": 10,
          "usfm": "JOL.1.10",
          "line_type": null,
          "text": "The field is destroyed; the earth mourns because the grain is destroyed, the new wine dries up, the olive oil languishes."
        },
        {
          "verse": 11,
          "usfm": "JOL.1.11",
          "line_type": null,
          "text": "Be ashamed, farmers; Wail, vinedressers, over the wheat and over the barley, because the harvest of the field is ruined."
        },
        {
          "verse": 12,
          "usfm": "JOL.1.12",
          "line_type": null,
          "text": "The vine withers and the fig tree droops. The pomegranate tree, and also the palm tree, the apple tree —all the trees of the field—are dried up. Indeed, joy is dried up among the sons of men."
        },
        {
          "verse": 13,
          "usfm": "JOL.1.13",
          "line_type": null,
          "text": "Gird yourselves and lament, O priests! Wail, O ministers of the altar! Come spend the night in sackcloth, O ministers of my God, because offering and libation are withheld from the house of your God."
        },
        {
          "verse": 14,
          "usfm": "JOL.1.14",
          "line_type": null,
          "text": "Solemnize a fast! Call an assembly! Gather the elders, all of the inhabitants of the land in the house of Yahweh your God, and cry out to Yahweh."
        },
        {
          "verse": 15,
          "usfm": "JOL.1.15",
          "line_type": null,
          "text": "Ah! For the day! For the day of Yahweh is near. It will come like destruction from Shaddai."
        },
        {
          "verse": 16,
          "usfm": "JOL.1.16",
          "line_type": null,
          "text": "Is not food cut off before our eyes, from the house of our God, joy and gladness?"
        },
        {
          "verse": 17,
          "usfm": "JOL.1.17",
          "line_type": null,
          "text": "The seeds shrivel under their clods; the storehouses are desolate. The grain storage places are destroyed because grain has dried out."
        },
        {
          "verse": 18,
          "usfm": "JOL.1.18",
          "line_type": null,
          "text": "How the beasts groan; the herds of cattle wander around because there is no pasture for them; the flocks of sheep are in distress."
        },
        {
          "verse": 19,
          "usfm": "JOL.1.19",
          "line_type": null,
          "text": "To you, O Yahweh, I cry out, because fire has devoured the pastures of the desert, and flames burned all the trees of the field."
        },
        {
          "verse": 20,
          "usfm": "JOL.1.20",
          "line_type": null,
          "text": "Also, the beasts of the field long for you, because the courses of water are dried up, and fire has devoured the pastures of the desert."
        }
      ],
      "verse_count": 20,
      "headings": [
        {
          "before_verse": 2,
          "text": "A Lament Over the Land"
        }
      ],
