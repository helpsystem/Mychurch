    {
      "schema_version": 6,
      "book_id": "JOL",
      "chapter": 3,
      "chapter_usfm": "JOL.3",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "JOL.3.1",
          "line_type": "p",
          "text": "For look! In those days, and in that time, when I will return the fortunes of Judah and Jerusalem,"
        },
        {
          "verse": 2,
          "usfm": "JOL.3.2",
          "line_type": "p",
          "text": "I will gather all the nations, and I will bring them down to the valley of Jehoshaphat, and I will argue a case against them there concerning my people and my inheritance Israel whom they have scattered among the nations, and my land that they have divided."
        },
        {
          "verse": 3,
          "usfm": "JOL.3.3",
          "line_type": "p",
          "text": "For my people they cast lots, and they traded the male child for the prostitute, and the female child they sold for wine and they drank it."
        },
        {
          "verse": 4,
          "usfm": "JOL.3.4",
          "line_type": "p",
          "text": "What are you to me, O Tyre and O Sidon, and all of the regions of Philistia? Are you repaying to me what is deserved? If you are recompensing me, I will return swiftly and quickly what you deserve on your head!"
        },
        {
          "verse": 5,
          "usfm": "JOL.3.5",
          "line_type": "p",
          "text": "For you have taken my silver and my gold, and my beautiful treasures you have carried into your temples."
        },
        {
          "verse": 6,
          "usfm": "JOL.3.6",
          "line_type": "p",
          "text": "And the sons of Judah and Jerusalem you sold to the sons of the Greeks, in order to remove them from their border."
        },
        {
          "verse": 7,
          "usfm": "JOL.3.7",
          "line_type": "p",
          "text": "Look! I am rousing them from the place where you have sold them, and I will return what you deserve on your head!"
        },
        {
          "verse": 8,
          "usfm": "JOL.3.8",
          "line_type": "p",
          "text": "I will sell your sons and your daughters into the hand of the children of Judah, and they will sell them to the Sabeans and to a nation far away, for Yahweh has spoken."
        },
        {
          "verse": 9,
          "usfm": "JOL.3.9",
          "line_type": null,
          "text": "Proclaim this among the nations: Prepare for war! Stir up the mighty warriors; let them approach and come up; let all the men of war approach."
        },
        {
          "verse": 10,
          "usfm": "JOL.3.10",
          "line_type": null,
          "text": "Beat your cutting tools of iron into swords and your pruning hooks into spears; let the weakling say, ‘I am a mighty warrior!’"
        },
        {
          "verse": 11,
          "usfm": "JOL.3.11",
          "line_type": null,
          "text": "Hurry and come, all the nations, from all around, and gather yourselves there. Bring down your mighty warriors, O Yahweh!"
        },
        {
          "verse": 12,
          "usfm": "JOL.3.12",
          "line_type": null,
          "text": "Let the nations be roused and let them come up to the valley of Jehoshaphat, for there I will sit to judge all the nations from all around."
        },
        {
          "verse": 13,
          "usfm": "JOL.3.13",
          "line_type": null,
          "text": "Send forth the sickle, for the harvest is ripe! Go tread, for the winepress is full! The vats overflow, because their evil is great!"
        },
        {
          "verse": 14,
          "usfm": "JOL.3.14",
          "line_type": null,
          "text": "Commotion, commotion in the valley of decision! For the day of Yahweh is near in the valley of decision!"
        },
        {
          "verse": 15,
          "usfm": "JOL.3.15",
          "line_type": null,
          "text": "The sun and the moon grow dark, and the stars have withheld their splendor."
        },
        {
          "verse": 16,
          "usfm": "JOL.3.16",
          "line_type": null,
          "text": "And Yahweh roars from Zion; from Jerusalem he utters his voice, and the heavens and the earth shake. But Yahweh is a refuge for his people, and a protection for the children of Israel."
        },
        {
          "verse": 17,
          "usfm": "JOL.3.17",
          "line_type": null,
          "text": "And you will know that I, Yahweh your God, am dwelling in Zion, my holy mountain. And Jerusalem will be a place of holiness, and strangers will pass through it no longer."
        },
        {
          "verse": 18,
          "usfm": "JOL.3.18",
          "line_type": null,
          "text": "And it will happen on that day; the mountains will drip new wine, and the hills will flow with milk, and all the channels of Judah will flow with water. A spring from the house of Yahweh will come forth, and it will water the valley of Acacia Trees."
        },
        {
          "verse": 19,
          "usfm": "JOL.3.19",
          "line_type": null,
          "text": "Egypt will become a desolation, and Edom will become a desolate desert, because of the violence they did against the children of Judah, in whose land they have shed innocent blood."
        },
        {
          "verse": 20,
          "usfm": "JOL.3.20",
          "line_type": null,
          "text": "But Judah will be inhabited forever, and Jerusalem for all generations."
        },
        {
          "verse": 21,
          "usfm": "JOL.3.21",
          "line_type": null,
          "text": "I will cleanse their bloodguilt that I did not cleanse, for Yahweh is dwelling in Zion."
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 9,
          "text": "Yahweh’s Judgment in the Valley of Jehoshaphat"
        }
      ],
