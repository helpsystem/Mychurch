    {
      "schema_version": 6,
      "book_id": "MAL",
      "chapter": 4,
      "chapter_usfm": "MAL.4",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "MAL.4.1",
          "line_type": "p",
          "text": "“For look! The day is about to come, burning like an oven, and all the arrogant and every evildoer will be stubble. The coming day will consume them,” says Yahweh of hosts. “It will not leave behind for them root or branch."
        },
        {
          "verse": 2,
          "usfm": "MAL.4.2",
          "line_type": "p",
          "text": "But for you who revere my name, the sun of righteousness will rise, with healing in its wings, and you will go out and leap like fattened calves."
        },
        {
          "verse": 3,
          "usfm": "MAL.4.3",
          "line_type": "p",
          "text": "You will trample down the wicked, for they will be ashes under the soles of your feet on the day that I am going to act,” says Yahweh of hosts."
        },
        {
          "verse": 4,
          "usfm": "MAL.4.4",
          "line_type": "p",
          "text": "“Remember the instruction of my servant Moses, which I commanded him at Horeb to all Israel, the rules and regulations."
        },
        {
          "verse": 5,
          "usfm": "MAL.4.5",
          "line_type": "p",
          "text": "Look! I am going to send to you Elijah the prophet before the coming of the great and awesome day of Yahweh!"
        },
        {
          "verse": 6,
          "usfm": "MAL.4.6",
          "line_type": "p",
          "text": "And he will bring back the hearts of the fathers to the sons, and the hearts of the sons to their fathers, so that I will not come and strike the land with a ban.”"
        }
      ],
      "verse_count": 6,
      "headings": [],
