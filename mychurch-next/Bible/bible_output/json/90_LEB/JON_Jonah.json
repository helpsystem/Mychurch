    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 3,
      "chapter_usfm": "JON.3",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.3.1",
          "line_type": "p",
          "text": "And the word of Yahweh came to Jonah a second time, saying,"
        },
        {
          "verse": 2,
          "usfm": "JON.3.2",
          "line_type": "p",
          "text": "“Get up! Go to Nineveh, the great city, and proclaim to it the message that I am telling you.”"
        },
        {
          "verse": 3,
          "usfm": "JON.3.3",
          "line_type": "p",
          "text": "So Jonah got up and went to Nineveh according to the word of Yahweh. Now Nineveh was an extraordinarily great city—a journey of three days across."
        },
        {
          "verse": 4,
          "usfm": "JON.3.4",
          "line_type": "p",
          "text": "And Jonah began to go into the city a journey of one day, and he cried out and said, “Forty more days and Nineveh will be demolished!”"
        },
        {
          "verse": 5,
          "usfm": "JON.3.5",
          "line_type": "p",
          "text": "And the people of Nineveh believed in God, and they proclaimed a fast and put on sackcloth—from the greatest of them to the least important."
        },
        {
          "verse": 6,
          "usfm": "JON.3.6",
          "line_type": "p",
          "text": "And the news reached the king of Nineveh, and he rose from his throne and removed his royal robe, put on sackcloth, and sat in the ashes."
        },
        {
          "verse": 7,
          "usfm": "JON.3.7",
          "line_type": "p",
          "text": "And he had a proclamation made, and said, “In Nineveh, by a decree of the king and his nobles: “No human being or animal, no herd or flock, shall taste anything! They must not eat, and they must not drink water!"
        },
        {
          "verse": 8,
          "usfm": "JON.3.8",
          "line_type": "p",
          "text": "And the human beings and the animals must be covered with sackcloth! And they must call forcefully to God, and each must turn from his evil way and from the violence that is in his hands."
        },
        {
          "verse": 9,
          "usfm": "JON.3.9",
          "line_type": "p",
          "text": "Who knows? God may relent and change his mind and turn from his blazing anger so that we will not perish.”"
        },
        {
          "verse": 10,
          "usfm": "JON.3.10",
          "line_type": "p",
          "text": "And God saw their deeds—that they turned from their evil ways—and God changed his mind about the evil that he had said he would bring upon them, and he did not do it."
        }
      ],
      "verse_count": 10,
      "headings": [
        {
          "before_verse": 6,
          "text": "The King’s Proclamation"
        }
      ],
      "footnotes": [
        {
          "verse": 3,
          "usfm": "JON.3.3",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "Or “set out”"
        },
        {
          "verse": 3,
          "usfm": "JON.3.3",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "Literally “a great city to God” or “a great city to the gods,” a disputed phrase which may refer to God’s estimate or ownership of Nineveh, to the presence of many idols, or an idiom referring to the size of Nineveh (this translation takes the last view)"
        },
        {
          "verse": 3,
          "usfm": "JON.3.3",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "This phrase may also refer to a journey on which business was done, so that “three days” is the total elapsed time"
        },
        {
          "verse": 4,
          "usfm": "JON.3.4",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "Or “overthrown”"
        },
        {
          "verse": 5,
          "usfm": "JON.3.5",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "Literally “to the smallest of them”"
        },
        {
          "verse": 8,
          "usfm": "JON.3.8",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "Hebrew “their”"
        },
        {
          "verse": 9,
          "usfm": "JON.3.9",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "Literally “from the heat of his anger”"
        },
        {
