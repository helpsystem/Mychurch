  "chapters": [
    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 1,
      "chapter_usfm": "JON.1",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.1.1",
          "line_type": "p",
          "text": "And the word of Yahweh came to Jonah the son of Amittai, saying,"
        },
        {
          "verse": 2,
          "usfm": "JON.1.2",
          "line_type": "p",
          "text": "“Get up! Go to the great city Nineveh and cry out against her, because their evil has come up before me.”"
        },
        {
          "verse": 3,
          "usfm": "JON.1.3",
          "line_type": "p",
          "text": "But Jonah set out to flee toward Tarshish from the presence of Yahweh. And he went down to Joppa and found a merchant ship going to Tarshish, and paid her fare, and went on board her to go with them toward Tarshish from the presence of Yahweh."
        },
        {
          "verse": 4,
          "usfm": "JON.1.4",
          "line_type": "p",
          "text": "And Yahweh hurled a great wind upon the sea, and it was a great storm on the sea, and the merchant ship was in danger of breaking up."
        },
        {
          "verse": 5,
          "usfm": "JON.1.5",
          "line_type": "p",
          "text": "And the mariners were afraid, and each cried out to his god. And they threw the contents that were in the merchant ship into the sea to lighten it for them. And meanwhile Jonah went down into the hold of the vessel and lay down and fell asleep."
        },
        {
          "verse": 6,
          "usfm": "JON.1.6",
          "line_type": "p",
          "text": "And the captain of the ship approached him and said to him, “Why are you sound asleep? Get up! Call on your god! Perhaps your god will take notice of us and we won’t perish!”"
        },
        {
          "verse": 7,
          "usfm": "JON.1.7",
          "line_type": "p",
          "text": "And they said to one another, “Come, let us cast lots so that we may know on whose account this disaster has come on us!” And they cast lots, and the lot fell on Jonah."
        },
        {
          "verse": 8,
          "usfm": "JON.1.8",
          "line_type": "p",
          "text": "So they said to him, “Please tell us whoever is responsible that this disaster has come upon us! What is your occupation? And from where do you come? What is your country? And from which people are you?”"
        },
        {
          "verse": 9,
          "usfm": "JON.1.9",
          "line_type": "p",
          "text": "And he said to them, “I am a Hebrew, and I fear Yahweh, the God of heaven, who made the sea and the dry land.”"
        },
        {
          "verse": 10,
          "usfm": "JON.1.10",
          "line_type": "p",
          "text": "Then the men were greatly afraid, and they said to him, “What is this you have done?” because they knew that he was fleeing from the presence of Yahweh (because he had told them)."
        },
        {
          "verse": 11,
          "usfm": "JON.1.11",
          "line_type": "p",
          "text": "So they said to him, “What shall we do to you so that the sea may quiet down for us?” because the sea was growing more and more tempestuous."
        },
        {
          "verse": 12,
          "usfm": "JON.1.12",
          "line_type": "p",
          "text": "And he said to them, “Pick me up and hurl me into the sea so that the sea may quiet down for you, because I know that on account of me this great storm has come upon you all.”"
        },
        {
          "verse": 13,
          "usfm": "JON.1.13",
          "line_type": "p",
          "text": "But the men rowed hard to bring the ship back to the dry land, and they could not do so because the sea was growing more and more tempestuous against them."
        },
        {
          "verse": 14,
          "usfm": "JON.1.14",
          "line_type": "p",
          "text": "So they cried out to Yahweh, and they said, “O Yahweh! Please do not let us perish because of this man’s life, and do not make us guilty of innocent blood, because you, O Yahweh, did what you wanted.”"
        },
        {
          "verse": 15,
          "usfm": "JON.1.15",
          "line_type": "p",
          "text": "And they picked Jonah up and hurled him into the sea, and the sea ceased from its raging."
        },
        {
          "verse": 16,
          "usfm": "JON.1.16",
          "line_type": "p",
          "text": "So the men feared Yahweh greatly, and they offered a sacrifice to Yahweh and made vows."
        },
        {
          "verse": 17,
          "usfm": "JON.1.17",
          "line_type": "p",
          "text": "And Yahweh provided a large fish to swallow up Jonah, and Jonah was in the belly of the fish three days and three nights."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 17,
          "text": "Jonah Is Swallowed by a Fish and Prays to Yahweh"
        }
      ],
