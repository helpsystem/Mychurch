          "usfm": "JON.2.4",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "Literally “on the temple of your holiness”"
        },
        {
          "verse": 7,
          "usfm": "JON.2.7",
          "note_ref": "",
