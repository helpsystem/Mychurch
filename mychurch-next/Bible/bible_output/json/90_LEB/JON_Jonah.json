    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 2,
      "chapter_usfm": "JON.2",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.2.1",
          "line_type": "p",
          "text": "And Jonah prayed to Yahweh his God from the belly of the fish"
        },
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "line_type": "p",
          "text": "and said, “I called from my distress to Yahweh, and he answered me; from the belly of Sheol I cried for help— you heard my voice."
        },
        {
          "verse": 3,
          "usfm": "JON.2.3",
          "line_type": null,
          "text": "And you threw me into the deep, into the heart of the seas, and the sea currents surrounded me; all your breakers and your surging waves passed over me."
        },
        {
          "verse": 4,
          "usfm": "JON.2.4",
          "line_type": null,
          "text": "And I said, ‘I am banished from your sight; how will I continue to look on your holy temple?’"
        },
        {
          "verse": 5,
          "usfm": "JON.2.5",
          "line_type": null,
          "text": "The waters encompassed me up to my neck; the deep surrounded me; seaweed was wrapped around my head."
        },
        {
          "verse": 6,
          "usfm": "JON.2.6",
          "line_type": null,
          "text": "I went down to the foundations of the mountains; the Underworld—its bars were around me forever. But you brought up my life from the pit, Yahweh my God."
        },
        {
          "verse": 7,
          "usfm": "JON.2.7",
          "line_type": null,
          "text": "When my life was ebbing away from me, I remembered Yahweh, and my prayer came to you, to your holy temple."
        },
        {
          "verse": 8,
          "usfm": "JON.2.8",
          "line_type": null,
          "text": "Those who worship vain idols forsake their loyal love."
        },
        {
          "verse": 9,
          "usfm": "JON.2.9",
          "line_type": null,
          "text": "But I, with a voice of thanksgiving, will sacrifice to you; I will fulfill what I have vowed. Deliverance belongs to Yahweh!”"
        },
        {
          "verse": 10,
          "usfm": "JON.2.10",
          "line_type": "p",
          "text": "And Yahweh spoke to the fish, and it vomited Jonah out on the dry land."
        }
      ],
      "verse_count": 10,
      "headings": [],
      "footnotes": [
        {
