      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.1.1",
          "line_type": "p",
          "text": "Paul and Silvanus and Timothy, to the church of the Thessalonians in God the Father and the Lord Jesus Christ. Grace to you and peace."
        },
        {
          "verse": 2,
          "usfm": "1TH.1.2",
          "line_type": "p",
          "text": "We give thanks to God always concerning all of you, making mention constantly in our prayers,"
        },
        {
          "verse": 3,
          "usfm": "1TH.1.3",
          "line_type": "p",
          "text": "because we remember your work of faith and labor of love and steadfastness of hope in our Lord Jesus Christ in the presence of our God and Father,"
        },
        {
          "verse": 4,
          "usfm": "1TH.1.4",
          "line_type": "p",
          "text": "knowing, brothers dearly loved by God, that he has chosen you,"
        },
        {
          "verse": 5,
          "usfm": "1TH.1.5",
          "line_type": "p",
          "text": "because our gospel did not come to you with word only, but also with power and with the Holy Spirit and with much certainty, just as you know what sort of people we became among you for your sake."
        },
        {
          "verse": 6,
          "usfm": "1TH.1.6",
          "line_type": "p",
          "text": "And you became imitators of us and of the Lord, receiving the word in much affliction, with the joy of the Holy Spirit,"
        },
        {
          "verse": 7,
          "usfm": "1TH.1.7",
          "line_type": "p",
          "text": "so that you became an example to all those who believe in Macedonia and in Achaia,"
        },
        {
          "verse": 8,
          "usfm": "1TH.1.8",
          "line_type": "p",
          "text": "for from you the word of the Lord has sounded forth, not only in Macedonia and Achaia, but in every place your faith toward God has gone out, so that we have no need to say anything."
        },
        {
          "verse": 9,
          "usfm": "1TH.1.9",
          "line_type": "p",
          "text": "For they themselves report about us, what sort of welcome we had with you, and how you turned to God from idols to serve the living and true God,"
        },
        {
          "verse": 10,
          "usfm": "1TH.1.10",
          "line_type": "p",
          "text": "and to await his Son from heaven, whom he raised from the dead, Jesus, the one who delivers us from the coming wrath."
        }
      ],
      "verse_count": 10,
      "headings": [
        {
          "before_verse": 2,
          "text": "Thanksgiving for the Thessalonian Believers"
        }
      ],
      "footnotes": [
        {
