    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 4,
      "chapter_usfm": "2TI.4",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.4.1",
          "line_type": "p",
          "text": "I solemnly charge you before God and Christ Jesus, who is going to judge the living and the dead, and by his appearing and his kingdom,"
        },
        {
          "verse": 2,
          "usfm": "2TI.4.2",
          "line_type": "p",
          "text": "preach the word, be ready in season and out of season, reprove, rebuke, exhort, with all patience and instruction."
        },
        {
          "verse": 3,
          "usfm": "2TI.4.3",
          "line_type": "p",
          "text": "For there will be a time when they will not put up with sound teaching, but in accordance with their own desires, they will accumulate for themselves teachers, because they have an insatiable curiosity,"
        },
        {
          "verse": 4,
          "usfm": "2TI.4.4",
          "line_type": "p",
          "text": "and they will turn away from the hearing of the truth, but will turn to myths."
        },
        {
          "verse": 5,
          "usfm": "2TI.4.5",
          "line_type": "p",
          "text": "But you, be self-controlled in all things, bear hardship patiently, do the work of an evangelist, fulfill your ministry."
        },
        {
          "verse": 6,
          "usfm": "2TI.4.6",
          "line_type": "p",
          "text": "For I am already being poured out as a drink offering, and the time of my departure is imminent."
        },
        {
          "verse": 7,
          "usfm": "2TI.4.7",
          "line_type": "p",
          "text": "I have fought the good fight, I have completed the race, I have kept the faith."
        },
        {
          "verse": 8,
          "usfm": "2TI.4.8",
          "line_type": "p",
          "text": "Finally, the crown of righteousness is reserved for me, that the Lord, the righteous Judge, will award to me on that day, and not only to me, but also to all who have loved his appearing."
        },
        {
          "verse": 9,
          "usfm": "2TI.4.9",
          "line_type": "p",
          "text": "Make haste to come to me quickly."
        },
        {
          "verse": 10,
          "usfm": "2TI.4.10",
          "line_type": "p",
          "text": "For Demas deserted me, because he loved the present age, and went to Thessalonica. Crescens went to Galatia; Titus went to Dalmatia."
        },
        {
          "verse": 11,
          "usfm": "2TI.4.11",
          "line_type": "p",
          "text": "Luke alone is with me. Take along Mark and bring him with you, because he is useful to me for ministry."
        },
        {
          "verse": 12,
          "usfm": "2TI.4.12",
          "line_type": "p",
          "text": "But I have sent Tychicus to Ephesus."
        },
        {
          "verse": 13,
          "usfm": "2TI.4.13",
          "line_type": "p",
          "text": "When you come, bring the cloak that I left behind in Troas with Carpus, and the scrolls, especially the parchments."
        },
        {
          "verse": 14,
          "usfm": "2TI.4.14",
          "line_type": "p",
          "text": "Alexander the metalworker did me much harm; may the Lord pay back to him according to his deeds,"
        },
        {
          "verse": 15,
          "usfm": "2TI.4.15",
          "line_type": "p",
          "text": "against whom you also be on guard, because he vehemently opposed our words."
        },
        {
          "verse": 16,
          "usfm": "2TI.4.16",
          "line_type": "p",
          "text": "At my first defense, no one came to my aid, but they all deserted me; may it not be counted against them."
        },
        {
          "verse": 17,
          "usfm": "2TI.4.17",
          "line_type": "p",
          "text": "But the Lord helped me and strengthened me, so that through me the proclamation might be fulfilled and all the Gentiles might hear, and he rescued me from the lion’s mouth."
        },
        {
          "verse": 18,
          "usfm": "2TI.4.18",
          "line_type": "p",
          "text": "The Lord will rescue me from every evil deed, and will save me for his heavenly kingdom, to whom be the glory forever and ever. Amen."
        },
        {
          "verse": 19,
          "usfm": "2TI.4.19",
          "line_type": "p",
          "text": "Greet Prisca and Aquila and the household of Onesiphorus."
        },
        {
          "verse": 20,
          "usfm": "2TI.4.20",
          "line_type": "p",
          "text": "Erastus remained in Corinth, but Trophimus I left behind in Miletus because he was sick."
        },
        {
          "verse": 21,
          "usfm": "2TI.4.21",
          "line_type": "p",
          "text": "Make haste to come before winter. Eubulus and Pudens and Linus and Claudia and all the brothers greet you."
        },
        {
          "verse": 22,
          "usfm": "2TI.4.22",
          "line_type": "p",
          "text": "The Lord be with your spirit. Grace be with you."
        }
      ],
      "verse_count": 22,
      "headings": [
        {
          "before_verse": 9,
          "text": "Final Instructions to Timothy"
        },
        {
          "before_verse": 19,
          "text": "Final Greetings and Benediction"
        }
      ],
