      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 1,
      "chapter_usfm": "2TI.1",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.1.1",
          "line_type": "p",
          "text": "Paul, an apostle of Christ Jesus through the will of God, according to the promise of life which is in Christ Jesus,"
        },
        {
          "verse": 2,
          "usfm": "2TI.1.2",
          "line_type": "p",
          "text": "to Timothy, my dear child. Grace, mercy, and peace from God the Father and Christ Jesus our Lord."
        },
        {
          "verse": 3,
          "usfm": "2TI.1.3",
          "line_type": "p",
          "text": "I am thankful to God, whom I have served with a clear conscience as my ancestors did, when I remember you constantly in my prayers night and day,"
        },
        {
          "verse": 4,
          "usfm": "2TI.1.4",
          "line_type": "p",
          "text": "longing to see you as I remember your tears, so that I may be filled with joy,"
        },
        {
          "verse": 5,
          "usfm": "2TI.1.5",
          "line_type": "p",
          "text": "remembering the sincere faith in you, which lived first in your grandmother Lois and your mother Eunice, and I am convinced that is in you also,"
        },
        {
          "verse": 6,
          "usfm": "2TI.1.6",
          "line_type": "p",
          "text": "for which reason I remind you to rekindle the gift of God that is in you through the laying on of my hands."
        },
        {
          "verse": 7,
          "usfm": "2TI.1.7",
          "line_type": "p",
          "text": "For God has not given us a spirit of cowardice, but of power and love and self-discipline."
        },
        {
          "verse": 8,
          "usfm": "2TI.1.8",
          "line_type": "p",
          "text": "Therefore, do not be ashamed of the testimony about our Lord, nor me his prisoner, but suffer along with me for the gospel, according to the power of God,"
        },
        {
          "verse": 9,
          "usfm": "2TI.1.9",
          "line_type": "p",
          "text": "who saved us and called us with a holy calling, not according to our works but according to his own purpose and grace that was given to us in Christ Jesus before time began,"
        },
        {
          "verse": 10,
          "usfm": "2TI.1.10",
          "line_type": "p",
          "text": "but has now been disclosed by the appearing of our Savior Jesus Christ, who has abolished death and brought to light life and immortality through the gospel,"
        },
        {
          "verse": 11,
          "usfm": "2TI.1.11",
          "line_type": "p",
          "text": "for which I was appointed a proclaimer and an apostle and a teacher,"
        },
        {
          "verse": 12,
          "usfm": "2TI.1.12",
          "line_type": "p",
          "text": "for which reason also I suffer these things. But I am not ashamed, because I know in whom I have believed, and I am convinced that he is able to guard what I have entrusted until that day."
        },
        {
          "verse": 13,
          "usfm": "2TI.1.13",
          "line_type": "p",
          "text": "Hold fast to the pattern of sound words which you heard from me, in the faith and love that are in Christ Jesus."
        },
        {
          "verse": 14,
          "usfm": "2TI.1.14",
          "line_type": "p",
          "text": "Guard the good deposit through the Holy Spirit who lives in us."
        },
        {
          "verse": 15,
          "usfm": "2TI.1.15",
          "line_type": "p",
          "text": "You know this, that all those in Asia turned away from me, among whom are Phygelus and Hermogenes."
        },
        {
          "verse": 16,
          "usfm": "2TI.1.16",
          "line_type": "p",
          "text": "May the Lord grant mercy to the household of Onesiphorus, because he refreshed me many times, and was not ashamed of my imprisonment,"
        },
        {
          "verse": 17,
          "usfm": "2TI.1.17",
          "line_type": "p",
          "text": "but when he was in Rome, he diligently sought me and found me."
        },
        {
          "verse": 18,
          "usfm": "2TI.1.18",
          "line_type": "p",
          "text": "May the Lord grant him to find mercy from the Lord in that day! And how much he served me in Ephesus you know very well."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 3,
          "text": "Timothy’s Spiritual Heritage"
        },
        {
          "before_verse": 8,
          "text": "Exhortation to Share Paul’s Suffering"
        }
      ],
