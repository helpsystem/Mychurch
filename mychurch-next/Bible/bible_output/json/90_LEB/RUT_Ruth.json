    {
      "schema_version": 6,
      "book_id": "RUT",
      "chapter": 3,
      "chapter_usfm": "RUT.3",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "RUT.3.1",
          "line_type": "p",
          "text": "Now Naomi her mother-in-law said to her, “My daughter, should I not seek for you security that things may be good for you?"
        },
        {
          "verse": 2,
          "usfm": "RUT.3.2",
          "line_type": "p",
          "text": "So then, is not Boaz our kinsman whose maidservants you were with? Look, he is winnowing the barley at the threshing floor tonight."
        },
        {
          "verse": 3,
          "usfm": "RUT.3.3",
          "line_type": "p",
          "text": "Wash, anoint yourself, put your clothing on, and go down to the threshing floor. Do not make yourself known to the man until he finishes eating and drinking."
        },
        {
          "verse": 4,
          "usfm": "RUT.3.4",
          "line_type": "p",
          "text": "And when he lies, take notice of the place where he lies. And you shall go and uncover his feet and lie down, and he shall tell you what to do.”"
        },
        {
          "verse": 5,
          "usfm": "RUT.3.5",
          "line_type": "p",
          "text": "And she said to her, “I will do all that you say.”"
        },
        {
          "verse": 6,
          "usfm": "RUT.3.6",
          "line_type": "p",
          "text": "And she went down to the threshing floor and did all that her mother-in-law had instructed her."
        },
        {
          "verse": 7,
          "usfm": "RUT.3.7",
          "line_type": "p",
          "text": "And Boaz ate and drank until his heart was merry and then he came to lie at the end of the grain heap. And she came in quietly and uncovered his feet and lay down."
        },
        {
          "verse": 8,
          "usfm": "RUT.3.8",
          "line_type": "p",
          "text": "And it happened in the middle of the night the man was startled and he reached out and behold, a woman was lying at his feet."
        },
        {
          "verse": 9,
          "usfm": "RUT.3.9",
          "line_type": "p",
          "text": "And he said, “Who are you?” And she said, “I am Ruth, your servant. Spread your garment over your servant because you are a redeemer.”"
        },
        {
          "verse": 10,
          "usfm": "RUT.3.10",
          "line_type": "p",
          "text": "And he said, “You are blessed by Yahweh my daughter. You did better in this last kindness than the first by not going after young men, whether poor or rich."
        },
        {
          "verse": 11,
          "usfm": "RUT.3.11",
          "line_type": "p",
          "text": "And so then my daughter, do not be afraid. All that you ask I will do for you, for the entire assembly of my people knows that you are a worthy woman."
        },
        {
          "verse": 12,
          "usfm": "RUT.3.12",
          "line_type": "p",
          "text": "Now truly I am a redeemer, but there is also a redeemer of a closer relationship than me."
        },
        {
          "verse": 13,
          "usfm": "RUT.3.13",
          "line_type": "p",
          "text": "Stay tonight, and in the morning, if he wants to redeem you, good; but if he is not willing to redeem, then as Yahweh lives, I will redeem you. Lie down until the morning.”"
        },
        {
          "verse": 14,
          "usfm": "RUT.3.14",
          "line_type": "p",
          "text": "So she lay at his feet until morning and got up before anyone could recognize each other. And he said, “It must not be known that you came to the threshing floor.”"
        },
        {
          "verse": 15,
          "usfm": "RUT.3.15",
          "line_type": "p",
          "text": "And he said, “Bring the cloak that is on you and hold it out.” And she held it out and he measured six measures of barley and put it on her cloak. Then she went into the city."
        },
        {
          "verse": 16,
          "usfm": "RUT.3.16",
          "line_type": "p",
          "text": "And she came to her mother-in-law, and she said, “How did it go for you, my daughter?” And she told her all that the man did for her."
        },
        {
          "verse": 17,
          "usfm": "RUT.3.17",
          "line_type": "p",
          "text": "And she said, “These six measures of barley he gave to me, for he said, ‘You shall not go empty-handed to your mother-in-law.’ ”"
        },
        {
          "verse": 18,
          "usfm": "RUT.3.18",
          "line_type": "p",
          "text": "And she said, “Wait, my daughter, until you know how the matter turns out, for the man will not rest but will settle the matter today.”"
        }
      ],
