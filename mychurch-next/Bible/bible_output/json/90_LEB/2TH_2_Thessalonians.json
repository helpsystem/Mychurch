    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 2,
      "chapter_usfm": "2TH.2",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.2.1",
          "line_type": "p",
          "text": "Now we ask you, brothers, concerning the coming of our Lord Jesus Christ and our assembling to him,"
        },
        {
          "verse": 2,
          "usfm": "2TH.2.2",
          "line_type": "p",
          "text": "that you not be easily shaken from your composure, nor be troubled either by a spirit or by a message or by a letter alleged to be from us, to the effect that the day of the Lord has arrived."
        },
        {
          "verse": 3,
          "usfm": "2TH.2.3",
          "line_type": "p",
          "text": "Do not let anyone deceive you in any way, for that day will not come unless the rebellion comes first, and the man of lawlessness is revealed, the son of destruction,"
        },
        {
          "verse": 4,
          "usfm": "2TH.2.4",
          "line_type": "p",
          "text": "who opposes and who exalts himself over every so-called god or object of worship, so that he sits down in the temple of God, proclaiming that he himself is God."
        },
        {
          "verse": 5,
          "usfm": "2TH.2.5",
          "line_type": "p",
          "text": "Do you not remember that while we were still with you, we were saying these things to you?"
        },
        {
          "verse": 6,
          "usfm": "2TH.2.6",
          "line_type": "p",
          "text": "And you know that which restrains him now, so that he will be revealed in his own time."
        },
        {
          "verse": 7,
          "usfm": "2TH.2.7",
          "line_type": "p",
          "text": "For the mystery of lawlessness is at work already; only the one who now restrains will do so until he is out of the way,"
        },
        {
          "verse": 8,
          "usfm": "2TH.2.8",
          "line_type": "p",
          "text": "and then the lawless one will be revealed, whom the Lord Jesus will slay with the breath of his mouth, and wipe out by the appearance of his coming,"
        },
        {
          "verse": 9,
          "usfm": "2TH.2.9",
          "line_type": "p",
          "text": "whose coming is in accordance with the working of Satan, with all power and signs and lying wonders,"
        },
        {
          "verse": 10,
          "usfm": "2TH.2.10",
          "line_type": "p",
          "text": "and with every unrighteous deception against those who are perishing, in place of which they did not accept the love of the truth, so that they would be saved."
        },
        {
          "verse": 11,
          "usfm": "2TH.2.11",
          "line_type": "p",
          "text": "And because of this, God sends them a powerful delusion so that they will believe the lie,"
        },
        {
          "verse": 12,
          "usfm": "2TH.2.12",
          "line_type": "p",
          "text": "in order that all may be condemned who did not believe the truth, but delighted in unrighteousness."
        },
        {
          "verse": 13,
          "usfm": "2TH.2.13",
          "line_type": "p",
          "text": "But we ought to give thanks to God always concerning you, brothers dearly loved by the Lord, because God has chosen you as first fruits for salvation by the sanctification of the Spirit and faith in the truth,"
        },
        {
          "verse": 14,
          "usfm": "2TH.2.14",
          "line_type": "p",
          "text": "for which purpose he called you through our gospel for the obtaining of the glory of our Lord Jesus Christ."
        },
        {
          "verse": 15,
          "usfm": "2TH.2.15",
          "line_type": "p",
          "text": "So then, brothers, stand firm and hold fast to the traditions which you were taught, whether by spoken word or by letter from us."
        },
        {
          "verse": 16,
          "usfm": "2TH.2.16",
          "line_type": "p",
          "text": "Now may our Lord Jesus Christ himself and God our Father, who has loved us and given us eternal encouragement and good hope by grace,"
        },
        {
          "verse": 17,
          "usfm": "2TH.2.17",
          "line_type": "p",
          "text": "encourage your hearts and strengthen you in every good work and word."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 13,
          "text": "Stand Firm and Hold Fast"
        }
      ],
      "footnotes": [
        {
          "verse": 2,
          "usfm": "2TH.2.2",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "Literally “as if by us”"
        },
        {
          "verse": 5,
          "usfm": "2TH.2.5",
          "note_ref": "",
