  "chapters": [
    {
      "schema_version": 6,
      "book_id": "NAM",
      "chapter": 1,
      "chapter_usfm": "NAM.1",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "NAM.1.1",
          "line_type": null,
          "text": "The oracle concerning Nineveh— the scroll of the vision of Nahum the Elkoshite:"
        },
        {
          "verse": 2,
          "usfm": "NAM.1.2",
          "line_type": null,
          "text": "Yahweh is a jealous God and avenging; Yahweh is avenging and full of wrath. Yahweh takes vengeance against his enemies; he rages against his adversaries."
        },
        {
          "verse": 3,
          "usfm": "NAM.1.3",
          "line_type": null,
          "text": "Yahweh is slow to anger but great in power; he will certainly not allow the guilty to go unpunished. He marches in storm wind and in gale; storm clouds are the dust of his feet."
        },
        {
          "verse": 4,
          "usfm": "NAM.1.4",
          "line_type": null,
          "text": "He rebukes the sea and he dries up the rivers; he makes all the rivers run dry. Bashan and Carmel wither; the blossom of Lebanon languishes."
        },
        {
          "verse": 5,
          "usfm": "NAM.1.5",
          "line_type": null,
          "text": "Mountains quake before him; the hills shake apart. The earth heaves before him— the world and all her inhabitants."
        },
        {
          "verse": 6,
          "usfm": "NAM.1.6",
          "line_type": null,
          "text": "His indignation—who can stand before it? Who can endure his fierce anger? His wrath is poured out like fire; rocks are shattered before him."
        },
        {
          "verse": 7,
          "usfm": "NAM.1.7",
          "line_type": null,
          "text": "Yahweh is good—a refuge in the day of distress; he knows those who take refuge in him."
        },
        {
          "verse": 8,
          "usfm": "NAM.1.8",
          "line_type": null,
          "text": "But with a rushing torrent he will bring Nineveh to an end; he will chase his enemies into darkness."
        },
        {
          "verse": 9,
          "usfm": "NAM.1.9",
          "line_type": null,
          "text": "What do you plot against Yahweh? He will completely destroy it; trouble will not rise up a second time!"
        },
        {
          "verse": 10,
          "usfm": "NAM.1.10",
          "line_type": null,
          "text": "For like entangled thorns, and like their drink which is drunk, they will be consumed like fully dry chaff."
        },
        {
          "verse": 11,
          "usfm": "NAM.1.11",
          "line_type": null,
          "text": "From you goes out one who plots evil against Yahweh, one who plans wickedness."
        },
        {
          "verse": 12,
          "usfm": "NAM.1.12",
          "line_type": "p",
          "text": "Yahweh says this: “Even though they are powerful and likewise many, even so they will be cut off and pass away. Though I have afflicted you, I will afflict you no longer."
        },
        {
          "verse": 13,
          "usfm": "NAM.1.13",
          "line_type": null,
          "text": "And now, I will break his yoke from upon you; I will snap your bonds.”"
        },
        {
          "verse": 14,
          "usfm": "NAM.1.14",
          "line_type": "p",
          "text": "Yahweh has commanded concerning you: “Your name will no longer be sown. I will cut off the idols and images from the temple of your gods; I will send you to the grave because you are worthless.”"
        },
        {
          "verse": 15,
          "usfm": "NAM.1.15",
          "line_type": null,
          "text": "Look! On the mountains! The feet of the one who brings good tidings, the one who proclaims peace! “Celebrate a festival, O Judah, Fulfill your vows! For he will not invade you again; the wicked one is cut off completely!”"
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 2,
          "text": "Half-Acrostic: Yahweh Takes Vengeance against His Enemies"
        },
        {
          "before_verse": 9,
          "text": "Yahweh Will Destroy Nineveh"
        },
        {
          "before_verse": 12,
          "text": "Yahweh Will Deliver Judah and Destroy Nineveh"
        }
      ],
      "footnotes": [
