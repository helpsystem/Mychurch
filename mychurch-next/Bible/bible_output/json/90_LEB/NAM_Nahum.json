    {
      "schema_version": 6,
      "book_id": "NAM",
      "chapter": 2,
      "chapter_usfm": "NAM.2",
      "version_id": 90,
      "version_abbr": "LEB",
      "verses": [
        {
          "verse": 1,
          "usfm": "NAM.2.1",
          "line_type": null,
          "text": "One who shatters has come up against you! Guard the fortification! Watch the road! Gird your loins! Muster all your strength!"
        },
        {
          "verse": 2,
          "usfm": "NAM.2.2",
          "line_type": null,
          "text": "For Yahweh will restore the majesty of Jacob like the majesty of Israel; for ravagers have ravaged them and ruined their branches."
        },
        {
          "verse": 3,
          "usfm": "NAM.2.3",
          "line_type": null,
          "text": "The shields of his warriors are dyed red; The powerful men are dressed in scarlet. The metal of the chariots shines like fire on the day of battle, and their spears quiver."
        },
        {
          "verse": 4,
          "usfm": "NAM.2.4",
          "line_type": null,
          "text": "The chariots race madly through the streets; they rush back and forth in the public squares. Their appearance like lightning bolts, they dart about like flashes of lightning."
        },
        {
          "verse": 5,
          "usfm": "NAM.2.5",
          "line_type": null,
          "text": "He calls his officers; they stumble as they march; they rush to her wall; they set the covering in place."
        },
        {
          "verse": 6,
          "usfm": "NAM.2.6",
          "line_type": null,
          "text": "The gates of the river are opened; the palace trembles."
        },
        {
          "verse": 7,
          "usfm": "NAM.2.7",
          "line_type": null,
          "text": "Her goddess is taken out and taken into exile; her maidservants moan like doves; they beat on their breasts."
        },
        {
          "verse": 8,
          "usfm": "NAM.2.8",
          "line_type": null,
          "text": "Nineveh is like a pool of water without its water. As they flee, she cries, “Stop! Stop!” But there is no one who turns back."
        },
        {
          "verse": 9,
          "usfm": "NAM.2.9",
          "line_type": null,
          "text": "Plunder the silver! Plunder the gold! There is no end to the spoils, an abundance of everything one could want!"
        },
        {
          "verse": 10,
          "usfm": "NAM.2.10",
          "line_type": null,
          "text": "Emptiness and plundering and devastation! Their hearts faint and their knees tremble, All their loins shake and all their faces turn pale."
        },
        {
          "verse": 11,
          "usfm": "NAM.2.11",
          "line_type": null,
          "text": "Where now is the den of the lions and the cave of the fierce lions? There the lioness, the cub, and the lion once prowled, and no one disturbed them."
        },
        {
          "verse": 12,
          "usfm": "NAM.2.12",
          "line_type": null,
          "text": "The lion tore apart enough prey for his cubs, he strangled prey for his lioness; he filled his lair with prey and his den with mangled carcass."
        },
        {
          "verse": 13,
          "usfm": "NAM.2.13",
          "line_type": null,
          "text": "“Look! I am against you!” declares Yahweh of hosts. “I will burn her chariots with fire; the sword will devour fierce lions. I will cut off your prey from the earth; the voice of your messengers will no longer be heard.”"
        }
      ],
      "verse_count": 13,
      "headings": [
        {
          "before_verse": 3,
          "text": "The Enemy Army Conquers the City of Nineveh"
        },
        {
          "before_verse": 11,
          "text": "The Divine Warrior Will Hunt down the Mighty Lions"
        }
      ],
