  "chapters": [
    {
      "schema_version": 6,
      "book_id": "3JN",
      "chapter": 1,
      "chapter_usfm": "3JN.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "3JN.1.1",
          "line_type": "p",
          "text": "از طرف شیخ کلیسا به «غایوس» عزیز که واقعاً دوستش دارم."
        },
        {
          "verse": 2,
          "usfm": "3JN.1.2",
          "line_type": "p",
          "text": "ای عزیز، دعا می‌کنم که از هر جهت کامیاب باشی و همان‌طور که از سلامتی روح برخورداری، جان تو نیز سلامت باشد."
        },
        {
          "verse": 3,
          "usfm": "3JN.1.3",
          "line_type": "p",
          "text": "وقتی بعضی از برادران به اینجا آمدند و به من خبر دادند که تو چقدر به حقیقت الهی وفادار هستی و بر‌ طبق حقیقت زندگی می‌کنی، بسیار شادمان شدم."
        },
        {
          "verse": 4,
          "usfm": "3JN.1.4",
          "line_type": "p",
          "text": "هیچ‌چیز مرا بیش از این امر خوشحال نمی‌سازد که بشنوم فرزندان من بر‌ طبق حقیقت رفتار می‌کنند."
        },
        {
          "verse": 5,
          "usfm": "3JN.1.5",
          "line_type": "p",
          "text": "ای عزیز، تو به برادران، مخصوصاً آنانی که نمی‌شناسی، صادقانه خدمت می‌کنی."
        },
        {
          "verse": 6,
          "usfm": "3JN.1.6",
          "line_type": "p",
          "text": "آن‌ها از محبّت تو در حضور کلیسا شهادت داده‌اند. اگر به‌طور خداپسندانه به آن‌ها کمک کنی تا به سفر خود ادامه دهند، کاری نیکو کرده‌ای،"
        },
        {
          "verse": 7,
          "usfm": "3JN.1.7",
          "line_type": "p",
          "text": "زیرا آن‌ها به‌خاطر خدمت به مسیح در سفر هستند و از غیر مسیحیان کمک قبول نمی‌کنند."
        },
        {
          "verse": 8,
          "usfm": "3JN.1.8",
          "line_type": "p",
          "text": "پس ما مسیحیان موظّفیم، با حمایت از چنین اشخاص در انتشار حقیقت همکاری کنیم."
        },
        {
          "verse": 9,
          "usfm": "3JN.1.9",
          "line_type": "p",
          "text": "من نامه‌ای مختصر به کلیسا نوشتم، امّا «دیوتْرِفِس» که همیشه دوست دارد خود را جلو بیندازد، سخنان ما را قبول نمی‌کند."
        },
        {
          "verse": 10,
          "usfm": "3JN.1.10",
          "line_type": "p",
          "text": "وقتی بیایم، تمام کارهایی را که او کرده و تمام اتّهامات بی‌اساس و نادرستی را که به ما زده است، مطرح خواهم کرد. او به این‌ کارها اکتفا نکرده، بلکه ایمان‌داران مسافر را نمی‌پذیرد و مانع می‌شود که دیگران نیز از آن‌ها پذیرایی کنند، و اگر بعضی‌ها چنین کنند، او آنان را از کلیسا بیرون می‌کند."
        },
        {
          "verse": 11,
          "usfm": "3JN.1.11",
          "line_type": "p",
          "text": "ای دوست عزیز، نیکویی را دنبال کن، نه بدی را. شخص نیکوکار فرزند خدا است؛ بدکار هرگز خدا را ندیده است."
        },
        {
          "verse": 12,
          "usfm": "3JN.1.12",
          "line_type": "p",
          "text": "همه از «دیمیتریوس» به نیکی سخن می‌گویند و حقیقت هم بر آن شهادت می‌دهد، و ما نیز گفتار آن‌ها را تأیید می‌کنیم و تو می‌دانی که شهادت ما قابل‌ اعتماد است."
        },
        {
          "verse": 13,
          "usfm": "3JN.1.13",
          "line_type": "p",
          "text": "مطالب زیادی هست که باید برای تو بنویسم، امّا نمی‌خواهم آن‌ را با قلم و مرکب روی کاغذ بیاورم."
        },
        {
          "verse": 14,
          "usfm": "3JN.1.14",
          "line_type": "p",
          "text": "امیدوارم تو را خیلی زود ببینم و روبه‌رو با هم صحبت کنیم."
        },
        {
          "verse": 15,
          "usfm": "3JN.1.15",
          "line_type": "p",
          "text": "صلح و آرامش بر تو باد. دوستانت سلام می‌رسانند، به یکایک دوستان ما سلام برسان."
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 5,
          "text": "همکاری و مخالفت"
        },
        {
          "before_verse": 13,
          "text": "خاتمه"
        }
      ],
      "footnotes": [
        {
