  "chapters": [
    {
      "schema_version": 6,
      "book_id": "NAM",
      "chapter": 1,
      "chapter_usfm": "NAM.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "NAM.1.1",
          "line_type": "p",
          "text": "خداوند این وحی را که در مورد نینوا بود، در رؤیا به ناحوم القوشی داد:"
        },
        {
          "verse": 2,
          "usfm": "NAM.1.2",
          "line_type": "q1",
          "text": "خداوند، خدای غیور و انتقام گیرنده است.او با‌ خشم و غضب انتقام می‌گیردو دشمنان خود را مجازات می‌کند."
        },
        {
          "verse": 3,
          "usfm": "NAM.1.3",
          "line_type": "q1",
          "text": "خداوند زود خشمگین نمی‌شود،امّا او قادر و توانا استو خطاکار را هرگز بی‌سزا نمی‌گذارد.قدرت خداوند را می‌توان در توفان و گردباد مشاهده کرد.ابرها خاک زیر پای او می‌باشند."
        },
        {
          "verse": 4,
          "usfm": "NAM.1.4",
          "line_type": "q1",
          "text": "به فرمان او رودها و دریاها خشک می‌شوند.کشتزارهای سرسبز باشان و کوه کَرمِل از بین می‌روندو گُل‌های لبنان پژمرده می‌گردند."
        },
        {
          "verse": 5,
          "usfm": "NAM.1.5",
          "line_type": "q1",
          "text": "در برابر او کو‌ه‌ها تکان می‌خورند،و تپّه‌ها هموار می‌شوند.جهان به لرزه می‌آید؛دنیا و ساکنینش به وحشت می‌افتند."
        },
        {
          "verse": 6,
          "usfm": "NAM.1.6",
          "line_type": "q1",
          "text": "کیست که بتواند در برابر خشم او مقاومت کند؟غضب او مثل آتش فرو می‌ریزدو صخره‌ها در برابر خشم او خُرد می‌شوند."
        },
        {
          "verse": 7,
          "usfm": "NAM.1.7",
          "line_type": "q1",
          "text": "خداوند نیکو استو در روز سختی و مصیبت از بندگان خود حمایت می‌کندو کسانی را که به او توکّل کنند، پناه می‌دهد."
        },
        {
          "verse": 8,
          "usfm": "NAM.1.8",
          "line_type": "q1",
          "text": "امّا با سیلابِ شدید خشم خود، دشمنان را نابود می‌سازد؛و مخالفین را به‌سوی دنیای تاریکی خواهد راند."
        },
        {
          "verse": 9,
          "usfm": "NAM.1.9",
          "line_type": "q1",
          "text": "چه نقشه‌ای بر ضد خداوند می‌توانید بکشید!او ناگهان شما را هلاک خواهد کرد،به‌طوری‌که نتوانید بار دیگر در مقابل او بایستید."
        },
        {
          "verse": 10,
          "usfm": "NAM.1.10",
          "line_type": "q1",
          "text": "دشمنان خداوند مانند خارهای به هم پیچیدهو کاه خشک در آتش خواهند سوخت و خاکستر خواهند شد."
        },
        {
          "verse": 11,
          "usfm": "NAM.1.11",
          "line_type": "p",
          "text": "از تو ای نینوا، شخصی پیدا شد که علیه خداوند توطئه کرد."
        },
        {
          "verse": 12,
          "usfm": "NAM.1.12",
          "line_type": "p",
          "text": "خداوند به قوم خود چنین می‌گوید: «لشکر آشور هرقدر نیرومند و زیاد باشد، شکست خورده نابود خواهند شد. من شما را به‌قدر کافی مجازات کرده‌ام، امّا دیگر این کار را نخواهم کرد."
        },
        {
          "verse": 13,
          "usfm": "NAM.1.13",
          "line_type": "p",
          "text": "اکنون یوغ بندگی را از گردنتان برخواهم داشت و شما را از قید اسارت آشوریان آزاد خواهم ساخت.»"
        },
        {
          "verse": 14,
          "usfm": "NAM.1.14",
          "line_type": "p",
          "text": "خداوند در مورد آشوریان می‌گوید: «نسلی به نام ایشان باقی نخواهد ماند. من بُت‌هایی را که در پرستشگاه‌های خدایان ایشان است، نابود خواهم کرد و قبر آشوریان را آماده خواهم نمود، زیرا سزاوار زندگی نیستند.»"
        },
        {
          "verse": 15,
          "usfm": "NAM.1.15",
          "line_type": "p",
          "text": "ببینید، قاصدی از فراز کو‌ه‌ها پایین می‌آید و مژدۀ پیروزی را اعلام می‌کند. ای مردم یهودا، عیدهای خود را برگزار کنید و نذرهای خود را ادا نمایید، زیرا مردم شریر آشور دیگر هرگز بر شما حمله نخواهند کرد. آن‌ها همگی نابود‌ شده‌اند."
        }
      ],
      "verse_count": 15,
