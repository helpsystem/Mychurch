    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 2,
      "chapter_usfm": "1TI.2",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.2.1",
          "line_type": "p",
          "text": "پس قبل از هر چیز تأکید می‌کنم که درخواست‌ها، دعاها، شفاعت‌ها و سپاس‌ها برای همۀ مردم،"
        },
        {
          "verse": 2,
          "usfm": "1TI.2.2",
          "line_type": "p",
          "text": "برای پادشاهان و همۀ اوّلیای امور به پیشگاه خداوند تقدیم گردد تا ما بتوانیم با آرامش و صلح و در کمال خداترسی و سرافرازی به سر بریم،"
        },
        {
          "verse": 3,
          "usfm": "1TI.2.3",
          "line_type": "p",
          "text": "زیرا انجام این‌ کار در حضور خدا، نجات‌دهندۀ ما، نیکو و پسندیده است."
        },
        {
          "verse": 4,
          "usfm": "1TI.2.4",
          "line_type": "p",
          "text": "او مایل است همۀ آدمیان نجات یابند و حقیقت را بشناسند،"
        },
        {
          "verse": 5,
          "usfm": "1TI.2.5",
          "line_type": "p",
          "text": "زیرا یک خدا وجود دارد و یک واسطه بین خدا و انسان، یعنی شخص عیسای مسیح"
        },
        {
          "verse": 6,
          "usfm": "1TI.2.6",
          "line_type": "p",
          "text": "که جان خود را به‌عنوان کفّاره در راه همه داد تا شهادتی در زمان مناسب بر این حقیقت باشد."
        },
        {
          "verse": 7,
          "usfm": "1TI.2.7",
          "line_type": "p",
          "text": "به‌خاطر این است که من به سِمَت گوینده و رسول و معلّم ملل در تعلیم ایمان و حقیقت منصوب شدم. حقیقت را بیان می‌کنم و دروغ نمی‌گویم."
        },
        {
          "verse": 8,
          "usfm": "1TI.2.8",
          "line_type": "p",
          "text": "آرزو دارم که مردها در همه‌جا بدون بحث و جدل دست‌های مقدّس خود را بلند کرده دعا نمایند."
        },
        {
          "verse": 9,
          "usfm": "1TI.2.9",
          "line_type": "p",
          "text": "من همچنین می‌خواهم زن‌ها، خود را به‌طور آبرومند و معقول و با لباس‌های مناسب بیارایند، نه با آرایش گیسوان و یا زیورهای طلا و جواهرات و لباس‌های گران‌قیمت،"
        },
        {
          "verse": 10,
          "usfm": "1TI.2.10",
          "line_type": "p",
          "text": "بلکه آن‌ها باید خود را با کارهای نیکو بیارایند، آن‌چنان‌که زیبندۀ زنانی است که ادّعای خداپرستی دارند."
        },
        {
          "verse": 11,
          "usfm": "1TI.2.11",
          "line_type": "p",
          "text": "زن‌ها باید در سکوت و کمال اطاعت تعلیم بگیرند."
        },
        {
          "verse": 12,
          "usfm": "1TI.2.12",
          "line_type": "p",
          "text": "من به هیچ زنی اجازه نمی‌دهم که تعلیم دهد و یا بر مرد حاکم باشد. او باید ساکت باشد."
        },
        {
          "verse": 13,
          "usfm": "1TI.2.13",
          "line_type": "p",
          "text": "زیرا اوّل «آدم» آفریده شد و بعد «حوا»."
        },
        {
          "verse": 14,
          "usfm": "1TI.2.14",
          "line_type": "p",
          "text": "و آدم نبود که فریب خورد، بلکه زن فریب خورد و قانون الهی را شکست."
        },
        {
          "verse": 15,
          "usfm": "1TI.2.15",
          "line_type": "p",
          "text": "امّا اگر زن‌ها با فروتنی در ایمان و محبّت و پاکی پایداری کنند، با آوردن فرزندان به این دنیا نجات خواهند یافت."
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 8,
          "text": "دربارۀ زن‌ها"
        }
      ],
      "footnotes": [
