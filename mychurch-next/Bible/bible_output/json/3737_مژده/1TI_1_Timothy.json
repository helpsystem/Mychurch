    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 3,
      "chapter_usfm": "1TI.3",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.3.1",
          "line_type": "p",
          "text": "این گفته درست است که اگر کسی مایل به سرپرستی در کلیسا است، در آرزوی کار بسیار خوبی می‌باشد."
        },
        {
          "verse": 2,
          "usfm": "1TI.3.2",
          "line_type": "p",
          "text": "سرپرست کلیسا باید مردی بی‌عیب، شوهر یک زن، خویشتن‌دار، هوشیار، منظّم، مهمان‌نواز و معلّمی توانا باشد."
        },
        {
          "verse": 3,
          "usfm": "1TI.3.3",
          "line_type": "p",
          "text": "او باید ملایم و صلح جو باشد، نه میگسار و جنگجو و پول‌پرست."
        },
        {
          "verse": 4,
          "usfm": "1TI.3.4",
          "line_type": "p",
          "text": "او باید خانوادۀ خود را به‌خوبی اداره کند و فرزندانش را طوری تربیت نماید که از او با احترام کامل اطاعت کنند،"
        },
        {
          "verse": 5,
          "usfm": "1TI.3.5",
          "line_type": "p",
          "text": "زیرا اگر مردی نتواند خانوادۀ خود را اداره کند، پس چگونه می‌تواند کلیسای خدا را سرپرستی نماید؟"
        },
        {
          "verse": 6,
          "usfm": "1TI.3.6",
          "line_type": "p",
          "text": "او نباید نوایمان باشد، مبادا مغرور گشته مثل ابلیس محکوم شود."
        },
        {
          "verse": 7,
          "usfm": "1TI.3.7",
          "line_type": "p",
          "text": "علاوه بر این، او باید در میان افراد خارج از کلیسا نیک‌نام باشد تا دچار رسوایی نشود و به دام ابلیس نیفتد."
        },
        {
          "verse": 8,
          "usfm": "1TI.3.8",
          "line_type": "p",
          "text": "همچنین خادمان کلیسا باید موقّر باشند و از دورویی مبرّا، و از افراط در شراب‌خواری بپرهیزند و پول‌پرست نباشند."
        },
        {
          "verse": 9,
          "usfm": "1TI.3.9",
          "line_type": "p",
          "text": "آن‌ها باید حقایق مکشوف شدۀ ایمان را با وجدان پاک نگاه دارند."
        },
        {
          "verse": 10,
          "usfm": "1TI.3.10",
          "line_type": "p",
          "text": "اوّل مورد آزمایش قرار بگیرند و درصورتی‌که بی‌عیب بودند، آن‌وقت به خدمت بپردازند."
        },
        {
          "verse": 11,
          "usfm": "1TI.3.11",
          "line_type": "p",
          "text": "زنانشان نیز باید سنگین و موقّر بوده سخن‌چین نباشند و در هر امر خویشتن‌دار و باوفا باشند."
        },
        {
          "verse": 12,
          "usfm": "1TI.3.12",
          "line_type": "p",
          "text": "خادم کلیسا شوهر وفادار یک زن باشد و فرزندان و خانوادۀ خود را به‌خوبی اداره کند."
        },
        {
          "verse": 13,
          "usfm": "1TI.3.13",
          "line_type": "p",
          "text": "کسانی‌ که به‌عنوان خادم به‌خوبی خدمت می‌کنند، برای خود احترام والایی کسب کرده در اعلام ایمانشان که در مسیح عیسی بنا شده است، اطمینان زیادی به دست می‌آورند."
        },
        {
          "verse": 14,
          "usfm": "1TI.3.14",
          "line_type": "p",
          "text": "امیدوارم به‌زودی نزد تو بیایم، امّا این‌ها را می‌نویسم"
        },
        {
          "verse": 15,
          "usfm": "1TI.3.15",
          "line_type": "p",
          "text": "تا درصورتی که در آمدن تأخیر کردم، بدانی که رفتار ما در خانوادۀ خدا، که کلیسای خدای زنده و ستون و پایه حقیقت است، چگونه باید باشد."
        },
        {
          "verse": 16,
          "usfm": "1TI.3.16",
          "line_type": "p",
          "text": "به‌یقین هیچ‌کس نمی‌تواند انکار کند که ایمان مسیحی ما بزرگ است:او به‌صورت انسان ظاهر شد،روح‌القدس حقّانیّتش را ثابت نمود،و فرشتگان او را دیدند.مژدۀ او در میان ملّت‌ها اعلام شد،در جهان، مردم به او ایمان آوردند،و او با جلال به عالم بالا برده شد."
        }
      ],
      "verse_count": 16,
      "headings": [
