    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 6,
      "chapter_usfm": "1TI.6",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.6.1",
          "line_type": "p",
          "text": "همۀ آنانی که زیر یوغ بردگی هستند، اربابان خود را شایستۀ احترام کامل بدانند تا هیچ‌کس از نام خدا و تعلیم ما بدگویی نکند."
        },
        {
          "verse": 2,
          "usfm": "1TI.6.2",
          "line_type": "p",
          "text": "غلامانی که اربابان ایماندار دارند، نباید به دلیل این‌که برادر دینی هستند، به آن‌ها بی‌احترامی کنند، بلکه باید بهتر خدمت کنند، چون آنانی که از خدمت ایشان بهره‌مند می‌گردند، مؤمن و عزیز هستند.باید این چیزها را تعلیم دهی و اصرار کنی که مطابق آن‌ها عمل کنند."
        },
        {
          "verse": 3,
          "usfm": "1TI.6.3",
          "line_type": "p",
          "text": "اگر کسی تعلیمی به‌غیراز این بدهد و تعلیمش با سخنان خداوند ما عیسای مسیح و تعالیم آیین ما سازگار نباشد،"
        },
        {
          "verse": 4,
          "usfm": "1TI.6.4",
          "line_type": "p",
          "text": "خودپسند و بی‌فهم است و تمایل ناسالمی به مجادله و منازعه بر سر کلمات دارد. این امر باعث حسادت، دسته‌بندی، توهین، بدگمانی و"
        },
        {
          "verse": 5,
          "usfm": "1TI.6.5",
          "line_type": "p",
          "text": "مباحثات دائمی در بین اشخاصی می‌شود که در افکار خود فاسد و از حقیقت دور هستند. آن‌ها گمان می‌کنند که دین‌داری وسیله‌ای است برای کسب منفعت."
        },
        {
          "verse": 6,
          "usfm": "1TI.6.6",
          "line_type": "p",
          "text": "البتّه دین‌داری همراه با قناعت، منفعت بسیار دارد."
        },
        {
          "verse": 7,
          "usfm": "1TI.6.7",
          "line_type": "p",
          "text": "زیرا ما چیزی به این جهان نیاورده‌ایم و نمی‌توانیم از این جهان چیزی ببریم."
        },
        {
          "verse": 8,
          "usfm": "1TI.6.8",
          "line_type": "p",
          "text": "پس اگر خوراک و پوشاک داشته باشیم، به آن‌ها قناعت می‌کنیم."
        },
        {
          "verse": 9,
          "usfm": "1TI.6.9",
          "line_type": "p",
          "text": "امّا آنانی که در آرزوی جمع کردن ثروت هستند، به وسوسه و دام آرزوهای پوچ و زیان‌بخشی که آدمی را به تباهی و نیستی می‌کشاند گرفتار می‌شوند."
        },
        {
          "verse": 10,
          "usfm": "1TI.6.10",
          "line_type": "p",
          "text": "زیرا عشق به پول، سرچشمۀ همه‌نوع بدی‌ها است و به علّت همین عشق است که بعضی‌ها از ایمان منحرف گشته متحمّل رنج‌های بسیار گشته‌اند."
        },
        {
          "verse": 11,
          "usfm": "1TI.6.11",
          "line_type": "p",
          "text": "امّا تو، ای مرد خدا، از همۀ این‌ها بگریز و نیکویی مطلق، تقوا، ایمان، محبّت، بردباری و ملایمت را پیشۀ خود ساز."
        },
        {
          "verse": 12,
          "usfm": "1TI.6.12",
          "line_type": "p",
          "text": "در مسابقۀ بزرگ ایمان تلاش کن و حیات جاودانی را به چنگ آور، زیرا خدا تو را برای آن خوانده است و در حضور شاهدان بسیار، به‌خوبی به ایمان خود اعتراف کردی."
        },
        {
          "verse": 13,
          "usfm": "1TI.6.13",
          "line_type": "p",
          "text": "در برابر خدایی که به همه‌‌چیز هستی می‌بخشد، و در حضور مسیح عیسی که در شهادت خود نزد «پنطیوس پیلاطُس» اعترافی نیکو کرد، تو را موظّف می‌سازم"
        },
        {
          "verse": 14,
          "usfm": "1TI.6.14",
          "line_type": "p",
          "text": "که این فرمان را به‌طور کامل و دور از سرزنش، تا روزی که خداوند ما عیسای مسیح ظهور کند، نگاه داری."
        },
        {
          "verse": 15,
          "usfm": "1TI.6.15",
          "line_type": "p",
          "text": "و خدای متبارک، یعنی آن حاکم یکتا، آن شاه شاهان و خداوند خداوندان، آن‌ را در زمانی‌‌که خود معیّن کرده ظاهر خواهد ساخت."
        },
        {
          "verse": 16,
          "usfm": "1TI.6.16",
          "line_type": "p",
          "text": "به آن یکتا وجودی که فناناپذیر است و در نوری ساکن می‌باشد که محال است کسی بتواند به آن نزدیک گردد و هیچ‌کس هرگز او را ندیده و نمی‌تواند ببیند، عزّت و قدرت جاودان باد، آمین."
        },
        {
          "verse": 17,
          "usfm": "1TI.6.17",
          "line_type": "p",
          "text": "به ثروتمندان این جهان دستور بده که متکبّر نباشند و به چیزهای بی‌ثبات مانند مال دنیا امید نبندند، بلکه به خدایی توکّل کنند که همه‌‌چیز را به فراوانی فراهم می‌کند تا ما از آن‌ها لذّت ببریم."
        },
        {
          "verse": 18,
          "usfm": "1TI.6.18",
          "line_type": "p",
          "text": "همچنین به آن‌ها فرمان بده که خیرخواه و در کارهای نیک غنی بوده، سخاوتمند و بخشنده باشند."
        },
        {
          "verse": 19,
          "usfm": "1TI.6.19",
          "line_type": "p",
          "text": "به‌این‌طریق گنجی برای خود ذخیره خواهند کرد که اساس محکمی برای آیندۀ آن‌ها خواهد بود و آن حیاتی را که حیات واقعی است به دست خواهند آورد."
        },
        {
          "verse": 20,
          "usfm": "1TI.6.20",
          "line_type": "p",
          "text": "ای تیموتاؤس، آنچه را به تو سپرده شده است، حفظ کن. از سخنان بی‌معنی و کُفرآمیز و مباحثاتی که به غلط «دانش» نامیده می‌شود، دوری کن."
        },
        {
          "verse": 21,
          "usfm": "1TI.6.21",
          "line_type": "p",
          "text": "زیرا بعضی‌ها که خود را در این چیزها متخصص می‌دانند، از ایمان منحرف گشته‌اند. فیض خدا با همۀ شما باد."
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 3,
          "text": "تعالیم غلط و ثروت حقیقی"
        },
        {
          "before_verse": 11,
          "text": "وظایف تیموتاؤس"
        }
      ],
