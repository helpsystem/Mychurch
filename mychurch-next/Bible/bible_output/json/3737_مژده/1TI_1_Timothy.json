    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 5,
      "chapter_usfm": "1TI.5",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.5.1",
          "line_type": "p",
          "text": "مردی را که از تو مسن‌تر است سرزنش نکن، بلکه او را طوری نصیحت کن که گویی پدر تو است. با جوانان مثل برادران"
        },
        {
          "verse": 2,
          "usfm": "1TI.5.2",
          "line_type": "p",
          "text": "و با زن‌های پیر مانند مادران و با زن‌های جوان مثل خواهران خود با کمال پاکدامنی رفتار کن."
        },
        {
          "verse": 3,
          "usfm": "1TI.5.3",
          "line_type": "p",
          "text": "بیوه‌زنانی را که واقعاً بی‌کس هستند مورد توجّه قرار بده."
        },
        {
          "verse": 4,
          "usfm": "1TI.5.4",
          "line_type": "p",
          "text": "امّا اگر بیوه‌زنی فرزندان و یا نوه‌ها دارد، اوّل آن‌ها هستند که باید وظیفۀ دینی خود را نسبت به خانواده بیاموزند و از والدین خود نگهداری کنند، زیرا این‌ کار خدا را خشنود می‌سازد."
        },
        {
          "verse": 5,
          "usfm": "1TI.5.5",
          "line_type": "p",
          "text": "کسی‌ که واقعاً بیوه و تنها است، به خدا توکّل دارد و شب و روز به مناجات و دعا مشغول است."
        },
        {
          "verse": 6,
          "usfm": "1TI.5.6",
          "line_type": "p",
          "text": "ولی آن بیوه‌زنی که تسلیم عیّاشی می‌شود، اگرچه زنده باشد، درواقع مُرده است."
        },
        {
          "verse": 7,
          "usfm": "1TI.5.7",
          "line_type": "p",
          "text": "این دستورات را به ایشان بده تا از سرزنش به دور باشند."
        },
        {
          "verse": 8,
          "usfm": "1TI.5.8",
          "line_type": "p",
          "text": "اگر کسی معاش زندگی خویشاوندان و مخصوصاً خانوادۀ خود را تأمین نکند، ایمان را انکار کرده و بدتر از کافران شده است."
        },
        {
          "verse": 9,
          "usfm": "1TI.5.9",
          "line_type": "p",
          "text": "فقط نام بیوه‌زنی باید ثبت شود که بیش از شصت سال داشته و بیش از یک شوهر نکرده باشد."
        },
        {
          "verse": 10,
          "usfm": "1TI.5.10",
          "line_type": "p",
          "text": "علاوه بر این، او باید در امور خیریه، از قبیل پرورش اطفال، مهمان‌نوازی، شستن پای‌های مقدّسین، دستگیری از دردمندان و انجام هر نوع نیکوکاری شهرت داشته باشد."
        },
        {
          "verse": 11,
          "usfm": "1TI.5.11",
          "line_type": "p",
          "text": "نام بیوه‌زن‌های جوان‌تر ثبت نگردد، زیرا به‌محض این‌که هوی و هوسْ آن‌ها را از مسیح دور سازد، علاقه‌مند به ازدواج می‌شوند"
        },
        {
          "verse": 12,
          "usfm": "1TI.5.12",
          "line_type": "p",
          "text": "و به‌ سبب این‌که پیمان قبلی خود را با مسیح می‌شکنند، محکوم خواهند شد."
        },
        {
          "verse": 13,
          "usfm": "1TI.5.13",
          "line_type": "p",
          "text": "گذشته از این، یاد می‌گیرند که خانه به خانه بگردند و بیکار باشند. آن‌ها نه فقط بیکار بلکه سخن‌چین و فضول می‌شوند و چیزهایی می‌گویند که گفتن آن‌ها شایسته نیست."
        },
        {
          "verse": 14,
          "usfm": "1TI.5.14",
          "line_type": "p",
          "text": "من ترجیح می‌دهم که بیوه‌زن‌های جوان ازدواج کنند و صاحب فرزند شوند و خانه‌داری نمایند تا به دشمنان ما فرصت بدگویی ندهند."
        },
        {
          "verse": 15,
          "usfm": "1TI.5.15",
          "line_type": "p",
          "text": "زیرا بعضی از بیوه‌زن‌ها هم‌اکنون منحرف شده و به‌دنبال شیطان رفته‌اند."
        },
        {
          "verse": 16,
          "usfm": "1TI.5.16",
          "line_type": "p",
          "text": "اگر زن ایمانداری، خویشاوندان بیوه داشته باشد، باید ایشان را یاری دهد که بر کلیسا تحمیل نگردند تا کلیسا به بیوه‌زن‌های بی‌کس کمک نماید."
        },
        {
          "verse": 17,
          "usfm": "1TI.5.17",
          "line_type": "p",
          "text": "مشایخی را که به‌خوبی رهبری می‌کنند، مخصوصاً آنانی که در وعظ و تعلیم زحمت می‌کشند، باید مستحق دریافت مزد دو برابر دانست."
        },
        {
          "verse": 18,
          "usfm": "1TI.5.18",
          "line_type": "p",
          "text": "زیرا نوشته شده است: «دهان گاوی را که خرمن می‌کوبد، نبند» و «کارگر مستحق مزد خود می‌باشد.»"
        },
        {
          "verse": 19,
          "usfm": "1TI.5.19",
          "line_type": "p",
          "text": "هیچ ادّعایی را علیه یکی از مشایخ نپذیر، مگر آنکه به‌وسیلهٔ دو یا سه شاهد تأیید شود."
        },
        {
          "verse": 20,
          "usfm": "1TI.5.20",
          "line_type": "p",
          "text": "آنانی را که در گناه پافشاری می‌کنند، در حضور همه توبیخ کن تا دیگران عبرت گیرند."
        },
        {
          "verse": 21,
          "usfm": "1TI.5.21",
          "line_type": "p",
          "text": "در حضور خدا و عیسی و فرشتگان برگزیده، تو را موظّف می‌سازم که دستورهای فوق را بدون غَرَض نگاه داری و هیچ کاری را از روی تبعیض انجام ندهی."
        },
        {
          "verse": 22,
          "usfm": "1TI.5.22",
          "line_type": "p",
          "text": "در دست‌گذاری کسی برای خدمت خداوند عجله نکن و در گناهان دیگران شریک نباش، خود را پاک نگه‌دار."
        },
        {
          "verse": 23,
          "usfm": "1TI.5.23",
          "line_type": "p",
          "text": "از این پس فقط آب ننوش، بلکه برای کمک به معده‌ات کمی هم شراب بخور، زیرا اغلب مریض‌ هستی."
        },
        {
          "verse": 24,
          "usfm": "1TI.5.24",
          "line_type": "p",
          "text": "گناهان بعضی‌ها اکنون آشکار است و آن‌ها را به‌سوی داوری می‌کشاند، امّا گناهان دیگران بعدها معلوم خواهد شد."
        },
        {
          "verse": 25,
          "usfm": "1TI.5.25",
          "line_type": "p",
          "text": "همچنین کارهای نیک نیز آشکار می‌باشند و حتّی اگر اکنون آشکار نباشند، نمی‌توان آن‌ها برای همیشه پنهان نگاه داشت."
        }
      ],
      "verse_count": 25,
