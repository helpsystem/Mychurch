  "version_abbr": "مژده",
  "version_name": "مژده برای عصر جدید - ویرایش ۲۰۲۳",
  "language": "fa",
  "chapter_count": 6,
  "total_verses": 113,
  "chapters": [
    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 1,
      "chapter_usfm": "1TI.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.1.1",
          "line_type": "p",
          "text": "از طرف پولس که به فرمان نجات‌دهندۀ ما خدا و به دستور مسیح عیسی، امید ما، رسول مسیح عیسی است،"
        },
        {
          "verse": 2,
          "usfm": "1TI.1.2",
          "line_type": "p",
          "text": "به تیموتاؤس، فرزند حقیقی خودم در ایمان تقدیم می‌گردد. خدای پدر و خداوند ما مسیح عیسی، فیض و رحمت و آرامش به تو عطا فرماید."
        },
        {
          "verse": 3,
          "usfm": "1TI.1.3",
          "line_type": "p",
          "text": "همچنان‌ که در سر راه خود به مقدونیه به تو اصرار کردم، بازهم از تو می‌خواهم که در اَفِسُس بمانی و به اشخاصی که تعالیم نادرست می‌دهند دستور دهی که از این‌ کار دست بردارند."
        },
        {
          "verse": 4,
          "usfm": "1TI.1.4",
          "line_type": "p",
          "text": "به آن‌ها بگو که خود را با افسانه‌ها و شجره‌نامه‌های بی‌پایانی که انسان را به مجادله می‌کشند، سرگرم نسازند. این‌ها به پیشرفت نقشۀ خدا که از راه ایمان شناخته می‌شود، کمکی نمی‌کنند."
        },
        {
          "verse": 5,
          "usfm": "1TI.1.5",
          "line_type": "p",
          "text": "هدف تعلیم ما برانگیختن محبّتی است که از دل‌پاک و وجدان روشن و ایمان خالص پدید می‌آید."
        },
        {
          "verse": 6,
          "usfm": "1TI.1.6",
          "line_type": "p",
          "text": "بعضی افراد از این امور روی گردانیده و در مباحثات احمقانه راهشان را گُم کرده‌اند."
        },
        {
          "verse": 7,
          "usfm": "1TI.1.7",
          "line_type": "p",
          "text": "آن‌ها مایلند معلّمان شریعت باشند، بدون آنکه بفهمند چه می‌گویند و یا دربارۀ چه چیز این‌طور با اطمینان سخن می‌گویند."
        },
        {
          "verse": 8,
          "usfm": "1TI.1.8",
          "line_type": "p",
          "text": "ما می‌دانیم شریعت وقتی نیکو است که به طرز صحیحی از آن استفاده شود."
        },
        {
          "verse": 9,
          "usfm": "1TI.1.9",
          "line_type": "p",
          "text": "البتّه باید دانست که احکام برای نیکان وضع نشده، بلکه برای افراد سرکش، برای خدا نشناسان، گناه‌کاران، کافران، بی‌دینان، قاتلان پدر و مادر، آدم‌کشان،"
        },
        {
          "verse": 10,
          "usfm": "1TI.1.10",
          "line_type": "p",
          "text": "زشتکاران، لواط‌گران، آدم‌دزدان، دروغ‌گویان و اشخاصی که شهادت دروغ می‌دهند و هر کار دیگری را که برخلاف تعلیم درست باشد انجام می‌دهند."
        },
        {
          "verse": 11,
          "usfm": "1TI.1.11",
          "line_type": "p",
          "text": "این تعلیمی که در انجیل یافت می‌شود، یعنی مژده‌ای از جانب خدای پُرجلال و متبارک که به من سپرده شده است تا آن‌ را اعلام کنم."
        },
        {
          "verse": 12,
          "usfm": "1TI.1.12",
          "line_type": "p",
          "text": "خداوندمان مسیح عیسی را که مرا قابل‌ اعتماد شمرد و توانایی بخشید و برای خدمت خود برگزید، سپاس می‌گویم."
        },
        {
          "verse": 13,
          "usfm": "1TI.1.13",
          "line_type": "p",
          "text": "اگرچه در گذشته به او دشنام می‌دادم، جفا می‌رسانیدم و اهانت می‌کردم، امّا خدا به من رحم کرد، زیرا من بی‌ایمان بودم و نمی‌‌دانستم چه می‌کردم،"
        },
        {
          "verse": 14,
          "usfm": "1TI.1.14",
          "line_type": "p",
          "text": "و خداوند فیض سرشار خود را بر من جاری ساخت و آن ایمان و محبّتی را به من عطا نمود که در اتّحاد با مسیح نصیب ما می‌گردد."
        },
        {
          "verse": 15,
          "usfm": "1TI.1.15",
          "line_type": "p",
          "text": "این سخن‌ قابل‌ اعتماد است و کاملاً قابل قبول که مسیح عیسی به جهان آمد تا گناه‌کاران را نجات بخشد. و من بزرگ‌ترین گناهکار هستم."
        },
        {
          "verse": 16,
          "usfm": "1TI.1.16",
          "line_type": "p",
          "text": "امّا به این دلیل رحمت یافتم تا عیسای مسیح در رفتار خود با من که بزرگ‌ترینِ گناهکارانم، کمال بردباری خود را نشان دهد و من نمونه‌ای باشم برای همۀ کسانی‌ که بعدها به او ایمان آورده حیات جاودانی خواهند یافت."
        },
        {
          "verse": 17,
          "usfm": "1TI.1.17",
          "line_type": "p",
          "text": "به پادشاه جاودانی و فناناپذیر و نادیدنی، خدای یکتا تا ابد عزّت و جلال باد، آمین."
        },
        {
          "verse": 18,
          "usfm": "1TI.1.18",
          "line_type": "p",
          "text": "ای تیموتاؤس، فرزند من، همان‌طور که مدّت‌ها پیش دربارۀ تو نبوّت شد، این فرمان را به تو می‌سپارم و امیدوارم آن سخنان، مانند سلاحی در این جنگ نیکو تو را یاری دهند،"
        },
        {
          "verse": 19,
          "usfm": "1TI.1.19",
          "line_type": "p",
          "text": "و تو ایمان و وجدان پاک خود را نگه‌دار. کشتی ایمان بعضی‌ها به علّت گوش ‌ندادن به ندای وجدان درهم شکسته است."
        },
        {
          "verse": 20,
          "usfm": "1TI.1.20",
          "line_type": "p",
          "text": "از آن جمله «هیمِنائوس» و «اسکندر» می‌باشند که آن‌ها را به دست شیطان سپردم تا تأدیب شوند و دیگر کُفر نگویند."
        }
      ],
      "verse_count": 20,
      "headings": [
        {
          "before_verse": 3,
          "text": "دربارۀ تعلیم نادرست"
        },
        {
          "before_verse": 12,
          "text": "حمد و سپاس برای رحمت خدا"
        }
      ],
