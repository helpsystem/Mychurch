    {
      "schema_version": 6,
      "book_id": "1TI",
      "chapter": 4,
      "chapter_usfm": "1TI.4",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TI.4.1",
          "line_type": "p",
          "text": "روح‌القدس صریحاً می‌فرماید که در زمان‌های آخر، بعضی‌ها از ایمان دست خواهند کشید و از ارواح گمراه کننده و تعالیم شیاطین پیروی خواهند کرد."
        },
        {
          "verse": 2,
          "usfm": "1TI.4.2",
          "line_type": "p",
          "text": "این‌چنین تعالیم از دروغ‌گویان ریاکار است، دروغگویانی که وجدانشان چنان بی‌حس شده که گویی با آهنی داغ سوخته شده است."
        },
        {
          "verse": 3,
          "usfm": "1TI.4.3",
          "line_type": "p",
          "text": "آنان ازدواج را منع می‌کنند و خوردن بعضی از غذاها را ممنوع می‌کنند، در حالی‌که خدا آن‌ غذاها را آفریده تا ایماندارانی که از حقیقت آگاهند، با شکرگزاری از آن‌ها لذّت ببرند."
        },
        {
          "verse": 4,
          "usfm": "1TI.4.4",
          "line_type": "p",
          "text": "همۀ چیزهایی که خدا آفریده است نیکو است و نباید چیزی را که با شکرگزاری پذیرفته می‌شود، ممنوع نمود،"
        },
        {
          "verse": 5,
          "usfm": "1TI.4.5",
          "line_type": "p",
          "text": "زیرا به‌وسیلهٔ کلام خدا و دعا تقدیس می‌گردد."
        },
        {
          "verse": 6,
          "usfm": "1TI.4.6",
          "line_type": "p",
          "text": "اگر این دستورها را به ایمان‌داران یادآور شوی، خادم نیکوی مسیح عیسی خواهی بود که در حقایق ایمان و تعالیم نیکویی که دنبال کرده‌ای، پرورش خواهی یافت."
        },
        {
          "verse": 7,
          "usfm": "1TI.4.7",
          "line_type": "p",
          "text": "از افسانه‌های پوچ و از آنچه کُفرآمیز است دوری کن، و به‌جای آن خود را در خداپرستی پرورش بده."
        },
        {
          "verse": 8,
          "usfm": "1TI.4.8",
          "line_type": "p",
          "text": "زیرا اگرچه ورزش اندکی برای بدن فایده دارد، امّا خداپرستی از هر حیث مفید است، چون هم برای حال و هم برای آینده وعدۀ حیات دارد."
        },
        {
          "verse": 9,
          "usfm": "1TI.4.9",
          "line_type": "p",
          "text": "این سخن قابل‌ اعتماد و شایستهٔ پذیرش کامل است."
        },
        {
          "verse": 10,
          "usfm": "1TI.4.10",
          "line_type": "p",
          "text": "بنابراین ما سخت می‌کوشیم و زحمت می‌کشیم، زیرا بر خدای زنده که نجات‌دهندهٔ همهٔ آدمیان بخصوص ایمان‌داران است، امید بسته‌ایم."
        },
        {
          "verse": 11,
          "usfm": "1TI.4.11",
          "line_type": "p",
          "text": "این دستورات را با تأکید تعلیم بده."
        },
        {
          "verse": 12,
          "usfm": "1TI.4.12",
          "line_type": "p",
          "text": "هیچ‌کس جوانی تو را حقیر نشمارد، بلکه در گفتار، کردار، محبّت، ایمان و پاکی برای ایمان‌داران نمونه باش"
        },
        {
          "verse": 13,
          "usfm": "1TI.4.13",
          "line_type": "p",
          "text": "و تا موقع آمدن من، وقت خود را صرف قرائت کتب مقدّس برای عموم و تشویق و تعلیم آن‌ها بنما."
        },
        {
          "verse": 14,
          "usfm": "1TI.4.14",
          "line_type": "p",
          "text": "نسبت به عطیۀ روحانی خود بی‌توجّه نباش، عطیه‌ای که در وقت دست‌گذاری تو به‌وسیلهٔ مشایخ کلیسا همراه با نبوّت آن‌ها به تو داده شد."
        },
        {
          "verse": 15,
          "usfm": "1TI.4.15",
          "line_type": "p",
          "text": "در این امور کوشا باش و خود را وقف آن‌ها بساز تا پیشرفت تو برای همه آشکار گردد."
        },
        {
          "verse": 16,
          "usfm": "1TI.4.16",
          "line_type": "p",
          "text": "مراقب خود و تعالیمت باش و در انجام این‌ کارها همیشه کوشش کن، چون به‌این‌وسیله هم خود و هم آنانی را که به تو گوش می‌دهند، نجات خواهی داد."
        }
      ],
      "verse_count": 16,
      "headings": [
        {
          "before_verse": 6,
          "text": "خادم خوب مسیح"
        }
      ],
