  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2JN",
      "chapter": 1,
      "chapter_usfm": "2JN.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "2JN.1.1",
          "line_type": "p",
          "text": "از طرف شیخ کلیسا به بانوی برگزیدۀ خدا و فرزندان او، که نه‌تنها من بلکه همۀ آنانی که حقیقت را می‌شناسند آن‌ها را واقعاً دوست داریم،"
        },
        {
          "verse": 2,
          "usfm": "2JN.1.2",
          "line_type": "p",
          "text": "زیرا حقیقت در میان ما بوده و هست و تا ابد با ما خواهد بود."
        },
        {
          "verse": 3,
          "usfm": "2JN.1.3",
          "line_type": "p",
          "text": "خدای پدر و عیسای مسیح پسر او، فیض، رحمت و آرامش به ما عنایت فرماید تا این برکات همیشه درحقیقت و محبّت از آن ما باشند."
        },
        {
          "verse": 4,
          "usfm": "2JN.1.4",
          "line_type": "p",
          "text": "وقتی شنیدم که بعضی از فرزندان تو همان‌طور که پدر ما فرمان داده است بر‌ طبق حقیقت زندگی می‌کنند، بسیار شادمان شدم."
        },
        {
          "verse": 5,
          "usfm": "2JN.1.5",
          "line_type": "p",
          "text": "و اکنون ای بانو، خواهشی از تو دارم و آن این است که به یکدیگر محبّت کنیم. من فرمان تازه‌ای به تو نمی‌دهم، بلکه همان فرمانی است که از اوّل داشته‌ایم."
        },
        {
          "verse": 6,
          "usfm": "2JN.1.6",
          "line_type": "p",
          "text": "منظور من از محبّت این است که مطابق احکام خدا زندگی کنیم. آری، آن فرمان که شما از اوّل شنیده‌اید این است که باید در محبّت زندگی کنید."
        },
        {
          "verse": 7,
          "usfm": "2JN.1.7",
          "line_type": "p",
          "text": "فریبکاران بسیاری به سرتاسر جهان رفته‌اند، یعنی اشخاصی که نمی‌پذیرند که عیسای مسیح در جسم ظاهر شد. این‌ها فریبکار هستند! این‌ها «ضدّ مسیح» هستند!"
        },
        {
          "verse": 8,
          "usfm": "2JN.1.8",
          "line_type": "p",
          "text": "مواظب باشید که نتیجهٔ کارهای ما به هدر نرود، بلکه تا شما پاداش خود را کاملاً دریافت کنید."
        },
        {
          "verse": 9,
          "usfm": "2JN.1.9",
          "line_type": "p",
          "text": "هرکه تعالیمش مطابق تعالیم مسیح نیست بلکه چیزهای دیگری را تعلیم می‌دهد، خدا با او نیست. امّا کسانی‌ که به تعلیم مسیح وفادار هستند، هم خدای پدر را دارند و هم پسر را."
        },
        {
          "verse": 10,
          "usfm": "2JN.1.10",
          "line_type": "p",
          "text": "اگر کسی نزد شما بیاید و این تعلیم درست را نیاورد، او را در خانۀ خود نپذیرید و حتّی به او خوش‌آمد هم نگویید،"
        },
        {
          "verse": 11,
          "usfm": "2JN.1.11",
          "line_type": "p",
          "text": "زیرا هرکه به او خوش‌آمد بگوید در کارهای شریرانۀ او هم‌دست شده است."
        },
        {
          "verse": 12,
          "usfm": "2JN.1.12",
          "line_type": "p",
          "text": "اگرچه مطالب بسیاری هست که باید به شما بنویسم، امّا نمی‌خواهم آن‌ها را با قلم و مرکب روی کاغذ بیاورم و به‌جای آن، امیدوارم شما را شخصاً ببینم و روبه‌رو با شما صحبت کنم تا شادی ما کامل گردد."
        },
        {
          "verse": 13,
          "usfm": "2JN.1.13",
          "line_type": "p",
          "text": "فرزندانِ خواهر برگزیده‌ات به تو سلام می‌رسانند."
        }
      ],
      "verse_count": 13,
      "headings": [
        {
          "before_verse": 4,
          "text": "حقیقت و محبّت"
        },
        {
          "before_verse": 12,
