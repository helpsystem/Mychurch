    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 3,
      "chapter_usfm": "1TH.3",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.3.1",
          "line_type": "p",
          "text": "پس چون دیگر نمی‌توانستیم بی‌خبری را تحمّل کنیم، تصمیم گرفتیم که در شهر آتن تنها بمانیم"
        },
        {
          "verse": 2,
          "usfm": "1TH.3.2",
          "line_type": "p",
          "text": "و تیموتاؤس را که برادر ما و همکار ما در خدا برای انتشار مژدۀ انجیل است، فرستادیم تا شما را در ایمانتان تقویت نماید و دل‌داری دهد،"
        },
        {
          "verse": 3,
          "usfm": "1TH.3.3",
          "line_type": "p",
          "text": "تا هیچ‌کس در اثر این رنج‌ها دل‌سرد نشود. خودتان می‌دانید که این رنج‌ها نصیب و قسمت ما است."
        },
        {
          "verse": 4,
          "usfm": "1TH.3.4",
          "line_type": "p",
          "text": "وقتی ما با شما بودیم، از پیش به شما گفتیم که رنج و آزار خواهیم دید و چنان‌که آگاه هستید، همان‌طور هم شده است."
        },
        {
          "verse": 5,
          "usfm": "1TH.3.5",
          "line_type": "p",
          "text": "از این جهت چون این بی‌خبری، دیگر برای من غیرقابل تحمّل بود، تیموتاؤس را نزد شما فرستادم تا از ایمان شما آگاه شوم، زیرا می‌ترسیدم آن وسوسه کننده شما را به نوعی وسوسه کرده باشد و زحمات ما بی‌نتیجه مانده باشد."
        },
        {
          "verse": 6,
          "usfm": "1TH.3.6",
          "line_type": "p",
          "text": "امّا اکنون که تیموتاؤس از نزد شما بازگشته است، خبر خوشی دربارۀ ایمان و محبّت شما به ما داده است و گزارش می‌دهد که شما با چه لطفی همواره ما را به‌یاد می‌آورید و همان‌گونه که ما برای دیدن شما اشتیاق داریم، شما هم مشتاق دیدار ما هستید."
        },
        {
          "verse": 7,
          "usfm": "1TH.3.7",
          "line_type": "p",
          "text": "ای برادران، با وجود همۀ مشکلات و زحماتی که داریم، این خبر ما را دل‌داری داده است. بلی، ایمان شما سبب دل‌داری ما گشته است."
        },
        {
          "verse": 8,
          "usfm": "1TH.3.8",
          "line_type": "p",
          "text": "اگر شما در اتّحاد با خداوند استوار بمانید، ما جان تازه‌ای خواهیم گرفت."
        },
        {
          "verse": 9,
          "usfm": "1TH.3.9",
          "line_type": "p",
          "text": "ما با چه نوع شکرگزاری خدا را برای شما و برای تمام شادی‌ای که به‌خاطر شما در پیشگاه خدا احساس می‌کنیم، سپاسگزاری کنیم؟"
        },
        {
          "verse": 10,
          "usfm": "1TH.3.10",
          "line_type": "p",
          "text": "شب و روز از صمیم قلب، دعا می‌کنیم که روی شما را ببینیم و کمبودهای ایمان شما را برطرف سازیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.3.11",
          "line_type": "p",
          "text": "باشد که خدای پدر و خداوند ما عیسای مسیح، راه ما را به‌سوی شما بگشاید!"
        },
        {
          "verse": 12,
          "usfm": "1TH.3.12",
          "line_type": "p",
          "text": "و خداوند عطا فرماید که به‌اندازۀ محبّتی که ما برای شما داریم، محبّت شما برای یکدیگر و همۀ مردم افزایش و گسترش یابد؛"
        },
        {
          "verse": 13,
          "usfm": "1TH.3.13",
          "line_type": "p",
          "text": "و خدا دل‌های شما را قوی گرداند تا در آن هنگام که خداوند ما عیسی با همۀ مقدّسین خود می‌آید، شما در حضور خدای پدر بی‌عیب و مقدّس باشید."
        }
      ],
      "verse_count": 13,
      "headings": [
        {
          "before_verse": 6,
          "text": "گزارش دل‌گرم کنندۀ تیموتاؤس"
        }
      ],
      "footnotes": [
