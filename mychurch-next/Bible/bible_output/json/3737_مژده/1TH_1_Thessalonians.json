    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 5,
      "chapter_usfm": "1TH.5",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.5.1",
          "line_type": "p",
          "text": "امّا ای برادران، لازم نیست که من دربارۀ زمان و تاریخ وقوع این امور چیزی برای شما بنویسم."
        },
        {
          "verse": 2,
          "usfm": "1TH.5.2",
          "line_type": "p",
          "text": "زیرا شما خوب می‌دانید که روز خداوند مانند دزدی که در شب می‌آید، فرا خواهد رسید."
        },
        {
          "verse": 3,
          "usfm": "1TH.5.3",
          "line_type": "p",
          "text": "در آن هنگام که مردم از صلح و امنیّت خود تعریف می‌کنند، هلاکت ناگهانی مثل درد زایمان به ایشان وارد خواهد شد و به هیچ‌وجه جان سالم به در نخواهند برد."
        },
        {
          "verse": 4,
          "usfm": "1TH.5.4",
          "line_type": "p",
          "text": "امّا ای برادران، شما در تاریکی نیستید که آن روز، شما را مانند دزد غافلگیر کند،"
        },
        {
          "verse": 5,
          "usfm": "1TH.5.5",
          "line_type": "p",
          "text": "زیرا همۀ شما فرزندان نور و روز هستید. ما به شب و تاریکی تعلّق نداریم."
        },
        {
          "verse": 6,
          "usfm": "1TH.5.6",
          "line_type": "p",
          "text": "پس ما نباید مانند دیگران در خواب باشیم، بلکه باید بیدار و هوشیار باشیم."
        },
        {
          "verse": 7,
          "usfm": "1TH.5.7",
          "line_type": "p",
          "text": "کسانی‌ که می‌خوابند، در شب می‌خوابند و آنانی ‌که مست می‌شوند، در شب مست می‌شوند."
        },
        {
          "verse": 8,
          "usfm": "1TH.5.8",
          "line_type": "p",
          "text": "امّا ما که به روز تعلّق داریم باید هوشیار باشیم و ایمان و محبّت را مانند زِرِه به سینه ببندیم و امید نجات را مانند کلاهخود بر سر بگذاریم."
        },
        {
          "verse": 9,
          "usfm": "1TH.5.9",
          "line_type": "p",
          "text": "زیرا خدا ما را برای آن برنگزید که به غضب او گرفتار شویم، بلکه ما را برگزید تا به‌وسیلهٔ خداوند ما عیسای مسیح نجات یابیم."
        },
        {
          "verse": 10,
          "usfm": "1TH.5.10",
          "line_type": "p",
          "text": "او در راه ما مُرد تا خواه زنده باشیم خواه مُرده، با او زیست کنیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.5.11",
          "line_type": "p",
          "text": "پس یکدیگر را تشویق کنید، همان‌گونه که اکنون نیز می‌کنید."
        },
        {
          "verse": 12,
          "usfm": "1TH.5.12",
          "line_type": "p",
          "text": "ای برادران من، از شما تقاضا دارم برای آنانی که در میان شما زحمت می‌کشند و در خداوند، رهبران و مشاوران شما هستند، احترام قائل شوید؛"
        },
        {
          "verse": 13,
          "usfm": "1TH.5.13",
          "line_type": "p",
          "text": "و از آنان به‌خاطر خدماتی که انجام می‌دهند با نهایت محبّت و احترام قدردانی نمایید. با یکدیگر در صلح و صفا زیست کنید."
        },
        {
          "verse": 14,
          "usfm": "1TH.5.14",
          "line_type": "p",
          "text": "ای برادران من، از شما استدعا می‌کنم افراد تنبل و عاطل را توبیخ کنید، اشخاص ترسو را دل‌داری دهید، از ضعیفان پشتیبانی کنید و نسبت به همۀ مردم بردبار باشید."
        },
        {
          "verse": 15,
          "usfm": "1TH.5.15",
          "line_type": "p",
          "text": "مواظب باشید که هیچ‌کس بدی را با بدی تلافی نکند، بلکه هدف شما این باشد که پیوسته به یکدیگر و به همۀ مردم نیکویی کنید."
        },
        {
          "verse": 16,
          "usfm": "1TH.5.16",
          "line_type": "p",
          "text": "همیشه شادمان باشید"
        },
        {
          "verse": 17,
          "usfm": "1TH.5.17",
          "line_type": "p",
          "text": "و پیوسته دعا کنید."
        },
        {
          "verse": 18,
          "usfm": "1TH.5.18",
          "line_type": "p",
          "text": "در تمام شرایط خدا را شکر کنید، زیرا ارادۀ خدا در مسیح عیسی برای شما همین است."
        },
        {
          "verse": 19,
          "usfm": "1TH.5.19",
          "line_type": "p",
          "text": "روح‌القدس را خاموش نکنید."
        },
        {
          "verse": 20,
          "usfm": "1TH.5.20",
          "line_type": "p",
          "text": "نبوّت‌ها را ناچیز نشمارید."
        },
        {
          "verse": 21,
          "usfm": "1TH.5.21",
          "line_type": "p",
          "text": "همه‌‌چیز را بیازمایید و آنچه را که نیکو است نگاه دارید"
        },
        {
          "verse": 22,
          "usfm": "1TH.5.22",
          "line_type": "p",
          "text": "و از هر نوع بدی دوری کنید."
        },
        {
          "verse": 23,
          "usfm": "1TH.5.23",
          "line_type": "p",
          "text": "خدایی که سرچشمۀ آرامش است، شما را کاملاً پاک گرداند و عطا فرماید که روح و جان و جسم شما سالم بماند تا در وقت آمدن خداوند ما عیسای مسیح، از هر نوع عیب و نقصی به‌دور باشید."
        },
        {
          "verse": 24,
          "usfm": "1TH.5.24",
          "line_type": "p",
          "text": "او که شما را به‌سوی خود دعوت کرده است، امین است و این‌ کار را خواهد کرد."
        },
        {
          "verse": 25,
          "usfm": "1TH.5.25",
          "line_type": "p",
          "text": "ای برادران، برای ما دعا کنید."
        },
        {
          "verse": 26,
          "usfm": "1TH.5.26",
          "line_type": "p",
          "text": "همۀ ایمان‌داران را با بوسۀ مقدّسانه سلام گویید."
        },
        {
          "verse": 27,
          "usfm": "1TH.5.27",
          "line_type": "p",
          "text": "شما را به نام خداوند موظّف می‌سازم که این نامه را برای تمام ایمان‌داران بخوانید."
        },
        {
          "verse": 28,
          "usfm": "1TH.5.28",
          "line_type": "p",
          "text": "فیض خداوند ما عیسای مسیح با شما باد. آمین."
        }
      ],
      "verse_count": 28,
