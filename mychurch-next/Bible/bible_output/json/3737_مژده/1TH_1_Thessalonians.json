    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 4,
      "chapter_usfm": "1TH.4",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.4.1",
          "line_type": "p",
          "text": "دیگر این‌که ای برادران، شما از ما آموختید که چگونه باید زندگی کنید تا خدا را خشنود سازید و البتّه شما آنطور زندگی می‌کنید. اکنون به نام عیسای خداوند از شما استدعا و التماس می‌کنم که بیش از پیش آنطور زندگی کنید،"
        },
        {
          "verse": 2,
          "usfm": "1TH.4.2",
          "line_type": "p",
          "text": "زیرا می‌دانید چه احکامی از جانب عیسای خداوند به شما دادیم."
        },
        {
          "verse": 3,
          "usfm": "1TH.4.3",
          "line_type": "p",
          "text": "ارادۀ خدا این است که شما پاک باشید و از روابط جنسی نامشروع بپرهیزید."
        },
        {
          "verse": 4,
          "usfm": "1TH.4.4",
          "line_type": "p",
          "text": "همۀ شما باید بدانید چگونه بدن خود را همیشه تحت کنترل داشته باشید و آن‌ را پاک و محترم نگاه دارید"
        },
        {
          "verse": 5,
          "usfm": "1TH.4.5",
          "line_type": "p",
          "text": "و مانند ملّت‌های خداناشناس، دستخوش امیال و شهوات جسمانی نگردید."
        },
        {
          "verse": 6,
          "usfm": "1TH.4.6",
          "line_type": "p",
          "text": "در این خصوص هیچ‌کس نباید از یک ایماندار سوء‌استفاده نموده به او صدمه بزند، زیرا همان طوری که من قبلاً با تأکید زیاد به شما گفته بودم، خداوند همۀ کسانی‌ را که این‌ کارها را می‌کنند، کیفر خواهد داد."
        },
        {
          "verse": 7,
          "usfm": "1TH.4.7",
          "line_type": "p",
          "text": "خدا ما را به یک زندگی پاک و مقدّس خوانده است، نه به فساد اخلاقی!"
        },
        {
          "verse": 8,
          "usfm": "1TH.4.8",
          "line_type": "p",
          "text": "پس هرکه این تعلیم را قبول نکند، انسان را رد نمی‌کند، بلکه خدایی را رد می‌کند که روح‌القدس خود را به شما عطا می‌فرماید."
        },
        {
          "verse": 9,
          "usfm": "1TH.4.9",
          "line_type": "p",
          "text": "و امّا هیچ نیازی نیست که دربارۀ محبّت به یکدیگر چیزی بنویسم، زیرا خود شما از خدا تعلیم یافته‌اید که چگونه یکدیگر را محبّت کنید،"
        },
        {
          "verse": 10,
          "usfm": "1TH.4.10",
          "line_type": "p",
          "text": "و به‌راستی که در تمام مقدونیه شما با همۀ ایمان‌داران همین‌طور رفتار می‌کنید؛ باوجوداین ای برادران، از شما درخواست می‌کنم که محبّت شما روزبه‌روز بیشتر گردد."
        },
        {
          "verse": 11,
          "usfm": "1TH.4.11",
          "line_type": "p",
          "text": "آرزویتان این باشد که زندگی آرامی داشته باشید و به کار خود مشغول باشید و همان‌طور که قبلاً به شما دستور دادیم برای تأمین معاش خود کار کنید"
        },
        {
          "verse": 12,
          "usfm": "1TH.4.12",
          "line_type": "p",
          "text": "تا زندگی شما تأثیری نیکو در بی‌ایمانان بگذارد و برای نیازهای خود محتاج دیگران نباشید."
        },
        {
          "verse": 13,
          "usfm": "1TH.4.13",
          "line_type": "p",
          "text": "ای برادران، نمی‌خواهیم در مورد آنانی که فوت نموده‌اند، بی‌اطّلاع باشید، مبادا مانند سایر مردم که هیچ امیدی به آینده ندارند، غمگین باشید؛"
        },
        {
          "verse": 14,
          "usfm": "1TH.4.14",
          "line_type": "p",
          "text": "زیرا اگر ما معتقدیم که عیسی مرد و دوباره زنده شد، همچنین ایمان داریم که خدا آنانی را که در ایمان به عیسی مرده‌اند نیز همراه عیسی باز خواهد آورد."
        },
        {
          "verse": 15,
          "usfm": "1TH.4.15",
          "line_type": "p",
          "text": "ما این‌ را از تعالیم خداوند به شما می‌گوییم: آن کسانی از ما که تا روز آمدن خداوند زنده می‌مانیم، از مردگان پیشی نخواهیم گرفت."
        },
        {
          "verse": 16,
          "usfm": "1TH.4.16",
          "line_type": "p",
          "text": "در همان موقع که فریاد فرمان الهی و صدای رئیس فرشتگان و بانگ شیپور خداوند شنیده شود، خود خداوند از آسمان به زیر خواهد آمد و اوّل کسانی‌ که در ایمان به مسیح مرده‌اند، خواهند برخاست"
        },
        {
          "verse": 17,
          "usfm": "1TH.4.17",
          "line_type": "p",
          "text": "و سپس آن کسانی‌ که از میان ما زنده مانده‌اند همراه با آن‌ها در ابرها بالا برده خواهند شد تا در هوا با خداوند ملاقات نمایند و به‌این‌ترتیب ما همیشه با خداوند خواهیم بود."
        },
        {
          "verse": 18,
          "usfm": "1TH.4.18",
          "line_type": "p",
          "text": "پس شما باید یکدیگر را با این کلمات تشویق کنید."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 13,
          "text": "بازگشت مسیح"
        }
      ],
