  "chapters": [
    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 1,
      "chapter_usfm": "1TH.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.1.1",
          "line_type": "p",
          "text": "از طرف پولس و سیلاس و تیموتاؤس به کلیسای تسالونیکیان که به خدای پدر و عیسای مسیح خداوند تعلّق دارد: فیض و آرامش از آن شما باد."
        },
        {
          "verse": 2,
          "usfm": "1TH.1.2",
          "line_type": "p",
          "text": "ما همیشه خدا را به‌خاطر همۀ شما شکر می‌کنیم و همواره شما را در دعاهای خود به‌یاد می‌آوریم،"
        },
        {
          "verse": 3,
          "usfm": "1TH.1.3",
          "line_type": "p",
          "text": "و در حضور خدا که پدر ما است پیوسته فعّالیّت‌هایی را که در ایمان انجام می‌دهید و زحماتی را که با محبّت می‌کشید و امید پایداری را که به خداوندمان عیسای مسیح دارید به یاد می‌آوریم."
        },
        {
          "verse": 4,
          "usfm": "1TH.1.4",
          "line_type": "p",
          "text": "ای برادران، ما می‌دانیم که خدا شما را دوست دارد و شما را برگزیده است."
        },
        {
          "verse": 5,
          "usfm": "1TH.1.5",
          "line_type": "p",
          "text": "زیرا ما انجیل را تنها در قالب کلمات نزد شما نیاوردیم، بلکه باقدرت و با روح‌القدس و اطمینان کامل به حقّانیّت آن. شما می‌دانید وقتی در آنجا بودیم چگونه برای خیریّت شما با شما رفتار کردیم."
        },
        {
          "verse": 6,
          "usfm": "1TH.1.6",
          "line_type": "p",
          "text": "شما از سرمشق ما و خداوند پیروی کردید و اگرچه به‌خاطر پیام خدا رنج بسیار دیدید، آن‌ را با خوشی‌ای که روح‌القدس می‌دهد، پذیرفتید."
        },
        {
          "verse": 7,
          "usfm": "1TH.1.7",
          "line_type": "p",
          "text": "درنتیجه شما برای همۀ ایمان‌داران در مقدونیه و اَخائیه نمونه شدید."
        },
        {
          "verse": 8,
          "usfm": "1TH.1.8",
          "line_type": "p",
          "text": "زیرا پیام خداوند از جانب شما نه‌تنها تا مقدونیه و اَخائیه انتشار یافت، بلکه خبر ایمانتان به خدا به همه‌جا رسیده است. پس دیگر احتیاجی نیست که ما دربارۀ آن چیزی بگوییم،"
        },
        {
          "verse": 9,
          "usfm": "1TH.1.9",
          "line_type": "p",
          "text": "زیرا آنان از استقبال گرمی که از ما می‌کنید آگاهند و تعریف می‌کنند که چگونه شما بُت‌ها را ترک کرده به‌سوی خداوند بازگشت نمودید تا خدای زنده و حقیقی را خدمت کنید"
        },
        {
          "verse": 10,
          "usfm": "1TH.1.10",
          "line_type": "p",
          "text": "و چگونه در انتظار ظهور پسر او عیسی که از آسمان می‌آید به‌سر می‌برید. آری، همان عیسی که خدا او را پس از مرگ زنده ساخت، ما را از غضب آینده رهایی می‌بخشد."
        }
      ],
      "verse_count": 10,
      "headings": [
        {
          "before_verse": 2,
          "text": "زندگی و ایمان تسالونیکیان"
        }
      ],
      "footnotes": [
        {
          "verse": 4,
          "usfm": "1TH.1.4",
          "note_ref": "1‏:4",
          "note_type": "footnote",
          "references": [],
          "text": "روی سخن در اینجا با تمام ایمان‌داران است."
        }
      ],
