    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 2,
      "chapter_usfm": "1TH.2",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.2.1",
          "line_type": "p",
          "text": "خود شما ای برادران می‌دانید که آمدن ما نزد شما بی‌نتیجه نبود."
        },
        {
          "verse": 2,
          "usfm": "1TH.2.2",
          "line_type": "p",
          "text": "برعکس، چنان‌که اطّلاع دارید، پس از آن‌همه آزار و اهانت که در شهر فیلیپی دیدیم، با کمک خدا جرأت یافتیم مژدهٔ انجیلِ خدا را، با وجودِ مخالفت‌های شدید، به شما برسانیم."
        },
        {
          "verse": 3,
          "usfm": "1TH.2.3",
          "line_type": "p",
          "text": "اصرار ما به شما اشتباه و یا از روی انگیزه‌های ناپاک نبود و ما سعی نداشتیم کسی را فریب دهیم،"
        },
        {
          "verse": 4,
          "usfm": "1TH.2.4",
          "line_type": "p",
          "text": "امّا چون خدا ما را لایق دانسته است و انتشار مژدۀ انجیل را به عهدۀ ما گذاشته است، سخن می‌گوییم. منظور ما جلب رضایت انسان نیست، بلکه ما می‌خواهیم خدایی را خشنود کنیم که دل‌های ما را پیوسته می‌آزماید."
        },
        {
          "verse": 5,
          "usfm": "1TH.2.5",
          "line_type": "p",
          "text": "شما خوب می‌دانید و خدا شاهد است که ما هرگز چاپلوسی نکردیم و سخنان ما از روی طمع نبود."
        },
        {
          "verse": 6,
          "usfm": "1TH.2.6",
          "line_type": "p",
          "text": "و به هیچ وجه ما جویای احترام و ستایش مردم، خواه شما و خواه دیگران، نبودیم،"
        },
        {
          "verse": 7,
          "usfm": "1TH.2.7",
          "line_type": "p",
          "text": "اگرچه ما به‌عنوان رسولان مسیح حقّی به گردن شما داشتیم، ولی مانند مادری که فرزندان خود را پرورش می‌دهد، با شما به ملایمت رفتار کردیم."
        },
        {
          "verse": 8,
          "usfm": "1TH.2.8",
          "line_type": "p",
          "text": "به‌خاطر علاقه‌ای که نسبت به شما داشتیم، حاضر بودیم نه فقط مژدۀ انجیل خدا را به شما برسانیم، بلکه جان خود را نیز در راه شما فدا سازیم، چون شما برای ما بسیار عزیز شده بودید!"
        },
        {
          "verse": 9,
          "usfm": "1TH.2.9",
          "line_type": "p",
          "text": "ای برادران، به‌خاطر دارید که ما چگونه کار می‌کردیم و زحمت می‌کشیدیم و شب و روز مشغول کار بودیم تا در موقع اعلام مژدۀ انجیل خدا در میان شما بر هیچ‌کس تحمیل نشویم."
        },
        {
          "verse": 10,
          "usfm": "1TH.2.10",
          "line_type": "p",
          "text": "هم شما شاهد هستید و هم خدا که رفتار ما نسبت به شما ایمان‌داران تا چه اندازه پاک، درست و بی‌عیب بود."
        },
        {
          "verse": 11,
          "usfm": "1TH.2.11",
          "line_type": "p",
          "text": "شما خوب می‌دانید که رفتار ما با فردفرد شما درست مانند رفتار یک پدر با فرزندان خود بود."
        },
        {
          "verse": 12,
          "usfm": "1TH.2.12",
          "line_type": "p",
          "text": "ما شما را تشویق می‌کردیم، دل‌داری می‌دادیم و اصرار می‌ورزیدیم که زندگی و رفتار شما پسندیدۀ خدا باشد، آن خدایی که شما را به پادشاهی و جلال خود دعوت می‌کند."
        },
        {
          "verse": 13,
          "usfm": "1TH.2.13",
          "line_type": "p",
          "text": "پیوسته خدا را برای این نیز شکر می‌کنم که وقتی کلام خدا را از ما شنیدید، آن‌ را به‌عنوان پیامی از جانب بشر نپذیرفتید، بلکه آن‌ را از طرف خدا دانستید و درحقیقت همین‌طور هم هست، چنان‌که همان کلام اکنون نیز در میان شما ایمان‌داران عمل می‌کند."
        },
        {
          "verse": 14,
          "usfm": "1TH.2.14",
          "line_type": "p",
          "text": "ای برادران، شما درست به همان راهی می‌روید که کلیساهای یهودیه در اتّحاد با مسیح عیسای خداوند رفته‌اند، زیرا شما از هموطنان خود همان آزارهایی را دیده‌اید که آنان از یهودیان دیدند،"
        },
        {
          "verse": 15,
          "usfm": "1TH.2.15",
          "line_type": "p",
          "text": "‌یهودیانی که هم عیسای خداوند و هم انبیا را کشتند و بر ما هم سخت جفا رساندند؛ آن‌ها خدا را خشنود نمی‌سازند و با همۀ مردم دشمنی می‌کنند."
        },
        {
          "verse": 16,
          "usfm": "1TH.2.16",
          "line_type": "p",
          "text": "آن‌ها حتّی نمی‌گذارند ما به غیریهودیان موعظه کنیم تا نجات یابند. آن‌ها با این عمل خود پیمانۀ گناهان خود را پُرتر می‌سازند، تا سرانجام غضب خدا به‌کمال بر آن‌ها ریخته شود."
        },
        {
          "verse": 17,
          "usfm": "1TH.2.17",
          "line_type": "p",
          "text": "امّا ای برادران، چون برای مدّت کوتاهی، و آن هم جسماً، نه قلباً از شما جدا شدیم، چقدر بیشتر مشتاق دیدار شما شدیم و سخت می‌کوشیدیم تا دوباره شما را ببینیم."
        },
        {
          "verse": 18,
          "usfm": "1TH.2.18",
          "line_type": "p",
          "text": "آری، مایل بودیم نزد شما بیاییم و من، پولس، یکی دو بار خواستم بیایم، امّا شیطان مانع ما می‌شد."
        },
        {
          "verse": 19,
          "usfm": "1TH.2.19",
          "line_type": "p",
          "text": "برای ما چه امیدی یا شادمانی‌ای یا تاج افتخاری در حضور خداوند ما عیسای مسیح به هنگام آمدن او وجود دارد؟ مگر شما نیستید؟"
        },
        {
          "verse": 20,
          "usfm": "1TH.2.20",
          "line_type": "p",
          "text": "به‌راستی، شما مایۀ افتخار و شادمانی ما هستید!"
        }
      ],
      "verse_count": 20,
      "headings": [
        {
          "before_verse": 17,
          "text": "علاقۀ پولس برای دیدن آن‌ها"
        }
      ],
