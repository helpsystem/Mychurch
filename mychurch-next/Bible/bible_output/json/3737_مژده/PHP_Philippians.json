    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 4,
      "chapter_usfm": "PHP.4",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.4.1",
          "line_type": "p",
          "text": "بنابراین، ای برادران عزیز من، مشتاق دیدار شما هستم. شما مایۀ شادی و تاج افتخار من هستید. ای عزیزان، همچنان در اتّحاد خود با خداوند استوار باشید."
        },
        {
          "verse": 2,
          "usfm": "PHP.4.2",
          "line_type": "p",
          "text": "از خواهران خود، اِفُودیه، و سینتیخی استدعا دارم در خداوند توافق فکری داشته باشند."
        },
        {
          "verse": 3,
          "usfm": "PHP.4.3",
          "line_type": "p",
          "text": "و از تو، ای همکار صمیمی، تقاضا می‌کنم که این دو زن را کمک کنی، زیرا نام آن‌ها، با «کلیمانتوس» و سایر همکاران من که در انتشار مژدۀ انجیل تلاش کرده‌اند، در دفتر حیات ثبت شده است."
        },
        {
          "verse": 4,
          "usfm": "PHP.4.4",
          "line_type": "p",
          "text": "پیوسته در خداوند شاد باشید، بازهم می‌گویم شاد باشید!"
        },
        {
          "verse": 5,
          "usfm": "PHP.4.5",
          "line_type": "p",
          "text": "بگذارید ملایمت شما در رفتارتان با دیگران آشکار باشد. آمدن خداوند نزدیک است!"
        },
        {
          "verse": 6,
          "usfm": "PHP.4.6",
          "line_type": "p",
          "text": "نگران هیچ‌چیز نباشید، بلکه در هر مورد با دعا و مناجات و سپاسگزاری تقاضاهای خود را در پیشگاه خدا ابراز نمایید."
        },
        {
          "verse": 7,
          "usfm": "PHP.4.7",
          "line_type": "p",
          "text": "و آرامش خدا که بالاتر از فهم بشر است، دل‌ها و افکار شما را در مسیح عیسی حفظ خواهد کرد."
        },
        {
          "verse": 8,
          "usfm": "PHP.4.8",
          "line_type": "p",
          "text": "در خاتمه، ای برادران، دربارۀ هرآنچه راست، هرآنچه شریف، هرآنچه درست، هرآنچه پاک، هرآنچه دوست‌داشتنی، هرآنچه نیک‌نام و هرآنچه قابل‌ستایش، و هرآنچه عالی، بیندیشید."
        },
        {
          "verse": 9,
          "usfm": "PHP.4.9",
          "line_type": "p",
          "text": "چیزهایی را که از من آموختید و به‌ دست آوردید، یعنی آنچه را از من دیده و شنیده‌اید، سرمشق خود ساخته به‌عمل آورید که درآن‌صورت، خدایی که منبع آرامش است، با شما خواهد بود."
        },
        {
          "verse": 10,
          "usfm": "PHP.4.10",
          "line_type": "p",
          "text": "حال که پس از مدّتی دوباره مورد توجّه شما قرار گرفته‌ام، شادی عظیمی در خداوند یافته‌ام. البتّه شما همیشه به فکر من بوده‌اید، امّا فرصت ابراز آن‌ را نیافتید."
        },
        {
          "verse": 11,
          "usfm": "PHP.4.11",
          "line_type": "p",
          "text": "من به احتیاجات شخصی خود اشاره نمی‌کنم، زیرا آموخته‌ام در هر وضعی که باشم، قانع باشم."
        },
        {
          "verse": 12,
          "usfm": "PHP.4.12",
          "line_type": "p",
          "text": "من می‌دانم چگونه در فقر و تنگ‌دستی و یا در سعادتمندی زندگی کنم. به رمز زیستن در سیری و گرسنگی، در فراوانی و نیازمندی پی‌ برده‌ام."
        },
        {
          "verse": 13,
          "usfm": "PHP.4.13",
          "line_type": "p",
          "text": "من به‌وسیلهٔ مسیح که مرا تقویت می‌کند، توانایی روبرو شدن با هر موقعیّتی را دارم."
        },
        {
          "verse": 14,
          "usfm": "PHP.4.14",
          "line_type": "p",
          "text": "امّا شما لطف کرده شریک زحمات من شدید."
        },
        {
          "verse": 15,
          "usfm": "PHP.4.15",
          "line_type": "p",
          "text": "خود شما ای فیلپیان، خوب می‌دانید که در ابتدای اعلام مژدۀ انجیل وقتی من مقدونیه را ترک کردم، شما تنها کلیسایی بودید که در قبول مسئولیّت دخل و خرج من با من همکاری کردید."
        },
        {
          "verse": 16,
          "usfm": "PHP.4.16",
          "line_type": "p",
          "text": "حتّی زمانی‌‌که در «تَسالونیکی» بودم، یکی دو مرتبه مبلغی برای رفع احتیاجات من فرستادید."
        },
        {
          "verse": 17,
          "usfm": "PHP.4.17",
          "line_type": "p",
          "text": "من طالب هدایای مالی شما نیستم، بلکه می‌خواهم به پاداش نیکوکاری شما افزوده شود."
        },
        {
          "verse": 18,
          "usfm": "PHP.4.18",
          "line_type": "p",
          "text": "کمک مالی شما به دستم رسید و نه‌تنها کافی بلکه بیشتر از احتیاجاتم بود. هدایایی را که توسط «اپفرودیتُس» فرستادید، احتیاج مرا رفع کرده‌اند. عطایای شما هدیه‌ای خوش‌بو است، قربانی مقبولی که پسندیدۀ خدا است"
        },
        {
          "verse": 19,
          "usfm": "PHP.4.19",
          "line_type": "p",
          "text": "و خدای من همۀ احتیاجات شما را برحسب ثروت عظیم خود در مسیح عیسی رفع خواهد کرد."
        },
        {
          "verse": 20,
          "usfm": "PHP.4.20",
          "line_type": "p",
          "text": "پدر ما خدا را تا ابد جلال باد، آمین."
        },
        {
          "verse": 21,
          "usfm": "PHP.4.21",
          "line_type": "p",
          "text": "به همۀ مقدّسین در عیسای مسیح سلام برسانید. ایماندارانی که با من هستند به شما سلام می‌رسانند."
        },
        {
          "verse": 22,
          "usfm": "PHP.4.22",
          "line_type": "p",
          "text": "همۀ مقدّسین در اینجا و مخصوصاً ایماندارانی که در دربار قیصر هستند، به شما سلام می‌رسانند."
        },
        {
          "verse": 23,
          "usfm": "PHP.4.23",
          "line_type": "p",
          "text": "فیض خداوند ما عیسای مسیح با روح شما باد. آمین."
        }
      ],
      "verse_count": 23,
