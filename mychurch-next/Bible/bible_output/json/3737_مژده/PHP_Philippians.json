    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 2,
      "chapter_usfm": "PHP.2",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.2.1",
          "line_type": "p",
          "text": "حال که در اتّحاد با مسیح دل‌گرم هستید و محبّت، محرّک اصلی زندگی شما است، و اکنون که با روح‌القدس مصاحبت دارید و احساس مهر و شفقّت در بین شما وجود دارد،"
        },
        {
          "verse": 2,
          "usfm": "PHP.2.2",
          "line_type": "p",
          "text": "پس تقاضا می‌کنم شادی مرا به کمال رسانید و با یک‌دلی، توافقِ فکری، محبّت دو‌جانبه و هدف مشترک داشته باشید."
        },
        {
          "verse": 3,
          "usfm": "PHP.2.3",
          "line_type": "p",
          "text": "هیچ عملی را از روی جاه‌طلبی و غرور انجام ندهید، بلکه با فروتنی، دیگران را از خود بهتر بدانید."
        },
        {
          "verse": 4,
          "usfm": "PHP.2.4",
          "line_type": "p",
          "text": "به نفع دیگران فکر کنید و تنها در فکر خود نباشید."
        },
        {
          "verse": 5,
          "usfm": "PHP.2.5",
          "line_type": "p",
          "text": "پس همان طرز فکری را داشته باشید که عیسای مسیح داشت:"
        },
        {
          "verse": 6,
          "usfm": "PHP.2.6",
          "line_type": "q1",
          "text": "اگرچه او از ازل با خدا هم‌ذات بود،ولی حاضر نشد از برابر بودن با خدا به نفع خود استفاده کند،"
        },
        {
          "verse": 7,
          "usfm": "PHP.2.7",
          "line_type": "q1",
          "text": "بلکه خود را از مزایای آن محروم نمودهبه‌صورت یک غلام درآمد و شبیه انسان شد."
        },
        {
          "verse": 8,
          "usfm": "PHP.2.8",
          "line_type": "q1",
          "text": "چون او به شکل انسان در میان ما ظاهر گشت، خود را فروتن ساخت و از روی اطاعت حاضر شدمرگ، حتّی مرگ بر روی صلیب را بپذیرد."
        },
        {
          "verse": 9,
          "usfm": "PHP.2.9",
          "line_type": "q1",
          "text": "از این جهت خدا او را بسیار سرافراز نمودو نامی را که بالاتر از جمیع نام‌ها است به او عطا فرمود."
        },
        {
          "verse": 10,
          "usfm": "PHP.2.10",
          "line_type": "q1",
          "text": "تا این‌که همۀ موجوداتدر آسمان و روی زمین و زیر زمین،با شنیدن نام عیسی به زانو در آیند،"
        },
        {
          "verse": 11,
          "usfm": "PHP.2.11",
          "line_type": "q1",
          "text": "و همه برای جلال خدای پدر، با زبان خود اعتراف کنندکه عیسای مسیح، خداوند است."
        },
        {
          "verse": 12,
          "usfm": "PHP.2.12",
          "line_type": "p",
          "text": "بنابراین، ای عزیزان من، همان‌طور که وقتی با شما بودم همیشه از من اطاعت می‌کردید، اکنون که از شما دور هستم، بسی مهم‌تر است که به اطاعت خود ادامه داده با ترس‌ولرز نجات خود را به‌سوی کمال پیش ببرید،"
        },
        {
          "verse": 13,
          "usfm": "PHP.2.13",
          "line_type": "p",
          "text": "زیرا خدا است که برای خشنودی خود، هم اراده و هم قدرت انجام هرکاری را در شما ایجاد می‌کند."
        },
        {
          "verse": 14,
          "usfm": "PHP.2.14",
          "line_type": "p",
          "text": "هر کاری را بدون شکایت و همهمه انجام دهید"
        },
        {
          "verse": 15,
          "usfm": "PHP.2.15",
          "line_type": "p",
          "text": "تا در زمانی‌‌که بین نسلی کج‌رو و منحرف هستید، بدون تقصیر و بی‌آلایش، فرزندان بی‌عیب خدا باشید و مانند ستارگان در جهان تاریک بدرخشید."
        },
        {
          "verse": 16,
          "usfm": "PHP.2.16",
          "line_type": "p",
          "text": "پیام حیات را محکم نگه دارید. اگر چنین کنید، من دلیلی خواهم داشت که در روز عظیم مسیح به شما افتخار کنم، زیرا این نشان خواهد داد که کار و زحمت من بیهوده نبوده است."
        },
        {
          "verse": 17,
          "usfm": "PHP.2.17",
          "line_type": "p",
          "text": "حتّی اگر لازم باشد که خون من مانند شرابِ وقف‌شده روی هدیۀ قربانی ایمان شما ریخته شود، در انجام این‌ کار شادم و با همۀ شما شادی می‌کنم."
        },
        {
          "verse": 18,
          "usfm": "PHP.2.18",
          "line_type": "p",
          "text": "شما نیز باید شاد باشید و با من شادی کنید."
        },
        {
          "verse": 19,
          "usfm": "PHP.2.19",
          "line_type": "p",
          "text": "امیدوارم که با خواست عیسای خداوند، به‌زودی تیموتاؤس را نزد شما بفرستم تا با آگاهی یافتن از احوال شما آسوده ‌خاطر شوم،"
        },
        {
          "verse": 20,
          "usfm": "PHP.2.20",
          "line_type": "p",
          "text": "زیرا او تنها کسی است که با من هم‌دل بوده و خالصانه در فکر شما است."
        },
        {
          "verse": 21,
          "usfm": "PHP.2.21",
          "line_type": "p",
          "text": "دیگران همه در فکر منافع خود هستند نه در فکر پیشرفت کار عیسای مسیح!"
        },
        {
          "verse": 22,
          "usfm": "PHP.2.22",
          "line_type": "p",
          "text": "شما تیموتاؤس را خوب می‌شناسید و می‌دانید که او چگونه با من، مانند یک پسر با پدر خود، در انتشار مژدۀ انجیل خدمت کرده است."
        },
        {
          "verse": 23,
          "usfm": "PHP.2.23",
          "line_type": "p",
          "text": "پس امیدوارم به مجرّد این‌که وضع من معلوم شد، او را نزد شما بفرستم."
        },
        {
          "verse": 24,
          "usfm": "PHP.2.24",
          "line_type": "p",
          "text": "و اطمینان دارم که با کمک خداوند، خود من نیز به‌زودی نزد شما خواهم آمد."
        },
        {
          "verse": 25,
          "usfm": "PHP.2.25",
          "line_type": "p",
          "text": "لازم دانستم «اپفرودیتُس» را که برادر، همکار و همرزم من بوده است و شما او را برای خدمت من و رفع احتیاجاتم فرستاده بودید، نزد شما برگردانم،"
        },
        {
          "verse": 26,
          "usfm": "PHP.2.26",
          "line_type": "p",
          "text": "زیرا او برای همۀ شما دلتنگ شده و از این‌که از بیماری او باخبر گشته‌اید، ناراحت شده است."
        },
        {
          "verse": 27,
          "usfm": "PHP.2.27",
          "line_type": "p",
          "text": "راستش این است که او مریض و حتّی مُشرف به موت بود، امّا خدا بر او رحم کرد و نه‌تنها بر او، بلکه بر من نیز رحم فرمود، مبادا این غم بر غم‌های دیگر من افزوده شود."
        },
        {
          "verse": 28,
          "usfm": "PHP.2.28",
          "line_type": "p",
          "text": "پس مایل هستم هرچه زودتر او را نزد شما بفرستم تا شما با دیدن او بار دیگر شاد شوید و به‌این‌وسیله غم من هم کمتر خواهد شد."
        },
        {
          "verse": 29,
          "usfm": "PHP.2.29",
          "line_type": "p",
          "text": "پس با شادی او را به‌عنوان برادری در خداوند بپذیرید. به افرادی مثل او احترام بگذارید،"
        },
        {
          "verse": 30,
          "usfm": "PHP.2.30",
          "line_type": "p",
          "text": "زیرا او در راه خدمت مسیح تا سرحد مرگ پیش رفت، و برای جبران عدم خدمت شما به من، جان خود را به خطر انداخت."
        }
      ],
      "verse_count": 30,
      "headings": [
