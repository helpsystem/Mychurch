  "chapters": [
    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 1,
      "chapter_usfm": "PHP.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.1.1",
          "line_type": "p",
          "text": "از طرف پولس و تیموتاؤس، غلامان مسیح عیسی، به همۀ مقدّسین شهر فیلیپی که با عیسای مسیح متّحدند، از جمله سرپرستان و خادمان."
        },
        {
          "verse": 2,
          "usfm": "PHP.1.2",
          "line_type": "p",
          "text": "فیض و آرامش خدای پدر و عیسای مسیح خداوند با شما باد."
        },
        {
          "verse": 3,
          "usfm": "PHP.1.3",
          "line_type": "p",
          "text": "هر وقت که شما را به‌یاد می‌آورم، خدای خود را شکر می‌گویم،"
        },
        {
          "verse": 4,
          "usfm": "PHP.1.4",
          "line_type": "p",
          "text": "و در تمام دعاهایم نام شما را با شادی ذکر می‌کنم،"
        },
        {
          "verse": 5,
          "usfm": "PHP.1.5",
          "line_type": "p",
          "text": "زیرا شما در انتشار مژدۀ انجیل از اوّلین روز شنیدن آن تا‌به‌حال، با من شریک بوده‌اید."
        },
        {
          "verse": 6,
          "usfm": "PHP.1.6",
          "line_type": "p",
          "text": "من اطمینان دارم آن خدایی که در شما کار نیکویی را شروع کرد، آن‌ را تا روز مسیح عیسی به کمال خواهد رسانید."
        },
        {
          "verse": 7,
          "usfm": "PHP.1.7",
          "line_type": "p",
          "text": "من حقّ دارم که دربارۀ شما چنین احساسی داشته باشم، زیرا همیشه در دل من هستید و من چه در زندان باشم و چه آزاد مشغول دفاع و پشتیبانی از مژدۀ انجیل، شما را در فیض خدا با خود شریک می‌دانم."
        },
        {
          "verse": 8,
          "usfm": "PHP.1.8",
          "line_type": "p",
          "text": "خدا شاهد است که تا چه اندازه با احساسات عمیقی که از مسیح سرچشمه گرفته، مشتاق دیدار شما هستم."
        },
        {
          "verse": 9,
          "usfm": "PHP.1.9",
          "line_type": "p",
          "text": "دعایم این است که محبّت شما همراه با آگاهی و کمال دانایی، بیشتر و بیشتر شود"
        },
        {
          "verse": 10,
          "usfm": "PHP.1.10",
          "line_type": "p",
          "text": "تا همه‌‌چیز را بیازمایید و عالی‌ترین آن‌ها را انتخاب کنید. آن‌وقت در روز عظیم مسیح بی‌عیب و بی‌تقصیر خواهید بود."
        },
        {
          "verse": 11,
          "usfm": "PHP.1.11",
          "line_type": "p",
          "text": "همچنین دعا می‌کنم که زندگی شما از ثمرات نیکی مطلق که به‌وسیلهٔ عیسای مسیح برای جلال و ستایش خدا به دست می‌آید، سرشار گردد."
        },
        {
          "verse": 12,
          "usfm": "PHP.1.12",
          "line_type": "p",
          "text": "ای برادران، می‌خواهم بدانید که آنچه به ‌سر من آمده است درواقع به پیشرفت انجیل کمک کرده است،"
        },
        {
          "verse": 13,
          "usfm": "PHP.1.13",
          "line_type": "p",
          "text": "تا آنجا که تمام اعضای گارد امپراتوری و سایرین نیز متوجّه شدند که من به‌خاطر مسیح زندانی شده‌ام."
        },
        {
          "verse": 14,
          "usfm": "PHP.1.14",
          "line_type": "p",
          "text": "از طرف دیگر، بسیاری از ایمان‌داران به‌ سبب زندانی شدن من به‌قدری قوی‌دل شده‌اند که با جرأت بیشتری پیام خدا را بدون ترس اعلام کنند."
        },
        {
          "verse": 15,
          "usfm": "PHP.1.15",
          "line_type": "p",
          "text": "البتّه بعضی‌ها، از روی حسادت و رقابت، به مسیح بشارت می‌دهند، ولی دیگران این‌ کار را با حُسن نیّت انجام می‌دهند."
        },
        {
          "verse": 16,
          "usfm": "PHP.1.16",
          "line_type": "p",
          "text": "این‌ها از روی محبّت چنین می‌کنند، زیرا می‌دانند که من به‌خاطر دفاع از مژدۀ انجیل در اینجا هستم."
        },
        {
          "verse": 17,
          "usfm": "PHP.1.17",
          "line_type": "p",
          "text": "ولی دیگران به‌خاطر جاه‌طلبی، به مسیح بشارت می‌دهند، نه از روی صمیمیّت، زیرا تصوّر می‌کنند از این راه می‌توانند بار زحمت مرا در زندان سنگین‌تر سازند."
        },
        {
          "verse": 18,
          "usfm": "PHP.1.18",
          "line_type": "p",
          "text": "چه اهمیّت دارد؟ از هر راهی باشد، خواه از روی نیّت درست یا نادرست، مسیح به مردم اعلام می‌شود و این امر مایۀ شادی من است. آری من شادم و همچنان شادی خواهم کرد."
        },
        {
          "verse": 19,
          "usfm": "PHP.1.19",
          "line_type": "p",
          "text": "زیرا می‌دانم دعاهای شما و یاری روح عیسای مسیح، باعث رهایی من خواهند شد."
        },
        {
          "verse": 20,
          "usfm": "PHP.1.20",
          "line_type": "p",
          "text": "انتظار شدید و امید من این است که هرگز سرافکنده نشوم، بلکه اکنون با دلیری کامل، مانند همیشه مسیح را در وجود خود جلال دهم، خواه در مرگ و خواه در زندگی."
        },
        {
          "verse": 21,
          "usfm": "PHP.1.21",
          "line_type": "p",
          "text": "زیرا برای من زنده بودن، مسیح است و مردن، منفعت."
        },
        {
          "verse": 22,
          "usfm": "PHP.1.22",
          "line_type": "p",
          "text": "امّا اگر زنده ماندن من ثمرۀ نیکویی داشته باشد، من نمی‌دانم کدام را انتخاب کنم."
        },
        {
          "verse": 23,
          "usfm": "PHP.1.23",
          "line_type": "p",
          "text": "بین دوراهی گیر کرده‌ام، چراکه اشتیاق دارم که این زندگی را ترک کنم و با مسیح باشم که خیلی بهتر است،"
        },
        {
          "verse": 24,
          "usfm": "PHP.1.24",
          "line_type": "p",
          "text": "امّا به‌خاطر شما زنده ماندن من واجب‌تر است."
        },
        {
          "verse": 25,
          "usfm": "PHP.1.25",
          "line_type": "p",
          "text": "با چنین اعتمادی یقین دارم که زنده خواهم ماند و برای پیشرفت و شادمانی شما در ایمان با شما خواهم بود،"
        },
        {
          "verse": 26,
          "usfm": "PHP.1.26",
          "line_type": "p",
          "text": "تا بار دیگر با آمدنم نزد شما، افتخار شما در عیسای مسیح به‌ سبب من بیشتر گردد."
        },
        {
          "verse": 27,
          "usfm": "PHP.1.27",
          "line_type": "p",
          "text": "به‌هرحال، طوری زندگی کنید که رفتار شما شایستۀ انجیل مسیح باشد و من چه بیایم و شما را ببینم و چه نیایم، مایلم دربارۀ شما بشنوم که در یگانگی روح پابرجا هستید و با هماهنگی پیوسته دست به دست یکدیگر داده به‌خاطر ایمان انجیل تلاش می‌کنید."
        },
        {
          "verse": 28,
          "usfm": "PHP.1.28",
          "line_type": "p",
          "text": "به هیچ وجه از مخالفین نترسید، زیرا این شهامت شما به آن‌ها ثابت می‌کند که به‌سوی هلاکت می‌روند و شما نجات خواهید یافت و این هم از خدا است."
        },
        {
          "verse": 29,
          "usfm": "PHP.1.29",
          "line_type": "p",
          "text": "چون این امتیاز به شما عطا شده است که نه‌تنها به مسیح ایمان آورید، بلکه به‌خاطر او نیز رنج و زحمت ببینید،"
        },
        {
          "verse": 30,
          "usfm": "PHP.1.30",
          "line_type": "p",
          "text": "زیرا شما نیز به همان مبارزه‌ای داخل شده‌اید که من داشتم. شما ناظر آن بودید و اطّلاع دارید که هنوز هم گرفتار آن هستم."
        }
      ],
      "verse_count": 30,
      "headings": [
        {
          "before_verse": 3,
          "text": "دعای پولس برای آن‌ها"
        },
        {
          "before_verse": 12,
          "text": "زندگی در مسیح"
        }
      ],
