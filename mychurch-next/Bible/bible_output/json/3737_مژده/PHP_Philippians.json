    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 3,
      "chapter_usfm": "PHP.3",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.3.1",
          "line_type": "p",
          "text": "خلاصه این‌که ای برادران من، در اتّحاد خود با خداوند شاد باشید. تکرار آنچه قبلاً نوشته بودم برای من زحمتی نیست، زیرا می‌دانم که این برای امنیّت شما است."
        },
        {
          "verse": 2,
          "usfm": "PHP.3.2",
          "line_type": "p",
          "text": "از آن سگ‌ها و کارهای پست ایشان و آنانی که بر ختنه اصرار دارند، بر حذر باشید."
        },
        {
          "verse": 3,
          "usfm": "PHP.3.3",
          "line_type": "p",
          "text": "زیرا ختنه‌شدگان واقعی ما هستیم، نه آن‌ها؛ ما به‌وسیلهٔ روح، خدا را می‌پرستیم و به مسیح افتخار می‌کنیم و به امتیازات ظاهری اتّکایی نداریم،"
        },
        {
          "verse": 4,
          "usfm": "PHP.3.4",
          "line_type": "p",
          "text": "اگرچه من حقّ دارم که به این مزایا متّکی باشم. اگر دیگران تصوّر می‌کنند که حقّ دارند به امتیازات ظاهری متّکی باشند، من حقّ بیشتری دارم."
        },
        {
          "verse": 5,
          "usfm": "PHP.3.5",
          "line_type": "p",
          "text": "من در هشتمین روز تولّد خود ختنه شدم و به‌طور مادرزاد، یک اسرائیلی از طایفۀ بنیامین و یک عبرانی اصیل هستم. از لحاظ رعایت شریعت، فریسی بودم،"
        },
        {
          "verse": 6,
          "usfm": "PHP.3.6",
          "line_type": "p",
          "text": "و از لحاظ تعصّب، به کلیسا جفا می‌رسانیدم و مطابق معیارهای شریعت، من یک مرد بی‌عیب محسوب می‌شدم."
        },
        {
          "verse": 7,
          "usfm": "PHP.3.7",
          "line_type": "p",
          "text": "امّا هرچه به نفع من بود آن‌ را به‌خاطر مسیح ضرر محسوب می‌کنم."
        },
        {
          "verse": 8,
          "usfm": "PHP.3.8",
          "line_type": "p",
          "text": "علاوه بر این، همه‌‌چیز را به‌خاطر امتیازی بسیار ارزنده‌تر، یعنی شناختن عیسای مسیح خداوند خود زیان می‌دانم. درواقع، من به‌خاطر او همه‌‌چیز را از دست داده‌ام و همه‌‌چیز را زباله شمردم تا به‌این‌وسیله مسیح را به دست آورم"
        },
        {
          "verse": 9,
          "usfm": "PHP.3.9",
          "line_type": "p",
          "text": "و کاملاً با او متّحد شوم. من دیگر به نیکی خود که از انجام احکام شریعت به دست می‌آید، متّکی نیستم، بلکه به‌وسیلهٔ ایمان به مسیح، دارای نیکی مطلق شده‌ام. این نیکی بر ایمان استوار است و از خدا سرچشمه می‌گیرد."
        },
        {
          "verse": 10,
          "usfm": "PHP.3.10",
          "line_type": "p",
          "text": "یگانه آرزوی من این است که مسیح را کاملاً بشناسم و قدرت قیامت او را در وجود خود درک کنم و در رنج‌های او شریک گشته در مرگ او همشکل او شوم،"
        },
        {
          "verse": 11,
          "usfm": "PHP.3.11",
          "line_type": "p",
          "text": "با این امید که من نیز به رستاخیز از مردگان نائل گردم."
        },
        {
          "verse": 12,
          "usfm": "PHP.3.12",
          "line_type": "p",
          "text": "من نمی‌گویم که هم‌اکنون این‌ را به دست آورده‌ام و یا به کمال رسیده‌ام، بلکه آن‌ را دنبال می‌کنم تا به چنگ آورم، همان‌طور که مسیح نیز مرا به‌خاطر آن به چنگ آورده است."
        },
        {
          "verse": 13,
          "usfm": "PHP.3.13",
          "line_type": "p",
          "text": "ای برادران، من ادّعا نمی‌کنم که تا‌به‌حال آن‌ را به چنگ آورده‌ام، ولی تنها کار من این است که آنچه را در پشت سر من قرار دارد فراموش کنم و برای رسیدن به آنچه در پیش است، بکوشم."
        },
        {
          "verse": 14,
          "usfm": "PHP.3.14",
          "line_type": "p",
          "text": "مستقیماً به‌طرف هدف می‌دوم تا جایزۀ دعوت خدا را برای یک زندگی آسمانی در عیسای مسیح به دست آورم."
        },
        {
          "verse": 15,
          "usfm": "PHP.3.15",
          "line_type": "p",
          "text": "پس همۀ ما که روحاً بالغ هستیم، باید چنین طرز تفکّری داشته باشیم؛ و اگر شما فکر دیگری دارید، خدا این‌ را هم به شما آشکار خواهد ساخت."
        },
        {
          "verse": 16,
          "usfm": "PHP.3.16",
          "line_type": "p",
          "text": "درهرحال ما باید مطابق حقایقی که کسب کرده‌ایم، زندگی کنیم."
        },
        {
          "verse": 17,
          "usfm": "PHP.3.17",
          "line_type": "p",
          "text": "ای برادران من، همۀ شما از من سرمشق بگیرید و به کسانی‌ که از نمونۀ ما پیروی می‌کنند، نگاه کنید."
        },
        {
          "verse": 18,
          "usfm": "PHP.3.18",
          "line_type": "p",
          "text": "بارها این‌ را به شما گفته‌ام و بار دیگر آن‌ را با اشک خود تکرار می‌کنم که عدّۀ زیادی طوری زندگی می‌کنند که گویی دشمنان صلیب مسیح هستند."
        },
        {
          "verse": 19,
          "usfm": "PHP.3.19",
          "line_type": "p",
          "text": "آخر و عاقبت آن‌ها هلاکت و خدای ایشان، امیال جسمانی آن‌ها است و افتخاراتشان در رسوایی و شرمساری است. آن‌ها افکار خود را به چیزهای دنیوی مشغول می‌سازند،"
        },
        {
          "verse": 20,
          "usfm": "PHP.3.20",
          "line_type": "p",
          "text": "امّا ما دارای تابعیّت کشور آسمانی بوده با اشتیاق منتظر آمدن عیسای مسیح خداوند هستیم که به‌عنوان نجات‌دهنده از آسمان می‌آید."
        },
        {
          "verse": 21,
          "usfm": "PHP.3.21",
          "line_type": "p",
          "text": "او طوری بدن‌های ضعیف و فانی ما را تغییر خواهد داد تا به بدن پُرشکوه او شباهت یابند و این‌ کار را با همان قدرتی که همه‌‌چیز را تحت فرمان خود درمی‌آورد، انجام خواهد داد."
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 12,
          "text": "دویدن به‌سوی هدف"
        }
      ],
      "footnotes": [
        {
