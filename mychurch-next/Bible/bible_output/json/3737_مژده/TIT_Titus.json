{
  "book_id": "TIT",
  "book_name_en": "Titus",
  "book_name_fa": "تیتوس",
  "testament": "NT",
  "version_id": 3737,
  "version_abbr": "مژده",
  "version_name": "مژده برای عصر جدید - ویرایش ۲۰۲۳",
  "language": "fa",
