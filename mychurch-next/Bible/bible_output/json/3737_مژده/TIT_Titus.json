  "chapters": [
    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 1,
      "chapter_usfm": "TIT.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.1.1",
          "line_type": "p",
          "text": "از طرف پولس، بندۀ خدا و رسول عیسای مسیح. من مأموریت یافتم که ایمان برگزیدگان خدا را تقویت کنم و حقیقتی را که با خداشناسی سازگار است، بیان نمایم."
        },
        {
          "verse": 2,
          "usfm": "TIT.1.2",
          "line_type": "p",
          "text": "این حقیقت بر اساس امید به حیات جاودانی است. خدا که هرگز دروغ نمی‌گوید، در ازل وعدۀ آن حیات را به ما داد"
        },
        {
          "verse": 3,
          "usfm": "TIT.1.3",
          "line_type": "p",
          "text": "و در زمان معیّن، آن وعده در پیامی که اعلام آن به دستور نجات‌دهندۀ ما خدا، به من سپرده شد، آشکار گردید."
        },
        {
          "verse": 4,
          "usfm": "TIT.1.4",
          "line_type": "p",
          "text": "به تیطُس فرزند حقیقی‏‌ام که در یک ایمان مشترکیم، خدای پدر و مسیح عیسی نجات‌دهندۀ ما، به تو فیض و آرامش عطا فرماید."
        },
        {
          "verse": 5,
          "usfm": "TIT.1.5",
          "line_type": "p",
          "text": "تو را در جزیره کریت باقی گذاشتم تا کارهای عقب افتاده را سامان دهی و چنان‌که شخصاً به تو دستور دادم، مشایخی برای کلیساها در هر شهر بگماری."
        },
        {
          "verse": 6,
          "usfm": "TIT.1.6",
          "line_type": "p",
          "text": "مشایخ باید اشخاصی بی‌عیب و بی‌آلایش و شوهر یک زن و دارای فرزندان با ایمانی باشند که نتوان آن‌ها را به هرزگی و سرکشی متّهم ساخت."
        },
        {
          "verse": 7,
          "usfm": "TIT.1.7",
          "line_type": "p",
          "text": "زیرا سرپرست کلیسا چون مسئول کار خدا است، باید بی‌عیب باشد، نه خودرأی، نه تندخو، نه مست باده، نه جنگجو و نه پول‌پرست."
        },
        {
          "verse": 8,
          "usfm": "TIT.1.8",
          "line_type": "p",
          "text": "بلکه باید مهمان‌نواز، نیک‌خواه، خویشتن‌دار، عادل، پاک و منظبط باشد."
        },
        {
          "verse": 9,
          "usfm": "TIT.1.9",
          "line_type": "p",
          "text": "او باید به پیام قابل‌ اعتمادی که تعلیم داده شده است، محکم بچسبد تا بتواند دیگران را با تعلیم صحیح تشویق نموده مخالفان را مُجاب سازد."
        },
        {
          "verse": 10,
          "usfm": "TIT.1.10",
          "line_type": "p",
          "text": "زیرا افراد سرکش، یاوه‌سرا و گمراه‌کننده بسیارند، بخصوص در بین نوایمانان یهودی‌نژاد."
        },
        {
          "verse": 11,
          "usfm": "TIT.1.11",
          "line_type": "p",
          "text": "لازم است که جلوی دهان آن‌ها را گرفت، زیرا برای کسب منافع نامشروع، با تعلیم نادرست، خانواده‌ها را به کلّی تباه می‌سازند."
        },
        {
          "verse": 12,
          "usfm": "TIT.1.12",
          "line_type": "p",
          "text": "یکی از خودشان که او را نبی می‌خواند گفت: «اهالی کریت همیشه دروغ‌گو و درّنده‌خو، پُرخور و تنبل هستند.»"
        },
        {
          "verse": 13,
          "usfm": "TIT.1.13",
          "line_type": "p",
          "text": "این گفته درست است. به این دلیل آن‌ها را سخت توبیخ کن تا در ایمان سالم باشند"
        },
        {
          "verse": 14,
          "usfm": "TIT.1.14",
          "line_type": "p",
          "text": "و به افسانه‌های یهود و احکام مردمانی که حقیقت را رد کرده‌اند، گوش ندهند."
        },
        {
          "verse": 15,
          "usfm": "TIT.1.15",
          "line_type": "p",
          "text": "برای پاکان همه‌‌چیز پاک است، امّا برای کسانی‌ که آلوده و بی‌ایمان هستند، هیچ‌چیز پاک نیست. زیرا هم افکارشان و هم وجدانشان آلوده است."
        },
        {
          "verse": 16,
          "usfm": "TIT.1.16",
          "line_type": "p",
          "text": "ادّعا دارند که خدا را می‌شناسند، امّا کارهایشان این ادّعا را تکذیب می‌کند. آن‌ها نفرت‌انگیز و سرکش هستند و نالایق برای انجام هر کار نیک."
        }
      ],
      "verse_count": 16,
      "headings": [
        {
          "before_verse": 5,
          "text": "کار تیطُس در کریت"
        },
        {
          "before_verse": 10,
          "text": "معلّمین گمراه کننده"
        }
      ],
