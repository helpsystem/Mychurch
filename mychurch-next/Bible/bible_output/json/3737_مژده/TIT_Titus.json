    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 2,
      "chapter_usfm": "TIT.2",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.2.1",
          "line_type": "p",
          "text": "امّا تو، دربارهٔ مطالبی که مطابق تعلیم صحیح است سخن بگو."
        },
        {
          "verse": 2,
          "usfm": "TIT.2.2",
          "line_type": "p",
          "text": "به مردان سال‌خورده دستور بده که باوقار، سنگین و خویشتن‌دار باشند و سالم و قوی در ایمان، محبّت و پایداری."
        },
        {
          "verse": 3,
          "usfm": "TIT.2.3",
          "line_type": "p",
          "text": "همچنین به زنان سال‌خورده دستور بده که رفتاری خداپسندانه داشته باشند و تهمت نزنند و اسیر شراب نباشند؛ بلکه آنچه را که نیکو است تعلیم دهند"
        },
        {
          "verse": 4,
          "usfm": "TIT.2.4",
          "line_type": "p",
          "text": "تا زن‌های جوان را تربیت کنند که شوهر و فرزندانشان را دوست بدارند"
        },
        {
          "verse": 5,
          "usfm": "TIT.2.5",
          "line_type": "p",
          "text": "و خویشتن‌دار، پاک‌دامن، خانه‌دار، مهربان و مطیع شوهرانشان باشند تا هیچ‌کس از پیام خدا بدگویی نکند."
        },
        {
          "verse": 6,
          "usfm": "TIT.2.6",
          "line_type": "p",
          "text": "همچنین به مردان جوان اصرار کن که خویشتن‌دار باشند."
        },
        {
          "verse": 7,
          "usfm": "TIT.2.7",
          "line_type": "p",
          "text": "زندگی تو در هر مورد باید نمونه‌ای از کارهای نیک باشد و در تعلیم خود صمیمی و جدّی باش."
        },
        {
          "verse": 8,
          "usfm": "TIT.2.8",
          "line_type": "p",
          "text": "طوری سخن بگو که مورد ایراد واقع نشوی تا دشمنان ما از این‌که دلیلی برای بدگویی از ما نمی‌یابند، شرمسار گردند."
        },
        {
          "verse": 9,
          "usfm": "TIT.2.9",
          "line_type": "p",
          "text": "به غلامان بگو که در هر امر مطیع اربابان خود باشند و بدون چون‌وچرا، ایشان را راضی سازند."
        },
        {
          "verse": 10,
          "usfm": "TIT.2.10",
          "line_type": "p",
          "text": "دزدی نکنند، بلکه کاملاً امین باشند تا با کارهای نیکوی خود بتوانند به احترامِ تعلیم نجات‌دهندۀ ما خدا، بیفزایند."
        },
        {
          "verse": 11,
          "usfm": "TIT.2.11",
          "line_type": "p",
          "text": "زیرا فیض خدا ظاهر شده و نجات را در برابر همه قرار داده است"
        },
        {
          "verse": 12,
          "usfm": "TIT.2.12",
          "line_type": "p",
          "text": "و به ما می‌آموزد که راه‌های شرارت‌آمیز و شهوات دنیوی را ترک کرده با خویشتن‌داری، عدالت و خداترسی در این جهان زندگی کنیم."
        },
        {
          "verse": 13,
          "usfm": "TIT.2.13",
          "line_type": "p",
          "text": "و در عَین حال، در انتظار امید متبارک خود، یعنی ظهور پُرجلال خدای بزرگ و نجات‌دهندۀ ما عیسای مسیح باشیم."
        },
        {
          "verse": 14,
          "usfm": "TIT.2.14",
          "line_type": "p",
          "text": "او جان خود را در راه ما داد تا ما را از هرگونه شرارت آزاد سازد و ما را قومی پاک بگرداند که فقط به خودش تعلّق داشته و مشتاق نیکوکاری باشیم."
        },
        {
          "verse": 15,
          "usfm": "TIT.2.15",
          "line_type": "p",
          "text": "دربارۀ این مطالب سخن بگو و شنوندگانت را در کمال اقتدار تشویق و توبیخ کن. اجازه نده کسی تو را حقیر بشمارد."
        }
      ],
      "verse_count": 15,
