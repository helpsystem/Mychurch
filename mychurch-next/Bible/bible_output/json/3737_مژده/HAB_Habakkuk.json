    {
      "schema_version": 6,
      "book_id": "HAB",
      "chapter": 3,
      "chapter_usfm": "HAB.3",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAB.3.1",
          "line_type": "p",
          "text": "این است دعای حبقوق نبی:"
        },
        {
          "verse": 2,
          "usfm": "HAB.3.2",
          "line_type": "q1",
          "text": "خداوندا، خبری را که به من فرمودی شنیدمو از شنیدن آن ترس مرا فراگرفت.بار دیگر کارهای عظیمی را که در دوران گذشته انجام می‌دادیبه ما نشان بدهو در هنگام غضب خود، رحمتت را به‌یاد آور."
        },
        {
          "verse": 3,
          "usfm": "HAB.3.3",
          "line_type": "q1",
          "text": "خدا از تیمان برمی‌گردد؛خدای قدّوس از کوهستان فاران می‌آید.جلال او آسمان‌ها را پوشانده،و زمین از ستایش او پُر است."
        },
        {
          "verse": 4,
          "usfm": "HAB.3.4",
          "line_type": "q1",
          "text": "پرتو او مثل نورِ صاعقهٔ درخشان استو از دست‌هایش که قدرت او در آن‌ها نهفته است، نور می‌تابد."
        },
        {
          "verse": 5,
          "usfm": "HAB.3.5",
          "line_type": "q1",
          "text": "مرض را پیشاپیش خود می‌فرستدو به مرگ امر می‌کند که به‌دنبالش بیاید."
        },
        {
          "verse": 6,
          "usfm": "HAB.3.6",
          "line_type": "q1",
          "text": "هنگامی‌که می‌ایستد، زمین می‌لرزدو چون می‌نگرد، قوم‌ها از ترس می‌لرزند.کوه‌های جاودانی خُرد می‌شوندو تپّه‌های ابدی که در زمان‌های قدیم بر آن‌ها قدم می‌زد،از هم‌ پاشیده می‌شوند."
        },
        {
          "verse": 7,
          "usfm": "HAB.3.7",
          "line_type": "q1",
          "text": "مردم کوشان را ترسانو مِدیان را لرزان دیدم."
        },
        {
          "verse": 8,
          "usfm": "HAB.3.8",
          "line_type": "q1",
          "text": "خداوندا، آیا رودها تو را خشمگین ساختند؟آیا دریاها تو را غضبناک کردند؟تو بر بالای ابرها عبور کردی،و ابرهای توفانی ارّابه‌ات گشتند،و تو پیروزی برای مردم خود آوردی."
        },
        {
          "verse": 9,
          "usfm": "HAB.3.9",
          "line_type": "q1",
          "text": "کمانت را آماده کردیو تیرت را در کمان گذاشتیو زمین را با صاعقه شکافتی."
        },
        {
          "verse": 10,
          "usfm": "HAB.3.10",
          "line_type": "q1",
          "text": "کو‌ه‌ها تو را دیدند و به لرزه افتادند.سیلاب‌ها جاری شدند،آب‌های عمیق خروشیدندو امواجشان بالا آمد."
        },
        {
          "verse": 11,
          "usfm": "HAB.3.11",
          "line_type": "q1",
          "text": "از نور تیرهایت و از پرتو نیزه‌های درخشانت،آفتاب و مهتاب بی‌حرکت ایستادند."
        },
        {
          "verse": 12,
          "usfm": "HAB.3.12",
          "line_type": "q1",
          "text": "با قهر و غضب، جهان را پیمودی و با‌خشم،قوم‌های دنیا را پایمال کردی."
        },
        {
          "verse": 13,
          "usfm": "HAB.3.13",
          "line_type": "q1",
          "text": "برای نجات قوم خود شتافتیو پادشاه برگزیده‌ات را نجات دادی.رهبرِ شریران را نابود کردیو پیروانشان را به‌کلّی از بین بردی."
        },
        {
          "verse": 14,
          "usfm": "HAB.3.14",
          "line_type": "q1",
          "text": "جنگ‌جویان دشمن مانند گردباد آمدندتا ما را پراکنده کنندو می‌خواستند که مردم مسکین را از بین ببرند، امّا تیرهای تو سر آن‌ها را شکافت."
        },
        {
          "verse": 15,
          "usfm": "HAB.3.15",
          "line_type": "q1",
          "text": "با اسبانت، دریاو آب‌های خروشان را پایمال نمودی."
        },
        {
          "verse": 16,
          "usfm": "HAB.3.16",
          "line_type": "q1",
          "text": "وقتی این‌ها را می‌شنوم،از ترس بدنم تکان می‌خورد و لب‌هایم می‌لرزند.اندامم سُست می‌شودو پای‌هایم به لرزه می‌آیند.در انتظار روزی هستمکه خدا آن مردمی را که ما را مورد حمله قرار دادند، مجازات کند."
        },
        {
          "verse": 17,
          "usfm": "HAB.3.17",
          "line_type": "q1",
          "text": "هرچند درخت انجیر شکوفه نیاوردو انگور در تاک نروید،محصول زیتون از بین برودو کشتزارها غلّه بار نیاورند،گلّه‌ها در چراگاه تلف شوندو طویله‌ها از رمه خالی بمانند،"
        },
        {
          "verse": 18,
          "usfm": "HAB.3.18",
          "line_type": "q1",
          "text": "بازهم خوشحال و شادمان خواهم بود،زیرا خداوند نجات‌دهندۀ من است."
        },
        {
          "verse": 19,
          "usfm": "HAB.3.19",
          "line_type": "q1",
          "text": "خداوند متعال به من نیرو می‌بخشدو به پای‌هایم قوّت می‌دهدتا مانند آهو بِدَوَم و از کوه‌های بلند بالا بروم."
        }
      ],
      "verse_count": 19,
      "headings": [],
      "footnotes": [
        {
          "verse": 3,
          "usfm": "HAB.3.3",
          "note_ref": "3‏:3",
          "note_type": "footnote",
          "references": [],
          "text": "«تیمان» منطقه‌ای از اَدوم می‌باشد."
        }
      ],
