  "chapters": [
    {
      "schema_version": 6,
      "book_id": "HAB",
      "chapter": 1,
      "chapter_usfm": "HAB.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAB.1.1",
          "line_type": "p",
          "text": "این وحی‌ای است که خداوند در رؤیا به حبقوق نشان داد:"
        },
        {
          "verse": 2,
          "usfm": "HAB.1.2",
          "line_type": "p",
          "text": "خداوندا، تا به کی برای کمک نزد تو فریاد کنم تا بشنوی؟ تا به کی از دست ظلم فریاد کنم تا نجات بدهی؟"
        },
        {
          "verse": 3,
          "usfm": "HAB.1.3",
          "line_type": "p",
          "text": "چرا می‌گذاری این‌همه بی‌عدالتی‌ها را ببینم؟ ظلم‌وستم اطراف مرا گرفته است، همه‌جا پُر از ظلم و خرابی است و جنگ و دشمنی همه‌جا را گرفته است."
        },
        {
          "verse": 4,
          "usfm": "HAB.1.4",
          "line_type": "p",
          "text": "قانون از بین رفته و عدالت اجرا نمی‌شود. شریران بر نیکوکاران برتری دارند و داوران عدالت را اجرا نمی‌کنند."
        },
        {
          "verse": 5,
          "usfm": "HAB.1.5",
          "line_type": "p",
          "text": "خداوند گفت: «به ملل اطراف خود نگاه کنید؛ از آنچه که می‌بینید تعجّب خواهید کرد، زیرا در دوران زندگی شما کاری می‌کنم که حتّی وقتی خبر آن‌ را بشنوید، باور نکنید."
        },
        {
          "verse": 6,
          "usfm": "HAB.1.6",
          "line_type": "p",
          "text": "من بابِلی‌ها را که مردمی بی‌رحم و ظالم هستند، به قدرت می‌رسانم. آن‌ها به تمام روی زمین هجوم آورده همه‌جا را تصرّف خواهند کرد."
        },
        {
          "verse": 7,
          "usfm": "HAB.1.7",
          "line_type": "p",
          "text": "آنان ترس و وحشت را منتشر می‌کنند و آن‌قدر مغرورند که هر کاری که می‌کنند در نظرشان قانونی است."
        },
        {
          "verse": 8,
          "usfm": "HAB.1.8",
          "line_type": "p",
          "text": "«اسب‌هایشان سریع‌تر از پلنگ و درّنده‌تر از گرگ‌های گرسنه هستند. سواران آن‌ها از سرزمین‌های دور می‌آیند و همچون عقاب بر شکار خود حمله می‌کنند."
        },
        {
          "verse": 9,
          "usfm": "HAB.1.9",
          "line_type": "p",
          "text": "«بی‌رحمانه حمله کرده ترس و وحشت ایجاد می‌کنند و مثل ریگ بیابان اسیر می‌گیرند."
        },
        {
          "verse": 10,
          "usfm": "HAB.1.10",
          "line_type": "p",
          "text": "پادشاهان را مسخره می‌کنند و به بزرگان می‌خندند. قلعه‌ها را هیچ می‌شمارند و در پشت دیوار آن‌ها تپّه‌ای از خاک می‌سازند و آن‌ها را تصرّف می‌کنند."
        },
        {
          "verse": 11,
          "usfm": "HAB.1.11",
          "line_type": "p",
          "text": "همچون باد هجوم می‌آورند و می‌روند. آن‌ها مردمی گناهکار هستند، زیرا قدرت خود را، خدای خود می‌دانند.»"
        },
        {
          "verse": 12,
          "usfm": "HAB.1.12",
          "line_type": "p",
          "text": "ای خداوند، تو از ازل خدا بوده‌ای! تو خدای من، خدای مقدّس و ابدی هستی. ای خداوند، و ای پناه من! تو بابِلی‌ها را برگزیده و قدرت داده‌ای تا ما را مجازات کنند."
        },
        {
          "verse": 13,
          "usfm": "HAB.1.13",
          "line_type": "p",
          "text": "چشمان تو پاک‌تر از آن است که بر شرارت بنگرند. تو بی‌عدالتی را تحمّل نمی‌کنی، پس چرا وقتی‌که شریران اشخاصی را که از خودشان عادل‌ترند می‌بلعند، خاموش می‌مانی؟"
        },
        {
          "verse": 14,
          "usfm": "HAB.1.14",
          "line_type": "p",
          "text": "چرا با مردم مثل ماهیان و خزندگان بی‌رهبر رفتار می‌کنی؟"
        },
        {
          "verse": 15,
          "usfm": "HAB.1.15",
          "line_type": "p",
          "text": "بابِلی‌ها آن‌ها مردم را به قلّاب خود می‌اندازند و در تورهای خود جمع می‌کنند و سپس به شادی می‌پردازند."
        },
        {
          "verse": 16,
          "usfm": "HAB.1.16",
          "line_type": "p",
          "text": "بعد می‌روند و تورهای خود را می‌پرستند و برای آن‌ها قربانی می‌کنند، زیرا تورهایشان خوراک و ثروت برای آن‌ها آورده است."
        },
        {
          "verse": 17,
          "usfm": "HAB.1.17",
          "line_type": "p",
          "text": "آیا آن‌ها برای همیشه به کشتار خود ادامه داده بی‌رحمانۀ ملّت‌ها را نابود خواهند کرد؟"
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 5,
          "text": "جواب خداوند"
        },
        {
          "before_verse": 12,
          "text": "شکایت دوّم حبقوق"
        }
      ],
