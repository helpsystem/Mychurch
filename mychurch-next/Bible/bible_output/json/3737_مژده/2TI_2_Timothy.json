    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 4,
      "chapter_usfm": "2TI.4",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.4.1",
          "line_type": "p",
          "text": "در پیشگاه خدا و در حضور مسیح عیسی که بر زندگان و مردگان داوری خواهد کرد و به‌خاطر ظهور و پادشاهی او، تو را موظّف می‌سازم"
        },
        {
          "verse": 2,
          "usfm": "2TI.4.2",
          "line_type": "p",
          "text": "که کلام را موعظه کنی. وقت و بی‌وقت آمادۀ کار باش و دیگران را متقاعد و توبیخ و تشویق کن و با صبر و شکیباییِ تمام، تعلیم بده."
        },
        {
          "verse": 3,
          "usfm": "2TI.4.3",
          "line_type": "p",
          "text": "زیرا زمانی خواهد آمد که آدمیان به تعلیم درست گوش نخواهند داد، بلکه از امیال خودشان پیروی خواهند کرد و برای خود معلّمین بسیاری جمع خواهند کرد تا آنچه گو‌ش‌هایشان مایل به شنیدن آن‌ها است، از زبان آن‌ها بشنوند."
        },
        {
          "verse": 4,
          "usfm": "2TI.4.4",
          "line_type": "p",
          "text": "آن‌ها از شنیدن حقیقت روی‌گردان شده به افسانه‌ها روی می‌آورند."
        },
        {
          "verse": 5,
          "usfm": "2TI.4.5",
          "line_type": "p",
          "text": "امّا تو باید در تمام شرایط هوشیار بوده برای تحمّل رنج آماده باشی. در انتشار انجیل کوشا باش و وظیفۀ خود را به‌عنوان خادم خدا انجام بده."
        },
        {
          "verse": 6,
          "usfm": "2TI.4.6",
          "line_type": "p",
          "text": "امّا برای من، وقت آن رسیده است که قربانی شوم و زمان مرگم رسیده است."
        },
        {
          "verse": 7,
          "usfm": "2TI.4.7",
          "line_type": "p",
          "text": "من در مبارزهٔ ایمان نیکو جنگیده‌ام و دورۀ خود را تمام نموده ایمانم را حفظ کرده‌ام."
        },
        {
          "verse": 8,
          "usfm": "2TI.4.8",
          "line_type": "p",
          "text": "اکنون تاج نیکی مطلق در انتظار من است، همان تاجی که خداوند، یعنی آن داور عادل، در روز بازپسین به من خواهد داد و آن‌ را نه‌تنها به من، بلکه به همۀ آنانی که مشتاق ظهور او بوده‌اند، عنایت خواهد فرمود."
        },
        {
          "verse": 9,
          "usfm": "2TI.4.9",
          "line_type": "p",
          "text": "سعی کن که هرچه زودتر نزد من بیایی،"
        },
        {
          "verse": 10,
          "usfm": "2TI.4.10",
          "line_type": "p",
          "text": "زیرا دیماس به‌خاطر عشقی که به این دنیا دارد، مرا ترک کرده و به تَسالونیکی رفته و کْرِیسْکیس به غلاطیه و تیطُس به دلماطیه رفته‌اند."
        },
        {
          "verse": 11,
          "usfm": "2TI.4.11",
          "line_type": "p",
          "text": "تنها لوقا با من است. مرقس را بردار و با خود بیاور، چون برای خدمتم مفید است."
        },
        {
          "verse": 12,
          "usfm": "2TI.4.12",
          "line_type": "p",
          "text": "تیخیکاس را به اَفِسُس فرستادم."
        },
        {
          "verse": 13,
          "usfm": "2TI.4.13",
          "line_type": "p",
          "text": "در موقع آمدن، عبای مرا که در شهر ترواس نزد کارپُس جا گذاشتم و همچنین کتاب‌ها و از همه مهم‌تر نسخه‌های پوستی را بیاور."
        },
        {
          "verse": 14,
          "usfm": "2TI.4.14",
          "line_type": "p",
          "text": "اسکندر مِسگر با من بسیار بدی کرد. خداوند مطابق کارهایش به او سزا خواهد داد."
        },
        {
          "verse": 15,
          "usfm": "2TI.4.15",
          "line_type": "p",
          "text": "تو نیز از او بر حذر باش، زیرا شدیداً با پیام ما مخالف بود."
        },
        {
          "verse": 16,
          "usfm": "2TI.4.16",
          "line_type": "p",
          "text": "در اوّلین محاکمه من هیچ‌کس جانب مرا نگرفت؛ همه مرا ترک کردند. خدا این کار را به حسابشان نگذارد."
        },
        {
          "verse": 17,
          "usfm": "2TI.4.17",
          "line_type": "p",
          "text": "امّا خداوند با من بود و قدرتی به من عطا کرد که توانستم تمام پیام را اعلام کنم و آن‌ را به گوش تمام ملل برسانم، و از دهان شیر رهایی یافتم."
        },
        {
          "verse": 18,
          "usfm": "2TI.4.18",
          "line_type": "p",
          "text": "خداوند مرا از همۀ بدی‌ها خواهد رهانید و مرا به‌سلامت به پادشاهی سماوی خود خواهد رسانید. جلال بر او تا ابد باد! آمین."
        },
        {
          "verse": 19,
          "usfm": "2TI.4.19",
          "line_type": "p",
          "text": "به پِرسِکِلِه و اَکیلا و خانواده اونی‌سی‌فوروس سلام برسان."
        },
        {
          "verse": 20,
          "usfm": "2TI.4.20",
          "line_type": "p",
          "text": "اِراستوس در قرنتُس ماند و تروفیمُس را در میلیتوس جا گذاشتم، زیرا مریض بود."
        },
        {
          "verse": 21,
          "usfm": "2TI.4.21",
          "line_type": "p",
          "text": "سعی کن که قبل از زمستان بیایی. یوبولس، پودس، لینوس، کْلودیا و تمام ایمان‌داران سلام می‌رسانند."
        },
        {
          "verse": 22,
          "usfm": "2TI.4.22",
          "line_type": "p",
          "text": "خداوند با روح تو باشد. فیض خدا با همۀ شما باد."
        }
      ],
      "verse_count": 22,
      "headings": [
        {
          "before_verse": 9,
          "text": "سفارش‌های شخصی پولس به تیموتاؤس"
        },
        {
          "before_verse": 19,
          "text": "خاتمه"
        }
      ],
