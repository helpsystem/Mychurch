    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 3,
      "chapter_usfm": "2TI.3",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.3.1",
          "line_type": "p",
          "text": "این‌ را یقین بدان که در روزهای آخر، روزگار سختی خواهد بود،"
        },
        {
          "verse": 2,
          "usfm": "2TI.3.2",
          "line_type": "p",
          "text": "زیرا آدمیان، خودپرست و پول‌پرست و لاف‌زن و مغرور و ناسزاگو و نافرمان نسبت به والدین خواهند بود. آن‌ها ناسپاس، ناپاک،"
        },
        {
          "verse": 3,
          "usfm": "2TI.3.3",
          "line_type": "p",
          "text": "بی‌عاطفه، بی‌رحم، افترازن، ناپرهیزکار، درّنده‌خو، متنفّر از نیکی،"
        },
        {
          "verse": 4,
          "usfm": "2TI.3.4",
          "line_type": "p",
          "text": "خیانتکار، لاقید و خودپسند شده عیّاشی را بیش از خدا دوست خواهند داشت."
        },
        {
          "verse": 5,
          "usfm": "2TI.3.5",
          "line_type": "p",
          "text": "تظاهر به دین‌داری خواهند کرد، ولی منکر قدرت آن خواهند بود. از این اشخاص دوری کن،"
        },
        {
          "verse": 6,
          "usfm": "2TI.3.6",
          "line_type": "p",
          "text": "زیرا بعضی از آن‌ها به خانه‌ها راه می‌یابند و زن‌های سبک‌مغز را که زیر بار گناه شانه خم کرده‌اند و دستخوش تمایلات گوناگون هستند، اسیر می‌سازند."
        },
        {
          "verse": 7,
          "usfm": "2TI.3.7",
          "line_type": "p",
          "text": "این زن‌ها دائماً تعلیم می‌گیرند، ولی هیچ‌وقت نمی‌توانند حقیقت را درک کنند."
        },
        {
          "verse": 8,
          "usfm": "2TI.3.8",
          "line_type": "p",
          "text": "همان‌طور که «یَنّیس» و «یَمبرِیس» با موسی مخالفت کردند، این مردان نیز با حقیقت مخالفت می‌کنند. افکارشان فاسد شده و در ایمان مردود هستند."
        },
        {
          "verse": 9,
          "usfm": "2TI.3.9",
          "line_type": "p",
          "text": "امّا پیشرفت آنان بیش از این نخواهد بود، زیرا حماقت آن‌ها بر همه آشکار خواهد شد، درست همان طوری که حماقت «یَنّیس» و «یَمبرِیس» معلوم گردید."
        },
        {
          "verse": 10,
          "usfm": "2TI.3.10",
          "line_type": "p",
          "text": "امّا تو، از تعلیم و رفتار و هدف من در زندگی آگاه هستی و ایمان، بردباری، محبّت و پایداری مرا دیده‌ای"
        },
        {
          "verse": 11,
          "usfm": "2TI.3.11",
          "line_type": "p",
          "text": "و همچنین جفایی را که در انطاکیه، قونیه و لستره دیدم، مشاهده کرده‌ای و می‌دانی چه جفاهایی به من رسید و چگونه خداوند مرا از همۀ این‌ها رهایی بخشید."
        },
        {
          "verse": 12,
          "usfm": "2TI.3.12",
          "line_type": "p",
          "text": "آری، همۀ کسانی‌ که مایلند در اتّحاد با مسیح عیسی زندگی خداپسندانه‌ای داشته باشند، جفا خواهند دید."
        },
        {
          "verse": 13,
          "usfm": "2TI.3.13",
          "line_type": "p",
          "text": "امّا مردمان شریر و شیّاد در شرارت پیشرفت خواهند کرد. آن‌ها دیگران را فریب می‌دهند و خود نیز فریب می‌خورند."
        },
        {
          "verse": 14,
          "usfm": "2TI.3.14",
          "line_type": "p",
          "text": "و امّا تو، به آنچه آموخته‌ای و به آن اطمینان داری وفادار باش زیرا می‌دانی از چه کسانی آن‌ را آموختی"
        },
        {
          "verse": 15,
          "usfm": "2TI.3.15",
          "line_type": "p",
          "text": "و از کودکی با کلام خدا که قادر است به تو حکمت ببخشد تا به‌وسیلهٔ ایمان به مسیح عیسی نجات یابی، آشنا بوده‌ای."
        },
        {
          "verse": 16,
          "usfm": "2TI.3.16",
          "line_type": "p",
          "text": "تمامی کتب‌ مقدّس از الهام خدا است و برای تعلیم حقیقت، سرزنش خطا، اصلاح معایب و پرورش ما در نیکی مطلق مفید است"
        },
        {
          "verse": 17,
          "usfm": "2TI.3.17",
          "line_type": "p",
          "text": "تا مرد خدا برای هر کار نیکو کاملاً آماده و مجهّز باشد."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 10,
          "text": "آخرین دستورها"
        }
      ],
