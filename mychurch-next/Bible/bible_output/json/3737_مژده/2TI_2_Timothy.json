  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 1,
      "chapter_usfm": "2TI.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.1.1",
          "line_type": "p",
          "text": "از طرف پولس که به خواست خدا و به‌خاطر وعدهٔ حیاتی که در مسیح عیسی یافت می‌شود، رسول مسیح عیسی است،"
        },
        {
          "verse": 2,
          "usfm": "2TI.1.2",
          "line_type": "p",
          "text": "به تیموتاؤس، فرزند عزیزم: خدای پدر و مسیح عیسی، خداوند ما، فیض و رحمت و آرامش به تو عطا فرماید."
        },
        {
          "verse": 3,
          "usfm": "2TI.1.3",
          "line_type": "p",
          "text": "وقتی تو را در شب و روز در دعاهای خود به‌یاد می‌آورم، خدایی را که من مانند اجدادم با وجدانی پاک خدمت می‌کنم، شکر و سپاس می‌گویم."
        },
        {
          "verse": 4,
          "usfm": "2TI.1.4",
          "line_type": "p",
          "text": "وقتی اشک‌های تو را به‌یاد می‌آورم، آرزو می‌کنم تو را ببینم تا با دیدار تو شادی من کامل گردد."
        },
        {
          "verse": 5,
          "usfm": "2TI.1.5",
          "line_type": "p",
          "text": "ایمان بی‌ریای تو را به‌خاطر می‌آورم، یعنی همان ایمانی که نخست مادربزرگ تو «لوئیس» و مادرت «یونیکی» داشتند و اکنون مطمئن هستم که در تو هم هست."
        },
        {
          "verse": 6,
          "usfm": "2TI.1.6",
          "line_type": "p",
          "text": "از‌این‌رو به تو یادآوری می‌کنم آن عطایی را که خدا هنگام دست‌گذاری من بر تو به تو بخشید، شعله‌ور نگاه داری،"
        },
        {
          "verse": 7,
          "usfm": "2TI.1.7",
          "line_type": "p",
          "text": "زیرا روحی که خدا به ما بخشیده است ما را ترسان نمی‌سازد، بلکه روح او ما را از قدرت و محبّت و خو‌یشتن‌داری پُر می‌کند."
        },
        {
          "verse": 8,
          "usfm": "2TI.1.8",
          "line_type": "p",
          "text": "پس، از شهادت دادن به خداوند یا به رابطۀ خودت با من، که به‌خاطر او زندانی هستم خجل نباش، بلکه در رنج و زحمتی که به‌خاطر انجیل پیش می‌آید با آن قدرتی که خدا می‌بخشد سهیم باش."
        },
        {
          "verse": 9,
          "usfm": "2TI.1.9",
          "line_type": "p",
          "text": "خدا ما را نجات داد و به یک زندگی مقدّس دعوت کرد و این در اثر کارهای ما نبود، بلکه بر‌ طبق نقشۀ خود خدا و فیضی است که او از ازل در شخص مسیح عیسی به ما عطا فرمود."
        },
        {
          "verse": 10,
          "usfm": "2TI.1.10",
          "line_type": "p",
          "text": "در حال حاضر این فیض به‌وسیلهٔ ظهور نجات‌دهندۀ ما مسیح عیسی آشکار شده است. او موت را از میان برداشت و حیاتی فناناپذیر به‌وسیلهٔ انجیل برای همه آشکار ساخته است."
        },
        {
          "verse": 11,
          "usfm": "2TI.1.11",
          "line_type": "p",
          "text": "خدا مرا برگزید تا در انتشار انجیل واعظ، رسول و معلّم باشم."
        },
        {
          "verse": 12,
          "usfm": "2TI.1.12",
          "line_type": "p",
          "text": "به این دلیل تمام رنج‌ها را متحمّل می‌شوم، امّا شرمسار نیستم زیرا می‌دانم به چه کسی ایمان آورده‌ام و یقین دارم که او قادر است آنچه را به او سپرده‌ام تا روز آخر حفظ کند."
        },
        {
          "verse": 13,
          "usfm": "2TI.1.13",
          "line_type": "p",
          "text": "تعلیم صحیحی را که از من شنیده‌ای، با ایمان و محبّتی که در مسیح عیسی است، سرمشق خود قرار بده"
        },
        {
          "verse": 14,
          "usfm": "2TI.1.14",
          "line_type": "p",
          "text": "و به‌وسیلهٔ قدرت روح‌القدس که در ما به سر می‌برد، آن سپرده‌های نیکو را حفظ کن."
        },
        {
          "verse": 15,
          "usfm": "2TI.1.15",
          "line_type": "p",
          "text": "خبر داری که در استان آسیا همه از جمله «فیگِلوس» و «هِرموگِنس» مرا ترک کرده‌اند."
        },
        {
          "verse": 16,
          "usfm": "2TI.1.16",
          "line_type": "p",
          "text": "خداوند رحمت خود را به خانواده «اونی‌سی‌فوروس» عطا فرماید، زیرا او بارها باعث نشاط من شده است. او از این‌که من زندانی هستم، خجل نبود،"
        },
        {
          "verse": 17,
          "usfm": "2TI.1.17",
          "line_type": "p",
          "text": "بلکه به‌محض این‌که به «روم» رسید، آن‌قدر به جستجوی من پرداخت تا مرا پیدا کرد."
        },
        {
          "verse": 18,
          "usfm": "2TI.1.18",
          "line_type": "p",
          "text": "خداوند عطا فرماید که در روز عظیم، او از دست خداوند رحمت یابد! و تو خوب از خدماتی که او در «اَفِسُس» به من کرد آگاه هستی."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 3,
          "text": "تیموتاؤس و مأموریت او"
        }
      ],
