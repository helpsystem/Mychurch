    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 2,
      "chapter_usfm": "2TI.2",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.2.1",
          "line_type": "p",
          "text": "و امّا تو، ای فرزند من، با فیضی که در مسیح عیسی است نیرومند شو"
        },
        {
          "verse": 2,
          "usfm": "2TI.2.2",
          "line_type": "p",
          "text": "و سخنانی را که در حضور شاهدان بسیاری از من شنیده‌ای به کسانی بسپار که مورد اعتماد و قادر به تعلیم دیگران باشند."
        },
        {
          "verse": 3,
          "usfm": "2TI.2.3",
          "line_type": "p",
          "text": "به‌عنوان سرباز خوب مسیح عیسی متحمّل سختی‌ها باش."
        },
        {
          "verse": 4,
          "usfm": "2TI.2.4",
          "line_type": "p",
          "text": "هیچ سربازی خود را گرفتار امور غیرنظامی نمی‌کند، زیرا هدف او جلب رضایت فرمانده‌اش می‌باشد."
        },
        {
          "verse": 5,
          "usfm": "2TI.2.5",
          "line_type": "p",
          "text": "ورزشکاری که در مسابقه‌ای شرکت می‌کند، نمی‌تواند جایزه را ببرد مگر این‌که از قوانین آن پیروی کند."
        },
        {
          "verse": 6,
          "usfm": "2TI.2.6",
          "line_type": "p",
          "text": "کشاورزی که زحمت کشیده است، باید اوّلین کسی باشد که از ثمرۀ محصول خود بهره ببرد."
        },
        {
          "verse": 7,
          "usfm": "2TI.2.7",
          "line_type": "p",
          "text": "در آنچه می‌گویم تأمّل کن و خداوند درک همه‌چیز را به تو خواهد بخشید."
        },
        {
          "verse": 8,
          "usfm": "2TI.2.8",
          "line_type": "p",
          "text": "عیسای مسیح را که پس از مرگ زنده گشت و از نسل داوود بود، به‌خاطر داشته باش؛ انجیلی که من اعلام می‌کنم همین است"
        },
        {
          "verse": 9,
          "usfm": "2TI.2.9",
          "line_type": "p",
          "text": "و به‌ همین خاطر است که رنج و زحمت می‌بینم و حتّی مانند یک جنایتکار در زنجیرم. امّا کلام خدا در زنجیر بسته نمی‌شود."
        },
        {
          "verse": 10,
          "usfm": "2TI.2.10",
          "line_type": "p",
          "text": "بنابراین همه‌‌چیز را به‌خاطر برگزیدگان خدا تحمّل می‌کنم تا آن‌ها نیز نجاتی را که در مسیح عیسی است همراه با جلال جاودانۀ آن به دست آورند."
        },
        {
          "verse": 11,
          "usfm": "2TI.2.11",
          "line_type": "p",
          "text": "این سخن قابل‌ اعتماد است:«اگر با او مُردیم، همچنین با او خواهیم زیست."
        },
        {
          "verse": 12,
          "usfm": "2TI.2.12",
          "line_type": "q1",
          "text": "اگر تحمّل کنیم، با او فرمانروایی خواهیم کرد.اگر او را انکار کنیم، او هم ما را انکار خواهد کرد،"
        },
        {
          "verse": 13,
          "usfm": "2TI.2.13",
          "line_type": "q1",
          "text": "ولی اگر بی‌وفایی کنیم، او وفادار خواهد ماندزیرا او نمی‌تواند خود را انکار کند.»"
        },
        {
          "verse": 14,
          "usfm": "2TI.2.14",
          "line_type": "p",
          "text": "این مطالب را به مردم گوشزد کن و در حضور خدا به آن‌ها دستور بده که از مجادله بر سر کلمات دست بردارند. چون این‌ کار عاقبت خوشی ندارد، بلکه فقط باعث گمراهی شنوندگان خواهد شد."
        },
        {
          "verse": 15,
          "usfm": "2TI.2.15",
          "line_type": "p",
          "text": "نهایت کوشش خود را بکن تا مانند کارگری که از کار خود خجل نیست و پیام حقیقت را به‌درستی تعلیم می‌دهد، در نظر خدا کاملاً موردپسند باشی."
        },
        {
          "verse": 16,
          "usfm": "2TI.2.16",
          "line_type": "p",
          "text": "از مباحثات کُفرآمیز و بی‌معنی که مردم را همواره به بی‌دینی سوق می‌دهند، دوری کن."
        },
        {
          "verse": 17,
          "usfm": "2TI.2.17",
          "line_type": "p",
          "text": "حرف ایشان مثل بیماری خوره، به تمام بدن سرایت می‌کند. از آن جمله‌اند «هیمِنائوس» و «فیلِتوس»"
        },
        {
          "verse": 18,
          "usfm": "2TI.2.18",
          "line_type": "p",
          "text": "که از حقیقت منحرف شده‌اند و می‌گویند که رستاخیز ما هم‌اکنون به وقوع پیوسته است و به‌این‌وسیله ایمان عدّه‌ای را متزلزل می‌سازند."
        },
        {
          "verse": 19,
          "usfm": "2TI.2.19",
          "line_type": "p",
          "text": "امّا، شالودۀ مستحکمی که خدا نهاده، متزلزل نخواهد شد و این کلمات بر آن نقش شده است:«خداوند متعلّقان خود را می‌شناسد» و «هرکه نام خداوند را به زبان آورد، باید شرارت را ترک کند.»"
        },
        {
          "verse": 20,
          "usfm": "2TI.2.20",
          "line_type": "p",
          "text": "در یک خانۀ بزرگ علاوه بر ظروف طلایی و نقره‌ای، ظروف چوبی و سفالی هم وجود دارد. بعضی از آن‌ها در موارد مهم استفاده می‌شوند و بعضی در موارد معمولی."
        },
        {
          "verse": 21,
          "usfm": "2TI.2.21",
          "line_type": "p",
          "text": "اگر کسی خود را از این آلودگی‌ها پاک سازد، ظرفی می‌شود که برای مقاصد مهم بکار خواهد رفت و برای اربابش مقدّس و مفید و برای هر کار نیکو آماده خواهد بود."
        },
        {
          "verse": 22,
          "usfm": "2TI.2.22",
          "line_type": "p",
          "text": "از شهواتی که مربوط به دوران جوانی است بگریز و به اتّفاق همۀ کسانی‌ که با قلبی پاک به پیشگاه خداوند دعا می‌کنند، نیکویی مطلق، ایمان، محبّت و صلح و صفا را دنبال کن."
        },
        {
          "verse": 23,
          "usfm": "2TI.2.23",
          "line_type": "p",
          "text": "از مباحثات احمقانه و جاهلانه دوری کن، زیرا می‌دانی که به نزاع می‌انجامد."
        },
        {
          "verse": 24,
          "usfm": "2TI.2.24",
          "line_type": "p",
          "text": "خادم خداوند نباید نزاع کند، بلکه باید نسبت به همه مهربان و معلّمی توانا و صبور باشد"
        },
        {
          "verse": 25,
          "usfm": "2TI.2.25",
          "line_type": "p",
          "text": "و مخالفان خود را با ملایمت اصلاح کند، شاید خدا اجازه دهد که آن‌ها توبه کنند و حقیقت را بشناسند."
        },
        {
          "verse": 26,
          "usfm": "2TI.2.26",
          "line_type": "p",
          "text": "به‌این‌وسیله به خود خواهند آمد و از دام ابلیس، که آنان را گرفتار ساخته و به اطاعت از ارادۀ خویش وادار کرده است، خواهند گریخت."
        }
      ],
      "verse_count": 26,
      "headings": [
        {
          "before_verse": 14,
          "text": "مشخّصات خادم مقبول خدا"
        }
      ],
