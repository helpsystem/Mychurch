    {
      "schema_version": 6,
      "book_id": "HAG",
      "chapter": 2,
      "chapter_usfm": "HAG.2",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAG.2.1",
          "line_type": "p",
          "text": "در روز بیست و یکم ماه هفتم همان سال، خداوند به حجّای نبی فرمود:"
        },
        {
          "verse": 2,
          "usfm": "HAG.2.2",
          "line_type": "p",
          "text": "«از زِرُبابل، حاکم یهودا و یهوشع، کاهن اعظم بپرس:"
        },
        {
          "verse": 3,
          "usfm": "HAG.2.3",
          "line_type": "p",
          "text": "آیا در بین شما کسی هست که جلال و عظمت معبدِ بزرگ را، همان‌طور که در سابق بود، به‌یاد آورد؟ آیا آنچه را که اکنون می‌سازید به نظر شما ناچیز نیست؟"
        },
        {
          "verse": 4,
          "usfm": "HAG.2.4",
          "line_type": "p",
          "text": "اکنون ای زِرُبابل، دلیر باش و ای یِهوشَع پسر یَهوصاداق کاهن اعظم، دلیر باش و ای تمام قوم، دلیر باشید. به کارتان ادامه دهید، زیرا من همراه شما هستم."
        },
        {
          "verse": 5,
          "usfm": "HAG.2.5",
          "line_type": "p",
          "text": "وقتی از مصر خارج می‌شدید، به شما وعده دادم که روح من همیشه با شما خواهد بود؛ من هنوز با شما هستم، پس نترسید!"
        },
        {
          "verse": 6,
          "usfm": "HAG.2.6",
          "line_type": "p",
          "text": "«به‌زودی بار دیگر آسمان‌ها، زمین، دریاها و خشکی را به لرزه درخواهم آورد."
        },
        {
          "verse": 7,
          "usfm": "HAG.2.7",
          "line_type": "p",
          "text": "تمام ملّت‌ها را سرنگون خواهم ساخت. دارایی و ثروتشان به اینجا آورده خواهد شد و این خانه را از شکوه و جلال پُر خواهم ساخت."
        },
        {
          "verse": 8,
          "usfm": "HAG.2.8",
          "line_type": "p",
          "text": "تمام طلا و نقرۀ دنیا از آن من است."
        },
        {
          "verse": 9,
          "usfm": "HAG.2.9",
          "line_type": "p",
          "text": "این خانه با شکوه‌تر از سابق خواهد شد و در اینجا به قوم خود صلح و سلامتی خواهم بخشید.» خداوند متعال این‌ را فرموده است."
        },
        {
          "verse": 10,
          "usfm": "HAG.2.10",
          "line_type": "p",
          "text": "در روز بیست و چهارمِ ماه نهمِ از سال دوّمِ سلطنت داریوش، خداوند بار دیگر به حَجّای نبی فرمود:"
        },
        {
          "verse": 11,
          "usfm": "HAG.2.11",
          "line_type": "p",
          "text": "«از کاهنان بپرس که شریعت به این سؤال چه جواب می‌دهد:"
        },
        {
          "verse": 12,
          "usfm": "HAG.2.12",
          "line_type": "p",
          "text": "اگر کسی گوشت مقدّس را در ردای خود گذاشته ببرد، اگر دامنش با نان، آش، شراب، روغن و یا هر نوع خوراک دیگر تماس پیدا کند، آیا آن خوراک مقدّس می‌شود؟»وقتی حَجّای این سؤال را از کاهنان پرسید، آن‌ها جواب دادند: «نه.»"
        },
        {
          "verse": 13,
          "usfm": "HAG.2.13",
          "line_type": "p",
          "text": "سپس حَجّای پرسید: «امّا اگر کسی با جسدی تماس پیدا کرده ناپاک شده باشد و بعد به یکی از این خوراک‌ها دست بزند، آیا آن خوراک ناپاک می‌شود؟»کاهنان جواب دادند: «بلی، ناپاک می‌شود.»"
        },
        {
          "verse": 14,
          "usfm": "HAG.2.14",
          "line_type": "p",
          "text": "پس حَجّای گفت: «خداوند می‌فرماید که این مردم هم همین‌طور هستند؛ هر کاری که می‌کنند و هر هدیه‌ای که به این خانه می‌آورند، ناپاک است.»"
        },
        {
          "verse": 15,
          "usfm": "HAG.2.15",
          "line_type": "p",
          "text": "خداوند می‌فرماید: «حالا خوب فکر کنید و ببینید پیش از آنکه به ساختن خانۀ من شروع کنید،"
        },
        {
          "verse": 16,
          "usfm": "HAG.2.16",
          "line_type": "p",
          "text": "‌شما در چه وضعی بودید؟ در آن‌وقت شما توقّع داشتید که دو خروار محصول بردارید، امّا تنها یک خروار به دست می‌آوردید و هرگاه می‌خواستید پنجاه لیتر شراب از خُمره بکشید، فقط بیست لیتر در آن می‌یافتید."
        },
        {
          "verse": 17,
          "usfm": "HAG.2.17",
          "line_type": "p",
          "text": "‌من حاصل دست‌رنج شما را با باد سوزان، آفت و تگرگ تباه کردم، امّا شما بازهم توبه نکردید."
        },
        {
          "verse": 18,
          "usfm": "HAG.2.18",
          "line_type": "p",
          "text": "‌ولی از امروز به بعد که روز بیست و چهارم ماه نهم و روزی است که بنیاد خانۀ من گذاشته شده است، خواهید دید که با شما چه خواهم کرد."
        },
        {
          "verse": 19,
          "usfm": "HAG.2.19",
          "line_type": "p",
          "text": "‌هرچند که غلّه‌ای در انبارها باقی نمانده و هنوز تاک‌ها، درختان انجیر، انار و زیتون، میوه نیاورده‌اند، امّا از همین روز شما را برکت خواهم داد.»"
        },
        {
          "verse": 20,
          "usfm": "HAG.2.20",
          "line_type": "p",
          "text": "در همان روز بیست و چهارم ماه، بار دیگر این پیام از جانب خداوند برای حَجّای آمد:"
        },
        {
          "verse": 21,
          "usfm": "HAG.2.21",
          "line_type": "p",
          "text": "«به زِرُبابل، حاکم یهودا بگو که به‌زودی آسمان‌ها و زمین را به لرزه خواهم آورد."
        },
        {
          "verse": 22,
          "usfm": "HAG.2.22",
          "line_type": "p",
          "text": "تخت‌های پادشاهان را واژگون خواهم کرد. قدرت فرمانروایان را با ارّابه و سوارانشان از بین خواهم برد و اسبان و سواران آن‌ها یکدیگر را با شمشیرهای خود خواهند کُشت."
        },
        {
          "verse": 23,
          "usfm": "HAG.2.23",
          "line_type": "p",
          "text": "در آن روز، ای زِرُبابل، پسر شِئَلتیئیل، بندۀ من، تو مانند نگین انگشتر من خواهی بود، زیرا که من تو را برگزیده‌ام.» این قول خداوند متعال است."
        }
      ],
      "verse_count": 23,
      "headings": [
        {
          "before_verse": 10,
          "text": "مشورت حجّای به کاهنان"
        },
        {
          "before_verse": 15,
