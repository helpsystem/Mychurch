    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 3,
      "chapter_usfm": "JON.3",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.3.1",
          "line_type": "p",
          "text": "بار دیگر خدا با یونس سخن گفت:"
        },
        {
          "verse": 2,
          "usfm": "JON.3.2",
          "line_type": "p",
          "text": "«به نینوا، آن شهر بزرگ برو و پیامی را که به تو می‌گویم به آن‌ها اعلام کن.»"
        },
        {
          "verse": 3,
          "usfm": "JON.3.3",
          "line_type": "p",
          "text": "یونس اطاعت کرد و به نینوا رفت. نینوا شهر بسیار بزرگی بود و به‌اندازهٔ سه روز پیاده روی وسعت داشت."
        },
        {
          "verse": 4,
          "usfm": "JON.3.4",
          "line_type": "p",
          "text": "یونس وارد شهر شد و پس از یک روز راه پیمایی اعلام کرد که بعد از چهل روز نینوا نابود خواهد شد."
        },
        {
          "verse": 5,
          "usfm": "JON.3.5",
          "line_type": "p",
          "text": "مردم نینوا به خدا ایمان آورده اعلام روزه کردند و از بزرگ و کوچک، به علامت توبه، پلاس پوشیدند."
        },
        {
          "verse": 6,
          "usfm": "JON.3.6",
          "line_type": "p",
          "text": "وقتی پادشاه نینوا پیام را شنید، از تخت خود پایین آمد، ردای خود را کند و پلاس پوشیده روی خاکستر نشست."
        },
        {
          "verse": 7,
          "usfm": "JON.3.7",
          "line_type": "p",
          "text": "سپس از طرف پادشاه و بزرگان فرمانی صادر شد و در همه‌جا اعلام کردند که همۀ مردم و تمامی گاوان و گوسفندان چیزی نخورند و نیاشامند."
        },
        {
          "verse": 8,
          "usfm": "JON.3.8",
          "line_type": "p",
          "text": "همۀ مردم و حیوانات باید پلاس بپوشند و نزد خدا گریه و زاری کنند و همه از راه بد خود بازگردند و از ظلم دست کشیده توبه کنند."
        },
        {
          "verse": 9,
          "usfm": "JON.3.9",
          "line_type": "p",
          "text": "شاید خدا تصمیم خود را عوض کند و از خشم خود بازگردد و ما را هلاک نسازد."
        },
        {
          "verse": 10,
          "usfm": "JON.3.10",
          "line_type": "p",
          "text": "چون خدا کار آنان را دید و مشاهده کرد که آن‌ها از کارهای پلید خود دست کشیده و توبه کرده‌اند، از تصمیم خود منصرف شد و همان‌طور که قبلاً فرموده بود، آن‌ها را هلاک نکرد."
        }
      ],
