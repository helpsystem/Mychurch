  "chapters": [
    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 1,
      "chapter_usfm": "JON.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.1.1",
          "line_type": "p",
          "text": "یک روز خداوند به یونس، پسر اَمِتّای گفت:"
        },
        {
          "verse": 2,
          "usfm": "JON.1.2",
          "line_type": "p",
          "text": "«به نینوا، شهر بزرگ برو و بر ضد مردم آنجا سخن بگو و اعلام کن که از ظلم و شرارت آن‌ها آگاه هستم.»"
        },
        {
          "verse": 3,
          "usfm": "JON.1.3",
          "line_type": "p",
          "text": "امّا یونس خواست که از حضور خداوند فرار کند. پس به بندر یافا رفت و در آنجا یک کشتی دید که عازم تَرشیش بود. یونس کرایه خود را داد و با ملوانان سوار شد تا به تَرشیش رفته از خداوند دور گردد."
        },
        {
          "verse": 4,
          "usfm": "JON.1.4",
          "line_type": "p",
          "text": "امّا خداوند باد شدیدی بر دریا فرستاد. توفان به‌قدری شدید بود که نزدیک بود کشتی درهم شکسته شود."
        },
        {
          "verse": 5,
          "usfm": "JON.1.5",
          "line_type": "p",
          "text": "ملوانان ترسیدند و هرکدام نزد خدای خود فریاد می‌کرد و کمک می‌طلبید. سپس برای این‌که کشتی را سبک کنند، بارهای کشتی را به دریا انداختند. در این هنگام یونس در پایین کشتی دراز کشیده و به خواب سنگینی فرو رفته بود."
        },
        {
          "verse": 6,
          "usfm": "JON.1.6",
          "line_type": "p",
          "text": "ناخدای کشتی او را دید و گفت: «چرا خوابیده‌ای؟ بلند شو و نزد خدای خود دعا کن، شاید بر ما رحم کند و جان ما را نجات دهد.»"
        },
        {
          "verse": 7,
          "usfm": "JON.1.7",
          "line_type": "p",
          "text": "ملوانان به یکدیگر گفتند: «بیایید قرعه بیندازیم و ببینیم به‌خاطر چه کسی به این بلا دچار شده‌ایم.» آن‌ها قرعه انداختند و قرعه به نام یونس افتاد."
        },
        {
          "verse": 8,
          "usfm": "JON.1.8",
          "line_type": "p",
          "text": "آن‌ها به یونس گفتند: «به‌ سبب چه کسی این بلا بر سرما آمده است؟ کار تو چیست؟ از کجا آمده‌ای و اهل کجا هستی؟»"
        },
        {
          "verse": 9,
          "usfm": "JON.1.9",
          "line_type": "p",
          "text": "یونس گفت: «من عبرانی هستم و خداوندی را می‌پرستم که خدای آسمان و آفرینندۀ دریا و خشکی است.»"
        },
        {
          "verse": 10,
          "usfm": "JON.1.10",
          "line_type": "p",
          "text": "سپس یونس برای آن‌ها تعریف کرد که از پیشگاه خداوند فرار کرده است.ملوانان ترسیدند و به او گفتند: «تو کار بسیار بدی کرده‌ای.»"
        },
        {
          "verse": 11,
          "usfm": "JON.1.11",
          "line_type": "p",
          "text": "توفان هر لحظه شدیدتر می‌شد. بنابراین ملوانان از یونس پرسیدند: «ما با تو چه کار کنیم تا دریا آرام شود؟»"
        },
        {
          "verse": 12,
          "usfm": "JON.1.12",
          "line_type": "p",
          "text": "یونس گفت: «مرا بردارید و به دریا بیندازید تا دریا آرام شود، زیرا می‌دانم که این تقصیر من است که شما گرفتار این توفان شده‌اید.»"
        },
        {
          "verse": 13,
          "usfm": "JON.1.13",
          "line_type": "p",
          "text": "امّا ملوانان با تمام قدرت خود، کوشش می‌کردند پارو بزنند و کشتی را به خشکی برسانند. امّا توفان هر لحظه شدیدتر می‌شد و آن‌ها نمی‌توانستند کاری بکنند."
        },
        {
          "verse": 14,
          "usfm": "JON.1.14",
          "line_type": "p",
          "text": "پس به پیشگاه خداوند دعا کرده گفتند: «ای خداوند، ما را به‌خاطر این مرد هلاک نکن و ما را مسئول مرگ او نساز، چون ما گناهی نداریم، بلکه همۀ این وقایع طبق ارادۀ تو بوده است.»"
        },
        {
          "verse": 15,
          "usfm": "JON.1.15",
          "line_type": "p",
          "text": "سپس یونس را برداشتند و به دریا انداختند. در همان لحظه دریا آرام شد."
        },
        {
          "verse": 16,
          "usfm": "JON.1.16",
          "line_type": "p",
          "text": "ملوانان به‌خاطر این اتّفاق از خداوند ترسیدند و برای او قربانی کرده نذر نمودند."
        },
        {
          "verse": 17,
          "usfm": "JON.1.17",
          "line_type": "p",
          "text": "به دستور خداوند، یک ماهی بزرگ یونس را بلعید و یونس مدّت سه شبانه‌روز در شکم ماهی بود."
        }
      ],
      "verse_count": 17,
