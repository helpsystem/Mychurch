  "chapters": [
    {
      "schema_version": 6,
      "book_id": "PHM",
      "chapter": 1,
      "chapter_usfm": "PHM.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHM.1.1",
          "line_type": "p",
          "text": "از طرف پولس که به‌خاطر عیسای مسیح زندانی است و از طرف برادر ما تیموتاؤس، به دوست و همکارمان فِلیمُون"
        },
        {
          "verse": 2,
          "usfm": "PHM.1.2",
          "line_type": "p",
          "text": "و به کلیسایی که در خانۀ تو تشکیل می‌شود و به خواهر ما بانو اَپْفیه و همکار ما آرخیپُس."
        },
        {
          "verse": 3,
          "usfm": "PHM.1.3",
          "line_type": "p",
          "text": "پدر ما خدا و عیسای مسیح خداوند، فیض و آرامش به شما عطا فرمایند."
        },
        {
          "verse": 4,
          "usfm": "PHM.1.4",
          "line_type": "p",
          "text": "من پیوسته در دعاهای خود نام تو را به‌یاد آورده خدای خود را شکر می‌کنم،"
        },
        {
          "verse": 5,
          "usfm": "PHM.1.5",
          "line_type": "p",
          "text": "چون از محبّت تو و ایمانی که به عیسای خداوند و جمیع مقدّسین داری آگاه هستم."
        },
        {
          "verse": 6,
          "usfm": "PHM.1.6",
          "line_type": "p",
          "text": "باشد که اتّحاد ما در ایمان، دانش ما را دربارهٔ برکاتی که در عیسی مسیح داریم، به کمال برساند."
        },
        {
          "verse": 7,
          "usfm": "PHM.1.7",
          "line_type": "p",
          "text": "ای برادر، محبّت تو برای من شادی عظیم و دلگرمی بسیار پدید آورده است، زیرا دل‌های مقدّسین به‌وسیلۀ تو، نیرویی تازه گرفته است."
        },
        {
          "verse": 8,
          "usfm": "PHM.1.8",
          "line_type": "p",
          "text": "بنابراین اگرچه من در اتّحاد خود با مسیح حقّ دارم که به تو دستور بدهم که وظایف خود را انجام دهی،"
        },
        {
          "verse": 9,
          "usfm": "PHM.1.9",
          "line_type": "p",
          "text": "امّا به‌خاطر محبّتی که به تو دارم، ترجیح می‌دهم از تو درخواست کنم: بله من، پولس پیر که در حال حاضر به‌خاطر مسیح عیسی زندانی هستم،"
        },
        {
          "verse": 10,
          "usfm": "PHM.1.10",
          "line_type": "p",
          "text": "از جانب فرزند خود اونیسیموس که در زندان، پدر روحانی او شدم، از تو تقاضایی دارم."
        },
        {
          "verse": 11,
          "usfm": "PHM.1.11",
          "line_type": "p",
          "text": "او در گذشته برای تو مفید نبود، ولی اکنون هم برای تو و هم برای من مفید است."
        },
        {
          "verse": 12,
          "usfm": "PHM.1.12",
          "line_type": "p",
          "text": "اکنون که او را نزد تو روانه می‌کنم، مثل این است که قلب خود را برای تو می‌فرستم."
        },
        {
          "verse": 13,
          "usfm": "PHM.1.13",
          "line_type": "p",
          "text": "خوشحال می‌شدم که او را نزد خود نگاه دارم تا در این مدّتی که به‌خاطر اعلام مژدهٔ انجیل زندانی هستم، او به‌جای تو مرا خدمت کند."
        },
        {
          "verse": 14,
          "usfm": "PHM.1.14",
          "line_type": "p",
          "text": "امّا نمی‌خواستم بدون موافقت تو کاری انجام دهم تا نیکویی تو نه از روی اجبار، بلکه از روی میل باشد."
        },
        {
          "verse": 15,
          "usfm": "PHM.1.15",
          "line_type": "p",
          "text": "شاید علّت جدایی موقّت او از تو این بود که او را برای همیشه بازیابی!"
        },
        {
          "verse": 16,
          "usfm": "PHM.1.16",
          "line_type": "p",
          "text": "و البتّه نه مثل یک غلام، بلکه بالاتر از آن یعنی به‌عنوان یک برادر عزیز. او برای من بسیار عزیز است و چقدر بیشتر باید برای تو به‌عنوان یک انسان و یک برادر مسیحی عزیز باشد."
        },
        {
          "verse": 17,
          "usfm": "PHM.1.17",
          "line_type": "p",
          "text": "پس اگر مرا همکار صمیمی خود می‌دانی، او را همان‌طور بپذیر که گویی مرا می‌پذیری."
        },
        {
          "verse": 18,
          "usfm": "PHM.1.18",
          "line_type": "p",
          "text": "اگر به تو بدی کرده است یا چیزی به تو بدهکار است، آن‌ را به‌حساب من بگذار."
        },
        {
          "verse": 19,
          "usfm": "PHM.1.19",
          "line_type": "p",
          "text": "من این‌ را با دست خودم می‌نویسم: «من، پولس، آن‌ را به تو پس خواهم داد.» لازم نیست که به تو بگویم تو حتّی جان خود را هم به من مدیونی."
        },
        {
          "verse": 20,
          "usfm": "PHM.1.20",
          "line_type": "p",
          "text": "آری ای برادر، می‌خواهم به‌خاطر خداوند، به من لطف نمایی و دل مرا در مسیح شاد سازی."
        },
        {
          "verse": 21,
          "usfm": "PHM.1.21",
          "line_type": "p",
          "text": "من با اعتماد به اطاعت تو و با دانستن این‌که آنچه من می‌گویم و حتّی بیشتر از آن‌ را هم انجام خواهی داد، این‌ را به تو می‌نویسم."
        },
        {
          "verse": 22,
          "usfm": "PHM.1.22",
          "line_type": "p",
          "text": "درضمن اتاقی برای من آماده کن، زیرا امیدوارم که خدا دعاهای شما را مستجاب کرده مرا به شما برگرداند."
        },
        {
          "verse": 23,
          "usfm": "PHM.1.23",
          "line_type": "p",
          "text": "اِپفراس که به‌خاطر مسیح عیسی با من در زندان است، به تو سلام می‌رساند."
        },
        {
          "verse": 24,
          "usfm": "PHM.1.24",
          "line_type": "p",
          "text": "همچنین همکاران من مرقس، اَرِسْتَرخُس، دیماس و لوقا به تو سلام می‌رسانند."
        },
        {
          "verse": 25,
          "usfm": "PHM.1.25",
          "line_type": "p",
          "text": "فیض عیسای مسیح خداوند با روح شما باد."
        }
      ],
      "verse_count": 25,
      "headings": [
        {
          "before_verse": 4,
          "text": "محبّت و ایمان فِلیمُون"
        },
        {
          "before_verse": 8,
          "text": "تقاضای پولس برای اونیسیموس"
        },
        {
          "before_verse": 23,
          "text": "خاتمه"
        }
      ],
