  "chapters": [
    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 1,
      "chapter_usfm": "JAS.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.1.1",
          "line_type": "p",
          "text": "یعقوب بندۀ خدا و بندۀ عیسای مسیح خداوند به دوازده طایفۀ اسرائیل که در سراسر عالم پراکنده‌اند، سلام و درود می‌فرستد."
        },
        {
          "verse": 2,
          "usfm": "JAS.1.2",
          "line_type": "p",
          "text": "ای برادران من، هرگاه دچار آزمایش‌های گوناگون می‌شوید، بی‌نهایت شاد باشید،"
        },
        {
          "verse": 3,
          "usfm": "JAS.1.3",
          "line_type": "p",
          "text": "چون می‌دانید اگر خلوص ایمان شما در آزمایش ثابت شود، پایداری شما بیشتر می‌شود؛"
        },
        {
          "verse": 4,
          "usfm": "JAS.1.4",
          "line_type": "p",
          "text": "و وقتی پایداری شما کامل شود، شما انسان‌های کامل و بالغی شده کمبودی نخواهید داشت."
        },
        {
          "verse": 5,
          "usfm": "JAS.1.5",
          "line_type": "p",
          "text": "اگر کسی از شما فاقد حکمت باشد، آن‌ را از خدا بخواهد، و خدایی که همه‌‌چیز را باسخاوت می‌بخشد و انسان را سرزنش نمی‌کند، آن‌ را به او خواهد داد."
        },
        {
          "verse": 6,
          "usfm": "JAS.1.6",
          "line_type": "p",
          "text": "امّا او باید با ایمان بخواهد و در فکر خود هیچ شکی را راه ندهد، چون آدم شکّاک مانند موج دریا است که در برابر باد رانده و متلاطم می‌شود."
        },
        {
          "verse": 7,
          "usfm": "JAS.1.7",
          "line_type": "p",
          "text": "چنین شخصی نباید گمان کند که از خداوند چیزی خواهد یافت،"
        },
        {
          "verse": 8,
          "usfm": "JAS.1.8",
          "line_type": "p",
          "text": "چون شخص دودل در تمام کارهای خود ناپایدار است."
        },
        {
          "verse": 9,
          "usfm": "JAS.1.9",
          "line_type": "p",
          "text": "مسیحیِ مسکین باید به سرافرازی خود در برابر خدا فخر کند"
        },
        {
          "verse": 10,
          "usfm": "JAS.1.10",
          "line_type": "p",
          "text": "و مسیحیِ ثروتمند نیز به حقارت خود. او مانند گُلِ علف، زودگذر است؛"
        },
        {
          "verse": 11,
          "usfm": "JAS.1.11",
          "line_type": "p",
          "text": "همان‌گونه که آفتاب با گرمای سوزان خود بر علف می‌تابد، و آن‌ را می‌خشکاند و گُلِ آن پژمرده شده از بین می‌رود، شخص دولتمند نیز همین‌طور در میان تلاش‌های خود پژمرده و محو خواهد شد."
        },
        {
          "verse": 12,
          "usfm": "JAS.1.12",
          "line_type": "p",
          "text": "خوشا به حال کسی‌ که در برابر وسوسه پایدار است، زیرا وقتی آزموده شود، تاج حیاتی را که خداوند به دوستداران خود وعده داده است، خواهد گرفت."
        },
        {
          "verse": 13,
          "usfm": "JAS.1.13",
          "line_type": "p",
          "text": "کسی‌ که گرفتار وسوسه می‌شود، نباید بگوید: «خداوند مرا به وسوسه انداخته است.» چون خداوند از بدی مبرّا است و کسی را به وسوسه نمی‌اندازد."
        },
        {
          "verse": 14,
          "usfm": "JAS.1.14",
          "line_type": "p",
          "text": "انسان وقتی دچار وسوسه می‌شود که به دام هوس‌های خود می‌افتد."
        },
        {
          "verse": 15,
          "usfm": "JAS.1.15",
          "line_type": "p",
          "text": "درنتیجه، شهوت آبستن می‌شود و گناه را تولید می‌کند و وقتی گناه کاملاً رشد کرد، باعث مرگ می‌شود."
        },
        {
          "verse": 16,
          "usfm": "JAS.1.16",
          "line_type": "p",
          "text": "ای برادران عزیز من، فریب نخورید."
        },
        {
          "verse": 17,
          "usfm": "JAS.1.17",
          "line_type": "p",
          "text": "تمام بخشش‌های نیکو و هدایای کامل از آسمان و از جانب خدای پدر می‌آید که آفرینندۀ نور است و در او تغییر و تیرگی وجود ندارد."
        },
        {
          "verse": 18,
          "usfm": "JAS.1.18",
          "line_type": "p",
          "text": "او بنا به ارادۀ خود و به‌وسیلهٔ کلمۀ حقیقت، ما را از نو آفرید تا ما نوبری از خلقت تازۀ او باشیم."
        },
        {
          "verse": 19,
          "usfm": "JAS.1.19",
          "line_type": "p",
          "text": "بنابراین ای برادران عزیز من، این‌ را بدانید که هر‌کس باید در شنیدن، سریع و در پاسخ‌ دادن، کُند و در خشمگین شدن، آهسته باشد؛"
        },
        {
          "verse": 20,
          "usfm": "JAS.1.20",
          "line_type": "p",
          "text": "چون خشم انسان به کسب آن نیکویی که خدا می‌خواهد کمک نمی‌کند."
        },
        {
          "verse": 21,
          "usfm": "JAS.1.21",
          "line_type": "p",
          "text": "پس هر نوع عادت پلید و رفتار شرارت‌آمیز را از خود دور کنید، و کلامی را که خدا در دل‌های شما کاشته و می‌تواند شما را نجات بخشد، با فروتنی بپذیرید."
        },
        {
          "verse": 22,
          "usfm": "JAS.1.22",
          "line_type": "p",
          "text": "فقط با گوش دادن به کلام خدا خود را فریب ندهید، بلکه بر‌ طبق آن عمل کنید؛"
        },
        {
          "verse": 23,
          "usfm": "JAS.1.23",
          "line_type": "p",
          "text": "چون کسی‌ که به کلام گوش می‌دهد ولی بر‌ طبق آن عمل نمی‌کند، مانند مردی است که به آینه نگاه می‌کند و چهرهٔ خود را در آن می‌بیند."
        },
        {
          "verse": 24,
          "usfm": "JAS.1.24",
          "line_type": "p",
          "text": "او خود را می‌بیند ولی همین‌که از جلوی آینه دور می‌شود، فراموش می‌کند که چهره‌اش چگونه بود."
        },
        {
          "verse": 25,
          "usfm": "JAS.1.25",
          "line_type": "p",
          "text": "امّا کسی‌ که با‌دقّت به شریعت کامل و آزادی‌بخش نگاه کند و همیشه متوجّه آن باشد و شنوندۀ فراموش‌کاری نباشد، بلکه مطابق آن رفتار کند، خداوند تمام کارهای او را برکت خواهد داد."
        },
        {
          "verse": 26,
          "usfm": "JAS.1.26",
          "line_type": "p",
          "text": "اگر کسی گمان می‌کند که آدم دین‌داری است ولی زبان خود را مهار نمی‌کند، خود را فریب می‌دهد و دیانت او بیهوده است."
        },
        {
          "verse": 27,
          "usfm": "JAS.1.27",
          "line_type": "p",
          "text": "دیانت پاک و بی‌آلایش در برابر خدای پدر این است که وقتی یتیمان و بیوه‌زن‌ها دچار مصیبت می‌شوند، نیازهای آن‌ها را برآورده سازیم و خود را از فساد جهان دور نگاه داریم."
        }
      ],
      "verse_count": 27,
      "headings": [
