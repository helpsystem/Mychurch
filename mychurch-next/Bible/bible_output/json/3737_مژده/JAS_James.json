    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 2,
      "chapter_usfm": "JAS.2",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.2.1",
          "line_type": "p",
          "text": "ای برادرانِمن، ایمان شما به عیسای مسیح، خداوند جلال، با تبعیض همراه نباشد."
        },
        {
          "verse": 2,
          "usfm": "JAS.2.2",
          "line_type": "p",
          "text": "اگر شخصی با انگشتر طلا و لباس فاخر به مجلس شما بیاید و فقیری با لباس پاره نیز وارد شود"
        },
        {
          "verse": 3,
          "usfm": "JAS.2.3",
          "line_type": "p",
          "text": "و شما به کسی‌ که لباس فاخر دارد احترام بگذارید و بگویید: «بفرمایید بالا بنشینید» و به آن شخص فقیر بگویید: «در آنجا بایست یا در اینجا روی زمین پیش پای من بنشین،»"
        },
        {
          "verse": 4,
          "usfm": "JAS.2.4",
          "line_type": "p",
          "text": "آیا با این کار در بین خود تبعیض قائل نشده‌اید و با افکار پلید قضاوت نکرده‌اید؟"
        },
        {
          "verse": 5,
          "usfm": "JAS.2.5",
          "line_type": "p",
          "text": "ای برادران عزیز من گوش دهید! مگر خدا فقیران این جهان را برنگزیده است تا در ایمان، دولتمند و وارث آن ملکوتی باشند که او به دوستداران خود وعده داده است؟"
        },
        {
          "verse": 6,
          "usfm": "JAS.2.6",
          "line_type": "p",
          "text": "امّا شما به فقرا بی‌احترامی می‌کنید. آیا دولتمندان به شما ظلم نمی‌کنند و شما را به‌پای میز محاکمه نمی‌کشند؟"
        },
        {
          "verse": 7,
          "usfm": "JAS.2.7",
          "line_type": "p",
          "text": "و آیا آن‌ها به نام نیکویی که خدا بر شما نهاده است، بی‌حرمتی نمی‌کنند؟"
        },
        {
          "verse": 8,
          "usfm": "JAS.2.8",
          "line_type": "p",
          "text": "اگر شما قانون شاهانه‌ای را که در کلام خدا است و می‌فرماید: «همسایه‌ات را مثل جان خود محبّت نما» به‌جا آورید، کاری نیکو کرده‌اید."
        },
        {
          "verse": 9,
          "usfm": "JAS.2.9",
          "line_type": "p",
          "text": "امّا اگر بین اشخاص تبعیض قائل شوید، مرتکب گناه شده‌اید و شریعت، شما را به‌عنوان افرادی خطا‌کار محکوم می‌نماید."
        },
        {
          "verse": 10,
          "usfm": "JAS.2.10",
          "line_type": "p",
          "text": "چون اگر کسی تمام شریعت را رعایت کند و فقط یکی از قوانین آن‌ را بشکند، بازهم در مقابل تمام شریعت مقصّر است."
        },
        {
          "verse": 11,
          "usfm": "JAS.2.11",
          "line_type": "p",
          "text": "زیرا او که گفت: «زنا نکن،» همچنین گفته است: «قتل نکن.» پس اگر تو زنا نکنی ولی مرتکب قتل شوی، بازهم شریعت را شکسته‌ای."
        },
        {
          "verse": 12,
          "usfm": "JAS.2.12",
          "line_type": "p",
          "text": "مانند کسانی سخن گویید و عمل نمایید که خداوند بر اساس قانون آزادی‌بخش، دربارۀ آن‌ها قضاوت می‌کند."
        },
        {
          "verse": 13,
          "usfm": "JAS.2.13",
          "line_type": "p",
          "text": "چون خدا بر کسی که رحم نکرده، رحم نخواهد کرد، ولی همیشه رحمت بر داوری چیره خواهد شد."
        },
        {
          "verse": 14,
          "usfm": "JAS.2.14",
          "line_type": "p",
          "text": "ای برادران من، چه فایده دارد اگر کسی بگوید: «من ایمان دارم،» ولی عمل او این‌ را ثابت نکند؟ آیا چنین ایمانی می‌تواند او را نجات بخشد؟"
        },
        {
          "verse": 15,
          "usfm": "JAS.2.15",
          "line_type": "p",
          "text": "پس اگر در میان شما برادری یا خواهری برهنه و محتاج غذای روزانۀ خود باشد،"
        },
        {
          "verse": 16,
          "usfm": "JAS.2.16",
          "line_type": "p",
          "text": "و یکی از شما به ایشان بگوید «به‌سلامت بروید، و گرم و سیر شوید،» چه فایده‌ای دارد اگر شما احتیاجات جسمانی آن‌ها را برآورده نسازید؟"
        },
        {
          "verse": 17,
          "usfm": "JAS.2.17",
          "line_type": "p",
          "text": "همین‌طور ایمانی که با عمل همراه نباشد، مُرده است."
        },
        {
          "verse": 18,
          "usfm": "JAS.2.18",
          "line_type": "p",
          "text": "ممکن است کسی بگوید: «تو ایمان داری و من کارهای نیکو.» من خواهم گفت: «تو به من ثابت کن چگونه می‌توانی ایمانِ بدون کارهای نیک داشته باشی، و من ایمان خود را به‌وسیلهٔ کارهای نیک خویش به تو ثابت می‌کنم.»"
        },
        {
          "verse": 19,
          "usfm": "JAS.2.19",
          "line_type": "p",
          "text": "تو ایمان داری که خدا واحد است؛ بسیار خوب! دیوها هم ایمان دارند و از ترس می‌لرزند."
        },
        {
          "verse": 20,
          "usfm": "JAS.2.20",
          "line_type": "p",
          "text": "ای نادان، آیا نمی‌دانی که ایمان بدون کار نیک بی‌ثمر است؟"
        },
        {
          "verse": 21,
          "usfm": "JAS.2.21",
          "line_type": "p",
          "text": "پدر ما ابراهیم به‌خاطر کارهای نیک خود در وقتی‌که فرزند خویش اسحاق را در قربانگاه تقدیم خدا کرد، نیک و عادل محسوب شد."
        },
        {
          "verse": 22,
          "usfm": "JAS.2.22",
          "line_type": "p",
          "text": "می‌بینی که چگونه ایمان او محرّک کارهای نیک او بود و کارهای نیک او نیز ایمانش را کامل گردانید."
        },
        {
          "verse": 23,
          "usfm": "JAS.2.23",
          "line_type": "p",
          "text": "آن نوشته که می‌فرماید: «ابراهیم به خدا ایمان آورد و این برایش نیکی مطلق محسوب شد» تحقّق یافت و او دوست خدا خوانده شد."
        },
        {
          "verse": 24,
          "usfm": "JAS.2.24",
          "line_type": "p",
          "text": "پس می‌بینید که چگونه انسان نه فقط از راه ایمان، بلکه به‌وسیلهٔ کارهای نیک خود نیک و عادل شمرده می‌شود."
        },
        {
          "verse": 25,
          "usfm": "JAS.2.25",
          "line_type": "p",
          "text": "همین‌طور راحاب فاحشه نیز با کارهای نیک خود یعنی پذیرفتن قاصدان اسرائیلی و روانه کردن آن‌ها از راه دیگر، نیک و عادل شمرده شد."
        },
        {
          "verse": 26,
          "usfm": "JAS.2.26",
          "line_type": "p",
          "text": "پس همان‌گونه که بدنِ بدونِ ‌روح مُرده است، ایمانِ بدون کارهای نیک نیز مُرده است."
        }
      ],
      "verse_count": 26,
      "headings": [
        {
          "before_verse": 14,
          "text": "ایمان و عمل"
        }
      ],
