    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 4,
      "chapter_usfm": "JAS.4",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.4.1",
          "line_type": "p",
          "text": "جنگ‌وجدال میان شما از کجا سرچشمه می‌گیرند؟ آیا علّت آن‌ها خواهش‌های نفسانی شما نیست، خواهش‌هایی که در تمام اعضای بدن شما در ستیز هستند؟"
        },
        {
          "verse": 2,
          "usfm": "JAS.4.2",
          "line_type": "p",
          "text": "شما در حسرت چیزهایی هستید که ندارید؛ پس به‌خاطر آن‌ها حاضرید دیگران را بکُشید. حسد می‌ورزید، ولی نمی‌توانید آنچه را که می‌خواهید به دست آورید؛ پس با یکدیگر به جنگ‌وجدال می‌پردازید. شما آنچه را که می‌خواهید ندارید چون آن‌ را از خدا نخواسته‌اید."
        },
        {
          "verse": 3,
          "usfm": "JAS.4.3",
          "line_type": "p",
          "text": "اگر از خدا هم بخواهید، دیگر حاجت شما برآورده نمی‌شود، چون با نیّت بد و به‌منظور ارضای هوس‌های خود آن‌ را می‌طلبید."
        },
        {
          "verse": 4,
          "usfm": "JAS.4.4",
          "line_type": "p",
          "text": "ای مردم خیانتکار و بی‌وفا، آیا نمی‌دانید که دلبستگی به این دنیا، دشمنی با خدا است؟ هرکه بخواهد دنیا را دوست داشته باشد، خود را دشمن خدا می‌گرداند."
        },
        {
          "verse": 5,
          "usfm": "JAS.4.5",
          "line_type": "p",
          "text": "آیا تصوّر می‌کنید کلام‌ خدا بی‌معنی است وقتی می‌فرماید: «خدا به آن روحی که خود در دل انسان قرار داده، به‌شدّت علاقه دارد»؟"
        },
        {
          "verse": 6,
          "usfm": "JAS.4.6",
          "line_type": "p",
          "text": "امّا فیضی که خدا می‌بخشد، بسی بیشتر است، زیرا نوشته شده است: «خدا با متکبّران مخالفت می‌کند و به فروتنان فیض می‌بخشد.»"
        },
        {
          "verse": 7,
          "usfm": "JAS.4.7",
          "line_type": "p",
          "text": "پس از خدا اطاعت کنید و در مقابل ابلیس مقاومت نمایید تا از شما بگریزد."
        },
        {
          "verse": 8,
          "usfm": "JAS.4.8",
          "line_type": "p",
          "text": "به خدا نزدیک شوید که او نیز به شما نزدیک خواهد شد. ای گناه‌کاران، دست‌های خود را بشویید. ای ریاکاران، دل‌های خود را پاک سازید،"
        },
        {
          "verse": 9,
          "usfm": "JAS.4.9",
          "line_type": "p",
          "text": "ماتم بگیرید، گریه و ناله کنید. خندۀ شما به گریه و شادی شما به غم مبدّل شود."
        },
        {
          "verse": 10,
          "usfm": "JAS.4.10",
          "line_type": "p",
          "text": "در پیشگاه خدا فروتن شوید و او شما را سرافراز خواهد ساخت."
        },
        {
          "verse": 11,
          "usfm": "JAS.4.11",
          "line_type": "p",
          "text": "ای برادران، از یکدیگر بد نگویید. کسی‌ که از دیگری بد بگوید و یا نسبت به او داوری کند از شریعت بد گفته و آن‌ را محکوم ساخته است. اگر نسبت به شریعت داوری کنی، تو داور شریعت شده‌ای و نه به‌جا آورندۀ آن."
        },
        {
          "verse": 12,
          "usfm": "JAS.4.12",
          "line_type": "p",
          "text": "قانونگذار و داور یکی است، یعنی همان‌که قادر است انسان را نجات بخشد یا هلاک سازد. پس تو کیستی که دربارۀ همسایۀ خود داوری می‌کنی؟"
        },
        {
          "verse": 13,
          "usfm": "JAS.4.13",
          "line_type": "p",
          "text": "ای کسانی‌ که می‌گویید: «امروز یا فردا به فلان شهر می‌رویم و در آنجا یک‌سال تجارت می‌کنیم و سود فراوان می‌بریم،»"
        },
        {
          "verse": 14,
          "usfm": "JAS.4.14",
          "line_type": "p",
          "text": "ولی نمی‌دانید فردا چه خواهد شد، حیات شما مثل بخاری است که لحظه‌ای دیده می‌شود و بعد ناپدید می‌شود."
        },
        {
          "verse": 15,
          "usfm": "JAS.4.15",
          "line_type": "p",
          "text": "در عوض آن، شما باید بگویید: «اگر خدا بخواهد، زنده می‌مانیم و چنین و چنان می‌کنیم.»"
        },
        {
          "verse": 16,
          "usfm": "JAS.4.16",
          "line_type": "p",
          "text": "امّا شما از خودستایی لذّت می‌برید و این‌گونه فخر خطا است."
        },
        {
          "verse": 17,
          "usfm": "JAS.4.17",
          "line_type": "p",
          "text": "بنابراین کسی‌ که بداند کار نیک چیست و آن‌ را انجام ندهد، گناه کرده است."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 11,
          "text": "داوری‌کردن نسبت به دیگران"
        },
        {
          "before_verse": 13,
          "text": "لاف‌ زدن"
        }
      ],
      "footnotes": [
        {
          "verse": 5,
          "usfm": "JAS.4.5",
          "note_ref": "4‏:5",
          "note_type": "footnote",
          "references": [],
          "text": "این آیه در بعضی از ترجمه‌ها این‌طور ادامه دارد: «خدا به آن روحی که خود در دل انسان قرار داده، به‌شدّت علاقه دارد و نمی‌تواند تمایل انسان را به چیزی جز خود تحمّل نماید»؟"
        },
        {
          "verse": 6,
          "usfm": "JAS.4.6",
          "note_ref": "4‏:6",
          "note_type": "footnote",
          "references": [],
          "text": "نقل قول از امثال سلیمان ۳‏:۳۴"
        }
      ],
