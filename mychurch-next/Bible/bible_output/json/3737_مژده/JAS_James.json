    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 3,
      "chapter_usfm": "JAS.3",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.3.1",
          "line_type": "p",
          "text": "ای برادران من، مبادا بسیاری از شما بخواهید معلّم دیگران باشید، چون می‌دانید که روز داوری برای ما معلّمین سخت‌تر خواهد بود."
        },
        {
          "verse": 2,
          "usfm": "JAS.3.2",
          "line_type": "p",
          "text": "همۀ ما مرتکب خطاهای بسیاری می‌شویم ولی کسی‌ که در سخن گفتن خطا نکند، انسان کاملی است و می‌تواند تمام وجود خود را مهار کند."
        },
        {
          "verse": 3,
          "usfm": "JAS.3.3",
          "line_type": "p",
          "text": "ما به دهان اسبان دهنه می‌زنیم تا مطیع ما شوند و به‌این‌وسیله تمام بدن آن‌ها را به هر طرف که بخواهیم هدایت می‌کنیم."
        },
        {
          "verse": 4,
          "usfm": "JAS.3.4",
          "line_type": "p",
          "text": "همچنین می‌توان کشتی‌های بسیار بزرگ را که با بادهای تند به حرکت در‌می‌آیند، با استفاده از سکّان بسیار کوچکی مهار کرد و به هر جا که ناخدا بخواهد، هدایت نمود."
        },
        {
          "verse": 5,
          "usfm": "JAS.3.5",
          "line_type": "p",
          "text": "زبان هم همین‌طور است؛ گرچه عضو کوچکی است ولی ادّعاهای بسیار بزرگی می‌نماید. چه جنگل‌های بزرگ که با جرقه‌ای، آتش می‌گیرند."
        },
        {
          "verse": 6,
          "usfm": "JAS.3.6",
          "line_type": "p",
          "text": "زبان هم آتش است! در میان تمام اعضای بدن ما، زبان دنیایی از شرارت است که همۀ وجودمان را آلوده می‌سازد و آتش آن تمام زندگی ما را می‌سوزاند، آتشی که از جهنّم سرچشمه می‌گیرد."
        },
        {
          "verse": 7,
          "usfm": "JAS.3.7",
          "line_type": "p",
          "text": "انسان توانسته است و بازهم می‌تواند تمام حیوانات وحشی و پرندگان و خزندگان و ماهیان را رام کند،"
        },
        {
          "verse": 8,
          "usfm": "JAS.3.8",
          "line_type": "p",
          "text": "ولی هیچ‌کس نمی‌تواند زبان را مهار کند. زبان، شرور و رام نشدنی و پُر از زهر کُشنده است."
        },
        {
          "verse": 9,
          "usfm": "JAS.3.9",
          "line_type": "p",
          "text": "ما با آن، هم خداوند و پدر را حمد و سپاس می‌گوییم و هم انسان را که به‌صورت خدا آفریده شده است، لعنت می‌کنیم."
        },
        {
          "verse": 10,
          "usfm": "JAS.3.10",
          "line_type": "p",
          "text": "از یک دهان هم شکر و سپاس شنیده می‌شود و هم لعنت! ای برادران من، نباید چنین باشد."
        },
        {
          "verse": 11,
          "usfm": "JAS.3.11",
          "line_type": "p",
          "text": "آیا یک چشمه می‌تواند از یک شکاف هم آب شیرین و هم آب شور جاری سازد؟"
        },
        {
          "verse": 12,
          "usfm": "JAS.3.12",
          "line_type": "p",
          "text": "ای برادران من، آیا درخت انجیر می‌تواند زیتون و یا درخت انگور، انجیر به بار آورد؟ همین‌طور چشمۀ آب شور هم نمی‌تواند از خود آب شیرین جاری سازد."
        },
        {
          "verse": 13,
          "usfm": "JAS.3.13",
          "line_type": "p",
          "text": "در میان شما چه کسی عاقل و فهیم است؟ او باید با زندگی و کارهای نیک خود که با تواضعی که از حکمت سرچشمه می‌گیرد، آن‌ را نشان دهد."
        },
        {
          "verse": 14,
          "usfm": "JAS.3.14",
          "line_type": "p",
          "text": "امّا اگر شما حسود و تندخو و خودخواه هستید، به خود فخر نکنید و برخلاف حقیقت به دروغ سخن نگویید؛"
        },
        {
          "verse": 15,
          "usfm": "JAS.3.15",
          "line_type": "p",
          "text": "این حکمت از بالا نیست، بلکه دنیوی، نفسانی و شیطانی است."
        },
        {
          "verse": 16,
          "usfm": "JAS.3.16",
          "line_type": "p",
          "text": "چون هر جا حسد و جاه‌طلبی هست، در آنجا بی‌نظمی و شرارت نیز هست."
        },
        {
          "verse": 17,
          "usfm": "JAS.3.17",
          "line_type": "p",
          "text": "امّا حکمتی که از عالم بالا است، اوّل پاک است، بعد صلح‌جو، باگذشت، مهربان، بی‌غرض و بی‌ریا، پُر از شفقّت و ثمرات نیکو."
        },
        {
          "verse": 18,
          "usfm": "JAS.3.18",
          "line_type": "p",
          "text": "نیکی و عدالت، میوۀ بذرهایی است که به دست صالحان در صلح و صفا کاشته می‌شود."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 13,
          "text": "حکمت آسمانی"
        }
      ],
