    {
      "schema_version": 6,
      "book_id": "JAS",
      "chapter": 5,
      "chapter_usfm": "JAS.5",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "JAS.5.1",
          "line_type": "p",
          "text": "و شما ای ثروتمندان، برای بلاهایی که بر سر شما می‌آید، گریه و زاری کنید."
        },
        {
          "verse": 2,
          "usfm": "JAS.5.2",
          "line_type": "p",
          "text": "ثروت شما تباه گشته و لباس‌های زیبایتان را بید خورده است."
        },
        {
          "verse": 3,
          "usfm": "JAS.5.3",
          "line_type": "p",
          "text": "سیم و زَر شما زنگ زده و زنگ آن‌ها مدرکی علیه شما است و مانند آتش بدن شما را خواهد سوزاند. شما در این روزهای آخر به اندوختن ثروت مشغولید."
        },
        {
          "verse": 4,
          "usfm": "JAS.5.4",
          "line_type": "p",
          "text": "مزد کارگرانی که مزرعه‌های شما را درو کرده‌اند و شما آن‌ها را نپرداخته‌اید، علیه شما فریاد می‌کنند و نالۀ دروگران به گوش خداوند متعال رسیده است."
        },
        {
          "verse": 5,
          "usfm": "JAS.5.5",
          "line_type": "p",
          "text": "شما در روی زمین در تجمّل و خوشگذرانی زندگی کرده‌اید و خود را برای روز ذبح پروار کرده‌اید."
        },
        {
          "verse": 6,
          "usfm": "JAS.5.6",
          "line_type": "p",
          "text": "شخص نیک را محکوم کرده‌ کشتید. او با شما مقاومت نمی‌کند."
        },
        {
          "verse": 7,
          "usfm": "JAS.5.7",
          "line_type": "p",
          "text": "ای برادران من، تا ظهور خداوند صبر کنید. زارع برای برداشت محصول پرارزش زمین با صبر و شکیبایی منتظر باران‌های پاییزی و بهاری می‌ماند."
        },
        {
          "verse": 8,
          "usfm": "JAS.5.8",
          "line_type": "p",
          "text": "شما نیز باید صبر کنید و قوی‌دل باشید زیرا آمدن خداوند نزدیک است."
        },
        {
          "verse": 9,
          "usfm": "JAS.5.9",
          "line_type": "p",
          "text": "ای برادران من، از یکدیگر شکایت نکنید، مبادا خود شما محکوم شوید، چون داور عادل آمادۀ داوری است."
        },
        {
          "verse": 10,
          "usfm": "JAS.5.10",
          "line_type": "p",
          "text": "ای برادران من، صبر و تحمّل انبیایی که با سختی‌ها به نام خداوند سخن می‌گفتند، باید برای شما نمونه باشد."
        },
        {
          "verse": 11,
          "usfm": "JAS.5.11",
          "line_type": "p",
          "text": "ما اشخاص صبور را خوشبخت می‌دانیم. شما دربارۀ صبر و تحمّل ایّوب شنیده‌اید و می‌دانید سرانجام خداوند به او چه داد؛ زیرا خداوند بی‌نهایت رحیم و مهربان است."
        },
        {
          "verse": 12,
          "usfm": "JAS.5.12",
          "line_type": "p",
          "text": "ای برادران من، از همه مهم‌تر این است که سوگند نخورید، نه به آسمان، نه به زمین و نه به هیچ‌چیز دیگر، بلکه بلی شما واقعاً بلی باشد و نهِ شما نه، مبادا محکوم شوید."
        },
        {
          "verse": 13,
          "usfm": "JAS.5.13",
          "line_type": "p",
          "text": "اگر برای کسی از شما مصیبتی روی دهد، او باید دعا کند و اگر خوشحال است، باید سرود حمد بخواند."
        },
        {
          "verse": 14,
          "usfm": "JAS.5.14",
          "line_type": "p",
          "text": "اگر کسی از شما بیمار است، باید از مشایخ کلیسا بخواهد تا برای او دعا کنند و او را به نام خداوند با روغن تدهین نمایند،"
        },
        {
          "verse": 15,
          "usfm": "JAS.5.15",
          "line_type": "p",
          "text": "و دعای با ایمان بیمار را شفا خواهد بخشید. خداوند او را از بستر بیماری بلند خواهد کرد و اگر مرتکب گناهی شده باشد، بخشیده خواهد شد."
        },
        {
          "verse": 16,
          "usfm": "JAS.5.16",
          "line_type": "p",
          "text": "نزد یکدیگر به گناهان خود اعتراف نمایید و برای یکدیگر دعا کنید، تا شفا یابید. دعای شخص عادل و نیک بسیار قوی و مؤثّر است."
        },
        {
          "verse": 17,
          "usfm": "JAS.5.17",
          "line_type": "p",
          "text": "الیاس دارای عواطفی مانند خود ما بود، ولی وقتی از صمیم قلب دعا کرد که باران نبارد، سه سال و شش ماه در آن سرزمین باران نبارید."
        },
        {
          "verse": 18,
          "usfm": "JAS.5.18",
          "line_type": "p",
          "text": "دوباره دعا کرد و باران بارید و زمین بار دیگر محصول به بار آورد."
        },
        {
          "verse": 19,
          "usfm": "JAS.5.19",
          "line_type": "p",
          "text": "ای برادران من، اگر کسی از شما از حقیقت منحرف گردد و شخص دیگری او را برگردانَد،"
        },
        {
          "verse": 20,
          "usfm": "JAS.5.20",
          "line_type": "p",
          "text": "یقین بدانید که هر‌کس گناهکاری را از گمراهی بازگرداند، جانی را از مرگ خواهد رهانید و گناهان بی‌شماری را خواهد پوشانید."
        }
      ],
      "verse_count": 20,
