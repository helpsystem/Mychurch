  "chapters": [
    {
      "schema_version": 6,
      "book_id": "RUT",
      "chapter": 1,
      "chapter_usfm": "RUT.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "RUT.1.1",
          "line_type": "p",
          "text": "در روزگاری که داوران بر اسرائیل حکومت می‌کردند، قحطی سختی در آن سرزمین واقع گشت."
        },
        {
          "verse": 2,
          "usfm": "RUT.1.2",
          "line_type": "p",
          "text": "به همین دلیل، شخصی به نام اِلیمِلِک که از خاندان اِفراتَه بود و در بِیت‌لِحِم یهودیه زندگی می‌کرد، به اتّفاق همسرش نَعومی و دو پسرش مَحلون و کلیون به سرزمین موآب کوچ کرد تا در آنجا زندگی کنند. در طول اقامتشان در آنجا،"
        },
        {
          "verse": 3,
          "usfm": "RUT.1.3",
          "line_type": "p",
          "text": "اِلیمِلِک شوهر نَعومی درگذشت و او با دو پسرش تنها ماند."
        },
        {
          "verse": 4,
          "usfm": "RUT.1.4",
          "line_type": "p",
          "text": "این دو پسر با دو دختر موآبی به نام‌های عُرفه و روت ازدواج کردند و ایشان حدود ده سال در آنجا زندگی نمودند."
        },
        {
          "verse": 5,
          "usfm": "RUT.1.5",
          "line_type": "p",
          "text": "سپس مَحلون و کلیون نیز درگذشتند و نَعومی بدون شوهر و فرزند ماند."
        },
        {
          "verse": 6,
          "usfm": "RUT.1.6",
          "line_type": "p",
          "text": "پس از مدّتی، نَعومی شنید که خداوند قوم خود را با اعطای محصول فراوان برکت داده است. او تصمیم گرفت به‌ همراه دو عروس خود، موآب را ترک کند."
        },
        {
          "verse": 7,
          "usfm": "RUT.1.7",
          "line_type": "p",
          "text": "بنابراین آن‌ها با هم به راه افتادند تا به یهودیه بازگردند. امّا در بین راه"
        },
        {
          "verse": 8,
          "usfm": "RUT.1.8",
          "line_type": "p",
          "text": "نَعومی به آن‌ها گفت: «به خانه‌های خود، نزد مادرانتان بازگردید. امیدوارم خداوند در عوض نیکویی که به من و به فرزندانم کرده‌اید، با شما به نیکی رفتار کند."
        },
        {
          "verse": 9,
          "usfm": "RUT.1.9",
          "line_type": "p",
          "text": "دعای من این است که هر دوی شما بتوانید ازدواج کنید و تشکیل خانواده بدهید.»پس نَعومی آن‌ها را بوسید و از آن‌ها خداحافظی کرد. امّا آن‌ها گریه‌کنان"
        },
        {
          "verse": 10,
          "usfm": "RUT.1.10",
          "line_type": "p",
          "text": "به او گفتند: «نه، ما حتماً همراه تو و به میان قوم تو خواهیم آمد.»"
        },
        {
          "verse": 11,
          "usfm": "RUT.1.11",
          "line_type": "p",
          "text": "امّا نَعومی در پاسخ گفت: «دخترانم، شما باید بازگردید. چرا می‌خواهید همراه من باشید؟ آیا فکر می‌کنید که من می‌توانم دوباره صاحب پسرانی شوم که با شما ازدواج کنند؟"
        },
        {
          "verse": 12,
          "usfm": "RUT.1.12",
          "line_type": "p",
          "text": "به خانۀ خود بروید، چون من پیرتر از آن هستم که بتوانم دوباره ازدواج کنم. حتّی اگر چنین چیزی امکان داشت و همین امشب ازدواج می‌کردم و صاحب دو پسر می‌شدم،"
        },
        {
          "verse": 13,
          "usfm": "RUT.1.13",
          "line_type": "p",
          "text": "آیا شما می‌توانید صبر کنید تا آن‌ها بزرگ شوند؟ آیا این امید، مانع ازدواج شما با دیگران نخواهد شد؟ نه دخترانم، شما می‌دانید که این غیرممکن است. خداوند با من از درِ خشم درآمده و از این بابت برای شما بسیار متأسفم.»"
        },
        {
          "verse": 14,
          "usfm": "RUT.1.14",
          "line_type": "p",
          "text": "آن‌ها باز به گریه افتادند. پس از آن عرفه مادرشوهر خود را بوسید و از او خداحافظی کرد و به خانۀ خود برگشت. امّا روت به او چسبید."
        },
        {
          "verse": 15,
          "usfm": "RUT.1.15",
          "line_type": "p",
          "text": "پس نَعومی به او گفت: «روت، زنِ برادرشوهرت نزد قوم خود و خدایان خود برگشته است. تو نیز همراه او برو.»"
        },
        {
          "verse": 16,
          "usfm": "RUT.1.16",
          "line_type": "p",
          "text": "امّا روت در جواب گفت: «از من نخواه که تو را ترک کنم. اجازه بده همراه تو بیایم. هر جا بروی، من نیز خواهم آمد و هر جا زندگی کنی، من هم در آنجا زندگی خواهم کرد. قوم تو، قوم من و خدای تو، خدای من خواهد بود."
        },
        {
          "verse": 17,
          "usfm": "RUT.1.17",
          "line_type": "p",
          "text": "هر جا تو بمیری، من هم خواهم مرد و در همان‌جا دفن خواهم شد. خداوند مرا جزا دهد اگر چیزی جز مرگ، مرا از تو جدا سازد.»"
        },
        {
          "verse": 18,
          "usfm": "RUT.1.18",
          "line_type": "p",
          "text": "وقتی نَعومی دید که روت برای همراهی او مصمّم است، دیگر چیزی نگفت."
        },
        {
          "verse": 19,
          "usfm": "RUT.1.19",
          "line_type": "p",
          "text": "آن‌ها به راه خود ادامه دادند تا به بِیت‌لِحِم رسیدند. وقتی وارد شهر شدند، مردم از دیدنشان به هیجان آمدند و زنان با تعجّب می‌گفتند: «آیا این نَعومی است؟»"
        },
        {
          "verse": 20,
          "usfm": "RUT.1.20",
          "line_type": "p",
          "text": "او در پاسخ گفت: «دیگر مرا نَعومی نخوانید، مرا مارَه صدا کنید، چون خدای قادر مطلق زندگی مرا تلخ ساخته است."
        },
        {
          "verse": 21,
          "usfm": "RUT.1.21",
          "line_type": "p",
          "text": "وقتی اینجا را ترک کردم، صاحب همه‌‌چیز بودم، امّا خداوند مرا دست‌ خالی به اینجا بازگردانده است. چرا مرا نَعومی صدا می‌کنید در‌حالی‌که خداوند قادر مطلق مرا محکوم کرده و بلا بر من آورده است؟»"
        },
        {
          "verse": 22,
          "usfm": "RUT.1.22",
          "line_type": "p",
          "text": "به‌این‌ترتیب نَعومی به‌ همراه روت، عروس موآبی خود، از موآب بازگشت. وقتی آن‌ها به بِیت‌لِحِم رسیدند، فصل برداشت جو به‌تازگی شروع شده بود."
        }
      ],
      "verse_count": 22,
      "headings": [
        {
          "before_verse": 6,
          "text": "بازگشت نَعومی و روت به بِیت‌لِحِم"
        }
      ],
      "footnotes": [
        {
          "verse": 13,
          "usfm": "RUT.1.13",
          "note_ref": "1‏:13",
          "note_type": "footnote",
          "references": [],
          "text": "از متن عبری این برداشت نیز ممکن است: چون دست خداوند علیه من بوده و این برای من سخت‌تر است تا برای شما!"
        },
        {
          "verse": 19,
          "usfm": "RUT.1.19",
          "note_ref": "1‏:19",
          "note_type": "footnote",
