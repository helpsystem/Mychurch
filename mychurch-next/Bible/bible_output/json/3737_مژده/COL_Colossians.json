    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 2,
      "chapter_usfm": "COL.2",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.2.1",
          "line_type": "p",
          "text": "می‌خواهم بدانید که چقدر برای شما و ایمان‌داران «لائودیکیه» و برای همۀ آنانی که تا‌به‌حال روی مرا ندیده‌اند زحمت می‌کشم،"
        },
        {
          "verse": 2,
          "usfm": "COL.2.2",
          "line_type": "p",
          "text": "تا آنان دل‌گرم شده در محبّت متّحد گردند و از برکاتِ سرشارِ اطمینانی کامل که از راه درک حقیقی به دست می‌آید، بهره‌مند شده از این راه به راز خدا، یعنی مسیح، پی ببرند،"
        },
        {
          "verse": 3,
          "usfm": "COL.2.3",
          "line_type": "p",
          "text": "که در او تمام گنجینه‌های حکمت و معرفت الهی نهفته است."
        },
        {
          "verse": 4,
          "usfm": "COL.2.4",
          "line_type": "p",
          "text": "این‌ را می‌گویم تا مبادا کسی شما را با دلایل مجذوب‌کننده گمراه سازد،"
        },
        {
          "verse": 5,
          "usfm": "COL.2.5",
          "line_type": "p",
          "text": "زیرا اگرچه جسماً غایب هستم ولی در روح حضور دارم و از دیدن نظم و ترتیب در شما، و ثبات ایمانتان به مسیح خوشحالم."
        },
        {
          "verse": 6,
          "usfm": "COL.2.6",
          "line_type": "p",
          "text": "پس شما که مسیح عیسی را به‌عنوان خداوند خود پذیرفته‌اید، همیشه در اتّحاد با او زندگی کنید."
        },
        {
          "verse": 7,
          "usfm": "COL.2.7",
          "line_type": "p",
          "text": "در او ریشه بگیرید و رشد کنید. همان‌گونه که تعلیم یافتید، در ایمان استوار باشید و در شکرگزاری پیشرفت کنید."
        },
        {
          "verse": 8,
          "usfm": "COL.2.8",
          "line_type": "p",
          "text": "مراقب باشید مبادا کسی شما را با فلسفه‌ای که متّکی به سنّت‌های انسانی و عقاید پوچ این جهان است اسیر خود سازد. این تعالیم از مسیح نیست."
        },
        {
          "verse": 9,
          "usfm": "COL.2.9",
          "line_type": "p",
          "text": "زیرا الوهیّت به‌طور کامل در وجود مسیح مجسم شد"
        },
        {
          "verse": 10,
          "usfm": "COL.2.10",
          "line_type": "p",
          "text": "و شما نیز به‌وسیلهٔ اتّحاد با او که بالاتر از همۀ قدرت‌ها و ریاست‌ها است، کامل شده‌اید."
        },
        {
          "verse": 11,
          "usfm": "COL.2.11",
          "line_type": "p",
          "text": "شما نیز در اتّحاد با او ختنه شده‌اید، ختنه‌ای که به دست انسان صورت نگرفته است بلکه ختنه‌ای به‌وسیلهٔ مسیح که همانا قطع طبیعت نفسانی است."
        },
        {
          "verse": 12,
          "usfm": "COL.2.12",
          "line_type": "p",
          "text": "شما در تعمید خود با مسیح مدفون شدید و به‌وسیلهٔ ایمان به قدرت خدا که مسیح را پس از مرگ زنده گردانید، با او قیام کردید."
        },
        {
          "verse": 13,
          "usfm": "COL.2.13",
          "line_type": "p",
          "text": "خدا شما را که به علّت خطاهای خود مُرده و در جسم خود نامختون بودید، با مسیح زنده کرد و همۀ گناهان ما را بخشیده است."
        },
        {
          "verse": 14,
          "usfm": "COL.2.14",
          "line_type": "p",
          "text": "او سند محکومیّت ما را همراه با تمام قوانینش که علیه ما بود، لغو کرد و آن‌ را به صلیب خود میخکوب نموده از بین برد."
        },
        {
          "verse": 15,
          "usfm": "COL.2.15",
          "line_type": "p",
          "text": "مسیح بر روی صلیب، تمام قدرت‌های آسمانی و فرمانروایان را خلع سلاح کرده بر آن‌ها پیروز شد و آن‌ها را نزد همه رسوا ساخت."
        },
        {
          "verse": 16,
          "usfm": "COL.2.16",
          "line_type": "p",
          "text": "بنابراین به هیچ‌وجه اجازه ندهید کسی شما را در مورد خوراک یا آشامیدنی یا رعایت عید یا ماه نو یا روز سَبَّت محکوم نماید."
        },
        {
          "verse": 17,
          "usfm": "COL.2.17",
          "line_type": "p",
          "text": "این‌ها فقط سایۀ آن واقعیّتی است که قرار است بیاید و آن واقعیّت، خود مسیح است."
        },
        {
          "verse": 18,
          "usfm": "COL.2.18",
          "line_type": "p",
          "text": "اجازه ندهید کسی با تظاهر به فروتنی و پرستش فرشتگان، شما را از دریافت پاداش‌تان محروم سازد، زیرا این قبیل اشخاص با اتّکا به رؤیاهایی که دیده‌اند و به‌خاطر افکار دنیوی خود، بی‌جهت مغرور شده‌اند"
        },
        {
          "verse": 19,
          "usfm": "COL.2.19",
          "line_type": "p",
          "text": "و رابطۀ خود را با سر یعنی با مسیح قطع کرده‌اند. در‌حالی‌که در مسیح تمام بدن نیرو می‌گیرد و به توسط مفاصل و رشته‌ها به هم متّصل می‌شود و همان‌طور که خدا می‌خواهد، رشد می‌کند."
        },
        {
          "verse": 20,
          "usfm": "COL.2.20",
          "line_type": "p",
          "text": "چون شما با مسیح مُردید، با عقاید بچّگانۀ این جهان قطع رابطه کرده‌اید. پس چرا طوری زندگی می‌کنید که گویا هنوز به دنیا وابستگی دارید؟ چرا مطیع دستوراتی از قبیل"
        },
        {
          "verse": 21,
          "usfm": "COL.2.21",
          "line_type": "p",
          "text": "«این را لمس نکن، به آن لب نزن و به این دست نزن» می‌شوید؟!"
        },
        {
          "verse": 22,
          "usfm": "COL.2.22",
          "line_type": "p",
          "text": "این‌ها همه در اثر مصرف از بین می‌روند و این دستورات فقط قوانین و تعالیم انسان هستند!"
        },
        {
          "verse": 23,
          "usfm": "COL.2.23",
          "line_type": "p",
          "text": "هرچند این دستورات که با فروتنی و ریاضت‌کشی همراهند و ظاهراً معقول به نظر می‌آیند، ولی درواقع نمی‌توانند مانع ارضای شهوات نفسانی شوند!"
        }
      ],
      "verse_count": 23,
      "headings": [
        {
          "before_verse": 6,
          "text": "زندگی کامل در مسیح"
        },
        {
          "before_verse": 20,
          "text": "زندگی جدید در مسیح"
        }
      ],
