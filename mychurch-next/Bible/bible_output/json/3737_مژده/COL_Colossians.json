    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 3,
      "chapter_usfm": "COL.3",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.3.1",
          "line_type": "p",
          "text": "حالا که با مسیح زنده شده‌اید، باید به آنچه در آسمان است، جایی‌که مسیح در آنجا در دست راست خدا نشسته است، دل ببندید."
        },
        {
          "verse": 2,
          "usfm": "COL.3.2",
          "line_type": "p",
          "text": "دربارۀ آنچه در عالم بالا است بیندیشید، نه به آنچه بر روی زمین است."
        },
        {
          "verse": 3,
          "usfm": "COL.3.3",
          "line_type": "p",
          "text": "زیرا شما مُرده‌اید و زندگی شما اکنون با مسیح در خدا پنهان است."
        },
        {
          "verse": 4,
          "usfm": "COL.3.4",
          "line_type": "p",
          "text": "وقتی مسیح که زندگی ما است ظهور کند، شما نیز با او در جلال ظهور خواهید کرد."
        },
        {
          "verse": 5,
          "usfm": "COL.3.5",
          "line_type": "p",
          "text": "بنابراین، تمایلات دنیوی یعنی زنا، ناپاکی، هوی‌وهوس، شهوت و طمع را، که یک نوع بُت‌پرستی است، در خود بکُشید."
        },
        {
          "verse": 6,
          "usfm": "COL.3.6",
          "line_type": "p",
          "text": "به‌ سبب این کارها است که افراد سرکش گرفتار غضب خدا می‌شوند."
        },
        {
          "verse": 7,
          "usfm": "COL.3.7",
          "line_type": "p",
          "text": "شما نیز زمانی‌ مانند آن‌ها زندگی می‌کردید و مانند آن‌ها رفتار می‌کردید."
        },
        {
          "verse": 8,
          "usfm": "COL.3.8",
          "line_type": "p",
          "text": "امّا اکنون شما باید خشم، غیظ و بدخواهی را از دل‌هایتان و اهانت و حرف‌های زشت را از لب‌های خود به کلّی دور سازید."
        },
        {
          "verse": 9,
          "usfm": "COL.3.9",
          "line_type": "p",
          "text": "دیگر دروغ نگویید، زیرا با آن آدمی که در گذشته بودید و عادت‌های او قطع رابطه کرده‌اید،"
        },
        {
          "verse": 10,
          "usfm": "COL.3.10",
          "line_type": "p",
          "text": "و زندگی را به‌صورت انسان تازه‌ای شروع نموده‌اید، انسانی که با شناختی کامل‌تر پیوسته در شباهت خالق خود به شکل تازه‌ای در می‌آید، تا رفته‌رفته به شناخت کامل خدا برسد."
        },
        {
          "verse": 11,
          "usfm": "COL.3.11",
          "line_type": "p",
          "text": "پس بین یونانی و یهودی، مختون و نامختون، بربری و وحشی، غلام و آزاد فرقی وجود ندارد، بلکه مسیح همه‌‌چیز است و در همه می‌باشد."
        },
        {
          "verse": 12,
          "usfm": "COL.3.12",
          "line_type": "p",
          "text": "پس شما که برگزیدگان مقدّس و محبوب خدا هستید، خود را به دل‌سوزی، مهربانی، فروتنی، ملایمت و بردباری ملبّس سازید."
        },
        {
          "verse": 13,
          "usfm": "COL.3.13",
          "line_type": "p",
          "text": "متحمّل یکدیگر شوید و اگر از دیگران شکایتی دارید، یکدیگر را عفو کنید و چنان‌که خداوند شما را بخشیده است، شما نیز یکدیگر را ببخشید."
        },
        {
          "verse": 14,
          "usfm": "COL.3.14",
          "line_type": "p",
          "text": "به همۀ این‌ها محبّت را اضافه کنید، زیرا محبّت همه‌‌چیز را به کمال به هم می‌پیوندد."
        },
        {
          "verse": 15,
          "usfm": "COL.3.15",
          "line_type": "p",
          "text": "آرامشی که مسیح به شما می‌بخشد، در وجود شما حکم‌فرما باشد، چون خدا شما را به‌عنوان اعضای یک بدن به این آرامش خوانده است و شما باید سپاسگزار باشید."
        },
        {
          "verse": 16,
          "usfm": "COL.3.16",
          "line_type": "p",
          "text": "اجازه بدهید که پیام مسیح با تمام پُری آن سرتاسر وجود شما را فراگیرد. یکدیگر را با نهایت خردمندی تعلیم و پند دهید و با سپاسگزاری از صمیم دل برای خدا زبور، تسبیحات و سرودهای روحانی بخوانید."
        },
        {
          "verse": 17,
          "usfm": "COL.3.17",
          "line_type": "p",
          "text": "هرچه می‌کنید، چه گفتار، چه کردار، همه را به نام عیسای خداوند انجام دهید و به واسطۀ او خدای پدر را دائماً سپاس گویید."
        },
        {
          "verse": 18,
          "usfm": "COL.3.18",
          "line_type": "p",
          "text": "ای زن‌ها، مطیع شوهران خود باشید، زیرا این‌ نشانۀ زندگی شما در خداوند است."
        },
        {
          "verse": 19,
          "usfm": "COL.3.19",
          "line_type": "p",
          "text": "ای شوهرها، زن‌هایتان را محبّت کنید و با آنان تندی نکنید."
        },
        {
          "verse": 20,
          "usfm": "COL.3.20",
          "line_type": "p",
          "text": "ای فرزندان، از والدین خود در هر امری اطاعت کنید، زیرا این‌ کار خداوند را خشنود می‌سازد."
        },
        {
          "verse": 21,
          "usfm": "COL.3.21",
          "line_type": "p",
          "text": "ای پدران، فرزندان خود را خشمگین نسازید مبادا دل‌سرد شوند."
        },
        {
          "verse": 22,
          "usfm": "COL.3.22",
          "line_type": "p",
          "text": "ای غلامان، در کلّیۀ امور مطیع اربابان دنیوی خود باشید و اطاعت شما فقط به‌خاطر این نباشد که تحت مراقبت هستید یا می‌خواهید آنان را خشنود سازید، بلکه با خلوص نیّت و خداترسی اطاعت کنید."
        },
        {
          "verse": 23,
          "usfm": "COL.3.23",
          "line_type": "p",
          "text": "هرکاری که می‌کنید با دل‌وجان انجام دهید چنان‌که گویی برای خداوند کار می‌کنید، نه برای انسان."
        },
        {
          "verse": 24,
          "usfm": "COL.3.24",
          "line_type": "p",
          "text": "زیرا می‌دانید که پاداش خود را به‌عنوان میراث از خداوند دریافت خواهید کرد. شما غلامان مسیح هستید."
        },
        {
          "verse": 25,
          "usfm": "COL.3.25",
          "line_type": "p",
          "text": "شخص بدکار کیفر بد خود را خواهد دید و خدا تبعیض قائل نمی‌شود."
        }
      ],
      "verse_count": 25,
      "headings": [
        {
          "before_verse": 18,
          "text": "وظایف اجتماعی یک مسیحی"
        }
      ],
