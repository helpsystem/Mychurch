  "chapters": [
    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 1,
      "chapter_usfm": "COL.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.1.1",
          "line_type": "p",
          "text": "از طرف پولس که به خواست خدا، رسول مسیح عیسی است و از طرف برادر ما تیموتاؤس،"
        },
        {
          "verse": 2,
          "usfm": "COL.1.2",
          "line_type": "p",
          "text": "به برادران مقدّس و وفادار در شهر کولسیه، که با مسیح متّحد می‌باشند. پدر ما خدا، فیض و آرامش به شما عطا فرماید."
        },
        {
          "verse": 3,
          "usfm": "COL.1.3",
          "line_type": "p",
          "text": "هر وقت که برای شما دعا می‌کنیم، پدر خداوند ما عیسای مسیح را سپاس می‌گوییم،"
        },
        {
          "verse": 4,
          "usfm": "COL.1.4",
          "line_type": "p",
          "text": "زیرا ما از ایمان شما به مسیح عیسی و محبّت شما به همۀ مقدّسین آگاه هستیم."
        },
        {
          "verse": 5,
          "usfm": "COL.1.5",
          "line_type": "p",
          "text": "امید شما به آنچه در عالم بالا در انتظار شما است، باعث این ایمان و محبّت است. وقتی پیام حقیقی یعنی مژدۀ انجیل برای اوّلین بار به شما رسید، از این امید باخبر شدید."
        },
        {
          "verse": 6,
          "usfm": "COL.1.6",
          "line_type": "p",
          "text": "این مژده همان‌طوری‌که به شما رسید، به تمام جهان نیز رسیده است و به همان‌ نحو‌ که در جهان ثمر آورده رشد و نمو می‌کند، در میان شما نیز از همان روزی که از فیض خدا باخبر شدید و به‌راستی آن‌ را درک کردید، عمل کرده است."
        },
        {
          "verse": 7,
          "usfm": "COL.1.7",
          "line_type": "p",
          "text": "شما آن مژده را از «اِپفراس» عزیز که همچون ما غلام و از طرف ما خادم وفادار مسیح است، آموختید"
        },
        {
          "verse": 8,
          "usfm": "COL.1.8",
          "line_type": "p",
          "text": "و او نیز ما را از محبّتی که روح‌القدس به شما بخشیده، مطّلع ساخته است."
        },
        {
          "verse": 9,
          "usfm": "COL.1.9",
          "line_type": "p",
          "text": "به‌این‌جهت از همان روزی که این‌ را شنیدیم، همیشه برای شما دعا می‌کنیم و از خدا می‌خواهیم که شما را از بینش و فهم روحانی پُر نماید تا ارادۀ او را کاملاً درک کنید،"
        },
        {
          "verse": 10,
          "usfm": "COL.1.10",
          "line_type": "p",
          "text": "تا به‌این‌ترتیب طوری که شایستۀ خداوند است زندگی کنید، کاملاً او را خشنود ساخته در تمام کارهای نیک ثمر بیاورید و در معرفت خدا رشد و نمو کنید."
        },
        {
          "verse": 11,
          "usfm": "COL.1.11",
          "line_type": "p",
          "text": "دعا می‌کنم که به‌وسیلهٔ قدرت پُرشکوه او کاملاً تقویت شوید تا با شادی و صبر هر چیز را تحمّل کنید."
        },
        {
          "verse": 12,
          "usfm": "COL.1.12",
          "line_type": "p",
          "text": "پیوسته خدای پدر را شکر کنید که شما را لایق آن گردانیده است تا در میراثی که در عالم نورانی در انتظار مقدّسین است، سهمی داشته باشید."
        },
        {
          "verse": 13,
          "usfm": "COL.1.13",
          "line_type": "p",
          "text": "او ما را از چنگ نیرومند ظلمت رهانید و به پادشاهی پسر عزیزش منتقل ساخت."
        },
        {
          "verse": 14,
          "usfm": "COL.1.14",
          "line_type": "p",
          "text": "به‌وسیلهٔ او ما آزاد شده‌ایم و گناهانمان آمرزیده شده است."
        },
        {
          "verse": 15,
          "usfm": "COL.1.15",
          "line_type": "p",
          "text": "مسیح، صورت و مظهر خدای نادیده است و نخست‌زاده و بالاتر از همۀ مخلوقات،"
        },
        {
          "verse": 16,
          "usfm": "COL.1.16",
          "line_type": "p",
          "text": "زیرا به‌وسیلۀ او هرآنچه در آسمان و زمین است، دیدنی‌ها و نادیدنی‌ها، پادشاهان، حکمرانان، اوّلیای امور و صاحبان قدرت آفریده شدند. آری، تمام موجودات به‌وسیلهٔ او و برای او آفریده شدند."
        },
        {
          "verse": 17,
          "usfm": "COL.1.17",
          "line_type": "p",
          "text": "او قبل از همه‌‌چیز وجود داشت و همه‌‌چیز در ارتباط او با هم دوام می‌آورد."
        },
        {
          "verse": 18,
          "usfm": "COL.1.18",
          "line_type": "p",
          "text": "او سر و منشأ بدن یعنی کلیسا است؛ او نخست‌زاده است و نخستین کسی است که پس از مرگ زنده گردید تا تنها او در همه‌‌چیز مقام اوّل را داشته باشد."
        },
        {
          "verse": 19,
          "usfm": "COL.1.19",
          "line_type": "p",
          "text": "زیرا خشنودی خدا در این بود که او دارای الوهیّت کامل باشد."
        },
        {
          "verse": 20,
          "usfm": "COL.1.20",
          "line_type": "p",
          "text": "به‌وسیلهٔ مسیح، همه‌‌چیز را با خود آشتی داد و به‌وسیلهٔ ریختن خون مسیح بر روی صلیب، صلح بین خدا و هرآنچه در آسمان و زمین است، برقرار گردید."
        },
        {
          "verse": 21,
          "usfm": "COL.1.21",
          "line_type": "p",
          "text": "شما زمانی از خدا دور بودید و با اعمال و افکار شریرانۀ خود با او دشمنی داشتید،"
        },
        {
          "verse": 22,
          "usfm": "COL.1.22",
          "line_type": "p",
          "text": "امّا اکنون او به‌وسیلهٔ مرگ جسمانی مسیح شما را با خود مصالحه داده تا شما را مقدّس، بی‌عیب و بی‌آلایش به حضور خود بیاورد،"
        },
        {
          "verse": 23,
          "usfm": "COL.1.23",
          "line_type": "p",
          "text": "البتّه به‌شرط این‌که در ایمان خود محکم و استوار بمانید و از آن امیدی که در وقت شنیدن مژدۀ انجیل به دست آوردید، دور نشوید. این همان مژده‌ای است که در سرتاسر جهان اعلام شده و من «پولس» خادم آن هستم."
        },
        {
          "verse": 24,
          "usfm": "COL.1.24",
          "line_type": "p",
          "text": "اکنون از آن رنج و زحمتی که به‌خاطر شما می‌بینم، خوشحالم. زیرا به‌وسیلۀ رنج‌های جسمانی خود، آنچه را که از رنج‌های مسیح برای بدن او یعنی کلیسایش باقی‌مانده است، تکمیل می‌کنم."
        },
        {
          "verse": 25,
          "usfm": "COL.1.25",
          "line_type": "p",
          "text": "من طبق مأموریتی که خدا برای خیریّت شما به من عطا فرمود، خادم کلیسا هستم تا پیام خدا را کاملاً اعلام نمایم،"
        },
        {
          "verse": 26,
          "usfm": "COL.1.26",
          "line_type": "p",
          "text": "یعنی آن حقیقت اسرار‌آمیز که طی اعصار و قرون مخفی مانده بود، امّا اکنون برای مقدّسین آشکار شده است."
        },
        {
          "verse": 27,
          "usfm": "COL.1.27",
          "line_type": "p",
          "text": "خدا صلاح دانست که راز پُرجلال و بی‌قیاس خود را در میان ملل غیریهود آشکار سازد و آن راز این است که مسیح در شما ساکن می‌باشد، یعنی امید سهیم شدن در جلالی که از آن خدا است."
        },
        {
          "verse": 28,
          "usfm": "COL.1.28",
          "line_type": "p",
          "text": "ما مسیح را به همه اعلام می‌کنیم و با تمام دانشی که داریم همه را آگاه ‌ساخته تعلیم می‌دهیم تا آن‌ها افرادی بالغ در مسیح شوند."
        },
        {
          "verse": 29,
          "usfm": "COL.1.29",
          "line_type": "p",
          "text": "برای انجام این‌ کار، من زحمت کشیده کوشش می‌کنم و از قدرت عظیمی که مسیح به من می‌دهد و در من کار می‌کند، استفاده می‌نمایم."
        }
      ],
      "verse_count": 29,
      "headings": [
        {
          "before_verse": 3,
          "text": "دعای سپاسگزاری"
        },
        {
          "before_verse": 15,
          "text": "شخصیّت و کار مسیح"
        },
        {
          "before_verse": 24,
          "text": "خدمت پولس برای کلیسا"
        }
      ],
      "footnotes": [
        {
          "verse": 2,
          "usfm": "COL.1.2",
          "note_ref": "1‏:2",
          "note_type": "footnote",
          "references": [],
          "text": "روی سخن در اینجا با تمام ایمان‌داران است."
        },
        {
          "verse": 15,
          "usfm": "COL.1.15",
          "note_ref": "1‏:15",
          "note_type": "footnote",
          "references": [],
          "text": "منظور از نخست‌زاده و بالاتر، رابطهٔ شخصی خدای پدر و خدای پسر (عیسای مسیح) در وجود خدا قبل از آفرینش این خلقت است."
        }
      ],
