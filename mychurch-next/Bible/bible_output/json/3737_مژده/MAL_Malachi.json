  "chapters": [
    {
      "schema_version": 6,
      "book_id": "MAL",
      "chapter": 1,
      "chapter_usfm": "MAL.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "MAL.1.1",
          "line_type": "p",
          "text": "این پیامی است که خداوند توسط ملاکی به اسرائیل داد: خداوند می‌گوید: «من همیشه عاشق شما بوده‌ام.» امّا شما می‌پرسید: «تو چگونه عشق خود را به ما نشان داده‌ای؟» خداوند در پاسخ می‌فرماید: «عیسو و یعقوب دو برادر بودند. امّا من یعقوب و نسل او را دوست داشتم، و از عیسو نفرت داشتم. سرزمین کوهستانی او را ویران کردم و آنجا را مسکن شغال‌ها ساختم.»"
        },
        {
          "verse": 4,
          "usfm": "MAL.1.4",
          "line_type": "p",
          "text": "اگر اَدومیان که از نسل عیسو هستند، بگویند: «شهرهای ما ویران شده‌اند، امّا آن‌ها را بازسازی می‌کنیم،» خداوند متعال پاسخ خواهد داد: «هرچند آن‌ها شهرهای خود را بازسازی کنند، من دوباره آن‌ها را ویران خواهم ساخت و سرزمین آن‌ها 'سرزمین شرارت' و خودشان 'مردمی که خداوند تا ابد از آن‌ها خشمگین می‌باشد' نامیده خواهند شد.»"
        },
        {
          "verse": 5,
          "usfm": "MAL.1.5",
          "line_type": "p",
          "text": "هنگامی‌که شما این‌ها را با چشم خود ببینید، خواهید گفت: «بزرگی و عظمت خداوند در آن‌سوی مرزهای اسرائیل نیز مشاهده می‌شود.»"
        },
        {
          "verse": 6,
          "usfm": "MAL.1.6",
          "line_type": "p",
          "text": "خداوند متعال به کاهنان می‌فرماید: «پسر به پدر خود و غلام به آقای خود احترام می‌گذارد، پس اگر من پدر شما هستم، چرا به من احترام نمی‌گذارید؟ و اگر ارباب شما هستم، پس حرمت من کجا است؟ ای کاهنان، شما نام مرا بی‌حرمت ساخته می‌گویید، 'چطور نام تو را بی‌حرمت کرده‌ایم؟'"
        },
        {
          "verse": 7,
          "usfm": "MAL.1.7",
          "line_type": "p",
          "text": "هنگامی‌که شما خوراک‌های ناپاک بر قربانگاه من می‌گذارید، نام مرا بی‌حرمت می‌سازید. بلی، شما با این کار خود، به قربانگاه من اهانت می‌کنید."
        },
        {
          "verse": 8,
          "usfm": "MAL.1.8",
          "line_type": "p",
          "text": "آیا این کار شما زشت نیست که یک حیوان کور یا لنگ و یا بیمار را برای من قربانی می‌کنید؟ اگر آن‌ را به حاکم خود هدیه بدهید، آیا او آن‌ را خواهد پذیرفت و از شما راضی خواهد بود؟»"
        },
        {
          "verse": 9,
          "usfm": "MAL.1.9",
          "line_type": "p",
          "text": "اکنون شما، ای کاهنان، توقّع دارید که خدا بر شما رحم کند و شما را از فیض خود بهره‌مند سازد. خداوند متعال می‌فرماید که تقصیر خود شما است."
        },
        {
          "verse": 10,
          "usfm": "MAL.1.10",
          "line_type": "p",
          "text": "ای‌کاش یکی از شما کاهنان درهای معبدِ بزرگ را ببندد تا کسی نتواند آتش بر قربانگاه من روشن کند. من از شما راضی نیستم و قربانی‌های شما را نمی‌پسندم."
        },
        {
          "verse": 11,
          "usfm": "MAL.1.11",
          "line_type": "p",
          "text": "نام من در سراسر روی زمین و در بین تمام قوم‌های جهان با احترام یاد می‌شود و برای من بُخور خوش‌بو دود می‌کنند و قربانی‌های پسندیده تقدیم می‌کنند."
        },
        {
          "verse": 12,
          "usfm": "MAL.1.12",
          "line_type": "p",
          "text": "امّا شما نام مرا بی‌حرمت می‌سازید، زیرا می‌گویید که قربانگاه خداوند ناپاک و غذای آن مکروه است."
        },
        {
          "verse": 13,
          "usfm": "MAL.1.13",
          "line_type": "p",
          "text": "خداوند متعال می‌گوید: «شما می‌گویید خدمتی که برای من می‌کنید خسته کننده است و روی خود را از من برمی‌گردانید. شما حیواناتی را که به‌زور از مردم گرفته‌اید و آن‌ها‌یی را که لنگ یا بیمارند، به‌عنوان قربانی برای من می‌آورید! آیا فکر می‌کنید که من آن‌ها را خواهم پذیرفت؟"
        },
        {
          "verse": 14,
          "usfm": "MAL.1.14",
          "line_type": "p",
          "text": "لعنت بر کسی‌ که فریب بدهد، یعنی نذر کند که قوچ سالمی را از گلّۀ خود قربانی خواهد کرد، ولی حیوان معیوبی را بیاورد. من پادشاه بزرگ و با عظمت هستم و نام من در بین قوم‌های جهان باعزّت و احترام یاد می‌شود.»"
        }
      ],
      "verse_count": 12,
      "headings": [
        {
          "before_verse": 2,
          "text": "محبّت خداوند به اسرائیل"
        },
        {
          "before_verse": 6,
          "text": "سرزنش کاهنان"
        }
      ],
