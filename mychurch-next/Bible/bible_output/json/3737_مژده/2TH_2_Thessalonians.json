  "version_abbr": "مژده",
  "version_name": "مژده برای عصر جدید - ویرایش ۲۰۲۳",
  "language": "fa",
  "chapter_count": 3,
  "total_verses": 47,
  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 1,
      "chapter_usfm": "2TH.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.1.1",
          "line_type": "p",
          "text": "از طرف پولس و سیلاس و تیموتاؤس به کلیسای تسالونیکیان که به پدر ما خدا و عیسای مسیح خداوند تعلّق دارد."
        },
        {
          "verse": 2,
          "usfm": "2TH.1.2",
          "line_type": "p",
          "text": "خدای پدر و عیسای مسیح خداوند، فیض و آرامش به شما عنایت فرمایند."
        },
        {
          "verse": 3,
          "usfm": "2TH.1.3",
          "line_type": "p",
          "text": "ای برادران، ما موظّفیم همواره خدا را به‌خاطر شما سپاس گوییم. آری، شایسته است چنین کنیم، زیرا ایمان شما به‌طور عظیمی رشد می‌کند و محبّت شما به یکدیگر روز‌افزون است."
        },
        {
          "verse": 4,
          "usfm": "2TH.1.4",
          "line_type": "p",
          "text": "بنابراین، ما در کلیساهای خدا به‌خاطر بردباری و ایمانتان در تحمّل آزارها و رنج‌ها به‌وجود شما افتخار می‌کنیم."
        },
        {
          "verse": 5,
          "usfm": "2TH.1.5",
          "line_type": "p",
          "text": "این آزارها ثابت می‌کند که خدا از روی انصاف داوری می‌کند و می‌خواهد که شما شایستۀ پادشاهی خدا که به‌خاطر آن رنج می‌برید، بشوید."
        },
        {
          "verse": 6,
          "usfm": "2TH.1.6",
          "line_type": "p",
          "text": "خدا عادل است و به کسانی‌ که به شما آزار می‌رسانند، جزا خواهد داد"
        },
        {
          "verse": 7,
          "usfm": "2TH.1.7",
          "line_type": "p",
          "text": "و به شما که رنج و آزار می‌بینید و همچنین به ما تسکین خواهد بخشید. این‌ کار در روزی که عیسای خداوند از آسمان با فرشتگان توانای خود"
        },
        {
          "verse": 8,
          "usfm": "2TH.1.8",
          "line_type": "p",
          "text": "در آتشی فروزان ظهور کند، انجام خواهد گرفت و به آنانی که خدا را نمی‌شناسند و انجیل خداوند ما عیسی را رد می‌کنند، کیفر خواهد داد."
        },
        {
          "verse": 9,
          "usfm": "2TH.1.9",
          "line_type": "p",
          "text": "کیفر آنان هلاکت جاودانی و دوری از حضور خداوند و محرومیّت از جلال قدرت او خواهد بود."
        },
        {
          "verse": 10,
          "usfm": "2TH.1.10",
          "line_type": "p",
          "text": "در آن روزی که او می‌آید تا در مقدّسین خود جلال یابد، تمام ایمان‌داران از دیدن او شگفت‌زده خواهند شد و شما که به شهادت ما ایمان آوردید نیز، جزو آن‌ها خواهید بود."
        },
        {
          "verse": 11,
          "usfm": "2TH.1.11",
          "line_type": "p",
          "text": "به‌این‌سبب است که ما همیشه برای شما دعا می‌کنیم که خدای ما، شما را شایستۀ دعوت خود گرداند و همۀ آرزوهای نیکوی شما را برآورد و فعّالیّت‌های شما را که از ایمان سرچشمه می‌گیرد، باقدرت خود به کمال رساند،"
        },
        {
          "verse": 12,
          "usfm": "2TH.1.12",
          "line_type": "p",
          "text": "تا نام خداوند ما عیسای مسیح در شما جلال یابد و شما نیز بر‌ طبق فیض خدای ما و عیسای مسیح خداوند در او جلال یابید."
        }
      ],
      "verse_count": 12,
      "headings": [
        {
          "before_verse": 3,
          "text": "داوری در وقت آمدن مسیح"
        }
      ],
      "footnotes": [
        {
          "verse": 3,
          "usfm": "2TH.1.3",
          "note_ref": "1‏:3",
          "note_type": "footnote",
          "references": [],
          "text": "روی سخن در اینجا با تمام ایمان‌داران است."
        }
      ],
