    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 3,
      "chapter_usfm": "2TH.3",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.3.1",
          "line_type": "p",
          "text": "دیگر این‌که، ای برادران، برای ما دعا کنید تا پیام خداوند نیز به‌سرعت منتشر و با احترام پذیرفته گردد، همان‌طور که در میان شما شد."
        },
        {
          "verse": 2,
          "usfm": "2TH.3.2",
          "line_type": "p",
          "text": "و دعا کنید که خدا ما را از دست افراد پلید و بدکار نجات بخشد، زیرا همۀ مردم به آن پیام ایمان ندارند."
        },
        {
          "verse": 3,
          "usfm": "2TH.3.3",
          "line_type": "p",
          "text": "امّا خداوند امین است. او شما را تقویت خواهد فرمود و از آن شریر حفظ خواهد کرد."
        },
        {
          "verse": 4,
          "usfm": "2TH.3.4",
          "line_type": "p",
          "text": "ما، در خداوند به شما اطمینان کامل داریم که دستورهای ما را به‌عمل می‌آورید و همچنان به‌عمل خواهید آورد."
        },
        {
          "verse": 5,
          "usfm": "2TH.3.5",
          "line_type": "p",
          "text": "خداوند دل‌های شما را به‌سوی محبّت خدا و بردباری مسیح هدایت فرماید."
        },
        {
          "verse": 6,
          "usfm": "2TH.3.6",
          "line_type": "p",
          "text": "ای برادران، ما به نام عیسای مسیح خداوند به شما فرمان می‌دهیم که از هر ایمانداری که تنبلی می‌کند و مطابق تعالیمی که ما داده‌ایم رفتار نمی‌کند، دوری جویید،"
        },
        {
          "verse": 7,
          "usfm": "2TH.3.7",
          "line_type": "p",
          "text": "زیرا شما خوب می‌دانید برای این‌که از ما سرمشق بگیرید چه باید بکنید. ما در میان شما تنبلی نکردیم،"
        },
        {
          "verse": 8,
          "usfm": "2TH.3.8",
          "line_type": "p",
          "text": "نان هیچ‌کس را مُفت نخوردیم، بلکه شب و روز برای امرار معاش خود کار کردیم و زحمت کشیدیم تا به هیچ‌کس از شما تحمیل نشویم."
        },
        {
          "verse": 9,
          "usfm": "2TH.3.9",
          "line_type": "p",
          "text": "دلیلش این نبود که چنین حقّی را نداریم؛ بلکه می‌خواستیم سرمشقی به شما بدهیم که از آن پیروی کنید."
        },
        {
          "verse": 10,
          "usfm": "2TH.3.10",
          "line_type": "p",
          "text": "حتّی هنگامی‌که نزد شما بودیم، دستور دادیم هر‌کس که نمی‌خواهد کار کند، غذا هم نخورد."
        },
        {
          "verse": 11,
          "usfm": "2TH.3.11",
          "line_type": "p",
          "text": "ما می‌شنویم که افرادی در میان شما هستند که تنبلی پیشه کرده‌اند و به‌عوض این‌که خود کار کنند، در کار دیگران فضولی می‌کنند."
        },
        {
          "verse": 12,
          "usfm": "2TH.3.12",
          "line_type": "p",
          "text": "به نام عیسای مسیح خداوند چنین اشخاص را نصیحت می‌کنم و به آن‌ها فرمان می‌دهم که در آرامش به کار بپردازند تا نانی به دست آورند."
        },
        {
          "verse": 13,
          "usfm": "2TH.3.13",
          "line_type": "p",
          "text": "امّا شما ای برادران، از نیکی کردن خسته نشوید."
        },
        {
          "verse": 14,
          "usfm": "2TH.3.14",
          "line_type": "p",
          "text": "اگر کسی در آنجا هست که از آنچه در این نامه نوشتیم اطاعت نمی‌کند، مراقب او باشید و با او رفت‌وآمد نکنید تا شرمنده شود."
        },
        {
          "verse": 15,
          "usfm": "2TH.3.15",
          "line_type": "p",
          "text": "او را دشمن نشمارید، بلکه مانند یک ایماندار به او هشدار دهید."
        },
        {
          "verse": 16,
          "usfm": "2TH.3.16",
          "line_type": "p",
          "text": "خود خداوند که سرچشمۀ آرامش است، همواره و در هر مورد به شما آرامش عطا فرماید و با همۀ شما باشد."
        },
        {
          "verse": 17,
          "usfm": "2TH.3.17",
          "line_type": "p",
          "text": "من، پولس، با دست‌خط خود می‌نویسم: درود از جانب پولس. به‌این‌طریق من هر نامه‌ای را امضا می‌کنم."
        },
        {
          "verse": 18,
          "usfm": "2TH.3.18",
          "line_type": "p",
          "text": "فیض خداوند ما عیسای مسیح با همۀ شما باد. آمین."
        }
      ],
