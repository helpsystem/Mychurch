    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 2,
      "chapter_usfm": "2TH.2",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.2.1",
          "line_type": "p",
          "text": "ای برادران، دربارۀ آمدن خداوند ما عیسای مسیح و جمع شدن ما با او، از شما خواهش می‌کنم"
        },
        {
          "verse": 2,
          "usfm": "2TH.2.2",
          "line_type": "p",
          "text": "نگذارید نبوّتی یا گفته‌ای یا نامه‌ای منتسب به ما، مبنی براینکه روز خداوند فرارسیده است، شما را مضطرب و آشفته سازد."
        },
        {
          "verse": 3,
          "usfm": "2TH.2.3",
          "line_type": "p",
          "text": "نگذارید هیچ‌کس به هیچ عنوانی شما را فریب دهد، زیرا آن روز نخواهد آمد، مگر این‌که اوّل شورش عظیمی علیه خدا روی دهد و مظهر شرارت، یعنی آن کسی که از ابتدا محکوم به هلاکت بود، ظهور کند."
        },
        {
          "verse": 4,
          "usfm": "2TH.2.4",
          "line_type": "p",
          "text": "او با هرآنچه به اصطلاح، خدا خوانده می‌شود و یا مورد پرستش قرار می‌گیرد، مخالفت خواهد کرد و خود را بالاتر از همۀ آن‌ها قرار خواهد داد، به حدّی که در معبدِ بزرگِ خدا خواهد نشست و ادّعای خدایی خواهد کرد."
        },
        {
          "verse": 5,
          "usfm": "2TH.2.5",
          "line_type": "p",
          "text": "آیا فراموش کرده‌اید که وقتی با شما بودم این چیزها را به شما گفتم؟"
        },
        {
          "verse": 6,
          "usfm": "2TH.2.6",
          "line_type": "p",
          "text": "خود شما می‌دانید که چه چیزی فعلاً از ظهور او جلوگیری می‌کند. او در زمان معیّن‌شده ظهور خواهد کرد."
        },
        {
          "verse": 7,
          "usfm": "2TH.2.7",
          "line_type": "p",
          "text": "اکنون شرارت مرموز در کار است، ولی هرگاه قدرتی که مانع آن است از میان برداشته شود، بدون مانع کار خواهد کرد."
        },
        {
          "verse": 8,
          "usfm": "2TH.2.8",
          "line_type": "p",
          "text": "آنگاه مظهر شرارت ظهور خواهد کرد و عیسای خداوند با نَفَس دهانِ خود او را خواهد کُشت و با ظهور پُرشکوه خود او را نابود خواهد کرد."
        },
        {
          "verse": 9,
          "usfm": "2TH.2.9",
          "line_type": "p",
          "text": "ظهور آن مظهر شرارت در اثر فعّالیّت‌های شیطان خواهد بود و با انواع توانایی‌ها، نشانه‌ها و معجزات فریبنده"
        },
        {
          "verse": 10,
          "usfm": "2TH.2.10",
          "line_type": "p",
          "text": "و هر نوع شرارتی که برای محکومین به هلاکت فریبنده است، همراه خواهد بود، چون آن‌ها عشق به حقیقت را که می‌تواند آنان را نجات بخشد، قبول نکردند."
        },
        {
          "verse": 11,
          "usfm": "2TH.2.11",
          "line_type": "p",
          "text": "از این جهت خدا آن‌ها را گرفتار نیرویی گمراه‌کننده خواهد کرد تا آنچه را که دورغ است باور کنند."
        },
        {
          "verse": 12,
          "usfm": "2TH.2.12",
          "line_type": "p",
          "text": "درنتیجه همۀ آنانی که به حقیقت ایمان نیاورده‌اند و از گناه لذّت برده‌اند، محکوم خواهند شد."
        },
        {
          "verse": 13,
          "usfm": "2TH.2.13",
          "line_type": "p",
          "text": "امّا، ای برادران محبوب در خداوند، ما موظّفیم همیشه خدا را به‌خاطر شما شکر کنیم، زیرا خدا شما را به‌عنوان اوّلین ایمان‌داران برگزید تا به‌وسیلۀ روح‌القدس، شما را پاک گرداند و از راه ایمان به حقیقت نجات یابید."
        },
        {
          "verse": 14,
          "usfm": "2TH.2.14",
          "line_type": "p",
          "text": "او شما را به‌وسیلۀ مژده‌ای که ما برایتان آوردیم، دعوت کرد تا در جلال خداوند ما عیسای مسیح سهمی داشته باشید."
        },
        {
          "verse": 15,
          "usfm": "2TH.2.15",
          "line_type": "p",
          "text": "پس ای برادران، استوار بمانید و آن تعالیمی را که شفاهاً یا کتباً از ما آموختید، محکم نگاه دارید."
        },
        {
          "verse": 16,
          "usfm": "2TH.2.16",
          "line_type": "p",
          "text": "خود خداوند ما عیسای مسیح و خدای پدر که ما را دوست داشته است و از راه فیض ما را دائماً تشویق کرده و امیدی نیکو به ما بخشیده است،"
        },
        {
          "verse": 17,
          "usfm": "2TH.2.17",
          "line_type": "p",
          "text": "شما را نیز تشویق و تقویت کند تا آنچه را که نیکو است، بگویید و به‌عمل آورید."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 13,
          "text": "برگزیدگان خدا"
        }
      ],
