    {
      "schema_version": 6,
      "book_id": "1JN",
      "chapter": 1,
      "chapter_usfm": "1JN.1",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1JN.1.1",
          "line_type": "p",
          "text": "ما دربارۀ کلمۀ حیات به شما می‌نویسیم، کلامی که از ازل بود و ما آن‌ را شنیده و با چشمان خود دیده‌ایم، ‌آری، ما آن‌ را دیده‌ایم و دست‌هایمان آن‌ را لمس کرده است."
        },
        {
          "verse": 2,
          "usfm": "1JN.1.2",
          "line_type": "p",
          "text": "آن حیات ظاهر شد و ما آن‌ را دیده‌ایم و دربارهٔ آن شهادت می‌دهیم. ما آن حیات جاودانی را که با پدر بود و به ما شناسانیده شد، به شما اعلام می‌کنیم."
        },
        {
          "verse": 3,
          "usfm": "1JN.1.3",
          "line_type": "p",
          "text": "آری، آنچه را که ما دیده‌ و شنیده‌ایم، به شما اعلام می‌کنیم تا در اتّحادی که ما با پدر و پسر او عیسای مسیح داریم، شما هم با ما شریک شوید."
        },
        {
          "verse": 4,
          "usfm": "1JN.1.4",
          "line_type": "p",
          "text": "این‌ را می‌نویسیم تا شادی ما کامل گردد."
        },
        {
          "verse": 5,
          "usfm": "1JN.1.5",
          "line_type": "p",
          "text": "این است پیامی که ما از او شنیدیم و به شما اعلام می‌کنیم: خدا نور است و هیچ ظلمت در او نیست."
        },
        {
          "verse": 6,
          "usfm": "1JN.1.6",
          "line_type": "p",
          "text": "پس اگر بگوییم با او متّحد هستیم در‌حالی‌که در ظلمت زندگی می‌کنیم، گفتار ما دروغ و کردار ما نادرست است."
        },
        {
          "verse": 7,
          "usfm": "1JN.1.7",
          "line_type": "p",
          "text": "امّا اگر در نور به سر می‌بریم، همان‌طور که خدا در نور است، در‌آن‌صورت با یکدیگر اتّحاد داریم و خون عیسی، پسر او، ما را از همۀ گناهانمان پاک می‌سازد."
        },
        {
          "verse": 8,
          "usfm": "1JN.1.8",
          "line_type": "p",
          "text": "اگر بگوییم که بی‌گناه هستیم، خود را فریب می‌دهیم و حقیقت در ما نیست."
        },
        {
          "verse": 9,
          "usfm": "1JN.1.9",
          "line_type": "p",
          "text": "امّا اگر ما به گناهان خود اعتراف نماییم، او امین و عادل است تا گناهان ما را آمرزیده ما را از همۀ خطاهایمان پاک سازد."
        },
        {
          "verse": 10,
          "usfm": "1JN.1.10",
          "line_type": "p",
          "text": "اگر بگوییم که هرگز مرتکب گناهی نشده‌ایم، خدا را دروغ‌گو شمرده‌ایم و از کلام او کاملاً بی‌خبر هستیم."
        }
      ],
      "verse_count": 10,
      "headings": [
        {
          "before_verse": 5,
          "text": "زندگی در نور خدا"
        }
      ],
