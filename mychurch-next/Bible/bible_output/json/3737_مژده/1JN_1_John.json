    {
      "schema_version": 6,
      "book_id": "1JN",
      "chapter": 3,
      "chapter_usfm": "1JN.3",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1JN.3.1",
          "line_type": "p",
          "text": "ببینید محبّت خدای پدر نسبت به ما چقدر عظیم است که ما را فرزندان خود خوانده است؛ و درواقع ما فرزندان خدا هستیم. دلیل این‌که دنیا ما را نمی‌شناسد این است که او را نشناخته است."
        },
        {
          "verse": 2,
          "usfm": "1JN.3.2",
          "line_type": "p",
          "text": "ای عزیزان، اکنون ما فرزندان خدا هستیم، ولی آنچه در آینده خواهیم شد هنوز آشکار نشده است، ولی همین‌قدر می‌دانیم که وقتی مسیح ظهور کند، ما مثل او خواهیم بود، زیرا او را آن‌چنان که هست خواهیم دید."
        },
        {
          "verse": 3,
          "usfm": "1JN.3.3",
          "line_type": "p",
          "text": "هرکه این امید را در مسیح دارد خود را پاک می‌سازد، همان‌طور که مسیح پاک است."
        },
        {
          "verse": 4,
          "usfm": "1JN.3.4",
          "line_type": "p",
          "text": "هرکه گناه می‌کند شریعت خدا را می‌شکند، زیرا گناه همانا شکستن شریعت است."
        },
        {
          "verse": 5,
          "usfm": "1JN.3.5",
          "line_type": "p",
          "text": "شما می‌دانید که مسیح ظاهر شد تا گناهان را از میان بردارد و نیز می‌دانید که او کاملاً بی‌گناه است."
        },
        {
          "verse": 6,
          "usfm": "1JN.3.6",
          "line_type": "p",
          "text": "بنابراین کسی‌ که با مسیح متّحد شده است در گناه زندگی نمی‌کند، امّا کسی که به زندگی در گناه ادامه می‌دهد، هرگز او را ندیده و نشناخته است."
        },
        {
          "verse": 7,
          "usfm": "1JN.3.7",
          "line_type": "p",
          "text": "ای فرزندان، کسی شما را گمراه نسازد. هرکه نیک رفتار کند، شخصی نیک است، همان‌طور که عیسای مسیح کاملاً نیک است."
        },
        {
          "verse": 8,
          "usfm": "1JN.3.8",
          "line_type": "p",
          "text": "و هرکه در گناه به سر می‌برد، فرزند شیطان است، زیرا شیطان از ابتدا گناهکار بوده است. پسر خدا به همین سبب ظاهر شد تا کارهای شیطان را باطل سازد."
        },
        {
          "verse": 9,
          "usfm": "1JN.3.9",
          "line_type": "p",
          "text": "هرکه فرزند خدا است نمی‌تواند در گناه زندگی کند، زیرا ذات خدا در او است و نمی‌تواند در گناه به سر ببرد، زیرا از خدا تولّد یافته است."
        },
        {
          "verse": 10,
          "usfm": "1JN.3.10",
          "line_type": "p",
          "text": "فرق بین فرزندان خدا و فرزندان ابلیس در این است: هرکه نیک رفتار نمی‌کند و یا به برادر خود محبّت نمی‌کند، فرزند خدا نیست."
        },
        {
          "verse": 11,
          "usfm": "1JN.3.11",
          "line_type": "p",
          "text": "زیرا آن پیامی که شما از اوّل شنیده‌اید این است که: «باید به یکدیگر محبّت کنیم.»"
        },
        {
          "verse": 12,
          "usfm": "1JN.3.12",
          "line_type": "p",
          "text": "ما نباید مثل قائن باشیم. او فرزند شیطان بود و برادر خود را کُشت. برای چه او را کُشت؟ به‌خاطر این‌که کارهای خودش نادرست و کارهای برادرش درست بود."
        },
        {
          "verse": 13,
          "usfm": "1JN.3.13",
          "line_type": "p",
          "text": "ای برادران من، از این‌که دنیا از شما نفرت دارد، تعجّب نکنید."
        },
        {
          "verse": 14,
          "usfm": "1JN.3.14",
          "line_type": "p",
          "text": "ما می‌دانیم که از مرگ گذشته و به حیات رسیده‌ایم، زیرا به برادران محبّت می‌کنیم. هرکه محبّت نمی‌کند، هنوز در قلمرو مرگ زندگی می‌کند."
        },
        {
          "verse": 15,
          "usfm": "1JN.3.15",
          "line_type": "p",
          "text": "هرکه از برادر خود متنفّر باشد قاتل است، و شما می‌دانید که هیچ قاتلی دارای حیات جاودانی نیست."
        },
        {
          "verse": 16,
          "usfm": "1JN.3.16",
          "line_type": "p",
          "text": "ما معنی محبّت را درک کرده‌ایم زیرا مسیح جان خود را در راه ما فدا کرد. پس ما نیز باید جان خود را در راه یکدیگر فدا سازیم."
        },
        {
          "verse": 17,
          "usfm": "1JN.3.17",
          "line_type": "p",
          "text": "چطور ممکن است محبّت خدا در کسی ساکن باشد که از ثروت دنیا بهره‌مند است ولی محبّت خود را از برادری که محتاج است دریغ می‌کند؟"
        },
        {
          "verse": 18,
          "usfm": "1JN.3.18",
          "line_type": "p",
          "text": "ای فرزندان، محبّت ما نباید فقط در قالب حرف و تعارف باشد، بلکه باید حقیقی باشد و در عمل دیده شود."
        },
        {
          "verse": 19,
          "usfm": "1JN.3.19",
          "line_type": "p",
          "text": "به‌این‌وسیله می‌دانیم که به حقیقت تعلّق داریم، و وجدان ما در پیشگاه خدا اطمینان خواهد داشت."
        },
        {
          "verse": 20,
          "usfm": "1JN.3.20",
          "line_type": "p",
          "text": "و اگر هم وجدان ما، ما را محکوم سازد، خدا از وجدان ما بزرگ‌تر است و از همه‌‌چیز آگاه می‌باشد."
        },
        {
          "verse": 21,
          "usfm": "1JN.3.21",
          "line_type": "p",
          "text": "ای عزیزان، اگر وجدان ما، ما را محکوم نمی‌سازد، ما می‌توانیم با اطمینان به حضور خدا بیاییم"
        },
        {
          "verse": 22,
          "usfm": "1JN.3.22",
          "line_type": "p",
          "text": "و او تمام درخواست‌های ما را برآورده می‌کند، زیرا ما بر‌ طبق احکام او عمل می‌کنیم و آنچه را که موردپسند او است به‌جا می‌آوریم."
        },
        {
          "verse": 23,
          "usfm": "1JN.3.23",
          "line_type": "p",
          "text": "و فرمان او این است که ما به نام پسر او عیسای مسیح ایمان آوریم و به یکدیگر محبّت نماییم، چنان‌که او به ما دستور داده است."
        },
        {
          "verse": 24,
          "usfm": "1JN.3.24",
          "line_type": "p",
          "text": "هرکه از احکام او اطاعت می‌کند، در خدا ساکن است و خدا در او. او روح‌القدس را به ما بخشیده است تا ما مطمئن باشیم که او در ما زندگی می‌کند."
        }
      ],
