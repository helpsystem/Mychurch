    {
      "schema_version": 6,
      "book_id": "1JN",
      "chapter": 2,
      "chapter_usfm": "1JN.2",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1JN.2.1",
          "line_type": "p",
          "text": "ای فرزندان من، این‌ را به شما می‌نویسم تا گناه نکنید. امّا اگر کسی مرتکب گناهی شود، در پیشگاه خدای پدر کسی را داریم که برای ما شفاعت می‌کند، یعنی همان عیسای مسیح که کاملاً نیک است."
        },
        {
          "verse": 2,
          "usfm": "1JN.2.2",
          "line_type": "p",
          "text": "خود مسیح کفّارۀ گناهان ما است، نه‌تنها گناهان ما، بلکه گناهان تمام جهان."
        },
        {
          "verse": 3,
          "usfm": "1JN.2.3",
          "line_type": "p",
          "text": "وقتی از احکام او اطاعت می‌کنیم، می‌دانیم که او را می‌شناسیم."
        },
        {
          "verse": 4,
          "usfm": "1JN.2.4",
          "line_type": "p",
          "text": "کسی که می‌گوید او را می‌شناسد ولی از احکام او اطاعت نمی‌کند، دروغ‌گو است و در او هیچ راستی نیست."
        },
        {
          "verse": 5,
          "usfm": "1JN.2.5",
          "line_type": "p",
          "text": "امّا وقتی کسی از احکام او اطاعت می‌کند، محبّت خدا در او به‌طور واقعی به کمال رسیده است. از این راه می‌توانیم مطمئن باشیم که در خدا زندگی می‌کنیم:"
        },
        {
          "verse": 6,
          "usfm": "1JN.2.6",
          "line_type": "p",
          "text": "هرکه بگوید که در خدا زندگی می‌کند، باید همان‌طور زندگی کند که عیسای مسیح زندگی می‌کرد."
        },
        {
          "verse": 7,
          "usfm": "1JN.2.7",
          "line_type": "p",
          "text": "ای عزیزان، دستوری که به شما می‌نویسم فرمان تازه‌ای نیست، بلکه دستوری است قدیمی، یعنی همان دستوری که شما از ابتدا داشته‌اید. این همان پیامی است که درگذشته شنیده‌اید."
        },
        {
          "verse": 8,
          "usfm": "1JN.2.8",
          "line_type": "p",
          "text": "بااین‌وجود، دستور تازه‌ای به شما می‌نویسم و حقیقت آن، هم در مسیح و هم در شما دیده می‌شود، زیرا پایان ظلمت نزدیک و نور حقیقی در حال درخشیدن است."
        },
        {
          "verse": 9,
          "usfm": "1JN.2.9",
          "line_type": "p",
          "text": "اگر کسی ادّعا کند که در نور است و در‌عین‌حال از برادر یا خواهر خود نفرت داشته باشد، او هنوز در ظلمت است."
        },
        {
          "verse": 10,
          "usfm": "1JN.2.10",
          "line_type": "p",
          "text": "هرکه برادر یا خواهر خود را محبّت می‌کند، در نور زندگی می‌کند و باعث لغزش خود و یا دیگران نخواهد شد."
        },
        {
          "verse": 11,
          "usfm": "1JN.2.11",
          "line_type": "p",
          "text": "امّا هرکه از برادر یا خواهر خود متنفّر باشد، در ظلمت است؛ در ظلمت راه می‌رود و نمی‌داند به کجا می‌رود، زیرا تاریکی چشمانش را کور کرده است."
        },
        {
          "verse": 12,
          "usfm": "1JN.2.12",
          "line_type": "p",
          "text": "ای فرزندان، به شما می‌نویسم زیرا گناهانتان به‌خاطر نام مسیح آمرزیده شده‌اند."
        },
        {
          "verse": 13,
          "usfm": "1JN.2.13",
          "line_type": "p",
          "text": "ای پدران، به شما می‌نویسم، زیرا او را که از ازل بوده است، می‌شناسید.ای جوانان، به شما می‌نویسم، زیرا که بر شیطان پیروز شده‌اید."
        },
        {
          "verse": 14,
          "usfm": "1JN.2.14",
          "line_type": "p",
          "text": "ای فرزندان جوان، به شما می‌نویسم، زیرا شما پدر را می‌شناسید.ای پدران، به شما می‌نویسم، زیرا او را که از ازل بوده است، می‌شناسید.ای جوانان، به شما می‌نویسم، زیرا نیرومند هستید و کلام خدا در شما است و شما بر شیطان پیروز شده‌اید."
        },
        {
          "verse": 15,
          "usfm": "1JN.2.15",
          "line_type": "p",
          "text": "به دنیا و آنچه به آن تعلّق دارد دل نبندید. کسی‌ که دنیا را دوست دارد محبّت خدای پدر در او نیست."
        },
        {
          "verse": 16,
          "usfm": "1JN.2.16",
          "line_type": "p",
          "text": "هرآنچه به دنیا تعلّق دارد، یعنی آنچه نفس گناهکار آرزو می‌کند و آنچه چشم می‌بیند و طلب می‌کند و آنچه مایۀ فخر و غرور است، از پدر نیست. این‌ها همه به دنیا تعلّق دارند."
        },
        {
          "verse": 17,
          "usfm": "1JN.2.17",
          "line_type": "p",
          "text": "جهان و تمایلات دنیوی از بین خواهند رفت، امّا هرکه ارادۀ خدا را به‌جا می‌آورد، تا ابد خواهد زیست."
        },
        {
          "verse": 18,
          "usfm": "1JN.2.18",
          "line_type": "p",
          "text": "ای فرزندان، ساعت آخر فرارسیده است و چنان‌که شنیده‌اید «ضدّ مسیح» در زمان آخر می‌آید؛ و حالا می‌بینیم که «ضدّ مسیح‌های» بسیاری ظاهر شده‌اند و از‌این‌رو می‌فهمیم که ساعت آخر نزدیک است."
        },
        {
          "verse": 19,
          "usfm": "1JN.2.19",
          "line_type": "p",
          "text": "آن‌ها از میان ما بیرون رفتند. ولی آن‌ها درواقع هیچ‌وقت به ما تعلّق نداشتند. اگر به ما تعلّق داشتند، با ما می‌ماندند. امّا رفتند تا معلوم گردد که هیچ‌یک از آن‌ها درحقیقت از ما نبودند."
        },
        {
          "verse": 20,
          "usfm": "1JN.2.20",
          "line_type": "p",
          "text": "امّا مسیح، شما را با روح‌القدس خود مسح کرده است و از‌این‌رو همۀ شما حقیقت را می‌دانید."
        },
        {
          "verse": 21,
          "usfm": "1JN.2.21",
          "line_type": "p",
          "text": "من این‌ها را نوشتم، نه به آن منظور که شما از حقیقت بی‌خبرید، بلکه چون آن‌ را می‌دانید و آگاه هستید که هیچ ناراستی از راستی سرچشمه نمی‌گیرد."
        },
        {
          "verse": 22,
          "usfm": "1JN.2.22",
          "line_type": "p",
          "text": "پس آن دروغ‌گو کیست؟ کسی است که بگوید عیسی، «مسیح» نیست. این شخص «ضدّ مسیح» است چون او هم پدر و هم پسر را انکار می‌کند."
        },
        {
          "verse": 23,
          "usfm": "1JN.2.23",
          "line_type": "p",
          "text": "هرکه پسر را رد کند پدر را نیز رد کرده است و هرکه پسر را بپذیرد، پدر را نیز پذیرفته است."
        },
        {
          "verse": 24,
          "usfm": "1JN.2.24",
          "line_type": "p",
          "text": "بگذارید پیامی که از اوّل شنیدید، در شما باقی بماند. اگر آنچه که از اوّل به شما گفته شده است، در شما بماند، شما همیشه در پدر و در پسر خواهید ماند."
        },
        {
          "verse": 25,
          "usfm": "1JN.2.25",
          "line_type": "p",
          "text": "و وعدۀ عیسای مسیح این است که او حیات جاودان به شما می‌بخشد."
        },
        {
          "verse": 26,
          "usfm": "1JN.2.26",
          "line_type": "p",
          "text": "من این چیزها را دربارۀ اشخاصی که می‌خواهند شما را گمراه سازند، نوشته‌ام."
        },
        {
          "verse": 27,
          "usfm": "1JN.2.27",
          "line_type": "p",
          "text": "امّا شما نیازی ندارید که کسی شما را تعلیم دهد، زیرا روح‌القدس که مسیح او‌ را به شما داده است، در شما زندگی می‌کند. روح خدا در هر مورد به شما تعلیم می‌دهد و تعالیم او بر حقّ است و در آن ناراستی نیست. پس همان‌طور که روح خدا به شما تعلیم می‌دهد در مسیح بمانید."
        },
        {
          "verse": 28,
          "usfm": "1JN.2.28",
          "line_type": "p",
          "text": "آری، ای فرزندان من، در او بمانید تا در وقت ظهور او، شرمنده نشویم، بلکه با اطمینان در حضورش حاضر شویم."
        },
        {
          "verse": 29,
          "usfm": "1JN.2.29",
          "line_type": "p",
          "text": "اگر درک کرده‌اید که مسیح کاملاً نیک است، این حقیقت را نیز می‌دانید که هرکه نیک رفتار کند، از خدا متولّد شده است."
        }
      ],
      "verse_count": 29,
