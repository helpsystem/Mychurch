    {
      "schema_version": 6,
      "book_id": "1JN",
      "chapter": 5,
      "chapter_usfm": "1JN.5",
      "version_id": 3737,
      "version_abbr": "مژده",
      "verses": [
        {
          "verse": 1,
          "usfm": "1JN.5.1",
          "line_type": "p",
          "text": "هرکه ایمان دارد که عیسی، مسیح است فرزند خدا است، و هرکه پدر را دوست دارد فرزند او را نیز دوست خواهد داشت."
        },
        {
          "verse": 2,
          "usfm": "1JN.5.2",
          "line_type": "p",
          "text": "ما چگونه می‌دانیم که فرزندان خدا را دوست داریم؟ از این‌که خدا را دوست داریم و مطابق احکام او عمل می‌کنیم."
        },
        {
          "verse": 3,
          "usfm": "1JN.5.3",
          "line_type": "p",
          "text": "زیرا محبّت به خدا چیزی جز اطاعت از احکام او نیست و این احکام بار سنگینی نیست،"
        },
        {
          "verse": 4,
          "usfm": "1JN.5.4",
          "line_type": "p",
          "text": "زیرا همۀ فرزندان خدا بر این جهان غلبه یافته‌اند و ما این پیروزی را به‌وسیلهٔ ایمان به دست آورده‌ایم."
        },
        {
          "verse": 5,
          "usfm": "1JN.5.5",
          "line_type": "p",
          "text": "و کسی بر جهان پیروز نمی‌شود مگر آن کسی که ایمان دارد عیسی، پسر خدا است!"
        },
        {
          "verse": 6,
          "usfm": "1JN.5.6",
          "line_type": "p",
          "text": "آمدن مسیح با تعمید و ریختن خون خودش همراه بود. آمدن او نه‌تنها با آب تعمید، بلکه هم با آب تعمید و هم با خون خودش ثابت گردید. روح خدا که حقیقت محض است نیز این‌ را تصدیق می‌کند."
        },
        {
          "verse": 7,
          "usfm": "1JN.5.7",
          "line_type": "p",
          "text": "پس سه شاهد وجود دارد:"
        },
        {
          "verse": 8,
          "usfm": "1JN.5.8",
          "line_type": "p",
          "text": "روح خدا، آب، و خون؛ و هر سه شاهد یک شهادت می‌دهند."
        },
        {
          "verse": 9,
          "usfm": "1JN.5.9",
          "line_type": "p",
          "text": "ما شهادت انسان را می‌پذیریم، امّا شهادت خدا بسیار عظیم‌تر است، و او این شهادت را برای پسر خود داده است."
        },
        {
          "verse": 10,
          "usfm": "1JN.5.10",
          "line_type": "p",
          "text": "هرکه به پسر خدا ایمان آورد، این شهادت را در خود دارد، امّا هرکه شهادت خدا را قبول نکند و گواهی او را در مورد پسرش نپذیرد، خدا را دروغ‌گو شمرده است."
        },
        {
          "verse": 11,
          "usfm": "1JN.5.11",
          "line_type": "p",
          "text": "شهادت این است که خدا به ما حیات جاودانی داده است و این حیات در پسر او یافت می‌شود."
        },
        {
          "verse": 12,
          "usfm": "1JN.5.12",
          "line_type": "p",
          "text": "هرکه پسر را دارد، حیات دارد و هرکه پسر خدا را ندارد، صاحب حیات نیست."
        },
        {
          "verse": 13,
          "usfm": "1JN.5.13",
          "line_type": "p",
          "text": "این نامه را نوشتم تا شما که به نام پسر خدا ایمان دارید، یقین بدانید که حیات جاودانی دارید."
        },
        {
          "verse": 14,
          "usfm": "1JN.5.14",
          "line_type": "p",
          "text": "اطمینان ما در حضور خدا این است که اگر از او چیزی بخواهیم که مطابق ارادۀ او باشد، به ما گوش خواهد داد."
        },
        {
          "verse": 15,
          "usfm": "1JN.5.15",
          "line_type": "p",
          "text": "ما می‌دانیم که هرچه از او بخواهیم او به ما گوش می‌دهد. پس این‌ را هم باید بدانیم که آنچه از او می‌طلبیم به ما عطا می‌فرماید."
        },
        {
          "verse": 16,
          "usfm": "1JN.5.16",
          "line_type": "p",
          "text": "اگر کسی می‌بیند که ایمانداری مرتکب گناهی شده است که منجر به مرگ نیست، باید برای او به درگاه خداوند دعا کند و اگر آن شخص مرتکب چنین گناهی نشده باشد، خدا به او حیات خواهد بخشید. امّا گناهی هم هست که به مرگ منجر می‌شود و من نمی‌گویم که در مورد آن دعا کنید."
        },
        {
          "verse": 17,
          "usfm": "1JN.5.17",
          "line_type": "p",
          "text": "البتّه هر خطایی گناه است، امّا گناهی هم هست که منجر به مرگ نمی‌شود."
        },
        {
          "verse": 18,
          "usfm": "1JN.5.18",
          "line_type": "p",
          "text": "ما می‌دانیم کسی که فرزند خدا است در گناه زندگی نمی‌کند، زیرا پسر خدا او را حفظ خواهد کرد و شیطان به او دسترسی ندارد."
        },
        {
          "verse": 19,
          "usfm": "1JN.5.19",
          "line_type": "p",
          "text": "ما می‌دانیم که فرزندان خدا هستیم در‌حالی‌که تمام دنیا تحت تسلّط شیطان است."
        },
        {
          "verse": 20,
          "usfm": "1JN.5.20",
          "line_type": "p",
          "text": "ما می‌دانیم که پسر خدا آمده و به ما فهم آن‌ را داده است که خدای حقیقی را بشناسیم، و ما با خدای حقیقی و با پسر او عیسای مسیح متّحد هستیم. او است خدای حقیقی و حیات جاودانی."
        },
        {
          "verse": 21,
          "usfm": "1JN.5.21",
          "line_type": "p",
          "text": "ای فرزندان، خود را از بُت‌ها محفوظ نگاه دارید."
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 6,
          "text": "سه شاهد عیسای مسیح"
        },
        {
          "before_verse": 13,
          "text": "حیات جاودان"
        }
      ],
      "footnotes": [
