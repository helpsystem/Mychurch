    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 3,
      "chapter_usfm": "2TI.3",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.3.1",
          "line_type": "p",
          "text": "این را یقین بدان كه در زمان آخر، روزگار سختی خواهد بود"
        },
        {
          "verse": 2,
          "usfm": "2TI.3.2",
          "line_type": "p",
          "text": "زیرا آدمیان، خودخواه و پول‌پرست و لافزن و مغرور و توهین‌كننده و نسبت به والدین نافرمان، ناسپاس، ناپاک،"
        },
        {
          "verse": 3,
          "usfm": "2TI.3.3",
          "line_type": "p",
          "text": "بی‌عاطفه، بی‌رحم، افترازن، ناپرهیزكار، درّنده‌خو، متنفّر از نیكی،"
        },
        {
          "verse": 4,
          "usfm": "2TI.3.4",
          "line_type": "p",
          "text": "خیانتكار، لاقید و خودپسند خواهند بود و عیّاشی را بیش از خدا دوست خواهند داشت."
        },
        {
          "verse": 5,
          "usfm": "2TI.3.5",
          "line_type": "p",
          "text": "ظاهراً خداپرستند، ولی قدرت آن را انكار می‌نمایند. از این اشخاص دوری كن."
        },
        {
          "verse": 6,
          "usfm": "2TI.3.6",
          "line_type": "p",
          "text": "زیرا بعضی از آنها به خانه‌ها راه می‌یابند و زنهای سبک‌مغز را كه زیر بار گناه شانه خم کرده‌اند و دستخوش تمایلات گوناگون هستند، به چنگ می‌آورند."
        },
        {
          "verse": 7,
          "usfm": "2TI.3.7",
          "line_type": "p",
          "text": "این زنها دایماً در پی اطّلاعات تازه هستند، ولی هیچ‌وقت نمی‌توانند حقیقت را درک كنند."
        },
        {
          "verse": 8,
          "usfm": "2TI.3.8",
          "line_type": "p",
          "text": "همان‌طور كه «ینیس» و «یمبریس» با موسی مخالفت كردند، این اشخاص نیز با حقیقت مخالفند. افكارشان فاسد شده و در ایمان مردود هستند."
        },
        {
          "verse": 9,
          "usfm": "2TI.3.9",
          "line_type": "p",
          "text": "امّا پیشرفت آنان بیش از این نخواهد بود، زیرا حماقت آنها بر همه آشكار خواهد شد، درست همان طوری که حماقت «ینیس» و «یمبریس» معلوم گردید."
        },
        {
          "verse": 10,
          "usfm": "2TI.3.10",
          "line_type": "p",
          "text": "امّا تو، از تعلیم و رفتار و هدف من در زندگی آگاه هستی و ایمان، بردباری، محبّت و پایداری مرا دیده"
        },
        {
          "verse": 11,
          "usfm": "2TI.3.11",
          "line_type": "p",
          "text": "و همچنین رنج و آزاری را كه در «انطاكیه» و «قونیه» و «لستره» دیدم مشاهده كردی و می‌دانی چه آزارهایی به من رسید و چگونه خداوند مرا از همهٔ اینها رهایی بخشید."
        },
        {
          "verse": 12,
          "usfm": "2TI.3.12",
          "line_type": "p",
          "text": "آری، همهٔ کسانی‌که مایلند در اتّحاد با مسیح عیسی زندگانی خداپسندانه‌ای داشته باشند، رنج و آزار خواهند دید."
        },
        {
          "verse": 13,
          "usfm": "2TI.3.13",
          "line_type": "p",
          "text": "امّا مردمان شریر و شیّاد از بد، بدتر خواهند شد. آنها دیگران را فریب می‌دهند و خود نیز فریب می‌خورند."
        },
        {
          "verse": 14,
          "usfm": "2TI.3.14",
          "line_type": "p",
          "text": "و امّا تو، به آنچه آموخته‌ای و به آن اطمینان داری وفادار باش زیرا می‌دانی از چه كسانی آن را آموختی"
        },
        {
          "verse": 15,
          "usfm": "2TI.3.15",
          "line_type": "p",
          "text": "و از كودكی با کتاب‌مقدّس، که قادر است به تو حكمت ببخشد تا به وسیلهٔ ایمان به مسیح عیسی نجات یابی، آشنا بوده‌ای."
        },
        {
          "verse": 16,
          "usfm": "2TI.3.16",
          "line_type": "p",
          "text": "تمام کتاب‌مقدّس از الهام خداست و برای تعلیم حقیقت، سرزنش خطا، اصلاح معایب و پرورش ما در نیکی مطلق مفید است"
        },
        {
          "verse": 17,
          "usfm": "2TI.3.17",
          "line_type": "p",
          "text": "تا مرد خدا برای هر كار نیكو کاملاً آماده و مجهّز باشد."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 10,
          "text": "آخرین دستورها"
        }
