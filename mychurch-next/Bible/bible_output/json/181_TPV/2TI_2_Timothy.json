  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 1,
      "chapter_usfm": "2TI.1",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.1.1",
          "line_type": "p",
          "text": "از طرف پولس كه به خواست خدا رسول مسیح عیسی است و فرستاده شد تا حیاتی را كه در مسیح عیسی یافت می‌شود، اعلام نماید"
        },
        {
          "verse": 2,
          "usfm": "2TI.1.2",
          "line_type": "p",
          "text": "به تیموتاؤس، فرزند عزیزم تقدیم می‌گردد. خدای پدر و مسیح عیسی، خداوند ما فیض و رحمت و آرامش به تو عطا فرمایند."
        },
        {
          "verse": 3,
          "usfm": "2TI.1.3",
          "line_type": "p",
          "text": "خدایی را كه من، مانند اجدادم با وجدانی پاک خدمت می‌کنم، سپاس می‌گویم. همیشه وقتی در شب و روز تو را در دعاهای خود به‌یاد می‌آورم، خدا را شكر می‌کنم."
        },
        {
          "verse": 4,
          "usfm": "2TI.1.4",
          "line_type": "p",
          "text": "وقتی اشکهای تو را به‌یاد می‌آورم، آرزو می‌کنم تو را ببینم تا با دیدار تو شادی من كامل گردد."
        },
        {
          "verse": 5,
          "usfm": "2TI.1.5",
          "line_type": "p",
          "text": "ایمان بی‌ریای تو را به‌خاطر می‌آورم، یعنی همان ایمانی که نخست مادر بزرگ تو «لوییس» و مادرت «افنیكی» داشت و اكنون مطمئن هستم كه در تو هم هست."
        },
        {
          "verse": 6,
          "usfm": "2TI.1.6",
          "line_type": "p",
          "text": "به این سبب در وقتی‌که تو را دستگذاری كردم، عطیّهٔ خدا به تو داده شد. می‌خواهم این عطیه را به‌یاد تو بیاورم تا آن را همیشه شعله‌ور نگاه داری،"
        },
        {
          "verse": 7,
          "usfm": "2TI.1.7",
          "line_type": "p",
          "text": "زیرا روحی كه خدا به ما بخشیده است ما را ترسان نمی‌سازد، بلكه روح او ما را از قدرت و محبّت و خو‌یشتنداری پُر می‌کند."
        },
        {
          "verse": 8,
          "usfm": "2TI.1.8",
          "line_type": "p",
          "text": "پس، از شهادت دادن به خداوند یا به رابطهٔ خودت با من، كه به‌خاطر او زندانی هستم خجل نباش، بلكه در رنج و زحمتی كه به‌خاطر انجیل پیش می‌آید با آن قدرتی كه خدا می‌بخشد سهیم باش."
        },
        {
          "verse": 9,
          "usfm": "2TI.1.9",
          "line_type": "p",
          "text": "خدا ما را نجات داد و به یک زندگی مقدّس دعوت كرد و این در اثر کارهای ما نبود، بلكه بر طبق نقشهٔ خود خدا و فیضی است كه او از ازل در شخص مسیح عیسی به ما عطا فرمود."
        },
        {
          "verse": 10,
          "usfm": "2TI.1.10",
          "line_type": "p",
          "text": "در حال حاضر این فیض به وسیلهٔ ظهور نجات‌دهندهٔ ما مسیح عیسی آشكار شده است. او موت را از میان برداشت و حیاتی فناناپذیر به وسیلهٔ انجیل برای همه آشكار ساخته است."
        },
        {
          "verse": 11,
          "usfm": "2TI.1.11",
          "line_type": "p",
          "text": "خدا مرا برگزید تا در انتشار انجیل واعظ، رسول و معلّم باشم."
        },
        {
          "verse": 12,
          "usfm": "2TI.1.12",
          "line_type": "p",
          "text": "به این دلیل تمام رنجها را متحمّل می‌شوم، امّا از آن خجل نیستم زیرا می‌دانم به چه كسی ایمان آورده‌ام و یقین دارم كه او قادر است تا روز آخر آنچه را به من سپرده شد، حفظ كند."
        },
        {
          "verse": 13,
          "usfm": "2TI.1.13",
          "line_type": "p",
          "text": "تعلیم صحیحی را كه از من شنیده‌ای، با ایمان و محبتّی كه در مسیح عیسی است، سرمشق خود قرار بده"
        },
        {
          "verse": 14,
          "usfm": "2TI.1.14",
          "line_type": "p",
          "text": "و به وسیلهٔ قدرت روح‌القدس كه در ما به سر می‌برد، آن چیزهای نیكویی را كه به تو سپرده شده است، حفظ كن."
        },
        {
          "verse": 15,
          "usfm": "2TI.1.15",
          "line_type": "p",
          "text": "خبرداری كه در استان آسیا همه از جمله «فیجلس» و «هرموجنس» مرا ترک کرده‌اند."
        },
        {
          "verse": 16,
          "usfm": "2TI.1.16",
          "line_type": "p",
          "text": "خداوند رحمت خود را به خانواده «انی‌سی‌فورس» عطا فرماید زیرا او نیروی تازه‌ای به من بخشیده است. او از اینكه من زندانی هستم، خجل نبود."
        },
        {
          "verse": 17,
          "usfm": "2TI.1.17",
          "line_type": "p",
          "text": "بلكه به محض اینكه به «روم» رسید، در جستجوی من زحمت زیادی كشید تا مرا پیدا كرد."
        },
        {
          "verse": 18,
          "usfm": "2TI.1.18",
          "line_type": "p",
          "text": "خداوند عطا فرماید كه در روز عظیم، او از دست خداوند رحمت یابد و تو به خوبی می‌دانی كه او در «افسس» چه خدمتهایی برای من كرد."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 3,
          "text": "تیموتاؤس و مأموریت او"
        }
      ],
