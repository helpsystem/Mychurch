    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 4,
      "chapter_usfm": "2TI.4",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.4.1",
          "line_type": "p",
          "text": "در پیشگاه خدا و در حضور مسیح عیسی كه بر زندگان و مردگان داوری خواهد كرد و به‌خاطر ظهور و پادشاهی او تو را موظّف می‌سازم"
        },
        {
          "verse": 2,
          "usfm": "2TI.4.2",
          "line_type": "p",
          "text": "كه پیام را اعلام كنی. در وقت و بی‌وقت آمادهٔ كار باش و دیگران را متقاعد و توبیخ و تشویق كن و با صبر و شكیبایی تمام تعلیم بده."
        },
        {
          "verse": 3,
          "usfm": "2TI.4.3",
          "line_type": "p",
          "text": "زیرا زمانی خواهد آمد كه آدمیان به تعلیم درست گوش نخواهند داد، بلكه از امیال خودشان پیروی خواهند کرد و برای خود معلّمین بیشتری جمع خواهند كرد تا نصایحی را كه خود دوست دارند از زبان آنها بشنوند."
        },
        {
          "verse": 4,
          "usfm": "2TI.4.4",
          "line_type": "p",
          "text": "آنها از شنیدن حقیقت خودداری می‌کنند و توجّه خود را به افسانه‌ها معطوف می‌دارند."
        },
        {
          "verse": 5,
          "usfm": "2TI.4.5",
          "line_type": "p",
          "text": "امّا تو باید در تمام شرایط هوشیار بوده و برای تحمّل رنج آماده باشی. در انتشار انجیل كوشش كن و وظیفهٔ خود را به عنوان خادم خدا انجام بده."
        },
        {
          "verse": 6,
          "usfm": "2TI.4.6",
          "line_type": "p",
          "text": "امّا من، وقت آن رسیده است كه قربانی شوم و زمان رحلتم رسیده است."
        },
        {
          "verse": 7,
          "usfm": "2TI.4.7",
          "line_type": "p",
          "text": "من در مسابقه نهایت كوشش خود را نموده‌ام و دورهٔ خود را تمام نموده، ایمانم را حفظ کرده‌ام."
        },
        {
          "verse": 8,
          "usfm": "2TI.4.8",
          "line_type": "p",
          "text": "اكنون تاج پیروزی در انتظار من است، همان تاج نیكی مطلق كه خداوند، یعنی آن داور عادل در روز بازپسین به من خواهد داد و آن را نه تنها به من، بلكه به همهٔ آنانی كه مشتاق ظهور او بوده‌اند، عنایت خواهد فرمود."
        },
        {
          "verse": 9,
          "usfm": "2TI.4.9",
          "line_type": "p",
          "text": "سعی كن كه هرچه زودتر نزد من بیایی،"
        },
        {
          "verse": 10,
          "usfm": "2TI.4.10",
          "line_type": "p",
          "text": "زیرا «دیماس» به‌خاطر عشقی كه به این دنیا دارد، مرا ترک كرده و به تسالونیكی رفته و «كریسكیس» به غلاطیه و «تیطُس» به دلماطیه رفته است."
        },
        {
          "verse": 11,
          "usfm": "2TI.4.11",
          "line_type": "p",
          "text": "تنها «لوقا» با من است. «مرقس» را بردار و با خود بیاور، چون برای كارم مفید است."
        },
        {
          "verse": 12,
          "usfm": "2TI.4.12",
          "line_type": "p",
          "text": "«تیخیكاس» را به افسس فرستادم."
        },
        {
          "verse": 13,
          "usfm": "2TI.4.13",
          "line_type": "p",
          "text": "در موقع آمدن، عبای مرا كه در شهر ترواس نزد «كرپس» جا گذاشتم و همچنین كتابها و از همه مهمتر نسخه‌های پوستی را بیاور."
        },
        {
          "verse": 14,
          "usfm": "2TI.4.14",
          "line_type": "p",
          "text": "«اسكندر مسگر» لطمهٔ بزرگی به من زد. خداوند مطابق کارهایش به او سزا خواهد داد."
        },
        {
          "verse": 15,
          "usfm": "2TI.4.15",
          "line_type": "p",
          "text": "تو نیز از او برحذر باش، زیرا شدیداً با پیام ما مخالف بود."
        },
        {
          "verse": 16,
          "usfm": "2TI.4.16",
          "line_type": "p",
          "text": "در اولین محاكمه من هیچ‌کس جانب مرا نگرفت، همه مرا ترک كردند. خدا این کار را به حسابشان نگذارد."
        },
        {
          "verse": 17,
          "usfm": "2TI.4.17",
          "line_type": "p",
          "text": "امّا خداوند با من بود و قدرتی به من عطا كرد كه توانستم تمام پیام را اعلام كنم و آن را به گوش تمام ملل برسانم و به این وسیله از دهان شیر رهایی یافتم."
        },
        {
          "verse": 18,
          "usfm": "2TI.4.18",
          "line_type": "p",
          "text": "خداوند مرا از همهٔ بدیها خواهد رهانید و مرا به سلامت به پادشاهی سماوی خود خواهد رسانید. بر او تا به ابد جلال باد! آمین."
        },
        {
          "verse": 19,
          "usfm": "2TI.4.19",
          "line_type": "p",
          "text": "به «پرسکله» و «اكیلا» و خانواده «انی‌سی‌فورس» سلام برسان."
        },
        {
          "verse": 20,
          "usfm": "2TI.4.20",
          "line_type": "p",
          "text": "«ارسطوس» در قرنتس ماند و «تروفیمس» را در میلیتس جا گذاشتم، زیرا مریض بود."
        },
        {
          "verse": 21,
          "usfm": "2TI.4.21",
          "line_type": "p",
          "text": "سعی كن كه قبل از زمستان بیایی. «یوبولس»، «پودس»، «لینوس»، «كلادیه» و تمام ایمانداران سلام می‌رسانند."
        },
        {
          "verse": 22,
          "usfm": "2TI.4.22",
          "line_type": "p",
          "text": "خداوند با روح تو باشد. فیض خدا با همهٔ شما باد."
        }
      ],
      "verse_count": 22,
