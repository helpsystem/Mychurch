    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 2,
      "chapter_usfm": "2TI.2",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.2.1",
          "line_type": "p",
          "text": "و امّا تو، ای پسر من، با فیضی كه در مسیح عیسی است قوی باش"
        },
        {
          "verse": 2,
          "usfm": "2TI.2.2",
          "line_type": "p",
          "text": "و سخنانی را كه در حضور شاهدان بسیاری از من شنیده‌ای به كسانی بسپار كه مورد اعتماد و قادر به تعلیم دیگران باشند."
        },
        {
          "verse": 3,
          "usfm": "2TI.2.3",
          "line_type": "p",
          "text": "به عنوان سرباز خوب مسیح عیسی متحمّل سختی‌ها باش."
        },
        {
          "verse": 4,
          "usfm": "2TI.2.4",
          "line_type": "p",
          "text": "هیچ سربازی خود را گرفتار امور غیرنظامی نمی‌كند، زیرا هدف او جلب رضایت فرمانده‌اش می‌باشد."
        },
        {
          "verse": 5,
          "usfm": "2TI.2.5",
          "line_type": "p",
          "text": "ورزشكاری كه در مسابقه‌ای شركت می‌كند، نمی‌تواند جایزه را ببرد مگر اینكه قوانین آن را پیروی كند."
        },
        {
          "verse": 6,
          "usfm": "2TI.2.6",
          "line_type": "p",
          "text": "كشاورزی كه زحمت كشیده است، باید اولین كسی باشد كه از ثمرهٔ محصول خود بهره ببرد."
        },
        {
          "verse": 7,
          "usfm": "2TI.2.7",
          "line_type": "p",
          "text": "در آنچه می‌گویم تأمّل كن و خداوند تو را قادر می‌سازد كه همه‌چیز را بفهمی."
        },
        {
          "verse": 8,
          "usfm": "2TI.2.8",
          "line_type": "p",
          "text": "عیسی مسیح را كه پس از مرگ زنده گشت و از نسل داوود بود، به‌خاطر داشته باش، انجیلی كه من اعلام می‌کنم همین است"
        },
        {
          "verse": 9,
          "usfm": "2TI.2.9",
          "line_type": "p",
          "text": "و به‌خاطر آن است كه رنج و زحمت می‌بینم و حتّی مانند یک جنایتكار در زنجیرم. امّا كلام خدا در زنجیر بسته نمی‌شود."
        },
        {
          "verse": 10,
          "usfm": "2TI.2.10",
          "line_type": "p",
          "text": "بنابراین همه‌چیز را به‌خاطر برگزیدگان خدا تحمّل می‌كنم تا آنها نیز نجاتی را كه در مسیح عیسی است همراه با جلال جاودانهٔ آن به دست آورند."
        },
        {
          "verse": 11,
          "usfm": "2TI.2.11",
          "line_type": "p",
          "text": "این سخن درست است:«اگر با او مردیم، همچنین با او خواهیم زیست."
        },
        {
          "verse": 12,
          "usfm": "2TI.2.12",
          "line_type": "q1",
          "text": "اگر تحمّل كنیم، با او فرمانروایی خواهیم كرد.اگر او را انكار كنیم، او هم ما را انكار خواهد كرد،"
        },
        {
          "verse": 13,
          "usfm": "2TI.2.13",
          "line_type": "q1",
          "text": "ولی اگر بی‌وفایی كنیم، او وفادار خواهد ماندزیرا او نمی‌تواند خود را انكار كند.»"
        },
        {
          "verse": 14,
          "usfm": "2TI.2.14",
          "line_type": "p",
          "text": "این مطالب را به مردم گوشزد كن و در حضور خدا به آنها دستور بده كه از مجادله بر سر كلمات دست بردارند. چون این كار عاقبت خوشی ندارد، بلكه فقط باعث گمراهی شنوندگان خواهد شد."
        },
        {
          "verse": 15,
          "usfm": "2TI.2.15",
          "line_type": "p",
          "text": "منتهای كوشش خود را بكن تا مانند کارگری كه از كار خود خجل نیست و پیام حقیقت را به درستی تعلیم می‌دهد، در نظر خدا کاملاً مورد پسند باشی."
        },
        {
          "verse": 16,
          "usfm": "2TI.2.16",
          "line_type": "p",
          "text": "از مباحثات زشت و بی‌معنی كه فقط مردم را به بی‌دینی روزافزون می‌کشاند، دوری كن."
        },
        {
          "verse": 17,
          "usfm": "2TI.2.17",
          "line_type": "p",
          "text": "حرف ایشان مثل بیماری خوره، به تمام بدن سرایت می‌کند. از آن جمله‌اند «هیمینائوس» و «فیلیطس»"
        },
        {
          "verse": 18,
          "usfm": "2TI.2.18",
          "line_type": "p",
          "text": "كه از حقیقت منحرف شده‌اند و می‌گویند كه رستاخیز ما هم اكنون به وقوع پیوسته است و به این وسیلهٔ ایمان عدّه‌ای را از بین می‌برند."
        },
        {
          "verse": 19,
          "usfm": "2TI.2.19",
          "line_type": "p",
          "text": "امّا، شالودهٔ مستحكمی كه خدا نهاده، متزلزل نخواهد شد و این كلمات بر آن نقش شده است:«خداوند متعلّقان خود را می‌شناسد» و «هرکه نام خداوند را به زبان آورد، شرارت را ترک كند.»"
        },
        {
          "verse": 20,
          "usfm": "2TI.2.20",
          "line_type": "p",
          "text": "در یک خانهٔ بزرگ علاوه بر ظروف طلایی و نقره‌ای، ظروف چوبی و سفالی هم وجود دارد. بعضی از آنها مخصوص موارد مهم است و بعضی در موارد معمولی استفاده می‌شود."
        },
        {
          "verse": 21,
          "usfm": "2TI.2.21",
          "line_type": "p",
          "text": "اگر كسی خود را از این آلودگیها پاک سازد، ظرفی می‌شود كه برای مقاصد خاص بكار خواهد رفت و برای اربابش مقدّس و مفید و برای هر کار نیكو آماده خواهد بود."
        },
        {
          "verse": 22,
          "usfm": "2TI.2.22",
          "line_type": "p",
          "text": "از شهواتی كه مربوط به دوران جوانی است بگریز و به اتّفاق همهٔ کسانی‌که با قلبی پاک به پیشگاه خداوند دعا می‌كنند، نیكویی مطلق، ایمان، محبّت و صلح و صفا را دنبال كن."
        },
        {
          "verse": 23,
          "usfm": "2TI.2.23",
          "line_type": "p",
          "text": "به مباحثات احمقانه و جاهلانه كاری نداشته باش، زیرا می‌دانی كه به نزاع می‌انجامد."
        },
        {
          "verse": 24,
          "usfm": "2TI.2.24",
          "line_type": "p",
          "text": "خادم خداوند نباید نزاع كند، بلكه باید نسبت به همه مهربان و معلّمی توانا و در سختی‌ها صبور باشد"
        },
        {
          "verse": 25,
          "usfm": "2TI.2.25",
          "line_type": "p",
          "text": "و مخالفان خود را با ملایمت اصلاح كند، شاید خدا اجازه دهد كه آنها توبه كنند و حقیقت را بشناسند."
        },
        {
          "verse": 26,
          "usfm": "2TI.2.26",
          "line_type": "p",
          "text": "به این وسیله به خود خواهند آمد و از دام ابلیس، كه آنان را گرفتار ساخته و به اطاعت ارادهٔ خویش وادار كرده است، خواهند گریخت."
        }
      ],
      "verse_count": 26,
      "headings": [
        {
          "before_verse": 14,
          "text": "مشخّصات خادم مقبول خدا"
        }
      ],
      "footnotes": [],
