  "chapters": [
    {
      "schema_version": 6,
      "book_id": "1JN",
      "chapter": 1,
      "chapter_usfm": "1JN.1",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1JN.1.1",
          "line_type": "p",
          "text": "ما دربارهٔ كلمهٔ حیات به شما می‌نویسیم -كلامی كه از ازل بود و ما آن را شنیده و با چشمان خود دیده‌ایم - ‌آری، ما آن را دیده‌ایم و دستهایمان آن را لمس كرده است."
        },
        {
          "verse": 2,
          "usfm": "1JN.1.2",
          "line_type": "p",
          "text": "آن حیات ظاهر شد و ما آن را دیدیم. پس ما دربارهٔ آن شهادت می‌دهیم و از حیات جاودانی كه با پدر بود و به ما شناسانیده شد، شما را آگاه می‌سازیم."
        },
        {
          "verse": 3,
          "usfm": "1JN.1.3",
          "line_type": "p",
          "text": "آری، آنچه را كه ما دیده‌ و شنیده‌ایم به شما اعلام می‌کنیم تا در اتّحادی كه ما با پدر و پسر او عیسی مسیح داریم، شما هم با ما شریک شوید."
        },
        {
          "verse": 4,
          "usfm": "1JN.1.4",
          "line_type": "p",
          "text": "این را می‌نویسیم تا شادی ما كامل گردد."
        },
        {
          "verse": 5,
          "usfm": "1JN.1.5",
          "line_type": "p",
          "text": "این است پیامی كه ما از او شنیدیم و به شما اعلام می‌کنیم: خدا نور است و هیچ ظلمت در او نیست."
        },
        {
          "verse": 6,
          "usfm": "1JN.1.6",
          "line_type": "p",
          "text": "پس اگر بگوییم با او متّحد هستیم و در‌عین‌حال در ظلمت زندگی می‌کنیم، معلوم می‌شود كه گفتار ما دروغ و كردار ما نادرست است."
        },
        {
          "verse": 7,
          "usfm": "1JN.1.7",
          "line_type": "p",
          "text": "امّا اگر در نور به سر می‌بریم -‌همان‌طور كه خدا در نور است- در آن صورت با یكدیگر اتّحاد داریم و خون عیسی، پسر او، ما را از همهٔ گناهانمان پاک می‌سازد."
        },
        {
          "verse": 8,
          "usfm": "1JN.1.8",
          "line_type": "p",
          "text": "اگر بگوییم كه بی‌گناه هستیم، خود را فریب می‌دهیم و از حقیقت دور هستیم."
        },
        {
          "verse": 9,
          "usfm": "1JN.1.9",
          "line_type": "p",
          "text": "امّا اگر ما به گناهان خود اعتراف نماییم، می‌توانیم به او اعتماد كنیم؛ زیرا او به حق عمل می‌کند. او گناهان ما را می‌آمرزد و ما را از همهٔ خطاهایمان پاک می‌سازد."
        },
        {
          "verse": 10,
          "usfm": "1JN.1.10",
          "line_type": "p",
          "text": "اگر بگوییم كه هرگز مرتكب گناهی نشده‌ایم، خدا را دروغگو شمرده‌ایم و از كلام او کاملاً بی‌خبر هستیم."
        }
      ],
      "verse_count": 10,
      "headings": [
        {
          "before_verse": 5,
          "text": "زندگی در نور خدا"
        }
      ],
