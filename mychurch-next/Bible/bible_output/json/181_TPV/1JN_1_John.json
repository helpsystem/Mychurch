    {
      "schema_version": 6,
      "book_id": "1JN",
      "chapter": 2,
      "chapter_usfm": "1JN.2",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1JN.2.1",
          "line_type": "p",
          "text": "ای فرزندان من، این را به شما می‌نویسم تا گناه نكنید. امّا اگر كسی مرتكب گناهی شود، در پیشگاه خدای پدر كسی را داریم كه برای ما شفاعت می‌کند -‌همان عیسی مسیح كه کاملاً نیكوست-"
        },
        {
          "verse": 2,
          "usfm": "1JN.2.2",
          "line_type": "p",
          "text": "زیرا خود مسیح كفّارهٔ گناهان ماست، نه تنها گناهان ما، بلكه گناهان همهٔ مردم دنیا."
        },
        {
          "verse": 3,
          "usfm": "1JN.2.3",
          "line_type": "p",
          "text": "فقط وقتی ما از احكام خدا اطاعت می‌کنیم، می‌توانیم مطمئن باشیم كه او را می‌شناسیم"
        },
        {
          "verse": 4,
          "usfm": "1JN.2.4",
          "line_type": "p",
          "text": "و اگر كسی بگوید كه او را می‌شناسد ولی طبق دستورات او عمل نمی‌کند، دروغگو و از حقیقت دور است."
        },
        {
          "verse": 5,
          "usfm": "1JN.2.5",
          "line_type": "p",
          "text": "امّا وقتی كسی مطابق كلام خدا زندگی می‌کند، محبّت خدا در او به طور واقعی به كمال رسیده است. از این راه می‌توانیم مطمئن باشیم كه در خدا زندگی می‌کنیم:"
        },
        {
          "verse": 6,
          "usfm": "1JN.2.6",
          "line_type": "p",
          "text": "هرکه بگوید كه در خدا زندگی می‌کند، زندگی او باید درست مانند زندگی عیسی مسیح باشد."
        },
        {
          "verse": 7,
          "usfm": "1JN.2.7",
          "line_type": "p",
          "text": "ای عزیزان، دستوری كه به شما می‌نویسم فرمان تازه‌ای نیست، بلكه دستوری است قدیمی؛ یعنی همان است كه شما از ابتدا داشته‌اید. این همان پیامی است که از اول شنیده‌اید."
        },
        {
          "verse": 8,
          "usfm": "1JN.2.8",
          "line_type": "p",
          "text": "در هر حال دستور تازه‌ای به شما می‌نویسم و حقیقت آن، هم در مسیح و هم در شما دیده می‌شود، زیرا پایان ظلمت نزدیک و نور حقیقی در حال درخشیدن است."
        },
        {
          "verse": 9,
          "usfm": "1JN.2.9",
          "line_type": "p",
          "text": "اگر كسی ادّعا كند كه در نور است و در‌عین‌حال از برادر یا خواهر خود نفرت دارد، او هنوز در ظلمت است."
        },
        {
          "verse": 10,
          "usfm": "1JN.2.10",
          "line_type": "p",
          "text": "هرکه برادر یا خواهر خود را دوست بدارد، در نور زندگی می‌کند و باعث لغزش خود و یا دیگران نخواهد شد."
        },
        {
          "verse": 11,
          "usfm": "1JN.2.11",
          "line_type": "p",
          "text": "امّا هرکه از برادر یا خواهر خود متنفّر باشد، در ظلمت است، در ظلمت راه می‌رود و نمی‌داند به كجا می‌رود، زیرا تاریكی چشمانش را كور كرده است."
        },
        {
          "verse": 12,
          "usfm": "1JN.2.12",
          "line_type": "p",
          "text": "ای فرزندان كوچک، به شما می‌نویسم زیرا گناهانتان به‌خاطر نام مسیح آمرزیده شده‌اند."
        },
        {
          "verse": 13,
          "usfm": "1JN.2.13",
          "line_type": "p",
          "text": "ای پدران، به شما می‌نویسم، زیرا او را كه از ازل بوده است، می‌شناسید.ای جوانان، به شما می‌نویسم، زیرا كه بر شیطان پیروز شده‌اید."
        },
        {
          "verse": 14,
          "usfm": "1JN.2.14",
          "line_type": "p",
          "text": "ای كودكان، به شما نوشته‌ام، زیرا شما پدر را می‌شناسید.ای پدران، به شما نوشته‌ام، زیرا او را كه از ازل بوده است، می‌شناسید.ای جوانان، به شما نوشته‌ام، زیرا نیرومند هستید و كلام خدا در شماست و شما بر شیطان پیروز شده‌اید."
        },
        {
          "verse": 15,
          "usfm": "1JN.2.15",
          "line_type": "p",
          "text": "به دنیا و آنچه به آن تعلّق دارد دل نبندید، کسی‌که دنیا را دوست دارد محبّت خدای پدر در او نیست."
        },
        {
          "verse": 16,
          "usfm": "1JN.2.16",
          "line_type": "p",
          "text": "هر آنچه به جهان تعلّق دارد -یعنی آنچه نفس اَمّاره آرزو می‌کند و آنچه چشم می‌بیند و طلب می‌کند و آنچه مایهٔ فخر و غرور است- از پدر نیست. اینها همه به دنیا تعلّق دارند."
        },
        {
          "verse": 17,
          "usfm": "1JN.2.17",
          "line_type": "p",
          "text": "جهان و تمایلات دنیوی از بین خواهند رفت؛ امّا هرکه ارادهٔ خدا را بجا آورد، تا به ابد خواهد زیست."
        },
        {
          "verse": 18,
          "usfm": "1JN.2.18",
          "line_type": "p",
          "text": "ای فرزندان من، ساعت آخر فرا رسیده است و چنانکه شما شنیدید «دشمن مسیح» در زمان آخر ظاهر خواهد شد؛ و حالا می‌بینیم كه دشمنان مسیح كه ظاهر شده‌اند زیادند و از این رو می‌فهمیم كه ساعت آخر نزدیک است."
        },
        {
          "verse": 19,
          "usfm": "1JN.2.19",
          "line_type": "p",
          "text": "این دشمنان مسیح از میان ما بیرون رفتند. آنها در واقع هیچ‌وقت به ما تعلّق نداشتند. اگر متعلّق به ما می‌بودند، می‌ماندند. امّا رفتند تا معلوم گردد كه هیچ‌یک از آنها در حقیقت از ما نبودند."
        },
        {
          "verse": 20,
          "usfm": "1JN.2.20",
          "line_type": "p",
          "text": "امّا مسیح، شما را با روح‌القدس خود مسح كرده است و از این رو همهٔ شما حقیقت را می‌دانید."
        },
        {
          "verse": 21,
          "usfm": "1JN.2.21",
          "line_type": "p",
          "text": "من این را به آن منظور ننوشتم كه شما از حقیقت بی‌خبرید، بلكه چون آن را می‌دانید و آگاه هستید كه هیچ ناراستی از راستی سرچشمه نمی‌گیرد."
        },
        {
          "verse": 22,
          "usfm": "1JN.2.22",
          "line_type": "p",
          "text": "پس آن دروغگوی واقعی كیست؟ كسی است كه بگوید عیسی، «مسیح» نیست. این شخص «دشمن مسیح» است چون او هم پدر و هم پسر را رد می‌کند."
        },
        {
          "verse": 23,
          "usfm": "1JN.2.23",
          "line_type": "p",
          "text": "هرکه پسر را رد كند پدر را نیز رد كرده است و هرکه پسر را بپذیرد، پدر را نیز پذیرفته است."
        },
        {
          "verse": 24,
          "usfm": "1JN.2.24",
          "line_type": "p",
          "text": "بگذارید تأثیر پیامی كه از اول شنیدید، در دلهای شما باقی بماند. اگر تأثیر آنچه كه از اول به شما گفته شده است، در دلهای شما بماند، شما همیشه در پدر و پسر خواهید ماند."
        },
        {
          "verse": 25,
          "usfm": "1JN.2.25",
          "line_type": "p",
          "text": "و وعدهٔ عیسی مسیح این است كه او، حیات جاودان به شما خواهد بخشید."
        },
        {
          "verse": 26,
          "usfm": "1JN.2.26",
          "line_type": "p",
          "text": "من این چیزها را دربارهٔ اشخاصی كه می‌خواهند شما را گمراه سازند، نوشته‌ام."
        },
        {
          "verse": 27,
          "usfm": "1JN.2.27",
          "line_type": "p",
          "text": "امّا شما نیازی ندارید كه كسی شما را تعلیم دهد، زیرا روح‌القدس كه مسیح آن را به شما داده است، در شما زندگی می‌کند. روح خدا در هر مورد به شما تعلیم می‌دهد و تعالیم او بر حقّ است و در آن ناراستی نیست. پس همان‌طور كه روح خدا به شما تعلیم می‌دهد در مسیح بمانید."
        },
        {
          "verse": 28,
          "usfm": "1JN.2.28",
          "line_type": "p",
          "text": "آری ای فرزندان من، در او بمانید تا در وقت ظهور او، نه تنها احساس شرمندگی نكنیم، بلكه با اطمینان در حضورش حاضر شویم."
        },
        {
          "verse": 29,
          "usfm": "1JN.2.29",
          "line_type": "p",
          "text": "اگر درک کرده‌اید كه مسیح کاملاً نیک است، باید این حقیقت را نیز بدانید كه هرکه نیكی كند، فرزند خداست."
        }
      ],
      "verse_count": 29,
