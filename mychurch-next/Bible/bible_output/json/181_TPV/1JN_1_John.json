    {
      "schema_version": 6,
      "book_id": "1JN",
      "chapter": 4,
      "chapter_usfm": "1JN.4",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1JN.4.1",
          "line_type": "p",
          "text": "ای عزیزان، به هر نبوّتی (الهامی) اعتماد نكنید، بلكه آنها را بیازمایید تا ببینید كه آیا در واقع از جانب خداست یا نه، زیرا عدّهٔ ‌زیادی هستند كه به سرتاسر دنیا رفته، به دروغ نبوّت می‌کنند."
        },
        {
          "verse": 2,
          "usfm": "1JN.4.2",
          "line_type": "p",
          "text": "چگونه می‌توان نبوّتی را که از طرف روح خداست تشخیص داد؟ هرکه با هدایت روح اقرار كند كه عیسی مسیح در جسم ظاهر شد، از جانب خداست"
        },
        {
          "verse": 3,
          "usfm": "1JN.4.3",
          "line_type": "p",
          "text": "و هرکه مُنكر این حقیقت شود نه تنها از جانب خدا نیست، بلكه او دارای روح «دشمن مسیح» می‌باشد. شما شنیده‌اید كه او می‌آید، درحالی‌كه هم اكنون در این جهان است."
        },
        {
          "verse": 4,
          "usfm": "1JN.4.4",
          "line_type": "p",
          "text": "ای فرزندان من، شما به خدا تعلّق دارید و بر کسانی‌که به دروغ نبوّت می‌کنند غلبه یافته‌اید، زیرا روحی كه در شماست از روحی كه در این دنیا كار می‌کند، قویتر است."
        },
        {
          "verse": 5,
          "usfm": "1JN.4.5",
          "line_type": "p",
          "text": "آنها متعلّق به این دنیا هستند و دربارهٔ امور دنیوی سخن می‌گویند و به این سبب دنیا به آنها گوش می‌دهد."
        },
        {
          "verse": 6,
          "usfm": "1JN.4.6",
          "line_type": "p",
          "text": "امّا، ما فرزندان خدا هستیم و هر کسی كه خدا را می‌شناسد به ما گوش می‌دهد. درحالی‌که کسی‌که به خدا تعلّق ندارد، سخنان ما را قبول نمی‌کند. پس به این ترتیب، ما می‌توانیم پیام حقیقت را كه از جانب روح خداست، از پیامهای نادرستی كه از جانب ارواح دیگر هستند، تشخیص دهیم."
        },
        {
          "verse": 7,
          "usfm": "1JN.4.7",
          "line_type": "p",
          "text": "ای عزیزان، ما باید یكدیگر را دوست بداریم، زیرا دوستی و محبّت از جانب خداست. هرکه محبّت دارد، فرزند خداست و خدا را می‌شناسد."
        },
        {
          "verse": 8,
          "usfm": "1JN.4.8",
          "line_type": "p",
          "text": "امّا، آنكه محبّت ندارد از خدا کاملاً بی‌خبر است، زیرا خدا محبّت است."
        },
        {
          "verse": 9,
          "usfm": "1JN.4.9",
          "line_type": "p",
          "text": "و محبّت خدا از این طریق به ما آشكار گردید كه خدا پسر یگانهٔ خود را به جهان فرستاد تا ما به وسیلهٔ او حیات داشته باشیم."
        },
        {
          "verse": 10,
          "usfm": "1JN.4.10",
          "line_type": "p",
          "text": "محبّتی كه من از آن سخن می‌گویم، محبّت ما نسبت به خدا نیست، بلكه محبّت خدا نسبت به ماست. محبّتی كه باعث شد او پسر خود را به عنوان كفّارهٔ گناهان ما به جهان بفرستد."
        },
        {
          "verse": 11,
          "usfm": "1JN.4.11",
          "line_type": "p",
          "text": "ای عزیزان، اگر محبّت خدا به ما چنین است، ما نیز باید یكدیگر را دوست بداریم."
        },
        {
          "verse": 12,
          "usfm": "1JN.4.12",
          "line_type": "p",
          "text": "هیچ‌کس هرگز خدا را ندیده است، امّا اگر ما یكدیگر را دوست بداریم، خدا در ما زندگی می‌کند و محبّت او در ما به كمال می‌رسد."
        },
        {
          "verse": 13,
          "usfm": "1JN.4.13",
          "line_type": "p",
          "text": "چگونه می‌توانیم بدانیم که خدا در ماست و ما در خدا؟ از اینكه او روح خود را به ما بخشیده است!"
        },
        {
          "verse": 14,
          "usfm": "1JN.4.14",
          "line_type": "p",
          "text": "ما خود دیده‌ایم و شهادت می‌دهیم كه خدای پدر، پسر خود را فرستاد تا نجات‌دهندهٔ عالم باشد"
        },
        {
          "verse": 15,
          "usfm": "1JN.4.15",
          "line_type": "p",
          "text": "و هرکه اقرار كند كه عیسی پسر خداست، خدا در اوست و او در خدا."
        },
        {
          "verse": 16,
          "usfm": "1JN.4.16",
          "line_type": "p",
          "text": "ما از محبّت خدا نسبت به خود آگاهیم و به آن اطمینان داریم. خدا محبّت است و هرکه با محبّت زندگی می‌کند، در خدا ساكن است و خدا در او."
        },
        {
          "verse": 17,
          "usfm": "1JN.4.17",
          "line_type": "p",
          "text": "به این وسیله محبّت در ما به كمال رسیده است تا در روز داوری اعتماد داشته باشیم، زیرا زندگی ما مانند زندگی او در این جهان است."
        },
        {
          "verse": 18,
          "usfm": "1JN.4.18",
          "line_type": "p",
          "text": "کسی‌که محبّت دارد، نمی‌‌‌ترسد و هرکه بترسد هنوز به محبّت كامل نرسیده است؛ زیرا محبّت كامل ترس را دور می‌سازد، ولی شخصی می‌ترسد كه در انتظار مجازات است."
        },
        {
          "verse": 19,
          "usfm": "1JN.4.19",
          "line_type": "p",
          "text": "ما به دیگران محبّت می‌کنیم چون اول خدا به ما محبّت كرد."
        },
        {
          "verse": 20,
          "usfm": "1JN.4.20",
          "line_type": "p",
          "text": "اگر بگوییم: «من خدا را دوست دارم.» درحالی‌که از دیگری خود نفرت داریم، دروغگو هستیم، زیرا اگر کسانی را كه می‌بینیم محبّت نمی‌کنیم، محال است خدایی را كه ندیده‌ایم محبّت نماییم."
        },
        {
          "verse": 21,
          "usfm": "1JN.4.21",
          "line_type": "p",
          "text": "فرمانی كه او به ما داده است چنین است: «هرکه خدا را دوست دارد، باید دیگران را نیز دوست بدارد.»"
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 7,
          "text": "خدا محبّت است"
        }
      ],
