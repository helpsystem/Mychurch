    {
      "schema_version": 6,
      "book_id": "1JN",
      "chapter": 5,
      "chapter_usfm": "1JN.5",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1JN.5.1",
          "line_type": "p",
          "text": "هرکه ایمان دارد كه عیسی، مسیح است فرزند خداست و هرکه پدر را دوست دارد فرزند او را نیز دوست خواهد داشت."
        },
        {
          "verse": 2,
          "usfm": "1JN.5.2",
          "line_type": "p",
          "text": "ما چگونه می‌دانیم كه فرزندان خدا را دوست داریم؟ از اینكه خدا را دوست داریم و مطابق احكام او عمل می‌کنیم."
        },
        {
          "verse": 3,
          "usfm": "1JN.5.3",
          "line_type": "p",
          "text": "زیرا محبّت به خدا چیزی جز اطاعت از احكام او نیست و این احكام بار سنگینی نیست،"
        },
        {
          "verse": 4,
          "usfm": "1JN.5.4",
          "line_type": "p",
          "text": "زیرا همهٔ فرزندان خدا بر این جهان غلبه یافته‌اند و ما این پیروزی را به وسیلهٔ ایمان به دست آورده‌ایم."
        },
        {
          "verse": 5,
          "usfm": "1JN.5.5",
          "line_type": "p",
          "text": "و كسی بر جهان پیروز نمی‌شود مگر آن كسی ایمان دارد كه عیسی، پسر خداست!"
        },
        {
          "verse": 6,
          "usfm": "1JN.5.6",
          "line_type": "p",
          "text": "آمدن مسیح با تعمید و ریختن خون خودش همراه بود. آمدن او نه تنها با آب تعمید، بلكه هم با آب تعمید و هم با خون خودش ثابت گردید. روح خدا كه حقیقت محض است نیز این را تصدیق می‌کند."
        },
        {
          "verse": 7,
          "usfm": "1JN.5.7",
          "line_type": "p",
          "text": "پس سه شاهد وجود دارد:"
        },
        {
          "verse": 8,
          "usfm": "1JN.5.8",
          "line_type": "p",
          "text": "روح خدا، آب و خون؛ و شهادت این سه شاهد با هم سازگار است."
        },
        {
          "verse": 9,
          "usfm": "1JN.5.9",
          "line_type": "p",
          "text": "ما كه شهادت انسان را می‌پذیریم، با شهادت خدا كه قویتر است چه خواهیم كرد؟ و این شهادتی است كه او برای پسر خود داده است."
        },
        {
          "verse": 10,
          "usfm": "1JN.5.10",
          "line_type": "p",
          "text": "هرکه به پسر خدا ایمان آورد، این شهادت را در دل خود دارد، امّا هرکه شهادت خدا را قبول نكند و گواهی او را در مورد پسرش نپذیرد، خدا را دروغگو شمرده است."
        },
        {
          "verse": 11,
          "usfm": "1JN.5.11",
          "line_type": "p",
          "text": "شهادت این است كه خدا به ما حیات جاودانی داده است و این حیات در پسر او یافت می‌شود."
        },
        {
          "verse": 12,
          "usfm": "1JN.5.12",
          "line_type": "p",
          "text": "هرکه پسر را دارد، حیات دارد و هرکه پسر خدا را ندارد، صاحب حیات نیست."
        },
        {
          "verse": 13,
          "usfm": "1JN.5.13",
          "line_type": "p",
          "text": "این نامه را نوشتم تا شما كه به نام پسر خدا ایمان دارید، یقین بدانید كه حیات جاودانی دارید."
        },
        {
          "verse": 14,
          "usfm": "1JN.5.14",
          "line_type": "p",
          "text": "اطمینان ما در حضور خدا این است كه اگر از او چیزی بخواهیم كه مطابق ارادهٔ او باشد، به ما گوش خواهد داد."
        },
        {
          "verse": 15,
          "usfm": "1JN.5.15",
          "line_type": "p",
          "text": "ما می‌دانیم كه هرچه بخواهیم او به ما گوش می‌دهد. پس این را هم باید بدانیم كه آنچه از او بطلبیم به ما عطا خواهد فرمود."
        },
        {
          "verse": 16,
          "usfm": "1JN.5.16",
          "line_type": "p",
          "text": "اگر كسی می‌بیند كه ایمانداری مرتكب گناهی شده است كه منجر به مرگ نیست، باید برای او به درگاه خداوند دعا كند و اگر آن شخص مرتكب چنین گناهی نشده باشد، خدا به او زندگی خواهد بخشید. امّا گناهی هم هست كه به مرگ منجر می‌شود و من نمی‌گویم كه در مورد آن دعا كنید."
        },
        {
          "verse": 17,
          "usfm": "1JN.5.17",
          "line_type": "p",
          "text": "البتّه هر خطایی گناه است، امّا هر گناهی منجر به مرگ نمی‌شود."
        },
        {
          "verse": 18,
          "usfm": "1JN.5.18",
          "line_type": "p",
          "text": "ما می‌دانیم كه فرزندان خدا در گناه زندگی نمی‌کنند، زیرا پسر خدا آنها را حفظ خواهد كرد و شیطان به آنان دسترسی ندارد."
        },
        {
          "verse": 19,
          "usfm": "1JN.5.19",
          "line_type": "p",
          "text": "می‌دانیم كه ما فرزندان خدا هستیم درحالی‌که تمام دنیا تحت تسلّط شیطان است."
        },
        {
          "verse": 20,
          "usfm": "1JN.5.20",
          "line_type": "p",
          "text": "ما می‌دانیم كه پسر خدا آمده و به ما فهم آن را داده است كه خدای حقیقی را بشناسیم، ما با خدای حقیقی و با پسر او عیسی مسیح متّحد هستیم. این است خدای حقیقی و این است حیات جاودانی."
        },
        {
          "verse": 21,
          "usfm": "1JN.5.21",
          "line_type": "p",
          "text": "ای فرزندان من، از بُتها دوری جویید."
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 6,
          "text": "سه شاهد عیسی مسیح"
        },
        {
          "before_verse": 13,
          "text": "حیات جاودان"
        }
      ],
