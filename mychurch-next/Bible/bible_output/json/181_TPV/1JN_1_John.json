    {
      "schema_version": 6,
      "book_id": "1JN",
      "chapter": 3,
      "chapter_usfm": "1JN.3",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1JN.3.1",
          "line_type": "p",
          "text": "ببینید محبّت خدای پدر چقدر عظیم است كه ما را فرزندان خود خوانده است و در واقع فرزندان خدا هستیم. اگر دنیا ما را آن طوری که در واقع هستیم نمی‌شناسد، علّتش این است كه او را نشناخته است."
        },
        {
          "verse": 2,
          "usfm": "1JN.3.2",
          "line_type": "p",
          "text": "ای دوستان عزیز، اكنون ما فرزندان خدا هستیم، امّا معلوم نیست كه در آینده چه خواهیم شد. ولی همین‌قدر می‌دانیم كه وقتی مسیح ظهور كند، ما مثل او خواهیم بود، زیرا او را آن‌چنان كه هست خواهیم دید."
        },
        {
          "verse": 3,
          "usfm": "1JN.3.3",
          "line_type": "p",
          "text": "هرکه در مسیح چنین امیدی دارد خود را پاک می‌سازد، همان‌طور كه مسیح پاک است."
        },
        {
          "verse": 4,
          "usfm": "1JN.3.4",
          "line_type": "p",
          "text": "هرکه گناه كند، قانون خدا را می‌شكند، زیرا گناه چیزی جز شكستن قانون نیست."
        },
        {
          "verse": 5,
          "usfm": "1JN.3.5",
          "line_type": "p",
          "text": "شما می‌دانید كه مسیح ظاهر شد تا گناهان را از میان بردارد و نیز می‌دانید كه او کاملاً بی‌گناه است."
        },
        {
          "verse": 6,
          "usfm": "1JN.3.6",
          "line_type": "p",
          "text": "بنابراین محال است كسی‌كه در اتّحاد با مسیح زندگی می‌کند، در گناه به سر ببرد! امّا هرکه در گناه زندگی می‌کند، او را هرگز ندیده و نشناخته است."
        },
        {
          "verse": 7,
          "usfm": "1JN.3.7",
          "line_type": "p",
          "text": "ای فرزندان من، كسی شما را گمراه نسازد. هرکه نیكی كند، شخصی نیكوست، همان‌طور كه عیسی مسیح کاملاً نیک است."
        },
        {
          "verse": 8,
          "usfm": "1JN.3.8",
          "line_type": "p",
          "text": "و هرکه در گناه به سر می‌برد، فرزند شیطان است، زیرا شیطان از ابتدا گناهكار بوده است و پسر خدا به همین سبب ظاهر شد تا كار شیطان را نابود سازد."
        },
        {
          "verse": 9,
          "usfm": "1JN.3.9",
          "line_type": "p",
          "text": "هرکه فرزند خداست نمی‌تواند در گناه زندگی کند، زیرا ذات الهی در اوست و نمی‌تواند در گناه به سر برد، زیرا خدا پدر اوست."
        },
        {
          "verse": 10,
          "usfm": "1JN.3.10",
          "line_type": "p",
          "text": "فرق بین فرزندان خدا و فرزندان ابلیس در این است: هرکه نیكی نمی‌کند و یا برادر و خواهر خود را دوست نمی‌دارد، فرزند خدا نیست."
        },
        {
          "verse": 11,
          "usfm": "1JN.3.11",
          "line_type": "p",
          "text": "زیرا آن پیامی كه شما از اول شنیدید این است كه: «باید یکدیگر را دوست بداریم.»"
        },
        {
          "verse": 12,
          "usfm": "1JN.3.12",
          "line_type": "p",
          "text": "ما نباید مثل قائن باشیم. او فرزند شیطان بود و برادر خود را كُشت. برای چه او را كُشت؟ به‌خاطر اینکه کارهای خودش نادرست و کارهای برادرش درست بود."
        },
        {
          "verse": 13,
          "usfm": "1JN.3.13",
          "line_type": "p",
          "text": "ای برادران من، اگر مردم این دنیا از شما متنفّر باشند، تعجّب نكنید."
        },
        {
          "verse": 14,
          "usfm": "1JN.3.14",
          "line_type": "p",
          "text": "ما می‌دانیم كه از مرگ گذشته و به حیات رسیده‌ایم، چون یکدیگر را دوست می‌داریم. هر که دیگران را دوست ندارد، هنوز در قلمرو مرگ زندگی می‌کند."
        },
        {
          "verse": 15,
          "usfm": "1JN.3.15",
          "line_type": "p",
          "text": "هرکه از برادر خود متنفّر باشد قاتل است و شما می‌دانید كه هیچ قاتلی دارای حیات جاودانی نیست."
        },
        {
          "verse": 16,
          "usfm": "1JN.3.16",
          "line_type": "p",
          "text": "ما معنی محبّت را درک کرده‌ایم زیرا مسیح جان خود را در راه ما فدا كرد. پس ما نیز باید جان خود را در راه یکدیگر فدا سازیم."
        },
        {
          "verse": 17,
          "usfm": "1JN.3.17",
          "line_type": "p",
          "text": "آیا ممكن است محبّت خدا در كسی باشد كه از ثروت دنیا بهره‌مند است ولی وقتی برادر خود را می‌بیند، محبّت خود را از او دریغ نماید؟"
        },
        {
          "verse": 18,
          "usfm": "1JN.3.18",
          "line_type": "p",
          "text": "ای فرزندان من، محبّت ما نباید فقط در قالب حرف و تعارف باشد، بلكه باید حقیقی باشد و در عمل دیده شود."
        },
        {
          "verse": 19,
          "usfm": "1JN.3.19",
          "line_type": "p",
          "text": "پس ما می‌دانیم كه تابعین حقیقت هستیم زیرا وجدان ما در پیشگاه خدا به ما اطمینان می‌دهد."
        },
        {
          "verse": 20,
          "usfm": "1JN.3.20",
          "line_type": "p",
          "text": "و اگر هم وجدان ما، ما را محكوم سازد، خدا از وجدان ما بزرگتر است و از همه‌چیز آگاه می‌باشد."
        },
        {
          "verse": 21,
          "usfm": "1JN.3.21",
          "line_type": "p",
          "text": "ای عزیزان، اگر وجدان ما، ما را محكوم نمی‌سازد، ما می‌توانیم با اطمینان به حضور خدا بیاییم"
        },
        {
          "verse": 22,
          "usfm": "1JN.3.22",
          "line_type": "p",
          "text": "و او تمام خواهش‌های ما را برآورده می‌کند زیرا ما بر طبق احكام او عمل می‌کنیم و آنچه را كه پسند اوست بجا می‌آوریم."
        },
        {
          "verse": 23,
          "usfm": "1JN.3.23",
          "line_type": "p",
          "text": "و فرمان او این است كه ما باید به نام پسر او عیسی مسیح ایمان آوریم و یكدیگر را دوست بداریم چنانکه مسیح هم همین دستور را به ما داده است."
        },
        {
          "verse": 24,
          "usfm": "1JN.3.24",
          "line_type": "p",
          "text": "هرکه احكام او را رعایت می‌کند، در خدا زندگی می‌کند و خدا در او. او روح‌القدس را به ما بخشیده است تا ما مطمئن باشیم كه او در ما زندگی می‌کند."
        }
      ],
      "verse_count": 24,
      "headings": [
