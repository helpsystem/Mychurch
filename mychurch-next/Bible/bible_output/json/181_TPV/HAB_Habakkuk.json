    {
      "schema_version": 6,
      "book_id": "HAB",
      "chapter": 2,
      "chapter_usfm": "HAB.2",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAB.2.1",
          "line_type": "p",
          "text": "اکنون از بُرج دیدبانی خود بالا می‌روم و انتظار می‌کشم تا ببینم که خداوند به من چه می‌فرماید و به شکایت من چه پاسخی می‌دهد."
        },
        {
          "verse": 2,
          "usfm": "HAB.2.2",
          "line_type": "p",
          "text": "خداوند به من پاسخ داد: «آنچه را که در رؤیا به تو نشان می‌دهم به طور آشکار و خوانا بر لوحی بنویس تا هرکسی بتواند با یک نگاه آن را بخواند."
        },
        {
          "verse": 3,
          "usfm": "HAB.2.3",
          "line_type": "p",
          "text": "این رؤیا اکنون اتّفاق نمی‌افتد، امّا در وقت معیّن اتّفاق خواهد افتاد و زمان آن بزودی خواهد رسید. آنچه را که به تو نشان می‌دهم حتماً واقع خواهد شد. شاید تا وقوع آن مدّت زیادی طول بکشد، ولی منتظر باش، زیرا وقوع آن حتمی و بدون تأخیر است."
        },
        {
          "verse": 4,
          "usfm": "HAB.2.4",
          "line_type": "p",
          "text": "پیغام این است: مردم بدکار هلاک می‌شوند، امّا شخص نیکو به وسیلهٔ ایمان زندگی خواهد کرد.»"
        },
        {
          "verse": 5,
          "usfm": "HAB.2.5",
          "line_type": "p",
          "text": "ثروت فریبنده است. اشخاص حریص مغرورند و آرامی ندارند. قومها را اسیر کرده آنها را نزد خود جمع می‌کنند و مانند مرگ به کام خود فرو می‌برند و سیر نمی‌شوند."
        },
        {
          "verse": 6,
          "usfm": "HAB.2.6",
          "line_type": "p",
          "text": "اسیران با طعنه و تمسخر به بابلی‌ها می‌گویند: «وای بر شما! زیرا آنچه را که مال شما نیست می‌گیرید و به دارایی خود می‌افزایید؛ تا به کی مردم را مجبور می‌سازید تا بیشتر از آنچه که بدهکار هستند به شما بپردازند؟»"
        },
        {
          "verse": 7,
          "usfm": "HAB.2.7",
          "line_type": "p",
          "text": "آیا کسانی‌که به شما بدهکار هستند ناگهان برنخواهند خاست و شما را به وحشت نخواهند انداخت و شما را غارت نخواهند کرد؟"
        },
        {
          "verse": 8,
          "usfm": "HAB.2.8",
          "line_type": "p",
          "text": "چون شما قومها را غارت کرده‌اید، پس بازماندگان آنها شما را غارت می‌کنند، زیرا شما مرتکب قتل شدید و ظلم و ستم را بر روی زمین رواج دادید و شهرها و ساکنان آنها را از بین بردید."
        },
        {
          "verse": 9,
          "usfm": "HAB.2.9",
          "line_type": "p",
          "text": "وای به حال شما که از راه شرارت برای خود ثروت اندوخته‌اید تا خود و خانواده‌تان در رفاه و آسایش زندگی کنید و از خطر و بلا در امان باشید."
        },
        {
          "verse": 10,
          "usfm": "HAB.2.10",
          "line_type": "p",
          "text": "نقشه‌های شوم شما باعث رسوایی خودتان می‌شوند. شما با نابود کردن مردم، مرگ و نیستی را برای خود می‌آورید."
        },
        {
          "verse": 11,
          "usfm": "HAB.2.11",
          "line_type": "p",
          "text": "حتّی سنگهای دیوار و تیرهای سقف خانه‌تان برضد شما فریاد برمی‌آورند."
        },
        {
          "verse": 12,
          "usfm": "HAB.2.12",
          "line_type": "p",
          "text": "وای بر شما که شهرها و روستاهای خود را با غارت و ریختن خون مردم، می‌سازید."
        },
        {
          "verse": 13,
          "usfm": "HAB.2.13",
          "line_type": "p",
          "text": "قومهایی که آنها را اسیر کردید از دسترنج خود فایده‌ای نبردند. آنها زحمت بی‌فایده کشیدند و همهٔ چیزهایی که ساخته‌اند دود می‌شوند و به هوا می‌روند، زیرا خداوند متعال چنین اراده فرموده است."
        },
        {
          "verse": 14,
          "usfm": "HAB.2.14",
          "line_type": "p",
          "text": "امّا همان‌طور که دریاها پُر از آب می‌باشند، زمین نیز از حکمت و جلال خداوند پر خواهد شد."
        },
        {
          "verse": 15,
          "usfm": "HAB.2.15",
          "line_type": "p",
          "text": "وای بر شما که همسایگان خود را با جام غضب خود مست می‌سازید و بعد، از رسوایی آنها لذّت می‌برید."
        },
        {
          "verse": 16,
          "usfm": "HAB.2.16",
          "line_type": "p",
          "text": "بزودی شکوه و جلال شما به رسوایی تبدیل خواهد شد و از پیالهٔ مجازات خداوند خواهید نوشید و مست شده به زمین خواهید افتاد."
        },
        {
          "verse": 17,
          "usfm": "HAB.2.17",
          "line_type": "p",
          "text": "به‌خاطر ظلمهایی که در لبنان کرده‌اید و حیواناتی را که به وحشت انداختید و هلاک نمودید، اکنون خودتان نابود می‌شوید. به سبب خونهایی که ریخته‌اید و ظلمها‌یی که در شهرهای روی زمین و بر مردم آن کرده‌اید خودتان گرفتار ظلم و ستم می‌گردید."
        },
        {
          "verse": 18,
          "usfm": "HAB.2.18",
          "line_type": "p",
          "text": "از بت چه فایده‌ای به انسان می‌رسد؟ بُتی که انسان آن را بتراشد و بسازد و سپس بر آن توکّل نماید، تنها تمثالی است دروغین که حتّی نمی‌تواند حرف بزند و از آن نمی‌توان چیزی آموخت."
        },
        {
          "verse": 19,
          "usfm": "HAB.2.19",
          "line_type": "p",
          "text": "وای به حال شما که به یک تکه چوب می‌گویید «بیدار شو» و از یک بت بی‌جان می‌خواهید که برخیزد. آیا بت می‌تواند به شما چیزی بیاموزد؟ بُتها از بیرون با نقره و طلا پوشانده شده‌اند، امّا بی‌جان هستند و روحی در آنها نیست."
        },
        {
          "verse": 20,
          "usfm": "HAB.2.20",
          "line_type": "p",
          "text": "امّا خداوند در معبد مقدّس خود است، پس تمام روی زمین در حضور او خاموش باشند."
        }
      ],
