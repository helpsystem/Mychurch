  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2JN",
      "chapter": 1,
      "chapter_usfm": "2JN.1",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2JN.1.1",
          "line_type": "p",
          "text": "از طرف یكی از رهبران كلیسا به آن بانوی برگزیدهٔ خدا و فرزندان او، كه نه تنها من واقعاً آنها را دوست دارم، بلكه همهٔ آنانی كه حقیقت را می‌شناسند."
        },
        {
          "verse": 2,
          "usfm": "2JN.1.2",
          "line_type": "p",
          "text": "زیرا حقیقت در میان ما بوده و هست و تا ابد با ما خواهد بود."
        },
        {
          "verse": 3,
          "usfm": "2JN.1.3",
          "line_type": "p",
          "text": "خدای پدر و عیسی مسیح پسر او، فیض، رحمت و آرامش به ما عنایت فرماید تا این بركات همیشه در حقیقت و محبّت از آن ما باشد."
        },
        {
          "verse": 4,
          "usfm": "2JN.1.4",
          "line_type": "p",
          "text": "وقتی شنیدم كه بعضی از فرزندان تو همان‌طور كه پدر ما فرمان داده است بر طبق حقیقت زندگی می‌کنند، خیلی خوشحال شدم."
        },
        {
          "verse": 5,
          "usfm": "2JN.1.5",
          "line_type": "p",
          "text": "و اكنون ای بانو، خواهشی از تو دارم و آن این است كه به یكدیگر محبّت كنیم. من فرمان تازه‌ای به تو نمی‌دهم، بلكه همان فرمانی است كه از اول شنیدیم."
        },
        {
          "verse": 6,
          "usfm": "2JN.1.6",
          "line_type": "p",
          "text": "منظور من از محبّت این است كه مطابق احكام خدا زندگی كنیم. آری، آن فرمان كه شما از اول شنیدید این است كه باید در محبّت زندگی كنید."
        },
        {
          "verse": 7,
          "usfm": "2JN.1.7",
          "line_type": "p",
          "text": "فریبكاران بسیاری به سرتاسر جهان رفته‌اند، یعنی اشخاصی كه قبول نمی‌کنند، عیسی مسیح در جسم ظاهر شد. اینها فریبكار هستند! اینها «دشمن مسیح» هستند!"
        },
        {
          "verse": 8,
          "usfm": "2JN.1.8",
          "line_type": "p",
          "text": "مواظب باشید مبادا تمام كارهایی را كه ما برای شما کرده‌ایم، باطل سازید. برعکس، ما می‌خواهیم كه شما پاداش خود را کاملاً دریافت كنید."
        },
        {
          "verse": 9,
          "usfm": "2JN.1.9",
          "line_type": "p",
          "text": "هرکه تعالیمش مطابق تعالیم مسیح نیست بلكه چیزهای دیگری را تعلیم می‌دهد، خدا با او نیست. امّا کسانی‌که به تعلیم مسیح وفادار هستند، هم خدای پدر را دارند و هم پسر را."
        },
        {
          "verse": 10,
          "usfm": "2JN.1.10",
          "line_type": "p",
          "text": "اگر كسی نزد شما بیاید و این تعلیم درست را نیاورد، او را در خانهٔ خود نپذیرید و حتّی به او خوش‌آمد هم نگویید،"
        },
        {
          "verse": 11,
          "usfm": "2JN.1.11",
          "line_type": "p",
          "text": "زیرا هرکه به او خوش‌آمد گوید در کارهای شریرانهٔ او همدست شناخته می‌شود."
        },
        {
          "verse": 12,
          "usfm": "2JN.1.12",
          "line_type": "p",
          "text": "اگر چه مطالب بسیاری هست كه باید به شما بنویسم، امّا فكر می‌کنم بهتر است آنها را با قلم و مركب روی كاغذ نیاورم و به جای آن، امیدوارم شما را شخصاً ببینم و روبه‌رو با شما صحبت كنم تا همهٔ ما کاملاً شاد شویم."
        },
        {
          "verse": 13,
          "usfm": "2JN.1.13",
          "line_type": "p",
          "text": "فرزندان خواهر برگزیدهٔ تو سلام می‌رسانند."
        }
      ],
      "verse_count": 13,
      "headings": [
        {
          "before_verse": 4,
          "text": "حقیقت و محبّت"
        },
        {
          "before_verse": 12,
          "text": "خاتمه"
        }
      ],
