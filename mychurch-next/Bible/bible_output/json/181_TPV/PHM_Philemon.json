  "chapters": [
    {
      "schema_version": 6,
      "book_id": "PHM",
      "chapter": 1,
      "chapter_usfm": "PHM.1",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHM.1.1",
          "line_type": "p",
          "text": "از طرف پولس كه به‌خاطر عیسی مسیح زندانی است و تیموتاؤس، برادر ما به دوست و همكار ما فِلیمُون"
        },
        {
          "verse": 2,
          "usfm": "PHM.1.2",
          "line_type": "p",
          "text": "و به كلیسایی كه در خانهٔ تو تشكیل می‌شود و به خواهر ما «بانو اپفیه» و «ارخیپس» همكار ما، این نامه تقدیم می‌گردد."
        },
        {
          "verse": 3,
          "usfm": "PHM.1.3",
          "line_type": "p",
          "text": "پدر ما خدا و عیسی مسیح خداوند، فیض و آرامش به شما عطا فرمایند."
        },
        {
          "verse": 4,
          "usfm": "PHM.1.4",
          "line_type": "p",
          "text": "هروقت كه دعا می‌کنم، نام تو را به زبان می‌آورم و پیوسته خدای خود را شكر می‌کنم"
        },
        {
          "verse": 5,
          "usfm": "PHM.1.5",
          "line_type": "p",
          "text": "چون از محبّت تو و ایمانی كه به عیسی خداوند و جمیع مقدّسین داری آگاه هستم."
        },
        {
          "verse": 6,
          "usfm": "PHM.1.6",
          "line_type": "p",
          "text": "و دعای من این است كه اتّحاد ما با هم در ایمان باعث شود كه دانش ما به همهٔ بركاتی كه در مسیح داریم، افزوده شود."
        },
        {
          "verse": 7,
          "usfm": "PHM.1.7",
          "line_type": "p",
          "text": "ای برادر، محبّت تو برای من شادی عظیم و دلگرمی بسیار پدید آورده است، زیرا دلهای مقدّسین به وسیلهٔ تو، نیرویی تازه گرفته است."
        },
        {
          "verse": 8,
          "usfm": "PHM.1.8",
          "line_type": "p",
          "text": "بنابراین اگرچه من در اتّحاد خود با مسیح حقّ دارم كه جسارت كرده دستور بدهم كه وظایف خود را انجام دهی،"
        },
        {
          "verse": 9,
          "usfm": "PHM.1.9",
          "line_type": "p",
          "text": "امّا به‌خاطر محبّت، صلاح می‌دانم از تو درخواست كنم: من، پولس كه سفیر مسیح عیسی و در حال حاضر به‌خاطر او زندانی هستم،"
        },
        {
          "verse": 10,
          "usfm": "PHM.1.10",
          "line_type": "p",
          "text": "از جانب فرزند خود «اونیسیموس» كه در زمان زندان خود پدر روحانی او شدم، از تو تقاضایی دارم."
        },
        {
          "verse": 11,
          "usfm": "PHM.1.11",
          "line_type": "p",
          "text": "او زمانی برای تو مفید نبود، ولی اكنون هم برای تو و هم برای من مفید است."
        },
        {
          "verse": 12,
          "usfm": "PHM.1.12",
          "line_type": "p",
          "text": "اكنون كه او را نزد تو روانه می‌کنم، مثل این است كه قلب خود را برای تو می‌فرستم."
        },
        {
          "verse": 13,
          "usfm": "PHM.1.13",
          "line_type": "p",
          "text": "خوشحال می‌شدم كه او را نزد خود نگاه دارم تا در این مدّتی كه به‌خاطر انجیل زندانی هستم، او به جای تو مرا خدمت كند."
        },
        {
          "verse": 14,
          "usfm": "PHM.1.14",
          "line_type": "p",
          "text": "امّا بهتر دانستم كه بدون موافقت تو كاری نكنم تا نیكویی تو نه از روی اجبار، بلكه داوطلبانه باشد."
        },
        {
          "verse": 15,
          "usfm": "PHM.1.15",
          "line_type": "p",
          "text": "شاید علّت جدایی موقّت او از تو، این بود كه او را برای همیشه بازیابی!"
        },
        {
          "verse": 16,
          "usfm": "PHM.1.16",
          "line_type": "p",
          "text": "و البتّه نه مثل یک غلام، بلكه بالاتر از آن یعنی به عنوان یک برادر عزیز. او مخصوصاً برای من عزیز است و چقدر بیشتر باید برای تو به عنوان یک انسان و یک برادر مسیحی عزیز باشد."
        },
        {
          "verse": 17,
          "usfm": "PHM.1.17",
          "line_type": "p",
          "text": "پس اگر مرا دوست واقعی خود می‌دانی، همان‌طور كه مرا می‌پذیرفتی او را بپذیر."
        },
        {
          "verse": 18,
          "usfm": "PHM.1.18",
          "line_type": "p",
          "text": "و اگر به تو بدی كرده است یا چیزی به تو بدهكار است آن را به حساب من بگذار."
        },
        {
          "verse": 19,
          "usfm": "PHM.1.19",
          "line_type": "p",
          "text": "من این را با دست خودم می‌نویسم: «من، پولس، آن را به تو پس خواهم داد.» نمی‌گویم كه تو حتّی جان خود را هم به من مدیونی."
        },
        {
          "verse": 20,
          "usfm": "PHM.1.20",
          "line_type": "p",
          "text": "آری، ای برادر، چون در خداوند متّحد هستیم و می‌خواهم از تو بهره‌ای ببینم، به عنوان یک برادر مسیحی به قلب من نیروی تازه‌ای ببخش."
        },
        {
          "verse": 21,
          "usfm": "PHM.1.21",
          "line_type": "p",
          "text": "من با اعتماد به اطاعت تو و با دانستن اینکه آنچه من می‌گویم و حتّی بیشتر از آن را هم انجام خواهی داد، این را به تو می‌نویسم."
        },
        {
          "verse": 22,
          "usfm": "PHM.1.22",
          "line_type": "p",
          "text": "در ضمن اتاقی برای من آماده كن، زیرا امیدوارم كه خدا دعاهای شما را مستجاب كرده، مرا به شما برگرداند."
        },
        {
          "verse": 23,
          "usfm": "PHM.1.23",
          "line_type": "p",
          "text": "«اپفراس» كه به‌خاطر مسیح عیسی با من در زندان است، به تو سلام می‌رساند"
        },
        {
          "verse": 24,
          "usfm": "PHM.1.24",
          "line_type": "p",
          "text": "و همچنین همكاران من «مرقس»، «اَرِسْتَرخُس»، «دیماس» و «لوقا» به تو سلام می‌رسانند."
        },
        {
          "verse": 25,
          "usfm": "PHM.1.25",
          "line_type": "p",
          "text": "فیض عیسی مسیح خداوند با روح شما باد."
        }
      ],
      "verse_count": 25,
      "headings": [
        {
          "before_verse": 4,
          "text": "محبّت و ایمان فِلیمُون"
        },
        {
          "before_verse": 8,
          "text": "تقاضای پولس برای اونیسیموس"
        },
        {
          "before_verse": 23,
          "text": "خاتمه"
        }
      ],
