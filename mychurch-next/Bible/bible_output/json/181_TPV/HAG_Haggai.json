  "chapters": [
    {
      "schema_version": 6,
      "book_id": "HAG",
      "chapter": 1,
      "chapter_usfm": "HAG.1",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAG.1.1",
          "line_type": "p",
          "text": "در روز اولِ ماهِ ششمِ سال دومِ سلطنت داریوش شاهنشاه، خداوند پیامی توسط حجّای نبی برای زروبابل پسر شالتیئیل حاکم یهودا و برای یهوشع پسر یهوصادق کاهن اعظم فرستاد."
        },
        {
          "verse": 2,
          "usfm": "HAG.1.2",
          "line_type": "p",
          "text": "خداوند متعال به حَجّای فرمود: «این مردم می‌گویند که اکنون وقت بازسازی خانهٔ خداوند نیست.»"
        },
        {
          "verse": 3,
          "usfm": "HAG.1.3",
          "line_type": "p",
          "text": "بعد خداوند این پیام را توسط حجّای نبی برای مردم فرستاد:"
        },
        {
          "verse": 4,
          "usfm": "HAG.1.4",
          "line_type": "p",
          "text": "«ای قوم من، چرا شما در خانه‌های زیبا زندگی می‌کنید درحالی‌که معبد بزرگ ویران می‌باشد؟"
        },
        {
          "verse": 5,
          "usfm": "HAG.1.5",
          "line_type": "p",
          "text": "‌به نتیجهٔ کارهایتان توجّه کنید:"
        },
        {
          "verse": 6,
          "usfm": "HAG.1.6",
          "line_type": "p",
          "text": "زیاد می‌کارید، ولی محصولِ کم برمی‌دارید. می‌خورید، امّا سیر نمی‌شوید. می‌نوشید و باز هم تشنگی‌تان رفع نمی‌گردد. لباس‌ می‌پوشید، امّا گرم نمی‌شوید. مزد می‌گیرید امّا گویی آن را در جیبی که سوراخ است می‌گذارید."
        },
        {
          "verse": 7,
          "usfm": "HAG.1.7",
          "line_type": "p",
          "text": "خوب فکر کنید و ببینید که چرا چنین است؟"
        },
        {
          "verse": 8,
          "usfm": "HAG.1.8",
          "line_type": "p",
          "text": "حالا به کوه بروید و چوب بیاورید و خانهٔ مرا بازسازی کنید تا من از دیدن آن خشنود شوم و محترم شمرده شوم."
        },
        {
          "verse": 9,
          "usfm": "HAG.1.9",
          "line_type": "p",
          "text": "«منتظر محصول فراوان بودید، ولی کم به دست آوردید و وقتی‌که آن محصول کم را به خانه آوردید، من آن را برباد دادم. آیا می‌دانید چرا من این کار را کردم؟ به‌خاطر اینکه خانهٔ من ویران مانده و شما مشغول ساختن خانه‌های خود هستید."
        },
        {
          "verse": 10,
          "usfm": "HAG.1.10",
          "line_type": "p",
          "text": "به همین سبب است که باران نمی‌بارد و از زمین چیزی نمی‌روید."
        },
        {
          "verse": 11,
          "usfm": "HAG.1.11",
          "line_type": "p",
          "text": "من خشکسالی را بر زمین، کوهها، مزارع، تاکستانها، باغهای زیتون، سایر محصولات و همچنین انسان و حیوان و تمام حاصل زحمت شما آوردم.»"
        },
        {
          "verse": 12,
          "usfm": "HAG.1.12",
          "line_type": "p",
          "text": "آنگاه زروبابل و یهوشع و تمام کسانی‌که از اسارت در بابل، برگشته بودند از خداوند ترسیدند و دستور خداوند خدای خود را، که توسط حجّای نبی فرستاده شده بود، اطاعت کردند."
        },
        {
          "verse": 13,
          "usfm": "HAG.1.13",
          "line_type": "p",
          "text": "خداوند پیام دیگری توسط حجّای برای مردم فرستاد و فرمود: «من همراه شما هستم.»"
        },
        {
          "verse": 14,
          "usfm": "HAG.1.14",
          "line_type": "p",
          "text": "خداوند متعال در زروبابل، حاکم یهودا، یهوشع، کاهن اعظم و در سایر مردم که از اسارت بازگشته بودند شوق و رغبتی ایجاد کرد تا در معبد بزرگ کار کنند."
        },
        {
          "verse": 15,
          "usfm": "HAG.1.15",
          "line_type": "p",
          "text": "پس در روز بیست و چهارمِ ماه ششمِ سال دومِ سلطنت داریوش، همگی جمع شدند و ساختن معبد بزرگ خداوند، خدایشان را آغاز نمودند."
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 12,
          "text": "اطاعت مردم از فرمان خداوند"
        }
      ],
      "footnotes": [],
