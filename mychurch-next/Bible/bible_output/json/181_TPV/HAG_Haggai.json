    {
      "schema_version": 6,
      "book_id": "HAG",
      "chapter": 2,
      "chapter_usfm": "HAG.2",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAG.2.1",
          "line_type": "p",
          "text": "در روز بیست و یکم ماه هفتم همان سال، خداوند به حجّای نبی فرمود:"
        },
        {
          "verse": 2,
          "usfm": "HAG.2.2",
          "line_type": "p",
          "text": "«از زروبابل، حاکم یهودا و یهوشع، کاهن اعظم بپرس:"
        },
        {
          "verse": 3,
          "usfm": "HAG.2.3",
          "line_type": "p",
          "text": "آیا در بین شما کسی هست که جلال و عظمت معبد بزرگ را، همان‌طور که در سابق بود به یاد آورد؟ آیا آنچه را که اکنون می‌سازید به نظر شما ناچیز نیست؟"
        },
        {
          "verse": 4,
          "usfm": "HAG.2.4",
          "line_type": "p",
          "text": "امّا با این‌همه، ای زروبابل و یهوشع و تمام قوم، مأیوس نشوید و قوی‌دل باشید. به کارتان ادامه دهید، زیرا من همراه شما هستم."
        },
        {
          "verse": 5,
          "usfm": "HAG.2.5",
          "line_type": "p",
          "text": "وقتی از مصر خارج می‌شدید، به شما وعده دادم که روح من همیشه با شما خواهد بود، من هنوز با شما هستم، پس نترسید!"
        },
        {
          "verse": 6,
          "usfm": "HAG.2.6",
          "line_type": "p",
          "text": "«بزودی بار دیگر آسمانها، زمین، دریاها و خشکی را به لرزه می‌آورم."
        },
        {
          "verse": 7,
          "usfm": "HAG.2.7",
          "line_type": "p",
          "text": "تمام اقوام را سرنگون می‌سازم. دارایی و ثروتشان به اینجا آورده می‌شود و این خانه را از شکوه و جلال پُر می‌سازم."
        },
        {
          "verse": 8,
          "usfm": "HAG.2.8",
          "line_type": "p",
          "text": "تمام طلا و نقره دنیا از آن من است."
        },
        {
          "verse": 9,
          "usfm": "HAG.2.9",
          "line_type": "p",
          "text": "این خانه با شکوهتر از سابق می‌شود و در اینجا به قوم خود صلح و سلامتی می‌بخشم.» خداوند متعال این را فرموده است."
        },
        {
          "verse": 10,
          "usfm": "HAG.2.10",
          "line_type": "p",
          "text": "در روز بیست و چهارمِ ماه نهمِ سال دومِ سلطنت داریوش، خداوند بار دیگر به حَجّای نبی فرمود:"
        },
        {
          "verse": 11,
          "usfm": "HAG.2.11",
          "line_type": "p",
          "text": "«از کاهنان بپرس که شریعت به این سؤال چه جواب می‌دهد:"
        },
        {
          "verse": 12,
          "usfm": "HAG.2.12",
          "line_type": "p",
          "text": "اگر کسی گوشت مقدّس را در ردای خود گذاشته، ببرد و چنانچه اگر دامنش با نان، آش، شراب، روغن و یا هر نوع خوراک دیگر تماس پیدا کند، آیا آن خوراک مقدّس می‌شود؟»وقتی حَجّای این سؤال را از کاهنان پرسید، آنها جواب دادند: «نه.»"
        },
        {
          "verse": 13,
          "usfm": "HAG.2.13",
          "line_type": "p",
          "text": "سپس حَجّای پرسید: «امّا اگر کسی با جنازه‌ای تماس پیداکرده ناپاک شده باشد و بعد به یکی از این خوراکها دست بزند، آیا آن خوراک ناپاک می‌شود؟»کاهنان جواب دادند: «بلی، ناپاک می‌شود.»"
        },
        {
          "verse": 14,
          "usfm": "HAG.2.14",
          "line_type": "p",
          "text": "پس حَجّای گفت: «خداوند می‌فرماید که این مردم هم همین‌طور هستند، هر کاری که می‌کنند و هر هدیه‌ای که به این خانه می‌آورند، ناپاک است.»"
        },
        {
          "verse": 15,
          "usfm": "HAG.2.15",
          "line_type": "p",
          "text": "خداوند می‌فرماید: «حالا خوب فکر کنید و ببینید پیش از آنکه به ساختن خانهٔ من شروع کنید،"
        },
        {
          "verse": 16,
          "usfm": "HAG.2.16",
          "line_type": "p",
          "text": "‌ شما در چه وضعی بودید؟ در آن وقت شما توقع داشتید که دو خروار محصول بردارید، امّا تنها یک خروار به دست می‌آوردید و هرگاه می‌خواستید پنجاه لیتر شراب از خمره بکشید، فقط بیست لیتر در آن می‌یافتید."
        },
        {
          "verse": 17,
          "usfm": "HAG.2.17",
          "line_type": "p",
          "text": "‌من حاصل دسترنج شما را با باد سوزان، آفت و تگرگ تباه کردم، امّا شما باز هم توبه نکردید."
        },
        {
          "verse": 18,
          "usfm": "HAG.2.18",
          "line_type": "p",
          "text": "‌ولی از امروز به بعد که روز بیست و چهارم ماه نهم و روزی است که بنیاد خانهٔ من گذاشته شده است، خواهید دید که با شما چه می‌کنم."
        },
        {
          "verse": 19,
          "usfm": "HAG.2.19",
          "line_type": "p",
          "text": "‌هرچند که غلّه‌ای در انبارها باقی نمانده و هنوز تاکها و درختان انجیر، انار و زیتون، میوه نیاورده‌اند، امّا از همین روز شما را برکت می‌دهم.»"
        },
        {
          "verse": 20,
          "usfm": "HAG.2.20",
          "line_type": "p",
          "text": "در همان روز بیست و چهارم ماه، بار دیگر این پیام از جانب خداوند برای حَجّای آمد:"
        },
        {
          "verse": 21,
          "usfm": "HAG.2.21",
          "line_type": "p",
          "text": "«به زروبابل، حاکم یهودا بگو که بزودی آسمانها و زمین را به لرزه می‌آورم."
        },
        {
          "verse": 22,
          "usfm": "HAG.2.22",
          "line_type": "p",
          "text": "تختهای پادشاهان را واژگون می‌کنم. قدرت فرمانروایان را با ارّابه و سوارانشان از بین می‌برم و اسبان و سواران آنها یکدیگر را با شمشیرهای خود می‌کشند."
        },
        {
          "verse": 23,
          "usfm": "HAG.2.23",
          "line_type": "p",
          "text": "در آن روز، ای زروبابل، پسر شالتیئیل، بندهٔ من، تو مانند نگین انگشتر من خواهی بود، زیرا که من تو را برگزیده‌ام.» این قول خداوند متعال است."
        }
      ],
      "verse_count": 23,
      "headings": [
        {
          "before_verse": 10,
          "text": "مشورت حجّای به کاهنان"
        },
        {
          "before_verse": 15,
          "text": "وعدهٔ برکت"
        },
        {
          "before_verse": 20,
          "text": "وعدهٔ خداوند به زروبابل"
        }
      ],
