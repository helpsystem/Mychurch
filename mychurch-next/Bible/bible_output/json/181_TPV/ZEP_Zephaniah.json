  "chapters": [
    {
      "schema_version": 6,
      "book_id": "ZEP",
      "chapter": 1,
      "chapter_usfm": "ZEP.1",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "ZEP.1.1",
          "line_type": "p",
          "text": "خداوند این پیام را در دوران سلطنت یوشیا پسر آمون، پادشاه یهودا، به صَفَنیا داد. صَفَنیا پسر کوشی، پسر جدلیا، پسر امریا و امریا پسر حزقیا پادشاه بود."
        },
        {
          "verse": 2,
          "usfm": "ZEP.1.2",
          "line_type": "p",
          "text": "خداوند می‌فرماید: «من همه ‌چیز را از روی زمین نابود می‌سازم."
        },
        {
          "verse": 3,
          "usfm": "ZEP.1.3",
          "line_type": "p",
          "text": "تمام انسانها، حیوانات، پرندگان و ماهیان را از بین می‌برم. به زندگی مردم شریر خاتمه می‌دهم، همهٔ بشر را محو می‌کنم و حتّی یک نفر را هم زنده نمی‌گذارم."
        },
        {
          "verse": 4,
          "usfm": "ZEP.1.4",
          "line_type": "p",
          "text": "«مردم اورشلیم و یهودا را به سزای کارهایشان می‌رسانم و آثار بت بعل و نام کاهنان بت‌پرست را محو می‌سازم."
        },
        {
          "verse": 5,
          "usfm": "ZEP.1.5",
          "line_type": "p",
          "text": "آنهایی را که بر بامها، آفتاب و ماه و ستارگان را می‌پرستند و نیز کسانی ‌را که در ظاهر مرا می‌پرستند و به من سوگند وفاداری یاد می‌کنند، امّا به نام بت مولِک قسم می‌خورند، هلاک می‌کنم."
        },
        {
          "verse": 6,
          "usfm": "ZEP.1.6",
          "line_type": "p",
          "text": "آنهایی را که از پیروی من دست کشیده‌اند و آن اشخاصی را که طالب من نیستند و از من راهنمایی نمی‌خواهند، نابود می‌سازم.»"
        },
        {
          "verse": 7,
          "usfm": "ZEP.1.7",
          "line_type": "p",
          "text": "روز داوری خداوند نزدیک است، پس در حضور او خاموش باشید! خداوند قوم خود را برای قربانی آماده کرده و از دشمنان دعوت نموده است که یهودا را غارت کنند."
        },
        {
          "verse": 8,
          "usfm": "ZEP.1.8",
          "line_type": "p",
          "text": "خداوند می‌فرماید: «در آن روزِ جزا رهبران، شاهزادگان و همچنین کسانی را که از راه و رسم بیگانگان پیروی می‌کنند، به سزای کارهایشان می‌رسانم."
        },
        {
          "verse": 9,
          "usfm": "ZEP.1.9",
          "line_type": "p",
          "text": "آن اشخاصی را که مانند کافران دست به دزدی و آدمکشی می‌زنند تا پرستشگاههای خدایان خود را از مال دزدی پُر سازند، مجازات می‌کنم.»"
        },
        {
          "verse": 10,
          "usfm": "ZEP.1.10",
          "line_type": "p",
          "text": "خداوند می‌فرماید: «در آن روز صدای فریاد از دروازهٔ ماهی در اورشلیم شنیده می‌شود و صدای ناله از قسمت جدید شهر و صدای ولوله از تپّه‌ها به گوش می‌رسد."
        },
        {
          "verse": 11,
          "usfm": "ZEP.1.11",
          "line_type": "p",
          "text": "ای مردم بازار، فریاد و شیون کنید، زیرا همهٔ تاجران از بین رفته‌اند."
        },
        {
          "verse": 12,
          "usfm": "ZEP.1.12",
          "line_type": "p",
          "text": "«در آن روز چراغی گرفته، اورشلیم را تفتیش می‌کنم و اشخاص خودپرست را که می‌گویند: 'خداوند با ما کاری ندارد.' مجازات می‌کنم."
        },
        {
          "verse": 13,
          "usfm": "ZEP.1.13",
          "line_type": "p",
          "text": "مال و دارائیشان تاراج و خانه‌هایشان ویران می‌شود. خانه‌ها می‌سازند، امّا در آنها ساکن نخواهند شد. تاکستانها غرس می‌کنند، ولی هرگز از شراب آنها نخواهند نوشید.»"
        },
        {
          "verse": 14,
          "usfm": "ZEP.1.14",
          "line_type": "p",
          "text": "آن روز عظیم خداوند نزدیک است و بزودی فرا می‌رسد. در آن روز حتّی شجاعترین و قویترین مردان به تلخی خواهند گریست."
        },
        {
          "verse": 15,
          "usfm": "ZEP.1.15",
          "line_type": "p",
          "text": "آن روز، روز غضب خداوند است. روز سختی و اضطراب، روز تاریکی و ظلمت، روز سیاه و ابرهای غلیظ است."
        },
        {
          "verse": 16,
          "usfm": "ZEP.1.16",
          "line_type": "p",
          "text": "روزی که شیپور نواخته می‌شود و علیه شهرهای مستحکم و بُرجهای بلند، جنگ آغاز می‌گردد."
        },
        {
          "verse": 17,
          "usfm": "ZEP.1.17",
          "line_type": "p",
          "text": "خداوند می‌فرماید: «مردم را چنان پریشان و درمانده می‌سازم که مانند شخص کور نتوانند راه خود را پیدا کنند، آنها در برابر من گناه کرده‌اند و اکنون خونشان مانند آب بر خاک می‌ریزد و اجسادشان به روی زمین خواهد گندید.»"
        },
        {
          "verse": 18,
          "usfm": "ZEP.1.18",
          "line_type": "p",
          "text": "روزی که خداوند خشم خود را نشان دهد، طلا و نقرهٔ آنها نمی‌تواند ایشان را نجات بدهد. تمامی زمین در آتش خشم او می‌سوزد و همهٔ ساکنان روی زمین با مرگ ناگهانی از بین می‌روند."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 2,
          "text": "روز داوری خداوند"
        }
      ],
