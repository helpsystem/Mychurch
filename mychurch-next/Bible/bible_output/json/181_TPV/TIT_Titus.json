    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 2,
      "chapter_usfm": "TIT.2",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.2.1",
          "line_type": "p",
          "text": "امّا تو، مطالبی را كه مطابق تعالیم صحیح است به آنها بگو."
        },
        {
          "verse": 2,
          "usfm": "TIT.2.2",
          "line_type": "p",
          "text": "به پیرمردان دستور بده كه باوقار، سنگین، روشن‌بین و در ایمان، محبّت و پایداری سالم و قوی باشند."
        },
        {
          "verse": 3,
          "usfm": "TIT.2.3",
          "line_type": "p",
          "text": "همچنین به پیرزنها دستور بده كه رفتاری خداپسندانه داشته باشند و تهمت نزنند و اسیر شراب نباشند؛ بلكه آنچه را كه نیكوست تعلیم دهند."
        },
        {
          "verse": 4,
          "usfm": "TIT.2.4",
          "line_type": "p",
          "text": "تا زنهای جوان را تربیت كنند كه شوهر و فرزندانشان را دوست بدارند."
        },
        {
          "verse": 5,
          "usfm": "TIT.2.5",
          "line_type": "p",
          "text": "و روشن‌بین، پاکدامن، خانه‌دار، مهربان و مطیع شوهرانشان باشند تا هیچ‌كس از پیام خدا بدگویی نكند."
        },
        {
          "verse": 6,
          "usfm": "TIT.2.6",
          "line_type": "p",
          "text": "همچنین به مردان جوان اصرار كن كه روشن‌بین باشند."
        },
        {
          "verse": 7,
          "usfm": "TIT.2.7",
          "line_type": "p",
          "text": "زندگی تو در هر مورد باید نمونه‌ای از کارهای نیک باشد و در تعلیم خود صمیمی و باوفا باش."
        },
        {
          "verse": 8,
          "usfm": "TIT.2.8",
          "line_type": "p",
          "text": "طوری سخن بگو كه مورد ایراد واقع نشوی تا دشمنان ما از اینکه دلیلی برای بدگویی از ما نمی‌یابند، شرمسار گردند."
        },
        {
          "verse": 9,
          "usfm": "TIT.2.9",
          "line_type": "p",
          "text": "به غلامان بگو كه در هر امر مطیع اربابان خود باشند و بدون جرّ و بحث، ایشان را راضی سازند"
        },
        {
          "verse": 10,
          "usfm": "TIT.2.10",
          "line_type": "p",
          "text": "و دزدی نكنند بلكه کاملاً امین باشند تا با کارهای نیكوی خود بتوانند به شهرت و جلال كلام نجات‌دهندهٔ ما خدا، بیافزایند."
        },
        {
          "verse": 11,
          "usfm": "TIT.2.11",
          "line_type": "p",
          "text": "زیرا فیض خدا ظاهر شده و نجات را در برابر همه قرار داده است"
        },
        {
          "verse": 12,
          "usfm": "TIT.2.12",
          "line_type": "p",
          "text": "و به ما می‌آموزد كه راههای شرارت‌آمیز و شهوات دنیوی را ترک كرده و با روشن‌بینی، عدالت و خداترسی در این جهان زندگی كنیم."
        },
        {
          "verse": 13,
          "usfm": "TIT.2.13",
          "line_type": "p",
          "text": "و در عین حال، در انتظار امید متبارک خود، یعنی ظهور پرشكوه خدای بزرگ و نجات‌دهندهٔ ما عیسی مسیح باشیم."
        },
        {
          "verse": 14,
          "usfm": "TIT.2.14",
          "line_type": "p",
          "text": "او جان خود را در راه ما داد تا ما را از هرگونه شرارت آزاد سازد و ما را قومی پاک بگرداند كه فقط به خودش تعلّق داشته و مشتاق نیكوكاری باشیم."
        },
        {
          "verse": 15,
          "usfm": "TIT.2.15",
          "line_type": "p",
          "text": "دربارهٔ این مطالب سخن بگو و وقتی شنوندگانت را دلگرم می‌سازی و یا سرزنش می‌کنی، از تمام اختیارات خود استفاده كن. اجازه نده كسی تو را حقیر شمارد."
        }
      ],
