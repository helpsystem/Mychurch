  "chapters": [
    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 1,
      "chapter_usfm": "TIT.1",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.1.1",
          "line_type": "p",
          "text": "این نامه از طرف پولس، بندهٔ خدا و رسول عیسی مسیح است. من مأموریت یافتم كه ایمان برگزیدگان خدا را تقویت كنم و حقیقتی را كه با خداشناسی سازگار است، بیان نمایم."
        },
        {
          "verse": 2,
          "usfm": "TIT.1.2",
          "line_type": "p",
          "text": "این حقیقت بر اساس امید به حیات جاودانی است. خدا كه هرگز دروغ نمی‌گوید، در ازل وعدهٔ آن حیات را به ما داد"
        },
        {
          "verse": 3,
          "usfm": "TIT.1.3",
          "line_type": "p",
          "text": "و در زمان معیّن، آن وعده در پیامی که اعلام آن به دستور نجات‌دهندهٔ ما خدا، به من سپرده شد، آشكار شد."
        },
        {
          "verse": 4,
          "usfm": "TIT.1.4",
          "line_type": "p",
          "text": "به تیطُس فرزند حقیقی‏‌ام كه هردوی ما در یک ایمان مشتركیم، خدای پدر و مسیح عیسی نجات‌دهندهٔ ما، به تو فیض و آرامش عطا فرماید."
        },
        {
          "verse": 5,
          "usfm": "TIT.1.5",
          "line_type": "p",
          "text": "تو را برای این در جزیره كریت گذاشتم تا كارهای عقب افتاده را سر و سامان دهی و چنانکه شخصاً به تو دستور دادم، رهبرانی برای كلیساها در هر شهر بگماری."
        },
        {
          "verse": 6,
          "usfm": "TIT.1.6",
          "line_type": "p",
          "text": "رهبران باید اشخاصی بی‌عیب و بی‌آلایش و صاحب یک زن و دارای فرزندان با ایمانی باشند كه نتوان آنها را به هرزگی و سركشی متّهم ساخت."
        },
        {
          "verse": 7,
          "usfm": "TIT.1.7",
          "line_type": "p",
          "text": "زیرا سرپرست كلیسا چون مسئول كار خداست باید بی‌عیب باشد، نه خودخواه، نه تندخو، نه مست باده، نه جنگجو و نه پول‌پرست."
        },
        {
          "verse": 8,
          "usfm": "TIT.1.8",
          "line_type": "p",
          "text": "بلكه باید مهمان‌‌نواز، نیكخواه، روشن‌بین، عادل، پاک و خویشتن‌دار باشد."
        },
        {
          "verse": 9,
          "usfm": "TIT.1.9",
          "line_type": "p",
          "text": "باید به پیامی كه قابل اعتماد و با تعالیم صحیح سازگار است، محكم بچسبد تا بتواند اطرافیان را با تعلیمی درست تشویق كرده و مخالفان را مُجاب سازد."
        },
        {
          "verse": 10,
          "usfm": "TIT.1.10",
          "line_type": "p",
          "text": "زیرا افراد سركش، یاوه‌سرا و گمراه‌كننده بسیارند. این افراد مخصوصاً در بین تازه‌‌ ایمانان یهودی نژاد پیدا می‌شوند."
        },
        {
          "verse": 11,
          "usfm": "TIT.1.11",
          "line_type": "p",
          "text": "لازم است كه جلوی دهان آنها را گرفت، زیرا به‌خاطر تحصیل سودهای ننگ‌آور، با تعلیم چیزهایی که نباید آنها را تعلیم داد، خانواده‌‌ها را تماماً برمی‌‌اندازند."
        },
        {
          "verse": 12,
          "usfm": "TIT.1.12",
          "line_type": "p",
          "text": "یكی از انبیای كریتی كه یک نفر از خود آنهاست گفت: «اهالی كریت همیشه دروغگو و حیوانهای پلید، پرخور و تنبلی هستند.»"
        },
        {
          "verse": 13,
          "usfm": "TIT.1.13",
          "line_type": "p",
          "text": "این درست است. به این دلیل آنها را سخت سرزنش كن تا در ایمان سالم باشند"
        },
        {
          "verse": 14,
          "usfm": "TIT.1.14",
          "line_type": "p",
          "text": "و به افسانه‌های یهود و احكام مردمانی كه حقیقت را رد کرده‌اند، گوش ندهند."
        },
        {
          "verse": 15,
          "usfm": "TIT.1.15",
          "line_type": "p",
          "text": "برای پاكان همه‌چیز پاک است، امّا برای کسانی‌که آلوده و بی‌ایمان هستند، هیچ چیز پاک نیست. زیرا هم افكارشان و هم وجدانشان آلوده است."
        },
        {
          "verse": 16,
          "usfm": "TIT.1.16",
          "line_type": "p",
          "text": "ادّعا دارند كه خدا را می‌شناسند، امّا کارهایشان این ادّعا را تكذیب می‌کند. آنها نفرت‌انگیز و نافرمانند و برای انجام كار نیک کاملاً بی‌فایده هستند."
        }
      ],
      "verse_count": 16,
      "headings": [
        {
          "before_verse": 5,
          "text": "كار تیطُس در كریت"
        },
        {
          "before_verse": 10,
          "text": "معلّمین گمراه كننده"
        }
      ],
