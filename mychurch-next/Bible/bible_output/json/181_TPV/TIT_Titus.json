    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 3,
      "chapter_usfm": "TIT.3",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.3.1",
          "line_type": "p",
          "text": "به آنها خاطرنشان ساز كه مطیع حكمرانان و اولیای امور بوده و از آنها اطاعت كنند و برای انجام هرگونه نیكوكاری آماده باشند."
        },
        {
          "verse": 2,
          "usfm": "TIT.3.2",
          "line_type": "p",
          "text": "به آنها بگو كه از هیچ‌کس بدگویی نكنند و از مجادله دوری جسته، ملایم و آرام باشند. با تمام مردم کاملاً مؤدّب باشند،"
        },
        {
          "verse": 3,
          "usfm": "TIT.3.3",
          "line_type": "p",
          "text": "زیرا خود ما هم زمانی نادان و نافرمان و گمراه و بردگان انواع شهوات و عیّاشی بودیم و روزهای خود را به كینه‌جویی و حسادت می‌گذرانیدیم. دیگران از ما نفرت داشتند و ما از آنها متنفّر بودیم."
        },
        {
          "verse": 4,
          "usfm": "TIT.3.4",
          "line_type": "p",
          "text": "امّا هنگامی‌كه مهر و محبّت نجات‌دهندهٔ ما خدا، آشكار شد،"
        },
        {
          "verse": 5,
          "usfm": "TIT.3.5",
          "line_type": "p",
          "text": "او ما را نجات داد. امّا این نجات به‌خاطر کارهای نیكویی كه ما كردیم نبود، بلكه به سبب رحمت او و از راه شستشویی بود كه به وسیلهٔ آن، روح‌القدس به ما تولّد تازه و حیات تازه بخشید."
        },
        {
          "verse": 6,
          "usfm": "TIT.3.6",
          "line_type": "p",
          "text": "زیرا خدا روح‌القدس را به وسیلهٔ عیسی مسیح نجات‌دهندهٔ ما، به فراوانی به ما عطا فرمود"
        },
        {
          "verse": 7,
          "usfm": "TIT.3.7",
          "line_type": "p",
          "text": "تا به وسیلهٔ فیض او کاملاً نیک محسوب شده و مطابق امید خود، وارث حیات جاودانی گردیم."
        },
        {
          "verse": 8,
          "usfm": "TIT.3.8",
          "line_type": "p",
          "text": "این سخن درست است و می‌خواهم به این مطلب اهمیّت مخصوصی بدهی تا آنانی كه به خدا ایمان دارند فراموش نكنند كه خود را وقف نیكوكاری نمایند، زیرا این چیزها برای آدمیان خوب و مفیدند."
        },
        {
          "verse": 9,
          "usfm": "TIT.3.9",
          "line_type": "p",
          "text": "امّا از مباحثات احمقانه دربارهٔ شجره‌نامه‌ها و اختلافات و نزاعها بر سر شریعت دوری كن، زیرا اینها بیهوده و بی‌ارزش هستند."
        },
        {
          "verse": 10,
          "usfm": "TIT.3.10",
          "line_type": "p",
          "text": "اگر شخصی ستیزه‌جو باشد، یكی دو بار به او گوشزد كن و بعد از آن، دیگر كاری با او نداشته باش."
        },
        {
          "verse": 11,
          "usfm": "TIT.3.11",
          "line_type": "p",
          "text": "چون می‌دانی كه چنین شخصی منحرف شده و گناهانش نشان می‌دهند كه او خود را محكوم كرده است."
        },
        {
          "verse": 12,
          "usfm": "TIT.3.12",
          "line_type": "p",
          "text": "هروقت كه «ارتیماس» یا «تخیكاس» را نزد تو فرستادم، عجله كن كه به شهر «نیكوپولیس» نزد من بیایی، زیرا تصمیم گرفته‌ام زمستان را در آنجا بگذرانم."
        },
        {
          "verse": 13,
          "usfm": "TIT.3.13",
          "line_type": "p",
          "text": "و تا می‌توانی به «زیناس وكیل» و «اپلس» كمک كن تا به سفر خود ادامه دهند و مواظب باش كه به چیزی محتاج نشوند."
        },
        {
          "verse": 14,
          "usfm": "TIT.3.14",
          "line_type": "p",
          "text": "اعضای كلیساهای ما باید یاد بگیرند كه چگونه خود را وقف نیكوكاری نمایند تا بتوانند نیازمندیهای واقعی مردم را رفع كنند و زندگی آنها بی‌ثمر نباشد."
        },
        {
          "verse": 15,
          "usfm": "TIT.3.15",
          "line_type": "p",
          "text": "تمام کسانی‌که با من هستند به تو سلام می‌رسانند. به دوستانی كه با ما در ایمان متّحد هستند، سلام برسان. فیض خدا با همه شما باد."
        }
      ],
