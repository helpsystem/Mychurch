  "chapters": [
    {
      "schema_version": 6,
      "book_id": "3JN",
      "chapter": 1,
      "chapter_usfm": "3JN.1",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "3JN.1.1",
          "line_type": "p",
          "text": "از طرف یكی از رهبران كلیسا به «غایوس» عزیز كه واقعاً دوستش دارم."
        },
        {
          "verse": 2,
          "usfm": "3JN.1.2",
          "line_type": "p",
          "text": "ای عزیز، دعا می‌کنم كه روزگار بر وفق مراد تو باشد و همان‌طور كه در روح سالم هستی، از سلامتی بدن نیز برخوردار باشی."
        },
        {
          "verse": 3,
          "usfm": "3JN.1.3",
          "line_type": "p",
          "text": "وقتی بعضی از ایمانداران به اینجا آمدند و به من خبر دادند كه تو چقدر به حقیقت الهی وفادار هستی، یعنی چگونه مطابق حقیقت رفتار می‌کنی، خیلی خوشحال شدم."
        },
        {
          "verse": 4,
          "usfm": "3JN.1.4",
          "line_type": "p",
          "text": "هیچ چیز بیش از این مرا خوشحال نمی‌سازد كه بشنوم فرزندان من بر طبق حقیقت رفتار می‌کنند."
        },
        {
          "verse": 5,
          "usfm": "3JN.1.5",
          "line_type": "p",
          "text": "ای عزیز، از تمام كارهایی كه برای این ایمانداران انجام می‌دهی، هرچند آنها را نمی‌شناسی، معلوم می‌شود که با وفاداری كار می‌کنی."
        },
        {
          "verse": 6,
          "usfm": "3JN.1.6",
          "line_type": "p",
          "text": "آنها برای كلیسای اینجا از مهربانی تو تعریف کرده‌اند. اگر به طور خداپسندانه به آنها كمک كنی تا سفر خود را ادامه دهند، كاری نیكو کرده‌ای."
        },
        {
          "verse": 7,
          "usfm": "3JN.1.7",
          "line_type": "p",
          "text": "زیرا آنها این سفر را به عنوان خدمتی به مسیح شروع کرده‌اند و از غیر مسیحیان كمک قبول نمی‌کنند."
        },
        {
          "verse": 8,
          "usfm": "3JN.1.8",
          "line_type": "p",
          "text": "پس ما مسیحیان موظّفیم، با پذیرایی از چنین اشخاص در انتشار حقیقت همكاری كنیم."
        },
        {
          "verse": 9,
          "usfm": "3JN.1.9",
          "line_type": "p",
          "text": "من نامه‌ای مختصر به كلیسا نوشتم، امّا «دیوترفس» كه همیشه دوست دارد خود را جلو بیندازد و سخنان ما را قبول نمی‌کند."
        },
        {
          "verse": 10,
          "usfm": "3JN.1.10",
          "line_type": "p",
          "text": "وقتی بیایم كلیسا را از تمام كارهایی كه او كرده و تمام اتّهامات بی‌اساس و نادرستی که به ما زده است، مطّلع خواهم ساخت. او به این كارها اكتفا نكرده بلكه ایمانداران را نیز به خانهٔ خود راه نمی‌دهد و مانع می‌شود كه دیگران نیز از آنها پذیرایی كنند و اگر بعضی‌ها چنین كنند، او آنان را از كلیسا بیرون می‌کند."
        },
        {
          "verse": 11,
          "usfm": "3JN.1.11",
          "line_type": "p",
          "text": "ای دوست عزیز، نیكویی را دنبال كن نه بدی را. شخص نیكوكار فرزند خداست، بدكار هرگز خدا را ندیده است."
        },
        {
          "verse": 12,
          "usfm": "3JN.1.12",
          "line_type": "p",
          "text": "همه از «دیمیتریوس» به نیكی سخن می‌گویند -‌حقیقت هم همین است- و ما نیز گفتار آنها را تأیید می‌کنیم و تو می‌دانی كه شهادت ما قابل اعتماد است."
        },
        {
          "verse": 13,
          "usfm": "3JN.1.13",
          "line_type": "p",
          "text": "مطالب زیادی هست كه باید برای تو بنویسم، امّا نمی‌خواهم آن را با قلم و مركب روی كاغذ بیاورم."
        },
        {
          "verse": 14,
          "usfm": "3JN.1.14",
          "line_type": "p",
          "text": "امیدوارم تو را خیلی زود ببینم و روبه‌رو با هم صحبت كنیم."
        },
        {
          "verse": 15,
          "usfm": "3JN.1.15",
          "line_type": "p",
          "text": "صلح و آرامش از آن تو باد. دوستانت سلام می‌رسانند، به یکایک دوستان ما سلام برسان."
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 5,
          "text": "همكاری و مخالفت"
        },
        {
          "before_verse": 13,
          "text": "خاتمه"
        }
      ],
