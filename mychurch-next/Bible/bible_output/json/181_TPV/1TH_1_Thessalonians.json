    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 3,
      "chapter_usfm": "1TH.3",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.3.1",
          "line_type": "p",
          "text": "پس چون دیگر نمی‌توانستیم بی‌خبری را تحمّل كنیم، تصمیم گرفتیم كه در شهر آتن تنها بمانیم"
        },
        {
          "verse": 2,
          "usfm": "1TH.3.2",
          "line_type": "p",
          "text": "و تیموتاؤس برادر ما و خادم خدا در انتشار انجیل مسیح را فرستادیم تا شما را در ایمانتان تقویت نماید و دلداری دهد،"
        },
        {
          "verse": 3,
          "usfm": "1TH.3.3",
          "line_type": "p",
          "text": "تا هیچ‌کس در اثر این زجر و آزارها دلسرد نشود. خودتان می‌دانید كه این آزارها نصیب و قسمت ماست."
        },
        {
          "verse": 4,
          "usfm": "1TH.3.4",
          "line_type": "p",
          "text": "وقتی ما با شما بودیم، از پیش به شما گفتیم كه زجر و آزار در انتظار ماست و چنانکه آگاه هستید همان‌طور هم شده است."
        },
        {
          "verse": 5,
          "usfm": "1TH.3.5",
          "line_type": "p",
          "text": "از این جهت چون این بی‌خبری، دیگر برای من غیر قابل تحمّل بود، تیموتاؤس را نزد شما فرستادم تا از ایمان شما آگاه شوم، زیرا می‌ترسیدم آن اغوا‌كننده یعنی شیطان شما را به نوعی وسوسه كرده و زحمات ما بی‌نتیجه مانده باشد."
        },
        {
          "verse": 6,
          "usfm": "1TH.3.6",
          "line_type": "p",
          "text": "امّا اكنون كه تیموتاؤس از نزد شما بازگشته است، خبر خوشی دربارهٔ ایمان و محبّت شما به ما داده است و گزارش می‌دهد كه شما با چه لطفی همواره ما را به‌یاد می‌آورید و همان‌گونه كه ما برای دیدن شما اشتیاق داریم، شما هم مشتاق دیدار ما هستید."
        },
        {
          "verse": 7,
          "usfm": "1TH.3.7",
          "line_type": "p",
          "text": "ای برادران، با وجود همهٔ نگرانی‌ها و زحماتی كه داریم، این خبر ما را دلداری داده است. بلی، ایمان شما سبب دلداری ما گشته است."
        },
        {
          "verse": 8,
          "usfm": "1TH.3.8",
          "line_type": "p",
          "text": "اگر شما در اتّحاد با خداوند استوار بمانید، ما زندگی تازه‌ای خواهیم داشت."
        },
        {
          "verse": 9,
          "usfm": "1TH.3.9",
          "line_type": "p",
          "text": "ما چطور می‌توانیم به قدر كفایت، خدا را برای شما و برای تمام شادی‌ای كه به‌خاطر شما در پیشگاه خدا احساس می‌كنیم، سپاسگزاری كنیم؟"
        },
        {
          "verse": 10,
          "usfm": "1TH.3.10",
          "line_type": "p",
          "text": "شب و روز با التماس دعا می‌كنیم كه روی شما را ببینیم و نواقص ایمان شما را برطرف سازیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.3.11",
          "line_type": "p",
          "text": "خدای پدر و عیسی مسیح خداوند ما، راه ما را به سوی شما بگشاید!"
        },
        {
          "verse": 12,
          "usfm": "1TH.3.12",
          "line_type": "p",
          "text": "و خداوند عطا فرماید كه به اندازهٔ محبّتی كه ما برای شما داریم، محبّت شما برای یكدیگر و همهٔ مردم افزایش و گسترش یابد؛"
        },
        {
          "verse": 13,
          "usfm": "1TH.3.13",
          "line_type": "p",
          "text": "و خدا دلهای شما را قوی گرداند تا در آن هنگام كه خداوند ما عیسی با همهٔ مقدّسین خود می‌‌آید، شما در حضور خدای پدر پاک و بی‌عیب باشید."
        }
      ],
