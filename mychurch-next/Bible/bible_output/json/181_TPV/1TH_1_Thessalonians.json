  "chapters": [
    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 1,
      "chapter_usfm": "1TH.1",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.1.1",
          "line_type": "p",
          "text": "از طرف پولس و سیلوانس و تیموتاؤس به كلیسای تسالونیكیان كه به خدای پدر و عیسی مسیح خداوند تعلّق دارد، فیض و آرامش از آن شما باد."
        },
        {
          "verse": 2,
          "usfm": "1TH.1.2",
          "line_type": "p",
          "text": "ما همیشه خدا را به‌خاطر همهٔ شما شكر می‌کنیم و همواره شما را در دعاهای خود ذكر می‌نماییم."
        },
        {
          "verse": 3,
          "usfm": "1TH.1.3",
          "line_type": "p",
          "text": "زیرا در حضور خدا كه پدر ماست به‌یاد می‌آوریم كه چگونه ایمانتان در فعالیّت‌ها و محبّتتان در كارها و امیدتان به خداوند ما عیسی مسیح پایدار است."
        },
        {
          "verse": 4,
          "usfm": "1TH.1.4",
          "line_type": "p",
          "text": "ای برادران، ما می‌دانیم كه خدا شما را دوست دارد و شما را برگزیده است."
        },
        {
          "verse": 5,
          "usfm": "1TH.1.5",
          "line_type": "p",
          "text": "زیرا ما انجیل را تنها در قالب كلمات نزد شما نیاوردیم، بلكه با قدرت روح‌القدس و اطمینان كامل به حقانیّت آن، و شما می‌دانید وقتی با شما بودیم چگونه رفتار كردیم و آن برای خیریّت شما بود."
        },
        {
          "verse": 6,
          "usfm": "1TH.1.6",
          "line_type": "p",
          "text": "شما از سرمشق ما و خداوند پیروی كردید و اگرچه به‌خاطر پیام خدا رنج بسیار دیدید، آن را با خوشی‌ای كه روح‌القدس می‌دهد، پذیرفتید."
        },
        {
          "verse": 7,
          "usfm": "1TH.1.7",
          "line_type": "p",
          "text": "تا آنجا كه شما برای همهٔ ایمانداران در مقدونیه و یونان نمونه شدید."
        },
        {
          "verse": 8,
          "usfm": "1TH.1.8",
          "line_type": "p",
          "text": "زیرا پیام خداوند نه تنها از جانب شما تا مقدونیه و یونان انتشار یافت، بلكه خبر ایمانتان به خدا به همه‌جا رفته است. پس دیگر احتیاجی نیست كه ما آن را بازگو كنیم."
        },
        {
          "verse": 9,
          "usfm": "1TH.1.9",
          "line_type": "p",
          "text": "زیرا خود آنها حُسن استقبالی را كه شما از ما به عمل آوردید، بیان می‌کنند و تعریف می‌کنند كه چگونه شما بُتها را ترک كرده به سوی خداوند بازگشت نمودید تا خدای زنده و حقیقی را خدمت كنید"
        },
        {
          "verse": 10,
          "usfm": "1TH.1.10",
          "line_type": "p",
          "text": "و چگونه در انتظار ظهور پسر او عیسی كه از آسمان می‌آید به‌ سر می‌برید. آری، همان عیسی كه خدا او را پس از مرگ زنده ساخت، ما را از غضب آینده رهایی می‌بخشد."
        }
      ],
      "verse_count": 10,
      "headings": [
        {
          "before_verse": 2,
          "text": "زندگی و ایمان تسالونیکیان"
        }
      ],
      "footnotes": [
        {
          "verse": 4,
          "usfm": "1TH.1.4",
          "note_ref": "",
          "note_type": "footnote",
          "references": [],
          "text": "روی سخن در آیه با ایمانداران است."
        }
      ],
