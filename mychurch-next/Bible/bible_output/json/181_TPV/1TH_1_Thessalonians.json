    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 2,
      "chapter_usfm": "1TH.2",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.2.1",
          "line_type": "p",
          "text": "خود شما ای برادران می‌دانید كه آمدن ما به نزد شما بی‌نتیجه نبود."
        },
        {
          "verse": 2,
          "usfm": "1TH.2.2",
          "line_type": "p",
          "text": "برعکس، پس از آن‌همه بدرفتاری و اهانت كه در شهر فیلیپی دیدیم (چنانکه اطّلاع دارید) و با وجود مخالفت‌های شدید، با كمک خدا، دل و جرأت یافتیم كه انجیل خدا را به شما برسانیم."
        },
        {
          "verse": 3,
          "usfm": "1TH.2.3",
          "line_type": "p",
          "text": "اصرار ما به شما از روی ایمان غلط و یا ناپاک نبود و ما سعی نداشتیم كسی را فریب دهیم،"
        },
        {
          "verse": 4,
          "usfm": "1TH.2.4",
          "line_type": "p",
          "text": "امّا چون خدا ما را لایق دانست و انتشار انجیل را به عهدهٔ ما گذاشت، سخن می‌گوییم. منظور ما جلب رضایت انسان نیست، بلكه ما می‌خواهیم خدایی را خشنود كنیم كه دلهای ما را می‌آزماید."
        },
        {
          "verse": 5,
          "usfm": "1TH.2.5",
          "line_type": "p",
          "text": "شما خوب می‌دانید و خدا شاهد است كه ما چاپلوسی نکردیم و سخنان ما از روی طمع نبود."
        },
        {
          "verse": 6,
          "usfm": "1TH.2.6",
          "line_type": "p",
          "text": "و به هیچ وجه ما جویای احترام و ستایش مردم -‌خواه شما و خواه دیگران- نبودیم،"
        },
        {
          "verse": 7,
          "usfm": "1TH.2.7",
          "line_type": "p",
          "text": "اگرچه ما به عنوان رسولان مسیح حقّی به گردن شما داشتیم، ولی مانند مادری كه فرزندان خود را پرورش می‌دهد با شما به ملایمت رفتار كردیم"
        },
        {
          "verse": 8,
          "usfm": "1TH.2.8",
          "line_type": "p",
          "text": "و با احساسات و به‌خاطر علاقه‌ای كه نسبت به شما داشتیم، حاضر بودیم نه فقط انجیل خدا را به شما برسانیم بلكه جان خود را نیز در راه شما فدا سازیم، چون شما برای ما بسیار عزیز بودید!"
        },
        {
          "verse": 9,
          "usfm": "1TH.2.9",
          "line_type": "p",
          "text": "ای برادران، به‌خاطر دارید كه ما چگونه كار می‌كردیم و زحمت می‌کشیدیم و شب و روز مشغول كار بودیم تا در موقع اعلام انجیل خدا در میان شما بر هیچ‌کس تحمیل نشویم."
        },
        {
          "verse": 10,
          "usfm": "1TH.2.10",
          "line_type": "p",
          "text": "هم شما شاهد هستید و هم خدا كه رفتار ما نسبت به شما ایمانداران تا چه اندازه پاک، درست و بی‌عیب بود."
        },
        {
          "verse": 11,
          "usfm": "1TH.2.11",
          "line_type": "p",
          "text": "شما خوب می‌دانید كه رفتار ما با فرد فرد شما درست مانند رفتار یک پدر با فرزندان خود بود."
        },
        {
          "verse": 12,
          "usfm": "1TH.2.12",
          "line_type": "p",
          "text": "ما شما را تشویق می‌کردیم، دلداری می‌دادیم و موظّف می‌ساختیم كه زندگی و رفتار شما پسندیدهٔ خدا باشد، آن خدایی كه شما را به پادشاهی و جلال خود دعوت می‌کند."
        },
        {
          "verse": 13,
          "usfm": "1TH.2.13",
          "line_type": "p",
          "text": "پیوسته خدا را برای این نیز شكر می‌كنم كه وقتی پیام خدا را از ما شنیدید، آن را به عنوان پیامی از جانب بشر نپذیرفتید، بلكه آن را از طرف خدا دانستید و در حقیقت همین‌طور هم هست و اكنون در میان شما ایمانداران عمل می‌کند."
        },
        {
          "verse": 14,
          "usfm": "1TH.2.14",
          "line_type": "p",
          "text": "ای برادران، شما درست به همان راهی می‌روید كه كلیساهای یهودیه در اتّحاد با مسیح عیسی خداوند رفته‌اند، زیرا شما از هموطنان خود همان زحماتی را دیده‌اید كه آنان از یهودیان دیدند"
        },
        {
          "verse": 15,
          "usfm": "1TH.2.15",
          "line_type": "p",
          "text": "-‌یهودیانی كه هم عیسی خداوند و هم انبیا را كشتند و ما را بیرون راندند- آنها خدا را خشنود نمی‌سازند و با همهٔ مردم دشمنی می‌کنند."
        },
        {
          "verse": 16,
          "usfm": "1TH.2.16",
          "line_type": "p",
          "text": "آنها حتّی می‌كوشند كه ما را از موعظه به غیر یهودیان باز دارند، درصورتی‌که این گفت‌وگو سبب نجات غیر یهودیان می‌شود. آنها دایماً پیمانهٔ گناهان خود را پر می‌سازند، ولی غضب خدا سرانجام آنان را گرفتار كرده است."
        },
        {
          "verse": 17,
          "usfm": "1TH.2.17",
          "line_type": "p",
          "text": "امّا ای برادران، چون برای مدّت كوتاهی (البتّه جسماً، نه قلباً) از شما جدا شدیم، چقدر برای شما دلتنگ گشتیم و اكنون بسیار کوشش می‌کنیم که دوباره شما را ببینیم."
        },
        {
          "verse": 18,
          "usfm": "1TH.2.18",
          "line_type": "p",
          "text": "آری، مایل بودیم نزد شما بیاییم و من پولس، یكی دو بار خواستم بیایم، امّا شیطان مانع ما می‌شد."
        },
        {
          "verse": 19,
          "usfm": "1TH.2.19",
          "line_type": "p",
          "text": "برای ما چه امیدی یا شادمانی‌ای یا تاج افتخاری در حضور خداوند ما عیسی مسیح به هنگام آمدن او وجود دارد؟ مگر شما نیستید؟"
        },
        {
          "verse": 20,
          "usfm": "1TH.2.20",
          "line_type": "p",
          "text": "البتّه مایهٔ افتخار و شادمانی ما شما هستید!"
        }
      ],
      "verse_count": 20,
      "headings": [
        {
          "before_verse": 17,
          "text": "علاقهٔ پولس برای دیدن آنها"
        }
      ],
