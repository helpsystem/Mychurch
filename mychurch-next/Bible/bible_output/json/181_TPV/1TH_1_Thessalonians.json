    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 4,
      "chapter_usfm": "1TH.4",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.4.1",
          "line_type": "p",
          "text": "دیگر اینکه ای برادران، شما از ما آموختید كه چگونه باید زندگی كنید تا خدا را خشنود سازید و شما هم البتّه از آن پیروی می‌كنید. اكنون به نام عیسی خداوند از شما استدعا و التماس می‌كنم كه بیش از پیش مطابق آن زندگی كنید."
        },
        {
          "verse": 2,
          "usfm": "1TH.4.2",
          "line_type": "p",
          "text": "زیرا می‌دانید به حكم عیسی خداوند چه دستورهایی به شما دادم."
        },
        {
          "verse": 3,
          "usfm": "1TH.4.3",
          "line_type": "p",
          "text": "خواست خدا این است كه شما پاک باشید و از روابط جنسی نامشروع بپرهیزید."
        },
        {
          "verse": 4,
          "usfm": "1TH.4.4",
          "line_type": "p",
          "text": "همهٔ شما باید بدانید چگونه بدن خود را همیشه تحت كنترل داشته باشید و آن را پاک و محترم نگاه دارید"
        },
        {
          "verse": 5,
          "usfm": "1TH.4.5",
          "line_type": "p",
          "text": "و مانند ملّتهای خداناشناس، دستخوش امیال و شهوات جسمانی نگردید."
        },
        {
          "verse": 6,
          "usfm": "1TH.4.6",
          "line_type": "p",
          "text": "در این خصوص هیچ‌کس نباید از ایمانداران سوء استفاده کند، زیرا همان طوری که من قبلاً با تأكید زیاد به شما گفته بودم: خداوند به کسانی‌که این كارها را می‌کنند، كیفر خواهد داد."
        },
        {
          "verse": 7,
          "usfm": "1TH.4.7",
          "line_type": "p",
          "text": "خدا ما را به یک زندگی پاک خوانده است، نه به فساد اخلاقی!"
        },
        {
          "verse": 8,
          "usfm": "1TH.4.8",
          "line_type": "p",
          "text": "پس هرکه این تعلیم را قبول نكند، انسان را رد نمی‌کند بلكه خدایی را كه روح‌القدس خود را به شما عطا می‌فرماید، رد كرده است."
        },
        {
          "verse": 9,
          "usfm": "1TH.4.9",
          "line_type": "p",
          "text": "و امّا دربارهٔ محبّت به یکدیگر، هیچ نیازی نیست كه در خصوص آن چیزی بنویسم، زیرا خود شما از خدا تعلیم یافته‌اید كه چگونه یكدیگر را دوست بدارید"
        },
        {
          "verse": 10,
          "usfm": "1TH.4.10",
          "line_type": "p",
          "text": "و شكّی نیست كه در تمام مقدونیه شما با همهٔ ایمانداران همین‌طور رفتار می‌كنید، امّا ای برادران، از شما درخواست می‌كنم كه محبّت شما روز به روز بیشتر گردد."
        },
        {
          "verse": 11,
          "usfm": "1TH.4.11",
          "line_type": "p",
          "text": "آرزویتان این باشد كه زندگی آرامی داشته باشید و به كار خود مشغول باشید و همان‌طور كه قبلاً به شما دستور دادیم برای تأمین معاش خود كار كنید"
        },
        {
          "verse": 12,
          "usfm": "1TH.4.12",
          "line_type": "p",
          "text": "تا زندگی شما تأثیری نیكو در بی‌ایمانان بگذارد و برای تأمین خود محتاج دیگران نباشید."
        },
        {
          "verse": 13,
          "usfm": "1TH.4.13",
          "line_type": "p",
          "text": "ای برادران، نمی‌خواهم در مورد آنانی كه فوت نموده‌اند، بی‌اطّلاع باشید. مبادا مانند سایر مردم كه هیچ امیدی به آینده ندارند، غمگین باشید."
        },
        {
          "verse": 14,
          "usfm": "1TH.4.14",
          "line_type": "p",
          "text": "زیرا اگر ما معتقدیم كه عیسی مرد و دوباره زنده شد، همچنین ایمان داریم كه خدا آنانی را كه در ایمان به عیسی مرده‌اند نیز همراه عیسی باز خواهد آورد."
        },
        {
          "verse": 15,
          "usfm": "1TH.4.15",
          "line_type": "p",
          "text": "ما این را از تعالیم خداوند به شما می‌گوییم: آن كسانی از ما كه تا روز آمدن خداوند زنده می‌مانند، زودتر از مردگان صعود نخواهند كرد."
        },
        {
          "verse": 16,
          "usfm": "1TH.4.16",
          "line_type": "p",
          "text": "در همان موقع كه فریاد فرمان الهی و صدای رئیس فرشتگان و بانگ شیپور خداوند شنیده می‌شود، خود خداوند از آسمان به زیر خواهد آمد و اول کسانی‌که در ایمان به مسیح مرده‌اند، خواهند برخاست"
        },
        {
          "verse": 17,
          "usfm": "1TH.4.17",
          "line_type": "p",
          "text": "و سپس آن کسانی‌که از میان ما زنده می‌مانند همراه با آنها در ابرها بالا برده خواهند شد تا در فضا با خداوند ملاقات نمایند و به این ترتیب ما همیشه با خداوند خواهیم بود."
        },
        {
          "verse": 18,
          "usfm": "1TH.4.18",
          "line_type": "p",
          "text": "پس شما باید یكدیگر را با این كلمات تشویق كنید."
        }
      ],
      "verse_count": 18,
