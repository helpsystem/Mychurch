          "usfm": "1TH.5.1",
          "line_type": "p",
          "text": "امّا ای برادران، لازم نیست كه من دربارهٔ زمان و تاریخ وقوع این امور چیزی برای شما بنویسم."
        },
        {
          "verse": 2,
          "usfm": "1TH.5.2",
          "line_type": "p",
          "text": "زیرا شما خوب می‌دانید كه روز خداوند مانند دزدی كه در شب می‌آید، فرا خواهد رسید."
        },
        {
          "verse": 3,
          "usfm": "1TH.5.3",
          "line_type": "p",
          "text": "در آن هنگام كه مردم از صلح و امنیّت خود تعریف می‌کنند، هلاكت ناگهانی مثل درد زایمان به ایشان وارد خواهد شد و به هیچ‌وجه، جان سالم به در نخواهند برد."
        },
        {
          "verse": 4,
          "usfm": "1TH.5.4",
          "line_type": "p",
          "text": "امّا ای برادران، شما در تاریكی نیستید كه آن روز شما را مانند دزد غافلگیر كند،"
        },
        {
          "verse": 5,
          "usfm": "1TH.5.5",
          "line_type": "p",
          "text": "زیرا همهٔ شما فرزندان روشنایی و روز هستید. ما به شب و تاریكی تعلّق نداریم."
        },
        {
          "verse": 6,
          "usfm": "1TH.5.6",
          "line_type": "p",
          "text": "پس ما نباید مانند دیگران در خواب باشیم، بلكه باید بیدار و هوشیار باشیم."
        },
        {
          "verse": 7,
          "usfm": "1TH.5.7",
          "line_type": "p",
          "text": "کسانی‌که می‌خوابند، در شب می‌خوابند و آنانی ‌که مست می‌شوند، در شب مست می‌شوند."
        },
        {
          "verse": 8,
          "usfm": "1TH.5.8",
          "line_type": "p",
          "text": "امّا ما كه به روز تعلّق داریم باید هوشیار باشیم و ایمان و محبّت را مانند زِرِه به سینه ببندیم و امید نجات را مانند كلاهخود بر سر بگذاریم."
        },
        {
          "verse": 9,
          "usfm": "1TH.5.9",
          "line_type": "p",
          "text": "زیرا خدا ما را برای آن برنگزید كه به غضب او گرفتار شویم، بلكه ما را برگزید تا به وسیلهٔ خداوند ما عیسی مسیح نجات یابیم."
        },
        {
          "verse": 10,
          "usfm": "1TH.5.10",
          "line_type": "p",
          "text": "او در راه ما مرد تا خواه زنده باشیم خواه مرده، با او زیست کنیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.5.11",
          "line_type": "p",
          "text": "پس همان‌گونه كه اكنون انجام می‌دهید، یكدیگر را تشویق و تقویت كنید."
        },
        {
          "verse": 12,
          "usfm": "1TH.5.12",
          "line_type": "p",
          "text": "ای برادران من، از شما تقاضا دارم برای آنانی كه در میان شما زحمت می‌کشند و در خداوند، رهبران و مشاوران شما هستند، احترام قایل شوید؛"
        },
        {
          "verse": 13,
          "usfm": "1TH.5.13",
          "line_type": "p",
          "text": "و از آنان به‌خاطر كاری كه می‌کنند با نهایت محبّت و احترام قدردانی نمایید. با یكدیگر در صلح و صفا زیست كنید."
        },
        {
          "verse": 14,
          "usfm": "1TH.5.14",
          "line_type": "p",
          "text": "ای برادران من، از شما استدعا می‌کنم افراد تنبل و بیكار را توبیخ كنید، اشخاص ترسو را دلداری دهید، از ضعیفان پشتیبانی كنید و نسبت به همهٔ مردم بردبار باشید."
        },
        {
          "verse": 15,
          "usfm": "1TH.5.15",
          "line_type": "p",
          "text": "مواظب باشید كه هیچ‌کس بدی را با بدی تلافی نكند، بلكه هدف شما این باشد که پیوسته به یكدیگر و به همهٔ مردم نیکویی کنید."
        },
        {
          "verse": 16,
          "usfm": "1TH.5.16",
          "line_type": "p",
          "text": "همیشه شادمان باشید"
        },
        {
          "verse": 17,
          "usfm": "1TH.5.17",
          "line_type": "p",
          "text": "و پیوسته دعا كنید."
        },
        {
          "verse": 18,
          "usfm": "1TH.5.18",
          "line_type": "p",
          "text": "برای هرچه كه پیش می‌آید، خدا را شكر كنید. زیرا خدا در مسیح عیسی از شما همین انتظار را دارد."
        },
        {
          "verse": 19,
          "usfm": "1TH.5.19",
          "line_type": "p",
          "text": "روح‌القدس را محدود نسازید."
        },
        {
          "verse": 20,
          "usfm": "1TH.5.20",
          "line_type": "p",
          "text": "نبوّتها را ناچیز نشمارید."
        },
        {
          "verse": 21,
          "usfm": "1TH.5.21",
          "line_type": "p",
          "text": "همه‌چیز را بیازمایید و آنچه را كه نیكوست برای خود نگاه دارید."
        },
        {
          "verse": 22,
          "usfm": "1TH.5.22",
          "line_type": "p",
          "text": "از هر نوع بدی دوری كنید."
        },
        {
          "verse": 23,
          "usfm": "1TH.5.23",
          "line_type": "p",
          "text": "خدایی كه سرچشمهٔ آرامش است، شما را کاملاً پاک گرداند و عطا فرماید كه روح و جان و بدن شما سالم بماند تا در وقت آمدن خداوند ما عیسی مسیح، از هر نوع عیب و نقصی به دور باشید."
        },
        {
          "verse": 24,
          "usfm": "1TH.5.24",
          "line_type": "p",
          "text": "او كه شما را به سوی خود دعوت كرده است، قابل اعتماد است و این كار را خواهد كرد."
        },
        {
          "verse": 25,
          "usfm": "1TH.5.25",
          "line_type": "p",
          "text": "ای برادران، برای ما دعا كنید."
        },
        {
          "verse": 26,
          "usfm": "1TH.5.26",
          "line_type": "p",
          "text": "همهٔ ایمانداران را با بوسهٔ مقدّسانه سلام گویید."
        },
        {
          "verse": 27,
          "usfm": "1TH.5.27",
          "line_type": "p",
          "text": "شما را به نام خداوند موظّف می‌سازم كه این نامه را برای تمام ایمانداران بخوانید."
        },
        {
          "verse": 28,
          "usfm": "1TH.5.28",
          "line_type": "p",
          "text": "فیض خداوند ما عیسی مسیح با شما باد."
        }
      ],
