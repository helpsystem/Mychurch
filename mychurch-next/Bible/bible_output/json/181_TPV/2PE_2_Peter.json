  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 1,
      "chapter_usfm": "2PE.1",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.1.1",
          "line_type": "p",
          "text": "از طرف شمعون پطرس، غلام و رسول عیسی مسیح به آنانی كه از راه نیكی مطلق خدا و نجات‌دهندهٔ ما عیسی مسیح، ایمانی مانند ایمان ما یافته‌اند."
        },
        {
          "verse": 2,
          "usfm": "2PE.1.2",
          "line_type": "p",
          "text": "درحالی‌که شناخت شما از خدا و عیسی مسیح خداوند زیادتر می‌شود، فیض و آرامش شما نیز افزون گردد."
        },
        {
          "verse": 3,
          "usfm": "2PE.1.3",
          "line_type": "p",
          "text": "قدرت الهی آنچه را كه ما برای زندگی و خداپرستی نیاز داریم، به ما بخشیده است تا ما بتوانیم کسی‌که ما را خوانده است تا در جلال و عظمتش سهیم شویم، بهتر بشناسیم."
        },
        {
          "verse": 4,
          "usfm": "2PE.1.4",
          "line_type": "p",
          "text": "بنابراین از وعده‌های بزرگ و گرانبها، بهره‌مند شده و در نتیجه از فسادی كه زاییدهٔ تمایلات جسمانی است، بگریزید و در الوهیّت خدا شریک و سهیم شوید."
        },
        {
          "verse": 5,
          "usfm": "2PE.1.5",
          "line_type": "p",
          "text": "به این سبب شما باید سخت بكوشید كه ایمان خود را با جوانمردی، جوانمردی را با معرفت،"
        },
        {
          "verse": 6,
          "usfm": "2PE.1.6",
          "line_type": "p",
          "text": "معرفت را با پرهیزكاری، پرهیزكاری را با بردباری، بردباری را با خداشناسی،"
        },
        {
          "verse": 7,
          "usfm": "2PE.1.7",
          "line_type": "p",
          "text": "خداشناسی را با دوستی مسیحایی و دوستی مسیحایی را با محبّت خالص تكمیل كنید."
        },
        {
          "verse": 8,
          "usfm": "2PE.1.8",
          "line_type": "p",
          "text": "اگر این صفات در شما باشد و زندگی شما را بیشتر فراگیرد، همیشه در شناسایی خداوند ما عیسی مسیح فعّال و پرثمر خواهید بود."
        },
        {
          "verse": 9,
          "usfm": "2PE.1.9",
          "line_type": "p",
          "text": "ولی کسی‌که فاقد این صفات باشد، چنان كور و نزدیک‌بین می‌شود كه فراموش می‌کند چگونه از گناهان گذشته‌اش پاک شده است."
        },
        {
          "verse": 10,
          "usfm": "2PE.1.10",
          "line_type": "p",
          "text": "پس ای برادران من، هرچه بیشتر بكوشید تا زندگی شما ثابت كند كه شما جزء دعوت شدگان و برگزیدگان خدا هستید، زیرا اگر چنین كنید، هرگز لغزش نخواهید خورد."
        },
        {
          "verse": 11,
          "usfm": "2PE.1.11",
          "line_type": "p",
          "text": "و به این ترتیب به شما اجازه داده می‌شود با پیروزی به پادشاهی جاودان خداوند و نجات‌دهندهٔ ما عیسی مسیح وارد شوید."
        },
        {
          "verse": 12,
          "usfm": "2PE.1.12",
          "line_type": "p",
          "text": "به این جهت من تصمیم گرفتم كه همیشه این چیزها را به‌یاد شما بیاورم. اگرچه شما اینها را می‌دانید و در حقیقتی كه یافته‌اید، ثابت هستید،"
        },
        {
          "verse": 13,
          "usfm": "2PE.1.13",
          "line_type": "p",
          "text": "ولی من تا زنده هستم صلاح می‌دانم كه با یادآوری و تذكّر، شما را برانگیزانم."
        },
        {
          "verse": 14,
          "usfm": "2PE.1.14",
          "line_type": "p",
          "text": "من می‌دانم كه بزودی، چنانکه خداوند عیسی مسیح به من نشان داد، این خیمه را ترک خواهم نمود."
        },
        {
          "verse": 15,
          "usfm": "2PE.1.15",
          "line_type": "p",
          "text": "پس نهایت كوشش خود را خواهم كرد تا پس از مرگ من، شما بتوانید در همهٔ اوقات این مطالب را به‌یاد آورید."
        },
        {
          "verse": 16,
          "usfm": "2PE.1.16",
          "line_type": "p",
          "text": "زیرا وقتی ما دربارهٔ قدرت خداوند ما عیسی مسیح و آمدن او سخن گفتیم به افسانه‌هایی كه با مهارت ساخته شده‌اند متوسّل نشدیم، زیرا ما با چشمان خود بزرگی ملكوتی او را دیده‌ایم."
        },
        {
          "verse": 17,
          "usfm": "2PE.1.17",
          "line_type": "p",
          "text": "وقتی خدای پدر به او افتخار و جلال داد، ما در آنجا حاضر بودیم و آن زمان كه از جلال خداوندی، صدایی به او رسید كه می‌گفت: «این است پسر عزیز من، از او خشنودم.» ما آنجا بودیم."
        },
        {
          "verse": 18,
          "usfm": "2PE.1.18",
          "line_type": "p",
          "text": "آری، ما وقتی با او بر روی كوه مقدّس بودیم این صدای آسمانی را شنیدیم."
        },
        {
          "verse": 19,
          "usfm": "2PE.1.19",
          "line_type": "p",
          "text": "این‌همه، كلام انبیا را برای ما بیشتر تصدیق و تأیید می‌کند، پس شما باید با دقّت بیشتر به آن توجّه نمایید، زیرا كلام انبیا مانند چراغی است كه در جایی تاریک می‌درخشد تا سپیده بدمد و ستارهٔ صبح طلوع كرده، دلهای شما را روشن گرداند."
        },
        {
          "verse": 20,
          "usfm": "2PE.1.20",
          "line_type": "p",
          "text": "امّا بیش از همه‌چیز، این را به‌یاد داشته باشید كه هیچ‌کس نمی‌تواند به تنهایی پیشگویی‌های کتاب‌مقدّس را تفسیر كند."
        },
        {
          "verse": 21,
          "usfm": "2PE.1.21",
          "line_type": "p",
          "text": "زیرا هیچ پیشگویی از روی نقشه و خواستهٔ انسان به وجود نیامده است؛ بلكه مردم تحت تأثیر روح‌القدس، كلام خدا را بیان نمودند."
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 3,
          "text": "برگزیدگان خدا"
        },
        {
          "before_verse": 16,
          "text": "شاهدان جلال مسیح"
        }
      ],
      "footnotes": [
