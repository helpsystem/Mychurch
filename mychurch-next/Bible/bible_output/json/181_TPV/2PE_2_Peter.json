    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 2,
      "chapter_usfm": "2PE.2",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.2.1",
          "line_type": "p",
          "text": "امّا قوم اسرائیل علاوه بر انبیای راستین، انبیای دروغین هم داشتند و شما هم در میان خود، معلّمین دروغین خواهید داشت. آنها مخفیانه تعالیم غلط و زیان‌بخش به میان شما خواهند آورد و همان مولایی را كه آنها را خرید، انكار خواهند نمود و بلای ناگهانی بر سر خود خواهند آورد."
        },
        {
          "verse": 2,
          "usfm": "2PE.2.2",
          "line_type": "p",
          "text": "عدّهٔ زیادی، آنها و راههای هرزهٔ آنها را دنبال خواهند كرد و به‌خاطر ایشان راه حقیقت مورد اهانت قرار خواهد گرفت."
        },
        {
          "verse": 3,
          "usfm": "2PE.2.3",
          "line_type": "p",
          "text": "از روی طمع و با داستانهای جعلی خود، شما را استثمار خواهند كرد، امّا كیفری كه از مدّتها پیش برای آنان مقرّر شده بود در انتظار آنها و هلاكت در كمین آنان است."
        },
        {
          "verse": 4,
          "usfm": "2PE.2.4",
          "line_type": "p",
          "text": "شما می‌دانید، كه خدا فرشتگانی را كه گناه كردند بدون تنبیه رها نكرد، بلكه آنان را به گودالهای تاریک دوزخ فرستاد تا در آنجا برای داوری نگهداری شوند."
        },
        {
          "verse": 5,
          "usfm": "2PE.2.5",
          "line_type": "p",
          "text": "خدا همچنین دنیای قدیم را بدون كیفر نگذاشت، بلكه بر دنیای بدكاران سیل جاری ساخت. تنها کسانی‌که نجات یافتند نوح، آن رسول راستی و درستی با هفت نفر دیگر بود."
        },
        {
          "verse": 6,
          "usfm": "2PE.2.6",
          "line_type": "p",
          "text": "خدا شهرهای سدوم و غموره را محكوم و ویران ساخته و به خاكستر تبدیل كرد تا برای آدمیان دیگر كه می‌خواهند در گناه زندگی كنند، عبرتی باشد."
        },
        {
          "verse": 7,
          "usfm": "2PE.2.7",
          "line_type": "p",
          "text": "خدا لوط را كه مردی نیک بود و از رفتار هرزهٔ شریران رنج می‌برد، رها ساخت."
        },
        {
          "verse": 8,
          "usfm": "2PE.2.8",
          "line_type": "p",
          "text": "زیرا آن مرد نیكو كه در میان آنان به سر می‌بُرد، همه‌روزه کارهای زشتی را می‌دید و می‌شنید كه قلب پاكش را عذاب می‌داد."
        },
        {
          "verse": 9,
          "usfm": "2PE.2.9",
          "line_type": "p",
          "text": "پس به این نتیجه می‌رسیم كه خدا می‌داند چطور نیک‌مردان را از وسوسه‌ها و آزمایشها برهاند و چگونه شریران را تا روز بازپسین تحت عقوبت نگه‌دارد،"
        },
        {
          "verse": 10,
          "usfm": "2PE.2.10",
          "line_type": "p",
          "text": "مخصوصاً آنانی كه خود را به همه‌نوع شهوات زشت و ناپاک سپرده‌اند و هر قدرتی را خوار می‌شمارند.این معلّمین دروغین، بی‌باک و خودبین هستند و هیچ حرمتی به موجودات آسمانی نشان نمی‌دهند و برعکس به آنان اهانت می‌نمایند."
        },
        {
          "verse": 11,
          "usfm": "2PE.2.11",
          "line_type": "p",
          "text": "حتّی فرشتگان كه از این معلّمین دروغین بسیار قویتر و تواناترند این موجودات آسمانی را در پیشگاه خداوند با بد زبانی متّهم نمی‌سازند."
        },
        {
          "verse": 12,
          "usfm": "2PE.2.12",
          "line_type": "p",
          "text": "امّا این اشخاص مانند جانوران وحشی و بی‌شعور، فقط به این منظور به این دنیا آمدند كه اسیر گردند و كشته شوند. به چیزهایی توهین می‌کنند كه نمی‌فهمند، پس مثل حیوانات وحشی نابود خواهند شد."
        },
        {
          "verse": 13,
          "usfm": "2PE.2.13",
          "line_type": "p",
          "text": "و در عوض بدی كه کرده‌اند، بدی خواهند دید. خوشی آنان در این است كه در روز روشن شهوات نفسانی خود را ارضاء نمایند. آنها لکه‌ها و زخمهای گندیدهٔ بدن شما هستند و وقتی بر سر سفره شما می‌آیند، از اینکه فكر می‌کنند شما را فریب داده‌اند، لذّت می‌برند."
        },
        {
          "verse": 14,
          "usfm": "2PE.2.14",
          "line_type": "p",
          "text": "آنها نمی‌خواهند به هیچ چیز به جز روسپیان نظر كنند و اشتهای آنها برای گناه سیری ناپذیر است. و آنها افرادی را كه هنوز در ایمان قوی نشده‌اند، با اغوا به دام خود می‌اندازند. دلهایشان با طمع و حسادت خو گرفته است و زیر لعنت خدا هستند."
        },
        {
          "verse": 15,
          "usfm": "2PE.2.15",
          "line_type": "p",
          "text": "راه راست را ترک گفته و منحرف شده‌اند، از راهی رفته‌اند كه «بلعام» پسر بصور در پیش گرفت؛ کسی‌که پولی را كه مزد خلافكاری‌اش بود، دوست می‌داشت."
        },
        {
          "verse": 16,
          "usfm": "2PE.2.16",
          "line_type": "p",
          "text": "امّا او به‌خاطر خلافكاری خود سرزنش شد زیرا الاغ زبان بسته‌ای به صدای انسان تكلّم كرد و کارهای دیوانه‌وار آن نبی را متوقّف ساخت."
        },
        {
          "verse": 17,
          "usfm": "2PE.2.17",
          "line_type": "p",
          "text": "این اشخاص مانند چشمه‌های خشكیده و یا ابرهایی هستند كه جلوی بادهای توفانی رانده می‌شوند و تاریكی غلیظ دوزخ در انتظار آنهاست."
        },
        {
          "verse": 18,
          "usfm": "2PE.2.18",
          "line_type": "p",
          "text": "سخنان كبر‌آمیز و احمقانه به زبان می‌آورند و با استفاده از طعمهٔ شهوات جسمانی و هرزگی، كسانی را كه تازه از یک زندگی غلط و گناه‌آلود فرار کرده‌اند، به‌ دام می‌اندازند."
        },
        {
          "verse": 19,
          "usfm": "2PE.2.19",
          "line_type": "p",
          "text": "به آنان وعدهٔ آزادی می‌دهند درحالی‌که خودشان بردگان فساد هستند؛ زیرا آدمی بردهٔ هر چیزی است كه او را مغلوب خود ساخته است."
        },
        {
          "verse": 20,
          "usfm": "2PE.2.20",
          "line_type": "p",
          "text": "آنان یک‌بار از راه معرفت خداوند و نجات‌دهندهٔ ما عیسی مسیح از ناپاکی‌های این دنیا دست شستند ولی اگر بار دیگر آنها گرفتار و مغلوب ناپاكی‌ها شوند، حالت آخر آنها از اولشان بدتر خواهد بود."
        },
        {
          "verse": 21,
          "usfm": "2PE.2.21",
          "line_type": "p",
          "text": "برای آنان بهتر می‌بود كه هرگز راه نیكی مطلق را نمی‌شناختند تا اینکه آن را بشناسند و از آن فرمان مقدّس كه به آنان داده شد، روی بگردانند."
        },
        {
          "verse": 22,
          "usfm": "2PE.2.22",
          "line_type": "p",
          "text": "آنچه برای آنان اتّفاق افتاد نشان می‌دهد كه این مثل راست است: «سگ به طرف آنچه استفراغ كرده است، بر می‌گردد.» و «خوكی كه شسته شده است، برای غلتیدن در گِل باز می‌گردد.»"
        }
      ],
