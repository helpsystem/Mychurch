  "chapters": [
    {
      "schema_version": 6,
      "book_id": "OBA",
      "chapter": 1,
      "chapter_usfm": "OBA.1",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "OBA.1.1",
          "line_type": "p",
          "text": "این است نبوّت عوبدیا دربارهٔ اَدوم:«شنیدم که خداوند متعالقاصدى نزد ملّتها فرستاده است که مى‌گوید:'آماده شوید تا به جنگ با اَدوم برویم!'»"
        },
        {
          "verse": 2,
          "usfm": "OBA.1.2",
          "line_type": "q1",
          "text": "خداوند علیه اَدوم مى‌فرماید:«من تو را در بین ملّتها خوار و ذلیل مى‌سازم."
        },
        {
          "verse": 3,
          "usfm": "OBA.1.3",
          "line_type": "q1",
          "text": "تکبّر تو، تو را فریب داده است،زیرا که چون بر صخره‌هاى بلند ساکن هستىو مسکنت بر فراز کوههاست، به خود مى‌بالى و مى‌گویى:'کیست که بتواند دست دراز کندو مرا پایین آورد؟'"
        },
        {
          "verse": 4,
          "usfm": "OBA.1.4",
          "line_type": "q1",
          "text": "اگر مانند عقاب بر فراز آسمان پرواز کنىو آشیانه‌ات را در بین ستارگان بسازى،من تو را فرود مى‌آورم."
        },
        {
          "verse": 5,
          "usfm": "OBA.1.5",
          "line_type": "q1",
          "text": "«اگر دزدى در شب به خانه‌اى وارد شود،فقط چیزى را مى‌برد که به آن نیاز دارد،اگر انگورچین براى چیدن انگور بیاید،مقدارى از انگور را بجا مى‌گذارد،امّا دشمنان تو، تو را بکلّی نیست و نابود مى‌کنند."
        },
        {
          "verse": 6,
          "usfm": "OBA.1.6",
          "line_type": "q1",
          "text": "اى فرزند عیسو، وقتى دشمنانت بیایند، تمام ثروت تو را به یغما مى‌برند."
        },
        {
          "verse": 7,
          "usfm": "OBA.1.7",
          "line_type": "q1",
          "text": "متّحدانت به تو خیانت کردندو تو را از سرزمینت بیرون راندند.کسانی‌که با تو در صلح بودند بر تو غلبه کردندو دوستانى که نمک تو را خوردند برایت دام گستردند و مى‌گویند:'کجاست آن‌همه عقل و هوش او؟'»"
        },
        {
          "verse": 8,
          "usfm": "OBA.1.8",
          "line_type": "q1",
          "text": "خداوند مى‌فرماید: «در آن روز اَدوم را مجازات مى‌کنم.تمام اشخاص دانا را در سرزمینش نابود مى‌سازمو همهٔ حکیمانش را از بین مى‌برم."
        },
        {
          "verse": 9,
          "usfm": "OBA.1.9",
          "line_type": "q1",
          "text": "جنگجویان شجاع تیمان هراسان مى‌شوندو تمام سربازان اَدوم کشته خواهند شد."
        },
        {
          "verse": 10,
          "usfm": "OBA.1.10",
          "line_type": "q1",
          "text": "«به‌خاطر ظلمى که در حق برادرانت،یعنى فرزندان یعقوب کردىبا رسوایى براى همیشه نابود مى‌شوى."
        },
        {
          "verse": 11,
          "usfm": "OBA.1.11",
          "line_type": "q1",
          "text": "روزى که دشمنان، دروازه‌هاى آنها را شکستندو بیگانگان، مال و دارایى اورشلیم رابین خود تقسیم کردند و با خود بردند،تو مانند بیگانه‌ای ایستادى و تماشا کردى."
        },
        {
          "verse": 12,
          "usfm": "OBA.1.12",
          "line_type": "q1",
          "text": "تو نمى‌بایست از بدبختى برادرانت خوشحال مى‌شدى،نمى‌بایست در روز مصیبت آنها شادی مى‌کردىو در هنگام غم و اندوه به آنها مى‌‌خندیدى."
        },
        {
          "verse": 13,
          "usfm": "OBA.1.13",
          "line_type": "q1",
          "text": "تو نمى‌بایست در روز سختى قوم منبه شهر آنها داخل مى‌شدىو در زمان مصیبت آنها ثروتشان را تاراج مى‌کردىو از غم آنها شاد مى‌شدى."
        },
        {
          "verse": 14,
          "usfm": "OBA.1.14",
          "line_type": "q1",
          "text": "تو نمى‌بایست بر سر چهار راهها مى‌ایستادىتا آنهایى را که می‌‌خواستند فرار کنند بگیری.نمى‌بایست در روز مصیبتآنها را به دست دشمنان تسلیم مى‌کردى."
        },
        {
          "verse": 15,
          "usfm": "OBA.1.15",
          "line_type": "q1",
          "text": "«من، خداوند بزودى تمام قومها را مجازات مى‌کنم.اى اَدوم، طبق رفتار خودت با تو رفتار مى‌کنم.هرچه کرده‌اى به سر خودت خواهم آورد."
        },
        {
          "verse": 16,
          "usfm": "OBA.1.16",
          "line_type": "q1",
          "text": "قوم من جام تلخ مجازات رابر روى کوه مقدّس نوشیده است.اقوام دیگر نیز آن را خواهند نوشید،حتّى تلختر از آن را؛آنها، آن را مى‌نوشند و از بین مى‌روند."
        },
        {
          "verse": 17,
          "usfm": "OBA.1.17",
          "line_type": "q1",
          "text": "«امّا در کوه صهیون عدّه‌اى نجات خواهند یافتو آنجا مکان مقدّس خواهد شدو فرزندان یعقوب مالک آن زمینىکه میراث آنهاست خواهند گردید."
        },
        {
          "verse": 18,
          "usfm": "OBA.1.18",
          "line_type": "q1",
          "text": "خاندان یعقوب و یوسف مانند آتشی خواهند بودکه خاندان عیسو را مانند کاه خواهند سوزانیدو نابود خواهند کرد.هیچ‌کدام از نسل عیسو زنده نخواهند مانداین را خداوند فرموده است."
        },
        {
          "verse": 19,
          "usfm": "OBA.1.19",
          "line_type": "q1",
          "text": "«مردم از جنوب یهودا، اَدوم را تصرّف خواهند کرد.اهالى دشتهای غربى، سرزمین فلسطین را اشغال خواهند کرد،قوم اسرائیل، سرزمین افرایم و سامره راو طایفهٔ بنیامین، جلعاد را تصرّف خواهند کرد."
        },
        {
          "verse": 20,
          "usfm": "OBA.1.20",
          "line_type": "q1",
          "text": "تبعید شدگان از شمال اسرائیل برمى‌گردندو فینیقیه را تا صرفه در قسمت شمال متصرّف مى‌شوند.تبعیدشدگان اورشلیم، که در آسیاى صغیر به سر مى‌برند،به وطن خود بازخواهند گشت و شهرهاى جنوب یهودا را خواهند گرفت."
        },
        {
          "verse": 21,
          "usfm": "OBA.1.21",
          "line_type": "q1",
          "text": "پیروزمندان اورشلیم بر اَدوم حکومت مى‌کنندو خداوند پادشاه ایشان خواهد ‌بود.»"
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 10,
          "text": "دلایل مجازات اَدوم"
        },
        {
          "before_verse": 15,
          "text": "مجازات قومها"
        },
        {
          "before_verse": 17,
          "text": "پیروزى اسرائیل"
        }
      ],
