    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 2,
      "chapter_usfm": "PHP.2",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.2.1",
          "line_type": "p",
          "text": "آیا در اتّحاد با مسیح دلگرم هستید؟ آیا محبّت، محرّک اصلی زندگی شماست؟ آیا با روح‌القدس مصاحبت دارید؟ و آیا احساس مهر و شفقت در بین شما وجود دارد؟"
        },
        {
          "verse": 2,
          "usfm": "PHP.2.2",
          "line_type": "p",
          "text": "پس تقاضا می‌کنم خوشی مرا به كمال رسانید و با هم توافقِ فكری، محبّت دو‌جانبه و هدف مشترک داشته باشید."
        },
        {
          "verse": 3,
          "usfm": "PHP.2.3",
          "line_type": "p",
          "text": "هیچ عملی را از روی هم چشمی و خودخواهی انجام ندهید، بلكه با فروتنی، دیگران را از خود بهتر بدانید."
        },
        {
          "verse": 4,
          "usfm": "PHP.2.4",
          "line_type": "p",
          "text": "به نفع دیگران فكر كنید و تنها در فكر خود نباشید."
        },
        {
          "verse": 5,
          "usfm": "PHP.2.5",
          "line_type": "p",
          "text": "طرز تفكّر شما دربارهٔ زندگی باید مانند طرز تفكّر عیسی مسیح باشد:"
        },
        {
          "verse": 6,
          "usfm": "PHP.2.6",
          "line_type": "q1",
          "text": "اگرچه او از ازل دارای الوهیّت بود،ولی راضی نشد كه برابری با خدا را به هر قیمتی حفظ كند،"
        },
        {
          "verse": 7,
          "usfm": "PHP.2.7",
          "line_type": "q1",
          "text": "بلكه خود را از تمام مزایای آن محروم نموده،به صورت یک غلام درآمد و شبیه انسان شد."
        },
        {
          "verse": 8,
          "usfm": "PHP.2.8",
          "line_type": "q1",
          "text": "چون او به شكل انسان در میان ما ظاهر گشت، خود را فروتن ساخت و از روی اطاعت حاضر شدمرگ -‌حتّی مرگ بر روی صلیب- را بپذیرد."
        },
        {
          "verse": 9,
          "usfm": "PHP.2.9",
          "line_type": "q1",
          "text": "از این جهت خدا او را بسیار سرافراز نمودو نامی را كه بالاتر از جمیع نامهاست به او عطا فرمود."
        },
        {
          "verse": 10,
          "usfm": "PHP.2.10",
          "line_type": "q1",
          "text": "تا اینکه همهٔ موجوداتدر آسمان و روی زمین و زیر زمین،با شنیدن نام عیسی به زانو در آیند."
        },
        {
          "verse": 11,
          "usfm": "PHP.2.11",
          "line_type": "q1",
          "text": "و همه برای جلال خدای پدر، با زبان خود اعتراف كنندكه عیسی مسیح، خداوند است."
        },
        {
          "verse": 12,
          "usfm": "PHP.2.12",
          "line_type": "p",
          "text": "بنابراین ای عزیزان من، همان‌طور كه وقتی با شما بودم همیشه از من اطاعت می‌كردید، اكنون هم كه از شما دور هستم، مهمتر است كه از من اطاعت كنید و نجات خود را با ترس و لرز به كمال برسانید،"
        },
        {
          "verse": 13,
          "usfm": "PHP.2.13",
          "line_type": "p",
          "text": "زیرا خداست كه از لطف خود، هم اراده و هم قدرت هركاری را در شما ایجاد می‌کند."
        },
        {
          "verse": 14,
          "usfm": "PHP.2.14",
          "line_type": "p",
          "text": "هر كاری را بدون شكایت و همهمه انجام دهید"
        },
        {
          "verse": 15,
          "usfm": "PHP.2.15",
          "line_type": "p",
          "text": "تا در زمانی‌که همه منحرف و سركش هستند، شما بدون تقصیر و گناه، فرزندان بی‌عیب خدا باشید و مانند ستارگان در جهان تاریک بدرخشید."
        },
        {
          "verse": 16,
          "usfm": "PHP.2.16",
          "line_type": "p",
          "text": "پیام حیات را همیشه در اختیار مردم بگذارید. اگر چنین كنید، من دلیلی خواهم داشت كه در روز عظیم مسیح به شما افتخار كنم، زیرا این نشان خواهد داد كه كار و زحمت من بیهوده نبوده است."
        },
        {
          "verse": 17,
          "usfm": "PHP.2.17",
          "line_type": "p",
          "text": "و حتّی اگر لازم باشد كه خون من مانند شراب وقف شده روی هدیهٔ قربانی ایمان شما ریخته شود، در انجام این كار خوشحالم و به شما شادباش می‌گویم."
        },
        {
          "verse": 18,
          "usfm": "PHP.2.18",
          "line_type": "p",
          "text": "شما هم خوشحال باشید و به من شادباش بگویید."
        },
        {
          "verse": 19,
          "usfm": "PHP.2.19",
          "line_type": "p",
          "text": "امیدوارم كه با خواست عیسی خداوند، بزودی تیموتاؤس را نزد شما بفرستم تا با آگاهی از احوال شما آسوده ‌خاطر شوم."
        },
        {
          "verse": 20,
          "usfm": "PHP.2.20",
          "line_type": "p",
          "text": "او تنها كسی است كه احساسات مرا درک می‌کند و واقعاً در فكر شماست."
        },
        {
          "verse": 21,
          "usfm": "PHP.2.21",
          "line_type": "p",
          "text": "دیگران همه به فكر خود هستند نه در فكر پیشرفت كار عیسی مسیح!"
        },
        {
          "verse": 22,
          "usfm": "PHP.2.22",
          "line_type": "p",
          "text": "شما تیموتاؤس را خوب می‌شناسید و می‌دانید كه او چگونه مانند یک پسر نسبت به پدر خود در انتشار انجیل به من خدمت كرده است."
        },
        {
          "verse": 23,
          "usfm": "PHP.2.23",
          "line_type": "p",
          "text": "پس امیدوارم به مجرّد اینکه وضع من معلوم شود، او را نزد شما بفرستم."
        },
        {
          "verse": 24,
          "usfm": "PHP.2.24",
          "line_type": "p",
          "text": "و اطمینان دارم كه با كمک خداوند، خود من نیز بزودی نزد شما خواهم آمد."
        },
        {
          "verse": 25,
          "usfm": "PHP.2.25",
          "line_type": "p",
          "text": "لازم دانستم «اپفرودیتس» را كه برادر، همكار و همقطار من بوده است و شما او را برای خدمت من و رفع احتیاجاتم فرستاده بودید، نزد شما برگردانم."
        },
        {
          "verse": 26,
          "usfm": "PHP.2.26",
          "line_type": "p",
          "text": "زیرا او برای همهٔ شما دلتنگ شده و از اینکه از بیماری او باخبر گشته‌اید، ناراحت شده است."
        },
        {
          "verse": 27,
          "usfm": "PHP.2.27",
          "line_type": "p",
          "text": "راستش این است كه او مریض و حتّی مشرف به موت بود. امّا خدا بر او رحم كرد و نه تنها بر او، بلكه بر من نیز رحم فرمود، مبادا این غم بر غمهای دیگر من افزوده شود."
        },
        {
          "verse": 28,
          "usfm": "PHP.2.28",
          "line_type": "p",
          "text": "پس مایل هستم هرچه زودتر او را نزد شما بفرستم تا شما با دیدن او بار دیگر خوشحال شوید و به این وسیله غم من هم كمتر خواهد شد."
        },
        {
          "verse": 29,
          "usfm": "PHP.2.29",
          "line_type": "p",
          "text": "پس با شادی او را به عنوان برادری در خداوند بپذیرید. به افرادی مثل او احترام بگذارید،"
        },
        {
          "verse": 30,
          "usfm": "PHP.2.30",
          "line_type": "p",
          "text": "زیرا او نزدیک بود در راه خدمت مسیح جان بسپارد و برای اینكه نقص خدمت شما به من را جبران كند، جان خود را به خطر انداخت."
        }
      ],
      "verse_count": 30,
      "headings": [
        {
          "before_verse": 12,
          "text": "مانند ستارگان بدرخشید"
        },
        {
          "before_verse": 19,
          "text": "تیموتاؤس و اپفرودیتس"
        }
      ],
