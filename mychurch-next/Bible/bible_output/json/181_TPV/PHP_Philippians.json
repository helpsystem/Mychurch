    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 3,
      "chapter_usfm": "PHP.3",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.3.1",
          "line_type": "p",
          "text": "دیگر اینکه ای برادران من، در اتّحاد خود با خداوند شادمان باشید. از نوشتن و تكرار آنچه قبلاً نوشته بودم، خسته نمی‌شوم؛ زیرا می‌دانم كه این برای امنیّت شماست."
        },
        {
          "verse": 2,
          "usfm": "PHP.3.2",
          "line_type": "p",
          "text": "از آن سگها و كارهای پست ایشان و آنانی كه برای ختنه یعنی بریدن عضوی از بدن اصرار دارند، برحذر باشید."
        },
        {
          "verse": 3,
          "usfm": "PHP.3.3",
          "line_type": "p",
          "text": "زیرا ما دارای ختنهٔ واقعی هستیم نه آنها. زیرا ما به وسیلهٔ روح، خدا را می‌پرستیم و به مسیح افتخار می‌کنیم و به امتیازات ظاهری اتّكایی نداریم."
        },
        {
          "verse": 4,
          "usfm": "PHP.3.4",
          "line_type": "p",
          "text": "اگرچه من حقّ دارم كه به این مزایا متّكی باشم. اگر دیگران تصوّر می‌کنند كه حقّ دارند به امتیازات ظاهری متّكی باشند، من حقّ بیشتری دارم."
        },
        {
          "verse": 5,
          "usfm": "PHP.3.5",
          "line_type": "p",
          "text": "من در هشتمین روز تولّد خود ختنه شدم و به طور مادرزاد، اسرائیلی از طایفهٔ بنیامین و یک عبرانی اصیل هستم. از لحاظ رعایت شریعت، فریسی بودم،"
        },
        {
          "verse": 6,
          "usfm": "PHP.3.6",
          "line_type": "p",
          "text": "و از لحاظ تعصّب، به كلیسا آزار می‌رسانیدم و مطابق معیارهای شریعت، من یک مرد بی‌عیب محسوب می‌شدم."
        },
        {
          "verse": 7,
          "usfm": "PHP.3.7",
          "line_type": "p",
          "text": "امّا هرچه به نفع من بود آن را به‌خاطر مسیح ضرر محسوب می‌کنم."
        },
        {
          "verse": 8,
          "usfm": "PHP.3.8",
          "line_type": "p",
          "text": "آری، علاوه بر این، همه‌چیز را به‌خاطر امتیازی بسیار ارزنده‌تر، یعنی شناختن عیسی مسیح، خداوند خود زیان می‌دانم. در واقع، من به‌خاطر او همه‌چیز را از دست داده‌ام و همه‌چیز را هیچ شمردم تا به این وسیله مسیح را به دست آورم"
        },
        {
          "verse": 9,
          "usfm": "PHP.3.9",
          "line_type": "p",
          "text": "و کاملاً با او متّحد شوم. من دیگر به نیكی خود كه از انجام مقرّرات شریعت بدست می‌آید، متّكی نیستم، بلكه به وسیلهٔ ایمان به مسیح دارای نیكی مطلق شده‌ام. این نیكی، بر ایمان استوار است و از خدا سرچشمه می‌گیرد."
        },
        {
          "verse": 10,
          "usfm": "PHP.3.10",
          "line_type": "p",
          "text": "یگانه آرزوی من این است كه مسیح را کاملاً بشناسم و قدرت قیامت او را در وجود خود درک كنم و در رنجهای او شریک گشته و در مرگ او همشكل او شوم،"
        },
        {
          "verse": 11,
          "usfm": "PHP.3.11",
          "line_type": "p",
          "text": "به این امید كه من نیز به رستاخیز از مردگان نایل گردم."
        },
        {
          "verse": 12,
          "usfm": "PHP.3.12",
          "line_type": "p",
          "text": "من نمی‌گویم كه قبلاً این را به دست آورده‌ام و یا به كمال رسیده‌ام، بلكه آن را دنبال می‌کنم تا به چنگ آورم، همان‌طور كه مسیح نیز مرا به‌خاطر آن به چنگ آورده است."
        },
        {
          "verse": 13,
          "usfm": "PHP.3.13",
          "line_type": "p",
          "text": "ای برادران، من ادّعا نمی‌كنم كه تا به حال آن را به چنگ آورده‌ام، ولی تنها كار من این است كه آنچه را در پشت سر من قرار دارد فراموش كنم و برای رسیدن به آنچه در پیش است، بكوشم."
        },
        {
          "verse": 14,
          "usfm": "PHP.3.14",
          "line_type": "p",
          "text": "مستقیماً به طرف هدف می‌دوم تا جایزه‌ای را كه شامل دعوت خدا به یک زندگی آسمانی به وسیلهٔ عیسی مسیح است، به دست آورم."
        },
        {
          "verse": 15,
          "usfm": "PHP.3.15",
          "line_type": "p",
          "text": "پس همهٔ ما كه روحاً بالغ هستیم باید چنین طرز تفكّری داشته باشیم و اگر شما فكر دیگری دارید، خدا این را هم به شما آشكار خواهد ساخت."
        },
        {
          "verse": 16,
          "usfm": "PHP.3.16",
          "line_type": "p",
          "text": "در هر حال ما باید مطابق حقایقی كه كسب کرده‌ایم، زندگی كنیم."
        },
        {
          "verse": 17,
          "usfm": "PHP.3.17",
          "line_type": "p",
          "text": "ای برادران من، همهٔ شما از من سرمشق بگیرید و به کسانی‌که از نمونهٔ ما پیروی می‌کنند، نگاه كنید."
        },
        {
          "verse": 18,
          "usfm": "PHP.3.18",
          "line_type": "p",
          "text": "بارها این را به شما گفته‌ام و بار دیگر آن را با اشک خود تكرار می‌كنم كه عدّهٔ زیادی طوری زندگی می‌كنند كه گویی دشمنان صلیب مسیح هستند."
        },
        {
          "verse": 19,
          "usfm": "PHP.3.19",
          "line_type": "p",
          "text": "آخر و عاقبت آنها هلاكت و خدای ایشان، امیال جسمانی آنهاست و افتخاراتشان در رسوایی و شرمساری است. افكار خود را به چیزهای دنیوی مشغول می‌سازند،"
        },
        {
          "verse": 20,
          "usfm": "PHP.3.20",
          "line_type": "p",
          "text": "امّا ما تابع كشور آسمانی و منتظر آمدن عیسی مسیح خداوند هستیم كه به عنوان نجات‌دهنده از آسمان می‌آید."
        },
        {
          "verse": 21,
          "usfm": "PHP.3.21",
          "line_type": "p",
          "text": "او طوری بدنهای ضعیف و فانی ما را تغییر خواهد داد تا به بدن پر شكوه او شباهت یابد و این كار را با قدرتی كه همه‌چیز را تحت فرمان او در می‌آورد، انجام خواهد داد."
        }
      ],
      "verse_count": 21,
      "headings": [
