  "chapters": [
    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 1,
      "chapter_usfm": "PHP.1",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.1.1",
          "line_type": "p",
          "text": "از طرف پولس و تیموتاؤس -‌غلامان مسیح عیسی- به همهٔ مقدّسین شهر فیلیپی كه با عیسی مسیح متّحدند و سرپرستان و خادمان آنها."
        },
        {
          "verse": 2,
          "usfm": "PHP.1.2",
          "line_type": "p",
          "text": "فیض و آرامش خدای پدر و عیسی مسیح خداوند با شما باد."
        },
        {
          "verse": 3,
          "usfm": "PHP.1.3",
          "line_type": "p",
          "text": "هروقت كه شما را به‌یاد می‌آورم خدا را شكر می‌کنم؛"
        },
        {
          "verse": 4,
          "usfm": "PHP.1.4",
          "line_type": "p",
          "text": "و در تمام دعاهایم نام شما را با شادمانی ذكر می‌کنم"
        },
        {
          "verse": 5,
          "usfm": "PHP.1.5",
          "line_type": "p",
          "text": "و به‌خاطر همكاری شما در انتشار انجیل كه از اولین روز شنیدن آن تا به حال ادامه دارد، خدا را سپاس می‌گویم."
        },
        {
          "verse": 6,
          "usfm": "PHP.1.6",
          "line_type": "p",
          "text": "من اطمینان دارم آن خدایی كه در شما كار نیكویی را شروع كرد تا روز مسیح عیسی، آن را به كمال خواهد رسانید."
        },
        {
          "verse": 7,
          "usfm": "PHP.1.7",
          "line_type": "p",
          "text": "من حقّ دارم كه دربارهٔ شما چنین احساسی داشته باشم، زیرا همیشه در دل من هستید و من چه در زندان و چه به دفاع و پشتیبانی از انجیل مشغول باشم، شما را در فیض خدا با خود شریک می‌دانم."
        },
        {
          "verse": 8,
          "usfm": "PHP.1.8",
          "line_type": "p",
          "text": "خدا شاهد است كه تا چه اندازه با احساسات گرمی كه مسیح عیسی در من ایجاد كرده است، مشتاق دیدار شما هستم."
        },
        {
          "verse": 9,
          "usfm": "PHP.1.9",
          "line_type": "p",
          "text": "و دعایم این است كه محبّت شما همراه با آگاهی و كمال دانایی همچنان رشد كند"
        },
        {
          "verse": 10,
          "usfm": "PHP.1.10",
          "line_type": "p",
          "text": "تا همه‌چیز را بیازمایید و عالیترین آنها را انتخاب كنید. آن وقت در روز عظیم مسیح بی‌عیب و بی‌تقصیر خواهید بود."
        },
        {
          "verse": 11,
          "usfm": "PHP.1.11",
          "line_type": "p",
          "text": "همچنین دعا می‌کنم كه زندگی شما از ثمرات نیكی مطلق كه به وسیلهٔ عیسی مسیح برای جلال و ستایش خدا به دست می‌آید، سرشار گردد."
        },
        {
          "verse": 12,
          "usfm": "PHP.1.12",
          "line_type": "p",
          "text": "ای برادران، می‌خواهم بدانید كه آنچه به ‌سر من آمده است در واقع به پیشرفت انجیل كمک كرده است،"
        },
        {
          "verse": 13,
          "usfm": "PHP.1.13",
          "line_type": "p",
          "text": "تا آنجا كه تمام اعضای گارد امپراتوری و سایرین نیز می‌دانند كه من در خدمت مسیح؛ و به‌خاطر او زندانی شده‌ام."
        },
        {
          "verse": 14,
          "usfm": "PHP.1.14",
          "line_type": "p",
          "text": "و از طرف دیگر، اغلب ایمانداران مسیحی به سبب زندانی شدن من به قدری قویدل شده‌اند كه جرأت می‌کنند پیام خدا را بدون ترس اعلام كنند."
        },
        {
          "verse": 15,
          "usfm": "PHP.1.15",
          "line_type": "p",
          "text": "البتّه بعضی‌ها، از روی حسادت و رقابت، به مسیح بشارت می‌دهند، ولی دیگران این كار را با حُسن نیّت انجام می‌دهند."
        },
        {
          "verse": 16,
          "usfm": "PHP.1.16",
          "line_type": "p",
          "text": "اینها از روی محبّت چنین می‌کنند، زیرا می‌دانند كه من به جهت دفاع از انجیل در اینجا افتاده‌ام."
        },
        {
          "verse": 17,
          "usfm": "PHP.1.17",
          "line_type": "p",
          "text": "ولی آنها از روی هم چشمی به مسیح بشارت می‌دهند، نه از روی صمیمیّت، زیرا تصوّر می‌کنند از این راه می‌توانند بار زحمت مرا در زندان سنگین‌تر سازند."
        },
        {
          "verse": 18,
          "usfm": "PHP.1.18",
          "line_type": "p",
          "text": "چه اهمیّت دارد؟ از هر راهی باشد، خواه از روی نیّت درست یا نادرست، مسیح به مردم اعلام می‌شود و این امر برای من مایهٔ خوشوقتی است. آری من شادم و همچنان شادی خواهم كرد."
        },
        {
          "verse": 19,
          "usfm": "PHP.1.19",
          "line_type": "p",
          "text": "زیرا می‌دانم كه به وسیلهٔ دعاهای شما و به یاری روح عیسی مسیح، این امر به نجات من تمام خواهد شد."
        },
        {
          "verse": 20,
          "usfm": "PHP.1.20",
          "line_type": "p",
          "text": "زیرا انتظار شدید و امید من این است كه هرگز موجبات رسوایی خود را فراهم نسازم، بلكه اکنون با دلیری كامل، مانند همیشه مسیح را در وجود خود جلال دهم، خواه با مرگ من باشد، خواه با زندگی من."
        },
        {
          "verse": 21,
          "usfm": "PHP.1.21",
          "line_type": "p",
          "text": "زیرا مقصود من از زندگی، مسیح است و مردن نیز به سود من تمام می‌شود."
        },
        {
          "verse": 22,
          "usfm": "PHP.1.22",
          "line_type": "p",
          "text": "امّا اگر با زنده ماندن بتوانم كار ارزنده‌ای انجام دهم، من نمی‌دانم كدام را انتخاب كنم."
        },
        {
          "verse": 23,
          "usfm": "PHP.1.23",
          "line_type": "p",
          "text": "بین دو راهی گیر کرده‌ام. اشتیاق دارم كه این زندگی را ترک كنم و با مسیح باشم كه خیلی بهتر است،"
        },
        {
          "verse": 24,
          "usfm": "PHP.1.24",
          "line_type": "p",
          "text": "امّا به‌خاطر شما زنده ماندن من واجب‌تر است."
        },
        {
          "verse": 25,
          "usfm": "PHP.1.25",
          "line_type": "p",
          "text": "با چنین اعتمادی یقین دارم كه زنده خواهم ماند و برای پیشرفت و شادمانی شما در ایمان با شما خواهم بود؛"
        },
        {
          "verse": 26,
          "usfm": "PHP.1.26",
          "line_type": "p",
          "text": "تا بار دیگر با آمدن من موجبات افتخار شما به من در مسیح عیسی بیشتر گردد."
        },
        {
          "verse": 27,
          "usfm": "PHP.1.27",
          "line_type": "p",
          "text": "به هر حال، طوری زندگی كنید كه رفتار شما شایستهٔ انجیل مسیح باشد و من چه بیایم و شما را ببینم و چه نیایم، مایلم دربارهٔ شما بشنوم كه در یگانگی روح پابرجا هستید و با هماهنگی پیوسته دست به دست یكدیگر داده، به‌خاطر ایمان انجیل تلاش می‌کنید."
        },
        {
          "verse": 28,
          "usfm": "PHP.1.28",
          "line_type": "p",
          "text": "به هیچ وجه از مخالفین نترسید، زیرا این شهامت شما به آنها ثابت می‌کند كه به سوی هلاكت می‌روند و شما نجات خواهید یافت و آن هم از طرف خداست."
        },
        {
          "verse": 29,
          "usfm": "PHP.1.29",
          "line_type": "p",
          "text": "چون این امتیاز به شما عطا شده است كه نه تنها به مسیح ایمان آورید، بلكه به‌خاطر او نیز رنج و زحمت ببینید،"
        },
        {
          "verse": 30,
          "usfm": "PHP.1.30",
          "line_type": "p",
          "text": "زیرا شما نیز به همان مبارزه‌ای داخل شده‌اید كه من داشتم و شما ناظر آن بودید و اطّلاع دارید كه هنوز هم گرفتار آن هستم."
        }
      ],
      "verse_count": 30,
      "headings": [
        {
          "before_verse": 3,
          "text": "دعای پولس برای آنها"
        },
        {
          "before_verse": 12,
          "text": "مقصود زندگی، مسیح"
        }
      ],
      "footnotes": [
