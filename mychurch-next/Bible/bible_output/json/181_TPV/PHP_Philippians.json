    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 4,
      "chapter_usfm": "PHP.4",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.4.1",
          "line_type": "p",
          "text": "بنابراین ای برادران عزیز، مشتاق دیدار شما هستم. شما مایهٔ شادی و افتخار من هستید. ای عزیزان، همچنان در اتّحاد خود با خداوند استوار باشید."
        },
        {
          "verse": 2,
          "usfm": "PHP.4.2",
          "line_type": "p",
          "text": "از «افودیه» و «سینتیخی» خواهران خود در خداوند استدعا دارم كه با یكدیگر صلح و سازش كنند."
        },
        {
          "verse": 3,
          "usfm": "PHP.4.3",
          "line_type": "p",
          "text": "و از تو ای همكار صمیمی، تقاضا می‌کنم كه این دو زن را كمک كنی، زیرا نام آنها، با «كلیمانتوس» و سایر همكاران من كه در انتشار انجیل تلاش کرده‌اند، در دفتر حیات ثبت شده است."
        },
        {
          "verse": 4,
          "usfm": "PHP.4.4",
          "line_type": "p",
          "text": "پیوسته در خداوند شاد باشید، باز هم می‌گویم شاد باشید!"
        },
        {
          "verse": 5,
          "usfm": "PHP.4.5",
          "line_type": "p",
          "text": "مهربانی و ملایمت شما در رفتارتان با دیگران آشكار باشد. آمدن خداوند نزدیک است!"
        },
        {
          "verse": 6,
          "usfm": "PHP.4.6",
          "line_type": "p",
          "text": "نگران هیچ چیز نباشید، بلكه همیشه در هر مورد با دعا و مناجات و سپاسگزاری تقاضاهای خود را در پیشگاه خدا ابراز نمایید."
        },
        {
          "verse": 7,
          "usfm": "PHP.4.7",
          "line_type": "p",
          "text": "و آرامش الهی كه بالاتر از فهم بشر است، دلها و افكار شما را در مسیح عیسی حفظ خواهد كرد."
        },
        {
          "verse": 8,
          "usfm": "PHP.4.8",
          "line_type": "p",
          "text": "در خاتمه ای برادران، دربارهٔ هر آنچه راست، شریف، درست، پاک، دوست داشتنی، نیكنام و هرچه عالی و قابل ستایش است، بیندیشید."
        },
        {
          "verse": 9,
          "usfm": "PHP.4.9",
          "line_type": "p",
          "text": "تمام چیزهایی را كه از من آموختید و به دست آوردید، یعنی آنچه را از من شنیدید، سرمشق خود ساخته، به عمل آورید كه در این صورت خدایی كه منبع آرامش است، با شما خواهد بود."
        },
        {
          "verse": 10,
          "usfm": "PHP.4.10",
          "line_type": "p",
          "text": "حال كه پس از مدّتی دوباره مورد توجّه قرار گرفته‌ام، شادی عظیمی در خداوند یافته‌ام. البتّه شما همیشه نسبت به من علاقه و توجّه داشته‌اید، امّا فرصت ابراز آن را نیافتید."
        },
        {
          "verse": 11,
          "usfm": "PHP.4.11",
          "line_type": "p",
          "text": "من به احتیاجات شخصی خود اشاره نمی‌کنم، زیرا یاد گرفته‌ام در هر وضعی كه باشم، قناعت كنم."
        },
        {
          "verse": 12,
          "usfm": "PHP.4.12",
          "line_type": "p",
          "text": "من می‌دانم چگونه در فقر و بیچارگی و یا در سعادتمندی زندگی كنم. به رمز زیستن در سیری و گرسنگی، در فراوانی و نیازمندی پی‌ برده‌ام."
        },
        {
          "verse": 13,
          "usfm": "PHP.4.13",
          "line_type": "p",
          "text": "من به وسیلهٔ مسیح كه مرا تقویت می‌کند، به انجام هر كاری قادر هستم."
        },
        {
          "verse": 14,
          "usfm": "PHP.4.14",
          "line_type": "p",
          "text": "امّا شما لطف كرده شریک زحمات من شدید."
        },
        {
          "verse": 15,
          "usfm": "PHP.4.15",
          "line_type": "p",
          "text": "خود شما ای فیلپیان، خوب می‌دانید كه در ابتدای انتشار انجیل وقتی من مقدونیه را ترک كردم، شما تنها كلیسایی بودید كه در قبول مسئولیّت دخل و خرج من با من همكاری كردید."
        },
        {
          "verse": 16,
          "usfm": "PHP.4.16",
          "line_type": "p",
          "text": "حتّی زمانی‌که در «تسالونیكی» بودم، یكی دو مرتبه مبلغی برای رفع احتیاجات من فرستادید."
        },
        {
          "verse": 17,
          "usfm": "PHP.4.17",
          "line_type": "p",
          "text": "من طالب پول شما نیستم؛ بلكه می‌خواهم به پاداش نیكوكاری شما افزوده شود."
        },
        {
          "verse": 18,
          "usfm": "PHP.4.18",
          "line_type": "p",
          "text": "اعانهٔ شما به دستم رسید و نه تنها كافی بلكه بیشتر از احتیاجاتم بود. هدیه‌ای را كه توسط «اپفرودیتس» فرستادید، احتیاج مرا رفع كرده است. عطایای شما هدیه‌ای خوشبو یعنی قربانی مقبول و پسندیدهٔ خداست"
        },
        {
          "verse": 19,
          "usfm": "PHP.4.19",
          "line_type": "p",
          "text": "و خدای من همهٔ احتیاجات شما را با ثروت عظیم خود در مسیح عیسی رفع خواهد كرد."
        },
        {
          "verse": 20,
          "usfm": "PHP.4.20",
          "line_type": "p",
          "text": "پدر ما خدا را تا به ابد جلال باد، آمین!"
        },
        {
          "verse": 21,
          "usfm": "PHP.4.21",
          "line_type": "p",
          "text": "به همهٔ مقدّسینی كه به مسیح عیسی تعلّق دارند، سلام برسانید. ایماندارانی كه با من هستند به شما سلام می‌رسانند."
        },
        {
          "verse": 22,
          "usfm": "PHP.4.22",
          "line_type": "p",
          "text": "همهٔ مقدّسین در اینجا و مخصوصاً ایماندارانی كه در دربار قیصر هستند، به شما سلام می‌رسانند."
        },
        {
          "verse": 23,
          "usfm": "PHP.4.23",
          "line_type": "p",
          "text": "فیض خداوند ما عیسی مسیح با روح شما باد."
        }
      ],
      "verse_count": 23,
      "headings": [
        {
          "before_verse": 10,
          "text": "تشكّر برای هدایای آنها"
        },
        {
          "before_verse": 21,
          "text": "خاتمه"
        }
      ],
