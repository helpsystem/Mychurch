    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 2,
      "chapter_usfm": "JON.2",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.2.1",
          "line_type": "p",
          "text": "یونس در شکم ماهی نزد خداوند، خدای خود دعا کرد و گفت:"
        },
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "line_type": "q1",
          "text": "«در هنگام تنگی تو را خواندمو تو مرا مستجاب فرمودی.از اعماق دنیای مردگان،برای کمک زاری کردم و تو مرا شنیدی"
        },
        {
          "verse": 3,
          "usfm": "JON.2.3",
          "line_type": "q1",
          "text": "تو ای خداوند، مرا به اعماق دریا فرو بردیو آبها مرا پوشاندندو تمام موجهای پر قدرت تو از سر من گذشتند."
        },
        {
          "verse": 4,
          "usfm": "JON.2.4",
          "line_type": "q1",
          "text": "خیال کردم که از پیشگاه تو رانده شده‌امو دیگر عبادتگاه مقدّس تو را نخواهم دید."
        },
        {
          "verse": 5,
          "usfm": "JON.2.5",
          "line_type": "q1",
          "text": "آبها روی مرا پوشاندند،گودیها دور مرا گرفتندو علفهای دریا دور سرم پیچیدند."
        },
        {
          "verse": 6,
          "usfm": "JON.2.6",
          "line_type": "q1",
          "text": "به اعماق کوهها فرو رفتم،به سرزمینی که دروازه‌هایش تا به ‌‌ابد بسته‌اند.امّا تو ای خداوند، خدای من،مرا از اعماق زنده بیرون آوردی."
        },
        {
          "verse": 7,
          "usfm": "JON.2.7",
          "line_type": "q1",
          "text": "وقتی در حال مرگ بودم،به نزد تو، ای خداوند دعا کردمو دعای من به پیشگاه مقدّس تو رسید."
        },
        {
          "verse": 8,
          "usfm": "JON.2.8",
          "line_type": "q1",
          "text": "کسانی‌که بُتهای باطل را پرستش می‌کنند،وفاداری خود را به تو فراموش کرده‌اند."
        },
        {
          "verse": 9,
          "usfm": "JON.2.9",
          "line_type": "q1",
          "text": "امّا من تو را سپاس خواهم گفت.برای تو قربانی خواهم کردو نذرهای خود را بجا خواهم آورد.نجات در دست خداوند است.»"
        },
        {
          "verse": 10,
          "usfm": "JON.2.10",
          "line_type": "p",
          "text": "سپس خداوند به ماهی دستور داد که یونس را به خشکی بیاندازد و ماهی، یونس را در خشکی قی کرد."
        }
      ],
      "verse_count": 10,
