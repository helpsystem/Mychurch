  "version_name": "مژده برای عصر جدید",
  "language": "fa",
  "chapter_count": 4,
  "total_verses": 95,
  "chapters": [
    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 1,
      "chapter_usfm": "COL.1",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.1.1",
          "line_type": "p",
          "text": "از طرف پولس كه به خواست خدا، رسول مسیح عیسی است و از طرف برادر ما تیموتاؤس"
        },
        {
          "verse": 2,
          "usfm": "COL.1.2",
          "line_type": "p",
          "text": "به برادران مقدّس و وفادار در شهر كولسیه، كه با مسیح متّحد می‌‌باشند. پدر ما خدا، فیض و آرامش به شما عطا فرماید."
        },
        {
          "verse": 3,
          "usfm": "COL.1.3",
          "line_type": "p",
          "text": "هروقت كه برای شما دعا می‌کنیم پدر خداوند ما عیسی مسیح را سپاس می‌گوییم."
        },
        {
          "verse": 4,
          "usfm": "COL.1.4",
          "line_type": "p",
          "text": "زیرا ما از ایمان شما به مسیح عیسی و محبّت شما به همهٔ مقدّسین آگاه هستیم."
        },
        {
          "verse": 5,
          "usfm": "COL.1.5",
          "line_type": "p",
          "text": "امید شما به آنچه در عالم بالا در انتظار شماست، باعث این ایمان و محبّت است. وقتی پیام حقیقی یعنی انجیل برای اولین بار به شما رسید، از این امید باخبر شدید."
        },
        {
          "verse": 6,
          "usfm": "COL.1.6",
          "line_type": "p",
          "text": "و این انجیل همان طوری که به شما رسید، به تمام جهان نیز رسیده است و به همان‌نحو‌ كه در جهان ثمر آورده، رشد و نمو می‌کند در میان شما نیز از همان روزی كه از فیض خدا باخبر شدید و در حقیقت آن را درک كردید، عمل كرده است."
        },
        {
          "verse": 7,
          "usfm": "COL.1.7",
          "line_type": "p",
          "text": "شما انجیل را از «اپفراس» عزیز كه همچون ما غلام و از طرف ما خادم وفادار مسیح است، آموختید"
        },
        {
          "verse": 8,
          "usfm": "COL.1.8",
          "line_type": "p",
          "text": "و او نیز ما را از محبّتی كه روح‌القدس به شما بخشیده، مطّلع ساخته است."
        },
        {
          "verse": 9,
          "usfm": "COL.1.9",
          "line_type": "p",
          "text": "به این جهت از همان روزی كه این را شنیدیم، همیشه برای شما دعا می‌کنیم و از خدا می‌خواهیم كه شما به وسیلهٔ بینش و فهم روحانی، ارادهٔ او را کاملاً درک كنید."
        },
        {
          "verse": 10,
          "usfm": "COL.1.10",
          "line_type": "p",
          "text": "سپس شما قادر خواهید بود طوری که شایستهٔ خداوند است زندگی كنید، کاملاً او را خشنود سازید، در تمام كارهای نیک، زندگی پرثمری داشته باشید و در معرفت خدا رشد و نمو كنید."
        },
        {
          "verse": 11,
          "usfm": "COL.1.11",
          "line_type": "p",
          "text": "و همچنین دعا می‌کنم كه خدا برحسب قدرت پرشكوهش و با تمام نیروی خود شما را تقویت كند تا با شادی و صبر هر چیز را تحمّل كنید."
        },
        {
          "verse": 12,
          "usfm": "COL.1.12",
          "line_type": "p",
          "text": "پیوسته خدای پدر را شكر كنید كه شما را لایق آن گردانیده است تا در سرنوشتی كه در عالم نورانی در انتظار مقدّسین است، سهمی داشته باشید."
        },
        {
          "verse": 13,
          "usfm": "COL.1.13",
          "line_type": "p",
          "text": "او ما را از چنگ نیرومند ظلمت رهانید و به پادشاهی پسر عزیزش منتقل ساخته است."
        },
        {
          "verse": 14,
          "usfm": "COL.1.14",
          "line_type": "p",
          "text": "خدا به وسیلهٔ او ما را آزاد ساخته و گناهانمان را آمرزیده است."
        },
        {
          "verse": 15,
          "usfm": "COL.1.15",
          "line_type": "p",
          "text": "مسیح، صورت و مظهر خدای نادیده است و نخستزاده و بالاتر از همهٔ مخلوقات."
        },
        {
          "verse": 16,
          "usfm": "COL.1.16",
          "line_type": "p",
          "text": "زیرا به وسیلهٔ او هر آنچه در آسمان و زمین است، دیدنی‌ها و نادیدنی‌ها، پادشاهان، حكمرانان و اولیای امور آفریده شدند، آری تمام موجودات به وسیلهٔ او و برای او آفریده شدند."
        },
        {
          "verse": 17,
          "usfm": "COL.1.17",
          "line_type": "p",
          "text": "او قبل از همه‌چیز وجود داشت و همه‌چیز به وسیلهٔ او با هم ارتباط پیدا می‌کند."
        },
        {
          "verse": 18,
          "usfm": "COL.1.18",
          "line_type": "p",
          "text": "او سر و منشاء بدن یعنی كلیساست و نخستین كسی است كه پس از مرگ زنده گردید تا تنها او در همه‌چیز مقام اول را داشته باشد."
        },
        {
          "verse": 19,
          "usfm": "COL.1.19",
          "line_type": "p",
          "text": "زیرا ارادهٔ خدا بر این تعلّق گرفت كه او دارای الوهیّت كامل باشد."
        },
        {
          "verse": 20,
          "usfm": "COL.1.20",
          "line_type": "p",
          "text": "و به وسیلهٔ مسیح، همه‌چیز را با خود آشتی داد و به وسیلهٔ ریختن خون مسیح بر روی صلیب، صلح و دوستی بین خدا و هر آنچه در آسمان و زمین است، برقرار گردید."
        },
        {
          "verse": 21,
          "usfm": "COL.1.21",
          "line_type": "p",
          "text": "شما زمانی از خدا دور بودید و با کارها و افكار شریرانهٔ خود با او دشمنی داشتید،"
        },
        {
          "verse": 22,
          "usfm": "COL.1.22",
          "line_type": "p",
          "text": "امّا اكنون او به وسیلهٔ مرگ جسمانی مسیح شما را با خود متّحد ساخته تا شما را پاک، بی‌عیب و بی‌آلایش به حضور خود بیاورد،"
        },
        {
          "verse": 23,
          "usfm": "COL.1.23",
          "line_type": "p",
          "text": "البتّه به شرط اینكه ایمان خود را از دست ندهید، محكم و استوار بمانید و آن امیدی را كه در وقت شنیدن انجیل به دست آوردید، ترک نكنید. این همان انجیلی است كه در سرتاسر جهان اعلام گردیده و من «پولس» خادم آن هستم."
        },
        {
          "verse": 24,
          "usfm": "COL.1.24",
          "line_type": "p",
          "text": "اكنون از آن رنج و زحمتی كه به‌خاطر شما می‌بینم، خوشحالم. زیرا به وسیلهٔ رنجهای جسمانی خود، آنچه را كه از رنجهای مسیح برای بدن او، یعنی كلیسایش باقیمانده است، تكمیل می‌کنم."
        },
        {
          "verse": 25,
          "usfm": "COL.1.25",
          "line_type": "p",
          "text": "من طبق مأموریتی كه خدا برای خیریّت شما به من عطا فرمود، خادم كلیسا هستم تا پیام خدا را کاملاً اعلام نمایم،"
        },
        {
          "verse": 26,
          "usfm": "COL.1.26",
          "line_type": "p",
          "text": "یعنی آن حقیقت اسرار‌آمیز كه طی اعصار و قرون مخفی مانده بود، امّا اكنون برای مقدّسین آشكار شده است."
        },
        {
          "verse": 27,
          "usfm": "COL.1.27",
          "line_type": "p",
          "text": "خدا صلاح دانست كه راز پر جلال و بی‌قیاس خود را در میان ملل غیر یهود آشکار سازد و آن سرّ این است كه مسیح در شما ساكن می‌باشد و این حقیقت، مایهٔ امید شما به سهیم شدن در جلال خداست."
        },
        {
          "verse": 28,
          "usfm": "COL.1.28",
          "line_type": "p",
          "text": "ما مسیح را به همه می‌شناسانیم و با تمام دانشی كه داریم همه را آگاه ‌ساخته، تعلیم می‌دهیم تا آنها را به صورت افرادی بالغ در مسیح به خدا تقدیم نماییم."
        },
        {
          "verse": 29,
          "usfm": "COL.1.29",
          "line_type": "p",
          "text": "برای انجام این كار، من زحمت می‌کشم و کوشش می‌کنم و از قدرت عظیمی كه مسیح به من می‌دهد و در من كار می‌کند، استفاده می‌نمایم."
        }
      ],
      "verse_count": 29,
      "headings": [
        {
          "before_verse": 3,
          "text": "دعای سپاسگزاری"
        },
        {
          "before_verse": 15,
          "text": "شخصیّت و كار مسیح"
        },
        {
          "before_verse": 24,
          "text": "خدمت پولس برای كلیسا"
        }
      ],
      "footnotes": [
