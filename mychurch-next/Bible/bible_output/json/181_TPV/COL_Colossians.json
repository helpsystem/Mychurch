    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 4,
      "chapter_usfm": "COL.4",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.4.1",
          "line_type": "p",
          "text": "ای اربابان، با غلامان خود عادلانه و منصفانه رفتار كنید، زیرا می‌دانید كه شما هم در آسمان اربابی دارید."
        },
        {
          "verse": 2,
          "usfm": "COL.4.2",
          "line_type": "p",
          "text": "همیشه با حواس جمع و شكرگزاری دعا كنید."
        },
        {
          "verse": 3,
          "usfm": "COL.4.3",
          "line_type": "p",
          "text": "برای ما نیز دعا كنید كه خدا برای اعلام پیام خود، فرصت مناسبی به ما بدهد تا آن حقایقی را كه دربارهٔ مسیح پوشیده بود، اعلام كنیم که به‌خاطر آن من اكنون در زندان هستم."
        },
        {
          "verse": 4,
          "usfm": "COL.4.4",
          "line_type": "p",
          "text": "و دعا كنید تا آن طوری که وظیفهٔ من است این راز را آشكار سازم."
        },
        {
          "verse": 5,
          "usfm": "COL.4.5",
          "line_type": "p",
          "text": "در مناسبات خود با افراد غیر مسیحی، رفتاری عاقلانه داشته باشید. از فرصت‌هایی كه اكنون در دسترس شماست حداكثر استفاده را بكنید."
        },
        {
          "verse": 6,
          "usfm": "COL.4.6",
          "line_type": "p",
          "text": "گفتار شما پیوسته جالب و خوشایند باشد و یاد بگیرید كه چگونه به هرکس پاسخ مناسبی بدهید."
        },
        {
          "verse": 7,
          "usfm": "COL.4.7",
          "line_type": "p",
          "text": "«تیخیكاس» شما را از وضع من مطّلع خواهد ساخت. او برادر عزیز و خادمی وفادار است و با من در كار خداوند مثل یک غلام خدمت می‌کند."
        },
        {
          "verse": 8,
          "usfm": "COL.4.8",
          "line_type": "p",
          "text": "او را به این منظور نزد شما می‌فرستم تا از احوال ما باخبر شوید و تا خاطر شما را آسوده كند."
        },
        {
          "verse": 9,
          "usfm": "COL.4.9",
          "line_type": "p",
          "text": "«اونیسیموس» كه برادر محبوب وفادار و یكی از خودتان می‌باشد، همراه اوست. این دو، شما را از همهٔ اموری كه اینجا در جریان است، آگاه خواهند ساخت."
        },
        {
          "verse": 10,
          "usfm": "COL.4.10",
          "line_type": "p",
          "text": "«اَرِسْتَرخُس» كه با من در زندان است و همچنین «مرقس» پسر عموی برنابا به شما سلام می‌رسانند. (دربارهٔ مرقس قبلاً دستوراتی داده بودم كه چنانچه نزد شما بیاید او را با گرمی بپذیرید.)"
        },
        {
          "verse": 11,
          "usfm": "COL.4.11",
          "line_type": "p",
          "text": "و «یسوع» ملقّب به «یستوس» سلام می‌رساند. از مسیحیان یهودی نژاد فقط این چند نفر هستند كه برای پیشرفت پادشاهی خدا با من همكاری می‌کنند و باعث دلگرمی من شده‌اند."
        },
        {
          "verse": 12,
          "usfm": "COL.4.12",
          "line_type": "p",
          "text": "«اپفراس» كه یكی از افراد شما و غلام مسیح عیسی است سلام می‌رساند. او همیشه با جدیّت برای شما دعا می‌کند و از خدا می‌خواهد كه استوار و بالغ و کاملاً خاطر‌جمع باشید تا بتوانید ارادهٔ خدا را کاملاً اطاعت كنید."
        },
        {
          "verse": 13,
          "usfm": "COL.4.13",
          "line_type": "p",
          "text": "زیرا من شاهد هستم كه او به‌خاطر شما و ایمانداران «لائودیکیه» و «هیراپولیس» زحمت زیادی كشیده است."
        },
        {
          "verse": 14,
          "usfm": "COL.4.14",
          "line_type": "p",
          "text": "«لوقا» پزشک محبوب و «دیماس» به شما سلام می‌رسانند."
        },
        {
          "verse": 15,
          "usfm": "COL.4.15",
          "line_type": "p",
          "text": "به ایمانداران در «لائودیکیه» و به «بانو نیمفاس» و كلیسایی كه در خانه او تشكیل می‌شود، سلام مرا برسانید."
        },
        {
          "verse": 16,
          "usfm": "COL.4.16",
          "line_type": "p",
          "text": "پس از اینكه نامه را خواندید، طوری ترتیب بدهید كه این نامه برای كلیسای لائودیکیه نیز خوانده شود و شما هم نامه‌ای را که به کلیسای لائودیکیه نوشتم، بخوانید."
        },
        {
          "verse": 17,
          "usfm": "COL.4.17",
          "line_type": "p",
          "text": "به «ارخیپس» بگویید: «مواظب باش كه آن مأموریتی را كه در خدمت خداوند به عهدهٔ تو گذاشته شده است، انجام دهی.»"
        },
        {
          "verse": 18,
          "usfm": "COL.4.18",
          "line_type": "p",
          "text": "من پولس، با خط خودم درود می‌فرستم. فراموش نكنید كه من هنوز در زندان هستم! فیض خدا با شما باد، آمین."
        }
      ],
