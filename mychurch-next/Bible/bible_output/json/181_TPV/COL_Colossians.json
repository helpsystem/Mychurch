    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 3,
      "chapter_usfm": "COL.3",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.3.1",
          "line_type": "p",
          "text": "مگر شما با مسیح زنده نشده‌اید؟ پس در این صورت شما باید به چیزهای آسمانی، جایی‌که مسیح در آنجا در دست راست خدا نشسته است، دل ببندید."
        },
        {
          "verse": 2,
          "usfm": "COL.3.2",
          "line_type": "p",
          "text": "دربارهٔ آنچه در عالم بالا است بیندیشید، نه به آنچه بر روی زمین است."
        },
        {
          "verse": 3,
          "usfm": "COL.3.3",
          "line_type": "p",
          "text": "زیرا شما مرده‌اید و زندگی شما اكنون با مسیح در خدا پنهان است."
        },
        {
          "verse": 4,
          "usfm": "COL.3.4",
          "line_type": "p",
          "text": "وقتی مسیح كه زندگی ماست ظهور كند، شما نیز با او در شكوه و جلال ظهور خواهید كرد."
        },
        {
          "verse": 5,
          "usfm": "COL.3.5",
          "line_type": "p",
          "text": "بنابراین، تمایلات دنیوی یعنی زنا، ناپاكی، هوی و هوس، شهوت و طمع را (كه یک نوع بت‌پرستی است) در خود نابود سازید."
        },
        {
          "verse": 6,
          "usfm": "COL.3.6",
          "line_type": "p",
          "text": "به سبب این کارهاست كه افراد سركش گرفتار غضب خدا می‌شوند."
        },
        {
          "verse": 7,
          "usfm": "COL.3.7",
          "line_type": "p",
          "text": "زمانی‌که شما در آن وضع زندگی می‌کردید، کارهای شما نیز مانند دیگران بود."
        },
        {
          "verse": 8,
          "usfm": "COL.3.8",
          "line_type": "p",
          "text": "همچنین اكنون شما باید خشم، غیظ و بدخواهی را از دلهایتان و اهانت و حرفهای زشت را از لبهای خود به كلّی دور سازید."
        },
        {
          "verse": 9,
          "usfm": "COL.3.9",
          "line_type": "p",
          "text": "دیگر دروغ نگویید، زیرا با آن آدمی كه در سابق بودید و عادتهای او قطع رابطه کرده‌اید."
        },
        {
          "verse": 10,
          "usfm": "COL.3.10",
          "line_type": "p",
          "text": "و زندگی را به صورت انسان تازه‌ای شروع نموده‌اید -انسانی كه پیوسته در شباهت خالق خود به شكل تازه‌ای در می‌آید- تا رفته رفته به شناخت كامل خدا برسد."
        },
        {
          "verse": 11,
          "usfm": "COL.3.11",
          "line_type": "p",
          "text": "پس بین یونانی و یهودی، مختون و نامختون، بربری و وحشی، غلام و آزاد فرقی وجود ندارد، بلكه مسیح همه‌چیز است و در همه می‌باشد."
        },
        {
          "verse": 12,
          "usfm": "COL.3.12",
          "line_type": "p",
          "text": "پس شما كه برگزیدگان مقدّس و محبوب خدا هستید، خود را به دلسوزی، مهربانی، فروتنی، ملایمت و بردباری ملبّس سازید."
        },
        {
          "verse": 13,
          "usfm": "COL.3.13",
          "line_type": "p",
          "text": "متحمّل یكدیگر شوید. اگر از دیگران شِكوِه و شكایتی دارید، یكدیگر را عفو كنید و چنانکه خداوند شما را بخشیده است، شما نیز یكدیگر را ببخشید."
        },
        {
          "verse": 14,
          "usfm": "COL.3.14",
          "line_type": "p",
          "text": "به همهٔ اینها محبّت را اضافه كنید، زیرا محبّت همه‌چیز را به هم می‌پیوندد و تكمیل می‌کند."
        },
        {
          "verse": 15,
          "usfm": "COL.3.15",
          "line_type": "p",
          "text": "آرامشی كه مسیح به شما می‌بخشد، قاضی وجدان شما باشد؛ چون خدا شما را به عنوان اعضای یک بدن به این آرامش خوانده است و شما باید سپاسگزار باشید."
        },
        {
          "verse": 16,
          "usfm": "COL.3.16",
          "line_type": "p",
          "text": "اجازه بدهید كه پیام مسیح با تمام پُری آن سرتاسر وجود شما را فرا گیرد. یكدیگر را با نهایت خردمندی تعلیم و پند دهید و با سپاسگزاری در دلهای خود زبور، تسبیحات و سرودهای روحانی برای خدا بخوانید."
        },
        {
          "verse": 17,
          "usfm": "COL.3.17",
          "line_type": "p",
          "text": "هرچه می‌کنید، چه گفتار، چه كردار، همه را به نام عیسی خداوند انجام دهید و در عین حال خدای پدر را دایماً سپاس گویید."
        },
        {
          "verse": 18,
          "usfm": "COL.3.18",
          "line_type": "p",
          "text": "ای زنها، مطیع شوهرهای خود باشید، زیرا این كار وظیفهٔ مسیحی شماست."
        },
        {
          "verse": 19,
          "usfm": "COL.3.19",
          "line_type": "p",
          "text": "ای شوهرها، زنهایتان را دوست بدارید و با آنان تندی نكنید."
        },
        {
          "verse": 20,
          "usfm": "COL.3.20",
          "line_type": "p",
          "text": "ای فرزندان، از والدین خود در هر امری اطاعت كنید، زیرا این كار خداوند را خشنود می‌سازد."
        },
        {
          "verse": 21,
          "usfm": "COL.3.21",
          "line_type": "p",
          "text": "ای پدران، بر فرزندان خود زیاد سخت نگیرید مبادا دلسرد شوند."
        },
        {
          "verse": 22,
          "usfm": "COL.3.22",
          "line_type": "p",
          "text": "ای غلامان، در كلّیهٔ امور مطیع اربابان خود كه مانند شما بشرند باشید و اطاعت شما فقط به‌خاطر این نباشد كه تحت مراقبت هستید یا می‌خواهید دیگران را خشنود سازید، بلكه با خلوص نیّت و خداترسی اطاعت كنید."
        },
        {
          "verse": 23,
          "usfm": "COL.3.23",
          "line_type": "p",
          "text": "هرکاری که می‌کنید با دل و جان انجام دهید چنانکه گویی برای خداوند كار می‌کنید، نه برای بشر."
        },
        {
          "verse": 24,
          "usfm": "COL.3.24",
          "line_type": "p",
          "text": "زیرا می‌دانید خداوند میراثی به عنوان پاداش به شما عطا خواهد كرد. چون مسیح ارباب شماست و شما غلامان او هستید."
        },
        {
          "verse": 25,
          "usfm": "COL.3.25",
          "line_type": "p",
          "text": "شخص بدكار كیفر بد خود را خواهد دید و خدا تبعیض قایل نمی‌شود."
        }
      ],
      "verse_count": 25,
      "headings": [
        {
          "before_verse": 18,
          "text": "وظایف اجتماعی یک مسیحی"
        }
      ],
