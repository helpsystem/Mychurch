    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 2,
      "chapter_usfm": "COL.2",
      "version_id": 181,
      "version_abbr": "TPV",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.2.1",
          "line_type": "p",
          "text": "می‌خواهم بدانید كه چقدر برای شما و ایمانداران «لائودیکیه» و برای همهٔ آنانی كه تا به حال روی مرا ندیده‌اند زحمت می‌کشم،"
        },
        {
          "verse": 2,
          "usfm": "COL.2.2",
          "line_type": "p",
          "text": "تا آنان دلگرم شوند و در محبّت متّحد گردند و از بركاتِ سرشارِ اطمینانِ كامل كه از راه درک حقیقت به دست می‌آید، بهره‌مند شوند و از این راه به راز خدا كه خود مسیح است، پی خواهند برد."
        },
        {
          "verse": 3,
          "usfm": "COL.2.3",
          "line_type": "p",
          "text": "تمام گنجینه‌های حكمت و معرفت الهی، در مسیح نهفته است."
        },
        {
          "verse": 4,
          "usfm": "COL.2.4",
          "line_type": "p",
          "text": "این را می‌گویم تا مبادا كسی شما را با دلایل مجذوب كننده گمراه سازد،"
        },
        {
          "verse": 5,
          "usfm": "COL.2.5",
          "line_type": "p",
          "text": "زیرا اگرچه جسماً غایب هستم ولی در روح حضور دارم و از دیدن نظم و ترتیبی كه در میان شما وجود دارد و از ثبات ایمانتان به مسیح خوشحالم."
        },
        {
          "verse": 6,
          "usfm": "COL.2.6",
          "line_type": "p",
          "text": "پس همان طوری که روزی مسیح عیسی را به عنوان خداوند خود پذیرفتید، اكنون همیشه در اتّحاد با او زندگی كنید."
        },
        {
          "verse": 7,
          "usfm": "COL.2.7",
          "line_type": "p",
          "text": "در او ریشه بگیرید و رشد كنید. همان‌گونه كه تعلیم یافتید در ایمان استوار باشید و در ستایش خدا برای دیگران نمونه باشید."
        },
        {
          "verse": 8,
          "usfm": "COL.2.8",
          "line_type": "p",
          "text": "مواظب باشید مبادا كسی با دلایل پوچ و فلسفه‌ای كه متّکی به سنّتهای انسانی و عقاید بچّگانهٔ این جهان است، شما را اسیر خود سازد. این تعالیم از مسیح نیست."
        },
        {
          "verse": 9,
          "usfm": "COL.2.9",
          "line_type": "p",
          "text": "زیرا الوهیّت به طور كامل در مسیح مجسم شد"
        },
        {
          "verse": 10,
          "usfm": "COL.2.10",
          "line_type": "p",
          "text": "و شما نیز به وسیلهٔ اتّحاد با او كه بالاتر از همهٔ قدرتها و ریاستهاست، كامل شده‌اید."
        },
        {
          "verse": 11,
          "usfm": "COL.2.11",
          "line_type": "p",
          "text": "شما نیز در اتّحاد با او ختنه شده‌اید، ختنه‌ای كه به دست انسان صورت نگرفته است بلكه به وسیلهٔ ختنهٔ مسیح كه قطع طبیعت نفسانی است."
        },
        {
          "verse": 12,
          "usfm": "COL.2.12",
          "line_type": "p",
          "text": "وقتی شما تعمید گرفتید با مسیح مدفون شدید و نیز در تعمید خود به وسیلهٔ ایمان با قدرت خدا كه مسیح را پس از مرگ زنده گردانید، با او قیام كردید."
        },
        {
          "verse": 13,
          "usfm": "COL.2.13",
          "line_type": "p",
          "text": "خدا شما را كه به علّت خطاهای خود مُرده و در جسم خود نامختون بودید، با مسیح زنده كرد و همهٔ گناهان ما را بخشیده است."
        },
        {
          "verse": 14,
          "usfm": "COL.2.14",
          "line_type": "p",
          "text": "او سند محکومیّت ما را همراه با تمام مقرّراتی كه علیه ما بود، لغو كرد و آن را به صلیب خود میخكوب نموده، از بین برد."
        },
        {
          "verse": 15,
          "usfm": "COL.2.15",
          "line_type": "p",
          "text": "مسیح بر روی صلیب، تمام قدرتهای آسمانی و فرمانروایان را خلع سلاح كرد و بر آنها پیروز شد و آنها را نزد همه رسوا ساخت."
        },
        {
          "verse": 16,
          "usfm": "COL.2.16",
          "line_type": "p",
          "text": "بنابراین در مورد خوراکی یا آشامیدنی یا رعایت عید یا ماه نو یا روز سبت، به هیچ وجه تحت تأثیر انتقاد دیگران قرار نگیرید."
        },
        {
          "verse": 17,
          "usfm": "COL.2.17",
          "line_type": "p",
          "text": "این چیزها فقط سایهٔ آن واقعیّتی است كه قرار است بیاید و آن واقعیّت، خود مسیح است."
        },
        {
          "verse": 18,
          "usfm": "COL.2.18",
          "line_type": "p",
          "text": "نگذارید كسی با تظاهر به فروتنی و پرستش فرشتگان، شما را از ربودن تاج پیروزی باز دارد. زیرا چنین شخصی با اتّكاء به رؤیاهایی كه دیده است و به‌خاطر افكار دنیوی خود، بی‌جهت مغرور می‌شود."
        },
        {
          "verse": 19,
          "usfm": "COL.2.19",
          "line_type": "p",
          "text": "این قبیل اشخاص رابطهٔ خود را با سر یعنی با مسیح قطع کرده‌اند. تحت فرمان مسیح تمام بدن نیرو می‌گیرد و به توسط مفاصل و رشته‌‌ها به هم متّصل می‌شود و همان‌طور كه خدا می‌خواهد، نمو می‌كند."
        },
        {
          "verse": 20,
          "usfm": "COL.2.20",
          "line_type": "p",
          "text": "وقتی شما با مسیح مُردید، با عقاید بچّگانهٔ این جهان قطع رابطه كرده‌اید. پس چرا طوری زندگی می‌کنید كه گویا هنوز به دنیا بستگی دارید؟ چرا مطیع مقرّراتی از قبیل:"
        },
        {
          "verse": 21,
          "usfm": "COL.2.21",
          "line_type": "p",
          "text": "«این را لمس نكن، به آن لب نزن و به این دست نزن» می‌شوید؟!"
        },
        {
          "verse": 22,
          "usfm": "COL.2.22",
          "line_type": "p",
          "text": "اینها همه در اثر مصرف از بین می‌روند و این دستورات فقط قوانین و تعالیم انسان هستند!"
        },
        {
          "verse": 23,
          "usfm": "COL.2.23",
          "line_type": "p",
          "text": "البتّه این کارها در عبادتهایی كه آنها بر خود تحمیل کرده‌اند و فروتنی و ریاضت‌كشی، ظاهراً معقول به نظر می‌رسد، ولی در واقع نمی‌توانند مانع ارضای شهوات نفسانی شوند!"
        }
      ],
      "verse_count": 23,
      "headings": [
        {
          "before_verse": 6,
          "text": "زندگی كامل در مسیح"
        },
        {
          "before_verse": 20,
          "text": "زندگی جدید در مسیح"
        }
      ],
