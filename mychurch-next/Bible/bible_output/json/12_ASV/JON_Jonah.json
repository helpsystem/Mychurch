    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 2,
      "chapter_usfm": "JON.2",
      "version_id": 12,
      "version_abbr": "ASV",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.2.1",
          "line_type": null,
          "text": "Then Jonah prayed unto Jehovah his God out of the fish’s belly."
        },
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "line_type": "q1",
          "text": "And he said,I called by reason of mine affliction unto Jehovah,And he answered me;Out of the belly of Sheol cried I, And thou heardest my voice."
        },
        {
          "verse": 3,
          "usfm": "JON.2.3",
          "line_type": "q1",
          "text": "For thou didst cast me into the depth, in the heart of the seas,And the flood was round about me;All thy waves and thy billows passed over me."
        },
        {
          "verse": 4,
          "usfm": "JON.2.4",
          "line_type": "q1",
          "text": "And I said, I am cast out from before thine eyes;Yet I will look again toward thy holy temple."
        },
        {
          "verse": 5,
          "usfm": "JON.2.5",
          "line_type": "q1",
          "text": "The waters compassed me about, even to the soul;The deep was round about me;The weeds were wrapped about my head."
        },
        {
          "verse": 6,
          "usfm": "JON.2.6",
          "line_type": "q1",
          "text": "I went down to the bottoms of the mountains;The earth with its bars closed upon me for ever:Yet hast thou brought up my life from the pit, O Jehovah my God."
        },
        {
          "verse": 7,
          "usfm": "JON.2.7",
          "line_type": "q1",
          "text": "When my soul fainted within me, I remembered Jehovah;And my prayer came in unto thee, into thy holy temple."
        },
        {
          "verse": 8,
          "usfm": "JON.2.8",
          "line_type": "q1",
          "text": "They that regard lying vanitiesForsake their own mercy."
        },
        {
          "verse": 9,
          "usfm": "JON.2.9",
          "line_type": "q1",
          "text": "But I will sacrifice unto thee with the voice of thanksgiving;I will pay that which I have vowed.Salvation is of Jehovah."
        },
        {
          "verse": 10,
          "usfm": "JON.2.10",
          "line_type": "m",
          "text": "And Jehovah spake unto the fish, and it vomited out Jonah upon the dry land."
        }
      ],
      "verse_count": 10,
