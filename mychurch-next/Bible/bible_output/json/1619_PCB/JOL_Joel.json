  "chapters": [
    {
      "schema_version": 6,
      "book_id": "JOL",
      "chapter": 1,
      "chapter_usfm": "JOL.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "JOL.1.1",
          "line_type": "p",
          "text": "این پیام از جانب خداوند به یوئیل پسر فتوئیل رسید:"
        },
        {
          "verse": 2,
          "usfm": "JOL.1.2",
          "line_type": "p",
          "text": "ای ریش‌سفیدان بشنوید! ای همۀ ساکنان زمین گوش فرا دهید! آیا در روزگار شما یا روزگار نیاکانتان هرگز چنین چیزی رخ داده است؟"
        },
        {
          "verse": 3,
          "usfm": "JOL.1.3",
          "line_type": "p",
          "text": "در سالهای آینده این را برای فرزندانتان تعریف کنید تا آنان نیز آن را سینه به سینه برای نسلهای بعدی تعریف کنند."
        },
        {
          "verse": 4,
          "usfm": "JOL.1.4",
          "line_type": "p",
          "text": "ملخها دسته‌دسته خواهند آمد و محصول شما را خواهند خورد. آنچه ملخهای جونده از محصول باقی بگذارند، ملخهای دونده خواهند خورد، آنچه ملخهای دونده باقی بگذارند، ملخهای جهنده خواهند خورد و آنچه ملخهای جهنده باقی بگذارند، ملخهای فروبلعنده خواهند خورد."
        },
        {
          "verse": 5,
          "usfm": "JOL.1.5",
          "line_type": "p",
          "text": "ای مستان، بیدار شوید و زاری کنید؛ ای میگساران، شیون کنید! زیرا هر چه انگور بوده خراب شده و هر چه شراب داشتید از بین رفته است!"
        },
        {
          "verse": 6,
          "usfm": "JOL.1.6",
          "line_type": "p",
          "text": "لشکر بزرگی از ملخ، تمام سرزمین اسرائیل را پوشانده است. آنقدر زیادند که نمی‌توان آنها را شمرد. دندانهایشان مانند دندان شیر تیز است!"
        },
        {
          "verse": 7,
          "usfm": "JOL.1.7",
          "line_type": "p",
          "text": "تاکستان مرا از بین برده‌اند و پوست درختان انجیر را کنده، شاخه‌ها و تنه‌های آنها را سفید و لخت باقی گذاشته‌اند."
        },
        {
          "verse": 8,
          "usfm": "JOL.1.8",
          "line_type": "p",
          "text": "همچون دختر جوانی که نامزدش مرده باشد، گریه و زاری نمایید."
        },
        {
          "verse": 9,
          "usfm": "JOL.1.9",
          "line_type": "p",
          "text": "غله و شرابی که می‌بایست به خانهٔ خداوند تقدیم شود، از بین رفته است. کاهنان که خدمتگزاران خداوند هستند، ماتم گرفته‌اند."
        },
        {
          "verse": 10,
          "usfm": "JOL.1.10",
          "line_type": "p",
          "text": "در مزرعه‌ها محصولی باقی نمانده، غله و انگور و روغن زیتون از بین رفته و همه جا را غم و غصه فرا گرفته است."
        },
        {
          "verse": 11,
          "usfm": "JOL.1.11",
          "line_type": "p",
          "text": "ای کشاورزان، گریه کنید و ای باغبانان، زاری نمایید؛ زیرا محصول گندم و جو از میان رفته است."
        },
        {
          "verse": 12,
          "usfm": "JOL.1.12",
          "line_type": "p",
          "text": "درختان انگور خشک شده، و درختان انجیر و انار، خرما و سیب، و تمام درختان دیگر نابود شده‌اند. شادی از انسان رخت بربسته است."
        },
        {
          "verse": 13,
          "usfm": "JOL.1.13",
          "line_type": "p",
          "text": "ای کاهنان، لباس ماتم بپوشید. ای خدمتگزاران خدای من، تمام شب در برابر مذبح گریه کنید، چون دیگر غله و شرابی نمانده تا به خانهٔ خدایتان هدیه کنید."
        },
        {
          "verse": 14,
          "usfm": "JOL.1.14",
          "line_type": "p",
          "text": "روزه را اعلام کنید و خبر دهید که مردم جمع شوند. ریش‌سفیدان همراه با تمام قوم در خانهٔ خداوند، خدای خود جمع شوند و آنجا در حضور او گریه و ناله کنند."
        },
        {
          "verse": 15,
          "usfm": "JOL.1.15",
          "line_type": "p",
          "text": "وای بر ما، چون روز هولناک مجازات نزدیک می‌شود. نابودی از جانب خدای قادر مطلق فرا رسیده است!"
        },
        {
          "verse": 16,
          "usfm": "JOL.1.16",
          "line_type": "p",
          "text": "خوراک از برابر چشمانمان ناپدید شده، و شادی و خوشی از خانهٔ خدای ما رخت بربسته است."
        },
        {
          "verse": 17,
          "usfm": "JOL.1.17",
          "line_type": "p",
          "text": "بذر در زمین پوسیده می‌شود. انبارها و سیلوها خالی شده‌اند. غله در مزرعه‌ها تلف شده است."
        },
        {
          "verse": 18,
          "usfm": "JOL.1.18",
          "line_type": "p",
          "text": "گاوان چون چراگاهی ندارند سرگردانند و از گرسنگی می‌نالند و گوسفندان تلف می‌شوند."
        },
        {
          "verse": 19,
          "usfm": "JOL.1.19",
          "line_type": "p",
          "text": "ای خداوند، ما را یاری فرما! زیرا گرما و خشکسالی چراگاهها را خشکانیده و تمام درختان را سوزانیده است."
        },
        {
          "verse": 20,
          "usfm": "JOL.1.20",
          "line_type": "p",
          "text": "حتی حیوانات وحشی هم برای کمک به سوی تو فریاد برمی‌آورند، چون آبی برای خوردن ندارند. نهرهای کوهستانها خشک شده و چراگاهها زیر آفتاب به کلی سوخته‌اند."
        }
      ],
      "verse_count": 20,
