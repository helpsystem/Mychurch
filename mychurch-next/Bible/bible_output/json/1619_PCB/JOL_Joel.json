    {
      "schema_version": 6,
      "book_id": "JOL",
      "chapter": 3,
      "chapter_usfm": "JOL.3",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "JOL.3.1",
          "line_type": "p",
          "text": "خداوند می‌فرماید: «در آن زمان وقتی رفاه و سعادت را به یهودا و اورشلیم بازگردانم،"
        },
        {
          "verse": 2,
          "usfm": "JOL.3.2",
          "line_type": "p",
          "text": "سپاهیان جهان را در درهٔ یهوشافاط جمع خواهم کرد و در آنجا ایشان را به خاطر میراث خود، اسرائیل محاکمه خواهم نمود، چون قوم مرا در میان قومها پراکنده ساخته، سرزمین مرا تقسیم کردند."
        },
        {
          "verse": 3,
          "usfm": "JOL.3.3",
          "line_type": "p",
          "text": "آنها بر سر افراد قوم من قمار کردند و پسران را در ازای فاحشه‌ها و دختران را در مقابل شراب فروختند تا مست کنند."
        },
        {
          "verse": 4,
          "usfm": "JOL.3.4",
          "line_type": "p",
          "text": "«ای صور و صیدون، و ای شهرهای فلسطین چه می‌خواهید بکنید؟ آیا می‌خواهید از من انتقام بگیرید؟ اگر چنین کنید من بی‌درنگ شما را مجازات خواهم کرد."
        },
        {
          "verse": 5,
          "usfm": "JOL.3.5",
          "line_type": "p",
          "text": "طلا و نقره و تمام گنجینه‌های گرانبهای مرا گرفته و آنها را به بتخانه‌های خود برده‌اید."
        },
        {
          "verse": 6,
          "usfm": "JOL.3.6",
          "line_type": "p",
          "text": "مردم یهودا و اورشلیم را به یونانیان فروخته‌اید و ایشان را از سرزمینشان آواره کرده‌اید."
        },
        {
          "verse": 7,
          "usfm": "JOL.3.7",
          "line_type": "p",
          "text": "«ولی من دوباره آنها را از جاهایی که به آنها فروخته شده‌اند باز می‌گردانم و همهٔ اعمال شما را بر سر خودتان خواهم آورد."
        },
        {
          "verse": 8,
          "usfm": "JOL.3.8",
          "line_type": "p",
          "text": "من پسران و دختران شما را به مردم یهودا خواهم فروخت و ایشان هم آنها را به سبائیان که در سرزمینی دوردست ساکنند خواهند فروخت. من که خداوند هستم این را می‌گویم."
        },
        {
          "verse": 9,
          "usfm": "JOL.3.9",
          "line_type": "p",
          "text": "«برای جنگ آماده شوید و به همه خبر دهید! بهترین سربازان خود را بسیج کنید و تمام سپاهیان خود را فرا خوانید."
        },
        {
          "verse": 10,
          "usfm": "JOL.3.10",
          "line_type": "p",
          "text": "گاوآهنهای خود را ذوب نموده، شمشیر بسازید و از اره‌های خود نیزه تهیه کنید. شخص ضعیف بگوید: ”من قوی هستم!“"
        },
        {
          "verse": 11,
          "usfm": "JOL.3.11",
          "line_type": "p",
          "text": "ای همهٔ قومها، بشتابید و از هر طرف جمع شوید.»اکنون ای خداوند، جنگاوران خود را فرود آر!"
        },
        {
          "verse": 12,
          "usfm": "JOL.3.12",
          "line_type": "p",
          "text": "خداوند می‌فرماید: «قومها جمع شوند و به درهٔ یهوشافاط بیایند، چون من در آنجا نشسته، همه را داوری خواهم کرد."
        },
        {
          "verse": 13,
          "usfm": "JOL.3.13",
          "line_type": "p",
          "text": "داسها را آماده کنید، زیرا محصول رسیده و آماده است. انگورهای داخل چرخشت را با پا له کنید، چون از شرارت این مردم لبریز شده است.»"
        },
        {
          "verse": 14,
          "usfm": "JOL.3.14",
          "line_type": "p",
          "text": "مردم دسته‌دسته در درهٔ یهوشافاط جمع می‌شوند، زیرا در آنجا روز خداوند به‌زودی فرا خواهد رسید."
        },
        {
          "verse": 15,
          "usfm": "JOL.3.15",
          "line_type": "p",
          "text": "آفتاب و ماه تاریک می‌شوند و ستاره‌ها دیگر نمی‌درخشند."
        },
        {
          "verse": 16,
          "usfm": "JOL.3.16",
          "line_type": "p",
          "text": "خداوند از اورشلیم فریاد برمی‌آورد. آسمان و زمین می‌لرزند؛ اما خداوند همچنان پناهگاه و قلعهٔ قوم خود اسرائیل خواهد بود."
        },
        {
          "verse": 17,
          "usfm": "JOL.3.17",
          "line_type": "p",
          "text": "«آنگاه خواهید دانست که من یهوه خدای شما، در کوه مقدّس خود صهیون، ساکنم. اورشلیم برای همیشه از آن من خواهد بود و زمانی می‌رسد که دیگر هیچ سپاه بیگانه‌ای از آن گذر نخواهد کرد."
        },
        {
          "verse": 18,
          "usfm": "JOL.3.18",
          "line_type": "p",
          "text": "«از کوهها شراب تازه خواهد چکید و از بلندیها شیر جاری خواهد شد. نهرهای خشک یهودا از آب پر خواهند شد و از خانهٔ خداوند چشمه‌ای خواهد جوشید تا درهٔ شطیم را سیراب سازد."
        },
        {
          "verse": 19,
          "usfm": "JOL.3.19",
          "line_type": "p",
          "text": "مصر و ادوم هر دو به سبب ظلمی که به سرزمین یهودا کردند از بین خواهند رفت، زیرا مردم بی‌گناه آنجا را کشتند."
        },
        {
          "verse": 20,
          "usfm": "JOL.3.20",
          "line_type": "p",
          "text": "«ولی یهودا و اورشلیم تا به ابد پایدار خواهند ماند."
        },
        {
          "verse": 21,
          "usfm": "JOL.3.21",
          "line_type": "p",
          "text": "من انتقام خون قوم خود را خواهم گرفت و از تقصیر کسانی که بر آنها ظلم کردند، نخواهم گذشت. من در اورشلیم با قوم خود ساکن خواهم شد.»"
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 16,
          "text": "برکت خداوند بر اسرائیل"
        }
      ],
