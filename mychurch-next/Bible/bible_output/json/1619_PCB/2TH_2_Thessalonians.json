    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 2,
      "chapter_usfm": "2TH.2",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.2.1",
          "line_type": "p",
          "text": "حال، ای ایمانداران عزیز، بگذارید موضوعاتی را دربارهٔ بازگشت خداوند ما عیسی مسیح، و نحوۀ جمع شدن ما به نزد او را روشن سازیم: استدعا می‌کنیم"
        },
        {
          "verse": 2,
          "usfm": "2TH.2.2",
          "line_type": "p",
          "text": "اجازه ندهید از سوی آنانی که می‌گویند روز خداوند از هم اکنون آغاز شده، به آسانی پریشان‌خاطر و دچار تزلزل فکری گردید. گفته‌های ایشان را باور نکنید، حتی اگر ادعا کنند نبوّت یا مکاشفه‌ای داشته‌اند، یا اینکه به نامه‌ای استناد کنند که گویی از جانب ما بوده است."
        },
        {
          "verse": 3,
          "usfm": "2TH.2.3",
          "line_type": "p",
          "text": "اجازه ندهید کسی به هیچ وجه شما را بفریبد، زیرا آن روز فرا نخواهد رسید، مگر اینکه اول ارتداد و طغیانی برضد خدا بر پا شود، و آن مرد قانون‌شکن ظهور کند، همان کسی که محکوم به هلاکت در جهنم است."
        },
        {
          "verse": 4,
          "usfm": "2TH.2.4",
          "line_type": "p",
          "text": "او با هر چه خدا خوانده می‌شود و مورد پرستش قرار می‌گیرد، مخالفت خواهد نمود. حتی وارد معبد خواهد شد، و در آنجا نشسته، ادعا خواهد کرد که خداست."
        },
        {
          "verse": 5,
          "usfm": "2TH.2.5",
          "line_type": "p",
          "text": "آیا به یاد ندارید که وقتی نزد شما بودم، این را می‌گفتم؟"
        },
        {
          "verse": 6,
          "usfm": "2TH.2.6",
          "line_type": "p",
          "text": "خودتان می‌دانید چه چیزی مانع آمدن اوست؛ زیرا او فقط زمانی می‌تواند ظهور کند که وقتش رسیده باشد."
        },
        {
          "verse": 7,
          "usfm": "2TH.2.7",
          "line_type": "p",
          "text": "و اما آن بی‌دینی هم اکنون نیز مخفیانه عمل می‌کند، و همچنان مخفی خواهد ماند تا آن کسی که مانع اوست، از سر راه کنار برود."
        },
        {
          "verse": 8,
          "usfm": "2TH.2.8",
          "line_type": "p",
          "text": "آنگاه آن مرد خبیث ظهور خواهد کرد. اما خداوند ما عیسی به هنگام بازگشت خود، او را با نَفَس دهان خویش هلاک کرده، با حضور خود نابود خواهد ساخت."
        },
        {
          "verse": 9,
          "usfm": "2TH.2.9",
          "line_type": "p",
          "text": "این مرد خبیث به‌وسیلۀ قدرت شیطان ظهور خواهد کرد و آلت دست او خواهد بود؛ او با کارهای عجیب و حیرت‌انگیز خود همه را فریب داده، معجزات بزرگ انجام خواهد داد."
        },
        {
          "verse": 10,
          "usfm": "2TH.2.10",
          "line_type": "p",
          "text": "کسانی که فریب او را می‌خورند، آنانی هستند که راه راست را رد کرده و راه جهنم را در پیش گرفته‌اند. ایشان حقیقت را دوست ندارند و آن را نمی‌پذیرند تا نجات یابند."
        },
        {
          "verse": 11,
          "usfm": "2TH.2.11",
          "line_type": "p",
          "text": "از این رو، خدا اجازه خواهد داد فریب خورده، گمراه شوند، و این دروغها را باور کنند."
        },
        {
          "verse": 12,
          "usfm": "2TH.2.12",
          "line_type": "p",
          "text": "در نتیجه، تمام کسانی که دروغ را می‌پذیرند و راستی را رد می‌کنند و از شرارت شاد می‌شوند، به حق محکوم خواهند شد."
        },
        {
          "verse": 13,
          "usfm": "2TH.2.13",
          "line_type": "p",
          "text": "اما ای برادران و ای محبوبان خدا، ما باید همیشه برای وجود شما خدا را شکر کنیم، زیرا خدا از همان ابتدا شما را برگزید تا نجات بخشد و به‌وسیلۀ قدرت روح پاکش و ایمانتان به راستی، شما را پاک سازد."
        },
        {
          "verse": 14,
          "usfm": "2TH.2.14",
          "line_type": "p",
          "text": "به همین منظور، او مژدهٔ نجات را به‌وسیلۀ ما به شما رساند و از طریق ما، شما را دعوت کرد تا در جلال خداوند ما عیسی مسیح شریک گردید."
        },
        {
          "verse": 15,
          "usfm": "2TH.2.15",
          "line_type": "p",
          "text": "پس ای برادران و خواهران عزیز، با توجه به این مطالب، استوار باشید و به حقایقی که حضوراً و یا توسط نامه‌هایمان به شما آموختیم، محکم بچسبید."
        },
        {
          "verse": 16,
          "usfm": "2TH.2.16",
          "line_type": "p",
          "text": "خود خداوند ما عیسی مسیح و پدر ما خدا، که ما را محبت نمود و از روی لطف بی‌پایان خویش، تسلی و امید جاودانی به ما بخشید،"
        },
        {
          "verse": 17,
          "usfm": "2TH.2.17",
          "line_type": "p",
          "text": "دلهای شما را تسلی عطا کند و شما را نیرو بخشد تا همواره کردار و گفتارتان نیک باشد."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 13,
          "text": "ایمانداران باید پایدار بمانند"
        }
      ],
