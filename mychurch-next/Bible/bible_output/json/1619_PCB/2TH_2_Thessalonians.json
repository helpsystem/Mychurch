  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TH",
      "chapter": 1,
      "chapter_usfm": "2TH.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TH.1.1",
          "line_type": "p",
          "text": "این نامه از طرف پولس، سیلاس و تیموتائوس است.این نامه را به شما کلیسای تسالونیکیان که در پدر ما خدا و خداوند ما عیسی مسیح محفوظ هستید، می‌نویسیم."
        },
        {
          "verse": 2,
          "usfm": "2TH.1.2",
          "line_type": "p",
          "text": "از پدرمان خدا و خداوندمان عیسی مسیح، خواستار فیض و آرامش برای شما هستیم."
        },
        {
          "verse": 3,
          "usfm": "2TH.1.3",
          "line_type": "p",
          "text": "برادران عزیز، موظفیم همواره خدا را برای وجود شما شکر نماییم. بله، شایسته است که چنین کنیم، زیرا ایمان شما به گونه‌ای چشمگیر رشد کرده، و محبت شما نسبت به یکدیگر بسیار زیاد شده است."
        },
        {
          "verse": 4,
          "usfm": "2TH.1.4",
          "line_type": "p",
          "text": "به هر کلیسایی که می‌رویم، به وجود شما افتخار می‌کنیم و برای ایشان بیان می‌نماییم که چگونه شما با وجود مشکلات طاقت‌فرسا و آزار و اذیتها، شکیبایی و ایمان کامل به خدا را حفظ کرده‌اید."
        },
        {
          "verse": 5,
          "usfm": "2TH.1.5",
          "line_type": "p",
          "text": "این آزار و اذیتها نشان می‌دهند که راههای خدا منصفانه و عادلانه است، زیرا او به‌وسیلۀ این زحمات و رنجها، از یک طرف شما را برای ملکوت خود آماده می‌کند،"
        },
        {
          "verse": 6,
          "usfm": "2TH.1.6",
          "line_type": "p",
          "text": "و از طرف دیگر تنبیه و مجازات را برای آنانی که شما را زجر می‌دهند مهیا می‌سازد."
        },
        {
          "verse": 7,
          "usfm": "2TH.1.7",
          "line_type": "p",
          "text": "بنابراین، به شما که رنج و آزار می‌بینید، اعلام می‌دارم که وقتی عیسای خداوند به ناگاه در میان شعله‌های آتش با فرشتگان نیرومند خود از آسمان ظاهر شود، خدا به ما و به شما آسودگی خواهد بخشید؛"
        },
        {
          "verse": 8,
          "usfm": "2TH.1.8",
          "line_type": "p",
          "text": "اما آنانی را که از شناختن خدا و پذیرش خدا و پذیرش نقشهٔ نجات او توسط عیسی مسیح سر باز می‌زنند، مجازات خواهد کرد."
        },
        {
          "verse": 9,
          "usfm": "2TH.1.9",
          "line_type": "p",
          "text": "ایشان به مجازات جاودانی خواهند رسید، و تا ابد از حضور خداوند دور خواهند ماند و هرگز شکوه و عظمت قدرت او را نخواهند دید."
        },
        {
          "verse": 10,
          "usfm": "2TH.1.10",
          "line_type": "p",
          "text": "بله، این رویدادها در روز بازگشت او واقع خواهد شد، روزی که قوم او و مؤمنین او، ستایش و تحسین را نثار او کنند. در آن روز شما نیز در میان ستایش‌کنندگان او خواهید بود، زیرا به شهادتی که ما دربارهٔ او دادیم، ایمان آوردید."
        },
        {
          "verse": 11,
          "usfm": "2TH.1.11",
          "line_type": "p",
          "text": "پس ما به دعای خود برای شما ادامه می‌دهیم تا خدا شما را یاری دهد که رفتارتان شایسته دعوت الهی باشد، و به آرزوهای نیکی که دارید، جامهٔ عمل بپوشاند، و با قدرت خود اعمال شما را که از ایمان سرچشمه می‌گیرد، کامل کند."
        },
        {
          "verse": 12,
          "usfm": "2TH.1.12",
          "line_type": "p",
          "text": "آنگاه مردم با مشاهده اعمال شما، نام خداوند ما عیسی مسیح را ستایش و تمجید خواهند کرد؛ شما نیز به سبب تعلق به او، عزت و حرمت خواهید یافت. بدانید که لطف و فیض خدای ما و خداوند ما عیسی مسیح همهٔ این امتیازات را برای شما فراهم آورده است."
        }
      ],
      "verse_count": 12,
      "headings": [
        {
          "before_verse": 3,
          "text": "شکرگزاری و دعا"
        }
      ],
