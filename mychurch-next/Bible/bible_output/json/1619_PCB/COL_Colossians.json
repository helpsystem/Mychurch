    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 3,
      "chapter_usfm": "COL.3",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.3.1",
          "line_type": "p",
          "text": "اکنون که همراه مسیح برای حیاتی نو برخیزانده شده‌اید، مشتاق امور آسمانی باشید، همان جا که مسیح است و بر دست راست خدا نشسته است."
        },
        {
          "verse": 2,
          "usfm": "COL.3.2",
          "line_type": "p",
          "text": "همواره به آنچه در آسمان است بیندیشید، و به امور این دنیای زودگذر دل نبندید."
        },
        {
          "verse": 3,
          "usfm": "COL.3.3",
          "line_type": "p",
          "text": "به این دنیای فانی همانقدر دل ببندید که یک شخص مرده دل می‌بندد! زیرا زندگی واقعی شما در آسمان است، همراه مسیح در حضور خدا!"
        },
        {
          "verse": 4,
          "usfm": "COL.3.4",
          "line_type": "p",
          "text": "وقتی مسیح که زندگی واقعی ماست بازگردد، شما نیز با او خواهید درخشید و در جلال و شکوه او شریک خواهید شد."
        },
        {
          "verse": 5,
          "usfm": "COL.3.5",
          "line_type": "p",
          "text": "پس به گناهان این دنیا نزدیک نشوید؛ هوسهای ناپاک را که در وجودتان کمین می‌کنند، نابود سازید؛ هرگز خود را با گناهانی چون بی‌عفتی، ناپاکی، شهوترانی و هوسهای ننگین دیگر آلوده نکنید. به چیزهای خوش‌ظاهر این دنیا نیز طمع نورزید، چون طمع نوعی بت‌پرستی است."
        },
        {
          "verse": 6,
          "usfm": "COL.3.6",
          "line_type": "p",
          "text": "آنانی که مرتکب چنین اعمالی می‌شوند، یقیناً گرفتار خشم و غضب خدا خواهند شد."
        },
        {
          "verse": 7,
          "usfm": "COL.3.7",
          "line_type": "p",
          "text": "شما نیز زمانی که هنوز به این دنیای گناه‌آلود تعلق داشتید، اسیر همین عادتهای شرم‌آور بودید."
        },
        {
          "verse": 8,
          "usfm": "COL.3.8",
          "line_type": "p",
          "text": "اما اکنون وقت آن است که خشم و کینه و فحش و سخنان زشت را همچون جامه‌ای پوسیده از تن خود درآورید و دور بیندازید."
        },
        {
          "verse": 9,
          "usfm": "COL.3.9",
          "line_type": "p",
          "text": "به یکدیگر دروغ نگویید، زیرا آن طبیعت کهنه و فاسد شما که دروغ می‌گفت، دیگر مرده و از بین رفته است؛"
        },
        {
          "verse": 10,
          "usfm": "COL.3.10",
          "line_type": "p",
          "text": "و اکنون زندگی کاملاً تازه‌ای را در پیش گرفته‌اید، که طی آن در شناخت راستی ترقی می‌کنید و می‌کوشید هر روز بیشتر شبیه مسیح، خالق این زندگی تازه شوید."
        },
        {
          "verse": 11,
          "usfm": "COL.3.11",
          "line_type": "p",
          "text": "در این زندگی تازه، دیگر نه مهم است یهودی باشید یا غیریهودی، ختنه شده یا ختنه‌ناشده، بَربَر یا سَکایی، برده یا آزاد؛ چون تنها چیزی که اهمیت دارد، مسیح است، که در همۀ ما زندگی می‌کند."
        },
        {
          "verse": 12,
          "usfm": "COL.3.12",
          "line_type": "p",
          "text": "حال که خدا شما را برگزیده تا قوم مقدّسی باشید که مورد محبت اوست، پس جامۀ شفقت و دلسوزی، مهربانی، فروتنی، ملایمت و بردباری را بر تن کنید،"
        },
        {
          "verse": 13,
          "usfm": "COL.3.13",
          "line_type": "p",
          "text": "و رفتار دیگران را تحمل کنید و آماده باشید تا ایشان را ببخشید. هرگز از یکدیگر کینه به دل نگیرید. از یاد نبرید که مسیح شما را بخشیده است؛ پس شما نیز باید دیگران را ببخشید."
        },
        {
          "verse": 14,
          "usfm": "COL.3.14",
          "line_type": "p",
          "text": "مهمتر از همه، بگذارید محبت هادی زندگی شما باشد، زیرا محبت عامل همبستگی کامل مسیحیان است."
        },
        {
          "verse": 15,
          "usfm": "COL.3.15",
          "line_type": "p",
          "text": "بگذارید آرامشی که مسیح می‌بخشد، همواره بر دلهای شما مسلط باشد، چون همهٔ ما باید مانند اعضای یک بدن، در هماهنگی و صفا زندگی کنیم. در ضمن، همیشه شکرگزار باشید."
        },
        {
          "verse": 16,
          "usfm": "COL.3.16",
          "line_type": "p",
          "text": "بگذارید کلام مسیح به کمال در میان شما ساکن گردد. با مزامیر، سرودها و نغمه‌های روحانی و با تمام حکمتی که او به شما عطا می‌کند، به یکدیگر تعلیم و اندرز دهید و با قلبی شکرگزار برای خدا بسرایید."
        },
        {
          "verse": 17,
          "usfm": "COL.3.17",
          "line_type": "p",
          "text": "هرآنچه می‌کنید و هر سخنی که بر زبان می‌آورید، همه را به نام عیسای خداوند انجام دهید، و از طریق او خدای پدر را سپاس گویید."
        },
        {
          "verse": 18,
          "usfm": "COL.3.18",
          "line_type": "p",
          "text": "ای زنان، از شوهران خود اطاعت کنید، زیرا این خواست خداوند است."
        },
        {
          "verse": 19,
          "usfm": "COL.3.19",
          "line_type": "p",
          "text": "ای شوهران، همسران خود را محبت نمایید و با ایشان تندی و تلخی نکنید."
        },
        {
          "verse": 20,
          "usfm": "COL.3.20",
          "line_type": "p",
          "text": "ای فرزندان، همیشه مطیع والدین خود باشید، زیرا این خداوند را خشنود می‌سازد."
        },
        {
          "verse": 21,
          "usfm": "COL.3.21",
          "line_type": "p",
          "text": "و شما پدران، فرزندانتان را آنقدر سرزنش نکنید که دلسرد و دل شکسته شوند."
        },
        {
          "verse": 22,
          "usfm": "COL.3.22",
          "line_type": "p",
          "text": "ای غلامان، در هر امری مطیع اربابان خود در این دنیا باشید. نه تنها در حضور ایشان به وظایف خود خوب عمل کنید، بلکه به سبب محبت و احترامتان به مسیح، همیشه از صمیم قلب خدمت نمایید."
        },
        {
          "verse": 23,
          "usfm": "COL.3.23",
          "line_type": "p",
          "text": "هر کاری را از جان و دل انجام دهید، درست مانند اینکه برای مسیح کار می‌کنید، نه برای انسان."
        },
        {
          "verse": 24,
          "usfm": "COL.3.24",
          "line_type": "p",
          "text": "فراموش نکنید که شما پاداشتان را از مسیح خداوند دریافت خواهید کرد، یعنی همان میراثی را که برای شما نگاه داشته است، زیرا شما در واقع غلام مسیح هستید."
        },
        {
          "verse": 25,
          "usfm": "COL.3.25",
          "line_type": "p",
          "text": "هر که کار خطایی مرتکب شود، مکافات خطایش را خواهد یافت، زیرا خدا استثنا قائل نمی‌شود."
        }
      ],
      "verse_count": 25,
      "headings": [
        {
          "before_verse": 18,
          "text": "رفتار تازه"
        }
      ],
