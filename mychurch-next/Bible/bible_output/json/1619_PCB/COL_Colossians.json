  "chapters": [
    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 1,
      "chapter_usfm": "COL.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.1.1",
          "line_type": "p",
          "text": "این نامه از طرف پولس است که به ارادۀ خدا، رسول مسیحْ عیسی می‌باشد، و از طرف برادر ما تیموتائوس."
        },
        {
          "verse": 2,
          "usfm": "COL.1.2",
          "line_type": "p",
          "text": "این نامه را به قوم مقدّس خدا در شهر کولسی که برادران و خواهران وفادار در مسیح هستند، می‌نویسیم.از خدا، پدر ما، خواستار فیض و آرامش برای شما هستیم."
        },
        {
          "verse": 3,
          "usfm": "COL.1.3",
          "line_type": "p",
          "text": "هرگاه برای شما دعا می‌کنیم، ابتدا خدا را که پدر خداوند ما عیسی مسیح است، برای وجود شما شکر می‌کنیم،"
        },
        {
          "verse": 4,
          "usfm": "COL.1.4",
          "line_type": "p",
          "text": "زیرا وصف ایمان شما به مسیح عیسی و محبتی را که به همۀ ایمانداران او نشان می‌دهید، شنیده‌ایم."
        },
        {
          "verse": 5,
          "usfm": "COL.1.5",
          "line_type": "p",
          "text": "علّت این ایمان و محبت شما این است که از همان ابتدا که پیغام راستین انجیل را شنیدید، به شادیهای آسمانی دل بستید."
        },
        {
          "verse": 6,
          "usfm": "COL.1.6",
          "line_type": "p",
          "text": "همین پیغام که به شما رسید، به سرتاسر دنیا نیز می‌رسد، و در همه جا با دگرگون ساختن زندگی مردمان، ثمر می‌آوَرَد، همان‌طور که زندگی شما را دگرگون ساخت، از همان روزی که آن را شنیدید و حقیقت را دربارۀ فیض خدا درک کردید."
        },
        {
          "verse": 7,
          "usfm": "COL.1.7",
          "line_type": "p",
          "text": "خدمتگزار امین عیسی مسیح، یعنی اِپافراس که پیغام انجیل را به شما رساند و اکنون از طرف شما با ما همکار و همخدمت است،"
        },
        {
          "verse": 8,
          "usfm": "COL.1.8",
          "line_type": "p",
          "text": "ما را آگاه ساخت که روح‌القدس چه محبت عمیقی در دل شما نسبت به دیگران قرار داده است."
        },
        {
          "verse": 9,
          "usfm": "COL.1.9",
          "line_type": "p",
          "text": "بنابراین، از آن روز که این خبر را شنیدیم، دائماً دعا می‌کنیم و از خدا می‌طلبیم که به شما یاری کند تا خواست و ارادهٔ او را دریابید، و به شما حکمت عطا فرماید تا امور روحانی را درک کنید؛"
        },
        {
          "verse": 10,
          "usfm": "COL.1.10",
          "line_type": "p",
          "text": "تا به این ترتیب، رفتاری شایستۀ خداوند و زندگی خداپسندانه‌ای داشته باشید، به گونه‌ای که در هر کار نیک ثمر بیاورید و در شناخت خدا رشد کنید."
        },
        {
          "verse": 11,
          "usfm": "COL.1.11",
          "line_type": "p",
          "text": "همچنین، دعا می‌کنیم که از قدرت پرجلال خدا لبریز شوید تا صبر و تحمل بسیار داشته باشید و با شادی"
        },
        {
          "verse": 12,
          "usfm": "COL.1.12",
          "line_type": "p",
          "text": "همواره پدر آسمانی را سپاس گویید که ما را شایستهٔ آن ساخت تا در میراث قوم خود که در قلمرو نور زندگی می‌کنند، سهیم شویم."
        },
        {
          "verse": 13,
          "usfm": "COL.1.13",
          "line_type": "p",
          "text": "او ما را از دنیای تاریک شیطان نجات داد و به ملکوت پسر عزیزش منتقل ساخت،"
        },
        {
          "verse": 14,
          "usfm": "COL.1.14",
          "line_type": "p",
          "text": "همان که از طریق خونش رهایی و آمرزش گناهان را دریافت کردیم."
        },
        {
          "verse": 15,
          "usfm": "COL.1.15",
          "line_type": "p",
          "text": "او چهرهٔ دیدنی خدای نادیدنی و نخست‌زادۀ تمامی آفرینش است."
        },
        {
          "verse": 16,
          "usfm": "COL.1.16",
          "line_type": "p",
          "text": "در واقع، تمام هستی به‌وسیلۀ عیسی مسیح به وجود آمد، یعنی هر آنچه در آسمان و بر زمین است، دیدنی و نادیدنی؛ عالم روحانی با فرمانروایان و تاج و تخت ایشان، و فرماندهان و بزرگانشان، همه به‌وسیلۀ مسیح و برای جلال او آفریده شدند."
        },
        {
          "verse": 17,
          "usfm": "COL.1.17",
          "line_type": "p",
          "text": "پیش از آنکه چیزی به وجود آید، او وجود داشت، و قدرت اوست که همه چیز را در عالم هستی در هماهنگی با یکدیگر نگاه می‌دارد."
        },
        {
          "verse": 18,
          "usfm": "COL.1.18",
          "line_type": "p",
          "text": "او سرِ بدن است، که همان کلیسا باشد. او سرآغاز است، و نخست‌زادۀ آنانی است که به قیامت از مردگان می‌رسند، تا بدین‌سان، او در همه چیز مُقدّم باشد."
        },
        {
          "verse": 19,
          "usfm": "COL.1.19",
          "line_type": "p",
          "text": "زیرا خدا اراده فرمود که الوهیت کاملش در وجود پسرش ساکن گردد."
        },
        {
          "verse": 20,
          "usfm": "COL.1.20",
          "line_type": "p",
          "text": "او به‌واسطۀ مسیح، همه چیز را با خود آشتی داد، چه چیزهایی که بر روی زمین‌اند و چه چیزهایی که در آسمان هستند، و با خون او که بر صلیب ریخته شد، صلح و آشتی را فراهم ساخت."
        },
        {
          "verse": 21,
          "usfm": "COL.1.21",
          "line_type": "p",
          "text": "این صلح و آشتی شامل حال شما نیز می‌شود، شما که زمانی از خدا دور بودید، و در ذهن خود با او دشمنی می‌کردید، چرا که اعمالتان شریرانه بود."
        },
        {
          "verse": 22,
          "usfm": "COL.1.22",
          "line_type": "p",
          "text": "اما اکنون خدا شما را با خود آشتی داده است. این آشتی از طریق مرگ مسیح، مرگ بدن جسمانی‌اش، امکان‌پذیر شده است. در نتیجهٔ این فداکاری است که مسیح، شما را مقدّس گردانیده و به پیشگاه خدا آورده است. اکنون شما مقدّس و بی‌عیب و بَری از هر محکومیتی در حضور خدا ایستاده‌اید."
        },
        {
          "verse": 23,
          "usfm": "COL.1.23",
          "line_type": "p",
          "text": "اما این به شرطی میسّر می‌گردد که همواره در ایمان به این حقیقت استوار باشید و در آن ثابت‌قدم بمانید، و نگذارید امیدی که در پیام انجیل نهفته است، متزلزل شود. این همان انجیلی است که به گوش شما رسید و اکنون نیز به هر مخلوقی در زیر آسمان اعلان می‌شود، و من پولس، خدمتگزار آن شده‌ام."
        },
        {
          "verse": 24,
          "usfm": "COL.1.24",
          "line_type": "p",
          "text": "اکنون رنجی که به خاطر شما متحمل می‌شوم، موجب شادی من است، و من در بدن خود، رنجهایی را که لازمۀ خدمت به مسیح است، به خاطر بدن او، یعنی کلیسا، تکمیل می‌کنم."
        },
        {
          "verse": 25,
          "usfm": "COL.1.25",
          "line_type": "p",
          "text": "همچنین، من از سوی خدا مأموریت یافته‌ام تا کلیسایش را خدمت کنم و کلام او را در کمالش به شما اعلان نمایم،"
        },
        {
          "verse": 26,
          "usfm": "COL.1.26",
          "line_type": "p",
          "text": "یعنی این راز را که طی اعصار و نسلهای متمادی مخفی نگاه داشته شده بود، اما اکنون بر مقدّسین او آشکار گردیده است."
        },
        {
          "verse": 27,
          "usfm": "COL.1.27",
          "line_type": "p",
          "text": "زیرا خدا بر آن شد که ایشان دریابند که غنای پرجلال مسیح برای شما غیریهودیان نیز هست. و آن راز این است: «مسیح در وجود شما، امید پرشکوه شماست!»"
        },
        {
          "verse": 28,
          "usfm": "COL.1.28",
          "line_type": "p",
          "text": "پس کسی را که درباره‌اش موعظه می‌کنیم، مسیح است، و به هر کس هشدار می‌دهیم و به او به کمک تمام حکمتی که خدا به ما داده، تعلیم می‌دهیم تا بتوانیم هر کس را در مسیحْ عیسی به بلوغ روحانی کامل برسانیم و به حضور خدا تقدیم کنیم."
        },
        {
          "verse": 29,
          "usfm": "COL.1.29",
          "line_type": "p",
          "text": "کار من همین است و در این راه زحمت می‌کشم، و با تمام نیرویی که مسیح عطا می‌کند، در این زمینه تلاش و کوشش می‌کنم."
        }
      ],
      "verse_count": 29,
      "headings": [
        {
          "before_verse": 3,
          "text": "سپاسگزاری و دعا"
        },
        {
          "before_verse": 15,
          "text": "مسیح که بود و چه کرد؟"
        },
        {
          "before_verse": 24,
          "text": "زحمات پولس برای کلیسا"
        }
      ],
