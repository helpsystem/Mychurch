    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 4,
      "chapter_usfm": "COL.4",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.4.1",
          "line_type": "p",
          "text": "شما اربابان نیز باید با عدل و انصاف با غلامان خود رفتار کنید. فراموش نکنید که خود شما نیز در آسمان ارباب دارید که همیشه ناظر بر رفتار شماست."
        },
        {
          "verse": 2,
          "usfm": "COL.4.2",
          "line_type": "p",
          "text": "با ذهنی هوشیار و دلی شکرگزار، خود را وقف دعا کنید."
        },
        {
          "verse": 3,
          "usfm": "COL.4.3",
          "line_type": "p",
          "text": "برای ما نیز دعا کنید تا خدا فرصت‌های بسیاری ایجاد کند و بتوانیم راز مسیح را اعلان کنیم. در واقع، به همین دلیل است که در اینجا در حبس به سر می‌برم."
        },
        {
          "verse": 4,
          "usfm": "COL.4.4",
          "line_type": "p",
          "text": "دعا کنید که جرأت کافی داشته باشم تا این پیغام را آزادانه و تمام و کمال بیان نمایم."
        },
        {
          "verse": 5,
          "usfm": "COL.4.5",
          "line_type": "p",
          "text": "از هر فرصت نهایت استفاده را بکنید تا پیغام انجیل را به دیگران برسانید، و بدانید چگونه با کسانی که هنوز ایمان نیاورده‌اند، عاقلانه رفتار نمایید."
        },
        {
          "verse": 6,
          "usfm": "COL.4.6",
          "line_type": "p",
          "text": "گفتگوی شما همیشه پر از فیض و خوشایند بوده، و با نمک اصلاح شده باشد، تا بدانید به هر کس چگونه پاسخ دهید."
        },
        {
          "verse": 7,
          "usfm": "COL.4.7",
          "line_type": "p",
          "text": "برادر عزیزمان تیخیکوس، شما را از وضع من آگاه خواهد ساخت؛ او خدمتگزار وفادار مسیح و همخدمت من است."
        },
        {
          "verse": 8,
          "usfm": "COL.4.8",
          "line_type": "p",
          "text": "او را فقط به همین منظور نزد شما می‌فرستم، تا از چگونگی حال ما باخبر شوید و با شنیدن سخنان او دلگرم و تشویق گردید."
        },
        {
          "verse": 9,
          "usfm": "COL.4.9",
          "line_type": "p",
          "text": "در ضمن اونیسیموس را نیز همراه او می‌فرستم که برادر عزیز ما و از خود شماست. این دو برادر، شما را در جریان همهٔ وقایع اینجا خواهند گذاشت."
        },
        {
          "verse": 10,
          "usfm": "COL.4.10",
          "line_type": "p",
          "text": "اَرِستَرخوس که با من در زندان است، و مرقُس پسر عموی برنابا، به شما سلام می‌رسانند. همان‌گونه که قبلاً هم سفارش کرده‌ام، هرگاه مرقس نزد شما آید، از او به گرمی پذیرایی کنید."
        },
        {
          "verse": 11,
          "usfm": "COL.4.11",
          "line_type": "p",
          "text": "یسوع یوستوس نیز سلام می‌رساند. از مسیحیان یهودی‌نژاد، فقط همین چند نفر در اینجا با من خدا را خدمت می‌کنند، و خدا می‌داند که چقدر باعث دلگرمی من شده‌اند!"
        },
        {
          "verse": 12,
          "usfm": "COL.4.12",
          "line_type": "p",
          "text": "اِپافراس، که از خود شما و خدمتگزار عیسی مسیح است به شما سلام می‌رساند. او همیشه با جدیت برای شما دعا می‌کند تا کامل و استوار شوید و در هر امری اراده و خواست خدا را درک کنید."
        },
        {
          "verse": 13,
          "usfm": "COL.4.13",
          "line_type": "p",
          "text": "من شخصاً شاهد هستم که او با چه تلاش و کوششی برای شما و همچنین برای مسیحیان اهل لائودیکیه و هیراپولیس دعا می‌کند."
        },
        {
          "verse": 14,
          "usfm": "COL.4.14",
          "line_type": "p",
          "text": "لوقا پزشک محبوب و همچنین دیماس به شما سلام می‌رسانند."
        },
        {
          "verse": 15,
          "usfm": "COL.4.15",
          "line_type": "p",
          "text": "به برادران ما در لائودیکیه، و به نیمفاس و مؤمنینی که در خانهٔ او برای عبادت جمع می‌شوند، سلام برسانید."
        },
        {
          "verse": 16,
          "usfm": "COL.4.16",
          "line_type": "p",
          "text": "در ضمن، پس از خواندن این نامه، آن را به کلیسای لائودیکیه بفرستید، و نامه‌ای را هم که برای ایشان نوشته‌ام، بگیرید و بخوانید."
        },
        {
          "verse": 17,
          "usfm": "COL.4.17",
          "line_type": "p",
          "text": "به ارخیپوس نیز بگویید: «در انجام خدمتی که خداوند به تو سپرده است، کوشا باش!»"
        },
        {
          "verse": 18,
          "usfm": "COL.4.18",
          "line_type": "p",
          "text": "این چند کلمه را نیز من، پولس، به خط خودم می‌نویسم و درود می‌فرستم: «مرا در این زندان فراموش نکنید! خدا شما را فیض عنایت فرماید.»"
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 2,
          "text": "چند پند روحانی"
        },
        {
          "before_verse": 7,
          "text": "خاتمهٔ نامه"
        }
      ],
