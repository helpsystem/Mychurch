    {
      "schema_version": 6,
      "book_id": "COL",
      "chapter": 2,
      "chapter_usfm": "COL.2",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "COL.2.1",
          "line_type": "p",
          "text": "ای کاش می‌دانستید که من برای شما و ایمانداران لائودیکیه و مسیحیان دیگری که شخصاً مرا ندیده‌اند، با چه سوز دلی دعا می‌کنم."
        },
        {
          "verse": 2,
          "usfm": "COL.2.2",
          "line_type": "p",
          "text": "دعای من این است که همواره دلگرم باشید و به‌وسیلۀ ریسمانهای نیرومند محبت، به یکدیگر بپیوندید و با اطمینان واقعی و درک روشن، به شناخت مسیح دست یابید. زیرا آن راز بزرگ خدا که اکنون آشکار شده است، خود مسیح است."
        },
        {
          "verse": 3,
          "usfm": "COL.2.3",
          "line_type": "p",
          "text": "تمام گنجینه‌های حکمت و معرفت خدا، در مسیح نهفته است."
        },
        {
          "verse": 4,
          "usfm": "COL.2.4",
          "line_type": "p",
          "text": "این را می‌گویم تا کسی نتواند شما را با سخنان و استدلالهای فریبنده، گمراه سازد."
        },
        {
          "verse": 5,
          "usfm": "COL.2.5",
          "line_type": "p",
          "text": "زیرا با اینکه جسماً از شما دورم، اما در روح با شما هستم، و شادمانم از اینکه مشاهده می‌کنم تا چه حد منضبط هستید و ایمانتان به مسیح چقدر مستحکم است."
        },
        {
          "verse": 6,
          "usfm": "COL.2.6",
          "line_type": "p",
          "text": "پس همان‌طور که این اقرار ایمان را پذیرفتید که مسیحْ عیسی، خداوند است، به زندگی کردن در او نیز ادامه بدهید."
        },
        {
          "verse": 7,
          "usfm": "COL.2.7",
          "line_type": "p",
          "text": "در او ریشه بدوانید تا از او قوت بگیرید. بکوشید که همواره در او رشد کنید و در حقایقی که آموخته‌اید، قوی و نیرومند گردید؛ و برای کارهایی که او برای شما انجام داده است، زندگی‌تان لبریز از شادی و شکرگزاری باشد."
        },
        {
          "verse": 8,
          "usfm": "COL.2.8",
          "line_type": "p",
          "text": "هوشیار باشید تا کسی با فلسفه‌های باطل خود، ایمان و شادی روحانی را از شما نگیرد؛ نظریات غلط و پوچ ایشان، بر افکار و عقاید مردم استوار است، نه بر فرمایشات و تعالیم مسیح."
        },
        {
          "verse": 9,
          "usfm": "COL.2.9",
          "line_type": "p",
          "text": "در مسیح طبیعت و ذات الهی، به طور کامل، در یک بدن انسانی ظاهر شده است."
        },
        {
          "verse": 10,
          "usfm": "COL.2.10",
          "line_type": "p",
          "text": "بنابراین، وقتی مسیح را دارید، همه چیز دارید و وجود شما از حضور خدا لبریز است. مسیح در واقع حاکم بر تمامی ریاستها و قدرتهاست."
        },
        {
          "verse": 11,
          "usfm": "COL.2.11",
          "line_type": "p",
          "text": "هنگامی که به مسیح پیوستید، در واقع ختنه نیز شدید، اما نه ختنه‌ای که به دستهای انسانی صورت می‌گیرد، بلکه ختنه‌ای که مسیح انجام می‌دهد، به این گونه که طبیعت گناه‌آلودتان را بُرید و دور انداخت."
        },
        {
          "verse": 12,
          "usfm": "COL.2.12",
          "line_type": "p",
          "text": "زیرا زمانی که تعمید گرفتید، در واقع طبیعت کهنه و گناهکارتان با مسیح مرد و دفن شد؛ سپس با مسیح زنده شدید و حیاتی نوین را آغاز کردید. تمام اینها در اثر این بود که به کلام خدای توانا ایمان آوردید، خدایی که مسیح را پس از مرگ زنده کرد."
        },
        {
          "verse": 13,
          "usfm": "COL.2.13",
          "line_type": "p",
          "text": "زمانی شما در گناهان خود مرده بودید، و هوسهای گناه‌آلود بر وجودتان مسلط بود. اما خدا شما را در حیات مسیح سهیم گرداند، زیرا همهٔ گناهانتان را آمرزید،"
        },
        {
          "verse": 14,
          "usfm": "COL.2.14",
          "line_type": "p",
          "text": "و سند محکومیت شما را که حاکی از نااطاعتی شما بود، از بین برد. خدا نامهٔ اعمالتان را بر صلیب مسیح میخکوب کرد و همه گناهانتان را به حساب او گذاشت."
        },
        {
          "verse": 15,
          "usfm": "COL.2.15",
          "line_type": "p",
          "text": "به این ترتیب، او قدرتها و فرمانروایان روحانی را خلع‌سِلاح کرد، و ایشان را در ملأ عام رسوا ساخت و به‌وسیلۀ صلیب بر آنها پیروز شد."
        },
        {
          "verse": 16,
          "usfm": "COL.2.16",
          "line_type": "p",
          "text": "پس اجازه ندهید کسی شما را به خاطر آنچه می‌خورید یا می‌نوشید، یا در خصوص برگزاری جشنهای مذهبی، عید ماهِ نو یا روز مقدّس شَبّات محکوم سازد."
        },
        {
          "verse": 17,
          "usfm": "COL.2.17",
          "line_type": "p",
          "text": "تمام اینها احکامی موقتی بودند که با آمدن مسیح از اعتبار افتادند. آنها فقط سایه‌ای از آن «واقعیت» بودند که قرار بود بیاید، و آن واقعیت، خود مسیح است."
        },
        {
          "verse": 18,
          "usfm": "COL.2.18",
          "line_type": "p",
          "text": "نگذارید کسی که از فروتنی دروغین و پرستش فرشتگان لذت می‌بَرَد، صلاحیت شما را زیر سؤال ببرد. چنین شخصی به‌افراط وارد جزئیات رؤیاهایی می‌شود که دیده است. ذهن غیرروحانی او سبب می‌شود که به خاطر امور بی‌ارزش و بی‌فایده دچار غرور گردد،"
        },
        {
          "verse": 19,
          "usfm": "COL.2.19",
          "line_type": "p",
          "text": "چرا که ارتباط خود را با مسیح که «سرِ» همهٔ ماست، به کلی از دست داده است. در حالی که اگر ما که «بدن» هستیم، بخواهیم آن طور که خدا مقرر کرده، رشد کنیم، باید به‌وسیلۀ رگ و پی، پیوند خود را با «سر» نگاه داریم."
        },
        {
          "verse": 20,
          "usfm": "COL.2.20",
          "line_type": "p",
          "text": "اکنون که با مسیح نسبت به رابطۀ خود با عناصر و نیروهای روحانی این جهان مرده‌اید، چگونه است که تسلیم قواعد آن می‌شوید، گویی هنوز متعلق به جهان هستید،"
        },
        {
          "verse": 21,
          "usfm": "COL.2.21",
          "line_type": "p",
          "text": "قواعدی که می‌گوید: «این را نخور، آن را نچش، و به این دست نزن!»؟"
        },
        {
          "verse": 22,
          "usfm": "COL.2.22",
          "line_type": "p",
          "text": "اینها قواعد زودگذر انسانی هستند، زیرا خوراک وقتی خورده شد، دیگر تمام شده است!"
        },
        {
          "verse": 23,
          "usfm": "COL.2.23",
          "line_type": "p",
          "text": "این قواعد ممکن است برای بسیاری حکیمانه به نظر برسند، زیرا اجرای آنها نیاز به عباداتی داوطلبانه و سختگیرانه، و فروتنی، و ریاضت بدنی دارد، اما برای تسلط بر افکار و هوسهای شریرانۀ انسان، هیچ فایده‌ای ندارند."
        }
      ],
      "verse_count": 23,
      "headings": [
        {
          "before_verse": 6,
          "text": "هوشیاری در مقابل فلسفه‌های پوچ دنیا"
        }
      ],
