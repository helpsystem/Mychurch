    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 3,
      "chapter_usfm": "1TH.3",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.3.1",
          "line_type": "p",
          "text": "سرانجام، چون من دیدم که بیش از این تحمل دوری شما را ندارم، تصمیم گرفتم در «آتن» تنها بمانم،"
        },
        {
          "verse": 2,
          "usfm": "1TH.3.2",
          "line_type": "p",
          "text": "و «تیموتائوس» را که برادر و همکار ما در خدمت خداست برای اعلان انجیل مسیح، نزد شما بفرستم تا ایمانتان را تقویت کند و شما را دلداری دهد،"
        },
        {
          "verse": 3,
          "usfm": "1TH.3.3",
          "line_type": "p",
          "text": "و نگذارد در اثر سختی‌ها دلسرد شوید؛ گرچه می‌دانید که این سختی‌ها، جزئی از نقشهٔ خدا برای ما می‌باشد."
        },
        {
          "verse": 4,
          "usfm": "1TH.3.4",
          "line_type": "p",
          "text": "همان زمان نیز که نزد شما بودیم، از پیش به شما می‌گفتیم که سختی‌های فراوان به سراغتان خواهد آمد، و همین‌طور هم شد."
        },
        {
          "verse": 5,
          "usfm": "1TH.3.5",
          "line_type": "p",
          "text": "همان‌گونه که گفتم، چون دیگر نمی‌توانستم تحمل کنم که از شما بی‌خبر باشم، بی‌درنگ تیموتائوس را فرستادم تا از استواری ایمانتان یقین حاصل کند. می‌ترسیدم شیطان شما را در وسوسه و آزمایش انداخته باشد و به این ترتیب تمام زحماتی که برای شما کشیده‌ایم، به هدر رفته باشد."
        },
        {
          "verse": 6,
          "usfm": "1TH.3.6",
          "line_type": "p",
          "text": "اما اکنون که تیموتائوس از نزد شما بازگشته است، به ما مژده داده که ایمان و محبت شما به قوت خود باقی است و ما را نیز فراموش نکرده‌اید، و به همان اندازه که ما مشتاق دیدار شما هستیم، شما نیز برای دیدن ما اشتیاق دارید."
        },
        {
          "verse": 7,
          "usfm": "1TH.3.7",
          "line_type": "p",
          "text": "بنابراین ای برادران و خواهران عزیز، با وجود تمام مشکلات و زحماتمان، بسیار دلگرم شدیم، زیرا شنیدیم که در ایمانتان قوی مانده‌اید."
        },
        {
          "verse": 8,
          "usfm": "1TH.3.8",
          "line_type": "p",
          "text": "تا زمانی که شما در ایمان به خداوند استوار باشید، تحمل مشکلات برای ما آسان خواهد بود."
        },
        {
          "verse": 9,
          "usfm": "1TH.3.9",
          "line_type": "p",
          "text": "حقیقتاً نمی‌دانیم برای وجود شما و این همه خوشی و شادی که نصیب ما کرده‌اید چگونه از خدا تشکر کنیم؟"
        },
        {
          "verse": 10,
          "usfm": "1TH.3.10",
          "line_type": "p",
          "text": "روز و شب دائماً با جدّیت دعا می‌کنیم و از خدا می‌خواهیم به ما اجازه دهد که بار دیگر شما را ببینیم تا هر نقصی را که در ایمانتان وجود دارد، برطرف کنیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.3.11",
          "line_type": "p",
          "text": "باشد که پدرمان خدا و خداوندمان عیسی مسیح، بار دیگر ما را به نزد شما بفرستد."
        },
        {
          "verse": 12,
          "usfm": "1TH.3.12",
          "line_type": "p",
          "text": "خداوند محبت شما را چنان فزونی بخشد که بتوانید یکدیگر و دیگران را به شدت محبت کنید، همان‌گونه که ما شما را محبت می‌نماییم؛"
        },
        {
          "verse": 13,
          "usfm": "1TH.3.13",
          "line_type": "p",
          "text": "تا به این ترتیب، پدرمان خدا دل شما را قوی و بی‌گناه و پاک سازد، تا در آن روز که خداوند ما عیسی مسیح با مقدّسین خود باز می‌گردد، در حضور خدا، مقدّس و بی‌عیب بایستید."
        }
      ],
