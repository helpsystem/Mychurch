    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 5,
      "chapter_usfm": "1TH.5",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.5.1",
          "line_type": "p",
          "text": "شاید بپرسید که مسیح در چه زمان باز خواهد گشت. برادران عزیز، لازم نیست در این باره چیزی بنویسم،"
        },
        {
          "verse": 2,
          "usfm": "1TH.5.2",
          "line_type": "p",
          "text": "زیرا شما به خوبی می‌دانید که هیچ‌کس زمان بازگشت او را نمی‌داند. روز خداوند همچون دزد شب، بی‌خبر سر می‌رسد."
        },
        {
          "verse": 3,
          "usfm": "1TH.5.3",
          "line_type": "p",
          "text": "همان وقت که مردم می‌گویند: «همه جا امن و امان است»، ناگهان مصیبت دامنگیرشان خواهد شد، همان‌طور که درد به سراغ زن آبستن می‌آید؛ آنگاه راه فراری برای آنان وجود نخواهد داشت."
        },
        {
          "verse": 4,
          "usfm": "1TH.5.4",
          "line_type": "p",
          "text": "اما برادران عزیز، شما در تاریکی گناه و بی‌خبری نیستید که وقتی روز خداوند سر رسد، غافلگیر شوید، مانند کسی که دزد به او حمله کرده باشد."
        },
        {
          "verse": 5,
          "usfm": "1TH.5.5",
          "line_type": "p",
          "text": "شما همگی فرزندان نور و روز هستید، و با تاریکی و شب کاری ندارید."
        },
        {
          "verse": 6,
          "usfm": "1TH.5.6",
          "line_type": "p",
          "text": "بنابراین، آماده باشید و مانند دیگران به خواب نروید. منتظر بازگشت مسیح باشید و هوشیار بمانید."
        },
        {
          "verse": 7,
          "usfm": "1TH.5.7",
          "line_type": "p",
          "text": "شب، وقت خواب و مستی و بی‌خبری است،"
        },
        {
          "verse": 8,
          "usfm": "1TH.5.8",
          "line_type": "p",
          "text": "ولی ما که در روشنایی روز زندگی می‌کنیم، باید هوشیار باشیم و زره ایمان و محبت را در برکنیم، و امیدِ نجات را همچون کلاهخود بر سر بگذاریم."
        },
        {
          "verse": 9,
          "usfm": "1TH.5.9",
          "line_type": "p",
          "text": "از یاد نبریم که خدا ما را برنگزیده تا زیر غضب خود قرار دهد، بلکه ما را انتخاب نموده تا به‌وسیلهٔ خداوند ما عیسی مسیح نجات دهد."
        },
        {
          "verse": 10,
          "usfm": "1TH.5.10",
          "line_type": "p",
          "text": "او جان خود را فدا کرد تا ما بتوانیم تا ابد با او زندگی کنیم، خواه به هنگام بازگشت او زنده باشیم، خواه نباشیم."
        },
        {
          "verse": 11,
          "usfm": "1TH.5.11",
          "line_type": "p",
          "text": "پس به همین ترتیب، به تشویق و تقویت یکدیگر ادامه دهید."
        },
        {
          "verse": 12,
          "usfm": "1TH.5.12",
          "line_type": "p",
          "text": "ایمانداران عزیز، کسانی را که رهبران شما در کار خداوند هستند، گرامی بدارید. آنها در بین شما سخت تلاش می‌کنند و به شما پند می‌دهند."
        },
        {
          "verse": 13,
          "usfm": "1TH.5.13",
          "line_type": "p",
          "text": "ایشان را به سبب زحماتی که برای شما می‌کشند، با تمام وجود احترام بگذارید و محبت کنید. همچنین با یکدیگر در صلح و صفا به سر ببرید."
        },
        {
          "verse": 14,
          "usfm": "1TH.5.14",
          "line_type": "p",
          "text": "برادران عزیز، اشخاص تنبل و سرکش را تأدیب کنید؛ افراد محجوب و ترسو را دلداری دهید؛ ضعفا را یاری نمایید؛ نسبت به همه، صبر و تحمل را پیشه کنید."
        },
        {
          "verse": 15,
          "usfm": "1TH.5.15",
          "line_type": "p",
          "text": "مواظب باشید بدی را با بدی تلافی نکنید، بلکه بکوشید همواره به یکدیگر و به تمام مردم خوبی کنید."
        },
        {
          "verse": 16,
          "usfm": "1TH.5.16",
          "line_type": "p",
          "text": "همیشه شاد باشید!"
        },
        {
          "verse": 17,
          "usfm": "1TH.5.17",
          "line_type": "p",
          "text": "پیوسته دعا کنید!"
        },
        {
          "verse": 18,
          "usfm": "1TH.5.18",
          "line_type": "p",
          "text": "برای هر پیش آمدی خدا را شکر نمایید، زیرا این است خواست خدا برای شما که از آن عیسی مسیح هستید."
        },
        {
          "verse": 19,
          "usfm": "1TH.5.19",
          "line_type": "p",
          "text": "آتش روح را خاموش نکنید."
        },
        {
          "verse": 20,
          "usfm": "1TH.5.20",
          "line_type": "p",
          "text": "نبوّتها یعنی پیامهایی را که خدا به مؤمنین می‌دهد، کوچک و حقیر نشمارید،"
        },
        {
          "verse": 21,
          "usfm": "1TH.5.21",
          "line_type": "p",
          "text": "بلکه به دقت به آنها گوش فرا دهید، و اگر تشخیص دادید که از جانب خدا هستند، آنها را بپذیرید."
        },
        {
          "verse": 22,
          "usfm": "1TH.5.22",
          "line_type": "p",
          "text": "خود را از هر نوع بدی دور نگاه دارید."
        },
        {
          "verse": 23,
          "usfm": "1TH.5.23",
          "line_type": "p",
          "text": "دعا می‌کنم که خود خدای آرامش، شما را تماماً مقدّس سازد. باشد که روح و جان و بدن شما تا روز بازگشت خداوند ما عیسی مسیح بی‌عیب و استوار بماند."
        },
        {
          "verse": 24,
          "usfm": "1TH.5.24",
          "line_type": "p",
          "text": "همان خدایی که شما را خوانده است تا فرزندان او باشید، طبق وعده‌اش این را نیز برای شما انجام خواهد داد."
        },
        {
          "verse": 25,
          "usfm": "1TH.5.25",
          "line_type": "p",
          "text": "برادران عزیز، برای ما دعا کنید."
        },
        {
          "verse": 26,
          "usfm": "1TH.5.26",
          "line_type": "p",
          "text": "با بوسه‌ای مقدّس به تمام برادران سلام بگویید."
        },
        {
          "verse": 27,
          "usfm": "1TH.5.27",
          "line_type": "p",
          "text": "در نام خداوند از شما می‌خواهم که این نامه را برای همهٔ مؤمنین بخوانید."
        },
        {
          "verse": 28,
          "usfm": "1TH.5.28",
          "line_type": "p",
          "text": "فیض خداوند ما عیسی مسیح با همهٔ شما باشد."
        }
      ],
