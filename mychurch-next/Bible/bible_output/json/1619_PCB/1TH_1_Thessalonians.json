    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 4,
      "chapter_usfm": "1TH.4",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.4.1",
          "line_type": "p",
          "text": "دیگر اینکه، ای برادران و خواهران عزیز، به نام عیسای خداوند از شما استدعا داریم چنان رفتار کنید که خدا را خشنود سازید، چنانکه به شما آموختیم. البته، همین‌گونه نیز رفتار می‌کنید، اما شما را تشویق می‌کنیم تا در این مورد بیشتر تلاش کنید."
        },
        {
          "verse": 2,
          "usfm": "1TH.4.2",
          "line_type": "p",
          "text": "زیرا می‌دانید که به اقتدار عیسای خداوند چه تعالیمی به شما دادیم."
        },
        {
          "verse": 3,
          "usfm": "1TH.4.3",
          "line_type": "p",
          "text": "اراده و خواست خدا این است که مقدّس باشید و از هر نوع گناه جنسی خود را دور نگاه دارید."
        },
        {
          "verse": 4,
          "usfm": "1TH.4.4",
          "line_type": "p",
          "text": "هر یک از شما باید بیاموزد که بدن خود را تحت تسلط درآوَرَد و زندگی خود را در تقدّس و احترام سپری کند."
        },
        {
          "verse": 5,
          "usfm": "1TH.4.5",
          "line_type": "p",
          "text": "نگذارید بدنتان مانند خدانشناسان، اسیر شهوات باشد."
        },
        {
          "verse": 6,
          "usfm": "1TH.4.6",
          "line_type": "p",
          "text": "در ضمن، خواست خدا این است که کسی همنوع خود را فریب ندهد و زن او را تصاحب نکند، زیرا همان‌گونه که قبلاً به شما گفته‌ام، خدا برای این گونه اعمال، انسان را مجازات خواهد کرد."
        },
        {
          "verse": 7,
          "usfm": "1TH.4.7",
          "line_type": "p",
          "text": "زیرا خدا ما را نخوانده است تا ناپاک و شهوت‌ران باشیم، بلکه پاک و مقدّس."
        },
        {
          "verse": 8,
          "usfm": "1TH.4.8",
          "line_type": "p",
          "text": "اگر کسی حاضر نیست مطابق این احکام زندگی کند، بداند که با دستورهای انسان مخالفت نمی‌کند بلکه با احکام خدایی که روح پاکش را به شما بخشیده است."
        },
        {
          "verse": 9,
          "usfm": "1TH.4.9",
          "line_type": "p",
          "text": "اما دربارهٔ محبت پاک و برادرانه که باید در میان قوم خدا وجود داشته باشد، نیازی نمی‌بینم چیزی بنویسم، زیرا خدا خودش به شما آموخته است که یکدیگر را محبت بنمایید."
        },
        {
          "verse": 10,
          "usfm": "1TH.4.10",
          "line_type": "p",
          "text": "البته شما محبت خود را به همۀ ایمانداران مقدونیه نشان داده‌اید؛ با وجود این، ای برادران عزیز، از شما تقاضا می‌کنیم ایشان را بیش از این محبت کنید."
        },
        {
          "verse": 11,
          "usfm": "1TH.4.11",
          "line_type": "p",
          "text": "هدفتان این باشد که زندگی آرامی داشته باشید، و فقط به کارهای خودتان مشغول باشید و با دستهای خود امرار معاش کنید، همان‌گونه که قبلاً هم به شما گفته‌ایم."
        },
        {
          "verse": 12,
          "usfm": "1TH.4.12",
          "line_type": "p",
          "text": "به این ترتیب، غیرمسیحیان نیز به شما اعتماد کرده، احترام خواهند گذاشت. در ضمن، دست نیاز به سوی این و آن دراز نخواهید کرد."
        },
        {
          "verse": 13,
          "usfm": "1TH.4.13",
          "line_type": "p",
          "text": "و اینک برادران عزیز، می‌خواهم که شما از وضعیت ایماندارانی که می‌میرند آگاه باشید، تا وقتی کسی از شما فوت می‌کند، شما نیز مانند آنانی که امیدی به عالم آینده ندارند، در غم و غصه فرو نروید."
        },
        {
          "verse": 14,
          "usfm": "1TH.4.14",
          "line_type": "p",
          "text": "زیرا ما که ایمان داریم عیسی مرد و پس از مرگ زنده شد، باید یقین داشته باشیم که به هنگام بازگشت او، خدا تمام مسیحیانی را که مرده‌اند، همراه وی به این جهان باز خواهد آورد."
        },
        {
          "verse": 15,
          "usfm": "1TH.4.15",
          "line_type": "p",
          "text": "این را من از جانب خداوند می‌گویم: ما که هنگام بازگشت مسیح خداوند زنده باشیم، زودتر از مردگان به آسمان نخواهیم رفت."
        },
        {
          "verse": 16,
          "usfm": "1TH.4.16",
          "line_type": "p",
          "text": "زیرا خودِ خداوند از آسمان فرود خواهد آمد، با فرمانی بلندآوا و صدای رئیس فرشتگان و نوای شیپور فراخوان خدا. آنگاه پیش از همه، مسیحیانی که خوابیده‌اند، برخواهند خاست."
        },
        {
          "verse": 17,
          "usfm": "1TH.4.17",
          "line_type": "p",
          "text": "سپس، ما که هنوز زنده‌ایم و روی زمین باقی هستیم، همراه ایشان در ابرها ربوده خواهیم شد تا همگی، خداوند را در هوا ملاقات کنیم و تا ابد با او باشیم."
        },
        {
          "verse": 18,
          "usfm": "1TH.4.18",
          "line_type": "p",
          "text": "پس با این سخنان، یکدیگر را تشویق کنید و تسلی دهید."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 13,
          "text": "امید رستاخیز مردگان"
        }
      ],
      "footnotes": [
        {
          "verse": 16,
          "usfm": "1TH.4.16",
          "note_ref": "4‏:16",
          "note_type": "footnote",
          "references": [],
          "text": "در عهد جدید، برای اشاره به مرگ ایمانداران، از اصطلاح «خوابیدن» استفاده می‌شود، و از اصطلاح «برخاستن» نیز برای زنده شدن آنان."
        }
      ],
