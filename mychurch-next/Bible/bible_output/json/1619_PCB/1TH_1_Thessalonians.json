    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 2,
      "chapter_usfm": "1TH.2",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.2.1",
          "line_type": "p",
          "text": "برادران و خواهران عزیز، شما خود می‌دانید که آمدن ما نزد شما چقدر مفید و پرثمر بود."
        },
        {
          "verse": 2,
          "usfm": "1TH.2.2",
          "line_type": "p",
          "text": "آگاهید که پیش از آنکه نزد شما بیاییم، در شهر فیلیپی به سبب اعلام پیام انجیل، چقدر با ما بدرفتاری کردند و چقدر آزار و زحمت دیدیم. با این حال، با وجود مخالفت‌های شدید، خدا به ما جرأت داد تا با دلیری، پیغام انجیل را به شما نیز برسانیم."
        },
        {
          "verse": 3,
          "usfm": "1TH.2.3",
          "line_type": "p",
          "text": "پس ملاحظه می‌کنید که پیغام انجیل را نه با انگیزه‌های نادرست و مقاصد ناپاک بلکه با سادگی و خلوص نیت به شما رساندیم."
        },
        {
          "verse": 4,
          "usfm": "1TH.2.4",
          "line_type": "p",
          "text": "در واقع، خدا به ما اعتماد کرده تا به عنوان رسولان او، حقایق انجیل را اعلام نماییم. از این رو، ذره‌ای نیز پیغام خدا را تغییر نمی‌دهیم، حتی اگر به مذاق مردم سازگار نباشد؛ زیرا ما خدمتگزار خدایی هستیم که از تمام نیتهای دلمان باخبر است."
        },
        {
          "verse": 5,
          "usfm": "1TH.2.5",
          "line_type": "p",
          "text": "خودتان آگاهید که ما هرگز سعی نکردیم با چرب‌زبانی، توجه شما را به خود جلب کنیم؛ از روابطمان با شما نیز برای کسب منافع مادی استفاده نکردیم، خدا خودش شاهد است."
        },
        {
          "verse": 6,
          "usfm": "1TH.2.6",
          "line_type": "p",
          "text": "در ضمن، نه از شما و نه از کسی دیگر انتظار احترام و تکریم نداشتیم، گرچه به عنوان رسولان مسیح، این حق را به گردن شما داشتیم."
        },
        {
          "verse": 7,
          "usfm": "1TH.2.7",
          "line_type": "p",
          "text": "اما نه فقط از این حق خود استفاده نکردیم، بلکه مانند یک مادر مهربان از شما مراقبت نمودیم."
        },
        {
          "verse": 8,
          "usfm": "1TH.2.8",
          "line_type": "p",
          "text": "محبت و علاقهٔ ما نسبت به شما آنقدر زیاد بود که نه تنها پیغام خدا را، بلکه جانهای خود را نیز در اختیار شما گذاشتیم."
        },
        {
          "verse": 9,
          "usfm": "1TH.2.9",
          "line_type": "p",
          "text": "برادران عزیز، حتماً به یاد دارید که با چه زحمتی، شب و روز کار می‌کردیم و برای امرار معاش عرق می‌ریختیم، تا وقتی پیغام انجیل خدا را به شما می‌رسانیم، سربار کسی نباشیم."
        },
        {
          "verse": 10,
          "usfm": "1TH.2.10",
          "line_type": "p",
          "text": "شما خودتان شاهدید و خدا نیز گواه است که رفتار ما با هر یک از شما، پاک و بی‌ریا و بی‌عیب بوده است."
        },
        {
          "verse": 11,
          "usfm": "1TH.2.11",
          "line_type": "p",
          "text": "حتماً به خاطر دارید که چگونه مانند یک پدر که فرزند خود را نصیحت می‌کند با شما رفتار کردیم."
        },
        {
          "verse": 12,
          "usfm": "1TH.2.12",
          "line_type": "p",
          "text": "به شما التماس و توصیه می‌کردیم و تشویقتان می‌کردیم که زندگی و رفتارتان شایستۀ خدا باشد، خدایی که شما را دعوت کرده تا در ملکوت و جلال او سهیم گردید."
        },
        {
          "verse": 13,
          "usfm": "1TH.2.13",
          "line_type": "p",
          "text": "همچنین دائماً خدا را شکر می‌کنیم که وقتی پیام خدا را پذیرفتید، همان پیام را که از ما شنیدید، آن را سخنان انسانی نپنداشتید، بلکه گفته‌های ما را به‌عنوان کلام خدا پذیرفتید، که البته چنین نیز هست. و این پیغام همچنان در درون شما که ایمان دارید، عمل می‌کند."
        },
        {
          "verse": 14,
          "usfm": "1TH.2.14",
          "line_type": "p",
          "text": "و پس از آن، همان رنجها و مشکلاتی که بر کلیساهای یهودیه که در مسیح عیسایند، وارد آمد، شما را نیز در برگرفت، زیرا شما از هموطنان خود همان جور و ستمی را دیدید که ایشان از هموطنان یهودی خود دیدند."
        },
        {
          "verse": 15,
          "usfm": "1TH.2.15",
          "line_type": "p",
          "text": "از آنان که انبیای پیشین و حتی عیسای خداوند را کشتند؛ اکنون نیز بی‌رحمانه ما را آزار می‌دهند. آنان هم با خدا مخالفند، هم با انسان؛"
        },
        {
          "verse": 16,
          "usfm": "1TH.2.16",
          "line_type": "p",
          "text": "و می‌کوشند ما را از رساندن پیام خدا به غیریهودیان منع کنند، تا مبادا ایشان نیز به نجات دست یابند. به این ترتیب گناهان این قوم بر روی هم انباشته می‌شود، و سرانجام غضب خدا بر ایشان فرود خواهد آمد."
        },
        {
          "verse": 17,
          "usfm": "1TH.2.17",
          "line_type": "p",
          "text": "برادران عزیز، پس از آنکه مدتی از شما دور شدیم گرچه دلمان هرگز از شما دور نشد بسیار کوشیدیم که بار دیگر شما را ببینیم."
        },
        {
          "verse": 18,
          "usfm": "1TH.2.18",
          "line_type": "p",
          "text": "به همین منظور بسیار مایل بودیم نزد شما بیاییم، و من، پولس، بارها سعی کردم بیایم، اما شیطان مانع شد."
        },
        {
          "verse": 19,
          "usfm": "1TH.2.19",
          "line_type": "p",
          "text": "زیرا امید و شادی و تاج افتخار ما، در حضور خداوندمان، عیسی، به‌هنگام بازگشت او، چیست؟ آیا شما نیستید؟"
        },
        {
          "verse": 20,
          "usfm": "1TH.2.20",
          "line_type": "p",
          "text": "شما براستی افتخار و شادی ما هستید."
        }
      ],
      "verse_count": 20,
      "headings": [
        {
          "before_verse": 17,
          "text": "خبرهای دلگرم کننده تیموتائوس"
        }
      ],
