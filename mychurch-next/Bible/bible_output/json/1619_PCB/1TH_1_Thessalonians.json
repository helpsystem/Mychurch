  "chapters": [
    {
      "schema_version": 6,
      "book_id": "1TH",
      "chapter": 1,
      "chapter_usfm": "1TH.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "1TH.1.1",
          "line_type": "p",
          "text": "این نامه از طرف پولس، سیلاس و تیموتائوس است.این نامه را به شما کلیسای تسالونیکیان که از آنِ خدای پدر و عیسی مسیح خداوند می‌باشید، می‌نویسیم.از خدا خواستار فیض و آرامش برای شما هستیم."
        },
        {
          "verse": 2,
          "usfm": "1TH.1.2",
          "line_type": "p",
          "text": "ما همیشه خدا را برای وجود همۀ شما شکر می‌نماییم و دائماً برای شما دعا می‌کنیم،"
        },
        {
          "verse": 3,
          "usfm": "1TH.1.3",
          "line_type": "p",
          "text": "و در حضور خدا و پدرمان، به یاد می‌آوریم اعمال شما را که در اثر ایمان پدید می‌آیند، و نیز زحماتتان را که از محبت سرچشمه می‌گیرند، و شکیبایی و صبرتان را که از امید بر خداوندْ عیسی مسیح الهام می‌یابند."
        },
        {
          "verse": 4,
          "usfm": "1TH.1.4",
          "line_type": "p",
          "text": "ای برادران عزیز و ای محبوبان خدا، می‌دانیم که خدا شما را برگزیده است،"
        },
        {
          "verse": 5,
          "usfm": "1TH.1.5",
          "line_type": "p",
          "text": "زیرا زمانی که پیغام انجیل را به شما اعلام نمودیم، آن را کلمات و سخنانی بی‌معنی نپنداشتید، بلکه با علاقهٔ بسیار به آن گوش فرا دادید. آنچه می‌گفتیم، عمیقاً در شما اثر می‌گذاشت، زیرا روح‌القدس به شما یقین کامل می‌بخشید که سخنان ما راست است؛ رفتار ما نیز شما را از این امر مطمئن می‌ساخت."
        },
        {
          "verse": 6,
          "usfm": "1TH.1.6",
          "line_type": "p",
          "text": "در نتیجه، شما از ما و از خداوند پیروی کردید، و با وجود زحمات شدیدی که به سبب پیغام ما متوجهٔ شما شده بود، با آن شادی که از روح‌القدس است، پیغام ما را پذیرفتید."
        },
        {
          "verse": 7,
          "usfm": "1TH.1.7",
          "line_type": "p",
          "text": "به این ترتیب، شما برای مسیحیان سراسر مقدونیه و یونان نمونه شدید."
        },
        {
          "verse": 8,
          "usfm": "1TH.1.8",
          "line_type": "p",
          "text": "اکنون کلام خداوند به وسیلهٔ شما در همه جا پخش شده و به گوش مردم سرزمینهای دیگر نیز رسیده است. هر جا قدم می‌گذاریم، سخن از ایمان حیرت‌انگیز شما به خداست؛ لذا نیازی نیست که ما دیگر چیزی در این خصوص بگوییم،"
        },
        {
          "verse": 9,
          "usfm": "1TH.1.9",
          "line_type": "p",
          "text": "زیرا خودشان برای ما بیان می‌کنند که با آمدن ما نزد شما، چگونه از بت‌پرستی دست کشیدید و به سوی خدا بازگشتید تا خدای زنده و حقیقی را خدمت کنید."
        },
        {
          "verse": 10,
          "usfm": "1TH.1.10",
          "line_type": "p",
          "text": "در ضمن، بازگو می‌کنند که چگونه چشم انتظار بازگشت پسر خدا از آسمان هستید که خدا او را پس از مرگ زنده کرد، یعنی عیسی که ما را از وحشت داوری آینده رهایی بخشیده است."
        }
      ],
      "verse_count": 10,
      "headings": [
        {
          "before_verse": 2,
          "text": "شهرت ایمان تسالونیکیان"
        }
      ],
