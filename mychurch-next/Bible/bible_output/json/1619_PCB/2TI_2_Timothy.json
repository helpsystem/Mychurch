  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 1,
      "chapter_usfm": "2TI.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.1.1",
          "line_type": "p",
          "text": "این نامه از طرف پولس است، که طبق ارادۀ خدا، رسول و فرستادهٔ عیسی مسیح می‌باشد. من مأموریت یافته‌ام که این وعدهٔ خدا را در همه جا اعلام کنم که هر که به مسیح ایمان آورد، زندگی جاوید خواهد یافت."
        },
        {
          "verse": 2,
          "usfm": "2TI.1.2",
          "line_type": "p",
          "text": "این نامه را به فرزند عزیزم، تیموتائوس می‌نویسم.از خدای پدر و خداوندمان عیسی مسیح، خواستار فیض و رحمت و آرامش برای تو می‌باشم."
        },
        {
          "verse": 3,
          "usfm": "2TI.1.3",
          "line_type": "p",
          "text": "وقتی پیوسته، شب و روز تو را در دعاهایم به یاد می‌آورم، خدا را سپاس می‌گویم، خدایی را که با وجدانی پاک، مانند نیاکانم خدمت می‌کنم."
        },
        {
          "verse": 4,
          "usfm": "2TI.1.4",
          "line_type": "p",
          "text": "نمی‌دانی چقدر مشتاق دیدارت هستم و تا چه حد از دیدن مجدد تو شاد خواهم شد، زیرا همیشه اشکهایی را که به هنگام وداع می‌ریختی، به یاد دارم."
        },
        {
          "verse": 5,
          "usfm": "2TI.1.5",
          "line_type": "p",
          "text": "هیچگاه از یاد نمی‌برم چه ایمان خالصی به خداوند داشتی، درست مانند مادرت یونیکی و مادر بزرگت لوئیز؛ و اطمینان دارم که حالا نیز ایمانت به همان اندازه مستحکم است."
        },
        {
          "verse": 6,
          "usfm": "2TI.1.6",
          "line_type": "p",
          "text": "به همین جهت، می‌خواهم یادآوری کنم که آن عطای خدا را که در توست شعله‌ور سازی، همان عطایی که خدا به هنگام دعا و با دستگذاری من بر تو، در وجود تو قرار داد."
        },
        {
          "verse": 7,
          "usfm": "2TI.1.7",
          "line_type": "p",
          "text": "زیرا آن روحی که خدا به ما بخشیده، نه روح ترس، بلکه روح قوّت و محبت و انضباط است."
        },
        {
          "verse": 8,
          "usfm": "2TI.1.8",
          "line_type": "p",
          "text": "هرگز از شهادت دادن به دیگران دربارۀ خداوندمان عار نداشته باش. در ضمن، از من نیز که به خاطر او در زندانم عار نداشته باش؛ بلکه با اتکا به قدرتی که خدا به تو می‌بخشد، تو نیز آماده باش تا با من به خاطر انجیل زحمت ببینی."
        },
        {
          "verse": 9,
          "usfm": "2TI.1.9",
          "line_type": "p",
          "text": "این خداست که ما را نجات داد و برای زندگی مقدّس برگزید، نه به دلیل لیاقت ما، بلکه به سبب اینکه پیش از آفرینش جهان اراده فرموده بود فیض خود را به‌وسیلۀ عیسی مسیح به ما نشان دهد."
        },
        {
          "verse": 10,
          "usfm": "2TI.1.10",
          "line_type": "p",
          "text": "و حال، با ظهور نجات دهنده‌مان عیسی مسیح، ارادهٔ او آشکار شده است؛ او قدرت مرگ را در هم شکست، و به ما راه ورود به زندگی جاوید را نشان داد که همانا ایمان آوردن به پیغام انجیل اوست؛"
        },
        {
          "verse": 11,
          "usfm": "2TI.1.11",
          "line_type": "p",
          "text": "و برای اعلام و تعلیم همین پیغام است که خدا مرا برگزیده تا رسول و فرستادهٔ او باشم."
        },
        {
          "verse": 12,
          "usfm": "2TI.1.12",
          "line_type": "p",
          "text": "به همین دلیل است که در این زندان متحمل زحمات هستم، اما شرمگین نیستم که مانند یک مجرم در زندان به سر می‌برم، زیرا می‌دانم به چه کسی ایمان آورده و اعتماد کرده‌ام، و یقین دارم که او می‌تواند امانتم را تا روز بازگشت خود محفوظ نگاه دارد."
        },
        {
          "verse": 13,
          "usfm": "2TI.1.13",
          "line_type": "p",
          "text": "به سخنان و تعالیم صحیحی که از من شنیدی، محکم بچسب و از آنها سرمشق بگیر، بخصوص از ایمان و محبتی که عیسی مسیح می‌بخشد."
        },
        {
          "verse": 14,
          "usfm": "2TI.1.14",
          "line_type": "p",
          "text": "آن امانت نیکو، یعنی عطای الهی را به کمک روح‌القدس که در وجود تو ساکن است، حفظ کن."
        },
        {
          "verse": 15,
          "usfm": "2TI.1.15",
          "line_type": "p",
          "text": "همان‌طور که می‌دانی، تمام مسیحیانی که از ایالت آسیا به اینجا آمده بودند، مرا به حال خود گذاشته و رفته‌اند؛ حتی فیجلوس و هرموجنس نیز مرا ترک گفته‌اند."
        },
        {
          "verse": 16,
          "usfm": "2TI.1.16",
          "line_type": "p",
          "text": "خداوند اُنیسیفوروس و خانوادهٔ او را مورد لطف و رحمت خود قرار دهد، زیرا بارها به دیدن من آمد و باعث دلگرمی و شادی من گردید. او هیچگاه از زندانی بودن من عار نداشت،"
        },
        {
          "verse": 17,
          "usfm": "2TI.1.17",
          "line_type": "p",
          "text": "بلکه به محض رسیدن به روم، همه جا به دنبال من گشت تا اینکه مرا پیدا کرد."
        },
        {
          "verse": 18,
          "usfm": "2TI.1.18",
          "line_type": "p",
          "text": "خداوند در روز بازگشت مسیح بر او رحمت فرماید. تو خود به خوبی آگاهی که خدمات او در اَفَسُس چقدر مفید بوده است."
        }
      ],
      "verse_count": 18,
      "headings": [
        {
          "before_verse": 3,
          "text": "تشویق به وفاداری"
        }
      ],
      "footnotes": [
