    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 2,
      "chapter_usfm": "2TI.2",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.2.1",
          "line_type": "p",
          "text": "پس تو، پسرم، در فیضی که خدا در مسیحْ عیسی به تو عطا می‌کند، نیرومند باش."
        },
        {
          "verse": 2,
          "usfm": "2TI.2.2",
          "line_type": "p",
          "text": "تعالیمی را که در حضور جمع از من شنیده‌ای، به افراد قابل اعتماد بسپار تا ایشان نیز بتوانند آنها را به دیگران تعلیم دهند."
        },
        {
          "verse": 3,
          "usfm": "2TI.2.3",
          "line_type": "p",
          "text": "همچون سرباز خوب عیسی مسیح، به سهم خود در زحمات شریک باش."
        },
        {
          "verse": 4,
          "usfm": "2TI.2.4",
          "line_type": "p",
          "text": "سربازان خود را درگیر امور زندگی نمی‌کنند تا بتوانند فرماندۀ خود را راضی نگه دارند."
        },
        {
          "verse": 5,
          "usfm": "2TI.2.5",
          "line_type": "p",
          "text": "و همچنین ورزشکاری که می‌خواهد برندهٔ جایزه شود، باید تمام مقررات مسابقه را رعایت کند."
        },
        {
          "verse": 6,
          "usfm": "2TI.2.6",
          "line_type": "p",
          "text": "کشاورزی که سخت کار می‌کند، باید نخستین کسی باشد که از محصول نصیبی می‌برد."
        },
        {
          "verse": 7,
          "usfm": "2TI.2.7",
          "line_type": "p",
          "text": "به آنچه می‌گویم خوب فکر کن، که خداوند به تو بصیرت خواهد بخشید تا بتوانی اینها را درک کنی."
        },
        {
          "verse": 8,
          "usfm": "2TI.2.8",
          "line_type": "p",
          "text": "هیچگاه این حقیقت را از یاد نبر که عیسی مسیح به‌لحاظ جسمانی، از نسل داوود بود و پس از مرگ، بار دیگر زنده شد. این همان پیغام انجیل است که من اعلام می‌کنم،"
        },
        {
          "verse": 9,
          "usfm": "2TI.2.9",
          "line_type": "p",
          "text": "و به سبب این کار، در زحمت افتاده‌ام و مانند یک خطاکار در زندان به سر می‌برم. با اینکه مرا به زنجیر کشیده‌اند، اما کلام خدا را نمی‌توانند به زنجیر بکشند."
        },
        {
          "verse": 10,
          "usfm": "2TI.2.10",
          "line_type": "p",
          "text": "اما من حاضرم در راه برگزیدگان خدا بیش از اینها زحمت ببینم تا ایشان نیز نجات و جلال جاودانی را از عیسی مسیح بیابند."
        },
        {
          "verse": 11,
          "usfm": "2TI.2.11",
          "line_type": "p",
          "text": "این گفته‌ای است قابل اعتماد که:اگر با مسیح مردیم، با او نیز زندگی خواهیم کرد."
        },
        {
          "verse": 12,
          "usfm": "2TI.2.12",
          "line_type": "p",
          "text": "اگر سختیها را تحمل کنیم، با او نیز سلطنت خواهیم کرد.اگر انکارش کنیم، او نیز ما را انکار خواهد کرد."
        },
        {
          "verse": 13,
          "usfm": "2TI.2.13",
          "line_type": "p",
          "text": "اگر بی‌وفا شویم، او وفادار خواهد ماند، چرا که نمی‌تواند منکر ذات خود گردد."
        },
        {
          "verse": 14,
          "usfm": "2TI.2.14",
          "line_type": "p",
          "text": "این حقایق را به اعضای کلیسای خود یادآوری نما، و به نام خداوند به ایشان حکم کن که بر سر موضوعات جزئی بحث و مجادله نکنند، چون این گونه بحث‌ها بی‌ثمر و حتی مضرند."
        },
        {
          "verse": 15,
          "usfm": "2TI.2.15",
          "line_type": "p",
          "text": "تا آنجا که در توان داری، بکوش تا مورد تأیید خدا قرار گیری، همچون کارگری که دلیلی برای شرمسار شدن ندارد و کلام خدا را به‌درستی به کار می‌بندد."
        },
        {
          "verse": 16,
          "usfm": "2TI.2.16",
          "line_type": "p",
          "text": "از بحث‌های باطل و ناپسند دوری کن، زیرا انسان را از خدا دور می‌سازد."
        },
        {
          "verse": 17,
          "usfm": "2TI.2.17",
          "line_type": "p",
          "text": "در این بحث‌ها، سخنانی رد و بدل می‌شود که مانند خوره به جان آدمی می‌افتد. هیمینائوس و فلیطوس از جمله کسانی هستند که مشتاق چنین بحث‌هایی می‌باشند."
        },
        {
          "verse": 18,
          "usfm": "2TI.2.18",
          "line_type": "p",
          "text": "این دو از راه راست منحرف شده‌اند و تعلیم می‌دهند که روز قیامت فرا رسیده است، و به این ترتیب ایمان عده‌ای را تضعیف کرده‌اند."
        },
        {
          "verse": 19,
          "usfm": "2TI.2.19",
          "line_type": "p",
          "text": "اما حقایق الهی پا برجا می‌ماند و هیچ چیز نمی‌تواند آن را تکان دهد؛ همچون سنگ زیر بنایی است که بر روی آن، این دو جمله نوشته شده است: «خداوند کسانی را که واقعاً به او تعلق دارند می‌شناسد» و «آنانی که خود را از آنِ مسیح می‌دانند، باید از اعمال نادرست دوری کنند.»"
        },
        {
          "verse": 20,
          "usfm": "2TI.2.20",
          "line_type": "p",
          "text": "در خانۀ شخص ثروتمند، همه نوع ظرف وجود دارد، از ظروف طلا و نقره گرفته تا ظروف چوبی و گِلی. از ظرفهای گرانبها برای مصارف عالی استفاده می‌شود، و از ظرفهای ارزان برای مصارف عادی."
        },
        {
          "verse": 21,
          "usfm": "2TI.2.21",
          "line_type": "p",
          "text": "اگر کسی خود را از گناه دور نگاه دارد، مانند ظرف گرانبها خواهد بود و مسیح برای هدفهای عالی، او را به کار خواهد گرفت."
        },
        {
          "verse": 22,
          "usfm": "2TI.2.22",
          "line_type": "p",
          "text": "از هر آنچه شهوات جوانی را برمی‌انگیزد، بگریز، و با کسانی که با دلی پاک، خداوند را می‌خوانند، در پی عدالت، ایمان، محبت و صلح و صفا باش."
        },
        {
          "verse": 23,
          "usfm": "2TI.2.23",
          "line_type": "p",
          "text": "باز تکرار می‌کنم: خود را درگیر بحث‌های پوچ و بی‌معنی نکن، چون این گونه بحث‌ها باعث خشم و نزاع می‌گردد."
        },
        {
          "verse": 24,
          "usfm": "2TI.2.24",
          "line_type": "p",
          "text": "مرد خدا نباید اهل مجادله و دعوا باشد، بلکه باید با صبر و ملایمت، کسانی را که در اشتباهند، به راه راست هدایت کند."
        },
        {
          "verse": 25,
          "usfm": "2TI.2.25",
          "line_type": "p",
          "text": "مخالفان را باید با ملایمت و نرم‌خویی راهنمایی نماید، به این امید که خدا به ایشان توبه عنایت فرماید تا به شناخت حقیقت برسند،"
        },
        {
          "verse": 26,
          "usfm": "2TI.2.26",
          "line_type": "p",
          "text": "و به سرِ عقل بیایند و از دام ابلیس که ایشان را اسیر خود ساخته تا اراده‌اش را به انجام برسانند، رهایی یابند."
        }
      ],
      "verse_count": 26,
      "headings": [
        {
          "before_verse": 14,
          "text": "خادم مقبول خدا"
        }
      ],
