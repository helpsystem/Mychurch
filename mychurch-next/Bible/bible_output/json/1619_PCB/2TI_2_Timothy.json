    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 3,
      "chapter_usfm": "2TI.3",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.3.1",
          "line_type": "p",
          "text": "اما این را نیز باید بدانی که در روزهای آخر، زمانهای بسیار دشواری روی خواهد داد،"
        },
        {
          "verse": 2,
          "usfm": "2TI.3.2",
          "line_type": "p",
          "text": "زیرا مردمان، خودمحور، پولدوست، خودستا، متکبّر، بدزبان، نامطیع نسبت به والدین، و ناسپاس بوده، هیچ چیز را مقدّس نخواهند شمرد."
        },
        {
          "verse": 3,
          "usfm": "2TI.3.3",
          "line_type": "p",
          "text": "همچنین فاقد محبت، بی‌گذشت، تهمت‌زن، ناپرهیزگار، خشن و متنفر از نیکویی خواهند بود."
        },
        {
          "verse": 4,
          "usfm": "2TI.3.4",
          "line_type": "p",
          "text": "در آن زمان، خیانت در دوستی امری عادی به نظر خواهد آمد. انسانها لذت را بیشتر از خدا دوست خواهند داشت؛"
        },
        {
          "verse": 5,
          "usfm": "2TI.3.5",
          "line_type": "p",
          "text": "به ظاهر افرادی دیندار خواهند بود، اما قدرت آن را انکار خواهند کرد. تو را با این قبیل افراد کاری نباشد."
        },
        {
          "verse": 6,
          "usfm": "2TI.3.6",
          "line_type": "p",
          "text": "این گونه افراد هستند که با هزاران نیرنگ به خانه‌های مردم راه پیدا می‌کنند و با زنان کم‌عقل که گذشتهٔ گناه‌آلودی داشته‌اند، طرح دوستی می‌ریزند و تعالیم غلط خود را به خورد ایشان می‌دهند."
        },
        {
          "verse": 7,
          "usfm": "2TI.3.7",
          "line_type": "p",
          "text": "چنین زنان همواره کسانی را که تعالیم جدیدی می‌آورند، پیروی می‌کنند، اما هرگز به شناخت حقیقت دست نمی‌یابند."
        },
        {
          "verse": 8,
          "usfm": "2TI.3.8",
          "line_type": "p",
          "text": "همان‌گونه که ینیس و یمبریس با موسی مخالفت می‌کردند، این معلمین نیز با حقیقت و راستی مخالفت می‌کنند؛ ایشان افکاری آلوده و فاسد دارند و از ایمان برگشته‌اند."
        },
        {
          "verse": 9,
          "usfm": "2TI.3.9",
          "line_type": "p",
          "text": "اما همیشه اینطور نخواهد ماند، و یک روز گمراهی و نادانی‌شان بر همه آشکار خواهد گردید، چنانکه نادانی ینیس و یمبریس آشکار شد."
        },
        {
          "verse": 10,
          "usfm": "2TI.3.10",
          "line_type": "p",
          "text": "اما تو، تیموتائوس، خود می‌دانی که من چه تعلیم می‌دهم، چگونه زندگی می‌کنم، و هدف من در زندگی چیست. تو از ایمان و صبر و محبت و بردباری من آگاهی؛"
        },
        {
          "verse": 11,
          "usfm": "2TI.3.11",
          "line_type": "p",
          "text": "و شاهد زحمات و رنجهایی که در راه اعلام پیغام انجیل کشیدم هستی؛ و به یاد داری که در انطاکیه، قونیه و لستره با چه سختیها و رنجهایی مواجه شدم. اما خداوند مرا از همهٔ این خطرات نجات داد."
        },
        {
          "verse": 12,
          "usfm": "2TI.3.12",
          "line_type": "p",
          "text": "در واقع، همهٔ آنانی که می‌خواهند مطابق ارادهٔ خدا زندگی کنند، از دشمنان مسیح عیسی رنج و آزار خواهند دید."
        },
        {
          "verse": 13,
          "usfm": "2TI.3.13",
          "line_type": "p",
          "text": "اما افراد نادرست و علمای دروغین، روز‌به‌روز بدتر شده، بسیاری را فریب خواهند داد و خود نیز فریب شیطان را خواهند خورد."
        },
        {
          "verse": 14,
          "usfm": "2TI.3.14",
          "line_type": "p",
          "text": "اما تو باید به آنچه آموختی، ایمان راسخ داشته باشی. تو به صحت و درستی آنها اطمینان داری زیرا می‌دانی که آنها را از افراد قابل اعتمادی آموخته‌ای؛"
        },
        {
          "verse": 15,
          "usfm": "2TI.3.15",
          "line_type": "p",
          "text": "خودت نیز از کودکی کتب مقدّس را فرا گرفته‌ای. این کتابها به تو حکمت بخشیده‌اند تا بدانی که دست یافتن به نجات، از راه ایمان به عیسی مسیح امکان‌پذیر است."
        },
        {
          "verse": 16,
          "usfm": "2TI.3.16",
          "line_type": "p",
          "text": "در واقع، تمام کتب مقدّس الهام خداست و سودمند است تا حقیقت را به ما تعلیم دهد، و آنچه را که در زندگی ما نادرست است، به ما تذکر دهد. همچنین وقتی راه را به اشتباه می‌پیماییم، ما را اصلاح می‌کند و آنچه را که درست است، به ما تعلیم می‌دهد."
        },
        {
          "verse": 17,
          "usfm": "2TI.3.17",
          "line_type": "p",
          "text": "خدا به‌وسیلۀ کلامش ما را از هر جهت آماده و مجهز می‌سازد تا به همه نیکی نماییم."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 10,
          "text": "نصایح و سفارشهای پولس به تیموتائوس"
        }
      ],
