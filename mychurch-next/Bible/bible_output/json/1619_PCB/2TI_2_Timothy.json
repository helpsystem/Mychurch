    {
      "schema_version": 6,
      "book_id": "2TI",
      "chapter": 4,
      "chapter_usfm": "2TI.4",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2TI.4.1",
          "line_type": "p",
          "text": "در حضور خدا و عیسی مسیح که روزی زندگان و مردگان را داوری خواهد فرمود، تو را مکلف می‌سازم که"
        },
        {
          "verse": 2,
          "usfm": "2TI.4.2",
          "line_type": "p",
          "text": "کلام را موعظه کنی. در هر موقعیت، و در وقت و بی‌وقت، آماده باش. با صبر بسیار ایمانداران را تعلیم بده و آنها را اصلاح و توبیخ و تشویق کن."
        },
        {
          "verse": 3,
          "usfm": "2TI.4.3",
          "line_type": "p",
          "text": "زیرا زمانی خواهد رسید که مردم، دیگر به حقیقت گوش فرا نخواهند داد، بلکه به سراغ معلمینی خواهند رفت که مطابق میلشان سخن می‌گویند."
        },
        {
          "verse": 4,
          "usfm": "2TI.4.4",
          "line_type": "p",
          "text": "ایشان توجهی به پیغام راستین کلام خدا نخواهند نمود، بلکه کورکورانه به دنبال افسانه‌های گمراه کننده خواهند رفت."
        },
        {
          "verse": 5,
          "usfm": "2TI.4.5",
          "line_type": "p",
          "text": "اما تو در همهٔ شرایط استوار بایست، و از زحمت دیدن در راه خداوند نترس. مردم را به سوی مسیح هدایت کن و وظایف خود را کامل انجام بده."
        },
        {
          "verse": 6,
          "usfm": "2TI.4.6",
          "line_type": "p",
          "text": "زیرا اکنون مانند هدیۀ ریختنی، در حال ریخته شدنم و زمان رحلت من فرا رسیده است."
        },
        {
          "verse": 7,
          "usfm": "2TI.4.7",
          "line_type": "p",
          "text": "در جنگِ نیکو جنگیده‌ام، و مسابقه را به پایان رسانده‌ام، و خدمت خود را با وفاداری انجام داده‌ام."
        },
        {
          "verse": 8,
          "usfm": "2TI.4.8",
          "line_type": "p",
          "text": "حال، تاجی در آسمان انتظار مرا می‌کشد، تاجی که خداوند ما مسیح، آن داور عادل، در روز بازگشت خود به من خواهد داد؛ اما نه فقط به من، بلکه به تمام کسانی که با زندگی‌شان نشان می‌دهند که مشتاقانه منتظر بازگشت او هستند."
        },
        {
          "verse": 9,
          "usfm": "2TI.4.9",
          "line_type": "p",
          "text": "سعی کن هر چه زودتر نزد من بیایی،"
        },
        {
          "verse": 10,
          "usfm": "2TI.4.10",
          "line_type": "p",
          "text": "زیرا دیماس مرا ترک کرده است؛ او به خاطر علائق و دلبستگی‌هایش به امور این دنیا، به تسالونیکی رفته است. در ضمن کریسکیس به غلاطیه و تیتوس به دلماتیه رفته‌اند."
        },
        {
          "verse": 11,
          "usfm": "2TI.4.11",
          "line_type": "p",
          "text": "فقط لوقا پیش من است. هرگاه آمدی، مرقس را نیز با خود بیاور، زیرا به کمک او احتیاج دارم."
        },
        {
          "verse": 12,
          "usfm": "2TI.4.12",
          "line_type": "p",
          "text": "تیخیکوس هم دیگر اینجا نیست چون او را به افسس فرستادم."
        },
        {
          "verse": 13,
          "usfm": "2TI.4.13",
          "line_type": "p",
          "text": "وقتی می‌آیی، فراموش نکن ردای مرا که در شهر تروآس نزد کارپوس گذاشته‌ام، همراه بیاوری. در ضمن، کتابها، بخصوص اوراق پوستی را نیز بیاور."
        },
        {
          "verse": 14,
          "usfm": "2TI.4.14",
          "line_type": "p",
          "text": "اسکندر مسگر به من بسیار بدی کرد؛ خداوند خودش او را تنبیه کند."
        },
        {
          "verse": 15,
          "usfm": "2TI.4.15",
          "line_type": "p",
          "text": "تو نیز خود را از او دور نگاه دار، چون او با گفته‌های ما به مخالفت برخاسته است."
        },
        {
          "verse": 16,
          "usfm": "2TI.4.16",
          "line_type": "p",
          "text": "در نخستین جلسهٔ دادگاه، هیچ‌کس برای کمک به من، در جلسه حضور نیافت؛ همه مرا ترک کردند. امیدوارم خدا این خطا را به حساب ایشان نگذارد."
        },
        {
          "verse": 17,
          "usfm": "2TI.4.17",
          "line_type": "p",
          "text": "اما خداوند خودش مرا یاری نمود و فرصت داد تا با دلیری پیغام نجاتبخش انجیل را به گوش همهٔ قومهای دنیا برسانم. او مرا از مرگ حتمی نجات داد و نگذاشت طعمۀ شیران بشوم."
        },
        {
          "verse": 18,
          "usfm": "2TI.4.18",
          "line_type": "p",
          "text": "بله، خداوند مرا از هر اتفاق بدی حفظ خواهد کرد و سلامت به ملکوت آسمانی خود خواهد رساند. جلال تا ابد از آن خداوند باد. آمین."
        },
        {
          "verse": 19,
          "usfm": "2TI.4.19",
          "line_type": "p",
          "text": "سلام مرا به پریسکیلا و آکیلا برسان، همچنین به کسانی که در خانهٔ اُنیسیفوروس هستند."
        },
        {
          "verse": 20,
          "usfm": "2TI.4.20",
          "line_type": "p",
          "text": "اراستوس در قرنتس ماند؛ تروفیموس را نیز که بیمار بود، در میلیتوس ترک کردم و آمدم."
        },
        {
          "verse": 21,
          "usfm": "2TI.4.21",
          "line_type": "p",
          "text": "سعی کن قبل از زمستان اینجا باشی. یوبولوس، پودِنس و لینوس، کلادیا و همهٔ برادران سلام می‌رسانند."
        },
        {
          "verse": 22,
          "usfm": "2TI.4.22",
          "line_type": "p",
          "text": "عیسی مسیح خداوند با روح تو باد. فیض خداوند با شما باد."
        }
      ],
