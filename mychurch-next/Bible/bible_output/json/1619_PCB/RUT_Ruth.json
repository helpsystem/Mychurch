  "chapters": [
    {
      "schema_version": 6,
      "book_id": "RUT",
      "chapter": 1,
      "chapter_usfm": "RUT.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 3,
          "usfm": "RUT.1.3",
          "line_type": "p",
          "text": "در طی اقامتشان در موآب، الیملک درگذشت و نعومی با دو پسرش تنها ماند. پسران نعومی با دو دختر موآبی به نامهای عرفه و روت ازدواج کردند. ده سال بعد محلون و کلیون نیز مردند. بدین ترتیب نعومی، هم شوهر و هم پسرانش را از دست داد و تنها ماند. او تصمیم گرفت با دو عروسش به زادگاه خود یعنی سرزمین یهودا بازگردد، زیرا شنیده بود که خداوند به قوم خود برکت داده و محصول زمین دوباره فراوان شده است.اما وقتی به راه افتادند، تصمیم نعومی عوض شد"
        },
        {
          "verse": 8,
          "usfm": "RUT.1.8",
          "line_type": "p",
          "text": "و به عروسهایش گفت: «شما همراه من نیایید. به خانهٔ پدری خود بازگردید. خداوند به شما برکت بدهد همان‌گونه که شما به من و پسرانم خوبی کردید."
        },
        {
          "verse": 9,
          "usfm": "RUT.1.9",
          "line_type": "p",
          "text": "امیدوارم به لطف خداوند بتوانید بار دیگر شوهر کنید و خوشبخت شوید.»سپس نعومی آنها را بوسید و آنها گریستند"
        },
        {
          "verse": 10,
          "usfm": "RUT.1.10",
          "line_type": "p",
          "text": "و به نعومی گفتند: «ما می‌خواهیم همراه تو نزد قوم تو بیاییم.»"
        },
        {
          "verse": 11,
          "usfm": "RUT.1.11",
          "line_type": "p",
          "text": "ولی نعومی در جواب آنها گفت: «ای دخترانم بهتر است برگردید. چرا می‌خواهید همراه من بیایید؟ مگر من می‌توانم صاحب پسران دیگری شوم که برای شما شوهر باشند؟"
        },
        {
          "verse": 12,
          "usfm": "RUT.1.12",
          "line_type": "p",
          "text": "ای دخترانم، نزد قوم خود بازگردید، زیرا از من گذشته است که بار دیگر شوهر کنم. حتی اگر همین امشب شوهر کنم و صاحب پسرانی شوم،"
        },
        {
          "verse": 13,
          "usfm": "RUT.1.13",
          "line_type": "p",
          "text": "آیا تا بزرگ شدن آنها صبر خواهید کرد و با کس دیگری ازدواج نخواهید نمود؟ نه، دخترانم! وضع من بسیار تلخ‌تر از وضع شماست، زیرا خداوند خودش دستش را بر من بلند کرده است.»"
        },
        {
          "verse": 14,
          "usfm": "RUT.1.14",
          "line_type": "p",
          "text": "آنها بار دیگر با صدای بلند گریستند. عرفه مادرشوهرش را بوسید و از او خداحافظی کرد و به خانه بازگشت. اما روت از او جدا نشد."
        },
        {
          "verse": 15,
          "usfm": "RUT.1.15",
          "line_type": "p",
          "text": "نعومی به روت گفت: «ببین دخترم، زن برادر شوهرت نزد قوم و خدایان خود بازگشت. تو هم همین کار را بکن.»"
        },
        {
          "verse": 16,
          "usfm": "RUT.1.16",
          "line_type": "p",
          "text": "اما روت به او گفت: «مرا مجبور نکن که تو را ترک کنم، چون هر جا بروی با تو خواهم آمد و هر جا بمانی با تو خواهم ماند. قوم تو، قوم من و خدای تو، خدای من خواهد بود."
        },
        {
          "verse": 17,
          "usfm": "RUT.1.17",
          "line_type": "p",
          "text": "می‌خواهم جایی که تو می‌میری بمیرم و در کنار تو دفن شوم. خداوند بدترین بلا را بر سر من بیاورد، اگر بگذارم چیزی جز مرگ مرا از تو جدا کند.»"
        },
        {
          "verse": 18,
          "usfm": "RUT.1.18",
          "line_type": "p",
          "text": "نعومی چون دید تصمیم روت قطعی است و به هیچ وجه نمی‌شود او را منصرف کرد، دیگر اصرار ننمود."
        },
        {
          "verse": 19,
          "usfm": "RUT.1.19",
          "line_type": "p",
          "text": "پس هر دو روانهٔ بیت‌لحم شدند. وقتی به آنجا رسیدند تمام اهالی به هیجان آمدند و زنها از همدیگر می‌پرسیدند: «آیا این خود نعومی است؟»"
        },
        {
          "verse": 20,
          "usfm": "RUT.1.20",
          "line_type": "p",
          "text": "نعومی به ایشان گفت: «مرا نعومی (یعنی ”خوشحال“) نخوانید. مرا ماره (یعنی ”تلخ“) صدا کنید؛ زیرا خدای قادر مطلق زندگی مرا تلخ کرده است."
        },
        {
          "verse": 21,
          "usfm": "RUT.1.21",
          "line_type": "p",
          "text": "دست پُر رفتم و خداوند مرا دست خالی بازگردانید. برای چه مرا نعومی می‌خوانید، حال آنکه خداوند قادر مطلق روی خود را از من برگردانیده و این مصیبت بزرگ را بر من وارد آورده است؟»"
        },
        {
          "verse": 22,
          "usfm": "RUT.1.22",
          "line_type": "p",
          "text": "(وقتی نعومی و روت از موآب به بیت‌لحم رسیدند، هنگام درو جو بود.)"
        }
      ],
      "verse_count": 16,
      "headings": [],
      "footnotes": [
        {
          "verse": 11,
          "usfm": "RUT.1.11",
          "note_ref": "1‏:11",
          "note_type": "footnote",
          "references": [
            "DEU.25.5+DEU.25.6+DEU.25.7+DEU.25.8+DEU.25.9+DEU.25.10"
          ],
          "text": "طبق رسم آن روزگار هرگاه شوهر زنی می‌مرد برادر شوهر آن زن می‌بایست او را به عقد خود در می‌آورند (تثنیه ۲۵‏:۵‏-۱۰)."
        }
      ],
