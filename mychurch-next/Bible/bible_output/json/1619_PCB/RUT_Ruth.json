    },
    {
      "schema_version": 6,
      "book_id": "RUT",
      "chapter": 3,
      "chapter_usfm": "RUT.3",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "RUT.3.1",
          "line_type": "p",
          "text": "روزی نعومی به روت گفت: «دخترم الان وقت آن رسیده که شوهری برای تو پیدا کنم تا زندگی‌ات سروسامان گیرد."
        },
        {
          "verse": 2,
          "usfm": "RUT.3.2",
          "line_type": "p",
          "text": "همین‌طور که می‌دانی بوعز، که تو در کشتزارش خوشه‌چینی می‌کردی، از بستگان نزدیک ما می‌باشد. او امشب در خرمنگاه، جو غربال می‌کند."
        },
        {
          "verse": 3,
          "usfm": "RUT.3.3",
          "line_type": "p",
          "text": "پس برو حمام کن و عطر بزن، بهترین لباست را بپوش و به خرمنگاه برو. اما نگذار بوعز تو را ببیند، تا اینکه شامش را بخورد و بخوابد."
        },
        {
          "verse": 4,
          "usfm": "RUT.3.4",
          "line_type": "p",
          "text": "دقت کن و ببین جای خوابیدن او کجاست. بعد برو و پوشش او را از روی پاهایش کنار بزن و در همان جا کنار پاهای او بخواب. آنگاه او به تو خواهد گفت که چه باید کرد.»"
        },
        {
          "verse": 5,
          "usfm": "RUT.3.5",
          "line_type": "p",
          "text": "روت گفت: «بسیار خوب، همین کار را خواهم کرد.» روت آن شب به خرمنگاه رفت و طبق دستورهایی که مادرشوهرش به او داده بود، عمل کرد. بوعز پس از آنکه خورد و سیر شد، کنار بافه‌های جو دراز کشید و خوابید. آنگاه روت آهسته آمده، پوشش او را از روی پاهایش کنار زد و همان جا دراز کشید."
        },
        {
          "verse": 8,
          "usfm": "RUT.3.8",
          "line_type": "p",
          "text": "نیمه‌های شب، بوعز سراسیمه از خواب پرید و دید زنی کنار پاهایش خوابیده است."
        },
        {
          "verse": 9,
          "usfm": "RUT.3.9",
          "line_type": "p",
          "text": "گفت: «تو کیستی؟»روت جواب داد: «من کنیزت، روت هستم. خواهش می‌کنم مرا به زنی بگیری، زیرا تو خویشاوند نزدیک من هستی.»"
        },
        {
          "verse": 10,
          "usfm": "RUT.3.10",
          "line_type": "p",
          "text": "بوعز گفت: «دخترم، خداوند تو را برکت دهد! این محبتی که حالا می‌کنی از آن خوبی که در حق مادر شوهرت کردی، بزرگتر است. تو می‌توانستی با مرد جوانی، چه فقیر چه ثروتمند، ازدواج کنی؛ اما این کار را نکردی."
        },
        {
          "verse": 11,
          "usfm": "RUT.3.11",
          "line_type": "p",
          "text": "حال نگران نباش. آنچه خواسته‌ای برایت انجام خواهم داد. همهٔ مردم شهر می‌دانند که تو زنی نجیب هستی."
        },
        {
          "verse": 12,
          "usfm": "RUT.3.12",
          "line_type": "p",
          "text": "درست است که من خویشاوند نزدیک شوهرت هستم، اما خویشاوند نزدیکتر از من هم داری."
        },
        {
          "verse": 13,
          "usfm": "RUT.3.13",
          "line_type": "p",
          "text": "تو امشب در اینجا بمان و من فردا صبح این موضوع را با او در میان می‌گذارم. اگر او خواست با تو ازدواج کند، بگذار بکند؛ اما اگر راضی به این کار نبود، به خداوند زنده قسم که خودم حق تو را ادا خواهم کرد. اکنون تا صبح همین جا بخواب.»"
        },
        {
          "verse": 14,
          "usfm": "RUT.3.14",
          "line_type": "p",
          "text": "پس روت تا صبح کنار پاهای او خوابید و صبح خیلی زود، قبل از روشن شدن هوا برخاست، زیرا بوعز به او گفته بود: «نگذار کسی بفهمد که تو امشب در خرمنگاه، پیش من بوده‌ای.»"
        },
        {
          "verse": 15,
          "usfm": "RUT.3.15",
          "line_type": "p",
          "text": "او همچنین به روت گفت: «ردای خود را پهن کن.» روت ردایش را پهن کرد و بوعز حدود بیست کیلو جو در آن ریخت و روی دوش روت گذاشت تا به خانه ببرد."
        },
        {
          "verse": 16,
          "usfm": "RUT.3.16",
          "line_type": "p",
          "text": "وقتی به خانه رسید نعومی از او پرسید: «دخترم، چطور شد؟»آنگاه روت تمام ماجرا را برای او تعریف کرد."
        },
        {
          "verse": 17,
          "usfm": "RUT.3.17",
          "line_type": "p",
          "text": "در ضمن اضافه کرد: «برای اینکه دست خالی پیش تو برنگردم، بوعز این مقدار جو را به من داد تا به تو بدهم.»"
        },
        {
          "verse": 18,
          "usfm": "RUT.3.18",
          "line_type": "p",
          "text": "نعومی گفت: «دخترم، صبر کن تا ببینیم چه پیش خواهد آمد. زیرا بوعز تا این کار را امروز تمام نکند، آرام نخواهد گرفت.»"
        }
      ],
