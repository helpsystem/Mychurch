    {
      "schema_version": 6,
      "book_id": "NAM",
      "chapter": 2,
      "chapter_usfm": "NAM.2",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "NAM.2.1",
          "line_type": "p",
          "text": "ای نینوا، عمرت به سر آمده است! سپاهیان دشمن، تو را محاصره کرده‌اند. پس حصارهای خود را تقویت کن. جاده را دیدبانی نما و آمادۀ جنگ باش."
        },
        {
          "verse": 2,
          "usfm": "NAM.2.2",
          "line_type": "p",
          "text": "تو سرزمین یهودا را ویران کردی، ولی خداوند عزت و قدرتشان را به ایشان باز می‌گرداند. شاخه‌های تاک اسرائیل بریده شده‌اند، اما او شکوه آن را باز خواهد گرداند."
        },
        {
          "verse": 3,
          "usfm": "NAM.2.3",
          "line_type": "p",
          "text": "سپرهای سرخ دشمن برق می‌زنند! لباسهای نظامی سرخ رنگ آنها را ببین! ارابه‌های درخشان آنها را مشاهده نما که در کنار هم به‌وسیلۀ اسبها به پیش حرکت می‌کنند. دشمن آمادۀ حمله است!"
        },
        {
          "verse": 4,
          "usfm": "NAM.2.4",
          "line_type": "p",
          "text": "ارابه‌های تو در خیابانها و میدانها به سرعت از هم پیشی می‌گیرند؛ مانند برق جلو می‌روند و مثل مشعل می‌درخشند!"
        },
        {
          "verse": 5,
          "usfm": "NAM.2.5",
          "line_type": "p",
          "text": "پادشاه بر سر افسرانش فریاد می‌زند و آنها دستپاچه شده، با عجله به طرف دیوارهای شهر می‌دوند تا سنگرهایشان را بر پا سازند."
        },
        {
          "verse": 6,
          "usfm": "NAM.2.6",
          "line_type": "p",
          "text": "اما خیلی دیر شده است! دریچه‌های رودخانه باز است. دشمن به داخل شهر رخنه کرده است. کاخ سلطنتی را وحشت فرا گرفته است!"
        },
        {
          "verse": 7,
          "usfm": "NAM.2.7",
          "line_type": "p",
          "text": "ملکهٔ نینوا را برهنه به کوچه‌ها آورده‌اند؛ او را اسیر کرده‌اند و ندیمه‌هایش گریان به دنبال او می‌روند و مثل فاخته‌ها می‌نالند و سینه می‌زنند."
        },
        {
          "verse": 8,
          "usfm": "NAM.2.8",
          "line_type": "p",
          "text": "شهر نینوا چون مخزن آبی است که سوراخ شده باشد. اهالی آن با شتاب از آن بیرون می‌ریزند و به فریادهایی که آنها را از فرار باز می‌دارد توجهی نمی‌کنند."
        },
        {
          "verse": 9,
          "usfm": "NAM.2.9",
          "line_type": "p",
          "text": "نقره‌ها را غارت کنید! طلاها را به یغما ببرید! گنجهای بی‌حسابش را تاراج کنید!"
        },
        {
          "verse": 10,
          "usfm": "NAM.2.10",
          "line_type": "p",
          "text": "شهر نینوا خراب و متروک شده است. دلها از ترس آب شده‌اند، زانوها می‌لرزند، رمقی در مردم نمانده و رنگ از صورتها پریده است."
        },
        {
          "verse": 11,
          "usfm": "NAM.2.11",
          "line_type": "p",
          "text": "اینک، آن نینوای بزرگ، آن بیشهٔ شیران و محل دلیران کجاست؟ نینوایی که در آن پیر و جوان بدون ترس و دلهره زندگی می‌کردند."
        },
        {
          "verse": 12,
          "usfm": "NAM.2.12",
          "line_type": "p",
          "text": "ای نینوا که زمانی چون شیر، نیرومند بودی، و دشمنانت را پایمال می‌کردی تا زنان و فرزندانت را سیر کنی و شهرها و خانه‌هایت را از غنایم و اسیران جنگ پر سازی!"
        },
        {
          "verse": 13,
          "usfm": "NAM.2.13",
          "line_type": "p",
          "text": "بدان که اکنون خداوند لشکرهای آسمان بر ضد تو برخاسته است. او ارابه‌هایت را می‌سوزاند و دلیران تو را هلاک می‌کند. دیگر هرگز از سرزمینهای مغلوب، اسیری نخواهی آورد و صدای سفیران مغرورت دیگر شنیده نخواهد شد."
        }
      ],
      "verse_count": 13,
      "headings": [],
      "footnotes": [
        {
          "verse": 1,
          "usfm": "NAM.2.1",
          "note_ref": "2‏:1",
          "note_type": "footnote",
          "references": [],
          "text": "این فصل تسخیر نینوا به دست سپاهیان ماد و بابِل در سال ۶۱۲ ق.م. را پیشگویی می‌کند."
        }
      ],
