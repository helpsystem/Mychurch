  "chapters": [
    {
      "schema_version": 6,
      "book_id": "NAM",
      "chapter": 1,
      "chapter_usfm": "NAM.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "NAM.1.1",
          "line_type": "p",
          "text": "خداوند این رؤیا را که دربارهٔ نینوا است به ناحوم القوشی نشان داد:"
        },
        {
          "verse": 2,
          "usfm": "NAM.1.2",
          "line_type": "p",
          "text": "یهوه خدایی غیور است و از کسانی که با وی مخالفت ورزند، انتقام می‌گیرد و با خشم شدید آنان را مجازات می‌کند."
        },
        {
          "verse": 3,
          "usfm": "NAM.1.3",
          "line_type": "p",
          "text": "خداوند دیر خشمگین می‌شود ولی گناه را هرگز بی‌سزا نمی‌گذارد. قدرت او عظیم است و آن را می‌توان در گردبادهای وحشتناک و طوفانهای شدید مشاهده کرد. ابرها خاک زیر پای او هستند!"
        },
        {
          "verse": 4,
          "usfm": "NAM.1.4",
          "line_type": "p",
          "text": "به فرمان خداوند دریاها و رودها خشک می‌شوند، چراگاههای سبز و خرم باشان و کرمل از بین می‌روند و جنگلهای سرسبز لبنان طراوت و خرمی خود را از دست می‌دهند."
        },
        {
          "verse": 5,
          "usfm": "NAM.1.5",
          "line_type": "p",
          "text": "در حضور او کوهها می‌لرزند، تپه‌ها گداخته می‌شوند، زمین متلاشی می‌گردد و ساکنانش نابود می‌شوند."
        },
        {
          "verse": 6,
          "usfm": "NAM.1.6",
          "line_type": "p",
          "text": "کیست که بتواند در برابر خشم خدا ایستادگی کند؟ غضب او مانند آتش فرو می‌ریزد و کوهها در برابر خشم او خرد می‌شوند."
        },
        {
          "verse": 7,
          "usfm": "NAM.1.7",
          "line_type": "p",
          "text": "خداوند نیکوست و در روز بلا و سختی پناهگاه می‌باشد. او از کسانی که به او توکل می‌کنند مراقبت می‌نماید،"
        },
        {
          "verse": 8,
          "usfm": "NAM.1.8",
          "line_type": "p",
          "text": "ولی دشمنان خود را با سیلابی شدید از بین می‌برد و آنها را به ظلمت مرگ روانه می‌کند."
        },
        {
          "verse": 9,
          "usfm": "NAM.1.9",
          "line_type": "p",
          "text": "ای نینوا، چرا به فکر مخالفت با خداوند هستی؟ او با یک ضربه تو را از پای در خواهد آورد، به طوری که دیگر نخواهی توانست مقاومت کنی."
        },
        {
          "verse": 10,
          "usfm": "NAM.1.10",
          "line_type": "p",
          "text": "دشمنانش را همچون خارهای به هم پیچیده و مانند کسانی که از مستی تلوتلو می‌خورند به داخل آتش می‌اندازد و آنها همچون کاه در شعله‌های آتش سوخته شده دود می‌شوند."
        },
        {
          "verse": 11,
          "usfm": "NAM.1.11",
          "line_type": "p",
          "text": "این پادشاه تو کیست که جرأت می‌کند بر ضد خداوند توطئه کند؟"
        },
        {
          "verse": 12,
          "usfm": "NAM.1.12",
          "line_type": "p",
          "text": "خداوند می‌فرماید: «سپاه آشور هر قدر هم قوی و بزرگ باشد، محو و نابود خواهد شد.«ای قوم من، به اندازۀ کافی شما را تنبیه کرده‌ام، اما بار دیگر تنبیه‌تان نخواهم کرد."
        },
        {
          "verse": 13,
          "usfm": "NAM.1.13",
          "line_type": "p",
          "text": "اینک زنجیرهای شما را پاره می‌کنم و شما را از قید اسارت پادشاه آشور آزاد می‌سازم.»"
        },
        {
          "verse": 14,
          "usfm": "NAM.1.14",
          "line_type": "p",
          "text": "خداوند به پادشاه آشور می‌فرماید: «نسل تو را از بین می‌برم تا نام و نشانی از تو باقی نماند. بتها و بتخانه‌های تو را نابود خواهم کرد و قبرت را خواهم کند، زیرا تو نفرت‌انگیزی.»"
        },
        {
          "verse": 15,
          "usfm": "NAM.1.15",
          "line_type": "p",
          "text": "ببینید، قاصدی از کوهها سرازیر شده، خبر خوش پیروزی را ندا می‌دهد. ای یهودا، عیدهای خود را برگزار نما و نذرهای خود را به خدا وفا کن، چون دشمن، دیگر هرگز برنمی‌گردد. او برای همیشه ریشه‌کن شده است!"
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 15,
          "text": "خبر سقوط نینوا"
        }
      ],
      "footnotes": [],
