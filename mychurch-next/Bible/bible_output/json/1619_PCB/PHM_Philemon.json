  "chapters": [
    {
      "schema_version": 6,
      "book_id": "PHM",
      "chapter": 1,
      "chapter_usfm": "PHM.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHM.1.1",
          "line_type": "p",
          "text": "این نامه از طرف پولس است، که به سبب اعلام مژدهٔ انجیل مسیحْ عیسی در زندان به سر می‌برد، و نیز از طرف برادر ما تیموتائوس.این نامه را به فیلیمون، دوست گرامی و همکار عزیز ما می‌نویسم،"
        },
        {
          "verse": 2,
          "usfm": "PHM.1.2",
          "line_type": "p",
          "text": "و نیز به خواهر ما اَپفیه، و به همسنگرمان، اَرخیپوس، و به کلیسایی که در خانه‌ات تشکیل می‌شود."
        },
        {
          "verse": 3,
          "usfm": "PHM.1.3",
          "line_type": "p",
          "text": "از پدرمان، خدا، و خداوندمان، عیسی مسیح، خواستار فیض و آرامش برای شما هستم."
        },
        {
          "verse": 4,
          "usfm": "PHM.1.4",
          "line_type": "p",
          "text": "فیلیمون عزیز، هر بار که برای تو دعا می‌کنم، ابتدا خدا را برای وجود تو شکر می‌کنم،"
        },
        {
          "verse": 5,
          "usfm": "PHM.1.5",
          "line_type": "p",
          "text": "زیرا از دیگران می‌شنوم که چه ایمان استواری به عیسای خداوند داری، و چه محبتی در حق همۀ مقدّسان، یعنی در حق ایمانداران انجام می‌دهی."
        },
        {
          "verse": 6,
          "usfm": "PHM.1.6",
          "line_type": "p",
          "text": "دعا می‌کنم که ایمان و اعتمادی را که به خداوند داری، با دیگران در میان بگذاری، تا ایشان نیز تحت تأثیر قرار گیرند و ببینند که چه نیکویی‌ها و مواهبی از عیسی مسیح نصیب تو شده است."
        },
        {
          "verse": 7,
          "usfm": "PHM.1.7",
          "line_type": "p",
          "text": "من خودم از محبت تو ای برادر، شادی و تسلی پیدا کرده‌ام، زیرا مهربانی تو دلهای ایمانداران را تازه کرده است."
        },
        {
          "verse": 8,
          "usfm": "PHM.1.8",
          "line_type": "p",
          "text": "از این رو، گرچه در مسیح حق دارم جسارت کنم و به تو دستور دهم تا آنچه را که درست است انجام دهی،"
        },
        {
          "verse": 9,
          "usfm": "PHM.1.9",
          "line_type": "p",
          "text": "اما بر اساس محبت، ترجیح می‌دهم آن را به شکل خواهش مطرح کنم. بله، من، پولسِ پیر، که اکنون به خاطر خدمت به مسیحْ عیسی زندانی نیز شده‌ام،"
        },
        {
          "verse": 10,
          "usfm": "PHM.1.10",
          "line_type": "p",
          "text": "از تو استدعا می‌کنم که با فرزندم، اُنیسیموس که در زمان حبس خود، پدرِ ایمانیِ او شدم، مهربان باشی."
        },
        {
          "verse": 11,
          "usfm": "PHM.1.11",
          "line_type": "p",
          "text": "انیسیموس (با اینکه معنی نامش «مفید» است) در گذشته برای تو مفید نبوده است، اما اکنون چه برای تو و چه برای من مفید است."
        },
        {
          "verse": 12,
          "usfm": "PHM.1.12",
          "line_type": "p",
          "text": "حال که او را نزد تو باز می‌گردانم، درست مانند این است که قلب خود را می‌فرستم."
        },
        {
          "verse": 13,
          "usfm": "PHM.1.13",
          "line_type": "p",
          "text": "می‌خواستم او را نزد خود نگاه دارم، تا در این مدتی که به سبب اعلام پیغام انجیل در زندان به سر می‌برم، به جای تو مرا کمک کند."
        },
        {
          "verse": 14,
          "usfm": "PHM.1.14",
          "line_type": "p",
          "text": "اما نخواستم بدون موافقت تو این کار را انجام دهم تا نیکوکاری تو از روی اجبار نباشد، بلکه از روی میل و اختیار."
        },
        {
          "verse": 15,
          "usfm": "PHM.1.15",
          "line_type": "p",
          "text": "شاید او به این دلیل برای مدتی کوتاه از تو جدا شد تا برای همیشه نزد تو بازگردد،"
        },
        {
          "verse": 16,
          "usfm": "PHM.1.16",
          "line_type": "p",
          "text": "اما نه دیگر به‌عنوان غلام و برده، بلکه برتر از غلام، به‌عنوان برادری عزیز. او برای من بسیار عزیز است، اما برای تو عزیزتر، هم به‌عنوان یک همنوع و هم به‌عنوان برادر در خداوند."
        },
        {
          "verse": 17,
          "usfm": "PHM.1.17",
          "line_type": "p",
          "text": "اگر واقعاً مرا دوست خود می‌دانی، به همان صورت که از من استقبال می‌کردی، از او نیز استقبال کن و او را بپذیر."
        },
        {
          "verse": 18,
          "usfm": "PHM.1.18",
          "line_type": "p",
          "text": "اگر هم پیش از این ضرری به تو رسانده یا چیزی به تو بدهکار باشد، آن را به حساب من بگذار."
        },
        {
          "verse": 19,
          "usfm": "PHM.1.19",
          "line_type": "p",
          "text": "من، پولس، این را به دست خودم می‌نویسم که آن را پس خواهم داد. البته لازم به یادآوری نیست که تو خودت جانت را به من مدیونی."
        },
        {
          "verse": 20,
          "usfm": "PHM.1.20",
          "line_type": "p",
          "text": "بله، برادر عزیزم، این محبت را در حق من انجام ده، تا دل خستهٔ من شاد شود و مسیح را سپاس گویم."
        },
        {
          "verse": 21,
          "usfm": "PHM.1.21",
          "line_type": "p",
          "text": "این نامه را برایت می‌نویسم، چون یقین دارم که هر چه از تو تقاضا کنم، حتی بیشتر از آن را انجام خواهی داد."
        },
        {
          "verse": 22,
          "usfm": "PHM.1.22",
          "line_type": "p",
          "text": "در ضمن، اتاقی نیز برای من آماده کن، زیرا امیدوارم که خدا دعای شما را مستجاب فرموده، اجازه دهد که به‌زودی نزد شما آیم."
        },
        {
          "verse": 23,
          "usfm": "PHM.1.23",
          "line_type": "p",
          "text": "همزندانی من اِپافراس، که او نیز به سبب اعلام پیغام انجیل عیسی مسیح زندانی است، سلام می‌رساند."
        },
        {
          "verse": 24,
          "usfm": "PHM.1.24",
          "line_type": "p",
          "text": "همچنین همکاران من، مرقس، اَرِستَرخوس، دیماس و لوقا سلام می‌رسانند."
        },
        {
          "verse": 25,
          "usfm": "PHM.1.25",
          "line_type": "p",
          "text": "فیض خداوند ما عیسی مسیح با روح شما باد."
        }
      ],
      "verse_count": 25,
      "headings": [
        {
          "before_verse": 4,
          "text": "شکرگزاری و دعا"
        },
        {
          "before_verse": 8,
          "text": "تقاضای پولس برای انیسیموس"
        }
      ],
