  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2PE",
      "chapter": 1,
      "chapter_usfm": "2PE.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2PE.1.1",
          "line_type": "p",
          "text": "این نامه از طرف شمعون پطرس، خدمتگزار و رسول عیسی مسیح است.این نامه را به همهٔ شما که با ما ایمانی یکسان دارید می‌نویسم. این ایمان به برکت عدالت عیسی مسیح، خداوند و نجات دهندۀ ما نصیبتان شده است."
        },
        {
          "verse": 2,
          "usfm": "2PE.1.2",
          "line_type": "p",
          "text": "دعا می‌کنم که خدا به شما که در شناخت خدا و خداوندمان عیسی رشد می‌کنید، هر چه بیشتر فیض و آرامش بخشد."
        },
        {
          "verse": 3,
          "usfm": "2PE.1.3",
          "line_type": "p",
          "text": "او همچنین با قدرت الهی خود، هر چه که برای یک زندگی خداپسندانه نیاز داریم، به ما می‌بخشد و حتی ما را در جلال و نیکویی خود سهیم می‌سازد؛ اما برای این منظور، لازم است که او را بهتر و عمیقتر بشناسیم."
        },
        {
          "verse": 4,
          "usfm": "2PE.1.4",
          "line_type": "p",
          "text": "با همین قدرت عظیم بود که تمام برکات غنی و عالی را که وعده داده بود، به ما بخشید. یکی از این وعده‌ها این بود که ما را از شهوت و فساد محیط اطرافمان رهایی دهد و از طبیعت و صفات الهی خود بهره‌ای به ما ببخشد."
        },
        {
          "verse": 5,
          "usfm": "2PE.1.5",
          "line_type": "p",
          "text": "با توجه به این موضوع، نهایت کوشش خود را بکنید تا به ایمان خود نیکویی را بیافزایید؛ و به نیکویی، شناخت را؛"
        },
        {
          "verse": 6,
          "usfm": "2PE.1.6",
          "line_type": "p",
          "text": "و به شناخت، خویشتنداری را؛ و به خویشتنداری، پایداری را؛ و به پایداری، دینداری را؛"
        },
        {
          "verse": 7,
          "usfm": "2PE.1.7",
          "line_type": "p",
          "text": "و به دینداری، محبت برادرانه؛ و به محبت برادرانه، محبت نسبت به همۀ مردم."
        },
        {
          "verse": 8,
          "usfm": "2PE.1.8",
          "line_type": "p",
          "text": "اگر اجازه دهید این خصلت‌های خوب در شما رشد کنند و فزونی یابند، از لحاظ روحانی نیرومند شده، برای خداوندمان عیسی مسیح مفید و پرثمر خواهید شد."
        },
        {
          "verse": 9,
          "usfm": "2PE.1.9",
          "line_type": "p",
          "text": "اما کسی که اجازه نمی‌دهد این خصوصیات در او ریشه بدوانند، در حقیقت کور یا لااقل کوته‌بین است و فراموش کرده است که خدا او را از زندگی گناه‌آلود سابقش نجات داده تا بتواند برای خداوند زندگی کند."
        },
        {
          "verse": 10,
          "usfm": "2PE.1.10",
          "line_type": "p",
          "text": "بنابراین، ای برادران عزیز، بکوشید تا ثابت کنید که حقیقتاً جزو برگزیدگان و دعوت‌شدگان خدا هستید؛ زیرا اگر چنین کنید، هرگز لغزش نخواهید خورد و از خدا دور نخواهید شد؛"
        },
        {
          "verse": 11,
          "usfm": "2PE.1.11",
          "line_type": "p",
          "text": "و خدا نیز دروازه‌های آسمان را به روی شما خواهد گشود تا وارد ملکوت جاودانی خداوند و نجات‌دهندهٔ‌مان عیسی مسیح گردید."
        },
        {
          "verse": 12,
          "usfm": "2PE.1.12",
          "line_type": "p",
          "text": "اما من هرگز از یادآوری این مطالب به شما، کوتاهی نخواهم کرد، گرچه آنها را می‌دانید و در حقیقتی که یافته‌اید، ثابت و استوار می‌باشید."
        },
        {
          "verse": 13,
          "usfm": "2PE.1.13",
          "line_type": "p",
          "text": "تا زمانی که در این دنیای فانی به سر می‌برم، وظیفهٔ خود می‌دانم که این نکات را به شما تذکر دهم تا آنها را فراموش نکنید."
        },
        {
          "verse": 14,
          "usfm": "2PE.1.14",
          "line_type": "p",
          "text": "زیرا می‌دانم که به‌زودی دار فانی را وداع خواهم گفت؛ خداوندمان عیسی مسیح نیز مرا از این موضوع آگاه ساخته است."
        },
        {
          "verse": 15,
          "usfm": "2PE.1.15",
          "line_type": "p",
          "text": "بنابراین، سعی می‌کنم این نکات را چنان در فکر و ذهن شما نقش نمایم که حتی پس از رحلت من نیز بتوانید آنها را به یاد آورید."
        },
        {
          "verse": 16,
          "usfm": "2PE.1.16",
          "line_type": "p",
          "text": "زمانی که ما دربارهٔ قوت و بازگشت خداوندمان عیسی مسیح با شما سخن گفتیم، داستانهای ساختگی برایتان تعریف نکردیم، زیرا ما با چشمان خود، عظمت و جلال او را دیدیم"
        },
        {
          "verse": 17,
          "usfm": "2PE.1.17",
          "line_type": "p",
          "text": "وقتی از خدای پدر، جلال و اکرام را دریافت کرد. صدایی از جلال پرشکوه خدا به او در رسید و گفت: «این است پسر عزیز من که از او بسیار خشنودم.»"
        },
        {
          "verse": 18,
          "usfm": "2PE.1.18",
          "line_type": "p",
          "text": "بله، ما خود بر آن کوه مقدّس با او بودیم و آن پیام آسمانی را با گوشهای خود شنیدیم."
        },
        {
          "verse": 19,
          "usfm": "2PE.1.19",
          "line_type": "p",
          "text": "همچنین ما پیام انبیا را داریم که بسیار مطمئن است، و شما کار خوبی می‌کنید اگر به این پیام توجه کنید، چرا که پیام آنان مانند چراغی است که در جایی تاریک می‌درخشد تا زمانی که سپیده بر دمد و ستارهٔ صبح یعنی مسیح در دلهایتان طلوع کند."
        },
        {
          "verse": 20,
          "usfm": "2PE.1.20",
          "line_type": "p",
          "text": "قبل از هر چیز این را بدانید که هیچ وحیِ کتب مقدّس از فکر خود انبیا تراوش نکرده،"
        },
        {
          "verse": 21,
          "usfm": "2PE.1.21",
          "line_type": "p",
          "text": "زیرا وحی هرگز منشاء انسانی نداشته است؛ بلکه انبیا تحت نفوذ روح‌القدس از جانب خدا سخن می‌گفتند."
        }
      ],
      "verse_count": 21,
      "headings": [
