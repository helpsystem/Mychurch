    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 2,
      "chapter_usfm": "TIT.2",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.2.1",
          "line_type": "p",
          "text": "اما تو روش صحیح زندگی مسیحی را تعلیم ده."
        },
        {
          "verse": 2,
          "usfm": "TIT.2.2",
          "line_type": "p",
          "text": "به مردان سالخورده تعلیم ده که باوقار و متین و خویشتندار بوده، ایمانی صحیح داشته باشند، و هر کاری را از روی محبت و صبر انجام دهند."
        },
        {
          "verse": 3,
          "usfm": "TIT.2.3",
          "line_type": "p",
          "text": "به زنان سالخورده نیز بیاموز که در زندگی و رفتار خود باوقار باشند، غیبت نکنند، اسیر شراب نبوده، آنچه را که نیکوست، به دیگران تعلیم دهند،"
        },
        {
          "verse": 4,
          "usfm": "TIT.2.4",
          "line_type": "p",
          "text": "تا بتوانند به زنان جوانتر بیاموزند که چگونه شوهر و فرزندان خود را دوست بدارند،"
        },
        {
          "verse": 5,
          "usfm": "TIT.2.5",
          "line_type": "p",
          "text": "عاقل و پاکدامن باشند، و کدبانویی شایسته و همسری مطیع برای شوهر خود باشند، تا کسی بهانه‌ای برای بدگویی از کلام خدا نیابد."
        },
        {
          "verse": 6,
          "usfm": "TIT.2.6",
          "line_type": "p",
          "text": "همچنین، جوانان را نصیحت کن تا پرهیزگار و خرداندیش باشند."
        },
        {
          "verse": 7,
          "usfm": "TIT.2.7",
          "line_type": "p",
          "text": "تو خود نیز باید با انجام هر کار نیکی، برای ایشان نمونه باشی؛ در تعلیم خود، اخلاص و جدّیت به خرج بده."
        },
        {
          "verse": 8,
          "usfm": "TIT.2.8",
          "line_type": "p",
          "text": "سخنانت نیز باید منطقی و معقول باشد، تا کسانی که با تو مخالفت می‌کنند، چون فرصت بد گفتن از ما نیابند، خجل شوند."
        },
        {
          "verse": 9,
          "usfm": "TIT.2.9",
          "line_type": "p",
          "text": "غلامان را نصیحت کن که از دستورهای ارباب خود اطاعت کنند و بکوشند تا در هر امری رضایت خاطر ایشان را فراهم سازند؛ در مقابل گفته‌های ارباب خود نیز جواب پس ندهند؛"
        },
        {
          "verse": 10,
          "usfm": "TIT.2.10",
          "line_type": "p",
          "text": "یادآوری کن که از ایشان دزدی نکنند، بلکه در عمل نشان دهند که از هر جهت قابل اعتماد هستند، به‌گونه‌ای که تعلیم دربارۀ خدا و نجات‌دهندۀ ما را از هر حیث، جذّاب و گیرا سازند."
        },
        {
          "verse": 11,
          "usfm": "TIT.2.11",
          "line_type": "p",
          "text": "زیرا فیض خدا ظاهر شده است، فیضی که سرچشمۀ نجات برای همۀ مردم است،"
        },
        {
          "verse": 12,
          "usfm": "TIT.2.12",
          "line_type": "p",
          "text": "و به ما می‌آموزد که از زندگی بی‌بند و بار و خوشگذرانی‌های گناه‌آلود دست بکشیم و زندگی پاک و خداپسندانه‌ای در این دنیا داشته باشیم."
        },
        {
          "verse": 13,
          "usfm": "TIT.2.13",
          "line_type": "p",
          "text": "اگر چنین زندگی کنیم، می‌توانیم با امید و اشتیاق، منتظر روز مبارکی باشیم که در آن، خدای بزرگ و نجات دهنده‌مان عیسی مسیح باشکوه و جلال ظاهر می‌شود."
        },
        {
          "verse": 14,
          "usfm": "TIT.2.14",
          "line_type": "p",
          "text": "او جان خود را در راه گناهان ما فدا ساخت تا ما را از هر شرارتی رهایی بخشد، و ما را طاهر سازد، و از ما قومی پدید آوَرَد که به شکلی خاص متعلق به او بوده، عمیقاً مشتاق انجام اعمال نیک باشند."
        },
        {
          "verse": 15,
          "usfm": "TIT.2.15",
          "line_type": "p",
          "text": "این حقایق را تعلیم ده و مؤمنین را به انجام آنها تشویق کن. هرگاه لازم دیدی، با قدرت و اختیار کامل ایشان را توبیخ و اصلاح نما. اجازه نده کسی سخنان تو را خوار بشمارد."
        }
      ],
