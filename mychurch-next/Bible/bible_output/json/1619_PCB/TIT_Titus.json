  "chapters": [
    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 1,
      "chapter_usfm": "TIT.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.1.1",
          "line_type": "p",
          "text": "این نامه از طرف پولس، غلام خدا و رسول عیسی مسیح است. من فرستاده شده‌ام تا ایمان برگزیدگان خدا را تقویت کنم و به ایشان تعلیم دهم تا حقیقتی را بشناسند که به آنها نشان می‌دهد چگونه زندگی خداپسندانه‌ای داشته باشند."
        },
        {
          "verse": 2,
          "usfm": "TIT.1.2",
          "line_type": "p",
          "text": "این حقیقت به ایشان اطمینان می‌بخشد که از حیات جاویدان برخوردارند، حیاتی که خدایی که دروغ نمی‌گوید، از ازل وعده‌اش را داده بود،"
        },
        {
          "verse": 3,
          "usfm": "TIT.1.3",
          "line_type": "p",
          "text": "و اکنون، درست در زمان مقرّر، آن را از طریق موعظه‌ای که به دستور نجات‌دهندۀ ما خدا به من سپرده شده، آشکار ساخته است."
        },
        {
          "verse": 4,
          "usfm": "TIT.1.4",
          "line_type": "p",
          "text": "این نامه را به تیتوس، فرزند راستینم در ایمان مشترکمان، می‌نویسم:از پدرمان خدا و نجات دهنده‌مان، مسیحْ عیسی، برای تو خواستار فیض و آرامش هستم."
        },
        {
          "verse": 5,
          "usfm": "TIT.1.5",
          "line_type": "p",
          "text": "تو را به این سبب در جزیرهٔ کریت گذاشتم تا به هر آنچه که ناتمام مانده، نظم و ترتیب ببخشی، و در هر شهر، مطابق رهنمودهایی که به تو دادم، مشایخی تعیین کنی."
        },
        {
          "verse": 6,
          "usfm": "TIT.1.6",
          "line_type": "p",
          "text": "زندگی شیخ باید بدون عیب باشد، او باید شوهری وفادار برای یگانه همسر خود باشد، و فرزندانش نیز با ایمان باشند و کسی نتواند ایشان را به چشم ولگرد و یاغی نگاه کند."
        },
        {
          "verse": 7,
          "usfm": "TIT.1.7",
          "line_type": "p",
          "text": "چرا که شیخ مسئول ادارۀ کار خدا است و از این رو باید زندگی بدون عیب داشته باشد؛ همچنین نباید بی‌ادب و تندخو، مشروبخوار و اهل نزاع باشد. در زمینۀ امور مالی نیز باید از نادرستی و تقلّب دوری کند،"
        },
        {
          "verse": 8,
          "usfm": "TIT.1.8",
          "line_type": "p",
          "text": "و نیز باید مهمان‌نواز و دوستدار اعمال خیر باشد. او باید شخصی روشن‌بین، منصف، پاک و خویشتندار باشد."
        },
        {
          "verse": 9,
          "usfm": "TIT.1.9",
          "line_type": "p",
          "text": "باید به حقایقی که آموخته است، ایمان و اعتقادی راسخ داشته باشد، تا بتواند آنها را به دیگران تعلیم دهد و به کسانی که با آنها مخالفت می‌کنند، نشان دهد که در اشتباهند."
        },
        {
          "verse": 10,
          "usfm": "TIT.1.10",
          "line_type": "p",
          "text": "زیرا اشخاص سرکش و نافرمان بسیارند، خصوصاً در میان آن دسته از مسیحیان یهودی‌نژاد که معتقدند مسیحیان نیز باید احکام دین یهود را اجرا کنند. اما سخنان ایشان پوچ و گمراه کننده است."
        },
        {
          "verse": 11,
          "usfm": "TIT.1.11",
          "line_type": "p",
          "text": "پس باید دهان ایشان را بست، زیرا خانواده‌های بسیاری، در اثر سخنان آنان از راه راست منحرف شده‌اند. این معلمین گمراه که چنین تعالیمی می‌دهند، فقط به فکر کسب منافع مادی می‌باشند."
        },
        {
          "verse": 12,
          "usfm": "TIT.1.12",
          "line_type": "p",
          "text": "حتی یکی از خود ایشان که ادعای پیغمبری هم می‌کند، دربارهٔ آنان گفته است: «اهالی کریت، همه دروغگویند؛ مانند حیوانات تنبلی هستند که فقط برای شکم زندگی می‌کنند.»"
        },
        {
          "verse": 13,
          "usfm": "TIT.1.13",
          "line_type": "p",
          "text": "گفتهٔ او درست است. بنابراین، لازم است به مسیحیان کریت خیلی جدی حکم کنی تا در ایمان و اعتقاد خود قوی باشند؛"
        },
        {
          "verse": 14,
          "usfm": "TIT.1.14",
          "line_type": "p",
          "text": "و اجازه نده به افسانه‌های یهود و سخنان مردمانی که از راستی منحرف شده‌اند، گوش فرا دهند."
        },
        {
          "verse": 15,
          "usfm": "TIT.1.15",
          "line_type": "p",
          "text": "کسی که دلش پاک است، همه چیز برایش پاک است؛ اما کسی که دلی سیاه دارد و بی‌ایمان است، هیچ چیز برایش پاک نیست، زیرا هم فکرش فاسد و آلوده است و هم وجدانش."
        },
        {
          "verse": 16,
          "usfm": "TIT.1.16",
          "line_type": "p",
          "text": "این‌گونه انسانها ادعا می‌کنند که خدا را می‌شناسند، اما با کردارشان او را انکار می‌کنند. آنها نفرت‌انگیز و یاغی‌اند و به درد هیچ کار خوبی نمی‌خورند."
        }
      ],
      "verse_count": 16,
      "headings": [
        {
          "before_verse": 5,
          "text": "وظیفهٔ تیتوس در کریت"
        }
      ],
      "footnotes": [
        {
          "verse": 6,
          "usfm": "TIT.1.6",
          "note_ref": "1‏:6",
          "note_type": "footnote",
          "references": [],
          "text": "یا «ناظر»."
        }
      ],
