  "chapters": [
    {
      "schema_version": 6,
      "book_id": "2JN",
      "chapter": 1,
      "chapter_usfm": "2JN.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "2JN.1.1",
          "line_type": "p",
          "text": "از شیخ کلیسا،به بانوی برگزیده و فرزندانش که ایشان را به راستی دوست می‌دارم – و نه تنها من، بلکه همۀ کسانی که راستی را شناخته‌اند."
        },
        {
          "verse": 2,
          "usfm": "2JN.1.2",
          "line_type": "p",
          "text": "این محبت به خاطر آن راستی است که در وجود ما قرار دارد و تا ابد در ما خواهد ماند."
        },
        {
          "verse": 3,
          "usfm": "2JN.1.3",
          "line_type": "p",
          "text": "فیض و رحمت و آرامش از جانب خدای پدر و عیسی مسیح پسر او با ما خواهد بود، زیرا ما به او ایمان حقیقی داریم و یکدیگر را واقعاً محبت می‌نماییم."
        },
        {
          "verse": 4,
          "usfm": "2JN.1.4",
          "line_type": "p",
          "text": "چقدر شاد شدم که دیدم بعضی از فرزندان تو که در اینجا هستند، از حقیقت پیروی می‌کنند و احکام پدر ما خدا را نگاه می‌دارند."
        },
        {
          "verse": 5,
          "usfm": "2JN.1.5",
          "line_type": "p",
          "text": "بانوی گرامی، غرض از نوشتن این نامه این است که آن حکم قدیمی را که خدا از ابتدا به ما داد، به یادتان بیاورم، و آن حکم این است که یکدیگر را محبت نماییم."
        },
        {
          "verse": 6,
          "usfm": "2JN.1.6",
          "line_type": "p",
          "text": "اگر خدا را دوست داریم، باید حکم او را نیز اطاعت کنیم؛ و حکم او از ابتدا این بوده است که به یکدیگر محبت نماییم."
        },
        {
          "verse": 7,
          "usfm": "2JN.1.7",
          "line_type": "p",
          "text": "این را می‌گویم چون معلمین فریبکار بسیاری در دنیا هستند. ایشان قبول ندارند که عیسی مسیح به صورت یک انسان و با بدنی همچون بدن ما به این جهان آمد. چنین افراد، فریبکار و ضدمسیح هستند."
        },
        {
          "verse": 8,
          "usfm": "2JN.1.8",
          "line_type": "p",
          "text": "بنابراین، از ایشان برحذر باشید تا مانند آنان نشوید، مبادا اجر آسمانی خود را از دست بدهید که همه ما برای به دست آوردن آن، اینقدر تلاش کرده‌ایم. پس بکوشید تا پاداش خود را تمام و کمال از خداوند دریافت دارید."
        },
        {
          "verse": 9,
          "usfm": "2JN.1.9",
          "line_type": "p",
          "text": "زیرا اگر از تعالیم مسیح منحرف شوید، از خدا نیز منحرف خواهید شد. اما اگر به تعالیم مسیح وفادار بمانید، خدا را نیز خواهید داشت. به این ترتیب، هم «پدر» را خواهید داشت و هم «پسر» را."
        },
        {
          "verse": 10,
          "usfm": "2JN.1.10",
          "line_type": "p",
          "text": "اگر کسی نزد شما بیاید و این تعلیم را نیاورد، او را به خانهٔ خود راه ندهید و حتی به او سلام نکنید،"
        },
        {
          "verse": 11,
          "usfm": "2JN.1.11",
          "line_type": "p",
          "text": "زیرا اگر با آنان معاشرت کنید، مانند آنان خواهید شد."
        },
        {
          "verse": 12,
          "usfm": "2JN.1.12",
          "line_type": "p",
          "text": "مطالب بسیاری برای گفتن دارم، اما نمی‌خواهم همه را در این نامه بنویسم، زیرا امیدوارم بتوانم به‌زودی بیایم و شما را ببینم. آنگاه خواهیم توانست حضوراً گفتگو کنیم تا خوشی ما کامل شود."
        },
        {
          "verse": 13,
          "usfm": "2JN.1.13",
          "line_type": "p",
          "text": "فرزندان خواهر برگزیده‌ات، سلام می‌رسانند."
        }
      ],
      "verse_count": 13,
      "headings": [
        {
          "before_verse": 4,
          "text": "پیروی از حقیقت"
        },
        {
          "before_verse": 12,
          "text": "خاتمه"
        }
      ],
