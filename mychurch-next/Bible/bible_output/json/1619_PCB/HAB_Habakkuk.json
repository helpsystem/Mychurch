  "chapters": [
    {
      "schema_version": 6,
      "book_id": "HAB",
      "chapter": 1,
      "chapter_usfm": "HAB.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAB.1.1",
          "line_type": "p",
          "text": "این است پیغامی که خداوند در رؤیا به حبقوق نبی نشان داد."
        },
        {
          "verse": 2,
          "usfm": "HAB.1.2",
          "line_type": "p",
          "text": "ای خداوند، تا به کی از تو کمک بطلبم و تو نشنوی؟ فریاد برمی‌آورم «خشونت!»، اما بی‌فایده است، زیرا تو ما را از ظلم نجات نمی‌دهی."
        },
        {
          "verse": 3,
          "usfm": "HAB.1.3",
          "line_type": "p",
          "text": "تا به کی باید ناظر این بی‌عدالتی‌ای که اطراف مرا گرفته است باشم؟ چرا کاری نمی‌کنی؟ به هر جا که نگاه می‌کنم خرابی و ظلم می‌بینم، همه جا را جنگ و دشمنی فرا گرفته است."
        },
        {
          "verse": 4,
          "usfm": "HAB.1.4",
          "line_type": "p",
          "text": "قانون سست شده و عدالت هرگز بجا آورده نمی‌شود. شریران، درستکاران را در تنگنا گذاشته‌اند و عدالت مفهوم خود را از دست داده است."
        },
        {
          "verse": 5,
          "usfm": "HAB.1.5",
          "line_type": "p",
          "text": "«به قومهای اطراف خود نگاه کنید و تعجب نمایید! شما از آنچه می‌خواهم انجام دهم حیران خواهید شد! زیرا در روزگار شما کاری می‌کنم که حتی وقتی خبرش را به شما دهند، باور نکنید!"
        },
        {
          "verse": 6,
          "usfm": "HAB.1.6",
          "line_type": "p",
          "text": "من بابِلی‌های ظالم و ستمگر را به قدرت می‌رسانم تا به سراسر جهان تاخته مسکنهایی را که مال خودشان نیست به تصرف در آورند."
        },
        {
          "verse": 7,
          "usfm": "HAB.1.7",
          "line_type": "p",
          "text": "آنها هولناک و مهیبند، هر چه بخواهند می‌کنند، و کسی را یارای مقاومت در برابر آنها نیست."
        },
        {
          "verse": 8,
          "usfm": "HAB.1.8",
          "line_type": "p",
          "text": "اسبانشان از یوزپلنگان چالاکترند و از گرگان شب وحشی‌تر. سواران آنها از سرزمین دور دست می‌تازند و همچون عقاب بر سر صید خود فرود می‌آیند."
        },
        {
          "verse": 9,
          "usfm": "HAB.1.9",
          "line_type": "p",
          "text": "با خشونت به پیش می‌تازند و مثل ریگ بیابان اسیر می‌گیرند."
        },
        {
          "verse": 10,
          "usfm": "HAB.1.10",
          "line_type": "p",
          "text": "«پادشاهان و بزرگان را تمسخر می‌کنند و قلعه‌ها را به هیچ می‌شمارند. در پشت دیوار قلعه‌ها، از خاک تپه می‌سازند و آنها را تصرف می‌کنند!"
        },
        {
          "verse": 11,
          "usfm": "HAB.1.11",
          "line_type": "p",
          "text": "مثل باد یورش می‌برند و می‌گذرند. ولی گناهشان بزرگ است، زیرا قدرت خود را خدای خود می‌دانند.»"
        },
        {
          "verse": 12,
          "usfm": "HAB.1.12",
          "line_type": "p",
          "text": "ای یهوه، خدای من! ای قدوس من که از ازل هستی! تو نخواهی گذاشت که ما نابود شویم. ای خدایی که صخرهٔ ما هستی، تو به بابِلی‌ها قدرت بخشیدی تا ما را تنبیه کنند."
        },
        {
          "verse": 13,
          "usfm": "HAB.1.13",
          "line_type": "p",
          "text": "درست است که ما گناهکاریم، ولی آنها از ما گناهکارترند. چشمان تو پاکتر از آن است که بر گناه بنگرد، و تو عادلتر از آن هستی که بی‌انصافی را تحمل کنی. پس چرا هنگامی که شریران مردمی را که از خودشان عادلترند می‌بلعند، خاموش می‌مانی؟ چرا مردم را مانند ماهیان و جانوران دریا که مدافعی ندارند به قلاب بابِلی‌ها می‌اندازی؟ آنها با تور خود مردم را به دام می‌اندازند و از صید آنها شادی می‌کنند."
        },
        {
          "verse": 16,
          "usfm": "HAB.1.16",
          "line_type": "p",
          "text": "سپس رفته، به تورهای خود قربانی تقدیم می‌کنند و برای دامهای خویش بخور می‌سوزانند، زیرا خوراک و ثروت خود را مدیون این تورها می‌دانند."
        },
        {
          "verse": 17,
          "usfm": "HAB.1.17",
          "line_type": "p",
          "text": "آیا تو می‌گذاری آنها دائم به کشتار خود ادامه دهند و مردم را بی‌رحمانه نابود کنند؟"
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 2,
          "text": "شکایت حبقوق"
        },
        {
          "before_verse": 5,
          "text": "پاسخ خداوند به قوم یهود"
        },
        {
          "before_verse": 12,
          "text": "شکایت دوم حبقوق"
        }
      ],
