    {
      "schema_version": 6,
      "book_id": "HAB",
      "chapter": 3,
      "chapter_usfm": "HAB.3",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAB.3.1",
          "line_type": "p",
          "text": "این است دعای حبقوق نبی:"
        },
        {
          "verse": 2,
          "usfm": "HAB.3.2",
          "line_type": "p",
          "text": "ای خداوند، خبری را که به من دادی شنیدم و برای کارهایی که انجام خواهی داد با ترس و احترام تو را پرستش می‌کنم. دوباره مثل سالهای گذشته قدرت خود را به ما نشان ده تا نجات یابیم و در حین غضب خود، رحمت را به یاد آور."
        },
        {
          "verse": 3,
          "usfm": "HAB.3.3",
          "line_type": "p",
          "text": "خدا را می‌بینم که از تیمان می‌آید، آن قدوس از کوه فاران حرکت می‌کند. جلالش آسمانها را در بر گرفته و زمین از حمد و سپاس او پر است!"
        },
        {
          "verse": 4,
          "usfm": "HAB.3.4",
          "line_type": "p",
          "text": "درخشش او مانند طلوع خورشید است و از دستهای او که قدرتش در آنها نهفته است، نور می‌تابد."
        },
        {
          "verse": 5,
          "usfm": "HAB.3.5",
          "line_type": "p",
          "text": "او مرض را پیشاپیش خود می‌فرستد و به مرگ فرمان می‌دهد که به دنبال او بیاید."
        },
        {
          "verse": 6,
          "usfm": "HAB.3.6",
          "line_type": "p",
          "text": "وقتی او می‌ایستد زمین تکان می‌خورد و هنگامی که نگاه می‌کند، قومها می‌لرزند. کوههای ازلی خرد می‌شوند و تپه‌های ابدی با خاک یکسان می‌گردند. قدرت او بی‌زوال است."
        },
        {
          "verse": 7,
          "usfm": "HAB.3.7",
          "line_type": "p",
          "text": "مردمان کوشان و مدیان را می‌بینم که دچار ترس و اضطراب شده‌اند."
        },
        {
          "verse": 8,
          "usfm": "HAB.3.8",
          "line_type": "p",
          "text": "خداوندا، آیا تو بر رودخانه‌ها و دریا خشمگین بودی که بر اسبان و ارابه‌هایت سوار شدی؟ نه، تو برای پیروزی قومت این کار را کردی."
        },
        {
          "verse": 9,
          "usfm": "HAB.3.9",
          "line_type": "p",
          "text": "تو کمان را به دست گرفته، تیرها را آماده کردی و صاعقه را فرستاده زمین را شکافتی."
        },
        {
          "verse": 10,
          "usfm": "HAB.3.10",
          "line_type": "p",
          "text": "کوهها تو را دیدند و به لرزه افتادند و سیلابها جاری شدند. آبهای عمیق طغیان کردند و امواجشان بالا آمدند."
        },
        {
          "verse": 11,
          "usfm": "HAB.3.11",
          "line_type": "p",
          "text": "از نور تیرهایت و از برق نیزه‌های درخشانت خورشید و ماه ایستادند."
        },
        {
          "verse": 12,
          "usfm": "HAB.3.12",
          "line_type": "p",
          "text": "با غضب جهان را پیمودی و قومها را زیر پای خود لگدمال کردی."
        },
        {
          "verse": 13,
          "usfm": "HAB.3.13",
          "line_type": "p",
          "text": "تو برای نجات قوم برگزیدهٔ خود برخاستی و رهبر شریران را نابود کردی و پیروانش را از بین بردی."
        },
        {
          "verse": 14,
          "usfm": "HAB.3.14",
          "line_type": "p",
          "text": "آنها مثل گردباد بیرون آمده، خیال کردند اسرائیل به آسانی به چنگشان می‌افتد، ولی تو با سلاحهای خودشان آنها را نابود کردی."
        },
        {
          "verse": 15,
          "usfm": "HAB.3.15",
          "line_type": "p",
          "text": "با اسبان خود از دریا عبور کردی و آبهای نیرومند را زیر پا نهادی."
        },
        {
          "verse": 16,
          "usfm": "HAB.3.16",
          "line_type": "p",
          "text": "وقتی اینها را شنیدم، ترسیدم و لبهایم لرزیدند. بدنم بی‌حس و زانوانم سست گردید. به آرامی انتظار روزی را می‌کشم که خدا قومی را که بر ما هجوم می‌آورد مجازات کند."
        },
        {
          "verse": 17,
          "usfm": "HAB.3.17",
          "line_type": "p",
          "text": "هر چند درخت انجیر شکوفه ندهد و درخت انگور میوه نیاورد، هر چند محصول زیتون از بین برود و زمینها بایر بمانند، هر چند گله‌ها در صحرا بمیرند و آغلها از حیوانات خالی شوند،"
        },
        {
          "verse": 18,
          "usfm": "HAB.3.18",
          "line_type": "p",
          "text": "اما من شاد و خوشحال خواهم بود، زیرا خداوند نجا‌ت‌دهندۀ من است."
        },
        {
          "verse": 19,
          "usfm": "HAB.3.19",
          "line_type": "p",
          "text": "خداوند یهوه قوت من است! او به من قوت می‌دهد تا مانند آهو بدوم و از صخره‌های بلند، بالا بروم.برای رهبر سرایندگان، با همراهی سازهای زهی."
        }
      ],
      "verse_count": 19,
      "headings": [],
      "footnotes": [
        {
          "verse": 7,
          "usfm": "HAB.3.7",
          "note_ref": "3‏:7",
          "note_type": "footnote",
          "references": [
            "EXO.2.15"
          ],
          "text": "کوشان احتمالاً همان سرزمین مدیان است. نگاه کنید به خروج ۲‏:۱۵ به بعد."
        }
      ],
