    {
      "schema_version": 6,
      "book_id": "HAB",
      "chapter": 2,
      "chapter_usfm": "HAB.2",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAB.2.1",
          "line_type": "p",
          "text": "اکنون از برج دیدبانی خود بالا می‌روم و بر حصار ایستاده، منتظر می‌مانم تا ببینم خداوند به شکایت من چه جواب می‌دهد."
        },
        {
          "verse": 2,
          "usfm": "HAB.2.2",
          "line_type": "p",
          "text": "آنگاه خداوند به من فرمود: «آنچه را به تو نشان می‌دهم با خطی درشت و خوانا بر تخته سنگی بنویس تا هر کس بتواند با یک نگاه آن را بخواند."
        },
        {
          "verse": 3,
          "usfm": "HAB.2.3",
          "line_type": "p",
          "text": "اگرچه آنچه به تو نشان می‌دهم در حال حاضر اتفاق نمی‌افتد، ولی مطمئن باش که سرانجام در وقت معین به وقوع خواهد پیوست. هر چند تا وقوع آن، مدت زیادی طول بکشد، ولی منتظر آن باش، زیرا وقوع آن حتمی و بدون تأخیر خواهد بود."
        },
        {
          "verse": 4,
          "usfm": "HAB.2.4",
          "line_type": "p",
          "text": "«به کسانی که به خود می‌بالند نگاه کن! این بدکاران نابود خواهند شد، اما عادل به ایمان خواهد زیست."
        },
        {
          "verse": 5,
          "usfm": "HAB.2.5",
          "line_type": "p",
          "text": "به درستی که ثروت، خیانتکار است و این بابِلی‌های متکبر را به دام خواهد انداخت. آنها با حرص و ولع، مانند مرگ، قومها را یکی پس از دیگری به کام خود می‌کشند و اسیر می‌سازند و هرگز سیر نمی‌شوند."
        },
        {
          "verse": 6,
          "usfm": "HAB.2.6",
          "line_type": "p",
          "text": "اما زمانی خواهد آمد که همهٔ این اسیرشدگان آنها را تمسخر کرده، خواهند گفت: ”ای کسانی که مال و ثروت مردم را به زور از چنگشان درآورده‌اید، اینک به سزای ستمگری‌ها و غارتگری‌های خود می‌رسید.“»"
        },
        {
          "verse": 7,
          "usfm": "HAB.2.7",
          "line_type": "p",
          "text": "ای کسانی که بر دیگران ظلم کرده‌اید، طلبکارانتان ناگهان برخاسته، بر سرتان خواهند ریخت و شما را که درمانده شده‌اید غارت خواهند کرد."
        },
        {
          "verse": 8,
          "usfm": "HAB.2.8",
          "line_type": "p",
          "text": "بسیاری از قومها را غارت کردید و حال، بقیهٔ قومها شما را غارت خواهند کرد، زیرا خون مردم را ریختید و سرزمینها و شهرها را با مردمش نابود کردید."
        },
        {
          "verse": 9,
          "usfm": "HAB.2.9",
          "line_type": "p",
          "text": "وای بر شما که از راههای نادرست ثروت اندوخته‌اید تا زندگی امن و راحتی داشته باشید."
        },
        {
          "verse": 10,
          "usfm": "HAB.2.10",
          "line_type": "p",
          "text": "وای بر شما که قومها را نابود کرده‌اید، زیرا ننگ و نابودی برای خود به بار آورده‌اید."
        },
        {
          "verse": 11,
          "usfm": "HAB.2.11",
          "line_type": "p",
          "text": "حتی سنگهای دیوار و تیرهای سقف خانه‌تان بر ضد شما فریاد برمی‌آورند!"
        },
        {
          "verse": 12,
          "usfm": "HAB.2.12",
          "line_type": "p",
          "text": "وای بر شما که شهرها را با پولی که از راه آدمکشی و غارت به دست آورده‌اید، می‌سازید؛"
        },
        {
          "verse": 13,
          "usfm": "HAB.2.13",
          "line_type": "p",
          "text": "زیرا دارایی خدانشناسان دود شده، به هوا می‌رود و دسترنج آنها نابود می‌گردد. خداوند لشکرهای آسمان چنین مقرر کرده است."
        },
        {
          "verse": 14,
          "usfm": "HAB.2.14",
          "line_type": "p",
          "text": "همان‌گونه که آبها دریا را پر می‌سازند، زمانی خواهد رسید که درک و شناخت عظمت خداوند، جهان را پر خواهد ساخت."
        },
        {
          "verse": 15,
          "usfm": "HAB.2.15",
          "line_type": "p",
          "text": "وای بر شما که همسایگان خود را در زیر ضربه‌هایتان مانند آدمهای مست، بی‌حال و گیج می‌کنید و در آن حال از رسوایی آنها لذت می‌برید."
        },
        {
          "verse": 16,
          "usfm": "HAB.2.16",
          "line_type": "p",
          "text": "به‌زودی شکوه و جلال خود شما به ننگ و رسوایی تبدیل خواهد شد و شما پیالهٔ داوری خداوند را خواهید نوشید و گیج شده، به زمین خواهید افتاد."
        },
        {
          "verse": 17,
          "usfm": "HAB.2.17",
          "line_type": "p",
          "text": "جنگلهای لبنان را از بین بردید، اکنون خود شما نابود خواهید شد! حیوانات آنجا را به وحشت انداخته کشتید، پس حال، برای تمام آدمکشی‌ها و ظلم و ستمی که در سرزمینها و شهرها کردید، وحشتزده کشته خواهید شد."
        },
        {
          "verse": 18,
          "usfm": "HAB.2.18",
          "line_type": "p",
          "text": "از پرستش بتهایی که به دست انسان ساخته شده‌اند چه فایده‌ای بردید؟ آیا آنها توانستند چیزی به شما یاد دهند؟ چقدر نادان بودید که به ساختهٔ دست خودتان توکل کردید!"
        },
        {
          "verse": 19,
          "usfm": "HAB.2.19",
          "line_type": "p",
          "text": "وای بر آنانی که از بتهای چوبین و بی‌جان خود می‌خواهند که به پا خیزند و ایشان را نجات دهند! و از سنگهای بی‌زبان انتظار دارند که سخن بگویند و ایشان را راهنمایی کنند! بیرون بتها با طلا و نقره پوشانیده شده است، ولی در درونشان نَفَسی نیست."
        },
        {
          "verse": 20,
          "usfm": "HAB.2.20",
          "line_type": "p",
          "text": "خداوند در معبد مقدّس خویش است؛ پس تمام جهان در حضور او خاموش باشد."
        }
      ],
      "verse_count": 20,
      "headings": [
        {
          "before_verse": 2,
          "text": "جواب خداوند"
        }
      ],
