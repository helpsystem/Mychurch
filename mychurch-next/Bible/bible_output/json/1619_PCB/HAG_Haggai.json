    {
      "schema_version": 6,
      "book_id": "HAG",
      "chapter": 1,
      "chapter_usfm": "HAG.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAG.1.1",
          "line_type": "p",
          "text": "در سال دوم سلطنت داریوش، در روز اول ماه ششم، خداوند پیامی توسط حَجَّی نبی برای زروبابِل (پسر شئلتیئیل) حاکم یهودا، و برای یهوشع (پسر یهوصادق) کاهن اعظم، فرستاد."
        },
        {
          "verse": 2,
          "usfm": "HAG.1.2",
          "line_type": "p",
          "text": "خداوند لشکرهای آسمان به حَجَّی نبی فرمود: «این قوم می‌گویند که اکنون وقت بازسازی خانهٔ خدا نیست.»"
        },
        {
          "verse": 3,
          "usfm": "HAG.1.3",
          "line_type": "p",
          "text": "سپس، خداوند این پیام را توسط حَجَّی نبی برای قوم فرستاد:"
        },
        {
          "verse": 4,
          "usfm": "HAG.1.4",
          "line_type": "p",
          "text": "«آیا این درست است که شما در خانه‌های نوساخته زندگی کنید ولی خانهٔ من خراب بماند؟"
        },
        {
          "verse": 5,
          "usfm": "HAG.1.5",
          "line_type": "p",
          "text": "پس حال خداوند لشکرهای آسمان چنین می‌گوید: به نتیجهٔ کارهایتان نگاه کنید:"
        },
        {
          "verse": 6,
          "usfm": "HAG.1.6",
          "line_type": "p",
          "text": "بذر زیاد می‌کارید، ولی محصول کم برداشت می‌کنید؛ می‌خورید ولی سیر نمی‌شوید؛ می‌نوشید ولی تشنگی‌تان رفع نمی‌گردد؛ لباس می‌پوشید اما گرم نمی‌شوید؛ مزد می‌گیرید ولی گویی آن را در کیسه‌های سوراخ می‌گذارید."
        },
        {
          "verse": 7,
          "usfm": "HAG.1.7",
          "line_type": "p",
          "text": "«خداوند لشکرهای آسمان چنین می‌گوید: خوب فکر کنید و ببینید چه کرده‌اید و نتیجه‌اش چه بوده است!"
        },
        {
          "verse": 8,
          "usfm": "HAG.1.8",
          "line_type": "p",
          "text": "حال به کوه رفته، چوب بیاورید و خانهٔ مرا دوباره بسازید تا من از آن راضی شوم و در آنجا مردم احترام مرا بجا آورند."
        },
        {
          "verse": 9,
          "usfm": "HAG.1.9",
          "line_type": "p",
          "text": "«انتظار محصول فراوانی داشتید، اما خیلی کم به دست آوردید؛ و وقتی همان مقدار کم را هم به منزل آوردید، آن را از بین بردم. می‌دانید چرا؟ خداوند لشکرهای آسمان می‌فرماید: چون خانهٔ من خراب مانده و شما فقط به فکر خانه‌های خود هستید."
        },
        {
          "verse": 10,
          "usfm": "HAG.1.10",
          "line_type": "p",
          "text": "به همین علّت است که آسمان نمی‌بارد و زمین محصول خود را نمی‌دهد."
        },
        {
          "verse": 11,
          "usfm": "HAG.1.11",
          "line_type": "p",
          "text": "من در سرزمین شما خشکسالی پدید آورده‌ام و این خشکسالی تمام کوهها، مزرعه‌ها، تاکستانها، باغهای زیتون و سایر محصولات و حتی انسان و حیوان و تمام حاصل دسترنج شما را فرا خواهد گرفت.»"
        },
        {
          "verse": 12,
          "usfm": "HAG.1.12",
          "line_type": "p",
          "text": "آنگاه زروبابِل و یهوشع و تمام کسانی که از اسارت برگشته بودند از خداوند ترسیدند و پیام حَجَّی نبی را که خداوند، خدایشان به او داده بود اطاعت کردند."
        },
        {
          "verse": 13,
          "usfm": "HAG.1.13",
          "line_type": "p",
          "text": "سپس خداوند بار دیگر توسط نبی خود حَجَّی به قوم فرمود: «من با شما هستم.»"
        },
        {
          "verse": 14,
          "usfm": "HAG.1.14",
          "line_type": "p",
          "text": "خداوند روحِ زَروبابِل فرزند شِئَلتیئیل فرماندار یهودا، و روحِ یِهوشَع فرزند یِهوصاداق کاهن اعظم، و روح تمامی باقیماندگان قوم را برانگیخت تا خانهٔ یهوه خدای خود، خدای لشکرهای آسمان، را بسازند."
        },
        {
          "verse": 15,
          "usfm": "HAG.1.15",
          "line_type": "p",
          "text": "پس، در سال دوم سلطنت داریوش در روز بیست و چهارم ماه ششم خانۀ خداوند ساخته شد."
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 12,
          "text": "اطاعت از سخنان خداوند"
        }
      ],
