    {
      "schema_version": 6,
      "book_id": "HAG",
      "chapter": 2,
      "chapter_usfm": "HAG.2",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAG.2.1",
          "line_type": "p",
          "text": "در روز بیست و یکم ماه هفتم همان سال، خداوند به حَجَّی گفت:"
        },
        {
          "verse": 2,
          "usfm": "HAG.2.2",
          "line_type": "p",
          "text": "«اکنون با زَروبابِل فرزند شِئَلتیئیل، فرماندار یهودا، یِهوشَع فرزند یِهوصاداق، کاهن اعظم، و نیز با تمامی باقیماندگان قوم سخن بگو و از ایشان بپرس:"
        },
        {
          "verse": 3,
          "usfm": "HAG.2.3",
          "line_type": "p",
          "text": "”آیا کسی در بین شما هست که شکوه و عظمت خانهٔ خدا را آن طوری که در سابق بود به خاطر آورد؟ آیا این خانه‌ای که می‌سازید در مقایسه با خانهٔ قبلی به نظر شما ناچیز نمی‌آید؟"
        },
        {
          "verse": 4,
          "usfm": "HAG.2.4",
          "line_type": "p",
          "text": "اما اکنون خداوند می‌فرماید: هر چند به ظاهر چنین است اما مأیوس نشوید. ای زروبابِل و یهوشع و همهٔ قوم، قوی دل باشید و کار کنید، چون من با شما هستم. این را خداوند لشکرهای آسمان می‌گوید."
        },
        {
          "verse": 5,
          "usfm": "HAG.2.5",
          "line_type": "p",
          "text": "وقتی از مصر بیرون می‌آمدید به شما وعده دادم که روح من در میان شما می‌ماند؛ پس ترسان نباشید!“"
        },
        {
          "verse": 6,
          "usfm": "HAG.2.6",
          "line_type": "p",
          "text": "«زیرا خداوند لشکرهای آسمان می‌فرماید: بار دیگر آسمانها و زمین، دریاها و خشکی را به لرزه درمی‌آورم."
        },
        {
          "verse": 7,
          "usfm": "HAG.2.7",
          "line_type": "p",
          "text": "تمام قومها را سرنگون می‌کنم، و ثروت آنها به این خانه سرازیر می‌شود. و خداوند لشکرهای آسمان می‌گوید: من این مکان را با جلال خود پر می‌سازم."
        },
        {
          "verse": 8,
          "usfm": "HAG.2.8",
          "line_type": "p",
          "text": "خداوند لشکرهای آسمان می‌فرماید: تمام طلا و نقرهٔ دنیا از آن من است."
        },
        {
          "verse": 9,
          "usfm": "HAG.2.9",
          "line_type": "p",
          "text": "خداوند لشکرهای آسمان می‌گوید: شکوه و عظمت آیندهٔ این خانه از شکوه و عظمت خانهٔ قبلی بیشتر خواهد بود و در این مکان به قوم خود صلح و سلامتی خواهم بخشید.» این است آنچه خداوند لشکرهای آسمان می‌فرماید."
        },
        {
          "verse": 10,
          "usfm": "HAG.2.10",
          "line_type": "p",
          "text": "در روز بیست و چهارم ماه نهم از دومین سال سلطنت داریوش، این پیام از جانب خداوند به حَجَّی نبی نازل شد:"
        },
        {
          "verse": 11,
          "usfm": "HAG.2.11",
          "line_type": "p",
          "text": "«خداوند لشکرهای آسمان می‌فرماید: از کاهنان بخواه تا جواب شرعی این سؤال را بدهند:"
        },
        {
          "verse": 12,
          "usfm": "HAG.2.12",
          "line_type": "p",
          "text": "”اگر کسی قسمتی از گوشت مقدّس قربانی را در دامن ردایش گذاشته آن را حمل کند و برحسب اتفاق ردایش با نان، آش، شراب، روغن و یا هر نوع خوراک دیگری تماس پیدا کند، آیا آن خوراک مقدّس می‌شود؟“» کاهنان جواب دادند: «نه، مقدّس نمی‌شود؟»"
        },
        {
          "verse": 13,
          "usfm": "HAG.2.13",
          "line_type": "p",
          "text": "سپس حَجَّی پرسید: «و اما اگر شخصی به جسد مرده‌ای دست بزند و بدین ترتیب نجس شود و بعد به یکی از این خوراکها دست بزند، آیا آن خوراک نجس می‌شود؟»کاهنان جواب دادند: «بلی، نجس می‌شود.»"
        },
        {
          "verse": 14,
          "usfm": "HAG.2.14",
          "line_type": "p",
          "text": "پس حَجَّی گفت: «خداوند می‌فرماید شما نیز در نظر من همین‌طور نجس هستید و هر کاری که می‌کنید و هر قربانی که به خانۀ من می‌آورید، نجس است."
        },
        {
          "verse": 15,
          "usfm": "HAG.2.15",
          "line_type": "p",
          "text": "خوب فکر کنید و ببینید قبل از اینکه دست به کار ساختن خانهٔ خداوند بزنید وضع شما چگونه بود."
        },
        {
          "verse": 16,
          "usfm": "HAG.2.16",
          "line_type": "p",
          "text": "در آن روزها وقتی انتظار داشتید دو خروار محصول برداشت کنید، فقط نصف آن به دستتان می‌رسید، و هنگامی که به امید پنجاه لیتر شراب به سراغ خمره‌هایتان می‌رفتید، بیشتر از بیست لیتر نمی‌یافتید."
        },
        {
          "verse": 17,
          "usfm": "HAG.2.17",
          "line_type": "p",
          "text": "من محصولات شما را با باد سوزان، آفت و تگرگ از بین بردم، اما با وجود همهٔ اینها به سوی من بازگشت نکردید."
        },
        {
          "verse": 18,
          "usfm": "HAG.2.18",
          "line_type": "p",
          "text": "ولی از امروز که روز بیست و چهارم ماه نهم و روزی است که بنیاد خانهٔ خدا گذاشته شده است، ببینید من برای شما چه خواهم کرد."
        },
        {
          "verse": 19,
          "usfm": "HAG.2.19",
          "line_type": "p",
          "text": "اگرچه غله‌ای در انبارها باقی نمانده، و هنوز درختان انگور، انجیر، انار و زیتون میوه نداده‌اند، ولی من به شما برکت خواهم داد.»"
        },
        {
          "verse": 20,
          "usfm": "HAG.2.20",
          "line_type": "p",
          "text": "در همان روز پیام دیگری از جانب خداوند به حَجَّی رسید:"
        },
        {
          "verse": 21,
          "usfm": "HAG.2.21",
          "line_type": "p",
          "text": "«به زروبابِل، حاکم یهودا بگو که به‌زودی آسمانها و زمین را به لرزه درمی‌آورم،"
        },
        {
          "verse": 22,
          "usfm": "HAG.2.22",
          "line_type": "p",
          "text": "تختهای فرمانروایان را واژگون می‌سازم و قدرت آنان را از بین می‌برم. ارابه‌ها و سواران را سرنگون می‌کنم، و اسبها کشته می‌شوند و سوارانشان یکدیگر را با شمشیر از پای در می‌آورند."
        },
        {
          "verse": 23,
          "usfm": "HAG.2.23",
          "line_type": "p",
          "text": "«خداوند لشکرهای آسمان می‌فرماید: وقتی که این امور واقع گردد، ای زروبابِل، خدمتگزار من، تو برای من مانند نگین انگشتر خواهی بود، زیرا تو را برگزیده‌ام.» این است آنچه خداوند لشکرهای آسمان می‌فرماید."
        }
      ],
      "verse_count": 23,
      "headings": [
        {
          "before_verse": 10,
          "text": "برکت برای قوم ناپاک"
        },
        {
          "before_verse": 20,
          "text": "وعدهٔ خداوند به زروبابِل"
        }
      ],
      "footnotes": [
        {
          "verse": 7,
          "usfm": "HAG.2.7",
          "note_ref": "2‏:7",
          "note_type": "footnote",
          "references": [],
          "text": "«ثروت آنها به این خانه سرازیر می‌شود» یا «آرزوی آنها به این خانه خواهد آمد». جملهٔ دوم، به نظر برخی مفسرین اشاره است به ظهور مسیح موعود."
        }
      ],
