  "chapters": [
    {
      "schema_version": 6,
      "book_id": "OBA",
      "chapter": 1,
      "chapter_usfm": "OBA.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "OBA.1.1",
          "line_type": "p",
          "text": "خداوند، آیندهٔ سرزمین ادوم را در رؤیایی به عوبدیا نشان داد.از جانب خداوند خبر رسیده که قاصدی با این پیام نزد قومها فرستاده شده است: «آماده شوید تا به جنگ ادوم برویم.»"
        },
        {
          "verse": 2,
          "usfm": "OBA.1.2",
          "line_type": "p",
          "text": "خداوند می‌فرماید: «ای ادوم، تو را در میان قومها خوار و ضعیف می‌سازم."
        },
        {
          "verse": 3,
          "usfm": "OBA.1.3",
          "line_type": "p",
          "text": "از اینکه بر صخره‌های بلند ساکن هستی به خود می‌بالی و با غرور می‌گویی: ”کیست که دستش در این بلندیها به من برسد!“ خود را گول نزن!"
        },
        {
          "verse": 4,
          "usfm": "OBA.1.4",
          "line_type": "p",
          "text": "اگر همچون عقاب به اوج آسمانها بروی و آشیانهٔ خود را بین ستارگان بر پا داری، تو را از آنجا به زمین می‌آورم.» این است آنچه خداوند می‌گوید."
        },
        {
          "verse": 5,
          "usfm": "OBA.1.5",
          "line_type": "p",
          "text": "«اگر دزدها شبانگاه آمده تو را غارت می‌کردند به مراتب برای تو بهتر می‌بود، زیرا همه چیز را نمی‌بردند! یا اگر انگورچینان به سراغ تو می‌آمدند پس از چیدن انگور خوشه‌ای چند باقی می‌گذاشتند!"
        },
        {
          "verse": 6,
          "usfm": "OBA.1.6",
          "line_type": "p",
          "text": "اما اکنون ای ادوم، تو غارت خواهی شد و تمام ثروتت به یغما خواهد رفت."
        },
        {
          "verse": 7,
          "usfm": "OBA.1.7",
          "line_type": "p",
          "text": "«تمام هم‌پیمانانت دشمن تو می‌شوند و دست به دست هم داده، تو را از سرزمینت بیرون می‌رانند. دوستان مورد اعتمادت، برای تو دام می‌گذارند و تو از آن آگاه نخواهی شد.»"
        },
        {
          "verse": 8,
          "usfm": "OBA.1.8",
          "line_type": "p",
          "text": "خداوند می‌فرماید: «در آن روز در سراسر ادوم حتی یک شخص دانا باقی نخواهد ماند! زیرا من همهٔ دانایان ادوم را نابود خواهم کرد."
        },
        {
          "verse": 9,
          "usfm": "OBA.1.9",
          "line_type": "p",
          "text": "دلیرترین سربازان تیمان، هراسان خواهند گردید، و همه در کوهستان ادوم کشته خواهند شد."
        },
        {
          "verse": 10,
          "usfm": "OBA.1.10",
          "line_type": "p",
          "text": "«به سبب ظلمی که به برادر خود اسرائیل کردی رسوا و برای همیشه ریشه‌کن خواهی شد؛"
        },
        {
          "verse": 11,
          "usfm": "OBA.1.11",
          "line_type": "p",
          "text": "زیرا اسرائیل را به هنگام سختی و احتیاجش ترک کردی. وقتی که مهاجمان، ثروت او را غارت می‌کردند و بر اورشلیم قرعه انداخته، آن را میان خود تقسیم می‌نمودند، تو کنار ایستاده، نخواستی هیچ کمکی به او بکنی و مانند یکی از دشمنانش عمل نمودی."
        },
        {
          "verse": 12,
          "usfm": "OBA.1.12",
          "line_type": "p",
          "text": "«تو نباید این کار را می‌کردی. وقتی که برادرانت را به سرزمینهای بیگانه می‌بردند، نمی‌بایست می‌نشستی و آنها را تماشا می‌کردی. در روز مصیبت مردم یهودا نمی‌بایست شادی می‌کردی و زمانی که در سختی بودند نمی‌بایست به آنها می‌خندیدی."
        },
        {
          "verse": 13,
          "usfm": "OBA.1.13",
          "line_type": "p",
          "text": "روزی که اسرائیل گرفتار این مصیبت و بلا شده بود، تو نیز به او بدی رساندی و رفته، غارتش کردی."
        },
        {
          "verse": 14,
          "usfm": "OBA.1.14",
          "line_type": "p",
          "text": "بر سر چهارراه‌ها ایستادی و کسانی را که سعی می‌کردند فرار کنند کشتی. در آن زمان وحشت و پریشانی، بازماندگان اسرائیل را دستگیر نموده، تحویل دشمن دادی."
        },
        {
          "verse": 15,
          "usfm": "OBA.1.15",
          "line_type": "p",
          "text": "«من، خداوند به‌زودی از تمام قومها انتقام خواهم کشید. ای ادوم، همان‌طور که با اسرائیل رفتار کردی، با تو نیز به همان‌گونه رفتار خواهد شد. هر چه کردی بر سر خودت خواهد آمد."
        },
        {
          "verse": 16,
          "usfm": "OBA.1.16",
          "line_type": "p",
          "text": "بر بالای کوه مقدّس من، جام مکافاتم را نوشیدی، قومهای دیگر نیز آن را خواهند نوشید. آری، آنها خواهند نوشید و از بین خواهند رفت و اثری از آنها باقی نخواهد ماند."
        },
        {
          "verse": 17,
          "usfm": "OBA.1.17",
          "line_type": "p",
          "text": "«ولی کوه مقدّس من در اورشلیم، پناهگاه و محل نجات خواهد شد. اسرائیل سرزمین خود را دوباره تصرف خواهد نمود"
        },
        {
          "verse": 18,
          "usfm": "OBA.1.18",
          "line_type": "p",
          "text": "و مانند آتش، ادوم را خواهد سوزاند به طوری که از ادوم کسی باقی نخواهد ماند.» این را خداوند می‌فرماید."
        },
        {
          "verse": 19,
          "usfm": "OBA.1.19",
          "line_type": "p",
          "text": "اهالی جنوب یهودا، کوهستان ادوم را اشغال خواهند کرد و اهالی جلگه‌های یهودا، دشتهای فلسطین را تصرف نموده، دوباره مراتع افرایم و سامره را به چنگ خواهند آورد و قبیلهٔ بنیامین، جلعاد را خواهد گرفت."
        },
        {
          "verse": 20,
          "usfm": "OBA.1.20",
          "line_type": "p",
          "text": "تبعیدشدگان اسرائیلی مراجعت نموده، فینیقیه را تا صرفه در شمال، اشغال خواهند کرد و آنانی که از اورشلیم به آسیای صغیر به اسارت رفته بودند، به وطن خود بازگشته، شهرهای جنوب یهودا را خواهند گرفت."
        },
        {
          "verse": 21,
          "usfm": "OBA.1.21",
          "line_type": "p",
          "text": "نجات‌یافتگان از کوه صهیون در اورشلیم بالا خواهند رفت تا بر کوههای ادوم حکومت کنند و خودِ خداوند، پادشاه ایشان خواهد بود!"
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 10,
          "text": "دلیل مجازات ادوم"
        },
        {
          "before_verse": 15,
          "text": "روز خداوند"
        },
        {
          "before_verse": 17,
          "text": "پیروزی اسرائیل"
        }
      ],
      "footnotes": [
        {
          "verse": 6,
          "usfm": "OBA.1.6",
          "note_ref": "1‏:6",
          "note_type": "footnote",
          "references": [
            "OBA.1.8",
