    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 3,
      "chapter_usfm": "PHP.3",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.3.1",
          "line_type": "p",
          "text": "عزیزان من، در هر وضعی که هستید، در خداوند شاد باشید. من هرگز از تکرار این مطالب خسته نخواهم شد؛ و در ضمن به نفع شماست که آنها را بارها بشنوید."
        },
        {
          "verse": 2,
          "usfm": "PHP.3.2",
          "line_type": "p",
          "text": "مواظب آن سگان باشید، آن مردمان خبیث، آنان که مُدافعانِ قطع عضو بدن هستند!"
        },
        {
          "verse": 3,
          "usfm": "PHP.3.3",
          "line_type": "p",
          "text": "زیرا ختنه‌شدگان ما هستیم، ما که خدا را به‌واسطۀ روح قدوسش عبادت و خدمت می‌کنیم، و افتخارمان به مسیحْ عیسی است، و به کاری که او برای ما کرده است. هیچ اتکایی نیز به دستاوردهای انسانی نداریم،"
        },
        {
          "verse": 4,
          "usfm": "PHP.3.4",
          "line_type": "p",
          "text": "گرچه خودم دلایل خوبی برای چنین اتکایی دارم.اگر کسی تصور می‌کند که دلیل درستی برای اتکا به دستاوردهای شخصی خود دارد، من دلایل بیشتری دارم!"
        },
        {
          "verse": 5,
          "usfm": "PHP.3.5",
          "line_type": "p",
          "text": "زیرا من در یک خانوادهٔ اسرائیلی، از طایفهٔ بنیامین، به دنیا آمده‌ام؛ و هشت روزه بودم که ختنه شدم. بنابراین، یک یهودی کامل هستم. از این گذشته، عضو فرقهٔ فریسیان نیز بودم، که در زمینهٔ اجرای احکام دین یهود، از همه سختگیرترند."
        },
        {
          "verse": 6,
          "usfm": "PHP.3.6",
          "line_type": "p",
          "text": "تعصب من در دین یهود به قدری بود که مسیحیان را آزار و شکنجه می‌دادم، و همچون یک مرد دیندار شریعت را بدون کم و کاست اجرا می‌کردم."
        },
        {
          "verse": 7,
          "usfm": "PHP.3.7",
          "line_type": "p",
          "text": "اما اکنون همهٔ این امتیازات را که روزگاری برایم بسیار با ارزش بود، دور ریخته‌ام، تا بتوانم ایمان و امیدم را به مسیح ببندم."
        },
        {
          "verse": 8,
          "usfm": "PHP.3.8",
          "line_type": "p",
          "text": "بله، همه چیز در مقابل نعمت شناخت خداوندم مسیح عیسی، بی‌ارزش است. بنابراین، همه را کنار گذاشته‌ام، چون برای من پشیزی ارزش ندارند، با این هدف که مسیح را داشته باشم،"
        },
        {
          "verse": 9,
          "usfm": "PHP.3.9",
          "line_type": "p",
          "text": "و با او یکی شوم، و دیگر برای نجات یافتن، بر کارهای خوب خودم و یا اطاعت از قوانین مذهبی تکیه نکنم، بلکه اعتمادم بر مسیح باشد؛ زیرا فقط از راه ایمان به مسیح است که خدا ما را بی‌گناه به حساب می‌آورد."
        },
        {
          "verse": 10,
          "usfm": "PHP.3.10",
          "line_type": "p",
          "text": "می‌خواهم مسیح را بشناسم و قدرت رستاخیز او را تجربه کنم، و در رنجهایش شریک شوم، و در مرگش همانند او گردم،"
        },
        {
          "verse": 11,
          "usfm": "PHP.3.11",
          "line_type": "p",
          "text": "تا به هر قیمتی که شده، قیامت از مردگان را تجربه کنم."
        },
        {
          "verse": 12,
          "usfm": "PHP.3.12",
          "line_type": "p",
          "text": "منظورم این نیست که اینها را اکنون به دست آورده‌ام، یا اینکه به کمال رسیده‌ام. بلکه نهایت تلاش خود را می‌کنم تا آن را به دست آوَرَم، که مسیحْ عیسی نیز برای آن مرا به دست آورد."
        },
        {
          "verse": 13,
          "usfm": "PHP.3.13",
          "line_type": "p",
          "text": "بله برادران عزیز، من هنوز آن که باید باشم نیستم، اما تمام نیروی خود را صرف یک کار می‌کنم، و آن اینکه گذشته را فراموش کنم و با انتظار و امید به آنچه در پیش است چشم بدوزم،"
        },
        {
          "verse": 14,
          "usfm": "PHP.3.14",
          "line_type": "p",
          "text": "و بکوشم تا به خط پایان مسابقه برسم و جایزه را به چنگ آورم، که برای آن، خدا ما را به سوی آسمان فرا می‌خواند؛ و همهٔ اینها در اثر فداکاری‌ای است که مسیح عیسی برای ما انجام داده است."
        },
        {
          "verse": 15,
          "usfm": "PHP.3.15",
          "line_type": "p",
          "text": "امیدوارم همگی شما که مسیحیان بالغی هستید، در این مورد با من هم‌عقیده باشید. اگر در مورد مسئلهٔ دیگری اختلاف نظر داشته باشید، مطمئناً خدا آن را هم برای شما روشن خواهد ساخت،"
        },
        {
          "verse": 16,
          "usfm": "PHP.3.16",
          "line_type": "p",
          "text": "به شرط آنکه همیشه از حقیقتی که در وجود شماست پیروی کنید."
        },
        {
          "verse": 17,
          "usfm": "PHP.3.17",
          "line_type": "p",
          "text": "برادران عزیز، مرا سرمشق خود قرار دهید، و به کسانی توجه نمایید که مطابق نمونهٔ ما رفتار می‌کنند."
        },
        {
          "verse": 18,
          "usfm": "PHP.3.18",
          "line_type": "p",
          "text": "زیرا قبلاً بارها به شما گفته‌ام و اکنون نیز گریه‌کنان می‌گویم که خیلی‌ها که به ظاهر می‌گویند مسیحی‌اند، در واقع دشمنان صلیب مسیح‌اند."
        },
        {
          "verse": 19,
          "usfm": "PHP.3.19",
          "line_type": "p",
          "text": "این گونه افراد، عاقبتشان هلاکت ابدی است، چون خدای ایشان شکمشان است و به چیزی فخر می‌کنند که باید از آن خجالت بکشند؛ تمام افکارشان متوجهٔ امور دنیای فانی است."
        },
        {
          "verse": 20,
          "usfm": "PHP.3.20",
          "line_type": "p",
          "text": "اما سر منزل اصلی ما آسمان است، که نجا‌ت‌دهندۀ ما، عیسی مسیح خداوند نیز در آنجاست؛ و ما چشم به راه او هستیم تا از آنجا بازگردد."
        },
        {
          "verse": 21,
          "usfm": "PHP.3.21",
          "line_type": "p",
          "text": "او به هنگام بازگشت خود، این بدنهای فانی ما را دگرگون خواهد ساخت و به شکل بدن پرجلال خود در خواهد آورد. او با همان قدرتی که همهٔ چیزها را تحت سلطهٔ خود در خواهد آورد، ما را نیز دگرگون خواهد ساخت."
        }
      ],
      "verse_count": 21,
      "headings": [
        {
          "before_verse": 12,
          "text": "پیش به سوی هدف"
        }
      ],
      "footnotes": [
        {
