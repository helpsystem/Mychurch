    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 4,
      "chapter_usfm": "PHP.4",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.4.1",
          "line_type": "p",
          "text": "ای برادران عزیز، من شما را بسیار دوست می‌دارم و مشتاقانه در انتظار دیدار شما هستم، چون شما شادی من و پاداش زحماتم هستید. ای عزیزان من، به خداوند وفادار بمانید."
        },
        {
          "verse": 2,
          "usfm": "PHP.4.2",
          "line_type": "p",
          "text": "در ضمن، از آن دو بانوی گرامی، اِفودیه و سینتیخی التماس می‌کنم با هم آشتی کنند، زیرا متعلق به خداوند هستند."
        },
        {
          "verse": 3,
          "usfm": "PHP.4.3",
          "line_type": "p",
          "text": "از تو، دوست و همکار صمیمی خود نیز استدعا می‌کنم که به این دو بانو در حل اختلافشان کمک کنی، زیرا ایشان زمانی دوش به دوش من خدمت کرده‌اند تا پیغام انجیل را اعلام نماییم. ایشان با کلمنت و سایر همقطاران من نیز که نامهایشان در دفتر حیات نوشته شده است، همکاری کرده‌اند."
        },
        {
          "verse": 4,
          "usfm": "PHP.4.4",
          "line_type": "p",
          "text": "در خداوند دائماً شاد باشید، و باز می‌گویم شاد باشید!"
        },
        {
          "verse": 5,
          "usfm": "PHP.4.5",
          "line_type": "p",
          "text": "در هر کاری از خود گذشتگی نشان بدهید و ملاحظهٔ دیگران را بکنید. به خاطر داشته باشید که خداوند به‌زودی باز می‌گردد."
        },
        {
          "verse": 6,
          "usfm": "PHP.4.6",
          "line_type": "p",
          "text": "برای هیچ چیز نگران نباشید. در عوض، در هر شرایطی، با دعا و التماس، همراه با شکرگزاری، درخواستهای خود را به پیشگاه خدا ببرید."
        },
        {
          "verse": 7,
          "usfm": "PHP.4.7",
          "line_type": "p",
          "text": "اگر چنین کنید، از آرامش خدا بهره‌مند خواهید شد، آرامشی که فکر انسان قادر به درک آن نیست. این آرامش الهی به فکر و دل شما که به مسیح عیسی ایمان آورده‌اید، راحتی و آسایش خواهد بخشید."
        },
        {
          "verse": 8,
          "usfm": "PHP.4.8",
          "line_type": "p",
          "text": "و حال، دوستان عزیزم، یک نکتۀ پایانی: فکرتان را متمرکز سازید بر آنچه راست و قابل احترام است، بر آنچه درست است و پاک، بر آنچه دوست داشتنی است و قابل ستایش. به اموری بیندیشید که عالی و قابل تحسین است."
        },
        {
          "verse": 9,
          "usfm": "PHP.4.9",
          "line_type": "p",
          "text": "هر چه از من آموختید، یا از من دریافت کردید، یا شنیدید، یا در من مشاهده کردید، آنها را به‌عمل آورید. آنگاه خدای آرامش با شما خواهد بود."
        },
        {
          "verse": 10,
          "usfm": "PHP.4.10",
          "line_type": "p",
          "text": "چقدر از خدا سپاسگزارم و او را ستایش می‌کنم که بار دیگر به کمک من شتافتید. می‌دانم که همیشه در این فکر بوده‌اید، اما فرصت انجامش را نمی‌یافتید."
        },
        {
          "verse": 11,
          "usfm": "PHP.4.11",
          "line_type": "p",
          "text": "البته منظورم این نیست که در احتیاج بودم، زیرا آموخته‌ام که به آنچه دارم، راضی و قانع باشم."
        },
        {
          "verse": 12,
          "usfm": "PHP.4.12",
          "line_type": "p",
          "text": "می‌دانم که در تنگدستی و دولتمندی، چگونه زندگی کنم. رمز قناعت را در هر شرایطی آموخته‌ام، چه سیر باشم چه گرسنه، چه زیاد داشته باشم و چه اندک."
        },
        {
          "verse": 13,
          "usfm": "PHP.4.13",
          "line_type": "p",
          "text": "هر چه خدا از من بخواهد، با کمک مسیح می‌توانم انجام دهم، زیرا مسیح قدرت انجام آن را به من می‌بخشد."
        },
        {
          "verse": 14,
          "usfm": "PHP.4.14",
          "line_type": "p",
          "text": "با تمام اینها، لطف کردید که در مشکلاتم به کمکم شتافتید."
        },
        {
          "verse": 15,
          "usfm": "PHP.4.15",
          "line_type": "p",
          "text": "شما فیلیپیان به خوبی آگاهید که وقتی برای نخستین بار پیام انجیل را به شما اعلام نمودم، و سپس از مقدونیه روانه شدم، فقط شما به من کمک‌های مالی کردید. کلیسای دیگری در این امر پیشقدم نشد."
        },
        {
          "verse": 16,
          "usfm": "PHP.4.16",
          "line_type": "p",
          "text": "حتی زمانی که در «تسالونیکی» بودم، دو بار مبلغی برای رفع احتیاجاتم فرستادید."
        },
        {
          "verse": 17,
          "usfm": "PHP.4.17",
          "line_type": "p",
          "text": "البته از هدایای شما سپاسگزارم، ولی آنچه بیشتر مرا شاد می‌سازد، این است که به خاطر این نیکوکاری‌تان، پاداش خوبی خواهید یافت."
        },
        {
          "verse": 18,
          "usfm": "PHP.4.18",
          "line_type": "p",
          "text": "در حال حاضر، همه چیز دارم که حتی بیش از نیازم است؛ و غرق هدایایی هستم که به دست «اپافرودیتوس» فرستادید، هدایایی که همچون قربانی خوشبو، خدا را خشنود می‌سازد."
        },
        {
          "verse": 19,
          "usfm": "PHP.4.19",
          "line_type": "p",
          "text": "خدا نیز به سبب جانبازی عیسی مسیح، تمام احتیاجات شما را با ثروت شکوهمند خود، رفع خواهد نمود."
        },
        {
          "verse": 20,
          "usfm": "PHP.4.20",
          "line_type": "p",
          "text": "از حال تا ابد، پدر ما خدا را جلال باد، آمین."
        },
        {
          "verse": 21,
          "usfm": "PHP.4.21",
          "line_type": "p",
          "text": "به تمام ایمانداران در مسیح عیسی سلام برسانید. برادرانی که با من هستند، سلام می‌رسانند."
        },
        {
          "verse": 22,
          "usfm": "PHP.4.22",
          "line_type": "p",
          "text": "همهٔ ایمانداران اینجا، بخصوص ایماندارانی که از دربار قیصر هستند، سلام می‌رسانند."
        },
        {
          "verse": 23,
          "usfm": "PHP.4.23",
          "line_type": "p",
          "text": "فیض خداوند، عیسی مسیح، با روح شما باد."
        }
      ],
      "verse_count": 23,
      "headings": [
        {
          "before_verse": 2,
          "text": "سخنان آخر پولس"
        },
        {
          "before_verse": 10,
          "text": "سپاسگزاری بابت هدایا"
        },
        {
          "before_verse": 21,
          "text": "درودهای پایانی پولس"
        }
      ],
