    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 2,
      "chapter_usfm": "PHP.2",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.2.1",
          "line_type": "p",
          "text": "پس چنانچه به سبب تعلق خود به مسیح، دلگرم هستید، اگر از محبت او تسلی خاطر یافته‌اید، اگر در روح‌القدس، از رفاقت و مشارکت با یکدیگر برخوردارید، و اگر دلسوز و همدرد هستید،"
        },
        {
          "verse": 2,
          "usfm": "PHP.2.2",
          "line_type": "p",
          "text": "در این صورت، با یکدیگر اتفاق‌نظر کامل داشته، نسبت به یکدیگر محبتی متقابل نشان دهید، و در روح و ذهن یکی باشید، تا بدین‌سان، شادی مرا کامل سازید."
        },
        {
          "verse": 3,
          "usfm": "PHP.2.3",
          "line_type": "p",
          "text": "خودخواه نباشید و برای خودنمایی زندگی نکنید. فروتن باشید و دیگران را از خود بهتر بدانید."
        },
        {
          "verse": 4,
          "usfm": "PHP.2.4",
          "line_type": "p",
          "text": "فقط به فکر خودتان نباشید، بلکه به کار و مسائل دیگران هم توجه نمایید."
        },
        {
          "verse": 5,
          "usfm": "PHP.2.5",
          "line_type": "p",
          "text": "شما باید همان طرز فکری را در پیش گیرید که مسیح عیسی داشت."
        },
        {
          "verse": 6,
          "usfm": "PHP.2.6",
          "line_type": "p",
          "text": "او با اینکه ماهیت خدایی داشت، اما نخواست از برابری خود با خدا به نفع خود استفاده کند،"
        },
        {
          "verse": 7,
          "usfm": "PHP.2.7",
          "line_type": "p",
          "text": "بلکه قدرت و جلال خود را کنار گذاشت و شکل یک بنده را بر خود گرفت، و شبیه انسانها شد؛"
        },
        {
          "verse": 8,
          "usfm": "PHP.2.8",
          "line_type": "p",
          "text": "و وقتی به شکل یک انسان یافت شد، خود را خوار ساخت، و مسیر اطاعت را به‌طور کامل پیمود، اطاعتی تا سرحدّ مرگ، حتی مرگی خفّت‌بار بر روی صلیب!"
        },
        {
          "verse": 9,
          "usfm": "PHP.2.9",
          "line_type": "p",
          "text": "به همین جهت، خدا او را بی‌نهایت سرافراز کرد و نامی به او بخشید که از هر نام دیگری والاتر است،"
        },
        {
          "verse": 10,
          "usfm": "PHP.2.10",
          "line_type": "p",
          "text": "تا به نام عیسی هر زانویی، چه در آسمان، چه بر زمین و چه زیر زمین، خم شود،"
        },
        {
          "verse": 11,
          "usfm": "PHP.2.11",
          "line_type": "p",
          "text": "و هر زبانی اقرار کند که عیسی مسیح، خداوند است، برای جلال خدای پدر."
        },
        {
          "verse": 12,
          "usfm": "PHP.2.12",
          "line_type": "p",
          "text": "عزیزان من، وقتی من با شما بودم، همیشه از من اطاعت می‌کردید، پس چقدر بیشتر اکنون که غایبم باید چنین کنید. سخت بکوشید تا با اطاعت از خدا و ترس و احترام نسبت به او، نجات شما ثمر دهد."
        },
        {
          "verse": 13,
          "usfm": "PHP.2.13",
          "line_type": "p",
          "text": "زیرا خدا خودش در وجود شما کار می‌کند تا بتوانید با میل و رغبت او را اطاعت نمایید و اعمالی را بجا آورید که مورد پسند اوست."
        },
        {
          "verse": 14,
          "usfm": "PHP.2.14",
          "line_type": "p",
          "text": "کارهایتان را بدون غرغر و شکایت انجام دهید،"
        },
        {
          "verse": 15,
          "usfm": "PHP.2.15",
          "line_type": "p",
          "text": "تا کسی نتواند از شما عیب و ایرادی بگیرد. باید در این دنیای فاسد که پر از افراد نادرست و ناخلف است، همچون فرزندان خدا، پاک و بی‌لکه باشید. آنگاه در میان ایشان مانند ستارگان در آسمان، خواهید درخشید."
        },
        {
          "verse": 16,
          "usfm": "PHP.2.16",
          "line_type": "p",
          "text": "کلام حیات‌بخش خدا را محکم نگه دارید تا به هنگام بازگشت مسیح، من سرشار از شادی و افتخار شوم، زیرا نتیجۀ زحماتی را که برای شما کشیده‌ام، خواهم دید."
        },
        {
          "verse": 17,
          "usfm": "PHP.2.17",
          "line_type": "p",
          "text": "اما حتی اگر جان من مانند هدیه‌ای ریختنی، بر قربانی و خدمت شما که ناشی از ایمان شماست، ریخته شود، شاد خواهم شد و با همگی شما شادی خواهم کرد."
        },
        {
          "verse": 18,
          "usfm": "PHP.2.18",
          "line_type": "p",
          "text": "شما نیز باید خوشحال باشید و با من شادی کنید که این افتخار را دارم تا در راه شما جان خود را فدا نمایم."
        },
        {
          "verse": 19,
          "usfm": "PHP.2.19",
          "line_type": "p",
          "text": "در خداوند عیسی امید دارم به‌زودی تیموتائوس را نزد شما بفرستم، تا وقتی نزد من باز می‌گردد، مرا از احوال شما آگاه کند و روحم را شاد سازد."
        },
        {
          "verse": 20,
          "usfm": "PHP.2.20",
          "line_type": "p",
          "text": "هیچ‌کس مانند تیموتائوس، چنین علاقهٔ خالصی نسبت به شما ندارد؛"
        },
        {
          "verse": 21,
          "usfm": "PHP.2.21",
          "line_type": "p",
          "text": "گویا هر کس فقط به مسائل خود می‌اندیشد، و به فکر خدمت به عیسی مسیح نیست."
        },
        {
          "verse": 22,
          "usfm": "PHP.2.22",
          "line_type": "p",
          "text": "اما شما تیموتائوس را می‌شناسید؛ او مثل یک فرزند به من کمک کرده تا پیغام انجیل را اعلام نمایم."
        },
        {
          "verse": 23,
          "usfm": "PHP.2.23",
          "line_type": "p",
          "text": "بنابراین، امیدوارم به محض روشن شدن وضعیتم، تیموتائوس را فوری نزد شما بفرستم؛"
        },
        {
          "verse": 24,
          "usfm": "PHP.2.24",
          "line_type": "p",
          "text": "و امیدوارم به لطف خداوند، خودم هم به‌زودی نزد شما بیایم."
        },
        {
          "verse": 25,
          "usfm": "PHP.2.25",
          "line_type": "p",
          "text": "در ضمن، فکر کردم لازم است «اپافرودیتوس» را نیز پیش شما بفرستم. او را نزد من فرستاده بودید تا در وقت احتیاج به من کمک کند. من و او با هم مانند برادران واقعی بوده‌ایم و دوش به دوش هم کار کرده‌ایم و جنگیده‌ایم."
        },
        {
          "verse": 26,
          "usfm": "PHP.2.26",
          "line_type": "p",
          "text": "اکنون او را نزد شما می‌فرستم، چون دلش برای همهٔ شما تنگ شده است. خصوصاً غمگین شد از اینکه شنید شما از بیماری او آگاهی یافته‌اید."
        },
        {
          "verse": 27,
          "usfm": "PHP.2.27",
          "line_type": "p",
          "text": "در واقع، بیماری او بسیار سخت بود و چیزی نمانده بود که از پای درآید. اما خدا، هم به او و هم به من رحم کرد و نگذاشت که این غم نیز بر غمهای دیگر من اضافه شود."
        },
        {
          "verse": 28,
          "usfm": "PHP.2.28",
          "line_type": "p",
          "text": "دلم می‌خواهد هر چه زودتر او را نزد شما بفرستم، چون می‌دانم که از دیدنش واقعاً شاد خواهید شد؛ همین موضوع باعث خوشحالی من خواهد شد و از بار غمم خواهد کاست."
        },
        {
          "verse": 29,
          "usfm": "PHP.2.29",
          "line_type": "p",
          "text": "پس او را همچون برادری در خداوند به گرمی بپذیرید و از زحمات او قدردانی نمایید،"
        },
        {
          "verse": 30,
          "usfm": "PHP.2.30",
          "line_type": "p",
          "text": "زیرا جانش را در راه خدمت به مسیح، به خطر انداخت تا به جای شما که از من دور هستید، به من خدمت کند."
        }
      ],
      "verse_count": 30,
      "headings": [
        {
          "before_verse": 5,
          "text": "فروتنی و سرافرازی مسیح"
        },
        {
          "before_verse": 12,
          "text": "درخشش زندگی مسیحی"
        },
        {
          "before_verse": 19,
          "text": "پولس از تیموتائوس تقدیر می‌کند"
        },
        {
          "before_verse": 25,
          "text": "پولس از اپافرودیتوس تقدیر می‌کند"
        }
      ],
