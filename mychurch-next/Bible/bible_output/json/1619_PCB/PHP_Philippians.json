  "chapters": [
    {
      "schema_version": 6,
      "book_id": "PHP",
      "chapter": 1,
      "chapter_usfm": "PHP.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "PHP.1.1",
          "line_type": "p",
          "text": "این نامه از طرف پولس و تیموتائوس، خدمتگزاران مسیحْ عیسی است.این نامه را به جمیع مقدّسان در شهر فیلیپی که متعلق به مسیحْ عیسی هستند، از جمله مشایخ و خدمتگزاران کلیسا می‌نویسم."
        },
        {
          "verse": 2,
          "usfm": "PHP.1.2",
          "line_type": "p",
          "text": "فیض و آرامش از جانب خدا، پدر ما، و خداوندمان عیسی مسیح، بر شما باد."
        },
        {
          "verse": 3,
          "usfm": "PHP.1.3",
          "line_type": "p",
          "text": "هرگاه شما را به یاد می‌آورم، خدای خود را برای وجودتان سپاس می‌گویم."
        },
        {
          "verse": 4,
          "usfm": "PHP.1.4",
          "line_type": "p",
          "text": "هر بار که برای شما دعا می‌کنم، قلبم لبریز از شادی می‌گردد،"
        },
        {
          "verse": 5,
          "usfm": "PHP.1.5",
          "line_type": "p",
          "text": "زیرا شما از همان روزی که پیغام انجیل را شنیدید تا به حال، کمکهای بسیاری در اشاعه و گسترش آن نموده‌اید."
        },
        {
          "verse": 6,
          "usfm": "PHP.1.6",
          "line_type": "p",
          "text": "اطمینان دارم خدا که این عمل نیکو را در شما آغاز نمود، شما را یاری خواهد داد تا در فیض او رشد کنید تا به هنگام بازگشت عیسی مسیح، کار او در شما تکمیل شده باشد."
        },
        {
          "verse": 7,
          "usfm": "PHP.1.7",
          "line_type": "p",
          "text": "این طبیعی است که دربارهٔ شما چنین احساسی داشته باشم، چون همهٔ شما در دل من جای دارید. چه، زمانی که در زندان بودم و چه، زمانی که آزادانه در میان شما به سر می‌بردم، به اتفاق هم از حقیقت دفاع می‌کردیم و خبر نجات مسیح را به گوش مردم می‌رساندیم؛ به همین جهت همواره با هم در برکات خدا شریک بوده‌ایم."
        },
        {
          "verse": 8,
          "usfm": "PHP.1.8",
          "line_type": "p",
          "text": "فقط خدا می‌داند که عیسی مسیح چه محبت و اشتیاق عمیقی نسبت به شما در من گذاشته است."
        },
        {
          "verse": 9,
          "usfm": "PHP.1.9",
          "line_type": "p",
          "text": "از این رو، دعا می‌کنم تا محبتتان از طریق شناخت و درک و بینشی عمیق، روز‌به‌روز فزونی یابد،"
        },
        {
          "verse": 10,
          "usfm": "PHP.1.10",
          "line_type": "p",
          "text": "تا بتوانید عالی‌ترین امور را تشخیص دهید، و برای روز مسیح، پاک و بی‌عیب باشید."
        },
        {
          "verse": 11,
          "usfm": "PHP.1.11",
          "line_type": "p",
          "text": "همچنین آکنده از ثمرات نجات خود باشید یعنی عدالتی که از طریق عیسی مسیح به دست می‌آید و باعث جلال و ستایش خدا می‌گردد."
        },
        {
          "verse": 12,
          "usfm": "PHP.1.12",
          "line_type": "p",
          "text": "برادران و خواهران عزیز، می‌خواهم این را نیز بدانید که آنچه برای من پیش آمده، در واقع به پیشرفت و گسترش پیام انجیل منجر شده است؛"
        },
        {
          "verse": 13,
          "usfm": "PHP.1.13",
          "line_type": "p",
          "text": "زیرا اکنون همه، از جمله نگهبانان کاخ سلطنتی، به خوبی می‌دانند که من به علّت مسیحی بودن، در زندان به سر می‌برم."
        },
        {
          "verse": 14,
          "usfm": "PHP.1.14",
          "line_type": "p",
          "text": "به علاوه، زندانی بودن من باعث شده که بسیاری از مسیحیان اینجا، دیگر ترسی از زندان نداشته باشند؛ و صبر و تحمل من به آنان جرأت بخشیده که با شهامت بیشتری پیام مسیح را اعلام کنند."
        },
        {
          "verse": 15,
          "usfm": "PHP.1.15",
          "line_type": "p",
          "text": "البته، بعضی از روی حسادت و رقابت انجیل مسیح را موعظه می‌کنند، اما بعضی نیز با حسن نیت. اینان موعظه می‌کنند چون مرا دوست دارند و پی برده‌اند که خدا مرا برای دفاع از حقیقت به اینجا آورده است. عده‌ای هم برای این موعظه می‌کنند که حسادت مرا برانگیزند، با این تصور که پیشرفت کار آنان، غمی به غمهای من در زندان می‌افزاید."
        },
        {
          "verse": 18,
          "usfm": "PHP.1.18",
          "line_type": "p",
          "text": "اما هر کس با هر انگیزه و هدفی انجیل را موعظه کند، باعث شادی من می‌شود، چون به هر حال پیغام نجات‌بخش مسیح به گوش همه می‌رسد.بله، شادی من ادامه خواهد یافت،"
        },
        {
          "verse": 19,
          "usfm": "PHP.1.19",
          "line_type": "p",
          "text": "زیرا یقین می‌دانم که با دعاهای شما و تأییدات روح قدّوس عیسی مسیح، تمام این امور به آزادی من منجر خواهد شد."
        },
        {
          "verse": 20,
          "usfm": "PHP.1.20",
          "line_type": "p",
          "text": "آرزوی قلبی و امید من این است که هرگز در انجام وظایف خود، شرمنده و سرافکنده نشوم، بلکه همواره آماده باشم تا در تمام سختیها با کمال دلیری دربارهٔ مسیح سخن بگویم، همان‌طور که در گذشته نیز چنین کرده‌ام؛ تا بدین وسیله، چه زنده باشم و چه بمیرم، همیشه باعث سربلندی مسیح گردم."
        },
        {
          "verse": 21,
          "usfm": "PHP.1.21",
          "line_type": "p",
          "text": "چون برای من، زندگی فرصتی است برای خدمت به مسیح، و مرگ به معنی رفتن به نزد او می‌باشد."
        },
        {
          "verse": 22,
          "usfm": "PHP.1.22",
          "line_type": "p",
          "text": "اما اگر زنده ماندن من، سبب خواهد شد که عدهٔ بیشتری را به سوی مسیح هدایت کنم، در این صورت واقعاً نمی‌دانم کدام بهتر است، مردن یا زنده ماندن."
        },
        {
          "verse": 23,
          "usfm": "PHP.1.23",
          "line_type": "p",
          "text": "گاه می‌خواهم زنده بمانم و گاه آرزو می‌کنم که این زندگی را ترک گویم و به نزد مسیح بشتابم، که این برای من خیلی بهتر است."
        },
        {
          "verse": 24,
          "usfm": "PHP.1.24",
          "line_type": "p",
          "text": "اما در حقیقت اگر زنده بمانم، می‌توانم کمک بیشتری به شما بکنم."
        },
        {
          "verse": 25,
          "usfm": "PHP.1.25",
          "line_type": "p",
          "text": "بله، وجود من هنوز در اینجا لازم است؛ از این رو یقین دارم که باز مدتی در این دنیا خواهم ماند و به رشد و شادی شما در ایمان، کمک خواهم نمود."
        },
        {
          "verse": 26,
          "usfm": "PHP.1.26",
          "line_type": "p",
          "text": "و هنگامی که دوباره نزد شما بیایم، شما دلیل بیشتری برای فخر کردن به مسیح عیسی خواهید داشت به خاطر آنچه که توسط من انجام می‌دهد. اما هر چه برای من پیش آید، چه شما را بار دیگر ببینم، چه نبینم، به یاد داشته باشید که همواره باید همچون مسیحی واقعی زندگی کنید، تا همیشه خبرهای خوب دربارهٔ شما به من برسد و بشنوم که دوش به دوش یکدیگر، در یک روح استوار ایستاده‌اید و هدف همگی‌تان این است که بدون توجه به مخالفتهای دشمن، پیام نجات‌بخش انجیل مسیح را به همه اعلام کنید. همین امر برای ایشان نشانهٔ هلاکت است، اما برای شما نشانهٔ این است که خدا با شماست و به شما زندگی جاوید عطا کرده است."
        },
        {
          "verse": 29,
          "usfm": "PHP.1.29",
          "line_type": "p",
          "text": "زیرا خدا به شما این افتخار را داده است که نه فقط به مسیح ایمان آورید، بلکه در راه او متحمل زحمات و مشقات نیز بشوید."
        },
        {
          "verse": 30,
          "usfm": "PHP.1.30",
          "line_type": "p",
          "text": "در این مجاهده و پیکار، ما با یکدیگر شریک می‌باشیم. شما در گذشته شاهد زحمات من در راه مسیح بوده‌اید، و همان‌طور که می‌دانید هنوز هم درگیر همان زحمات و مبارزات هستم."
        }
      ],
      "verse_count": 26,
      "headings": [
        {
          "before_verse": 3,
          "text": "شکرگزاری و دعای پولس"
        },
        {
          "before_verse": 12,
          "text": "شادی پولس برای بشارت انجیل مسیح"
        },
        {
          "before_verse": 20,
          "text": "زندگی پولس برای مسیح"
        },
        {
          "before_verse": 27,
          "text": "زندگی در مقام شهروندان آسمان"
        }
      ],
      "footnotes": [
        {
