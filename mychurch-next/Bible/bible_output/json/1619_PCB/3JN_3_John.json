  "chapters": [
    {
      "schema_version": 6,
      "book_id": "3JN",
      "chapter": 1,
      "chapter_usfm": "3JN.1",
      "version_id": 1619,
      "version_abbr": "PCB",
      "verses": [
        {
          "verse": 1,
          "usfm": "3JN.1.1",
          "line_type": "p",
          "text": "از شیخ کلیسا،به گایوس عزیز، که او را از صمیم قلب دوست می‌دارم."
        },
        {
          "verse": 2,
          "usfm": "3JN.1.2",
          "line_type": "p",
          "text": "برادر عزیزم، از خدا می‌خواهم که در تمام کارهایت موفق باشی، و بدنت نیز مانند روحت در سلامتی و تندرستی باشد."
        },
        {
          "verse": 3,
          "usfm": "3JN.1.3",
          "line_type": "p",
          "text": "وقتی برادران مسیحی ما به اینجا آمدند، مرا بسیار شاد کردند، زیرا به من خبر دادند که به حقایق الهی وفاداری و مطابق احکام انجیل در راستی رفتار می‌کنی."
        },
        {
          "verse": 4,
          "usfm": "3JN.1.4",
          "line_type": "p",
          "text": "برای من هیچ دلخوشی بزرگتر از این نیست که بشنوم فرزندانم اینچنین از حقیقت پیروی می‌کنند."
        },
        {
          "verse": 5,
          "usfm": "3JN.1.5",
          "line_type": "p",
          "text": "برادر عزیز، تو در خدمت خود به خداوند، وفادار هستی، زیرا از خادمین او که از آنجا عبور می‌کنند، پذیرایی می‌کنی، هرچند که از آشنایان تو نیستند."
        },
        {
          "verse": 6,
          "usfm": "3JN.1.6",
          "line_type": "p",
          "text": "ایشان در کلیسای ما از رفتار پر محبت تو تعریف‌ها کرده‌اند. پس کاری نیکو می‌کنی اگر ایشان را آن گونه که سزاوار خداست، روانۀ سفر کنی."
        },
        {
          "verse": 7,
          "usfm": "3JN.1.7",
          "line_type": "p",
          "text": "زیرا ایشان برای خدمت به خداوند سفر می‌کنند و پیغام انجیل را به کسانی که هنوز به مسیح ایمان نیاورده‌اند اعلام می‌نمایند، بدون آنکه کمکی از آنان دریافت دارند."
        },
        {
          "verse": 8,
          "usfm": "3JN.1.8",
          "line_type": "p",
          "text": "پس بر ما واجب است که به چنین افراد کمک کنیم تا ما نیز در پیشبرد حقیقت، با ایشان شریک گردیم."
        },
        {
          "verse": 9,
          "usfm": "3JN.1.9",
          "line_type": "p",
          "text": "در این باره، قبلاً نامه‌ای مختصر به کلیسا نوشتم، اما دیوترَفیس که مقام رهبری را دوست دارد، ما را تحویل نمی‌گیرد."
        },
        {
          "verse": 10,
          "usfm": "3JN.1.10",
          "line_type": "p",
          "text": "وقتی آمدم، اعمال نادرست او را برایت تعریف خواهم کرد، تا بدانی چه اتهامات و سخنان زشتی به ما نسبت داده است. او، نه تنها خدمتگزاران کلیسا را که در سفر هستند، پذیرایی و خدمت نمی‌کند، بلکه دیگران را نیز وادار می‌کند تا ایشان را به خانهٔ خود نپذیرند، و اگر کسی به سخن او توجه نکند، او را از کلیسا بیرون می‌کند."
        },
        {
          "verse": 11,
          "usfm": "3JN.1.11",
          "line_type": "p",
          "text": "ای عزیز، بدی را سرمشق خود نساز، بلکه از نیکی سرمشق بگیر؛ زیرا کسی که نیکی می‌کند، فرزند خداست، اما کسی که همواره خواهان بدی باشد، خدا را نمی‌شناسد."
        },
        {
          "verse": 12,
          "usfm": "3JN.1.12",
          "line_type": "p",
          "text": "اما همه شهادت خوبی دربارهٔ دیمیتریوس می‌دهند و این شهادت راست است. ما نیز می‌گوییم که او شخص خوبی است و می‌دانی که راست می‌گوییم."
        },
        {
          "verse": 13,
          "usfm": "3JN.1.13",
          "line_type": "p",
          "text": "مطالب بسیاری برای گفتن دارم، اما نمی‌خواهم همه را در این نامه بنویسم،"
        },
        {
          "verse": 14,
          "usfm": "3JN.1.14",
          "line_type": "p",
          "text": "زیرا امیدوارم به‌زودی تو را ببینم تا حضوراً گفتگو کنیم."
        },
        {
          "verse": 15,
          "usfm": "3JN.1.15",
          "line_type": "p",
          "text": "آرامش بر تو باد. دوستان همگی سلام می‌رسانند. سلام مرا به یکایک دوستان برسان."
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 5,
          "text": "پذیرایی از خادمین خدا"
        },
        {
          "before_verse": 13,
          "text": "خاتمه"
        }
      ],
