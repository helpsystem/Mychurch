  "chapters": [
    {
      "schema_version": 6,
      "book_id": "NAM",
      "chapter": 1,
      "chapter_usfm": "NAM.1",
      "version_id": 68,
      "version_abbr": "GNT",
      "verses": [
        {
          "verse": 1,
          "usfm": "NAM.1.1",
          "line_type": "p",
          "text": "This is a message about Nineveh, the account of a vision seen by Nahum, who was from Elkosh."
        },
        {
          "verse": 2,
          "usfm": "NAM.1.2",
          "line_type": "q1",
          "text": "The Lord God tolerates no rivals;he punishes those who oppose him.In his anger he pays them back."
        },
        {
          "verse": 3,
          "usfm": "NAM.1.3",
          "line_type": "q1",
          "text": "The Lord does not easily become angry,but he is powerfuland never lets the guilty go unpunished.Where the Lord walks, storms arise;the clouds are the dust raised by his feet!"
        },
        {
          "verse": 4,
          "usfm": "NAM.1.4",
          "line_type": "q1",
          "text": "He commands the sea, and it dries up!He makes the rivers go dry.The fields of Bashan wither,Mount Carmel turns brown,and the flowers of Lebanon fade."
        },
        {
          "verse": 5,
          "usfm": "NAM.1.5",
          "line_type": "q1",
          "text": "Mountains quake in the presence of the Lord;hills melt before him.The earth shakes when the Lord appears;the world and all its people tremble."
        },
        {
          "verse": 6,
          "usfm": "NAM.1.6",
          "line_type": "q1",
          "text": "When he is angry, who can survive?Who can survive his terrible fury?He pours out his flaming anger;rocks crumble to dust before him."
        },
        {
          "verse": 7,
          "usfm": "NAM.1.7",
          "line_type": "q1",
          "text": "The Lord is good;he protects his people in times of trouble;he takes care of those who turn to him."
        },
        {
          "verse": 8,
          "usfm": "NAM.1.8",
          "line_type": "q1",
          "text": "Like a great rushing flood he completely destroys his enemies;he sends to their death those who oppose him."
        },
        {
          "verse": 9,
          "usfm": "NAM.1.9",
          "line_type": "q1",
          "text": "What are you plotting against the Lord?He will destroy you.No one opposes him more than once."
        },
        {
          "verse": 10,
          "usfm": "NAM.1.10",
          "line_type": "q1",
          "text": "Like tangled thorns and dry strawyou drunkards will be burned up!"
        },
        {
          "verse": 11,
          "usfm": "NAM.1.11",
          "line_type": "p",
          "text": "From you, Nineveh, there came someone full of wicked schemes, who plotted against the Lord."
        },
        {
          "verse": 12,
          "usfm": "NAM.1.12",
          "line_type": "p",
          "text": "This is what the Lord says to his people Israel: “Even though the Assyrians are strong and numerous, they will be destroyed and disappear. My people, I made you suffer, but I will not do it again."
        },
        {
          "verse": 13,
          "usfm": "NAM.1.13",
          "line_type": "p",
          "text": "I will now end Assyria's power over you and break the chains that bind you.”"
        },
        {
          "verse": 14,
          "usfm": "NAM.1.14",
          "line_type": "p",
          "text": "This is what the Lord has decreed about the Assyrians: “They will have no descendants to carry on their name. I will destroy the idols that are in the temples of their gods. I am preparing a grave for the Assyrians—they don't deserve to live!”"
        },
        {
          "verse": 15,
          "usfm": "NAM.1.15",
          "line_type": "p",
          "text": "Look, a messenger is coming over the mountains with good news! He is on his way to announce the victory! People of Judah, celebrate your festivals and give God what you solemnly promised him. The wicked will never invade your land again. They have been totally destroyed!"
        }
      ],
      "verse_count": 15,
      "headings": [
        {
          "before_verse": 2,
          "text": "The"
        },
        {
          "before_verse": 2,
          "text": "Lord"
        },
        {
          "before_verse": 2,
          "text": "'s Anger against Nineveh"
        }
      ],
