    {
      "schema_version": 6,
      "book_id": "NAM",
      "chapter": 2,
      "chapter_usfm": "NAM.2",
      "version_id": 68,
      "version_abbr": "GNT",
      "verses": [
        {
          "verse": 1,
          "usfm": "NAM.2.1",
          "line_type": "q1",
          "text": "Nineveh, you are under attack!The power that will shatter you has come.Prepare the defenses!Guard the road!Prepare for battle!("
        },
        {
          "verse": 2,
          "usfm": "NAM.2.2",
          "line_type": "m",
          "text": "The Lord is about to restore the glory of Israel, as it was before her enemies plundered her.)"
        },
        {
          "verse": 3,
          "usfm": "NAM.2.3",
          "line_type": "q1",
          "text": "The enemy soldiers carry red shieldsand wear uniforms of red.They are preparing to attack!Their chariots flash like fire!Their horses prance!"
        },
        {
          "verse": 4,
          "usfm": "NAM.2.4",
          "line_type": "q1",
          "text": "Chariots dash wildly through the streets,rushing back and forth in the city squares.They flash like torchesand dart about like lightning."
        },
        {
          "verse": 5,
          "usfm": "NAM.2.5",
          "line_type": "q1",
          "text": "The officers are summoned;they stumble as they press forward.The attackers rush to the walland set up the shield for the battering ram."
        },
        {
          "verse": 6,
          "usfm": "NAM.2.6",
          "line_type": "q1",
          "text": "The gates by the river burst open;the palace is filled with terror."
        },
        {
          "verse": 7,
          "usfm": "NAM.2.7",
          "line_type": "q1",
          "text": "The queen is taken captive;her servants moan like dovesand beat their breasts in sorrow."
        },
        {
          "verse": 8,
          "usfm": "NAM.2.8",
          "line_type": "q1",
          "text": "Like water from a broken damthe people rush from Nineveh!“Stop! Stop!” the cry rings out—but no one turns back."
        },
        {
          "verse": 9,
          "usfm": "NAM.2.9",
          "line_type": "q1",
          "text": "Plunder the silver!Plunder the gold!The city is full of treasure!"
        },
        {
          "verse": 10,
          "usfm": "NAM.2.10",
          "line_type": "q1",
          "text": "Nineveh is destroyed, deserted, desolate!Hearts melt with fear;knees tremble, strength is gone;faces grow pale."
        },
        {
          "verse": 11,
          "usfm": "NAM.2.11",
          "line_type": "q1",
          "text": "Where now is the citythat was like a den of lions,the place where young lions were fed,where the lion and the lioness would goand their cubs would be safe?"
        },
        {
          "verse": 12,
          "usfm": "NAM.2.12",
          "line_type": "q1",
          "text": "The lion killed his preyand tore it to pieces for his mate and her cubs;he filled his den with torn flesh."
        },
        {
          "verse": 13,
          "usfm": "NAM.2.13",
          "line_type": "p",
          "text": "“I am your enemy!” says the Lord Almighty. “I will burn up your chariots. Your soldiers will be killed in war, and I will take away everything that you took from others. The demands of your envoys will no longer be heard.”"
        }
      ],
