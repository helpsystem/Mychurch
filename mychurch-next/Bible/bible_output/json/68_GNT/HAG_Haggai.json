  "chapters": [
    {
      "schema_version": 6,
      "book_id": "HAG",
      "chapter": 1,
      "chapter_usfm": "HAG.1",
      "version_id": 68,
      "version_abbr": "GNT",
      "verses": [
        {
          "verse": 1,
          "usfm": "HAG.1.1",
          "line_type": "p",
          "text": "During the second year that Darius was emperor of Persia, on the first day of the sixth month, the Lord spoke through the prophet Haggai. The message was for the governor of Judah, Zerubbabel son of Shealtiel, and for the High Priest, Joshua son of Jehozadak."
        },
        {
          "verse": 2,
          "usfm": "HAG.1.2",
          "line_type": "p",
          "text": "The Lord Almighty said to Haggai, “These people say that this is not the right time to rebuild the Temple.”"
        },
        {
          "verse": 3,
          "usfm": "HAG.1.3",
          "line_type": "p",
          "text": "The Lord then gave this message to the people through the prophet Haggai:"
        },
        {
          "verse": 4,
          "usfm": "HAG.1.4",
          "line_type": "p",
          "text": "“My people, why should you be living in well-built houses while my Temple lies in ruins?"
        },
        {
          "verse": 5,
          "usfm": "HAG.1.5",
          "line_type": "p",
          "text": "Don't you see what is happening to you?"
        },
        {
          "verse": 6,
          "usfm": "HAG.1.6",
          "line_type": "p",
          "text": "You have planted much grain, but have harvested very little. You have food to eat, but not enough to make you full. You have wine to drink, but not enough to get drunk on! You have clothing, but not enough to keep you warm. And workers cannot earn enough to live on."
        },
        {
          "verse": 7,
          "usfm": "HAG.1.7",
          "line_type": "p",
          "text": "Can't you see why this has happened?"
        },
        {
          "verse": 8,
          "usfm": "HAG.1.8",
          "line_type": "p",
          "text": "Now go up into the hills, get lumber, and rebuild the Temple; then I will be pleased and will be worshiped as I should be."
        },
        {
          "verse": 9,
          "usfm": "HAG.1.9",
          "line_type": "p",
          "text": "“You hoped for large harvests, but they turned out to be small. And when you brought the harvest home, I blew it away. Why did I do that? Because my Temple lies in ruins while every one of you is busy working on your own house."
        },
        {
          "verse": 10,
          "usfm": "HAG.1.10",
          "line_type": "p",
          "text": "That is why there is no rain and nothing can grow."
        },
        {
          "verse": 11,
          "usfm": "HAG.1.11",
          "line_type": "p",
          "text": "I have brought drought on the land—on its hills, grainfields, vineyards, and olive orchards—on every crop the ground produces, on people and animals, on everything you try to grow.”"
        },
        {
          "verse": 12,
          "usfm": "HAG.1.12",
          "line_type": "p",
          "text": "Then Zerubbabel and Joshua and all the people who had returned from the exile in Babylonia, did what the Lord their God told them to do. They were afraid and obeyed the prophet Haggai, the Lord's messenger."
        },
        {
          "verse": 13,
          "usfm": "HAG.1.13",
          "line_type": "p",
          "text": "Then Haggai gave the Lord's message to the people: “I will be with you—that is my promise.”"
        },
        {
          "verse": 14,
          "usfm": "HAG.1.14",
          "line_type": "p",
          "text": "The Lord inspired everyone to work on the Temple: Zerubbabel, the governor of Judah; Joshua, the High Priest, and all the people who had returned from the exile. They began working on the Temple of the Lord Almighty, their God,"
        },
        {
          "verse": 15,
          "usfm": "HAG.1.15",
          "line_type": "p",
          "text": "on the twenty-fourth day of the sixth month of the second year that Darius was emperor."
        }
      ],
      "verse_count": 15,
      "headings": [
