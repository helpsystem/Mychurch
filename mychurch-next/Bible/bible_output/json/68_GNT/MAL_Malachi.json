    {
      "schema_version": 6,
      "book_id": "MAL",
      "chapter": 4,
      "chapter_usfm": "MAL.4",
      "version_id": 68,
      "version_abbr": "GNT",
      "verses": [
        {
          "verse": 1,
          "usfm": "MAL.4.1",
          "line_type": "p",
          "text": "The Lord Almighty says, “The day is coming when all proud and evil people will burn like straw. On that day they will burn up, and there will be nothing left of them."
        },
        {
          "verse": 2,
          "usfm": "MAL.4.2",
          "line_type": "p",
          "text": "But for you who obey me, my saving power will rise on you like the sun and bring healing like the sun's rays. You will be as free and happy as calves let out of a stall."
        },
        {
          "verse": 3,
          "usfm": "MAL.4.3",
          "line_type": "p",
          "text": "On the day when I act, you will overcome the wicked, and they will be like dust under your feet."
        },
        {
          "verse": 4,
          "usfm": "MAL.4.4",
          "line_type": "p",
          "text": "“Remember the teachings of my servant Moses, the laws and commands which I gave him at Mount Sinai for all the people of Israel to obey."
        },
        {
          "verse": 5,
          "usfm": "MAL.4.5",
          "line_type": "p",
          "text": "“But before the great and terrible day of the Lord comes, I will send you the prophet Elijah."
        },
        {
          "verse": 6,
          "usfm": "MAL.4.6",
          "line_type": "p",
          "text": "He will bring fathers and children together again; otherwise I would have to come and destroy your country.”"
        }
      ],
      "verse_count": 6,
      "headings": [
        {
          "before_verse": 1,
          "text": "Lord"
        },
        {
          "before_verse": 1,
          "text": "Is Coming"
        }
      ],
