  "chapters": [
    {
      "schema_version": 6,
      "book_id": "TIT",
      "chapter": 1,
      "chapter_usfm": "TIT.1",
      "version_id": 68,
      "version_abbr": "GNT",
      "verses": [
        {
          "verse": 1,
          "usfm": "TIT.1.1",
          "line_type": "p",
          "text": "From Paul, a servant of God and an apostle of Jesus Christ.I was chosen and sent to help the faith of God's chosen people and to lead them to the truth taught by our religion,"
        },
        {
          "verse": 2,
          "usfm": "TIT.1.2",
          "line_type": "p",
          "text": "which is based on the hope for eternal life. God, who does not lie, promised us this life before the beginning of time,"
        },
        {
          "verse": 3,
          "usfm": "TIT.1.3",
          "line_type": "p",
          "text": "and at the right time he revealed it in his message. This was entrusted to me, and I proclaim it by order of God our Savior."
        },
        {
          "verse": 4,
          "usfm": "TIT.1.4",
          "line_type": "p",
          "text": "I write to Titus, my true son in the faith that we have in common.May God the Father and Christ Jesus our Savior give you grace and peace."
        },
        {
          "verse": 5,
          "usfm": "TIT.1.5",
          "line_type": "p",
          "text": "I left you in Crete, so that you could put in order the things that still needed doing and appoint church elders in every town. Remember my instructions:"
        },
        {
          "verse": 6,
          "usfm": "TIT.1.6",
          "line_type": "p",
          "text": "an elder must be without fault; he must have only one wife, and his children must be believers and not have the reputation of being wild or disobedient."
        },
        {
          "verse": 7,
          "usfm": "TIT.1.7",
          "line_type": "p",
          "text": "For since a church leader is in charge of God's work, he should be without fault. He must not be arrogant or quick-tempered, or a drunkard or violent or greedy for money."
        },
        {
          "verse": 8,
          "usfm": "TIT.1.8",
          "line_type": "p",
          "text": "He must be hospitable and love what is good. He must be self-controlled, upright, holy, and disciplined."
        },
        {
          "verse": 9,
          "usfm": "TIT.1.9",
          "line_type": "p",
          "text": "He must hold firmly to the message which can be trusted and which agrees with the doctrine. In this way he will be able to encourage others with the true teaching and also to show the error of those who are opposed to it."
        },
        {
          "verse": 10,
          "usfm": "TIT.1.10",
          "line_type": "p",
          "text": "For there are many, especially the converts from Judaism, who rebel and deceive others with their nonsense."
        },
        {
          "verse": 11,
          "usfm": "TIT.1.11",
          "line_type": "p",
          "text": "It is necessary to stop their talk, because they are upsetting whole families by teaching what they should not, and all for the shameful purpose of making money. It was a Cretan himself, one of their own prophets, who spoke the truth when he said, “Cretans are always liars, wicked beasts, and lazy gluttons.” For this reason you must rebuke them sharply, so that they may have a healthy faith"
        },
        {
          "verse": 14,
          "usfm": "TIT.1.14",
          "line_type": "p",
          "text": "and no longer hold on to Jewish legends and to human commandments which come from people who have rejected the truth."
        },
        {
          "verse": 15,
          "usfm": "TIT.1.15",
          "line_type": "p",
          "text": "Everything is pure to those who are themselves pure; but nothing is pure to those who are defiled and unbelieving, for their minds and consciences have been defiled."
        },
        {
          "verse": 16,
          "usfm": "TIT.1.16",
          "line_type": "p",
          "text": "They claim that they know God, but their actions deny it. They are hateful and disobedient, not fit to do anything good."
        }
      ],
      "verse_count": 14,
      "headings": [
        {
          "before_verse": 5,
          "text": "Titus' Work in Crete"
        }
      ],
