  "chapters": [
    {
      "schema_version": 6,
      "book_id": "RUT",
      "chapter": 1,
      "chapter_usfm": "RUT.1",
      "version_id": 68,
      "version_abbr": "GNT",
      "verses": [
        {
          "verse": 3,
          "usfm": "RUT.1.3",
          "line_type": "p",
          "text": "Elimelech died, and Naomi was left alone with her two sons,"
        },
        {
          "verse": 4,
          "usfm": "RUT.1.4",
          "line_type": "p",
          "text": "who married Moabite women, Orpah and Ruth. About ten years later"
        },
        {
          "verse": 5,
          "usfm": "RUT.1.5",
          "line_type": "p",
          "text": "Mahlon and Chilion also died, and Naomi was left all alone, without husband or sons."
        },
        {
          "verse": 6,
          "usfm": "RUT.1.6",
          "line_type": "p",
          "text": "Some time later Naomi heard that the Lord had blessed his people by giving them good crops; so she got ready to leave Moab with her daughters-in-law."
        },
        {
          "verse": 7,
          "usfm": "RUT.1.7",
          "line_type": "p",
          "text": "They started out together to go back to Judah, but on the way"
        },
        {
          "verse": 8,
          "usfm": "RUT.1.8",
          "line_type": "p",
          "text": "she said to them, “Go back home and stay with your mothers. May the Lord be as good to you as you have been to me and to those who have died."
        },
        {
          "verse": 9,
          "usfm": "RUT.1.9",
          "line_type": "p",
          "text": "And may the Lord make it possible for each of you to marry again and have a home.”So Naomi kissed them good-bye. But they started crying"
        },
        {
          "verse": 10,
          "usfm": "RUT.1.10",
          "line_type": "p",
          "text": "and said to her, “No! We will go with you to your people.”"
        },
        {
          "verse": 11,
          "usfm": "RUT.1.11",
          "line_type": "p",
          "text": "“You must go back, my daughters,” Naomi answered. “Why do you want to come with me? Do you think I could have sons again for you to marry?"
        },
        {
          "verse": 12,
          "usfm": "RUT.1.12",
          "line_type": "p",
          "text": "Go back home, for I am too old to get married again. Even if I thought there was still hope, and so got married tonight and had sons,"
        },
        {
          "verse": 13,
          "usfm": "RUT.1.13",
          "line_type": "p",
          "text": "would you wait until they had grown up? Would this keep you from marrying someone else? No, my daughters, you know that's impossible. The Lord has turned against me, and I feel very sorry for you.”"
        },
        {
          "verse": 14,
          "usfm": "RUT.1.14",
          "line_type": "p",
          "text": "Again they started crying. Then Orpah kissed her mother-in-law good-bye and went back home, but Ruth held on to her."
        },
        {
          "verse": 15,
          "usfm": "RUT.1.15",
          "line_type": "p",
          "text": "So Naomi said to her, “Ruth, your sister-in-law has gone back to her people and to her god. Go back home with her.”"
        },
        {
          "verse": 16,
          "usfm": "RUT.1.16",
          "line_type": "p",
          "text": "But Ruth answered, “Don't ask me to leave you! Let me go with you. Wherever you go, I will go; wherever you live, I will live. Your people will be my people, and your God will be my God."
        },
        {
          "verse": 17,
          "usfm": "RUT.1.17",
          "line_type": "p",
          "text": "Wherever you die, I will die, and that is where I will be buried. May the Lord's worst punishment come upon me if I let anything but death separate me from you!”"
        },
        {
          "verse": 18,
          "usfm": "RUT.1.18",
          "line_type": "p",
          "text": "When Naomi saw that Ruth was determined to go with her, she said nothing more."
        },
        {
          "verse": 19,
          "usfm": "RUT.1.19",
          "line_type": "p",
          "text": "They went on until they came to Bethlehem. When they arrived, the whole town became excited, and the women there exclaimed, “Is this really Naomi?”"
        },
        {
          "verse": 20,
          "usfm": "RUT.1.20",
          "line_type": "p",
          "text": "“Don't call me Naomi,” she answered; “call me Marah, because Almighty God has made my life bitter."
        },
        {
          "verse": 21,
          "usfm": "RUT.1.21",
          "line_type": "p",
          "text": "When I left here, I had plenty, but the Lord has brought me back without a thing. Why call me Naomi when the Lord Almighty has condemned me and sent me trouble?”"
        },
        {
          "verse": 22,
          "usfm": "RUT.1.22",
          "line_type": "p",
          "text": "This, then, was how Naomi came back from Moab with Ruth, her Moabite daughter-in-law. When they arrived in Bethlehem, the barley harvest was just beginning."
        }
      ],
      "verse_count": 20,
      "headings": [
        {
          "before_verse": 6,
          "text": "Naomi and Ruth Return to Bethlehem"
        }
      ],
      "footnotes": [
        {
          "verse": 13,
          "usfm": "RUT.1.13",
          "note_ref": "1.13:",
          "note_type": "footnote",
          "references": [],
          "text": "sorry for you; or bitter about what has happened to you."
        },
        {
          "verse": 14,
          "usfm": "RUT.1.14",
          "note_ref": "1.14:",
          "note_type": "footnote",
          "references": [],
          "text": "One ancient translation and went back home; Hebrew does not have these words."
        },
        {
          "verse": 15,
          "usfm": "RUT.1.15",
          "note_ref": "1.15:",
          "note_type": "footnote",
          "references": [],
          "text": "god; or gods."
        },
        {
          "verse": 17,
          "usfm": "RUT.1.17",
          "note_ref": "1.17:",
          "note_type": "footnote",
          "references": [],
          "text": "anything but death; or even death."
        },
        {
          "verse": 20,
          "usfm": "RUT.1.20",
          "note_ref": "1.20:",
          "note_type": "footnote",
          "references": [],
          "text": "Naomi … Marah: In Hebrew Naomi means “pleasant” and Marah means “bitter.”"
        }
      ],
