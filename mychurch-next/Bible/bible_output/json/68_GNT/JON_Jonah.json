    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 2,
      "chapter_usfm": "JON.2",
      "version_id": 68,
      "version_abbr": "GNT",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.2.1",
          "line_type": "p",
          "text": "From deep inside the fish Jonah prayed to the Lord his God:"
        },
        {
          "verse": 2,
          "usfm": "JON.2.2",
          "line_type": "q1",
          "text": "“In my distress, O Lord, I called to you,and you answered me.From deep in the world of the deadI cried for help, and you heard me."
        },
        {
          "verse": 3,
          "usfm": "JON.2.3",
          "line_type": "q1",
          "text": "You threw me down into the depths,to the very bottom of the sea,where the waters were all around me,and all your mighty waves rolled over me."
        },
        {
          "verse": 4,
          "usfm": "JON.2.4",
          "line_type": "q1",
          "text": "I thought I had been banished from your presenceand would never see your holy Temple again."
        },
        {
          "verse": 5,
          "usfm": "JON.2.5",
          "line_type": "q1",
          "text": "The water came over me and choked me;the sea covered me completely,and seaweed wrapped around my head."
        },
        {
          "verse": 6,
          "usfm": "JON.2.6",
          "line_type": "q1",
          "text": "I went down to the very roots of the mountains,into the land whose gates lock shut forever.But you, O Lord my God,brought me back from the depths alive."
        },
        {
          "verse": 7,
          "usfm": "JON.2.7",
          "line_type": "q1",
          "text": "When I felt my life slipping away,then, O Lord, I prayed to you,and in your holy Temple you heard me."
        },
        {
          "verse": 8,
          "usfm": "JON.2.8",
          "line_type": "q1",
          "text": "Those who worship worthless idolshave abandoned their loyalty to you."
        },
        {
          "verse": 9,
          "usfm": "JON.2.9",
          "line_type": "q1",
          "text": "But I will sing praises to you;I will offer you a sacrificeand do what I have promised.Salvation comes from the Lord!”"
        },
        {
          "verse": 10,
          "usfm": "JON.2.10",
          "line_type": "p",
          "text": "Then the Lord ordered the fish to spit Jonah up on the beach, and it did."
        }
      ],
      "verse_count": 10,
      "headings": [],
      "footnotes": [
        {
          "verse": 6,
          "usfm": "JON.2.6",
          "note_ref": "2.6:",
          "note_type": "footnote",
          "references": [],
          "text": "the land whose gates lock shut forever: A reference to the world of the dead (see 2.2)."
        }
      ],
