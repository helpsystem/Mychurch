  "chapters": [
    {
      "schema_version": 6,
      "book_id": "JON",
      "chapter": 1,
      "chapter_usfm": "JON.1",
      "version_id": 68,
      "version_abbr": "GNT",
      "verses": [
        {
          "verse": 1,
          "usfm": "JON.1.1",
          "line_type": "p",
          "text": "One day the Lord spoke to Jonah son of Amittai."
        },
        {
          "verse": 2,
          "usfm": "JON.1.2",
          "line_type": "p",
          "text": "He said, “Go to Nineveh, that great city, and speak out against it; I am aware of how wicked its people are.”"
        },
        {
          "verse": 3,
          "usfm": "JON.1.3",
          "line_type": "p",
          "text": "Jonah, however, set out in the opposite direction in order to get away from the Lord. He went to Joppa, where he found a ship about to go to Spain. He paid his fare and went aboard with the crew to sail to Spain, where he would be away from the Lord."
        },
        {
          "verse": 4,
          "usfm": "JON.1.4",
          "line_type": "p",
          "text": "But the Lord sent a strong wind on the sea, and the storm was so violent that the ship was in danger of breaking up."
        },
        {
          "verse": 5,
          "usfm": "JON.1.5",
          "line_type": "p",
          "text": "The sailors were terrified and cried out for help, each one to his own god. Then, in order to lessen the danger, they threw the cargo overboard. Meanwhile, Jonah had gone below and was lying in the ship's hold, sound asleep."
        },
        {
          "verse": 6,
          "usfm": "JON.1.6",
          "line_type": "p",
          "text": "The captain found him there and said to him, “What are you doing asleep? Get up and pray to your god for help. Maybe he will feel sorry for us and spare our lives.”"
        },
        {
          "verse": 7,
          "usfm": "JON.1.7",
          "line_type": "p",
          "text": "The sailors said to each other, “Let's draw lots and find out who is to blame for getting us into this danger.” They did so, and Jonah's name was drawn."
        },
        {
          "verse": 8,
          "usfm": "JON.1.8",
          "line_type": "p",
          "text": "So they said to him, “Now, then, tell us! Who is to blame for this? What are you doing here? What country do you come from? What is your nationality?”"
        },
        {
          "verse": 9,
          "usfm": "JON.1.9",
          "line_type": "p",
          "text": "“I am a Hebrew,” Jonah answered. “I worship the Lord, the God of heaven, who made land and sea.”"
        },
        {
          "verse": 10,
          "usfm": "JON.1.10",
          "line_type": "p",
          "text": "Jonah went on to tell them that he was running away from the Lord.The sailors were terrified, and said to him, “That was an awful thing to do!”"
        },
        {
          "verse": 11,
          "usfm": "JON.1.11",
          "line_type": "p",
          "text": "The storm was getting worse all the time, so the sailors asked him, “What should we do to you to stop the storm?”"
        },
        {
          "verse": 12,
          "usfm": "JON.1.12",
          "line_type": "p",
          "text": "Jonah answered, “Throw me into the sea, and it will calm down. I know it is my fault that you are caught in this violent storm.”"
        },
        {
          "verse": 13,
          "usfm": "JON.1.13",
          "line_type": "p",
          "text": "Instead, the sailors tried to get the ship to shore, rowing with all their might. But the storm was becoming worse and worse, and they got nowhere."
        },
        {
          "verse": 14,
          "usfm": "JON.1.14",
          "line_type": "p",
          "text": "So they cried out to the Lord, “O Lord, we pray, don't punish us with death for taking this man's life! You, O Lord, are responsible for all this; it is your doing.”"
        },
        {
          "verse": 15,
          "usfm": "JON.1.15",
          "line_type": "p",
          "text": "Then they picked Jonah up and threw him into the sea, and it calmed down at once."
        },
        {
          "verse": 16,
          "usfm": "JON.1.16",
          "line_type": "p",
          "text": "This made the sailors so afraid of the Lord that they offered a sacrifice and promised to serve him."
        },
        {
          "verse": 17,
          "usfm": "JON.1.17",
          "line_type": "p",
          "text": "At the Lord's command a large fish swallowed Jonah, and he was inside the fish for three days and three nights."
        }
      ],
      "verse_count": 17,
      "headings": [
        {
          "before_verse": 1,
          "text": "Lord"
        }
      ],
      "footnotes": [
