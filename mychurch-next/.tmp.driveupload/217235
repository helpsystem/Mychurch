async function run() {
  try {
    const ref = "ICW-2026-4710";
    console.log(`Checking document: ${ref}...`);
    
    const { data, error } = await supabase
      .from("document_history")
      .select("*")
      .ilike("description", `%${ref}%`);
      
    if (error) {
      console.error("Database error:", error);
      return;
    }
    
    console.log(`Found ${data.length} records:`);
    for (const d of data) {
      console.log(`- ID: ${d.id}, Type: ${d.document_type}, Desc: ${d.description}, Draft: ${d.is_draft}`);
      console.log(`  Content:`, JSON.stringify(d.document_content).substring(0, 150) + "...");
    }
  } catch (err) {
    console.error("Error:", err);
  }
}

run();
