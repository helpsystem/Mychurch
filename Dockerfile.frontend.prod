# Multi-stage build for production optimization
FROM node:18-alpine AS deps
WORKDIR /app

# Install dependencies only when needed
COPY package.json package-lock.json* ./
COPY backend/package.json backend/package-lock.json* ./backend/
COPY pyproject.toml requirements.txt* ./

# Install Python dependencies for TTS features
RUN apk add --no-cache python3 py3-pip && \
    pip3 install --no-cache-dir -r requirements.txt

# Install Node.js dependencies
RUN npm ci --only=production && \
    cd backend && npm ci --only=production

# Builder stage
FROM node:18-alpine AS builder
WORKDIR /app

# Install all dependencies
COPY package.json package-lock.json* ./
COPY backend/package.json backend/package-lock.json* ./backend/

RUN npm ci && \
    cd backend && npm ci

# Copy source code
COPY . .

# Build frontend
RUN npm run build

# Build backend
RUN cd backend && npm run build

# Production stage
FROM node:18-alpine AS runner
WORKDIR /app

# Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# Install runtime dependencies
RUN apk add --no-cache \
    dumb-init \
    curl \
    python3 \
    py3-pip \
    && pip3 install --no-cache-dir -r requirements.txt

# Set up environment
ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

# Create directories
RUN mkdir -p /app/backend /app/logs /app/uploads /app/config /app/public /app/build

# Copy built application
COPY --from=builder --chown=nextjs:nodejs /app/build ./build
COPY --from=builder --chown=nextjs:nodejs /app/backend ./backend
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/package.json ./package.json
COPY --from=builder --chown=nextjs:nodejs /app/backend/package.json ./backend/package.json

# Copy configuration files
COPY --from=builder --chown=nextjs:nodejs /app/config ./config

# Create startup script
RUN echo '#!/bin/sh' > /app/start.sh && \
    echo 'dumb-init node server.js' >> /app/start.sh && \
    chmod +x /app/start.sh

# Switch to non-root user
USER nextjs

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3001/api/health || exit 1

# Expose port
EXPOSE 3001

# Start application
CMD ["/app/start.sh"]